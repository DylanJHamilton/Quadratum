{%- capture qtm_document_dir -%}{%- render 'theme-direction' -%}{%- endcapture -%}
{%- liquid
  assign qtm_page_title = page_title | default: shop.name
  assign qtm_meta_description = page_description | default: shop.description | default: settings.site_tagline
  assign qtm_canonical_url = canonical_url | default: request.origin

-%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ qtm_document_dir }}" class="no-js" data-theme="{% if settings.enable_dark_mode and settings.color_scheme == 'dark' %}dark{% else %}default{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {% render 'social-meta-tags' %}

  <title>
    {{ qtm_page_title | escape }}
    {%- unless qtm_page_title contains shop.name -%}
      · {{ shop.name | escape }}
    {%- endunless -%}
  </title>

  <link rel="canonical" href="{{ qtm_canonical_url }}">

  {% if qtm_meta_description != blank %}
    <meta name="description" content="{{ qtm_meta_description | strip_html | escape }}">
  {% endif %}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {% render 'theme-preconnect' %}
  {% render 'theme-fonts' %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {% render 'global-theme-vars' %}

  {{ 'q-base.css' | asset_url | stylesheet_tag }}
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ 'qtm-content-blocks.css' | asset_url | stylesheet_tag }}
{{ 'qtm-section-surfaces.css' | asset_url | stylesheet_tag }}
  {{ 'q-quick-view.css' | asset_url | stylesheet_tag }}

  {% if settings.pcard_show_wishlist %}
    {{ 'product-wishlist.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'product-wishlist.js' | asset_url }}" defer></script>
  {% endif %}
  {{ content_for_header }}

  {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

  {%- if settings.enable_search_popup -%}
    {{ 'search-popup.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'search-popup.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script>
    window.QuadratumSettings = window.QuadratumSettings || {};

    window.QuadratumSettings.theme = {
      name: {{ shop.name | json }},
      locale: {{ request.locale.iso_code | json }},
      direction: {{ qtm_document_dir | json }},
      designKit: {{ settings.style_kit | json }},
      sectionGroups: true
    };

    window.QuadratumSettings.cart = {
      url: {{ routes.cart_url | json }},
      ajaxDrawerEnabled: {{ settings.enable_ajax_cart_drawer | json }},
      openAfterAdd: {{ settings.open_ajax_cart_after_add | json }},
      headerTriggerEnabled: {{ settings.cart_drawer_enable_header_trigger | json }},
      productTriggerEnabled: {{ settings.cart_drawer_enable_pdp_trigger | json }},
      collectionTriggerEnabled: {{ settings.cart_drawer_enable_collection_trigger | json }},
      addonTriggerEnabled: {{ settings.cart_drawer_enable_addon_trigger | json }}
    };

    window.QuadratumSettings.search = {
      defaultFormType: {{ settings.search_default_form_type | json }},
      placeholder: {{ settings.search_placeholder | json }},
      submitLabel: {{ settings.search_submit_label | json }},
      viewAllLabel: {{ settings.search_view_all_label | json }},
      resultsLayout: {{ settings.search_results_layout | json }},
      resultsPerPage: {{ settings.search_results_per_page | json }},
      emptyMessage: {{ settings.search_empty_message | json }},
      emptyRecommendations: {{ settings.search_empty_recommendations | json }},
      sources: {
        products: {{ settings.search_src_products | json }},
        collections: {{ settings.search_src_collections | json }},
        articles: {{ settings.search_src_articles | json }},
        pages: {{ settings.search_src_pages | json }}
      },
      predictive: {
        enabled: {{ settings.enable_predictive_search | json }},
        productsLimit: {{ settings.predictive_search_products_limit | json }},
        collectionsLimit: {{ settings.predictive_search_collections_limit | json }},
        articlesLimit: {{ settings.predictive_search_articles_limit | json }},
        pagesLimit: {{ settings.predictive_search_pages_limit | json }},
        minChars: {{ settings.predictive_search_min_chars | json }},
        debounce: {{ settings.predictive_search_debounce | json }},
        showGroupHeadings: {{ settings.predictive_search_show_group_headings | json }},
        showThumbnails: {{ settings.predictive_search_show_thumbnails | json }},
        showViewAll: {{ settings.predictive_search_show_view_all | json }}
      },
      popup: {
        enabled: {{ settings.enable_search_popup | json }},
        formType: {{ settings.search_popup_form_type | json }},
        placeholder: {{ settings.search_popup_placeholder | json }}
      }
    };

    window.QuadratumSettings.popups = {
      enabled: {{ settings.popup_enable | json }},
      trigger: {{ settings.popup_trigger | json }},
      delaySeconds: {{ settings.popup_delay_seconds | json }},
      scrollPercent: {{ settings.popup_scroll_percent | json }},
      frequency: {{ settings.popup_frequency | json }},
      showOnMobile: {{ settings.popup_show_on_mobile | json }},
      showOnDesktop: {{ settings.popup_show_on_desktop | json }},
      overlayClickClose: {{ settings.popup_overlay_click_close | json }},
      editorPreview: {{ settings.popup_editor_preview | json }}
    };
  </script>

  {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  <script src="{{ 'global-popup.js' | asset_url }}" defer></script>

  {%- assign qtm_custom_code = settings.script_head | strip -%}
  {%- if settings.custom_scripts_enabled != false and qtm_custom_code != blank and qtm_custom_code != 'none' -%}
    {{ settings.script_head }}
  {%- endif -%}
</head>

<body class="q-typography qtm-dir-{{ qtm_document_dir }}">
  <a class="qtm-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- assign qtm_custom_code = settings.script_body_open | strip -%}
  {%- if settings.custom_scripts_enabled != false and qtm_custom_code != blank and qtm_custom_code != 'none' -%}
    {{ settings.script_body_open }}
  {%- endif -%}

  {% sections 'header-group' %}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'shop-follow-button' %}

  {%- if settings.enable_search_popup -%}
    {% render 'search-popup' %}
  {%- endif -%}

  {% render 'global-popup' %}
  {%- if settings.enable_ajax_cart_drawer -%}
    {% render 'cart-drawer' %}
  {%- endif -%}

  {% render 'q-quick-view-host' %}

  <script src="{{ 'product-media-runtime.js' | asset_url }}" defer></script>
  <script src="{{ 'q-quick-view.js' | asset_url }}" defer></script>

  {%- assign qtm_custom_code = settings.script_body_close | strip -%}
  {%- if settings.custom_scripts_enabled != false and qtm_custom_code != blank and qtm_custom_code != 'none' -%}
    {{ settings.script_body_close }}
  {%- endif -%}

  <script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-product-block-metadata.js' | asset_url }}" defer></script>
  <script src="{{ 'product-selling-plans.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-product-block-commerce.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-block-panels.js' | asset_url }}" defer></script>
  <script src="{{ 'interactive-content-countdown.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-product-block-utilities.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-product-block-gallery.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-block-product-cards.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-block-recently-viewed.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-block-bundles.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-block-navigation.js' | asset_url }}" defer></script>
  <script src="{{ 'qtm-block-visual-media.js' | asset_url }}" defer></script>
  <script src="{{ 'interactive-content-carousel-media.js' | asset_url }}" defer></script>


</body>
</html>
