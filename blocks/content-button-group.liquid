{%- liquid
  assign primary_label = block.settings.primary_label | default: 'Shop now'
  assign primary_url = block.settings.primary_url
  assign primary_aria_label = block.settings.primary_aria_label | default: primary_label

  assign secondary_label = block.settings.secondary_label | default: 'Learn more'
  assign secondary_url = block.settings.secondary_url
  assign secondary_aria_label = block.settings.secondary_aria_label | default: secondary_label

  assign show_primary = false
  assign show_secondary = false

  if primary_label != blank
    assign show_primary = true
  endif

  if secondary_label != blank
    assign show_secondary = true
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'button-group' %}

<div
  class="
    qtm-button-group
    qtm-button-group--{{ block.settings.group_layout }}
    qtm-button-group--mobile-{{ block.settings.mobile_layout }}
  "
  style="
    --qtm-button-group-gap: {{ block.settings.gap }}px;
    --qtm-button-group-max-width: {{ block.settings.max_width }}px;

    --qtm-button-primary-text-color: {{ block.settings.primary_text_color }};
    --qtm-button-primary-background-color: {{ block.settings.primary_background_color }};
    --qtm-button-primary-border-color: {{ block.settings.primary_border_color }};
    --qtm-button-primary-hover-text-color: {{ block.settings.primary_hover_text_color }};
    --qtm-button-primary-hover-background-color: {{ block.settings.primary_hover_background_color }};
    --qtm-button-primary-hover-border-color: {{ block.settings.primary_hover_border_color }};

    --qtm-button-secondary-text-color: {{ block.settings.secondary_text_color }};
    --qtm-button-secondary-background-color: {{ block.settings.secondary_background_color }};
    --qtm-button-secondary-border-color: {{ block.settings.secondary_border_color }};
    --qtm-button-secondary-hover-text-color: {{ block.settings.secondary_hover_text_color }};
    --qtm-button-secondary-hover-background-color: {{ block.settings.secondary_hover_background_color }};
    --qtm-button-secondary-hover-border-color: {{ block.settings.secondary_hover_border_color }};

    --qtm-button-radius: {{ block.settings.button_radius }}px;
    --qtm-button-border-width: {{ block.settings.button_border_width }}px;
    --qtm-button-font-family: {% if block.settings.font_family == 'heading' %}var(--font-heading-family){% elsif block.settings.font_family == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
    --qtm-button-font-weight: {{ block.settings.font_weight }};
    --qtm-button-letter-spacing: {{ block.settings.letter_spacing }}px;
  "
>
  {% if show_primary %}
    {%- liquid
      assign primary_tag = 'button'

      if primary_url != blank
        assign primary_tag = 'a'
      endif
    -%}

    <{{ primary_tag }}
      class="
        qtm-button
        qtm-button--{{ block.settings.primary_style }}
        qtm-button--{{ block.settings.button_size }}
        qtm-button-group__button
        qtm-button-group__button--primary
        {% if block.settings.full_width_buttons %} qtm-button--full{% endif %}
      "
      {% if primary_url != blank %}
        href="{{ primary_url }}"
        {% if block.settings.primary_open_new_tab %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      {% else %}
        type="button"
      {% endif %}
      aria-label="{{ primary_aria_label | escape }}"
    >
      {% if block.settings.primary_icon_left != blank %}
        <span class="qtm-button__icon qtm-button__icon--left" aria-hidden="true">
          {{ block.settings.primary_icon_left | escape }}
        </span>
      {% endif %}

      <span class="qtm-button__label">
        {{ primary_label | escape }}
      </span>

      {% if block.settings.primary_icon_right != blank %}
        <span class="qtm-button__icon qtm-button__icon--right" aria-hidden="true">
          {{ block.settings.primary_icon_right | escape }}
        </span>
      {% endif %}
    </{{ primary_tag }}>
  {% endif %}

  {% if show_secondary %}
    {%- liquid
      assign secondary_tag = 'button'

      if secondary_url != blank
        assign secondary_tag = 'a'
      endif
    -%}

    <{{ secondary_tag }}
      class="
        qtm-button
        qtm-button--{{ block.settings.secondary_style }}
        qtm-button--{{ block.settings.button_size }}
        qtm-button-group__button
        qtm-button-group__button--secondary
        {% if block.settings.full_width_buttons %} qtm-button--full{% endif %}
      "
      {% if secondary_url != blank %}
        href="{{ secondary_url }}"
        {% if block.settings.secondary_open_new_tab %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      {% else %}
        type="button"
      {% endif %}
      aria-label="{{ secondary_aria_label | escape }}"
    >
      {% if block.settings.secondary_icon_left != blank %}
        <span class="qtm-button__icon qtm-button__icon--left" aria-hidden="true">
          {{ block.settings.secondary_icon_left | escape }}
        </span>
      {% endif %}

      <span class="qtm-button__label">
        {{ secondary_label | escape }}
      </span>

      {% if block.settings.secondary_icon_right != blank %}
        <span class="qtm-button__icon qtm-button__icon--right" aria-hidden="true">
          {{ block.settings.secondary_icon_right | escape }}
        </span>
      {% endif %}
    </{{ secondary_tag }}>
  {% endif %}
</div>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

