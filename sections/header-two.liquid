{%- comment -%}
  Section: Header Two — Mega Menu Builder V2
  Quadratum Theme

  This version uses section blocks for the visible nav.
  Mega menu columns, links, and promos live INSIDE each Mega menu item block.
  No Shopify native main menu matching. No detached Mega Link/Mega Column blocks.

  Global contracts preserved:
    data-search-popup-open
    data-cart-drawer-open
    data-cart-count
{%- endcomment -%}

{{ 'header-two.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-two.js' | asset_url }}" defer></script>

{%- liquid
  assign header_placement = section.settings.header_placement | default: 'two_rows'
  assign header_width = section.settings.header_width | default: 'full_width'
  assign sticky_mode = section.settings.sticky_mode | default: 'sticky_shadow'
  assign search_display = section.settings.search_display | default: 'inline'
  assign search_placeholder = section.settings.search_placeholder | default: 'Search products, collections, and pages'
  assign mobile_drawer_style = section.settings.mobile_drawer_style | default: 'left'

  assign sticky_positioned = false
  if sticky_mode == 'sticky' or sticky_mode == 'sticky_shadow' or sticky_mode == 'hide_on_scroll'
    assign sticky_positioned = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }}{
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
  }

  {%- if sticky_positioned -%}
    #shopify-section-{{ section.id }}{
      position: sticky;
      top: 0;
      z-index: {{ section.settings.sticky_z_index }};
      transition: transform .28s ease;
    }

    #shopify-section-{{ section.id }}.qh2b-section-hidden{
      transform: translateY(-100%);
    }
  {%- endif -%}

  #HeaderTwoAnnounce-{{ section.id }}{
    --qh2b-announce-bg: {{ section.settings.announcement_bg }};
    --qh2b-announce-text: {{ section.settings.announcement_text_color }};
    --qh2b-announce-font-size: {{ section.settings.announcement_font_size }}px;
  }

  #HeaderTwo-{{ section.id }}{
    --qh2b-bg: {{ section.settings.header_bg }};
    --qh2b-text: {{ section.settings.header_text }};
    --qh2b-muted: {{ section.settings.muted_text }};
    --qh2b-link: {{ section.settings.header_link }};
    --qh2b-link-hover: {{ section.settings.header_link_hover }};
    --qh2b-border: {{ section.settings.header_border }};
    --qh2b-dropdown-bg: {{ section.settings.dropdown_bg }};
    --qh2b-dropdown-text: {{ section.settings.dropdown_text }};
    --qh2b-dropdown-muted: {{ section.settings.dropdown_muted }};
    --qh2b-dropdown-border: {{ section.settings.dropdown_border }};
    --qh2b-badge-bg: {{ section.settings.badge_bg }};
    --qh2b-badge-text: {{ section.settings.badge_text }};
    --qh2b-button-bg: {{ section.settings.button_bg }};
    --qh2b-button-text: {{ section.settings.button_text }};
    --qh2b-button-hover-bg: {{ section.settings.button_hover_bg }};
    --qh2b-button-hover-text: {{ section.settings.button_hover_text }};
    --qh2b-menu-font-size: {{ section.settings.menu_font_size }}px;
    --qh2b-menu-font-weight: {{ section.settings.menu_font_weight }};
    --qh2b-dropdown-font-size: {{ section.settings.dropdown_font_size }}px;
    --qh2b-logo-desktop: {{ section.settings.logo_height_desktop }}px;
    --qh2b-logo-mobile: {{ section.settings.logo_height_mobile }}px;
    --qh2b-pad-y: {{ section.settings.header_padding_y }}px;
    --qh2b-pad-x: {{ section.settings.header_padding_x }}px;
    --qh2b-menu-gap: {{ section.settings.menu_gap }}px;
    --qh2b-action-gap: {{ section.settings.action_gap }}px;
    --qh2b-search-width: {{ section.settings.search_max_width }}px;
    --qh2b-dropdown-pad: {{ section.settings.dropdown_padding }}px;
    --qh2b-button-radius: {{ section.settings.button_radius }}px;
    --qh2b-dropdown-radius: {{ section.settings.dropdown_radius }}px;
    --qh2b-card-radius: {{ section.settings.card_radius }}px;
    --qh2b-contained-width: 1180px;
    --qh2b-wide-width: 1440px;
    --qh2b-drawer-width: {{ section.settings.mobile_drawer_width }}px;
    --qh2b-overlay-z: {{ section.settings.mobile_overlay_z_index }};
  }
</style>

{%- if section.settings.announcement_enable and section.settings.announcement_text != blank -%}
  <div
    id="HeaderTwoAnnounce-{{ section.id }}"
    class="qh2bAnnounce qh2bAnnounce--align-{{ section.settings.announcement_alignment }}"
    data-qh2b-announce
  >
    <div class="qh2bAnnounce__inner">
      <p class="qh2bAnnounce__text">
        <span>{{ section.settings.announcement_text }}</span>
        {%- if section.settings.announcement_link_label != blank and section.settings.announcement_link_url != blank -%}
          <a class="qh2bAnnounce__link" href="{{ section.settings.announcement_link_url }}">
            {{ section.settings.announcement_link_label | escape }}
          </a>
        {%- endif -%}
      </p>

      {%- if section.settings.announcement_show_close -%}
        <button class="qh2bAnnounce__close" type="button" aria-label="Dismiss announcement" data-qh2b-announce-close>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<header
  id="HeaderTwo-{{ section.id }}"
  class="qh2b qh2b--placement-{{ header_placement }} qh2b--width-{{ header_width }} qh2b--sticky-{{ sticky_mode }} qh2b--drawer-{{ mobile_drawer_style }} qh2b--nav-align-{{ section.settings.nav_alignment }}"
  data-qh2b-header
  data-qh2b-sticky-mode="{{ sticky_mode }}"
  aria-label="Site header"
>
  <div class="qh2b__shell">
    <div class="qh2b__top-row">
      <button
        class="qh2b__mobile-toggle qh2b__icon-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="HeaderTwoMobileDrawer-{{ section.id }}"
        data-qh2b-mobile-open
      >
        <svg class="qh2b__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>

      <a class="qh2b__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo_primary != blank -%}
          <img class="qh2b__logo qh2b__logo--desktop" src="{{ settings.logo_primary | image_url: width: 700 }}" alt="{{ shop.name | escape }}" loading="eager">
        {%- endif -%}

        {%- if settings.logo_mobile != blank -%}
          <img class="qh2b__logo qh2b__logo--mobile" src="{{ settings.logo_mobile | image_url: width: 500 }}" alt="{{ shop.name | escape }}" loading="eager">
        {%- endif -%}

        {%- if settings.logo_primary == blank and settings.logo_mobile == blank -%}
          <span class="qh2b__brand-name">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- if header_placement == 'one_row' -%}
        <nav class="qh2b__nav qh2b__nav--inline" aria-label="Primary navigation">
          <ul class="qh2b__nav-list">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'nav_link' -%}
                  {%- unless block.settings.hide_desktop -%}
                    <li class="qh2b__nav-item" {{ block.shopify_attributes }}>
                      <a class="qh2b__nav-link{% if block.settings.url == request.path %} qh2b__nav-link--active{% endif %}" href="{{ block.settings.url | default: '#' }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
                        <span>{{ block.settings.label | default: 'Menu item' }}</span>
                        {%- if block.settings.badge != blank -%}<span class="qh2b__badge">{{ block.settings.badge }}</span>{%- endif -%}
                      </a>
                    </li>
                  {%- endunless -%}

                {%- when 'mega_menu' -%}
                  {%- unless block.settings.hide_desktop -%}
                    {%- assign panel_id = 'HeaderTwoMega-' | append: section.id | append: '-' | append: block.id -%}
                    <li class="qh2b__nav-item qh2b__nav-item--mega" data-qh2b-mega-item {{ block.shopify_attributes }}>
                      <div class="qh2b__nav-pair">
                        <a class="qh2b__nav-link" href="{{ block.settings.url | default: '#' }}">
                          <span>{{ block.settings.label | default: 'Mega menu' }}</span>
                          {%- if block.settings.badge != blank -%}<span class="qh2b__badge">{{ block.settings.badge }}</span>{%- endif -%}
                        </a>
                        <button class="qh2b__nav-caret" type="button" aria-label="Open {{ block.settings.label | escape }} menu" aria-expanded="false" aria-controls="{{ panel_id }}" data-qh2b-mega-trigger>
                          <svg class="qh2b__caret-icon" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.25L6 6.25L11 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                      </div>

                      <div id="{{ panel_id }}" class="qh2b__mega" hidden data-qh2b-mega-panel>
                        <div class="qh2b__mega-inner qh2b__mega-inner--{{ block.settings.panel_layout }}" style="--qh2b-mega-cols: {{ block.settings.columns }};">
                          <div class="qh2b__mega-columns">
                            {%- if block.settings.column_1_heading != blank or block.settings.column_1_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_1_heading != blank -%}
                                  {%- if block.settings.column_1_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_1_url }}">{{ block.settings.column_1_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_1_heading }}</p>{%- endif -%}
                                {%- endif -%}
                                {%- if block.settings.column_1_links != blank -%}
                                  <ul class="qh2b__mega-links">
                                    {%- assign rows = block.settings.column_1_links | newline_to_br | split: '<br />' -%}
                                    {%- for row in rows -%}
                                      {%- assign clean_row = row | strip -%}
                                      {%- if clean_row != blank -%}
                                        {%- assign parts = clean_row | split: '|' -%}
                                        {%- assign link_label = parts[0] | strip -%}
                                        {%- assign link_url = parts[1] | strip -%}
                                        {%- assign link_badge = parts[2] | strip -%}
                                        <li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>
                                      {%- endif -%}
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </div>
                            {%- endif -%}

                            {%- if block.settings.column_2_heading != blank or block.settings.column_2_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_2_heading != blank -%}
                                  {%- if block.settings.column_2_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_2_url }}">{{ block.settings.column_2_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_2_heading }}</p>{%- endif -%}
                                {%- endif -%}
                                {%- if block.settings.column_2_links != blank -%}
                                  <ul class="qh2b__mega-links">
                                    {%- assign rows = block.settings.column_2_links | newline_to_br | split: '<br />' -%}
                                    {%- for row in rows -%}
                                      {%- assign clean_row = row | strip -%}
                                      {%- if clean_row != blank -%}
                                        {%- assign parts = clean_row | split: '|' -%}
                                        {%- assign link_label = parts[0] | strip -%}
                                        {%- assign link_url = parts[1] | strip -%}
                                        {%- assign link_badge = parts[2] | strip -%}
                                        <li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>
                                      {%- endif -%}
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </div>
                            {%- endif -%}

                            {%- if block.settings.column_3_heading != blank or block.settings.column_3_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_3_heading != blank -%}
                                  {%- if block.settings.column_3_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_3_url }}">{{ block.settings.column_3_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_3_heading }}</p>{%- endif -%}
                                {%- endif -%}
                                {%- if block.settings.column_3_links != blank -%}
                                  <ul class="qh2b__mega-links">
                                    {%- assign rows = block.settings.column_3_links | newline_to_br | split: '<br />' -%}
                                    {%- for row in rows -%}
                                      {%- assign clean_row = row | strip -%}
                                      {%- if clean_row != blank -%}
                                        {%- assign parts = clean_row | split: '|' -%}
                                        {%- assign link_label = parts[0] | strip -%}
                                        {%- assign link_url = parts[1] | strip -%}
                                        {%- assign link_badge = parts[2] | strip -%}
                                        <li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>
                                      {%- endif -%}
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </div>
                            {%- endif -%}

                            {%- if block.settings.column_4_heading != blank or block.settings.column_4_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_4_heading != blank -%}
                                  {%- if block.settings.column_4_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_4_url }}">{{ block.settings.column_4_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_4_heading }}</p>{%- endif -%}
                                {%- endif -%}
                                {%- if block.settings.column_4_links != blank -%}
                                  <ul class="qh2b__mega-links">
                                    {%- assign rows = block.settings.column_4_links | newline_to_br | split: '<br />' -%}
                                    {%- for row in rows -%}
                                      {%- assign clean_row = row | strip -%}
                                      {%- if clean_row != blank -%}
                                        {%- assign parts = clean_row | split: '|' -%}
                                        {%- assign link_label = parts[0] | strip -%}
                                        {%- assign link_url = parts[1] | strip -%}
                                        {%- assign link_badge = parts[2] | strip -%}
                                        <li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>
                                      {%- endif -%}
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          </div>

                          {%- if block.settings.show_promo_1 or block.settings.show_promo_2 or block.settings.show_promo_3 or block.settings.featured_collection != blank -%}
                            <div class="qh2b__mega-aside">
                              {%- if block.settings.show_promo_1 -%}
                                <a class="qh2b__promo-card" href="{{ block.settings.promo_1_url | default: '#' }}">
                                  {%- if block.settings.promo_1_image != blank -%}<span class="qh2b__promo-media"><img class="qh2b__promo-img" src="{{ block.settings.promo_1_image | image_url: width: 520 }}" alt="{{ block.settings.promo_1_heading | escape }}" loading="lazy"></span>{%- endif -%}
                                  <span class="qh2b__promo-body">
                                    {%- if block.settings.promo_1_eyebrow != blank -%}<span class="qh2b__promo-eyebrow">{{ block.settings.promo_1_eyebrow }}</span>{%- endif -%}
                                    {%- if block.settings.promo_1_heading != blank -%}<span class="qh2b__promo-heading">{{ block.settings.promo_1_heading }}</span>{%- endif -%}
                                    {%- if block.settings.promo_1_text != blank -%}<span class="qh2b__promo-text">{{ block.settings.promo_1_text }}</span>{%- endif -%}
                                    {%- if block.settings.promo_1_label != blank -%}<span class="qh2b__promo-link-label">{{ block.settings.promo_1_label }}</span>{%- endif -%}
                                  </span>
                                </a>
                              {%- endif -%}
                              {%- if block.settings.show_promo_2 -%}
                                <a class="qh2b__promo-card" href="{{ block.settings.promo_2_url | default: '#' }}">
                                  {%- if block.settings.promo_2_image != blank -%}<span class="qh2b__promo-media"><img class="qh2b__promo-img" src="{{ block.settings.promo_2_image | image_url: width: 520 }}" alt="{{ block.settings.promo_2_heading | escape }}" loading="lazy"></span>{%- endif -%}
                                  <span class="qh2b__promo-body">
                                    {%- if block.settings.promo_2_eyebrow != blank -%}<span class="qh2b__promo-eyebrow">{{ block.settings.promo_2_eyebrow }}</span>{%- endif -%}
                                    {%- if block.settings.promo_2_heading != blank -%}<span class="qh2b__promo-heading">{{ block.settings.promo_2_heading }}</span>{%- endif -%}
                                    {%- if block.settings.promo_2_text != blank -%}<span class="qh2b__promo-text">{{ block.settings.promo_2_text }}</span>{%- endif -%}
                                    {%- if block.settings.promo_2_label != blank -%}<span class="qh2b__promo-link-label">{{ block.settings.promo_2_label }}</span>{%- endif -%}
                                  </span>
                                </a>
                              {%- endif -%}
                              {%- if block.settings.show_promo_3 -%}
                                <a class="qh2b__promo-card" href="{{ block.settings.promo_3_url | default: '#' }}">
                                  {%- if block.settings.promo_3_image != blank -%}<span class="qh2b__promo-media"><img class="qh2b__promo-img" src="{{ block.settings.promo_3_image | image_url: width: 520 }}" alt="{{ block.settings.promo_3_heading | escape }}" loading="lazy"></span>{%- endif -%}
                                  <span class="qh2b__promo-body">
                                    {%- if block.settings.promo_3_eyebrow != blank -%}<span class="qh2b__promo-eyebrow">{{ block.settings.promo_3_eyebrow }}</span>{%- endif -%}
                                    {%- if block.settings.promo_3_heading != blank -%}<span class="qh2b__promo-heading">{{ block.settings.promo_3_heading }}</span>{%- endif -%}
                                    {%- if block.settings.promo_3_text != blank -%}<span class="qh2b__promo-text">{{ block.settings.promo_3_text }}</span>{%- endif -%}
                                    {%- if block.settings.promo_3_label != blank -%}<span class="qh2b__promo-link-label">{{ block.settings.promo_3_label }}</span>{%- endif -%}
                                  </span>
                                </a>
                              {%- endif -%}
                              {%- if block.settings.featured_collection != blank -%}
                                {%- liquid
                                  assign featured_collection = block.settings.featured_collection
                                  assign collection_title = block.settings.featured_collection_heading
                                  if collection_title == blank
                                    assign collection_title = featured_collection.title
                                  endif
                                -%}
                                <a class="qh2b__featured" href="{{ featured_collection.url }}">
                                  {%- if block.settings.show_featured_collection_image -%}
                                    <span class="qh2b__featured-media">
                                      {%- if featured_collection.image != blank -%}<img class="qh2b__featured-img" src="{{ featured_collection.image | image_url: width: 220, height: 220, crop: 'center' }}" alt="{{ collection_title | escape }}" loading="lazy">{%- elsif featured_collection.featured_image != blank -%}<img class="qh2b__featured-img" src="{{ featured_collection.featured_image | image_url: width: 220, height: 220, crop: 'center' }}" alt="{{ collection_title | escape }}" loading="lazy">{%- endif -%}
                                    </span>
                                  {%- endif -%}
                                  <span class="qh2b__featured-body"><span class="qh2b__featured-eyebrow">Featured collection</span><span class="qh2b__featured-title">{{ collection_title }}</span></span>
                                </a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </li>
                  {%- endunless -%}
              {%- endcase -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if search_display == 'inline' -%}
        <div class="qh2b__search">
          <form class="qh2b__search-form" action="{{ routes.search_url }}" method="get" role="search">
            <label class="qh2b__visually-hidden" for="HeaderTwoSearch-{{ section.id }}">Search</label>
            <input id="HeaderTwoSearch-{{ section.id }}" class="qh2b__search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ search_placeholder | escape }}" autocomplete="off">
            {%- if section.settings.show_inline_search_button -%}<button class="qh2b__search-submit" type="submit">Search</button>{%- endif -%}
          </form>
        </div>
      {%- endif -%}

      <div class="qh2b__actions">
        {%- if search_display == 'popup' -%}
          <button class="qh2b__icon-button" type="button" data-search-popup-open aria-label="Open search" aria-haspopup="dialog">
            <svg class="qh2b__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span class="qh2b__action-label">Search</span>
          </button>
        {%- elsif search_display == 'page' -%}
          <a class="qh2b__icon-button" href="{{ routes.search_url }}" aria-label="Search">
            <svg class="qh2b__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span class="qh2b__action-label">Search</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          <details class="qh2b__account" data-qh2b-account>
            <summary class="qh2b__icon-button qh2b__account-summary" aria-label="Account">
              <svg class="qh2b__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.8"/><path d="M5 20C5.75 16.5 8.25 14.55 12 14.55C15.75 14.55 18.25 16.5 19 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              {%- if section.settings.account_display != 'icon' -%}<span class="qh2b__action-label">{% if customer %}Account{% else %}Sign in{% endif %}</span>{%- endif -%}
            </summary>
            <div class="qh2b__account-menu">
              {%- if customer -%}
                <a class="qh2b__account-link" href="{{ routes.account_url }}">Account</a>
                <a class="qh2b__account-link" href="{{ routes.account_url }}">Orders</a>
                <a class="qh2b__account-link" href="{{ routes.account_addresses_url }}">Addresses</a>
                {%- if section.settings.tracking_label != blank and section.settings.tracking_url != blank -%}<a class="qh2b__account-link" href="{{ section.settings.tracking_url }}">{{ section.settings.tracking_label }}</a>{%- endif -%}
                <a class="qh2b__account-link qh2b__account-link--muted" href="{{ routes.account_logout_url }}">Log out</a>
              {%- else -%}
                <a class="qh2b__account-link" href="{{ routes.account_login_url }}">Sign in</a>
                <a class="qh2b__account-link" href="{{ routes.account_register_url }}">Create account</a>
                {%- if section.settings.tracking_label != blank and section.settings.tracking_url != blank -%}<a class="qh2b__account-link" href="{{ section.settings.tracking_url }}">{{ section.settings.tracking_label }}</a>{%- endif -%}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        <button class="qh2b__icon-button qh2b__cart" type="button" data-cart-drawer-open aria-label="Open cart">
          <span class="qh2b__cart-icon-wrap">
            <svg class="qh2b__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 7.5H19.5L18.25 17H7.75L6.5 7.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 7.5C9 4.95 10.15 3.5 12 3.5C13.85 3.5 15 4.95 15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span class="qh2b__cart-count" data-cart-count>{{ cart.item_count }}</span>
          </span>
          {%- if section.settings.cart_display == 'icon_text' -%}<span class="qh2b__action-label">Cart</span>{%- endif -%}
        </button>
      </div>
    </div>

    {%- if header_placement == 'two_rows' -%}
      <div class="qh2b__bottom-row">
        <nav class="qh2b__nav qh2b__nav--below" aria-label="Primary navigation">
          <ul class="qh2b__nav-list">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'nav_link' -%}
                  {%- unless block.settings.hide_desktop -%}
                    <li class="qh2b__nav-item" {{ block.shopify_attributes }}>
                      <a class="qh2b__nav-link{% if block.settings.url == request.path %} qh2b__nav-link--active{% endif %}" href="{{ block.settings.url | default: '#' }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
                        <span>{{ block.settings.label | default: 'Menu item' }}</span>
                        {%- if block.settings.badge != blank -%}<span class="qh2b__badge">{{ block.settings.badge }}</span>{%- endif -%}
                      </a>
                    </li>
                  {%- endunless -%}

                {%- when 'mega_menu' -%}
                  {%- unless block.settings.hide_desktop -%}
                    {%- assign panel_id = 'HeaderTwoMegaBelow-' | append: section.id | append: '-' | append: block.id -%}
                    <li class="qh2b__nav-item qh2b__nav-item--mega" data-qh2b-mega-item {{ block.shopify_attributes }}>
                      <div class="qh2b__nav-pair">
                        <a class="qh2b__nav-link" href="{{ block.settings.url | default: '#' }}">
                          <span>{{ block.settings.label | default: 'Mega menu' }}</span>
                          {%- if block.settings.badge != blank -%}<span class="qh2b__badge">{{ block.settings.badge }}</span>{%- endif -%}
                        </a>
                        <button class="qh2b__nav-caret" type="button" aria-label="Open {{ block.settings.label | escape }} menu" aria-expanded="false" aria-controls="{{ panel_id }}" data-qh2b-mega-trigger>
                          <svg class="qh2b__caret-icon" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.25L6 6.25L11 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                      </div>

                      <div id="{{ panel_id }}" class="qh2b__mega" hidden data-qh2b-mega-panel>
                        <div class="qh2b__mega-inner qh2b__mega-inner--{{ block.settings.panel_layout }}" style="--qh2b-mega-cols: {{ block.settings.columns }};">
                          <div class="qh2b__mega-columns">
                            {%- if block.settings.column_1_heading != blank or block.settings.column_1_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_1_heading != blank -%}{%- if block.settings.column_1_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_1_url }}">{{ block.settings.column_1_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_1_heading }}</p>{%- endif -%}{%- endif -%}
                                {%- if block.settings.column_1_links != blank -%}<ul class="qh2b__mega-links">{%- assign rows = block.settings.column_1_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}{%- assign link_label = parts[0] | strip -%}{%- assign link_url = parts[1] | strip -%}{%- assign link_badge = parts[2] | strip -%}<li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
                              </div>
                            {%- endif -%}
                            {%- if block.settings.column_2_heading != blank or block.settings.column_2_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_2_heading != blank -%}{%- if block.settings.column_2_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_2_url }}">{{ block.settings.column_2_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_2_heading }}</p>{%- endif -%}{%- endif -%}
                                {%- if block.settings.column_2_links != blank -%}<ul class="qh2b__mega-links">{%- assign rows = block.settings.column_2_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}{%- assign link_label = parts[0] | strip -%}{%- assign link_url = parts[1] | strip -%}{%- assign link_badge = parts[2] | strip -%}<li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
                              </div>
                            {%- endif -%}
                            {%- if block.settings.column_3_heading != blank or block.settings.column_3_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_3_heading != blank -%}{%- if block.settings.column_3_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_3_url }}">{{ block.settings.column_3_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_3_heading }}</p>{%- endif -%}{%- endif -%}
                                {%- if block.settings.column_3_links != blank -%}<ul class="qh2b__mega-links">{%- assign rows = block.settings.column_3_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}{%- assign link_label = parts[0] | strip -%}{%- assign link_url = parts[1] | strip -%}{%- assign link_badge = parts[2] | strip -%}<li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
                              </div>
                            {%- endif -%}
                            {%- if block.settings.column_4_heading != blank or block.settings.column_4_links != blank -%}
                              <div class="qh2b__mega-column">
                                {%- if block.settings.column_4_heading != blank -%}{%- if block.settings.column_4_url != blank -%}<a class="qh2b__mega-heading" href="{{ block.settings.column_4_url }}">{{ block.settings.column_4_heading }}</a>{%- else -%}<p class="qh2b__mega-heading">{{ block.settings.column_4_heading }}</p>{%- endif -%}{%- endif -%}
                                {%- if block.settings.column_4_links != blank -%}<ul class="qh2b__mega-links">{%- assign rows = block.settings.column_4_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}{%- assign link_label = parts[0] | strip -%}{%- assign link_url = parts[1] | strip -%}{%- assign link_badge = parts[2] | strip -%}<li><a class="qh2b__mega-link" href="{{ link_url | default: '#' }}"><span>{{ link_label }}</span>{%- if link_badge != blank -%}<span class="qh2b__mini-badge">{{ link_badge }}</span>{%- endif -%}</a></li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
                              </div>
                            {%- endif -%}
                          </div>

                          {%- if block.settings.show_promo_1 or block.settings.show_promo_2 or block.settings.show_promo_3 or block.settings.featured_collection != blank -%}
                            <div class="qh2b__mega-aside">
                              {%- if block.settings.show_promo_1 -%}<a class="qh2b__promo-card" href="{{ block.settings.promo_1_url | default: '#' }}">{%- if block.settings.promo_1_image != blank -%}<span class="qh2b__promo-media"><img class="qh2b__promo-img" src="{{ block.settings.promo_1_image | image_url: width: 520 }}" alt="{{ block.settings.promo_1_heading | escape }}" loading="lazy"></span>{%- endif -%}<span class="qh2b__promo-body">{%- if block.settings.promo_1_eyebrow != blank -%}<span class="qh2b__promo-eyebrow">{{ block.settings.promo_1_eyebrow }}</span>{%- endif -%}{%- if block.settings.promo_1_heading != blank -%}<span class="qh2b__promo-heading">{{ block.settings.promo_1_heading }}</span>{%- endif -%}{%- if block.settings.promo_1_text != blank -%}<span class="qh2b__promo-text">{{ block.settings.promo_1_text }}</span>{%- endif -%}{%- if block.settings.promo_1_label != blank -%}<span class="qh2b__promo-link-label">{{ block.settings.promo_1_label }}</span>{%- endif -%}</span></a>{%- endif -%}
                              {%- if block.settings.show_promo_2 -%}<a class="qh2b__promo-card" href="{{ block.settings.promo_2_url | default: '#' }}">{%- if block.settings.promo_2_image != blank -%}<span class="qh2b__promo-media"><img class="qh2b__promo-img" src="{{ block.settings.promo_2_image | image_url: width: 520 }}" alt="{{ block.settings.promo_2_heading | escape }}" loading="lazy"></span>{%- endif -%}<span class="qh2b__promo-body">{%- if block.settings.promo_2_eyebrow != blank -%}<span class="qh2b__promo-eyebrow">{{ block.settings.promo_2_eyebrow }}</span>{%- endif -%}{%- if block.settings.promo_2_heading != blank -%}<span class="qh2b__promo-heading">{{ block.settings.promo_2_heading }}</span>{%- endif -%}{%- if block.settings.promo_2_text != blank -%}<span class="qh2b__promo-text">{{ block.settings.promo_2_text }}</span>{%- endif -%}{%- if block.settings.promo_2_label != blank -%}<span class="qh2b__promo-link-label">{{ block.settings.promo_2_label }}</span>{%- endif -%}</span></a>{%- endif -%}
                              {%- if block.settings.show_promo_3 -%}<a class="qh2b__promo-card" href="{{ block.settings.promo_3_url | default: '#' }}">{%- if block.settings.promo_3_image != blank -%}<span class="qh2b__promo-media"><img class="qh2b__promo-img" src="{{ block.settings.promo_3_image | image_url: width: 520 }}" alt="{{ block.settings.promo_3_heading | escape }}" loading="lazy"></span>{%- endif -%}<span class="qh2b__promo-body">{%- if block.settings.promo_3_eyebrow != blank -%}<span class="qh2b__promo-eyebrow">{{ block.settings.promo_3_eyebrow }}</span>{%- endif -%}{%- if block.settings.promo_3_heading != blank -%}<span class="qh2b__promo-heading">{{ block.settings.promo_3_heading }}</span>{%- endif -%}{%- if block.settings.promo_3_text != blank -%}<span class="qh2b__promo-text">{{ block.settings.promo_3_text }}</span>{%- endif -%}{%- if block.settings.promo_3_label != blank -%}<span class="qh2b__promo-link-label">{{ block.settings.promo_3_label }}</span>{%- endif -%}</span></a>{%- endif -%}
                              {%- if block.settings.featured_collection != blank -%}
                                {%- liquid
                                  assign featured_collection = block.settings.featured_collection
                                  assign collection_title = block.settings.featured_collection_heading
                                  if collection_title == blank
                                    assign collection_title = featured_collection.title
                                  endif
                                -%}
                                <a class="qh2b__featured" href="{{ featured_collection.url }}">
                                  {%- if block.settings.show_featured_collection_image -%}
                                    <span class="qh2b__featured-media">
                                      {%- if featured_collection.image != blank -%}
                                        <img class="qh2b__featured-img" src="{{ featured_collection.image | image_url: width: 220, height: 220, crop: 'center' }}" alt="{{ collection_title | escape }}" loading="lazy">
                                      {%- elsif featured_collection.featured_image != blank -%}
                                        <img class="qh2b__featured-img" src="{{ featured_collection.featured_image | image_url: width: 220, height: 220, crop: 'center' }}" alt="{{ collection_title | escape }}" loading="lazy">
                                      {%- endif -%}
                                    </span>
                                  {%- endif -%}
                                  <span class="qh2b__featured-body">
                                    <span class="qh2b__featured-eyebrow">Featured collection</span>
                                    <span class="qh2b__featured-title">{{ collection_title }}</span>
                                  </span>
                                </a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </li>
                  {%- endunless -%}
              {%- endcase -%}
            {%- endfor -%}
          </ul>
        </nav>
      </div>
    {%- endif -%}
  </div>

  <div id="HeaderTwoMobileOverlay-{{ section.id }}" class="qh2b__mobile-overlay" hidden data-qh2b-mobile-close></div>

  <aside
    id="HeaderTwoMobileDrawer-{{ section.id }}"
    class="qh2b__mobile-drawer"
    hidden
    aria-hidden="true"
    aria-label="Mobile navigation"
    data-qh2b-mobile-drawer
  >
    <div class="qh2b__mobile-head">
      <a class="qh2b__mobile-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo_mobile != blank -%}
          <img class="qh2b__mobile-logo" src="{{ settings.logo_mobile | image_url: width: 420 }}" alt="{{ shop.name | escape }}" loading="eager">
        {%- elsif settings.logo_primary != blank -%}
          <img class="qh2b__mobile-logo" src="{{ settings.logo_primary | image_url: width: 420 }}" alt="{{ shop.name | escape }}" loading="eager">
        {%- else -%}
          <span class="qh2b__mobile-brand-name">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <button class="qh2b__mobile-close" type="button" aria-label="Close menu" data-qh2b-mobile-close>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    {%- if search_display != 'none' -%}
      <div class="qh2b__mobile-search">
        {%- if search_display == 'popup' -%}
          <button class="qh2b__mobile-search-button" type="button" data-search-popup-open data-qh2b-mobile-system-action>Search</button>
        {%- else -%}
          <form class="qh2b__search-form" action="{{ routes.search_url }}" method="get" role="search">
            <label class="qh2b__visually-hidden" for="HeaderTwoMobileSearch-{{ section.id }}">Search</label>
            <input id="HeaderTwoMobileSearch-{{ section.id }}" class="qh2b__search-input" type="search" name="q" placeholder="{{ search_placeholder | escape }}" autocomplete="off">
            <button class="qh2b__search-submit" type="submit">Search</button>
          </form>
        {%- endif -%}
      </div>
    {%- endif -%}

    <nav class="qh2b__mobile-nav" aria-label="Mobile navigation">
      <ul class="qh2b__mobile-list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'nav_link' -%}
              {%- unless block.settings.hide_mobile -%}
                <li class="qh2b__mobile-item" {{ block.shopify_attributes }}>
                  <a class="qh2b__mobile-link" href="{{ block.settings.url | default: '#' }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
                    <span>{{ block.settings.label | default: 'Menu item' }}</span>
                    {%- if block.settings.badge != blank -%}<span class="qh2b__badge">{{ block.settings.badge }}</span>{%- endif -%}
                  </a>
                </li>
              {%- endunless -%}

            {%- when 'mega_menu' -%}
              {%- unless block.settings.hide_mobile -%}
                {%- assign mobile_panel_id = 'HeaderTwoMobileMega-' | append: section.id | append: '-' | append: block.id -%}
                <li class="qh2b__mobile-item qh2b__mobile-item--mega" {{ block.shopify_attributes }}>
                  <div class="qh2b__mobile-row">
                    <a class="qh2b__mobile-link" href="{{ block.settings.url | default: '#' }}">
                      <span>{{ block.settings.label | default: 'Mega menu' }}</span>
                      {%- if block.settings.badge != blank -%}<span class="qh2b__badge">{{ block.settings.badge }}</span>{%- endif -%}
                    </a>
                    <button class="qh2b__mobile-subtoggle" type="button" aria-expanded="false" aria-controls="{{ mobile_panel_id }}" data-qh2b-mobile-subtoggle>
                      <svg class="qh2b__caret-icon" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.25L6 6.25L11 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                  </div>

                  <div id="{{ mobile_panel_id }}" class="qh2b__mobile-submenu" hidden>
                    {%- if block.settings.column_1_heading != blank or block.settings.column_1_links != blank -%}<div class="qh2b__mobile-column">{%- if block.settings.column_1_heading != blank -%}<p class="qh2b__mobile-column-heading">{{ block.settings.column_1_heading }}</p>{%- endif -%}{%- assign rows = block.settings.column_1_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}<a class="qh2b__mobile-sublink" href="{{ parts[1] | strip | default: '#' }}">{{ parts[0] | strip }}</a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
                    {%- if block.settings.column_2_heading != blank or block.settings.column_2_links != blank -%}<div class="qh2b__mobile-column">{%- if block.settings.column_2_heading != blank -%}<p class="qh2b__mobile-column-heading">{{ block.settings.column_2_heading }}</p>{%- endif -%}{%- assign rows = block.settings.column_2_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}<a class="qh2b__mobile-sublink" href="{{ parts[1] | strip | default: '#' }}">{{ parts[0] | strip }}</a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
                    {%- if block.settings.column_3_heading != blank or block.settings.column_3_links != blank -%}<div class="qh2b__mobile-column">{%- if block.settings.column_3_heading != blank -%}<p class="qh2b__mobile-column-heading">{{ block.settings.column_3_heading }}</p>{%- endif -%}{%- assign rows = block.settings.column_3_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}<a class="qh2b__mobile-sublink" href="{{ parts[1] | strip | default: '#' }}">{{ parts[0] | strip }}</a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
                    {%- if block.settings.column_4_heading != blank or block.settings.column_4_links != blank -%}<div class="qh2b__mobile-column">{%- if block.settings.column_4_heading != blank -%}<p class="qh2b__mobile-column-heading">{{ block.settings.column_4_heading }}</p>{%- endif -%}{%- assign rows = block.settings.column_4_links | newline_to_br | split: '<br />' -%}{%- for row in rows -%}{%- assign clean_row = row | strip -%}{%- if clean_row != blank -%}{%- assign parts = clean_row | split: '|' -%}<a class="qh2b__mobile-sublink" href="{{ parts[1] | strip | default: '#' }}">{{ parts[0] | strip }}</a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
                  </div>
                </li>
              {%- endunless -%}
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="qh2b__mobile-utilities">
      {%- if section.settings.show_account -%}
        {%- if customer -%}
          <a class="qh2b__mobile-utility" href="{{ routes.account_url }}">Account</a>
          <a class="qh2b__mobile-utility" href="{{ routes.account_addresses_url }}">Addresses</a>
        {%- else -%}
          <a class="qh2b__mobile-utility" href="{{ routes.account_login_url }}">Sign in</a>
          {%- if section.settings.mobile_show_register -%}<a class="qh2b__mobile-utility" href="{{ routes.account_register_url }}">Create account</a>{%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.tracking_label != blank and section.settings.tracking_url != blank -%}
        <a class="qh2b__mobile-utility" href="{{ section.settings.tracking_url }}">{{ section.settings.tracking_label }}</a>
      {%- endif -%}

      <button class="qh2b__mobile-utility" type="button" data-cart-drawer-open data-qh2b-mobile-system-action>Cart <span data-cart-count>{{ cart.item_count }}</span></button>
    </div>
  </aside>
</header>

{% schema %}
{
  "name": "Header Two Builder",
  "class": "qtm-header-two-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "header_placement", "label": "Header placement", "default": "two_rows", "options": [ { "value": "one_row", "label": "One row" }, { "value": "two_rows", "label": "Two rows" } ] },
    { "type": "select", "id": "header_width", "label": "Header width", "default": "full_width", "options": [ { "value": "full_width", "label": "Full width" }, { "value": "wide", "label": "Wide" }, { "value": "contained", "label": "Contained" } ] },
    { "type": "select", "id": "sticky_mode", "label": "Sticky mode", "default": "sticky_shadow", "options": [ { "value": "none", "label": "None" }, { "value": "sticky", "label": "Sticky" }, { "value": "sticky_shadow", "label": "Sticky with shadow" }, { "value": "hide_on_scroll", "label": "Hide on scroll down" } ] },
