{%- liquid
  assign comparison_label = value
  assign comparison_symbol = ''
  case value
    when 'yes'
      assign comparison_label = block.settings.included_label | default: 'Included'
      assign comparison_symbol = '✓'
    when 'no'
      assign comparison_label = block.settings.not_included_label | default: 'Not included'
      assign comparison_symbol = '×'
    when 'partial'
      assign comparison_label = block.settings.partial_label | default: 'Partially included'
      assign comparison_symbol = '—'
  endcase
-%}
<span class="qtm-comparison-matrix__value qtm-comparison-matrix__value--{{ value | escape }}">
  {%- if comparison_symbol != blank -%}
    <span aria-hidden="true">{{ comparison_symbol }}</span><span class="visually-hidden">{{ comparison_label | escape }}</span>
  {%- else -%}
    <span>{{ comparison_label | escape }}</span>
  {%- endif -%}
</span>
{%- if note != blank -%}<span class="qtm-comparison-matrix__note">{{ note | escape }}</span>{%- endif -%}
