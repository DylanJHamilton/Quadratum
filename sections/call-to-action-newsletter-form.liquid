{% comment %}Newsletter signup with native customer feedback, explicit marketing confirmation and configured custom routing.{% endcomment %}
{{ 'call-to-action-quote-form.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

{%- comment %} INTEGRATIONS (globals → effective values; minimal add) {% endcomment -%}
{%- assign g = settings -%}
{%- assign form_surface_color = s.form_bg | default: g.bg_base | default: '#ffffff' -%}
{%- capture form_surface_text -%}{% render 'contrast-text', background: form_surface_color, preferred: g.text_base %}{%- endcapture -%}
{%- capture form_input_text -%}{% render 'contrast-text', background: '#ffffff', preferred: g.text_base %}{%- endcapture -%}

{%- assign eff_captcha_mode = s.captcha_mode | default: g.forms_captcha_provider | default: 'none' -%}

{%- capture eff_captcha_key -%}{%- render 'form-captcha-key', mode: eff_captcha_mode, local_key: s.captcha_site_key -%}{%- endcapture -%}

{%- assign tags_theme   = g.forms_default_tags | default: 'form, web' -%}
{%- assign tags_section = s.hidden_tags | default: '' -%}
{%- assign eff_tags = tags_theme -%}
{%- if tags_section != blank -%}{%- assign eff_tags = tags_theme | append: ', ' | append: tags_section -%}{%- endif -%}

{%- assign eff_endpoint = s.endpoint_url -%}
{%- if eff_endpoint == blank and s.destination == 'custom_endpoint' -%}
  {%- assign eff_endpoint = g.forms_global_endpoint | default: '' -%}
{%- endif -%}

{%- comment %} THEME TOKENS (mirror CTA–Quote) {% endcomment -%}
{%- assign t_font_heading = settings.font_heading -%}
{%- assign c_primary      = settings.color_primary        | default: '#2563eb' -%}
{%- assign c_bg_base      = settings.bg_base              | default: '#ffffff' -%}
{%- assign c_bg_contrast  = settings.bg_contrast          | default: '#f6f7f8' -%}
{%- assign c_text_base    = settings.text_base            | default: '#111111' -%}
{%- assign c_text_muted   = settings.text_muted           | default: '#6b7280' -%}
{%- assign c_success      = settings.color_success        | default: '#16a34a' -%}
{%- assign c_error        = settings.color_error          | default: '#dc2626' -%}
{%- assign btn_default    = settings.button_variant_default | default: 'solid' -%}
{%- assign btn_radius     = settings.button_radius        | default: 12 -%}
{%- assign btn_bw         = settings.button_border_width  | default: 1 -%}
{%- assign btn_hover_op   = settings.button_hover_opacity | default: 92 -%}
{%- assign btn_active     = settings.button_active_scale  | default: 98 -%}

{%- comment %} Button variant resolution {% endcomment -%}
{%- assign btn_choice = s.button_variant | default: 'inherit' -%}
{%- assign btn_variant = btn_default -%}
{%- if btn_choice != 'inherit' and btn_choice != blank -%}{%- assign btn_variant = btn_choice -%}{%- endif -%}
{%- assign btn_mode_class = 'q-btn--solid' -%}
{%- if btn_variant == 'outline' -%}{%- assign btn_mode_class = 'q-btn--outline' -%}{%- endif -%}
{%- if btn_variant == 'ghost' -%}{%- assign btn_mode_class = 'q-btn--ghost' -%}{%- endif -%}

{%- comment %} Visibility classes {% endcomment -%}
{%- assign visibility_classes = '' -%}
{%- if s.hide_on_mobile and request.design_mode == false -%}{%- assign visibility_classes = visibility_classes | append: ' hide-mobile' -%}{%- endif -%}
{%- if s.hide_on_desktop and request.design_mode == false -%}{%- assign visibility_classes = visibility_classes | append: ' hide-desktop' -%}{%- endif -%}

{%- assign anchor = s.anchor_id | strip -%}
{%- if anchor == blank -%}{%- assign anchor = 'section-' | append: section.id -%}{%- endif -%}

{% capture automatic_button_text %}{% render 'contrast-text', background: c_primary, preferred: settings.text_on_color %}{% endcapture %}
<style>
  .q-form-scope-{{ section.id }}{
    --q-pad-y: {{ s.padding_y | default: 64 }}px;
    --q-pad-x: {{ s.padding_x | default: 24 }}px;
    --q-card-br: {{ s.card_radius | default: 16 }}px;
    --q-card-shadow: {% case s.card_shadow %}{% when 0 %}none{% when 1 %}0 1px 2px rgba(0,0,0,.06){% when 3 %}0 2px 4px rgba(0,0,0,.08), 0 16px 40px rgba(0,0,0,.12){% else %}0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.08){% endcase %};
    --q-text: {{ c_text_base }};
    --q-muted: {{ c_text_muted }};
    --q-bg: {{ s.bg_color | default: c_bg_contrast }};
    --q-btn-bg: {{ c_primary }};
    --q-btn-fg: {{ automatic_button_text }};
    --q-btn-bdr: {{ c_text_base }};
    --q-btn-bw: {{ btn_bw }}px;
    --q-btn-br: {{ btn_radius }}px;
    --q-btn-hover-op: {{ btn_hover_op }};
    --q-btn-active-scale: {{ btn_active | divided_by: 100.0 }};
  }
  .q-form-scope-{{ section.id }} .q-wrap{max-width: {% if s.container_mode == 'full' or settings.style_kit == 'full' %}100%{% elsif settings.style_kit == 'wide' %}var(--q-cont-xl, 1440px){% else %}var(--q-cont-lg, 1152px){% endif %}; margin:0 auto; padding:0 min(var(--q-pad-x), 8vw);}
  .q-form-scope-{{ section.id }} .q-bleed{position:relative;}
  .q-form-scope-{{ section.id }} .q-bg{position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none;}
  .q-form-scope-{{ section.id }} .q-media{width:100%; height:100%; object-fit:cover; display:block;}
  .q-form-scope-{{ section.id }} .q-overlay{position:absolute; inset:0; pointer-events:none;}
  .q-form-scope-{{ section.id }} .q-layer{position:relative; z-index:1; padding: var(--q-pad-y) 0;}
  .q-form-scope-{{ section.id }} .q-grid{display:grid; gap:24px; align-items:stretch;}
  @media (min-width: 768px){
    .q-form-scope-{{ section.id }} .q-grid.split-left{grid-template-columns: 1.1fr 1fr;}
    .q-form-scope-{{ section.id }} .q-grid.split-right{grid-template-columns: 1fr 1.1fr;}
  }
  .q-form-scope-{{ section.id }} .q-card{
    background: {{ s.form_bg | default: c_bg_base }};
    border-radius: var(--q-card-br);
    box-shadow: var(--q-card-shadow);
    padding: 28px;
  }
  .q-form-scope-{{ section.id }} .q-media-card{ border-radius: var(--q-card-br); overflow:hidden; background: #000; min-height: 240px; }
  .q-form-scope-{{ section.id }} .q-head .q-kicker{color: var(--q-muted); font-size: .95rem; margin:0 0 4px;}
  .q-form-scope-{{ section.id }} .q-head .q-heading{
    margin:0 0 8px; color: var(--q-text);
    {% if t_font_heading %}font-family: {{ t_font_heading.family }}, {{ t_font_heading.fallback_families }};{% endif %}
  }
  .q-form-scope-{{ section.id }} .q-head .q-sub{color: var(--q-muted); margin:0 0 16px;}

  .q-form-scope-{{ section.id }} .q-fields{display:flex; flex-wrap:wrap; gap:12px;}
  .q-form-scope-{{ section.id }} .q-field{width:100%;}
  .q-form-scope-{{ section.id }} .q-field.half{width: calc(50% - 6px);}
  @media (max-width: 639.98px){ .q-form-scope-{{ section.id }} .q-field.half{ width:100%; } }

  .q-form-scope-{{ section.id }} .q-label{display:block; font-weight:600; margin:8px 0 6px; color: var(--q-text);}
  .q-form-scope-{{ section.id }} .q-help{font-size:.875rem; color: var(--q-muted); margin:4px 0 0;}
  .q-form-scope-{{ section.id }} .q-input, .q-form-scope-{{ section.id }} .q-select, .q-form-scope-{{ section.id }} .q-textarea{
    width:100%; border:1px solid {{ s.input_border | default: '#e5e7eb' }}; border-radius: {{ s.input_radius | default: 10 }}px; padding: 12px 14px; background:#fff; color:var(--q-text);
  }
  .q-form-scope-{{ section.id }} .q-radio{ display:flex; gap:10px; align-items:center; margin: 4px 0; }
  .q-form-scope-{{ section.id }} .q-error{ color: {{ c_error }}; font-size:.85rem; margin-top:6px; }
  .q-form-scope-{{ section.id }} [aria-invalid="true"]{ border-color: {{ c_error }}; outline:1px solid {{ c_error }}; }

  .q-form-scope-{{ section.id }} .q-btn{
    display:inline-flex; align-items:center; justify-content:center;
    padding: 12px 20px; border-radius: var(--q-btn-br); border-width: var(--q-btn-bw); border-style: solid;
    transition: transform .12s ease, opacity .12s ease, background-color .12s ease, color .12s ease;
    text-decoration:none; cursor:pointer; user-select:none;
  }
  .q-form-scope-{{ section.id }} .q-btn span { color: inherit; }
  .q-form-scope-{{ section.id }} .q-btn.q-btn--solid{ background: var(--q-btn-bg); color: var(--q-btn-fg); border-color: var(--q-btn-bg); }
  .q-form-scope-{{ section.id }} .q-btn.q-btn--outline{ background: transparent; color: var(--q-btn-bg); border-color: var(--q-btn-bg); }
  .q-form-scope-{{ section.id }} .q-btn.q-btn--ghost{ background: transparent; color: var(--q-btn-bg); border-color: transparent; }
  .q-form-scope-{{ section.id }} .q-btn[disabled]{ opacity:.6; pointer-events:none; }
  .q-form-scope-{{ section.id }} .q-btn:not([disabled]):hover{ opacity: calc(var(--q-btn-hover-op) / 100); }
  .q-form-scope-{{ section.id }} .q-btn:not([disabled]):active{ transform: scale(var(--q-btn-active-scale)); }

  .q-form-scope-{{ section.id }} .q-live{ position:relative; margin:8px 0 0; min-height: 1.2em; }
  .q-form-scope-{{ section.id }} .q-live .ok{ color: {{ c_success }}; }
  .q-form-scope-{{ section.id }} .q-live .bad{ color: {{ c_error }}; }

  /* Steps */
  .q-form-scope-{{ section.id }} [data-q-steps]{ margin-top: 10px; }
  .q-form-scope-{{ section.id }} .q-steps-nav{ display:flex; align-items:center; gap:10px; margin:0 0 12px; }
  .q-form-scope-{{ section.id }} .q-steps-bar{ flex:1; height:6px; background: rgba(0,0,0,.08); border-radius:6px; overflow:hidden; }
  .q-form-scope-{{ section.id }} .q-steps-fill{ height:100%; background: var(--q-btn-bg); width:0%; }
  .q-form-scope-{{ section.id }} .q-steps-count{ font-size:.875rem; color: var(--q-muted); }
  .q-form-scope-{{ section.id }} .q-steps-actions{ display:flex; gap:8px; margin-top:16px; }
  .q-form-scope-{{ section.id }} .q-step{ display:flex; flex-wrap:wrap; gap:12px; width:100%; }
  .q-form-scope-{{ section.id }} .q-step[hidden]{ display:none !important; }

  /* Conditional */
  .q-form-scope-{{ section.id }} .is-hidden{ display:none !important; }

  /* checkbox/radio cosmetics (scoped to this section) */
  .q-form-scope-{{ section.id }} .q-radio{ display:flex; align-items:center; gap:10px; justify-content:flex-start; width:auto; max-width:100%; overflow-wrap:anywhere; }
  .q-form-scope-{{ section.id }} .q-radio input.q-input{
    width:auto; padding:0; border:1px solid rgba(0,0,0,.35); border-radius:3px; height:1.05rem; margin:0;
  }
  .q-form-scope-{{ section.id }} input.q-input[aria-invalid="true"]{
    border-color: var(--q-error, #dc2626);
    outline:2px solid var(--q-error, #dc2626);
    outline-offset:2px;
  }
  .q-form-scope-{{ section.id }} input:not([type="checkbox"]):not([type="radio"]).q-input[aria-invalid="true"],
  .q-form-scope-{{ section.id }} select[aria-invalid="true"],
  .q-form-scope-{{ section.id }} textarea[aria-invalid="true"]{
    outline:1px solid var(--q-error, #dc2626);
  }
  .q-form-scope-{{ section.id }}{min-width:0;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-wrap,.q-form-scope-{{ section.id }} .q-wrap-full{box-sizing:border-box;}
  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface,.q-form-scope-{{ section.id }} .q-grid>*{min-width:0;max-width:100%;}
  .q-form-scope-{{ section.id }} .q-field{min-width:0;max-width:100%;text-align:start;}
  .q-form-scope-{{ section.id }} .q-radio{width:auto;max-width:100%;text-align:start;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-radio span{min-width:0;}
  .q-form-scope-{{ section.id }} .q-bg{background:var(--q-bg);}
  .q-form-scope-{{ section.id }} .q-bg .q-form-background-video{position:absolute;inset:0;width:100%;height:100%;border:0;}
  .q-form-scope-{{ section.id }} .q-bg .q-form-poster{width:100%;height:100%;object-fit:cover;}
  .q-form-scope-{{ section.id }} .q-bg [hidden]{display:none !important;}
  .q-form-scope-{{ section.id }} .q-form-video-toggle{position:absolute;z-index:2;inset-inline-end:12px;bottom:12px;padding:8px 12px;border:1px solid currentColor;border-radius:4px;background:#fff;color:#111;max-width:calc(100% - 24px);}
  .q-form-scope-{{ section.id }} :is(button,a,input,select,textarea):focus-visible{outline:2px solid currentColor;outline-offset:3px;}
  .q-form-scope-{{ section.id }} .q-step{grid-column:1 / -1;min-width:0;}
  .q-form-scope-{{ section.id }} .q-step-heading{width:100%;}
  .q-form-scope-{{ section.id }} [data-q-submit]{grid-column:1 / -1;max-width:100%;}
  @media(max-width:767.98px){.q-form-scope-{{ section.id }}.hide-mobile{display:none;}}
  @media(min-width:768px){.q-form-scope-{{ section.id }}.hide-desktop{display:none;}}
  @media(prefers-reduced-motion:reduce){.q-form-scope-{{ section.id }} .q-btn{transition:none;}}

  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface{--q-text:{{ form_surface_text | strip }};--q-muted:{{ form_surface_text | strip }};}
  .q-form-scope-{{ section.id }} input.q-input,.q-form-scope-{{ section.id }} select.q-select,.q-form-scope-{{ section.id }} textarea.q-textarea{color:{{ form_input_text | strip }};box-sizing:border-box;max-width:100%;}
  .q-form-scope-{{ section.id }}{--q-btn-hover-op:{{ g.button_hover_opacity | default: 92 }};--q-btn-active-scale:{{ g.button_active_scale | default: 98 | divided_by: 100.0 }};}
  {% if g.font_heading %}.q-form-scope-{{ section.id }} .q-head :is(h2,h3){font-family:{{ g.font_heading.family }},{{ g.font_heading.fallback_families }};}{% endif %}
</style>

<section
  data-q-form-host data-video-hero data-video-hero-mobile-query="(max-width: 767.98px)"
  id="{{ anchor | escape }}"
  class="q-form-scope-{{ section.id }} q-cta-quote-form q-cta-newsletter{{ visibility_classes }}"
  role="region"
  aria-label="{{ s.aria_label | default: 'Newsletter signup' | escape }}"
  data-template="{{ s.template_style | escape }}"
  data-msg-error="{{ s.error_text | escape }}"
  data-msg-success="{{ s.success_text | escape }}"
  data-captcha="{{ eff_captcha_mode | escape }}"
  data-captcha-key="{{ eff_captcha_key | escape }}"
  data-btn-variant="{{ btn_mode_class | escape }}"
  {% if s.destination == 'custom_endpoint' %}data-q-attrib-create="1"{% endif %}
>
  <div class="q-bleed">
    {% render 'form-background', settings: s, providers: true %}

    <div class="q-layer">
      <div class="q-wrap">
        {%- assign is_split_left = false -%}
        {%- assign is_split_right = false -%}
        {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'left' -%}{%- assign is_split_left = true -%}{%- endif -%}
        {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'right' -%}{%- assign is_split_right = true -%}{%- endif -%}

        <div class="q-grid{% if is_split_left %} split-left{% endif %}{% if is_split_right %} split-right{% endif %}">

          {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'left' -%}
            <div class="q-media-card">
              {{ s.split_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: s.split_image.alt }}
            </div>
          {%- endif -%}

          <div class="q-card" data-q-form-card>
            <header class="q-head">
              {%- if s.kicker != blank -%}<p class="q-kicker">{{ s.kicker | escape }}</p>{%- endif -%}
              {%- assign htag = s.heading_level | default: 'h2' -%}
              {%- if s.heading != blank -%}{%- if htag == 'h3' -%}<h3 class="q-heading">{{ s.heading | escape }}</h3>{%- else -%}<h2 class="q-heading">{{ s.heading | escape }}</h2>{%- endif -%}{%- endif -%}
              {%- if s.subheading != blank -%}<p class="q-sub">{{ s.subheading | escape }}</p>{%- endif -%}
            </header>

            {% render 'form-dispatch',
              id: section.id,
              settings: section.settings,
              blocks: section.blocks,
              theme_settings: g,
              form_source: 'newsletter',
              require_email: true,
              eff_captcha_mode: eff_captcha_mode,
              eff_captcha_key: eff_captcha_key,
              eff_endpoint_url: eff_endpoint,
              eff_tags: eff_tags
            %}
          </div>

          {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'right' -%}
            <div class="q-media-card">
              {{ s.split_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: s.split_image.alt }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'frontend-form-logic.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "CTA – Newsletter",
  "tag": "section",
  "class": "q-cta-quote-form q-cta-newsletter",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Newsletter signup" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "template_style", "label": "Template", "default": "card", "options": [
      { "value": "card", "label": "Card" },
      { "value": "split", "label": "Split" },
      { "value": "steps", "label": "Steps" }
    ]},
    { "type": "select", "id": "split_media_side", "label": "Split: media position", "default": "left", "options": [
      { "value": "left", "label": "Media left" },
      { "value": "right", "label": "Media right" }
    ]},
    { "type": "image_picker", "id": "split_image", "label": "Split: image" },
    { "type": "text", "id": "anchor_id", "label": "Optional anchor ID" },

    { "type": "header", "content": "Background (root)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "text", "id": "bg_video", "label": "Background video URL (MP4, YouTube, Vimeo)", "info": "Use an HTTPS MP4 or a YouTube/Vimeo video URL. Background image/color remains the fallback; playback starts paused for reduced motion and in the editor." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f6f7f8" },
    { "type": "select", "id": "overlay_type", "label": "Overlay", "default": "solid", "options": [
      { "value": "none", "label": "None" },
      { "value": "solid", "label": "Solid" },
      { "value": "gradient", "label": "Gradient" }
    ]},
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 35, "unit": "%" },
    { "type": "color", "id": "grad_start", "label": "Gradient start", "default": "#000000" },
    { "type": "range", "id": "grad_start_opacity", "label": "Start opacity", "min": 0, "max": 100, "step": 5, "default": 40, "unit": "%" },
    { "type": "color", "id": "grad_end", "label": "Gradient end", "default": "#000000" },
    { "type": "range", "id": "grad_end_opacity", "label": "End opacity", "min": 0, "max": 100, "step": 5, "default": 0, "unit": "%" },
    { "type": "range", "id": "grad_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 5, "default": 180, "unit": "deg" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Accent (kicker)", "default": "Join the list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get emails you’ll actually open" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "default": "h2", "options": [
      { "value": "h2", "label": "H2" },
      { "value": "h3", "label": "H3" }
    ]},
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Fresh articles, launch news, and occasional deals." },
    { "type": "text", "id": "success_text", "label": "Success message", "info": "Shown after a successful Shopify response. Confirmation emails depend on store double opt-in settings; custom endpoints own their response.", "default": "Thanks! Check your inbox." },
    { "type": "text", "id": "error_text", "label": "Error message", "default": "Please fix the highlighted fields and try again." },

    { "type": "header", "content": "Destination" },
    { "type": "select", "id": "destination", "label": "Send signups to", "default": "shopify_customer", "options": [
      { "value": "shopify_customer", "label": "Shopify newsletter (accepts_marketing)" },
      { "value": "custom_endpoint", "label": "Custom endpoint (POST)" }
    ]},
    { "type": "url", "id": "endpoint_url", "label": "Custom endpoint URL (HTTPS)", "info": "A configured endpoint must process the POST, captcha and marketing provider integration. Metadata does not enable delivery by itself." },
    { "type": "text", "id": "hidden_tags", "label": "Hidden tags/params (comma-separated)", "default": "newsletter, web" },

    { "type": "header", "content": "CAPTCHA" },
    { "type": "select", "id": "captcha_mode", "label": "Captcha provider", "info": "Custom endpoints only. Native Shopify signup uses Shopify spam protection. Custom providers also require server verification.", "default": "none", "options": [
      { "value": "none", "label": "None" },
      { "value": "turnstile", "label": "Cloudflare Turnstile" },
      { "value": "recaptcha_v3", "label": "reCAPTCHA v3" }
    ]},
    { "type": "text", "id": "captcha_site_key", "label": "Captcha site key" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "select", "id": "button_variant", "label": "Variant", "default": "inherit", "options": [
      { "value": "inherit", "label": "— Theme default —" },
      { "value": "solid", "label": "Solid" },
      { "value": "outline", "label": "Outline" },
      { "value": "ghost", "label": "Ghost" }
    ]},

    { "type": "header", "content": "Form UI" },
