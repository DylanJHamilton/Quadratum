{
  "sections": {
    "orvaine_1": {
      "type": "sub-banner-breadcrumb",
      "settings": {
        "layout_style": "media",
        "image": "shopify://shop_images/orvaine-crossbody-bags-hero.webp",
        "image_alt": "Stone crossbody bag resting on a travertine ledge in soft light.",
        "overlay_mode": "gradient",
        "grad_start": "#24211F",
        "grad_end": "#24211F",
        "grad_end_opacity": 30,
        "grad_angle": 90,
        "min_height_vh": 48,
        "min_height_vh_mobile": 56,
        "content_max_w": "max-w-3xl",
        "text_alignment": "left",
        "show_breadcrumb": true,
        "home_label": "Home",
        "separator": "/",
        "crumb_color": "#EDE6DC",
        "crumb_active_color": "#F8F6F2",
        "show_heading": true,
        "heading": "Contact ORVAINE.",
        "heading_level": "h1",
        "heading_size": "4xl",
        "subheading": "Questions about a design, a family or this concept store. Write to us and we will answer.",
        "heading_color": "#F8F6F2",
        "subheading_color": "#EDE6DC",
        "enable_overlap": false,
        "simple_mode": true,
        "grad_start_opacity": 96
      },
      "blocks": {
        "er_1": {
          "type": "button",
          "settings": {
            "label": "Write to us",
            "link": "#write",
            "size": "lg",
            "button_mode": "solid",
            "use_theme_colors": false,
            "bg_color": "#D4B991",
            "text_color": "#24211F",
            "border_color": "#D4B991",
            "border_width": 1,
            "radius": 2
          }
        },
        "er_2": {
          "type": "button",
          "settings": {
            "label": "Client care",
            "link": "/pages/orvaine-client-care",
            "size": "lg",
            "button_mode": "outline",
            "use_theme_colors": false,
            "bg_color": "transparent",
            "text_color": "#F8F6F2",
            "border_color": "#F8F6F2",
            "border_width": 1,
            "radius": 2
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2"
      ]
    },
    "orvaine_2": {
      "type": "form-compact",
      "settings": {
        "aria_label": "Contact form",
        "template_style": "split",
        "surface_style": "card",
        "split_media_side": "right",
        "split_image": "shopify://shop_images/orvaine-top-handle-satchels-editorial.webp",
        "bg_color": "#F8F6F2",
        "overlay_type": "none",
        "kicker": "Write to us",
        "heading": "Send a message.",
        "heading_level": "h2",
        "subheading": "Fields marked with an asterisk are required.",
        "success_text": "Thank you. We will reply by email.",
        "error_text": "Please fix the highlighted fields and try again.",
        "hidden_tags": "contact, orvaine",
        "button_label": "Send message",
        "form_bg": "#FFFFFF",
        "container_mode": "contained",
        "padding_y": 96,
        "padding_x": 24,
        "anchor_id": "write",
        "input_radius": 2,
        "input_border": 1,
        "card_radius": 4,
        "card_shadow": "none",
        "button_variant": "solid",
        "destination": "shopify_contact",
        "captcha_mode": "inherit"
      },
      "blocks": {
        "or_field_1": {
          "type": "field",
          "settings": {
            "label": "Full name",
            "field_type": "text",
            "name_attr": "contact[name]",
            "required": true,
            "width": "half"
          }
        },
        "or_field_2": {
          "type": "field",
          "settings": {
            "label": "Email",
            "field_type": "email",
            "name_attr": "contact[email]",
            "required": true,
            "width": "half"
          }
        },
        "or_field_3": {
          "type": "field",
          "settings": {
            "label": "What is it about?",
            "field_type": "select",
            "name_attr": "contact[topic]",
            "required": true,
            "width": "full",
            "options": "A specific design\nChoosing a shape\nPress and partnerships\nThis concept store\nSomething else"
          }
        },
        "or_field_4": {
          "type": "field",
          "settings": {
            "label": "Message",
            "field_type": "textarea",
            "name_attr": "contact[body]",
            "required": true,
            "width": "full"
          }
        }
      },
      "block_order": [
        "or_field_1",
        "or_field_2",
        "or_field_3",
        "or_field_4"
      ]
    },
    "orvaine_3": {
      "type": "interactive-content-helper-cards",
      "settings": {
        "show_header": true,
        "heading": "Other ways in.",
        "subheading": "<p>There is no showroom or phone line for this concept. These are the places to start.</p>",
        "columns_desktop": 3,
        "columns_tablet": 1,
        "columns_mobile": 1,
        "design_preset": "minimal",
        "hover_style": "none",
        "layout_mode": "grid",
        "card_variant": "icon_card",
        "content_align": "left",
        "card_radius": 4,
        "use_custom_colors": true,
        "color_bg": "#EEE8DF",
        "color_text": "#24211F",
        "color_muted": "#5E544B",
        "color_accent": "#69343B",
        "color_surface": "#FFFFFF",
        "color_border": "#E2DBD0"
      },
      "blocks": {
        "or_1": {
          "type": "card",
          "settings": {
            "title": "Email",
            "body": "<p>For questions about a design or this concept.</p>",
            "icon": "",
            "badge": "",
            "cta_label": "Write to us",
            "cta_url": "mailto:hello@orvaine.example"
          }
        },
        "or_2": {
          "type": "card",
          "settings": {
            "title": "Client care",
            "body": "<p>Specifications, colors, care and imagery, answered by topic.</p>",
            "icon": "",
            "badge": "",
            "cta_label": "Visit client care",
            "cta_url": "/pages/orvaine-client-care"
          }
        },
        "or_3": {
          "type": "card",
          "settings": {
            "title": "Shape Finder",
            "body": "<p>Not sure which silhouette suits you? Start by occasion or size.</p>",
            "icon": "",
            "badge": "",
            "cta_label": "Find your shape",
            "cta_url": "/pages/orvaine-shape-finder"
          }
        }
      },
      "block_order": [
        "or_1",
        "or_2",
        "or_3"
      ]
    },
    "orvaine_4": {
      "type": "interactive-content-helper-tabs-accordion",
      "settings": {
        "show_header": true,
        "heading": "Quick answers.",
        "subheading": "",
        "layout_mode": "accordion",
        "style_preset": "faq",
        "accordion_default_open": "all_closed",
        "use_custom_colors": true,
        "bg": "#F8F6F2",
        "text": "#24211F",
        "muted": "#5E544B",
        "accent": "#69343B",
        "border": "#E2DBD0"
      },
      "blocks": {
        "or_1": {
          "type": "item",
          "settings": {
            "label": "Is there a showroom?",
            "content": "<p>No. ORVAINE is a fictional concept store with no showroom, address or phone line.</p>",
            "icon": ""
          }
        },
        "or_2": {
          "type": "item",
          "settings": {
            "label": "Can I order a design?",
            "content": "<p>Not yet. Checkout is disabled and nothing is charged.</p>",
            "icon": ""
          }
        },
        "or_3": {
          "type": "item",
          "settings": {
            "label": "Do you work with press?",
            "content": "<p>Choose \"Press and partnerships\" in the form and tell us what you need.</p>",
            "icon": ""
          }
        }
      },
      "block_order": [
        "or_1",
        "or_2",
        "or_3"
      ]
    }
  },
  "order": [
    "orvaine_1",
    "orvaine_2",
    "orvaine_3",
    "orvaine_4"
  ]
}
