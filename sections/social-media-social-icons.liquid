{% comment %}
  Quadratum — Social Media: Social Icons Row (reset)

  Goals:
  • Standalone section showing social icons in a row
  • Optional heading/body (can be hidden for icon-only row)
  • Uses simple glyph icons (no external snippet dependency)
  • Safe schema (no invalid defaults)
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign g = settings -%}

{%- comment %}
  Global social URL fallbacks from Theme Settings → Integrations → Social Profile Links
{%- endcomment -%}
{%- assign social_fb  = g.social_url_facebook -%}
{%- assign social_ig  = g.social_url_instagram -%}
{%- assign social_tt  = g.social_url_tiktok -%}
{%- assign social_yt  = g.social_url_youtube -%}
{%- assign social_tw  = g.social_url_twitter -%}
{%- assign social_pin = g.social_url_pinterest -%}

{%- comment -%} Styles are defined in this section below. {%- endcomment -%}



{% assign social_count = 0 %}{% capture social_content %}
<section
  id="social-media-social-icons-{{ section.id }}"
  class="
    q-social-icons
    q-social-icons--layout-{{ s.layout_variant }}
    q-social-icons--style-{{ s.style }}
    {% unless s.show_labels %}q-social-icons--labels-hidden{% endunless %}
  "
  style="--q-social-gap: {{ s.gap }}px;"
  aria-label="{{ s.aria_label | escape }}"
>
  <div class="q-container">
    <div
      class="
        q-social-icons__inner
        q-align-{{ s.align }}
        q-justify-{{ s.justify }}
      "
    >
      {%- unless s.hide_text -%}
        {%- if s.eyebrow != blank or s.heading != blank or s.body != blank -%}
          <div class="q-social-icons__header">
            {%- if s.eyebrow != blank -%}
              <p class="q-social-icons__eyebrow">
                {{ s.eyebrow | escape }}
              </p>
            {%- endif -%}
            {%- if s.heading != blank -%}
              <h2 class="q-social-icons__heading">
                {{ s.heading | escape }}
              </h2>
            {%- endif -%}
            {%- if s.body != blank -%}
              <p class="q-social-icons__body">
                {{ s.body | escape | newline_to_br }}
              </p>
            {%- endif -%}
        </div>
        {%- endif -%}
      {%- endunless -%}

      {%- if section.blocks.size > 0 -%}
        <ul
          class="q-social-icons__list q-social-icons__list--{{ s.layout_variant }}"
          role="list"
          style="
            --q-social-gap: {{ s.gap }}px;

          "
        >
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}

            {%- comment %}
              Resolve URL:
              1. Block-level URL
              2. Global theme social URL (by network)
            {%- endcomment -%}
            {%- assign url = b.url -%}
            {%- if url == blank -%}
              {%- case b.network -%}
                {%- when 'facebook'  -%}{%- assign url = social_fb  -%}
                {%- when 'instagram' -%}{%- assign url = social_ig  -%}
                {%- when 'tiktok'    -%}{%- assign url = social_tt  -%}
                {%- when 'youtube'   -%}{%- assign url = social_yt  -%}
                {%- when 'twitter'   -%}{%- assign url = social_tw  -%}
                {%- when 'pinterest' -%}{%- assign url = social_pin -%}
              {%- endcase -%}
            {%- endif -%}

            {%- capture url -%}{%- render 'account-safe-link', url: url -%}{%- endcapture -%}
            {%- if url != blank -%}{% assign social_count = social_count | plus: 1 %}
              {% liquid
                assign glyph = '●'
                case b.network
                  when 'facebook'
                    assign glyph = 'f'
                  when 'instagram'
                    assign glyph = 'IG'
                  when 'tiktok'
                    assign glyph = 'T'
                  when 'twitter'
                    assign glyph = 'X'
                  when 'youtube'
                    assign glyph = '▶'
                  when 'pinterest'
                    assign glyph = 'P'
                  when 'linkedin'
                    assign glyph = 'in'
                  when 'other'
                    assign glyph = '●'
                endcase
              %}

              <li {{ block.shopify_attributes }}><a
                href="{{ url | escape }}"
                class="q-social-icons__item"
                {% if s.open_in_new_tab %}
                  target="_blank"
                  rel="noopener noreferrer"
                {% endif %}
              >
                <span
                  class="q-social-icons__icon"
                  style="--q-icon-size: {{ s.icon_size }}px;"
                  aria-hidden="true"
                >
                  {{ glyph }}
                </span>

                {%- if s.show_labels -%}
                  <span class="q-social-icons__label">
                    {{ b.label | default: b.network | escape }}
                  </span>
                {%- else -%}
                  <span class="visually-hidden">
                    {{ b.sr_label | default: b.label | default: b.network | escape }}
                  </span>
                {%- endif -%}
              </a></li>
            {% elsif request.design_mode %}<li {{ block.shopify_attributes }}>Configure a profile URL for {{ b.network | escape }}.</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{% endcapture %}
{% if social_count > 0 or request.design_mode %}{{ social_content }}{% endif %}
<style>

  #social-media-social-icons-{{ section.id }}.q-social-icons {
    padding: var(--q-section-pad-y, 48px) 0;
  }

  #social-media-social-icons-{{ section.id }}.q-social-icons .q-container {
    max-width: var(--container-md, 960px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:inherit;
    margin-bottom: 0.25rem;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__heading {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__body {
    margin: 0;
    color:inherit;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__inner.q-align-left .q-social-icons__header {
    text-align: left;
  }
  #social-media-social-icons-{{ section.id }} .q-social-icons__inner.q-align-right .q-social-icons__header {
    text-align: right;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--q-social-gap, 16px);
    justify-content: safe center;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__item {
    display: inline-flex;
    align-items: center;
    justify-content: safe center;
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1;
    border-radius: 999px;
    padding: 0.5rem 0.875rem;
    background-color: var(--c-surface,#f3f4f6);
    color: var(--c-text,#111111);
    transition: transform 120ms ease, background-color 120ms ease,
      box-shadow 120ms ease, color 120ms ease;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__item:hover {
    transform: translateY(-1px);
    background-color:var(--c-bg,#fff);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__item:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.2);
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__icon {
    --q-icon-size: 22px;
    width: var(--q-icon-size);
    height: var(--q-icon-size);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: safe center;
    margin-inline-end:0;flex-shrink:0;
    background-color: var(--c-primary,#111827);
    color: var(--c-oncolor,#ffffff);
    font-size: calc(var(--q-icon-size) * 0.55);
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__label {
    white-space:normal;
  }

  /* layout variants */
  #social-media-social-icons-{{ section.id }} .q-social-icons__list--wrap {
    flex-wrap: wrap;
  }

  #social-media-social-icons-{{ section.id }} .q-social-icons__inner.q-justify-flex-start .q-social-icons__list {
    justify-content: flex-start;
  }
  #social-media-social-icons-{{ section.id }} .q-social-icons__inner.q-justify-center .q-social-icons__list {
    justify-content: safe center;
  }
  #social-media-social-icons-{{ section.id }} .q-social-icons__inner.q-justify-flex-end .q-social-icons__list {
    justify-content: safe flex-end;
  }

  /* style variants */
  #social-media-social-icons-{{ section.id }}.q-social-icons--style-soft .q-social-icons__item {
    background-color:var(--c-bg,#fff);
  }
  #social-media-social-icons-{{ section.id }}.q-social-icons--style-soft .q-social-icons__item:hover {
    background-color:var(--c-surface,#f3f4f6);
  }

  #social-media-social-icons-{{ section.id }}.q-social-icons--style-bare .q-social-icons__item {
    background: transparent;
    padding: 0;
    box-shadow: none;
  }
  #social-media-social-icons-{{ section.id }}.q-social-icons--style-bare .q-social-icons__item:hover {
    background: transparent;
    box-shadow: none;
    transform: none;
  }
  #social-media-social-icons-{{ section.id }}.q-social-icons--style-bare .q-social-icons__icon {
    margin-right: 0;
  }

  /* icon-only mode (hide visible labels, keep sr-only) */
  #social-media-social-icons-{{ section.id }}.q-social-icons--labels-hidden .q-social-icons__label {
    display: none;
  }

  @media (max-width: 640px) {
    #social-media-social-icons-{{ section.id }}.q-social-icons .q-container {
      padding: 0 1.25rem;
    }
  }

  #social-media-social-icons-{{ section.id }} .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }


#social-media-social-icons-{{ section.id }} .q-social-icons-row {
  padding: var(--q-section-pad-y, 2.5rem) 0;
}

/* leaving legacy row styles in case you reference them elsewhere  */

#social-media-social-icons-{{ section.id }}{color:var(--c-text,#111111);font-family:var(--font-body);overflow-wrap:anywhere;min-width:0;max-width:100%}
#social-media-social-icons-{{ section.id }} *,#social-media-social-icons-{{ section.id }} *::before,#social-media-social-icons-{{ section.id }} *::after{box-sizing:border-box;min-width:0}
#social-media-social-icons-{{ section.id }} :is(h2,h3){font-family:var(--font-head)}
#social-media-social-icons-{{ section.id }} :is(a,button,[tabindex]):focus-visible{outline:2px solid currentColor;outline-offset:3px}
#social-media-social-icons-{{ section.id }} :is(a,button){max-width:100%;overflow-wrap:anywhere}
#social-media-social-icons-{{ section.id }} [hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){#social-media-social-icons-{{ section.id }} *,#social-media-social-icons-{{ section.id }} *::before,#social-media-social-icons-{{ section.id }} *::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}

#social-media-social-icons-{{ section.id }} .q-social-icons__list{list-style:none;margin:0;padding:4px;overflow-x:auto;max-width:100%}
#social-media-social-icons-{{ section.id }} .q-social-icons__list--inline{flex-wrap:nowrap}
#social-media-social-icons-{{ section.id }} .q-social-icons__list--wrap{flex-wrap:wrap}
#social-media-social-icons-{{ section.id }} .q-social-icons__list>li{flex:0 0 auto;max-width:100%}
#social-media-social-icons-{{ section.id }} .q-social-icons__item{gap:8px;min-height:44px}
@media(max-width:640px){#social-media-social-icons-{{ section.id }}.q-social-icons .q-social-icons__inner .q-social-icons__list{flex-wrap:{% if s.wrap_on_mobile %}wrap{% else %}nowrap{% endif %};justify-content:{% if s.wrap_on_mobile %}{{ s.justify }}{% else %}flex-start{% endif %}}}

</style>

{% schema %}
{
  "name": "Social Media - Icon Row",
  "tag": "section",
  "class": "q-host-social-media-social-icons",
  "settings": [
    {
      "type": "paragraph",
      "content": "Native profile links only. A block URL takes precedence over the matching global social URL. Configure actual profiles; no account connection or live feed is provided."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Connect with us"
    },
    {
      "type": "checkbox",
      "id": "hide_text",
      "label": "Hide heading and description",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show network labels (Facebook, Instagram, etc.)",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Icon layout",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline row"
        },
        {
          "value": "wrap",
          "label": "Wrapped row"
        }
      ]
    },
    {
      "type": "select",
      "id": "justify",
      "label": "Icon alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Icon style",
      "default": "pill",
      "options": [
        {
          "value": "pill",
          "label": "Pill buttons"
        },
        {
          "value": "soft",
          "label": "Soft background"
        },
        {
          "value": "bare",
          "label": "Icons only (no box)"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size (px)",
      "min": 16,
      "max": 40,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between icons (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "wrap_on_mobile",
      "label": "Wrap icons on small screens",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open links in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "default": "Social media links"
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "facebook",
          "options": [
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "twitter",
              "label": "Twitter / X"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "sr_label",
          "label": "Screen reader label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Social Media - Icon Row",
      "category": "Social Media",
      "blocks": [
        {
          "type": "social_link",
          "settings": {
            "network": "facebook",
            "label": "Facebook",
            "sr_label": "Visit us on Facebook"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "network": "instagram",
            "label": "Instagram",
            "sr_label": "Visit us on Instagram"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "network": "tiktok",
            "label": "TikTok",
            "sr_label": "Visit us on TikTok"
          }
        }
      ]
    }
  ]
}
{% endschema %}
