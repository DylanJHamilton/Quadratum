{%- if sort_options.size > 0 -%}
{%- assign current_sort = sort_by | default: default_sort_by -%}
<form class="qcm__sort" method="get" action="{{ results_url | escape }}">
  {% render 'collection-query-fields', is_search_context: is_search_context, terms_q: terms_q, filters: filters, keep_filters: true %}
  {%- if s.sort_style == 'pills' -%}
    <div class="qcm__sortPills">{%- for opt in sort_options -%}<button class="qcm__pill" type="submit" name="sort_by" value="{{ opt.value | escape }}" aria-pressed="{% if opt.value == current_sort %}true{% else %}false{% endif %}">{{ opt.name | escape }}</button>{%- endfor -%}</div>
  {%- else -%}
    <label>Sort <select name="sort_by" data-qcm-sort>{%- for opt in sort_options -%}<option value="{{ opt.value | escape }}" {% if opt.value == current_sort %}selected{% endif %}>{{ opt.name | escape }}</option>{%- endfor -%}</select></label>
    <button class="qcm__btn" type="submit">Apply sort</button>
  {%- endif -%}
</form>
{%- endif -%}
