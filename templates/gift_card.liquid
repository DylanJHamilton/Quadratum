{% layout 'password' %}
<h1>{{ shop.name | escape }} — Gift card</h1>
<p>Initial value: {{ gift_card.initial_value | money_with_currency }}</p>
<p>Balance: {{ gift_card.balance | money_with_currency }}</p>
{% if gift_card.enabled == false or gift_card.expired %}
  <p>This gift card is no longer available.</p>
{% else %}
  <label for="GiftCardCode">Use this code at checkout</label>
  <input id="GiftCardCode" type="text" readonly value="{{ gift_card.code | format_code }}" autocomplete="off">
{% endif %}
{% if gift_card.expires_on %}<p>Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}
{% if gift_card.pass_url %}<a href="{{ gift_card.pass_url }}">Add to Apple Wallet</a>{% endif %}
<a class="qtm-button" href="{{ routes.root_url }}">Continue shopping</a>
