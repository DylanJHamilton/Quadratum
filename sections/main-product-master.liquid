      "default": "summary",
      "options": [
        { "value": "summary", "label": "Sticky: summary" },
        { "value": "media", "label": "Sticky: media" },
        { "value": "none", "label": "Sticky: none" }
      ]
    },
    {
      "type": "select",
      "id": "thumb_placement_desktop",
