{{ 'documentation-hub.css' | asset_url | stylesheet_tag }}
<section class="q-docs" aria-labelledby="Support-{{ section.id }}">
  <header class="q-docs__heading"><p class="q-docs__eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 id="Support-{{ section.id }}">{{ section.settings.heading | escape }}</h1><div class="rte">{{ section.settings.intro }}</div>{% if section.settings.guide_link != blank %}<a href="{{ section.settings.guide_link | escape }}">{{ section.settings.guide_label | escape }} ↗</a>{% endif %}</header>
  <div class="q-docs__support">
    <div class="q-docs__main">
      <h2>{{ section.settings.help_heading | escape }}</h2>
      <div class="rte">{{ section.settings.help_text }}</div>
      {% for block in section.blocks %}<details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% endfor %}
      <p>Do not send passwords, payment information or sensitive personal information.</p>
    </div>
    {% assign support_form_id = 'ThemeSupport-' | append: section.id %}
    {% form 'contact', id: support_form_id, class: 'q-docs__form' %}
      {% if form.posted_successfully? %}<p role="status" tabindex="-1">Your message was submitted. Thank you for including the details.</p>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div><label for="SupportName-{{ section.id }}">Name</label><input id="SupportName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required></div>
      <div><label for="SupportEmail-{{ section.id }}">Email</label><input id="SupportEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" required></div>
      <div><label for="SupportReference-{{ section.id }}">Product or order reference (optional)</label><input id="SupportReference-{{ section.id }}" type="text" name="contact[Reference]"></div>
      <div><label for="SupportTopic-{{ section.id }}">Topic</label><select id="SupportTopic-{{ section.id }}" name="contact[Topic]"><option>Product question</option><option>Order question</option><option>Product care</option><option>Other</option></select></div>
      <div><label for="SupportMessage-{{ section.id }}">What do you need help with?</label><textarea id="SupportMessage-{{ section.id }}" name="contact[body]" required>{{ form.body | escape }}</textarea></div>
      <div><label for="SupportScreenshot-{{ section.id }}">Image link (optional)</label><input id="SupportScreenshot-{{ section.id }}" type="url" name="contact[Image link]" aria-describedby="SupportScreenshotHelp-{{ section.id }}"><p id="SupportScreenshotHelp-{{ section.id }}">Link to an image you are comfortable sharing. Remove personal information first.</p></div>
      <button type="submit">{{ section.settings.button_label | escape }}</button>
    {% endform %}
  </div>
</section>
{% schema %}
{"name":"Customer care","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CUSTOMER CARE"},{"type":"text","id":"heading","label":"Heading","default":"A useful answer starts here."},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Ask about a product, an order or a detail you would like to know.</p>"},{"type":"url","id":"guide_link","label":"Guide link"},{"type":"text","id":"guide_label","label":"Guide link label","default":"Read the guide"},{"type":"text","id":"help_heading","label":"Help heading","default":"Tell us a little more."},{"type":"richtext","id":"help_text","label":"Help text","default":"<p>Include the product name or order reference and describe what you would like to know.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Send your question"}],"blocks":[{"type":"answer","name":"Helpful answer","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product questions"},{"type":"richtext","id":"text","label":"Answer","default":"<p>Include the product name and the detail you would like to know.</p>"}]}],"presets":[{"name":"Customer care","blocks":[{"type":"answer"}]}]}
{% endschema %}
