      "options": [
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" },
        { "value": "lg", "label": "LG" }
      ]
    },
    {
      "type": "select",
      "id": "pad_x",
      "label": "Horizontal padding token",
      "default": "md",
      "options": [
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" },
        { "value": "lg", "label": "LG" }
      ]
    },

