          "type": "item",
          "settings": {
            "label": "Which fit should I choose between the Axis shirts?",
            "content": "<p>The Axis Slim Dress Shirt is built around a narrow torso; the Axis Regular Dress Shirt is the same design in a more generous cut. The Broadline Athletic Shirt is a broader-chest concept with a defined waist.</p>",
            "icon": ""
          }
        },
        "van_3": {
          "type": "item",
          "settings": {
            "label": "Are the blazer and trouser sold as a set?",
            "content": "<p>No. Coordinating pieces such as the Frame Waist Blazer and Frame Wide Leg Trouser are designed together and chosen separately, each with its own size and price.</p>",
