{%- liquid
  assign heading_tag = block.settings.html_tag | default: 'h2'
  assign heading_text = block.settings.heading_text | default: 'Heading'
  assign highlight_text = block.settings.highlight_text | strip
  assign rendered_heading = heading_text | escape

  if highlight_text != blank
    assign escaped_highlight = highlight_text | escape
    assign highlight_markup = '<span class="qtm-heading__highlight">' | append: escaped_highlight | append: '</span>'
    assign rendered_heading = rendered_heading | replace: escaped_highlight, highlight_markup
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'heading' %}

<{{ heading_tag }}
  class="
    qtm-heading
    qtm-heading--{{ block.settings.heading_style }}
    {% if block.settings.enable_gradient_text %} qtm-heading--gradient{% endif %}
    {% if block.settings.enable_accent_underline %} qtm-heading--underline{% endif %}
  "
  style="
    --qtm-heading-color: {{ block.settings.text_color }};
    --qtm-heading-max-width: {{ block.settings.max_width }}px;
    --qtm-heading-font-family: {% if block.settings.font_family == 'heading' %}var(--font-heading-family){% elsif block.settings.font_family == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
    --qtm-heading-font-weight: {{ block.settings.font_weight }};
    --qtm-heading-letter-spacing: {{ block.settings.letter_spacing }}px;
    --qtm-heading-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
    {% if block.settings.enable_gradient_text and block.settings.text_gradient != blank %}
      --qtm-heading-gradient: {{ block.settings.text_gradient }};
    {% endif %}
    --qtm-heading-underline-color: {{ block.settings.underline_color }};
    --qtm-heading-highlight-color: {{ block.settings.highlight_color }};
    --qtm-heading-highlight-background: {{ block.settings.highlight_background }};
    --qtm-heading-highlight-radius: {{ block.settings.highlight_radius }}px;
    --qtm-heading-highlight-padding-x: {{ block.settings.highlight_padding_x }}em;
  "
>
  {{ rendered_heading }}
</{{ heading_tag }}>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
