        { "value": "16", "label": "Medium (16)" },
        { "value": "10", "label": "Small (10)" },
        { "value": "0", "label": "Square (0)" }
      ]
    },
    { "type": "range", "id": "badge_border_width", "label": "Badge border width (px)", "min": 0, "max": 4, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "badge_pad_y",
      "label": "Badge padding Y token",
      "default": "xs",
      "options": [
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" }
      ]
    },
    {
      "type": "select",
      "id": "badge_pad_x",
      "label": "Badge padding X token",
      "default": "sm",
      "options": [
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" }
      ]
    },

    { "type": "header", "content": "Controls styling (carousel mode)" },
    { "type": "range", "id": "control_size", "label": "Control size (px)", "min": 28, "max": 72, "step": 1, "default": 40 },
    {
      "type": "select",
      "id": "control_radius",
      "label": "Control radius (px)",
      "default": "999",
      "options": [
        { "value": "999", "label": "Pill (999)" },
        { "value": "24", "label": "Large (24)" },
        { "value": "16", "label": "Medium (16)" },
        { "value": "10", "label": "Small (10)" },
        { "value": "0", "label": "Square (0)" }
      ]
    },
    { "type": "range", "id": "control_border_width", "label": "Control border width (px)", "min": 0, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "dot_size", "label": "Dot size (px)", "min": 6, "max": 18, "step": 1, "default": 8 },
    { "type": "range", "id": "dot_active_scale", "label": "Dot active scale (%)", "min": 100, "max": 160, "step": 5, "default": 125 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Your message" },
