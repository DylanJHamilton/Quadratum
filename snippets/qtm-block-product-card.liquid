{%- comment -%}Native merchandising cards; prefix comes from fixed Theme Block callers.{%- endcomment -%}
{%- liquid
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_alt = card_product.featured_image.alt | default: card_product.title
  assign card_sale = false
  if card_variant != blank and card_variant.compare_at_price > card_variant.price
    assign card_sale = true
  endif
-%}
<article class="{{ prefix }}__item" data-qtm-product-card data-card-product-id="{{ card_product.id }}">
  <div class="{{ prefix }}__card">
    <a class="{{ prefix }}__media" href="{{ card_product.url | escape }}" aria-label="{{ card_product.title | escape }}">
      {% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', sizes: '(max-width: 749px) 90vw, (max-width: 989px) 45vw, 30vw', alt: card_alt }}{% else %}<span class="{{ prefix }}__placeholder" aria-hidden="true"></span>{% endif %}
      {% if block.settings.show_sale_badge and card_sale and block.settings.sale_badge_text != blank %}<span class="{{ prefix }}__badge">{{ block.settings.sale_badge_text | escape }}</span>{% endif %}
    </a>
    <div class="{{ prefix }}__content">
      {% if block.settings.show_vendor and card_product.vendor != blank %}<div class="{{ prefix }}__vendor">{{ card_product.vendor | escape }}</div>{% endif %}
      <h3 class="{{ prefix }}__title"><a href="{{ card_product.url | escape }}">{{ card_product.title | escape }}</a></h3>
      {% if block.settings.show_price and card_variant != blank %}<div class="{{ prefix }}__price-row"><span class="{{ prefix }}__price">{{ card_variant.price | money }}</span>{% if card_sale %}<s class="{{ prefix }}__compare">{{ card_variant.compare_at_price | money }}</s>{% endif %}</div>{% endif %}
      {% if block.settings.show_button and block.settings.button_label != blank %}<a class="{{ prefix }}__button" href="{{ card_product.url | escape }}" aria-label="{{ block.settings.button_label | escape }}: {{ card_product.title | escape }}">{{ block.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</article>
