        "section_gap": 32,
        "row_gap": 32,
        "column_gap": 48,
        "vertical_alignment": "start",
        "mobile_behavior": "stack",
        "enable_sticky_add_to_cart": true,
        "sticky_offset": 24,
        "product_media_priority": "gallery-first",
        "mobile_product_layout": "gallery-first",
        "background_color": "#F6F1E7",
        "overlay_opacity": 0,
        "padding_top": 24,
        "padding_bottom": 64,
        "padding_left": 24,
        "padding_right": 24
