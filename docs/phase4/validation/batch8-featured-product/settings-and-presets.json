        },
        "source_consumers": [
          "--content-featured-product-padding: {{ block.settings.padding }}px;"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_empty_state",
          "label": "Show empty state",
          "default": true
        },
        "source_consumers": [
          "{% elsif request.design_mode and block.settings.show_empty_state %}<div class=\"content-featured-product__empty\" role=\"note\">{{ block.settings.empty_text | default: 'Select a product for this block.' | escape }}</div>{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "empty_text",
          "label": "Empty state text",
          "default": "Select a product to display this featured product block."
        },
        "source_consumers": [
          "{% elsif request.design_mode and block.settings.show_empty_state %}<div class=\"content-featured-product__empty\" role=\"note\">{{ block.settings.empty_text | default: 'Select a product for this block.' | escape }}</div>{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "gallery_label",
          "label": "Gallery label",
          "default": "Featured product gallery"
        },
        "source_consumers": [
          "snippets/qtm-block-featured-product-gallery.liquid: <div id=\"{{ block_id }}-gallery\" class=\"content-featured-product__media-frame\" data-product-gallery-viewport tabindex=\"0\" role=\"region\" aria-label=\"{{ block.settings.gallery_label | default: 'Featured product gallery' | escape }}\">{{ gallery_items }}</div>",
          "snippets/qtm-block-featured-product-gallery.liquid: {% if block.settings.show_gallery and rendered_media > 1 %}<div class=\"content-featured-product__thumbnails\" hidden data-gallery-nav role=\"group\" aria-label=\"{{ block.settings.gallery_label | default: 'Featured product gallery' | escape }}\">{{ gallery_thumbs }}</div>{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "view_media_label",
          "label": "View media label",
          "default": "View product media"
        },
        "source_consumers": [
          "snippets/qtm-block-featured-product-gallery.liquid: <div id=\"{{ block_id }}-media-{{ media.id }}\" class=\"content-featured-product__media\" data-gallery-item data-media-id=\"{{ media.id }}\" role=\"group\" aria-label=\"{{ block.settings.view_media_label | default: 'View product media' | escape }} {{ media_position }}\">",
          "snippets/qtm-block-featured-product-gallery.liquid: <button type=\"button\" class=\"content-featured-product__thumbnail\" data-product-gallery-thumbnail data-index=\"{{ rendered_media }}\" data-media-id=\"{{ media.id }}\" aria-controls=\"{{ block_id }}-media-{{ media.id }}\" aria-label=\"{{ block.settings.view_media_label | default: 'View product media' | escape }} {{ media_position }}\">"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_on_desktop",
          "label": "Show on desktop",
          "default": true
        },
        "source_consumers": [
          "assign show_on_desktop = block.settings.show_on_desktop"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_on_tablet",
          "label": "Show on tablet",
          "default": true
        },
        "source_consumers": [
          "assign show_on_tablet = block.settings.show_on_tablet"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on mobile",
          "default": true
        },
        "source_consumers": [
          "assign show_on_mobile = block.settings.show_on_mobile"
        ]
      },
      {
        "schema": {
          "type": "select",
          "id": "animation_style",
          "label": "Animation",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "fade",
              "label": "Fade"
            },
            {
              "value": "fade_up",
              "label": "Fade up"
            },
            {
              "value": "zoom",
              "label": "Zoom"
            }
          ]
        },
        "source_consumers": [
          "{% if block.settings.animation_style != 'none' and request.design_mode == false %} content-featured-product--animate content-featured-product--animate-{{ block.settings.animation_style }}{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "variant_label",
          "label": "Variant label",
          "default": "Variant"
        },
        "source_consumers": [
          "<label for=\"{{ block_id }}-variant\">{{ block.settings.variant_label | default: 'Variant' | escape }}</label>"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "selling_plan_label",
          "label": "Purchase options label",
          "default": "Purchase options"
        },
        "source_consumers": [
          "{% if featured_product.selling_plan_groups.size > 0 %}{% render 'product-selling-plans', product: featured_product, id: block_id, label: block.settings.selling_plan_label, one_time_label: block.settings.one_time_purchase_label %}{% else %}<input type=\"hidden\" name=\"selling_plan\" value=\"\">{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "one_time_purchase_label",
          "label": "One-time purchase label",
          "default": "One-time purchase"
        },
        "source_consumers": [
          "{% if featured_product.selling_plan_groups.size > 0 %}{% render 'product-selling-plans', product: featured_product, id: block_id, label: block.settings.selling_plan_label, one_time_label: block.settings.one_time_purchase_label %}{% else %}<input type=\"hidden\" name=\"selling_plan\" value=\"\">{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "unavailable_label",
          "label": "Unavailable label",
          "default": "Unavailable"
        },
        "source_consumers": [
          "data-unavailable-label=\"{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}\"",
          "<button type=\"submit\" name=\"add\" class=\"content-featured-product__button\" data-add-to-cart data-b8-submit {% unless purchase_available %}disabled{% endunless %}>{% if purchase_available %}{{ block.settings.atc_label | default: 'Add to cart' | escape }}{% elsif current_variant.available == false %}{{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% else %}{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}{% endif %}</button>"
        ]
      }
