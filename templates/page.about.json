    "habits": {
      "type": "interactive-content-helper-cards",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "Read first, shelve second",
            "subtitle": "The shelf note",
            "body": "<p>Nothing goes on the shelf without a bookseller having read it. The note under the title is the sentence we would say if you asked.</p>",
            "icon": "lucide-book-open",
            "image": "",
            "badge": "",
            "cta_label": "See the picks",
            "cta_url": "/collections/staff-picks"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Make room to talk",
            "subtitle": "The back room",
            "body": "<p>The back room table seats eight. Reading groups are free, start with a question, and are open to anyone who has the book.</p>",
            "icon": "lucide-users",
            "image": "",
            "badge": "",
            "cta_label": "Reading Together",
            "cta_url": "/pages/reading-together"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "Keep the useful things",
            "subtitle": "The goods table",
            "body": "<p>Journals, totes and bookmarks are made to be used for years, in the shop's own quiet colors. No seasonal churn.</p>",
            "icon": "lucide-leaf",
            "image": "",
            "badge": "",
            "cta_label": "Gifts and goods",
            "cta_url": "/collections/bookstore-goods"
          }
        }
