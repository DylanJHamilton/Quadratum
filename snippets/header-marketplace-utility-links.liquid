<div class="qtmHeaderFive__utility">
  <div class="qtmHeaderFive__utilityInner">
    {% if section_settings.utility_text != blank %}
      <div class="qtmHeaderFive__utilityText">
        {{ section_settings.utility_text }}
      </div>
    {% endif %}

    <div class="qtmHeaderFive__utilityLinks">
      {% if section_settings.utility_link_label != blank and section_settings.utility_link_url != blank %}
        <a class="qtmHeaderFive__utilityLink" href="{{ section_settings.utility_link_url }}">
          {{ section_settings.utility_link_label }}
        </a>
      {% endif %}

      {% for block in blocks %}
        {% if block.type == 'utility_link' %}
          {% if block.settings.label != blank and block.settings.url != blank %}
            <a class="qtmHeaderFive__utilityLink" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="qtmHeaderFive__utilityIcon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% endif %}
              <span>{{ block.settings.label }}</span>
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>