{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-anchor-nav
    qtm-anchor-nav-{{ block_id }}
    qtm-anchor-nav--width-{{ block_width }}
    qtm-anchor-nav--align-{{ block_alignment }}
    qtm-anchor-nav--layout-{{ block.settings.layout_style }}
    qtm-anchor-nav--animation-{{ animation }}
    {% if block.settings.enable_sticky %} qtm-anchor-nav--sticky{% endif %}
    {% if block.settings.enable_scroll_snap %} qtm-anchor-nav--scroll-snap{% endif %}
    {% unless block.settings.show_desktop %} qtm-anchor-nav--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-anchor-nav--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-anchor-nav--hide-mobile{% endunless %}
  "
  style="
    --qtm-anchor-nav-margin-top: {{ block.settings.margin_top }}px;
    --qtm-anchor-nav-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-anchor-nav-padding: {{ block.settings.padding }}px;
    --qtm-anchor-nav-gap: {{ block.settings.gap }}px;
    --qtm-anchor-nav-heading-color: {{ block.settings.heading_color }};
    --qtm-anchor-nav-text-color: {{ block.settings.text_color }};
    --qtm-anchor-nav-background-color: {{ block.settings.background_color }};
    --qtm-anchor-nav-bar-background: {{ block.settings.bar_background_color }};
    --qtm-anchor-nav-item-background: {{ block.settings.item_background_color }};
    --qtm-anchor-nav-item-hover-background: {{ block.settings.item_hover_background_color }};
    --qtm-anchor-nav-border-color: {{ block.settings.border_color }};
    --qtm-anchor-nav-link-color: {{ block.settings.link_color }};
    --qtm-anchor-nav-active-color: {{ block.settings.active_color }};
    --qtm-anchor-nav-active-background: {{ block.settings.active_background_color }};
    --qtm-anchor-nav-border-width: {{ block.settings.border_width }}px;
    --qtm-anchor-nav-border-radius: {{ block.settings.border_radius }}px;
    --qtm-anchor-nav-sticky-offset: {{ block.settings.sticky_offset }}px;
    --qtm-anchor-nav-item-height: {{ block.settings.item_height }}px;
  "
  data-qtm-anchor-nav="{{ block_id }}"
  {% if block.settings.enable_smooth_scroll %}data-smooth-scroll="true"{% endif %}
  {% if block.settings.active_on_click %}data-active-on-click="true"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="qtm-anchor-nav__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-anchor-nav__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-anchor-nav__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-anchor-nav__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-anchor-nav__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <nav class="qtm-anchor-nav__nav" aria-label="{{ block.settings.nav_label | escape }}">
      <ul class="qtm-anchor-nav__list" role="list">
        {% for i in (1..10) %}
          {% liquid
            assign enabled_key = 'anchor_' | append: i | append: '_enabled'
            assign label_key = 'anchor_' | append: i | append: '_label'
            assign id_key = 'anchor_' | append: i | append: '_id'
            assign badge_key = 'anchor_' | append: i | append: '_badge'

            assign anchor_enabled = block.settings[enabled_key]
            assign anchor_label = block.settings[label_key]
            assign anchor_id = block.settings[id_key] | remove: '#'
            assign anchor_badge = block.settings[badge_key]
          %}

          {% if anchor_enabled and anchor_label != blank and anchor_id != blank %}
            <li class="qtm-anchor-nav__item">
              <a
                class="qtm-anchor-nav__link {% if forloop.first and block.settings.mark_first_active %}is-active{% endif %}"
                href="#{{ anchor_id | escape }}"
                data-anchor-target="{{ anchor_id | escape }}"
              >
                {% if block.settings.show_numbers %}
                  <span class="qtm-anchor-nav__number" aria-hidden="true">
                    {{ forloop.index }}
                  </span>
                {% endif %}

                <span class="qtm-anchor-nav__label">
                  {{ anchor_label | escape }}
                </span>

                {% if anchor_badge != blank %}
                  <span class="qtm-anchor-nav__badge">
                    {{ anchor_badge | escape }}
                  </span>
                {% endif %}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</div>

{% if block.settings.enable_smooth_scroll or block.settings.active_on_click %}
  <script>
    (() => {
      const root = document.querySelector('[data-qtm-anchor-nav="{{ block_id }}"]');
      if (!root) return;

      const links = Array.from(root.querySelectorAll('[data-anchor-target]'));
      if (!links.length) return;

      const smoothScroll = root.dataset.smoothScroll === 'true';
      const activeOnClick = root.dataset.activeOnClick === 'true';

      links.forEach((link) => {
        link.addEventListener('click', (event) => {
          const targetId = link.dataset.anchorTarget;
          const target = document.getElementById(targetId);

          if (smoothScroll && target) {
            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', `#${targetId}`);
          }

          if (activeOnClick) {
            links.forEach((item) => item.classList.remove('is-active'));
            link.classList.add('is-active');
          }
        });
      });
    })();
  </script>
{% endif %}

<style>
  .qtm-anchor-nav-{{ block_id }} {
    margin-top: var(--qtm-anchor-nav-margin-top);
    margin-bottom: var(--qtm-anchor-nav-margin-bottom);
    padding: var(--qtm-anchor-nav-padding);
    color: var(--qtm-anchor-nav-text-color);
    background: var(--qtm-anchor-nav-background-color);
    border: var(--qtm-anchor-nav-border-width) solid var(--qtm-anchor-nav-border-color);
    border-radius: var(--qtm-anchor-nav-border-radius);
  }

  .qtm-anchor-nav-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--sticky {
    position: sticky;
    top: var(--qtm-anchor-nav-sticky-offset);
    z-index: 20;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--width-auto {
    width: auto;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--width-small {
    max-width: 640px;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--width-medium {
    max-width: 860px;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--width-large {
    max-width: 1120px;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__inner {
    display: grid;
    gap: var(--qtm-anchor-nav-gap);
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__header {
    display: grid;
    gap: 0.7rem;
    max-width: 760px;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-center .qtm-anchor-nav__header {
    margin-inline: auto;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-right .qtm-anchor-nav__header {
    margin-left: auto;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__eyebrow {
    margin: 0;
    color: var(--qtm-anchor-nav-link-color);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__heading {
    margin: 0;
    color: var(--qtm-anchor-nav-heading-color);
    line-height: 1.08;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__text {
    color: var(--qtm-anchor-nav-text-color);
    line-height: 1.7;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__text p {
    margin-top: 0;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__nav {
    width: 100%;
    padding: {% if block.settings.layout_style == 'bar' or block.settings.layout_style == 'tabs' %}0.45rem{% else %}0{% endif %};
    background: {% if block.settings.layout_style == 'bar' or block.settings.layout_style == 'tabs' %}var(--qtm-anchor-nav-bar-background){% else %}transparent{% endif %};
    border: {% if block.settings.layout_style == 'bar' or block.settings.layout_style == 'tabs' %}1px solid color-mix(in srgb, var(--qtm-anchor-nav-border-color), transparent 8%){% else %}0{% endif %};
    border-radius: {% if block.settings.layout_style == 'bar' or block.settings.layout_style == 'tabs' %}calc(var(--qtm-anchor-nav-border-radius) * 0.75){% else %}0{% endif %};
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__list {
    display: flex;
    flex-wrap: {% if block.settings.allow_wrap %}wrap{% else %}nowrap{% endif %};
    gap: calc(var(--qtm-anchor-nav-gap) * 0.45);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-center .qtm-anchor-nav__list {
    justify-content: center;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--align-right .qtm-anchor-nav__list {
    justify-content: flex-end;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--scroll-snap .qtm-anchor-nav__nav {
    scroll-snap-type: x proximity;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--scroll-snap .qtm-anchor-nav__item {
    scroll-snap-align: start;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__item {
    flex: 0 0 auto;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--qtm-anchor-nav-item-height);
    padding: 0.68rem 0.95rem;
    color: var(--qtm-anchor-nav-link-color);
    background: var(--qtm-anchor-nav-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-anchor-nav-border-color), transparent 10%);
    border-radius: calc(var(--qtm-anchor-nav-border-radius) * 0.55);
    font-size: {{ block.settings.text_size }}px;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 180ms ease, opacity 180ms ease, background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__link:hover {
    background: var(--qtm-anchor-nav-item-hover-background);
    border-color: color-mix(in srgb, var(--qtm-anchor-nav-link-color), transparent 72%);
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__link:focus-visible {
    outline: 3px solid var(--qtm-anchor-nav-link-color);
    outline-offset: 4px;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__link.is-active,
  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__link[aria-current="true"] {
    color: var(--qtm-anchor-nav-active-color);
    background: var(--qtm-anchor-nav-active-background);
    border-color: color-mix(in srgb, var(--qtm-anchor-nav-active-color), transparent 72%);
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__number {
    display: grid;
    place-items: center;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    color: var(--qtm-anchor-nav-active-color);
    background: color-mix(in srgb, var(--qtm-anchor-nav-active-background), transparent 0%);
    border-radius: 999px;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.25rem;
    padding: 0.2rem 0.42rem;
    color: var(--qtm-anchor-nav-active-color);
    background: var(--qtm-anchor-nav-active-background);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--layout-pills .qtm-anchor-nav__link {
    border-radius: 999px;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--layout-tabs .qtm-anchor-nav__link {
    border-radius: calc(var(--qtm-anchor-nav-border-radius) * 0.45);
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--layout-minimal .qtm-anchor-nav__link {
    min-height: auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--layout-minimal .qtm-anchor-nav__link:hover {
    background: transparent;
    border-color: transparent;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--layout-minimal .qtm-anchor-nav__badge {
    color: var(--qtm-anchor-nav-link-color);
    background: color-mix(in srgb, var(--qtm-anchor-nav-link-color), transparent 92%);
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--animation-fade {
    animation: qtm-anchor-nav-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--animation-fade-up {
    animation: qtm-anchor-nav-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--animation-fade-down {
    animation: qtm-anchor-nav-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--animation-fade-left {
    animation: qtm-anchor-nav-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--animation-fade-right {
    animation: qtm-anchor-nav-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--animation-zoom {
    animation: qtm-anchor-nav-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-anchor-nav-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-anchor-nav-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-anchor-nav-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-anchor-nav-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-anchor-nav-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-anchor-nav-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--hide-tablet {
      display: none !important;
    }

    .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--sticky {
      position: sticky;
      top: 0;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-anchor-nav-{{ block_id }} {
      padding: min(var(--qtm-anchor-nav-padding), 20px);
    }

    .qtm-anchor-nav-{{ block_id }}.qtm-anchor-nav--hide-mobile {
      display: none !important;
    }

    .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__list {
      justify-content: flex-start;
      flex-wrap: nowrap;
    }

    .qtm-anchor-nav-{{ block_id }} .qtm-anchor-nav__link {
      min-height: max(36px, {{ block.settings.item_height | minus: 6 }}px);
      font-size: min({{ block.settings.text_size }}px, 14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-anchor-nav-{{ block_id }},
    .qtm-anchor-nav-{{ block_id }} *,
    .qtm-anchor-nav-{{ block_id }} *::before,
    .qtm-anchor-nav-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Anchor navigation",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation label",
      "default": "Section navigation"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mark_first_active",
      "label": "Mark first link active by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "active_on_click",
      "label": "Update active state on click",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_smooth_scroll",
      "label": "Enable smooth scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky positioning",
      "default": false
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky offset",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "allow_wrap",
      "label": "Allow links to wrap",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_snap",
      "label": "Enable horizontal scroll snap",
      "default": true
    },

    {
      "type": "header",
      "content": "Anchor 1"
    },
    {
      "type": "checkbox",
      "id": "anchor_1_enabled",
      "label": "Enable anchor 1",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_1_label",
      "label": "Anchor 1 label",
      "default": "Overview"
    },
    {
      "type": "text",
      "id": "anchor_1_id",
      "label": "Anchor 1 ID",
      "default": "overview"
    },
    {
      "type": "text",
      "id": "anchor_1_badge",
      "label": "Anchor 1 badge"
    },

    {
      "type": "header",
      "content": "Anchor 2"
    },
    {
      "type": "checkbox",
      "id": "anchor_2_enabled",
      "label": "Enable anchor 2",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_2_label",
      "label": "Anchor 2 label",
      "default": "Features"
    },
    {
      "type": "text",
      "id": "anchor_2_id",
      "label": "Anchor 2 ID",
      "default": "features"
    },
    {
      "type": "text",
      "id": "anchor_2_badge",
      "label": "Anchor 2 badge"
    },

    {
      "type": "header",
      "content": "Anchor 3"
    },
    {
      "type": "checkbox",
      "id": "anchor_3_enabled",
      "label": "Enable anchor 3",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_3_label",
      "label": "Anchor 3 label",
      "default": "Benefits"
    },
    {
      "type": "text",
      "id": "anchor_3_id",
      "label": "Anchor 3 ID",
      "default": "benefits"
    },
    {
      "type": "text",
      "id": "anchor_3_badge",
      "label": "Anchor 3 badge"
    },

    {
      "type": "header",
      "content": "Anchor 4"
    },
    {
      "type": "checkbox",
      "id": "anchor_4_enabled",
      "label": "Enable anchor 4",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_4_label",
      "label": "Anchor 4 label",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "anchor_4_id",
      "label": "Anchor 4 ID",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "anchor_4_badge",
      "label": "Anchor 4 badge"
    },

    {
      "type": "header",
      "content": "Anchor 5"
    },
    {
      "type": "checkbox",
      "id": "anchor_5_enabled",
      "label": "Enable anchor 5",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_5_label",
      "label": "Anchor 5 label",
      "default": "FAQs"
    },
    {
      "type": "text",
      "id": "anchor_5_id",
      "label": "Anchor 5 ID",
      "default": "faqs"
    },
    {
