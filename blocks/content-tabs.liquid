    },
    {
      "type": "text",
      "id": "tab_4_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "tab_4_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "tab_4_button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "tab_4_button_url",
      "label": "Button URL"
    },

    {
      "type": "header",
      "content": "Tab 5"
    },
    {
      "type": "text",
      "id": "tab_5_label",
      "label": "Tab label"
    },
    {
      "type": "text",
      "id": "tab_5_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "tab_5_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "tab_5_button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "tab_5_button_url",
      "label": "Button URL"
    },

    {
      "type": "header",
      "content": "Tab 6"
    },
    {
      "type": "text",
      "id": "tab_6_label",
      "label": "Tab label"
    },
    {
      "type": "text",
      "id": "tab_6_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "tab_6_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "tab_6_button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "tab_6_button_url",
      "label": "Button URL"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
