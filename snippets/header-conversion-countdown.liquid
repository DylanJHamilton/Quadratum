{% liquid
  assign countdown_label = section_settings.countdown_label | default: 'Sale Ends In'
  assign countdown_end_date = section_settings.countdown_end_date
  assign expired_message = section_settings.countdown_expired_message | default: 'This offer has ended'
%}

<div
  class="qtmHeaderFour__countdown"
  data-qtm-h4-countdown
  data-end="{{ countdown_end_date | escape }}"
  data-expired-message="{{ expired_message | escape }}"
  aria-live="polite"
>
  <span class="qtmHeaderFour__countdownLabel">{{ countdown_label }}</span>

  <div class="qtmHeaderFour__countdownUnits" aria-label="{{ countdown_label }}">
    <span class="qtmHeaderFour__countdownUnit">
      <strong data-qtm-h4-days>00</strong>
      <span>Days</span>
    </span>

    <span class="qtmHeaderFour__countdownUnit">
      <strong data-qtm-h4-hours>00</strong>
      <span>Hours</span>
    </span>

    <span class="qtmHeaderFour__countdownUnit">
      <strong data-qtm-h4-minutes>00</strong>
      <span>Min</span>
    </span>

    <span class="qtmHeaderFour__countdownUnit">
      <strong data-qtm-h4-seconds>00</strong>
      <span>Sec</span>
    </span>
  </div>

  <span class="qtmHeaderFour__countdownExpired" hidden data-qtm-h4-countdown-expired>
    {{ expired_message }}
  </span>
</div>