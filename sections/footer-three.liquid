{% liquid
  assign footer_layout = section.settings.footer_layout | default: 'editorial'
  assign footer_width = section.settings.footer_width | default: 'wide'
  assign mobile_menu_behavior = section.settings.mobile_menu_behavior | default: 'accordion'

  assign has_menu_blocks = false
  assign has_social_block = false
  assign has_quote_block = false
  assign has_contact_block = false
  assign has_richtext_block = false
  assign has_custom_liquid_block = false

  for block in section.blocks
    if block.type == 'menu'
      assign has_menu_blocks = true
    elsif block.type == 'social'
      assign has_social_block = true
    elsif block.type == 'quote'
      assign has_quote_block = true
    elsif block.type == 'contact'
      assign has_contact_block = true
    elsif block.type == 'richtext'
      assign has_richtext_block = true
    elsif block.type == 'custom_liquid'
      assign has_custom_liquid_block = true
    endif
  endfor
%}

<footer
  id="FooterThree-{{ section.id }}"
  class="q-footer-three q-footer-three--layout-{{ footer_layout }} q-footer-three--width-{{ footer_width }} q-footer-three--mobile-{{ mobile_menu_behavior }} q-footer-three--image-{{ section.settings.image_position }}"
  aria-label="Site footer"
>
  <style>
    #FooterThree-{{ section.id }}{
      --qf3-bg: {{ section.settings.bg_color }};
      --qf3-text: {{ section.settings.text_color }};
      --qf3-muted: {{ section.settings.muted_color }};
      --qf3-heading: {{ section.settings.heading_color }};
      --qf3-link: {{ section.settings.link_color }};
      --qf3-link-hover: {{ section.settings.link_hover_color }};
      --qf3-border: {{ section.settings.border_color }};
      --qf3-bottom-bg: {{ section.settings.bottom_bg }};
      --qf3-bottom-text: {{ section.settings.bottom_text_color }};
      --qf3-newsletter-bg: {{ section.settings.newsletter_bg }};
      --qf3-newsletter-text: {{ section.settings.newsletter_text_color }};
      --qf3-radius: {{ section.settings.image_radius }}px;
      --qf3-newsletter-radius: {{ section.settings.newsletter_radius }}px;
      --qf3-button-radius: {{ section.settings.button_radius }}px;
      --qf3-gap: {{ section.settings.section_gap }}px;
      --qf3-column-gap: {{ section.settings.column_gap }}px;
      --qf3-block-gap: {{ section.settings.block_gap }}px;
      --qf3-padding-top: {{ section.settings.padding_top }}px;
      --qf3-padding-bottom: {{ section.settings.padding_bottom }}px;
      --qf3-editorial-heading-size: {{ section.settings.editorial_heading_size }}px;
      --qf3-editorial-text-size: {{ section.settings.editorial_text_size }}px;
      --qf3-heading-size: {{ section.settings.heading_size }}px;
      --qf3-body-size: {{ section.settings.body_size }}px;
      --qf3-link-size: {{ section.settings.link_size }}px;
      --qf3-letter-spacing: calc({{ section.settings.letter_spacing }} * 0.01em);
      --qf3-text-transform: {{ section.settings.text_transform }};
      --qf3-logo-height: {{ section.settings.logo_height }}px;

      width: 100%;
      margin: 0;
      padding: 0;
      background: var(--qf3-bg);
      color: var(--qf3-text);
      border-top: 1px solid var(--qf3-border);
    }

    #FooterThree-{{ section.id }},
    #FooterThree-{{ section.id }} *{
      box-sizing: border-box;
    }

    #FooterThree-{{ section.id }} a{
      color: var(--qf3-link);
      text-decoration: none;
      transition: color .22s ease, opacity .22s ease, transform .22s ease, border-color .22s ease, background .22s ease;
    }

    #FooterThree-{{ section.id }} a:hover{
      color: var(--qf3-link-hover);
    }

    #FooterThree-{{ section.id }} a:focus-visible,
    #FooterThree-{{ section.id }} button:focus-visible,
    #FooterThree-{{ section.id }} input:focus-visible,
    #FooterThree-{{ section.id }} summary:focus-visible{
      outline: 2px solid var(--qf3-link-hover);
      outline-offset: 3px;
    }

    #FooterThree-{{ section.id }} .qf3__shell,
    #FooterThree-{{ section.id }} .qf3__bottom-inner{
      width: 100%;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    #FooterThree-{{ section.id }}.q-footer-three--width-wide .qf3__shell,
    #FooterThree-{{ section.id }}.q-footer-three--width-wide .qf3__bottom-inner{
      max-width: 1400px;
    }

    #FooterThree-{{ section.id }}.q-footer-three--width-contained .qf3__shell,
    #FooterThree-{{ section.id }}.q-footer-three--width-contained .qf3__bottom-inner{
      max-width: 1180px;
    }

    #FooterThree-{{ section.id }}.q-footer-three--width-narrow .qf3__shell,
    #FooterThree-{{ section.id }}.q-footer-three--width-narrow .qf3__bottom-inner{
      max-width: 920px;
    }

    #FooterThree-{{ section.id }} .qf3__main{
      position: relative;
      width: 100%;
      padding-top: var(--qf3-padding-top);
      padding-bottom: var(--qf3-padding-bottom);
      overflow: hidden;
    }

    #FooterThree-{{ section.id }} .qf3__editorial{
      display: grid;
      gap: var(--qf3-gap);
      position: relative;
      z-index: 1;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-editorial .qf3__editorial{
      grid-template-columns: 1fr;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-split_editorial .qf3__editorial{
      grid-template-columns: minmax(280px, .9fr) minmax(0, 1.1fr);
      align-items: stretch;
      gap: var(--qf3-column-gap);
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__editorial{
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
    }

    #FooterThree-{{ section.id }} .qf3__statement{
      display: grid;
      gap: 18px;
      align-content: center;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__statement{
      justify-items: center;
    }

    #FooterThree-{{ section.id }} .qf3__brand-link{
      display: inline-flex;
      align-items: center;
      width: fit-content;
      max-width: 100%;
      color: inherit;
    }

    #FooterThree-{{ section.id }} .qf3__logo{
      display: block;
      width: auto;
      max-width: 100%;
      height: var(--qf3-logo-height);
      object-fit: contain;
    }

    #FooterThree-{{ section.id }} .qf3__brand-name{
      margin: 0;
      color: var(--qf3-heading);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: var(--qf3-letter-spacing);
      text-transform: var(--qf3-text-transform);
      line-height: 1.1;
    }

    #FooterThree-{{ section.id }} .qf3__editorial-heading{
      max-width: 13ch;
      margin: 0;
      color: var(--qf3-heading);
      font-size: var(--qf3-editorial-heading-size);
      font-weight: 500;
      line-height: .98;
      letter-spacing: -0.045em;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__editorial-heading{
      max-width: 15ch;
      margin-left: auto;
      margin-right: auto;
    }

    #FooterThree-{{ section.id }} .qf3__editorial-text{
      max-width: 52ch;
      margin: 0;
      color: var(--qf3-muted);
      font-size: var(--qf3-editorial-text-size);
      line-height: 1.7;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__editorial-text{
      margin-left: auto;
      margin-right: auto;
    }

    #FooterThree-{{ section.id }} .qf3__image-wrap{
      position: relative;
      overflow: hidden;
      min-height: 360px;
      border-radius: var(--qf3-radius);
      background: color-mix(in srgb, var(--qf3-muted), transparent 88%);
    }

    #FooterThree-{{ section.id }} .qf3__editorial-image{
      display: block;
      width: 100%;
      height: 100%;
      min-height: 360px;
      object-fit: cover;
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-background .qf3__image-wrap{
      position: absolute;
      inset: 0;
      z-index: 0;
      min-height: 100%;
      border-radius: 0;
      opacity: .16;
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-background .qf3__editorial-image{
      min-height: 100%;
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-background .qf3__main::after{
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background: linear-gradient(90deg, var(--qf3-bg), color-mix(in srgb, var(--qf3-bg), transparent 12%));
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-left .qf3__image-wrap{
      order: -1;
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-right .qf3__image-wrap{
      order: 2;
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-top .qf3__editorial{
      grid-template-columns: 1fr;
    }

    #FooterThree-{{ section.id }}.q-footer-three--image-top .qf3__image-wrap{
      order: -1;
      min-height: 300px;
    }

    #FooterThree-{{ section.id }} .qf3__content{
      display: grid;
      gap: var(--qf3-gap);
      align-content: start;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter{
      display: grid;
      gap: 14px;
      padding: 26px;
      border: 1px solid var(--qf3-border);
      border-radius: var(--qf3-newsletter-radius);
      background: var(--qf3-newsletter-bg);
      color: var(--qf3-newsletter-text);
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__newsletter{
      max-width: 620px;
      margin: 0 auto;
      width: 100%;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-heading{
      margin: 0;
      color: var(--qf3-heading);
      font-size: var(--qf3-heading-size);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: var(--qf3-letter-spacing);
      text-transform: var(--qf3-text-transform);
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-text{
      margin: 0;
      color: var(--qf3-muted);
      font-size: var(--qf3-body-size);
      line-height: 1.65;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-form{
      display: grid;
      gap: 12px;
      margin-top: 8px;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-row{
      display: flex;
      align-items: stretch;
      gap: 10px;
      min-width: 0;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-label{
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-input{
      flex: 1 1 auto;
      min-width: 0;
      height: 48px;
      padding: 0 14px;
      border: 1px solid var(--qf3-border);
      border-radius: var(--qf3-button-radius);
      background: transparent;
      color: var(--qf3-text);
      font-size: var(--qf3-body-size);
      box-shadow: none;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-input::placeholder{
      color: var(--qf3-muted);
      opacity: .78;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-button{
      flex: 0 0 auto;
      min-height: 48px;
      padding: 0 20px;
      border: 1px solid var(--qf3-link);
      border-radius: var(--qf3-button-radius);
      background: var(--qf3-link);
      color: var(--qf3-bg);
      cursor: pointer;
      font-size: var(--qf3-link-size);
      font-weight: 700;
      line-height: 1;
      letter-spacing: var(--qf3-letter-spacing);
      text-transform: var(--qf3-text-transform);
      white-space: nowrap;
    }

    #FooterThree-{{ section.id }} .qf3__newsletter-button:hover{
      background: var(--qf3-link-hover);
      border-color: var(--qf3-link-hover);
    }

    #FooterThree-{{ section.id }}.q-footer-three--newsletter-underline .qf3__newsletter{
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    #FooterThree-{{ section.id }}.q-footer-three--newsletter-underline .qf3__newsletter-row{
      border-bottom: 1px solid var(--qf3-border);
      gap: 0;
    }

    #FooterThree-{{ section.id }}.q-footer-three--newsletter-underline .qf3__newsletter-input{
      border: 0;
      border-radius: 0;
      padding-left: 0;
    }

    #FooterThree-{{ section.id }}.q-footer-three--newsletter-underline .qf3__newsletter-button{
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--qf3-link);
      padding-right: 0;
    }

    #FooterThree-{{ section.id }}.q-footer-three--newsletter-minimal .qf3__newsletter{
      padding: 0;
      border: 0;
      background: transparent;
    }

    #FooterThree-{{ section.id }} .qf3__form-message{
      margin: 0;
      color: var(--qf3-muted);
      font-size: .9rem;
      line-height: 1.45;
    }

    #FooterThree-{{ section.id }} .qf3__form-message--success{
      color: var(--qf3-link-hover);
      font-weight: 700;
    }

    #FooterThree-{{ section.id }} .qf3__blocks{
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--qf3-column-gap);
      align-items: start;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__blocks{
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    #FooterThree-{{ section.id }} .qf3__block{
      min-width: 0;
      display: grid;
      gap: var(--qf3-block-gap);
    }

    #FooterThree-{{ section.id }} .qf3__block-heading{
      margin: 0;
      color: var(--qf3-heading);
      font-size: var(--qf3-heading-size);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: var(--qf3-letter-spacing);
      text-transform: var(--qf3-text-transform);
    }

    #FooterThree-{{ section.id }} .qf3__menu-list,
    #FooterThree-{{ section.id }} .qf3__social-list,
    #FooterThree-{{ section.id }} .qf3__contact-list,
    #FooterThree-{{ section.id }} .qf3__bottom-menu,
    #FooterThree-{{ section.id }} .qf3__policy-links{
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #FooterThree-{{ section.id }} .qf3__menu-list{
      display: grid;
      gap: 10px;
    }

    #FooterThree-{{ section.id }} .qf3__menu-list a{
      display: inline-block;
      width: fit-content;
      max-width: 100%;
      color: var(--qf3-link);
      font-size: var(--qf3-link-size);
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    #FooterThree-{{ section.id }} .qf3__menu-list a:hover{
      color: var(--qf3-link-hover);
      transform: translateX(2px);
    }

    #FooterThree-{{ section.id }} .qf3__menu-details{
      margin: 0;
    }

    #FooterThree-{{ section.id }} .qf3__menu-summary{
      display: block;
      list-style: none;
      cursor: pointer;
    }

    #FooterThree-{{ section.id }} .qf3__menu-summary::-webkit-details-marker{
      display: none;
    }

    #FooterThree-{{ section.id }} .qf3__menu-summary .qf3__block-heading{
      margin: 0;
    }

    #FooterThree-{{ section.id }} .qf3__quote{
      max-width: 34ch;
      color: var(--qf3-heading);
      font-size: clamp(1.15rem, 2vw, 1.8rem);
      font-weight: 400;
      line-height: 1.25;
      letter-spacing: -0.025em;
    }

    #FooterThree-{{ section.id }} .qf3__quote-text{
      margin: 0;
    }

    #FooterThree-{{ section.id }} .qf3__quote-author{
      margin: 12px 0 0;
      color: var(--qf3-muted);
      font-size: .9rem;
      letter-spacing: var(--qf3-letter-spacing);
      text-transform: var(--qf3-text-transform);
    }

    #FooterThree-{{ section.id }} .qf3__contact-list{
      display: grid;
      gap: 9px;
      color: var(--qf3-muted);
      font-size: var(--qf3-body-size);
      line-height: 1.55;
    }

    #FooterThree-{{ section.id }} .qf3__contact-list a{
      color: var(--qf3-link);
    }

    #FooterThree-{{ section.id }} .qf3__rte{
      color: var(--qf3-muted);
      font-size: var(--qf3-body-size);
      line-height: 1.65;
    }

    #FooterThree-{{ section.id }} .qf3__rte p{
      margin-top: 0;
    }

    #FooterThree-{{ section.id }} .qf3__rte p:last-child{
      margin-bottom: 0;
    }

    #FooterThree-{{ section.id }} .qf3__custom-liquid{
      color: var(--qf3-text);
    }

    #FooterThree-{{ section.id }} .qf3__social-list{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    #FooterThree-{{ section.id }}.q-footer-three--layout-centered_luxury .qf3__social-list{
      justify-content: center;
    }

    #FooterThree-{{ section.id }} .qf3__social-link{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      color: var(--qf3-link);
      font-size: var(--qf3-link-size);
      font-weight: 600;
      letter-spacing: var(--qf3-letter-spacing);
      text-transform: var(--qf3-text-transform);
    }

    #FooterThree-{{ section.id }} .qf3__social-link--icons{
      min-width: 40px;
      height: 40px;
      padding: 0 10px;
      border: 1px solid var(--qf3-border);
      border-radius: 999px;
    }

    #FooterThree-{{ section.id }} .qf3__social-link--icons:hover{
      border-color: var(--qf3-link-hover);
      transform: translateY(-1px);
    }

    #FooterThree-{{ section.id }} .qf3__social-link--minimal{
      opacity: .78;
    }

    #FooterThree-{{ section.id }} .qf3__social-link--minimal:hover{
      opacity: 1;
    }

    #FooterThree-{{ section.id }} .qf3__bottom{
      width: 100%;
      background: var(--qf3-bottom-bg);
      color: var(--qf3-bottom-text);
      border-top: 1px solid var(--qf3-border);
    }

    #FooterThree-{{ section.id }} .qf3__bottom-inner{
      display: grid;
      gap: 14px;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    #FooterThree-{{ section.id }} .qf3__bottom-top,
    #FooterThree-{{ section.id }} .qf3__bottom-lower{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    #FooterThree-{{ section.id }} .qf3__copyright,
    #FooterThree-{{ section.id }} .qf3__bottom-message{
      margin: 0;
      color: var(--qf3-bottom-text);
      font-size: .88rem;
      line-height: 1.45;
    }

    #FooterThree-{{ section.id }} .qf3__bottom-menu,
    #FooterThree-{{ section.id }} .qf3__policy-links{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    #FooterThree-{{ section.id }} .qf3__bottom-menu a,
    #FooterThree-{{ section.id }} .qf3__policy-links a{
      color: var(--qf3-bottom-text);
      font-size: .88rem;
      opacity: .82;
    }

    #FooterThree-{{ section.id }} .qf3__bottom-menu a:hover,
    #FooterThree-{{ section.id }} .qf3__policy-links a:hover{
      opacity: 1;
      color: var(--qf3-link-hover);
    }

    #FooterThree-{{ section.id }} .qf3__payments{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterThree-{{ section.id }} .qf3__payment-icon{
      display: block;
      width: auto;
      height: 22px;
    }

    #FooterThree-{{ section.id }} .qf3__payment-pill{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 28px;
      padding: 5px 10px;
      border: 1px solid var(--qf3-border);
      border-radius: 999px;
      color: var(--qf3-bottom-text);
      background: rgba(255,255,255,.035);
      font-size: .74rem;
      line-height: 1;
      letter-spacing: .02em;
    }

    @supports not (color: color-mix(in srgb, #000, #fff)){
      #FooterThree-{{ section.id }} .qf3__image-wrap{
        background: rgba(255,255,255,.06);
      }
    }

    @media (max-width: 1100px){
      #FooterThree-{{ section.id }}.q-footer-three--layout-split_editorial .qf3__editorial{
        grid-template-columns: 1fr;
      }

      #FooterThree-{{ section.id }} .qf3__blocks{
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #FooterThree-{{ section.id }} .qf3__newsletter-row{
        flex-direction: column;
      }

      #FooterThree-{{ section.id }} .qf3__newsletter-button{
        width: 100%;
      }

      #FooterThree-{{ section.id }} .qf3__editorial-heading{
        font-size: clamp(2.4rem, 7vw, var(--qf3-editorial-heading-size));
      }
    }

    @media (min-width: 741px){
      #FooterThree-{{ section.id }} .qf3__menu-details{
        pointer-events: none;
      }

      #FooterThree-{{ section.id }} .qf3__menu-details .qf3__menu-list{
        display: grid;
      }
    }

    @media (max-width: 740px){
      #FooterThree-{{ section.id }} .qf3__shell,
      #FooterThree-{{ section.id }} .qf3__bottom-inner{
        padding-left: 14px;
        padding-right: 14px;
      }

      #FooterThree-{{ section.id }} .qf3__main{
        padding-top: 44px;
        padding-bottom: 44px;
      }

      #FooterThree-{{ section.id }} .qf3__editorial,
      #FooterThree-{{ section.id }} .qf3__content,
      #FooterThree-{{ section.id }} .qf3__blocks{
        gap: 28px;
      }

      #FooterThree-{{ section.id }} .qf3__blocks{
        grid-template-columns: 1fr;
      }

      #FooterThree-{{ section.id }} .qf3__editorial-heading{
        max-width: 12ch;
        font-size: clamp(2.25rem, 13vw, 4.2rem);
      }

      #FooterThree-{{ section.id }} .qf3__editorial-text{
        font-size: 1rem;
      }

      #FooterThree-{{ section.id }} .qf3__image-wrap,
      #FooterThree-{{ section.id }} .qf3__editorial-image{
        min-height: 260px;
      }

      #FooterThree-{{ section.id }} .qf3__newsletter{
        padding: 20px;
      }

      #FooterThree-{{ section.id }} .qf3__newsletter-row{
        flex-direction: column;
      }

      #FooterThree-{{ section.id }} .qf3__newsletter-button{
        width: 100%;
      }

      #FooterThree-{{ section.id }}.q-footer-three--mobile-accordion .qf3__menu-details{
        border-bottom: 1px solid var(--qf3-border);
        padding-bottom: 12px;
      }

      #FooterThree-{{ section.id }}.q-footer-three--mobile-accordion .qf3__menu-summary{
        position: relative;
        cursor: pointer;
        padding-right: 28px;
      }

      #FooterThree-{{ section.id }}.q-footer-three--mobile-accordion .qf3__menu-summary::after{
        content: "+";
        position: absolute;
        top: 0;
        right: 0;
        color: var(--qf3-heading);
        font-weight: 600;
      }

      #FooterThree-{{ section.id }}.q-footer-three--mobile-accordion .qf3__menu-details[open] .qf3__menu-summary::after{
        content: "–";
      }

      #FooterThree-{{ section.id }}.q-footer-three--mobile-accordion .qf3__menu-details:not([open]) .qf3__menu-list{
        display: none;
      }

      #FooterThree-{{ section.id }} .qf3__bottom-top,
      #FooterThree-{{ section.id }} .qf3__bottom-lower{
        align-items: flex-start;
        justify-content: flex-start;
        flex-direction: column;
      }
    }
  </style>

  <div class="qf3__main">
    {% if section.settings.editorial_image != blank and section.settings.image_position == 'background' %}
      <div class="qf3__image-wrap" aria-hidden="true">
        <img
          class="qf3__editorial-image"
          src="{{ section.settings.editorial_image | image_url: width: 2200 }}"
          alt=""
          loading="lazy"
        >
      </div>
    {% endif %}

    <div class="qf3__shell">
      <div class="qf3__editorial">
        {% if section.settings.editorial_image != blank and section.settings.image_position != 'background' %}
          <div class="qf3__image-wrap">
            <img
              class="qf3__editorial-image"
              src="{{ section.settings.editorial_image | image_url: width: 1400 }}"
              alt="{{ section.settings.editorial_image_alt | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}

        <div class="qf3__content">
          <div class="qf3__statement">
            {% if section.settings.show_logo %}
              <a class="qf3__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
                {% if settings.logo_primary != blank %}
                  <img
                    class="qf3__logo"
                    src="{{ settings.logo_primary | image_url: width: 640 }}"
                    alt="{{ shop.name | escape }}"
                    loading="lazy"
                  >
                {% elsif settings.logo_mobile != blank %}
                  <img
                    class="qf3__logo"
                    src="{{ settings.logo_mobile | image_url: width: 640 }}"
                    alt="{{ shop.name | escape }}"
                    loading="lazy"
                  >
                {% else %}
                  <span class="qf3__brand-name">{{ shop.name }}</span>
                {% endif %}
              </a>
            {% endif %}

            {% if section.settings.editorial_heading != blank %}
              <h2 class="qf3__editorial-heading">{{ section.settings.editorial_heading }}</h2>
            {% endif %}

            {% if section.settings.editorial_text != blank %}
              <div class="qf3__editorial-text">
                {{ section.settings.editorial_text }}
              </div>
            {% endif %}
          </div>

          {% if section.settings.show_newsletter %}
            <div class="qf3__newsletter">
              {% if section.settings.newsletter_heading != blank %}
                <h3 class="qf3__newsletter-heading">{{ section.settings.newsletter_heading }}</h3>
              {% endif %}

              {% if section.settings.newsletter_body != blank %}
                <div class="qf3__newsletter-text">{{ section.settings.newsletter_body }}</div>
              {% endif %}

              {% form 'customer', class: 'qf3__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">

                <div class="qf3__newsletter-row">
                  <label class="qf3__newsletter-label" for="FooterThreeNewsletterEmail-{{ section.id }}">
                    Email address
                  </label>

                  <input
                    id="FooterThreeNewsletterEmail-{{ section.id }}"
                    class="qf3__newsletter-input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                    aria-label="{{ section.settings.newsletter_placeholder | default: 'Email address' | escape }}"
                    required
                  >

                  <button class="qf3__newsletter-button" type="submit">
                    {{ section.settings.newsletter_button_label }}
                  </button>
                </div>

                {% if form.posted_successfully? %}
                  <p class="qf3__form-message qf3__form-message--success" tabindex="-1">
                    Thanks for subscribing.
                  </p>
                {% endif %}

                {% if form.errors %}
                  <div class="qf3__form-message">
                    {{ form.errors | default_errors }}
                  </div>
                {% endif %}
              {% endform %}
            </div>
          {% endif %}

          {% if section.blocks.size > 0 %}
            <div class="qf3__blocks">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'menu' %}
                    <div class="qf3__block qf3__block--menu" {{ block.shopify_attributes }}>
                      {% if mobile_menu_behavior == 'accordion' %}
                        <details class="qf3__menu-details" open>
                          <summary class="qf3__menu-summary">
                            {% if block.settings.heading != blank %}
                              <h3 class="qf3__block-heading">{{ block.settings.heading }}</h3>
                            {% endif %}
                          </summary>

                          {% if block.settings.menu != blank %}
                            <ul class="qf3__menu-list">
                              {% for link in block.settings.menu.links %}
                                <li>
                                  <a href="{{ link.url }}">{{ link.title }}</a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </details>
                      {% else %}
                        {% if block.settings.heading != blank %}
                          <h3 class="qf3__block-heading">{{ block.settings.heading }}</h3>
                        {% endif %}

                        {% if block.settings.menu != blank %}
                          <ul class="qf3__menu-list">
                            {% for link in block.settings.menu.links %}
                              <li>
                                <a href="{{ link.url }}">{{ link.title }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      {% endif %}
                    </div>

                  {% when 'social' %}
                    <div class="qf3__block qf3__block--social" {{ block.shopify_attributes }}>
                      {% if block.settings.heading != blank %}
                        <h3 class="qf3__block-heading">{{ block.settings.heading }}</h3>
                      {% endif %}

                      <ul class="qf3__social-list" aria-label="Social links">
                        {% if settings.social_instagram_link != blank %}
                          <li><a class="qf3__social-link qf3__social-link--{{ block.settings.social_style }}" href="{{ settings.social_instagram_link }}" rel="noopener" target="_blank" aria-label="Instagram">{% if block.settings.social_style == 'icons' %}IG{% else %}Instagram{% endif %}</a></li>
                        {% endif %}

                        {% if settings.social_facebook_link != blank %}
                          <li><a class="qf3__social-link qf3__social-link--{{ block.settings.social_style }}" href="{{ settings.social_facebook_link }}" rel="noopener" target="_blank" aria-label="Facebook">{% if block.settings.social_style == 'icons' %}FB{% else %}Facebook{% endif %}</a></li>
                        {% endif %}

                        {% if settings.social_tiktok_link != blank %}
                          <li><a class="qf3__social-link qf3__social-link--{{ block.settings.social_style }}" href="{{ settings.social_tiktok_link }}" rel="noopener" target="_blank" aria-label="TikTok">{% if block.settings.social_style == 'icons' %}TT{% else %}TikTok{% endif %}</a></li>
                        {% endif %}

                        {% if settings.social_youtube_link != blank %}
                          <li><a class="qf3__social-link qf3__social-link--{{ block.settings.social_style }}" href="{{ settings.social_youtube_link }}" rel="noopener" target="_blank" aria-label="YouTube">{% if block.settings.social_style == 'icons' %}YT{% else %}YouTube{% endif %}</a></li>
                        {% endif %}

                        {% if settings.social_pinterest_link != blank %}
                          <li><a class="qf3__social-link qf3__social-link--{{ block.settings.social_style }}" href="{{ settings.social_pinterest_link }}" rel="noopener" target="_blank" aria-label="Pinterest">{% if block.settings.social_style == 'icons' %}PI{% else %}Pinterest{% endif %}</a></li>
                        {% endif %}

                        {% if settings.social_linkedin_link != blank %}
                          <li><a class="qf3__social-link qf3__social-link--{{ block.settings.social_style }}" href="{{ settings.social_linkedin_link }}" rel="noopener" target="_blank" aria-label="LinkedIn">{% if block.settings.social_style == 'icons' %}IN{% else %}LinkedIn{% endif %}</a></li>
                        {% endif %}
                      </ul>
                    </div>

                  {% when 'quote' %}
                    <div class="qf3__block qf3__block--quote" {{ block.shopify_attributes }}>
                      {% if block.settings.quote_text != blank %}
                        <blockquote class="qf3__quote">
                          <p class="qf3__quote-text">{{ block.settings.quote_text }}</p>

                          {% if block.settings.quote_author != blank %}
                            <cite class="qf3__quote-author">{{ block.settings.quote_author }}</cite>
                          {% endif %}
                        </blockquote>
                      {% endif %}
                    </div>

                  {% when 'contact' %}
                    <div class="qf3__block qf3__block--contact" {{ block.shopify_attributes }}>
                      {% if block.settings.heading != blank %}
                        <h3 class="qf3__block-heading">{{ block.settings.heading }}</h3>
                      {% endif %}

                      <ul class="qf3__contact-list">
                        {% if block.settings.email != blank %}
                          <li>
                            <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                          </li>
                        {% endif %}

                        {% if block.settings.phone != blank %}
                          <li>
                            <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">{{ block.settings.phone }}</a>
                          </li>
                        {% endif %}

                        {% if block.settings.address != blank %}
                          <li>{{ block.settings.address | newline_to_br }}</li>
                        {% endif %}

                        {% if block.settings.hours != blank %}
                          <li>{{ block.settings.hours | newline_to_br }}</li>
                        {% endif %}
                      </ul>
                    </div>

                  {% when 'richtext' %}
                    <div class="qf3__block qf3__block--richtext" {{ block.shopify_attributes }}>
                      {% if block.settings.heading != blank %}
                        <h3 class="qf3__block-heading">{{ block.settings.heading }}</h3>
                      {% endif %}

                      {% if block.settings.content != blank %}
                        <div class="qf3__rte">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                    </div>

                  {% when 'custom_liquid' %}
                    <div class="qf3__block qf3__block--custom-liquid" {{ block.shopify_attributes }}>
                      <div class="qf3__custom-liquid">
                        {{ block.settings.custom_liquid }}
                      </div>
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="qf3__bottom">
    <div class="qf3__bottom-inner">
      <div class="qf3__bottom-top">
        <p class="qf3__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>

        {% if section.settings.bottom_menu != blank %}
          <ul class="qf3__bottom-menu" aria-label="Footer utility links">
            {% for link in section.settings.bottom_menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% if section.settings.bottom_message != blank %}
        <p class="qf3__bottom-message">{{ section.settings.bottom_message }}</p>
      {% endif %}

      <div class="qf3__bottom-lower">
        {% if section.settings.show_policy_links and shop.policies != blank %}
          <ul class="qf3__policy-links" aria-label="Policy links">
            {% for policy in shop.policies %}
              {% if policy != blank and policy.url != blank %}
                <li>
                  <a href="{{ policy.url }}">{{ policy.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <div class="qf3__payments" aria-label="Accepted payment methods">
            {% if shop.enabled_payment_types != blank %}
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'qf3__payment-icon' }}
              {% endfor %}
            {% elsif section.settings.show_payment_fallback %}
              <span class="qf3__payment-pill" aria-hidden="true">Visa</span>
              <span class="qf3__payment-pill" aria-hidden="true">Mastercard</span>
              <span class="qf3__payment-pill" aria-hidden="true">Amex</span>
              <span class="qf3__payment-pill" aria-hidden="true">PayPal</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Three",
  "class": "qtm-footer-three-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "footer_layout",
      "label": "Footer layout",
      "default": "editorial",
      "options": [
        { "value": "editorial", "label": "Editorial" },
        { "value": "split_editorial", "label": "Split editorial" },
        { "value": "centered_luxury", "label": "Centered luxury" }
      ]
    },
    {
      "type": "select",
      "id": "footer_width",
      "label": "Footer width",
      "default": "wide",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_menu_behavior",
      "label": "Mobile menu behavior",
      "default": "accordion",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "accordion", "label": "Accordion menus" }
      ]
    },
    {
      "type": "header",
      "content": "Editorial statement"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 110,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "editorial_heading",
      "label": "Editorial heading",
      "default": "Designed for slower moments and lasting quality."
    },
    {
      "type": "richtext",
      "id": "editorial_text",
      "label": "Editorial text",
      "default": "<p>A refined shopping experience built around thoughtful details, timeless design, and everyday elegance.</p>"
    },
    {
      "type": "image_picker",
      "id": "editorial_image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "editorial_image_alt",
      "label": "Editorial image alt text",
      "default": "Editorial brand image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" },
        { "value": "background", "label": "Background" }
      ]
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Receive notes from the studio"
    },
    {
      "type": "richtext",
      "id": "newsletter_body",
      "label": "Newsletter text",
      "default": "<p>Stories, launches, and quiet updates delivered occasionally.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Newsletter button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "newsletter_style",
      "label": "Newsletter style",
      "default": "underline",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "boxed", "label": "Boxed" },
        { "value": "minimal", "label": "Minimal" }
      ]
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_message",
      "label": "Bottom message",
      "default": "Crafted for modern editorial commerce."
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_fallback",
      "label": "Show fallback payment pills if icons are unavailable",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f8f5ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1f1b16"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#71685d"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#16120f"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#282017"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#7a5c3a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#ded4c6"
    },
    {
      "type": "color",
      "id": "bottom_bg",
      "label": "Bottom background",
      "default": "#eee7dc"
    },
    {
      "type": "color",
      "id": "bottom_text_color",
      "label": "Bottom text color",
      "default": "#51483d"
    },
    {
      "type": "color",
      "id": "newsletter_bg",
      "label": "Newsletter background",
      "default": "#f2ece3"
    },
    {
      "type": "color",
      "id": "newsletter_text_color",
      "label": "Newsletter text color",
      "default": "#1f1b16"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "editorial_heading_size",
      "label": "Editorial heading size",
      "min": 34,
      "max": 104,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "editorial_text_size",
      "label": "Editorial text size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Block heading size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 13,
      "max": 19,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "uppercase",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 32,
      "max": 140,
      "step": 4,
      "default": 84,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 32,
      "max": 140,
      "step": 4,
      "default": 76,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Section gap",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 88,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Block gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Radius"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "newsletter_radius",
      "label": "Newsletter radius",
      "min": 0,
      "max": 36,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 36,
      "step": 1,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
