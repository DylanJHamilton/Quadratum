{%- comment -%}
  Collection Modern — Active Filters
  File: snippets/collection-modern-active-filters.liquid
{%- endcomment -%}



{%- liquid
  assign has_active = false
  for f in filters
    if f.active_values != blank and f.active_values.size > 0
      assign has_active = true
      break
    endif
    if f.type == 'price_range'
      if f.min_value.value != blank or f.max_value.value != blank
        assign has_active = true
        break
      endif
    endif
  endfor
-%}

{%- if has_active -%}

<div class="qcm__chips qcmChips" aria-label="Active filters">
  {%- for f in filters -%}
    {%- if f.active_values != blank and f.active_values.size > 0 -%}
      {%- for av in f.active_values -%}
        <a class="qcm__chip qcmChip" href="{{ av.url_to_remove | escape }}">
          {{ f.label | escape }}: {{ av.label | escape }} <span aria-hidden="true">×</span>
        </a>
      {%- endfor -%}
    {%- endif -%}

    {%- if f.type == 'price_range' -%}
      {%- if f.min_value.value != blank or f.max_value.value != blank -%}
        <a class="qcm__chip qcmChip" href="{{ f.url_to_remove | escape }}">
          {{ f.label | escape }}:
          {%- if f.min_value.value != blank -%}{{ f.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
          –
          {%- if f.max_value.value != blank -%}{{ f.max_value.value | money }}{%- else -%}∞{%- endif -%}
          <span aria-hidden="true">×</span>
        </a>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if s.show_clear_all -%}
    {%- capture qcm_base_url -%}{%- render 'section-collection-modern-utils',
      results_url: results_url,
      is_search_context: is_search_context,
      terms_q: terms_q, sort_by: sort_by
    -%}{%- endcapture -%}
    <a class="qcm__chip qcmChip" href="{{ qcm_base_url | escape }}">
      Clear all <span aria-hidden="true">↺</span>
    </a>
  {%- endif -%}
</div>
{%- endif -%}
