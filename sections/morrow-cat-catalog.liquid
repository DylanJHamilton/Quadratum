<script src="{{ 'morrow-cat-store.js' | asset_url }}" defer="defer"></script>
<section id="morrow-cat-catalog" class="mc-catalog" data-mc-catalog aria-labelledby="MorrowCatalogTitle-{{ section.id }}">
  <div class="mc-catalog__intro">
    <div><p class="mc-eyebrow">{{ section.settings.kicker | escape }}</p><h2 id="MorrowCatalogTitle-{{ section.id }}">{{ section.settings.heading | escape }}<br><em>{{ section.settings.heading_accent | escape }}</em></h2></div>
    <div class="mc-catalog__description">{{ section.settings.description }}</div>
  </div>
  <div class="mc-catalog__toolbar">
    <div class="mc-filter-list" role="group" aria-label="Filter sample concepts">
      <button type="button" class="mc-filter is-active" data-mc-filter="All" aria-pressed="true">Everything <span>{{ section.blocks.size }}</span></button>
      <button type="button" class="mc-filter" data-mc-filter="Play" aria-pressed="false">Play</button>
      <button type="button" class="mc-filter" data-mc-filter="Rest" aria-pressed="false">Rest</button>
      <button type="button" class="mc-filter" data-mc-filter="Feeding" aria-pressed="false">Feeding</button>
      <button type="button" class="mc-filter" data-mc-filter="Care" aria-pressed="false">Care</button>
    </div>
    <label class="mc-search"><span class="visually-hidden">Search sample concepts</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg><input type="search" data-mc-search placeholder="Find a little something"></label>
  </div>
  <div class="mc-product-grid">
    {% for block in section.blocks %}
      {%- liquid
        assign product_asset = block.settings.image_asset | default: 'mc-window-perch.webp'
        assign product_alt = block.settings.image_alt | default: block.settings.title
      -%}
      <article class="mc-product-card" data-mc-product data-mc-category="{{ block.settings.category | escape }}" data-mc-name="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
        <div class="mc-product-card__art">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'mc-product-card__image', alt: product_alt, loading: 'lazy', widths: '320, 480, 640, 900' }}
          {% else %}
            <img class="mc-product-card__image" src="{{ product_asset | asset_url }}" alt="{{ product_alt | escape }}" width="900" height="900" loading="lazy">
          {% endif %}
          <span class="mc-product-card__badge">Fictional concept</span>
        </div>
        <div class="mc-product-card__content">
          <div class="mc-product-card__meta"><span>{{ block.settings.category | escape }}</span><span>{{ block.settings.sku | escape }}</span></div>
          <h3>{{ block.settings.title | escape }}</h3>
          <p class="mc-product-card__description">{{ block.settings.description | escape }}</p>
          <div class="mc-product-card__foot"><span>{{ block.settings.demo_price | escape }} <small>fictional demo price</small></span><details class="mc-product-card__details"><summary>Concept notes</summary><p>{{ block.settings.details | escape }}</p><p><strong>To verify:</strong> {{ block.settings.verify | escape }}. Supplier evidence has not been supplied.</p></details></div>
        </div>
      </article>
    {% endfor %}
  </div>
  <p class="mc-catalog__empty" data-mc-empty hidden>No little discoveries found. Try another collection.</p>
  <div class="mc-catalog__end"><span>{{ section.settings.end_note | escape }}</span><span>24 fictional concepts / 4 collections</span></div>
</section>
{% schema %}
{
  "name":"Morrow Cat Concepts",
  "max_blocks":24,
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"The Morrow collection / demo only"},
    {"type":"text","id":"heading","label":"Heading","default":"Small discoveries."},
    {"type":"text","id":"heading_accent","label":"Accent line","default":"Big cat energy."},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Play, rest, feeding and care, all with room for a little personality. Browse the fictional collection and explore the design direction.</p>"},
    {"type":"text","id":"end_note","label":"End note","default":"That’s the whole curious crew."}
  ],
  "blocks":[{"type":"concept","name":"Product concept","settings":[
    {"type":"select","id":"category","label":"Collection","options":[{"value":"Play","label":"Play"},{"value":"Rest","label":"Rest"},{"value":"Feeding","label":"Feeding"},{"value":"Care","label":"Care"}],"default":"Play"},
    {"type":"text","id":"sku","label":"Demo reference","default":"MC-01"},
    {"type":"text","id":"title","label":"Name","default":"Window Perch"},
    {"type":"text","id":"description","label":"Short description","default":"A window-side resting spot with a furniture-like silhouette."},
    {"type":"text","id":"demo_price","label":"Fictional demo price","default":"$89"},
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"text","id":"image_asset","label":"Theme asset filename","default":"mc-window-perch.webp"},
    {"type":"text","id":"image_alt","label":"Image description","default":"Window Perch, generated fictional product concept."},
    {"type":"textarea","id":"details","label":"Concept notes","default":"A fictional design idea shown for the Quadratum storefront demo. No product is available for purchase."},
    {"type":"textarea","id":"verify","label":"Supplier facts to verify","default":"Materials, dimensions, construction, safety and care"}
  ]}],
  "presets":[{"name":"Morrow Cat Concepts","blocks":[{"type":"concept"}]}]
}
{% endschema %}

