{%- liquid
  assign block_id = 'product-metafield-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign namespace = block.settings.namespace
  assign metafield_key = block.settings.key
  assign metafield_value = blank
  assign display_style = block.settings.display_style | default: 'text'

  if product_context != blank and namespace != blank and metafield_key != blank
    assign metafield_value = product_context.metafields[namespace][metafield_key]
  endif

  assign has_value = false

  if metafield_value != blank
    assign has_value = true
  endif

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-metafield
    product-metafield--{{ display_style }}
    product-metafield--width-{{ width }}
    product-metafield--align-{{ alignment }}
    {% unless show_on_desktop %} product-metafield--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-metafield--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-metafield--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-metafield--animate product-metafield--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-metafield-margin-top: {{ block.settings.margin_top }}px;
    --product-metafield-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-metafield-padding: {{ block.settings.padding }}px;
    --product-metafield-card-padding: {{ block.settings.card_padding }}px;
    --product-metafield-gap: {{ block.settings.content_gap }}px;
    --product-metafield-radius: {{ block.settings.card_radius }}px;
    --product-metafield-border-width: {{ block.settings.border_width }}px;
    --product-metafield-image-width: {{ block.settings.image_width }}px;
    --product-metafield-image-radius: {{ block.settings.image_radius }}px;
    --product-metafield-heading-color: {{ block.settings.heading_color }};
    --product-metafield-text-color: {{ block.settings.text_color }};
    --product-metafield-muted-color: {{ block.settings.muted_color }};
    --product-metafield-background: {{ block.settings.background_color }};
    --product-metafield-card-background: {{ block.settings.card_background_color }};
    --product-metafield-badge-background: {{ block.settings.badge_background_color }};
    --product-metafield-badge-text: {{ block.settings.badge_text_color }};
    --product-metafield-border-color: {{ block.settings.border_color }};
    --product-metafield-link-color: {{ block.settings.link_color }};
    --product-metafield-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-metafield
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-metafield-margin-top);
      margin-bottom: var(--product-metafield-margin-bottom);
      padding: var(--product-metafield-padding);
      color: var(--product-metafield-text-color);
      background: var(--product-metafield-background);
    }

    #{{ block_id }}.product-metafield--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-metafield--width-small {
      max-width: 560px;
    }

    #{{ block_id }}.product-metafield--width-medium {
      max-width: 760px;
    }

    #{{ block_id }}.product-metafield--width-large {
      max-width: 980px;
    }

    #{{ block_id }}.product-metafield--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-metafield--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-metafield--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-metafield--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-metafield__inner {
      display: grid;
      gap: var(--product-metafield-gap);
      min-width: 0;
      color: var(--product-metafield-text-color);
    }

    #{{ block_id }}.product-metafield--text .product-metafield__inner,
    #{{ block_id }}.product-metafield--rich_text .product-metafield__inner,
    #{{ block_id }}.product-metafield--list .product-metafield__inner,
    #{{ block_id }}.product-metafield--file_link .product-metafield__inner {
      padding: var(--product-metafield-card-padding);
      background: var(--product-metafield-card-background);
      border: var(--product-metafield-border-width) solid var(--product-metafield-border-color);
      border-radius: var(--product-metafield-radius);
    }

    #{{ block_id }}.product-metafield--badge .product-metafield__inner {
      display: inline-grid;
      width: fit-content;
      max-width: 100%;
    }

    #{{ block_id }}.product-metafield--align-center.product-metafield--badge .product-metafield__inner {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-metafield--align-right.product-metafield--badge .product-metafield__inner {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-metafield__label {
      margin: 0;
      color: var(--product-metafield-heading-color);
      font-size: {{ block.settings.label_size }}px;
      line-height: 1.25;
      font-weight: 800;
    }

    #{{ block_id }} .product-metafield__content {
      color: var(--product-metafield-text-color);
      font-size: {{ block.settings.text_size }}px;
      line-height: 1.6;
    }

    #{{ block_id }} .product-metafield__content p:first-child {
      margin-top: 0;
    }

    #{{ block_id }} .product-metafield__content p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-metafield__content ul,
    #{{ block_id }} .product-metafield__content ol {
      padding-left: 1.25em;
    }

    #{{ block_id }} .product-metafield__badge {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: {{ block.settings.badge_padding_y }}px {{ block.settings.badge_padding_x }}px;
      color: var(--product-metafield-badge-text);
      background: var(--product-metafield-badge-background);
      border: var(--product-metafield-border-width) solid var(--product-metafield-border-color);
      border-radius: {{ block.settings.badge_radius }}px;
      font-size: {{ block.settings.badge_text_size }}px;
      line-height: 1.2;
      font-weight: 800;
      text-align: center;
    }

    #{{ block_id }} .product-metafield__list {
      display: flex;
      flex-wrap: wrap;
      gap: {{ block.settings.list_gap }}px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #{{ block_id }}.product-metafield--align-center .product-metafield__list {
      justify-content: center;
    }

    #{{ block_id }}.product-metafield--align-right .product-metafield__list {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-metafield__list-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px;
      color: var(--product-metafield-text-color);
      background: {{ block.settings.list_item_background_color }};
      border: var(--product-metafield-border-width) solid var(--product-metafield-border-color);
      border-radius: {{ block.settings.list_item_radius }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-metafield__list-item::before {
      content: "";
      width: 6px;
      height: 6px;
      background: var(--product-metafield-link-color);
      border-radius: 999px;
    }

    #{{ block_id }} .product-metafield__image-wrap {
      display: inline-block;
      width: min(100%, var(--product-metafield-image-width));
      overflow: hidden;
      background: #f6f6f6;
      border-radius: var(--product-metafield-image-radius);
    }

    #{{ block_id }} .product-metafield__image {
      display: block;
      width: 100%;
      height: auto;
    }

    #{{ block_id }} .product-metafield__file-link {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: {{ block.settings.file_link_height }}px;
      padding: 10px 14px;
      color: var(--product-metafield-link-color);
      background: transparent;
      border: var(--product-metafield-border-width) solid var(--product-metafield-border-color);
      border-radius: {{ block.settings.file_link_radius }}px;
      text-decoration: none;
      line-height: 1.25;
      font-weight: 800;
    }

    #{{ block_id }} .product-metafield__file-link:hover {
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }

    #{{ block_id }} .product-metafield__file-icon {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      color: var(--product-metafield-badge-text);
      background: var(--product-metafield-link-color);
      border-radius: 6px;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
    }

    #{{ block_id }} .product-metafield__fallback {
      color: var(--product-metafield-muted-color);
      font-size: {{ block.settings.text_size }}px;
      line-height: 1.55;
    }

    #{{ block_id }} .product-metafield__file-link:focus-visible {
      outline: 2px solid var(--product-metafield-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }}.product-metafield--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-metafield--animate-fade {
      animation-name: productMetafieldFade;
    }

    #{{ block_id }}.product-metafield--animate-fade_up {
      animation-name: productMetafieldFadeUp;
    }

    #{{ block_id }}.product-metafield--animate-zoom {
      animation-name: productMetafieldZoom;
    }

    @keyframes productMetafieldFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productMetafieldFadeUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productMetafieldZoom {
      from {
        opacity: 0;
        transform: scale(0.98);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-metafield--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-metafield--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-metafield--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-metafield__label {
        font-size: {{ block.settings.label_size_mobile }}px;
      }

      #{{ block_id }} .product-metafield__content,
      #{{ block_id }} .product-metafield__fallback {
        font-size: {{ block.settings.text_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-metafield--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  {% if has_value %}
    <div class="product-metafield__inner">
      {% if block.settings.show_label and block.settings.label != blank and display_style != 'badge' %}
        <h3 class="product-metafield__label">
          {{ block.settings.label | escape }}
        </h3>
      {% endif %}

      {% case display_style %}
        {% when 'badge' %}
          <span class="product-metafield__badge">
            {% if block.settings.show_label and block.settings.label != blank %}
              <span>{{ block.settings.label | escape }}:</span>
            {% endif %}
            <span>
              {% if metafield_value.type == 'single_line_text_field' or metafield_value.type == 'number_integer' or metafield_value.type == 'number_decimal' or metafield_value.type == 'boolean' %}
                {{ metafield_value.value }}
              {% else %}
                {{ metafield_value | metafield_text }}
              {% endif %}
            </span>
          </span>

        {% when 'rich_text' %}
          <div class="product-metafield__content">
            {{ metafield_value | metafield_tag }}
          </div>

        {% when 'list' %}
          <ul class="product-metafield__list">
            {% if metafield_value.value.size > 0 %}
              {% for item in metafield_value.value %}
                <li class="product-metafield__list-item">
                  {{ item }}
                </li>
              {% endfor %}
            {% else %}
              <li class="product-metafield__list-item">
                {{ metafield_value | metafield_text }}
              </li>
            {% endif %}
          </ul>

        {% when 'image' %}
          <div class="product-metafield__content">
            {% if metafield_value.type == 'file_reference' and metafield_value.value.media_type == 'image' %}
              {%- liquid
                assign metafield_image = metafield_value.value
                assign metafield_image_alt = block.settings.label

                if metafield_image.alt != blank
                  assign metafield_image_alt = metafield_image.alt
                endif
              -%}

              <span class="product-metafield__image-wrap">
                {{ metafield_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900, 1200', alt: metafield_image_alt, class: 'product-metafield__image' }}
              </span>
            {% else %}
              {{ metafield_value | metafield_tag }}
            {% endif %}
          </div>

        {% when 'file_link' %}
          {% if metafield_value.type == 'file_reference' %}
            <a class="product-metafield__file-link" href="{{ metafield_value.value.url }}" target="_blank" rel="noopener">
              <span class="product-metafield__file-icon" aria-hidden="true">↓</span>
              <span>
                {% if block.settings.file_link_label != blank %}
                  {{ block.settings.file_link_label | escape }}
                {% else %}
                  {{ block.settings.label | escape }}
                {% endif %}
              </span>
            </a>
          {% else %}
            <div class="product-metafield__content">
              {{ metafield_value | metafield_tag }}
            </div>
          {% endif %}

        {% else %}
          <div class="product-metafield__content">
            {% if metafield_value.type == 'single_line_text_field' or metafield_value.type == 'number_integer' or metafield_value.type == 'number_decimal' or metafield_value.type == 'boolean' %}
              {{ metafield_value.value }}
            {% else %}
              {{ metafield_value | metafield_text }}
            {% endif %}
          </div>
      {% endcase %}
    </div>
  {% elsif block.settings.show_fallback %}
    <div class="product-metafield__inner">
      {% if block.settings.show_label and block.settings.label != blank and display_style != 'badge' %}
        <h3 class="product-metafield__label">
          {{ block.settings.label | escape }}
        </h3>
      {% endif %}

      <div class="product-metafield__fallback">
        {{ block.settings.fallback_text | escape }}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product metafield",
  "settings": [
    {
      "type": "header",
      "content": "Metafield"
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "Namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Key",
      "default": "details"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Product detail"
    },
    {
      "type": "checkbox",
      "id": "show_fallback",
      "label": "Show fallback when blank",
      "default": false
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "Additional product details will appear here when available."
    },

    {
      "type": "header",
      "content": "Display style"
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "rich_text",
          "label": "Rich text"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "file_link",
          "label": "File link"
        }
      ]
    },
    {
      "type": "text",
      "id": "file_link_label",
      "label": "File link label",
      "default": "Download file"
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "label": "Label size mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "badge_text_size",
      "label": "Badge text size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 120,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "range",
      "id": "badge_padding_x",
      "label": "Badge horizontal padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_padding_y",
      "label": "Badge vertical padding",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Badge radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "List"
    },
    {
      "type": "range",
      "id": "list_gap",
      "label": "List gap",
      "min": 4,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "list_item_radius",
      "label": "List item radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "list_item_background_color",
      "label": "List item background",
      "default": "#f7f7f7"
    },

    {
      "type": "header",
      "content": "File link"
    },
    {
      "type": "range",
      "id": "file_link_height",
      "label": "File link height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "file_link_radius",
      "label": "File link radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#6f6f6f"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link / accent color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus color",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
