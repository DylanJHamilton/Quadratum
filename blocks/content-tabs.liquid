{%- liquid
  assign block_id = 'content-tabs-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'horizontal'
  assign tab_count = block.settings.tab_count | default: 3

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
  assign has_panel_content = false
  for panel_number in (1..6)
    if panel_number <= tab_count
      assign panel_key = 'tab_' | append: panel_number | append: '_label'
      if block.settings[panel_key] != blank
        assign has_panel_content = true
      endif
    endif
  endfor
-%}

{% if has_panel_content or request.design_mode %}
<div
  id="{{ block_id }}"
  data-qtm-tabs
  data-tabs-vertical="{% if layout_style == 'vertical' %}true{% else %}false{% endif %}"
  data-tabs-breakpoint="750"
  class="
    content-tabs
    content-tabs--{{ layout_style }}
    content-tabs--width-{{ block_width }}
    content-tabs--align-{{ text_alignment }}
    {% unless show_on_desktop or request.design_mode %} content-tabs--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} content-tabs--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} content-tabs--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} content-tabs--animate content-tabs--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-tabs-margin-top: {{ block.settings.margin_top }}px;
    --content-tabs-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-tabs-padding: {{ block.settings.padding }}px;
    --content-tabs-gap: {{ block.settings.gap }}px;
    --content-tabs-border-width: {{ block.settings.border_width }}px;
    --content-tabs-border-radius: {{ block.settings.border_radius }}px;
    --content-tabs-heading-color: {{ block.settings.heading_color }};
    --content-tabs-text-color: {{ block.settings.text_color }};
    --content-tabs-background-color: {{ block.settings.background_color }};
    --content-tabs-border-color: {{ block.settings.border_color }};
    --content-tabs-link-color: {{ block.settings.link_color }};
    --content-tabs-tab-background: {{ block.settings.tab_background_color }};
    --content-tabs-tab-active-background: {{ block.settings.active_tab_background_color }};
    --content-tabs-tab-active-text: {{ block.settings.active_tab_text_color }};
    --content-tabs-panel-background: {{ block.settings.panel_background_color }};
  "
>
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--content-tabs-margin-top);
      margin-bottom: var(--content-tabs-margin-bottom);
      padding: var(--content-tabs-padding);
      color: var(--content-tabs-text-color);
      background: var(--content-tabs-background-color);
    }

    #{{ block_id }}.content-tabs--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-tabs--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-tabs--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-tabs--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-tabs--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-tabs--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-tabs--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-tabs--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-tabs__inner {
      display: grid;
      gap: var(--content-tabs-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }}.content-tabs--vertical .content-tabs__inner {
      grid-template-columns: minmax(180px, 28%) minmax(0, 1fr);
      align-items: start;
    }

    #{{ block_id }} .content-tabs__list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      width: 100%;
      min-width: 0;
      border-color: var(--content-tabs-border-color);
    }

    #{{ block_id }}.content-tabs--vertical .content-tabs__list {
      flex-direction: column;
      align-items: stretch;
    }

    #{{ block_id }}.content-tabs--align-center:not(.content-tabs--vertical) .content-tabs__list {
      justify-content: center;
    }

    #{{ block_id }}.content-tabs--align-right:not(.content-tabs--vertical) .content-tabs__list {
      justify-content: flex-end;
    }

    #{{ block_id }}.content-tabs--underline .content-tabs__list {
      gap: 0;
      border-bottom: var(--content-tabs-border-width) solid var(--content-tabs-border-color);
    }

    #{{ block_id }} .content-tabs__tab {
      appearance: none;
      border: var(--content-tabs-border-width) solid var(--content-tabs-border-color);
      border-radius: var(--content-tabs-border-radius);
      background: var(--content-tabs-tab-background);
      color: var(--content-tabs-heading-color);
      cursor: pointer;
      min-height: 42px;
      padding: 11px 16px;
      line-height: 1.2;
      text-align: inherit;
      transition: background 180ms ease, color 180ms ease, border-color 180ms ease, opacity 180ms ease;
    }

    #{{ block_id }}.content-tabs--underline .content-tabs__tab {
      border-width: 0 0 var(--content-tabs-border-width) 0;
      border-radius: 0;
      background: transparent;
      margin-bottom: calc(var(--content-tabs-border-width) * -1);
    }

    #{{ block_id }}.content-tabs--pills .content-tabs__tab {
      border-radius: 999px;
    }

    #{{ block_id }} .content-tabs__tab:hover {
      opacity: 0.78;
    }

    #{{ block_id }} .content-tabs__tab[aria-selected="true"] {
      background: var(--content-tabs-tab-active-background);
      color: var(--content-tabs-tab-active-text);
      border-color: var(--content-tabs-link-color);
    }

    #{{ block_id }}.content-tabs--underline .content-tabs__tab[aria-selected="true"] {
      color: var(--content-tabs-link-color);
      background: transparent;
      border-color: var(--content-tabs-link-color);
    }

    #{{ block_id }} .content-tabs__tab:focus-visible {
      outline: 2px solid var(--content-tabs-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-tabs__panels {
      min-width: 0;
      width: 100%;
    }

    #{{ block_id }} .content-tabs__panel {
      display: none;
      min-width: 0;
      color: var(--content-tabs-text-color);
      background: var(--content-tabs-panel-background);
      border: var(--content-tabs-border-width) solid var(--content-tabs-border-color);
      border-radius: var(--content-tabs-border-radius);
      padding: 24px;
    }

    #{{ block_id }}.content-tabs--underline .content-tabs__panel,
    #{{ block_id }}.content-tabs--minimal .content-tabs__panel {
      border-color: transparent;
      background: transparent;
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }} .content-tabs__panel.is-active {
      display: block;
    }

    #{{ block_id }} .content-tabs__panel-inner {
      display: grid;
      gap: 14px;
      min-width: 0;
    }

    #{{ block_id }} .content-tabs__heading {
      margin: 0;
      color: var(--content-tabs-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .content-tabs__content {
      color: var(--content-tabs-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-tabs__content p {
      margin-top: 0;
    }

    #{{ block_id }} .content-tabs__content p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-tabs__content a {
      color: var(--content-tabs-link-color);
      text-underline-offset: 0.2em;
    }

    #{{ block_id }} .content-tabs__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      padding: 11px 16px;
      border-radius: var(--content-tabs-border-radius);
      color: var(--content-tabs-link-color);
      border: var(--content-tabs-border-width) solid currentColor;
      text-decoration: none;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-tabs__button:hover {
      opacity: 0.78;
      transform: translateY(-1px);
    }

    #{{ block_id }}.content-tabs--align-center .content-tabs__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-tabs--align-right .content-tabs__button {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.content-tabs--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-tabs--animate-fade {
      animation-name: contentTabsFade;
    }

    #{{ block_id }}.content-tabs--animate-fade_up {
      animation-name: contentTabsFadeUp;
    }

    #{{ block_id }}.content-tabs--animate-fade_down {
      animation-name: contentTabsFadeDown;
    }

    #{{ block_id }}.content-tabs--animate-fade_left {
      animation-name: contentTabsFadeLeft;
    }

    #{{ block_id }}.content-tabs--animate-fade_right {
      animation-name: contentTabsFadeRight;
    }

    #{{ block_id }}.content-tabs--animate-zoom {
      animation-name: contentTabsZoom;
    }

    @keyframes contentTabsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentTabsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTabsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTabsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTabsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTabsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-tabs--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-tabs--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-tabs--vertical .content-tabs__inner {
        grid-template-columns: minmax(160px, 32%) minmax(0, 1fr);
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-tabs--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-tabs--vertical .content-tabs__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-tabs--vertical .content-tabs__list {
        flex-direction: row;
      }

      #{{ block_id }} .content-tabs__list {
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
      }

      #{{ block_id }} .content-tabs__tab {
        flex: 0 0 auto;
        scroll-snap-align: start;
        white-space: nowrap;
      }

      #{{ block_id }} .content-tabs__panel {
        padding: 20px;
      }

      #{{ block_id }}.content-tabs--underline .content-tabs__panel,
      #{{ block_id }}.content-tabs--minimal .content-tabs__panel {
        padding-left: 0;
        padding-right: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-tabs--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-tabs__tab,
      #{{ block_id }} .content-tabs__button {
        transition: none;
      }

      #{{ block_id }} .content-tabs__button:hover {
        transform: none;
      }
    }

    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} img, #{{ block_id }} video, #{{ block_id }} iframe { max-width: 100%; }
{% unless show_on_desktop or request.design_mode %}@media (min-width: 990px) { #shopify-block-{{ block.id }} { display: none !important; } }{% endunless %}
{% unless show_on_tablet or request.design_mode %}@media (min-width: 750px) and (max-width: 989px) { #shopify-block-{{ block.id }} { display: none !important; } }{% endunless %}
{% unless show_on_mobile or request.design_mode %}@media (max-width: 749px) { #shopify-block-{{ block.id }} { display: none !important; } }{% endunless %}
    #{{ block_id }} a { color: var(--content-tabs-link-color); text-underline-offset: .2em; }
    #{{ block_id }} a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    #{{ block_id }} [data-qtm-tabpanel]:not([hidden]) { display: block; }
    #{{ block_id }}:not(.qtm-panels-ready) .content-tabs__inner { grid-template-columns: minmax(0, 1fr); }
  </style>

  {% if request.design_mode %}<p>Add tab labels and the content you want visitors to read.</p>{% endif %}
  <div class="content-tabs__inner">
    <div
      class="content-tabs__list"
      role="tablist"
      data-qtm-tablist hidden
      aria-label="{{ block.settings.aria_label | escape }}"
    >
      {%- for index in (1..6) -%}
        {%- if index <= tab_count -%}
          {%- liquid
            assign label_key = 'tab_' | append: index | append: '_label'
            assign tab_label = block.settings[label_key]
          -%}

          {% if tab_label != blank %}
            <button
              class="content-tabs__tab"
              id="{{ block_id }}-tab-{{ index }}"
              type="button"
              role="tab" data-qtm-tab
              aria-selected="{% if index == 1 %}true{% else %}false{% endif %}"
              aria-controls="{{ block_id }}-panel-{{ index }}"
              tabindex="{% if index == 1 %}0{% else %}-1{% endif %}"
              data-content-tabs-tab
              data-content-tabs-index="{{ index }}"
            >
              {{ tab_label | escape }}
            </button>
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="content-tabs__panels">
      {%- for index in (1..6) -%}
        {%- if index <= tab_count -%}
          {%- liquid
            assign label_key = 'tab_' | append: index | append: '_label'
            assign heading_key = 'tab_' | append: index | append: '_heading'
            assign content_key = 'tab_' | append: index | append: '_content'
            assign button_label_key = 'tab_' | append: index | append: '_button_label'
            assign button_url_key = 'tab_' | append: index | append: '_button_url'

            assign tab_label = block.settings[label_key]
            assign tab_heading = block.settings[heading_key]
            assign tab_content = block.settings[content_key]
            assign tab_button_label = block.settings[button_label_key]
            assign tab_button_url = block.settings[button_url_key]
          -%}

          {% if tab_label != blank %}
            <div
              class="content-tabs__panel {% if index == 1 %}is-active{% endif %}"
              id="{{ block_id }}-panel-{{ index }}"
              role="region" data-qtm-tabpanel
              aria-labelledby="{{ block_id }}-tab-{{ index }}"

              data-content-tabs-panel
              data-content-tabs-index="{{ index }}"
            >
              <div class="content-tabs__panel-inner">
                {% if tab_heading != blank %}
                  <h3 class="content-tabs__heading">
                    {{ tab_heading | escape }}
                  </h3>
                {% endif %}

                {% if tab_content != blank %}
                  <div class="content-tabs__content">
                    {{ tab_content }}
                  </div>
                {% endif %}

                {% if tab_button_label != blank and tab_button_url != blank %}
                  <a class="content-tabs__button" href="{{ tab_button_url | escape }}">
                    {{ tab_button_label | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>


{% endif %}
{% schema %}
{
  "name": "Content tabs",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Tab list accessibility label",
      "default": "Content tabs"
    },
    {
      "type": "range",
      "id": "tab_count",
      "label": "Number of tabs",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab label"
    },
    {
      "type": "text",
      "id": "tab_1_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "tab_1_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "tab_1_button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "tab_1_button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab label"
    },
    {
      "type": "text",
      "id": "tab_2_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "tab_2_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "tab_2_button_label",
      "label": "Button label"
    },
    {
      "type": "url",
