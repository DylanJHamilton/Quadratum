{%- comment -%}
  Decorative Lucide icon by name, rendered inline from the versioned icon library.
  Its hosts provide the icon box size. Blank/none emits no icon.
{%- endcomment -%}
{%- assign icon_name = name | default: '' | strip | remove: '.svg' | handleize -%}
{%- if icon_name != blank and icon_name != 'none' -%}
  <svg data-q-icon="lucide-{{ icon_name | escape }}" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="width:100%;height:100%;display:block">
    {% assign symbol_id = icon_name | prepend: 'lucide-' %}{% render 'q-icon-symbol', symbol_id: symbol_id %}
  </svg>
{%- endif -%}
