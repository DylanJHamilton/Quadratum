{% if product != blank %}
{%- liquid
  assign block_id = 'product-variant-picker-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant
  assign selected_allocation = current_variant.selected_selling_plan_allocation
  if selected_allocation == blank and product_context.requires_selling_plan
    assign selected_allocation = current_variant.selling_plan_allocations.first
  endif

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign picker_style = block.settings.picker_style | default: 'pills'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{% if product_context.has_only_default_variant == false or request.design_mode %}
  <div
    id="{{ block_id }}"
    class="
      product-variant-picker
      product-variant-picker--{{ picker_style }}
      product-variant-picker--width-{{ width }}
      product-variant-picker--align-{{ alignment }}
      {% unless show_on_desktop or request.design_mode %} product-variant-picker--hide-desktop{% endunless %}
      {% unless show_on_tablet or request.design_mode %} product-variant-picker--hide-tablet{% endunless %}
      {% unless show_on_mobile or request.design_mode %} product-variant-picker--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-variant-picker--animate product-variant-picker--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-variant-picker-margin-top: {{ block.settings.margin_top }}px;
      --product-variant-picker-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-variant-picker-padding: {{ block.settings.padding }}px;
      --product-variant-picker-gap: {{ block.settings.gap }}px;
      --product-variant-picker-option-gap: {{ block.settings.option_gap }}px;
      --product-variant-picker-button-gap: {{ block.settings.button_gap }}px;
      --product-variant-picker-border-width: {{ block.settings.border_width }}px;
      --product-variant-picker-border-radius: {{ block.settings.border_radius }}px;
      --product-variant-picker-swatch-size: {{ block.settings.swatch_size }}px;
      --product-variant-picker-heading-color: {{ block.settings.heading_color }};
      --product-variant-picker-text-color: {{ block.settings.text_color }};
      --product-variant-picker-background-color: {{ block.settings.background_color }};
      --product-variant-picker-border-color: {{ block.settings.border_color }};
      --product-variant-picker-active-background: {{ block.settings.active_background_color }};
      --product-variant-picker-active-text: {{ block.settings.active_text_color }};
      --product-variant-picker-active-border: {{ block.settings.active_border_color }};
      --product-variant-picker-disabled-opacity: {{ block.settings.disabled_opacity | divided_by: 100.0 }};
    "
    data-qtm-product-block-commerce="variant-picker"
  data-product-url="{{ product_context.url | escape }}"
  data-requires-plan="{{ product_context.requires_selling_plan }}"
  data-initial-plan="{{ selected_allocation.selling_plan.id }}"
  data-add-label="{{ 'Add to cart' | escape }}"
  data-sold-label="{{ block.settings.sold_out_text | default: 'Sold out' | escape }}"
  data-unavailable-label="{{ block.settings.unavailable_text | default: 'Unavailable' | escape }}"
  data-available-label="{{ block.settings.available_text | default: 'Available' | escape }}"
  data-cart-adding-message="{{ 'Adding to cart...' | escape }}"
  data-cart-added-message="{{ 'Added to cart.' | escape }}"
  data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-product-variant-picker

  >
    {% render 'qtm-product-block-data', product: product_context %}
  <style>
      #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
        width: 100%;
        margin-top: var(--product-variant-picker-margin-top);
        margin-bottom: var(--product-variant-picker-margin-bottom);
        padding: var(--product-variant-picker-padding);
        color: var(--product-variant-picker-text-color);
        background: transparent;
      }

      #{{ block_id }}.product-variant-picker--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-variant-picker--width-small {
        max-width: 640px;
      }

      #{{ block_id }}.product-variant-picker--width-medium {
        max-width: 820px;
      }

      #{{ block_id }}.product-variant-picker--width-large {
        max-width: 1040px;
      }

      #{{ block_id }}.product-variant-picker--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-variant-picker--align-left {
        margin-left: 0;
        margin-right: auto;
        text-align: left;
      }

      #{{ block_id }}.product-variant-picker--align-center {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      #{{ block_id }}.product-variant-picker--align-right {
        margin-left: auto;
        margin-right: 0;
        text-align: right;
      }

      #{{ block_id }} .product-variant-picker__inner {
        display: grid;
        gap: var(--product-variant-picker-gap);
        min-width: 0;
      }

      #{{ block_id }} .product-variant-picker__option {
        display: grid;
        gap: var(--product-variant-picker-option-gap);
        min-width: 0;
      }

      #{{ block_id }} .product-variant-picker__label-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
      }

      #{{ block_id }}.product-variant-picker--align-center .product-variant-picker__label-row {
        justify-content: center;
      }

      #{{ block_id }}.product-variant-picker--align-right .product-variant-picker__label-row {
        justify-content: flex-end;
      }

      #{{ block_id }} .product-variant-picker__label {
        margin: 0;
        color: var(--product-variant-picker-heading-color);
        line-height: 1.25;
        font-size: 0.94em;
      }

      #{{ block_id }} .product-variant-picker__selected-value {
        color: var(--product-variant-picker-text-color);
        line-height: 1.25;
        font-size: 0.9em;
        opacity: 0.78;
      }

      #{{ block_id }} .product-variant-picker__select {
        width: 100%;
        min-height: 46px;
        padding: 0 38px 0 12px;
        color: var(--product-variant-picker-heading-color);
        background: var(--product-variant-picker-background-color);
        border: var(--product-variant-picker-border-width) solid var(--product-variant-picker-border-color);
        border-radius: var(--product-variant-picker-border-radius);
      }

      #{{ block_id }} .product-variant-picker__select:focus-visible {
        outline: 2px solid var(--product-variant-picker-active-border);
        outline-offset: 2px;
      }

      #{{ block_id }} .product-variant-picker__values {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--product-variant-picker-button-gap);
        min-width: 0;
      }

      #{{ block_id }}.product-variant-picker--align-center .product-variant-picker__values {
        justify-content: center;
      }

      #{{ block_id }}.product-variant-picker--align-right .product-variant-picker__values {
        justify-content: flex-end;
      }

      #{{ block_id }} .product-variant-picker__button {
        appearance: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        min-width: 42px;
        padding: 10px 14px;
        color: var(--product-variant-picker-text-color);
        background: var(--product-variant-picker-background-color);
        border: var(--product-variant-picker-border-width) solid var(--product-variant-picker-border-color);
        border-radius: var(--product-variant-picker-border-radius);
        cursor: pointer;
        line-height: 1.2;
        text-align: center;
        transition: border-color 180ms ease, background 180ms ease, color 180ms ease, opacity 180ms ease, transform 180ms ease;
      }

      #{{ block_id }}.product-variant-picker--buttons .product-variant-picker__button {
        border-radius: max(calc(var(--product-variant-picker-border-radius) - 8px), 0px);
      }

      #{{ block_id }}.product-variant-picker--pills .product-variant-picker__button {
        border-radius: var(--product-variant-picker-border-radius);
      }

      #{{ block_id }} .product-variant-picker__button:hover {
        border-color: var(--product-variant-picker-active-border);
        transform: translateY(-1px);
      }

      #{{ block_id }} .product-variant-picker__button:focus-visible {
        outline: 2px solid var(--product-variant-picker-active-border);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-variant-picker__button.is-active {
        color: var(--product-variant-picker-active-text);
        background: var(--product-variant-picker-active-background);
        border-color: var(--product-variant-picker-active-border);
      }

      #{{ block_id }} .product-variant-picker__button.is-unavailable {
        opacity: var(--product-variant-picker-disabled-opacity);
      }

      #{{ block_id }} .product-variant-picker__button.is-unavailable .product-variant-picker__button-text {
        text-decoration: line-through;
      }

      #{{ block_id }} .product-variant-picker__swatch {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--product-variant-picker-swatch-size);
        height: var(--product-variant-picker-swatch-size);
        padding: 3px;
        border-radius: 999px;
      }

      #{{ block_id }}.product-variant-picker--swatches .product-variant-picker__button {
        min-width: auto;
        min-height: auto;
        padding: 3px;
        border-radius: 999px;
      }

      #{{ block_id }} .product-variant-picker__swatch-color {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 999px;
        background: var(--swatch-color, #d8d8d8);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
      }

      #{{ block_id }} .product-variant-picker__swatch-label { overflow-wrap: anywhere; }

      #{{ block_id }} .product-variant-picker__status {
        min-height: 1.3em;
        color: var(--product-variant-picker-text-color);
        font-size: 0.9em;
        line-height: 1.35;
        opacity: 0.84;
      }

      #{{ block_id }}.product-variant-picker--dropdown .product-variant-picker__values,
      #{{ block_id }}.product-variant-picker--buttons .product-variant-picker__select,
      #{{ block_id }}.product-variant-picker--pills .product-variant-picker__select,
      #{{ block_id }}.product-variant-picker--swatches .product-variant-picker__select {
        display: none;
      }

      #{{ block_id }}.product-variant-picker--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-variant-picker--animate-fade {
        animation-name: productVariantPickerFade;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_up {
        animation-name: productVariantPickerFadeUp;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_down {
        animation-name: productVariantPickerFadeDown;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_left {
        animation-name: productVariantPickerFadeLeft;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_right {
        animation-name: productVariantPickerFadeRight;
      }

      #{{ block_id }}.product-variant-picker--animate-zoom {
        animation-name: productVariantPickerZoom;
      }

      @keyframes productVariantPickerFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productVariantPickerFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productVariantPickerFadeDown {
        from {
          opacity: 0;
          transform: translateY(-20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productVariantPickerFadeLeft {
        from {
          opacity: 0;
          transform: translateX(20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productVariantPickerFadeRight {
        from {
          opacity: 0;
          transform: translateX(-20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productVariantPickerZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-variant-picker--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-variant-picker--hide-tablet {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }}.product-variant-picker--hide-mobile {
          display: none !important;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-variant-picker--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }

        #{{ block_id }} .product-variant-picker__button {
          transition: none;
        }

        #{{ block_id }} .product-variant-picker__button:hover {
          transform: none;
        }
      }
      #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} :is(button, select, input, a):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    #{{ block_id }} :is(button, select, input) { max-width: 100%; }
    #{{ block_id }}:focus-within { opacity: 1; transform: none; animation: none; }
    #{{ block_id }} [data-b8-fallback] { display: grid; gap: 6px; min-width: 0; }
    #{{ block_id }} [data-b8-fallback] select, #{{ block_id }} [name="selling_plan"] { width: 100%; min-width: 0; min-height: 44px; }
  {% unless block.settings.show_on_desktop or request.design_mode %}@media screen and (min-width: 990px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_tablet or request.design_mode %}@media screen and (min-width: 750px) and (max-width: 989px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_mobile or request.design_mode %}@media screen and (max-width: 749px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
  </style>

    <div data-b8-variant-links><ul>{% for variant in product_context.variants %}<li><a href="{{ variant.url | escape }}">{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</a></li>{% endfor %}</ul></div>
    <div class="product-variant-picker__inner" data-b8-option-controls hidden>
      {% for option in product_context.options_with_values %}
        <fieldset class="product-variant-picker__option" data-product-variant-option data-option-position="{{ option.position }}">
          <legend class="product-variant-picker__label">
              {{ option.name | escape }}
            </legend>

            {% if block.settings.show_selected_value %}
              <span class="product-variant-picker__selected-value" data-product-variant-selected-value>
                {{ option.selected_value | escape }}
              </span>
            {% endif %}

          <select
            class="product-variant-picker__select"
            data-product-variant-select data-b8-option-select
            data-option-position="{{ option.position }}"
            aria-label="{{ option.name | escape }}"
          >
            {% for value in option.values %}
              {% assign value_text = value.name | default: value | append: '' %}
              <option
                value="{{ value_text | escape }}"
                {% if value.selected or option.selected_value == value_text %}selected{% endif %}
              >
                {{ value_text | escape }}
              </option>
            {% endfor %}
          </select>

          <div class="product-variant-picker__values" role="group" aria-label="{{ option.name | escape }}">
            {% for value in option.values %}
              {% assign value_text = value.name | default: value | append: '' %}
              {%- liquid
                assign swatch_color = '#d8d8d8'
                assign has_swatch = false
                if value.swatch.color != blank
                  assign swatch_color = value.swatch.color
                  assign has_swatch = true
                endif

              -%}

              <button
                type="button"
                class="product-variant-picker__button {% if value.selected or option.selected_value == value_text %}is-active{% endif %}"
                data-product-variant-value
                data-option-position="{{ option.position }}"
                data-option-value="{{ value_text | escape }}"
                aria-pressed="{% if value.selected or option.selected_value == value_text %}true{% else %}false{% endif %}"
              >
                {% if picker_style == 'swatches' and value.swatch.image != blank %}
                  {{ value.swatch.image | image_url: width: 144 | image_tag: loading: 'lazy', alt: '', class: 'product-variant-picker__swatch' }}
                  <span>{{ value_text | escape }}</span>
                {% elsif picker_style == 'swatches' and has_swatch %}
                  <span class="product-variant-picker__swatch" aria-hidden="true">
                    <span class="product-variant-picker__swatch-color" style="--swatch-color: {{ swatch_color | escape }};"></span>
                  </span>
                  <span class="product-variant-picker__swatch-label">
                    {{ value_text | escape }}
                  </span>
                {% else %}
                  <span class="product-variant-picker__button-text">
                    {{ value_text | escape }}
                  </span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </fieldset>
      {% endfor %}

      {% if block.settings.show_status %}
        <div class="product-variant-picker__status" data-product-variant-status aria-live="polite">
          {% if current_variant.available %}
            {{ block.settings.available_text | escape }}
          {% else %}
            {{ block.settings.sold_out_text | escape }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% elsif request.design_mode %}<p>Select a product to configure this block.</p>{% endif %}

{% schema %}
{
  "name": "Product variant picker",
  "settings": [
    {
      "type": "header",
      "content": "Variant picker"
    },
    {
      "type": "select",
      "id": "picker_style",
      "label": "Picker style",
      "default": "pills",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "swatches",
          "label": "Swatches"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_selected_value",
      "label": "Show selected value",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show availability status",
      "default": true
    },
    {
      "type": "text",
      "id": "available_text",
      "label": "Available text",
      "default": "Available"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable text",
      "default": "Unavailable"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "disabled_opacity",
      "label": "Unavailable opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Label color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Button border",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "active_background_color",
      "label": "Active background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active border",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "option_gap",
      "label": "Option gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Button gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
