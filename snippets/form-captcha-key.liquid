{%- comment -%}
  Public client key only. Local override > retained provider-specific legacy key >
  shared global key for the selected global provider. Verification secrets stay server-side.
{%- endcomment -%}
{%- liquid
  assign key = local_key | strip
  if key == blank
    if mode == 'turnstile'
      assign key = settings.captcha_turnstile_site_key | strip
    elsif mode == 'recaptcha_v3'
      assign key = settings.captcha_recaptcha_site_key | strip
    endif
    if key == blank or key == 'none'
      if mode == settings.forms_captcha_provider
        assign key = settings.captcha_site_key | strip
      endif
    endif
  endif
  if mode == 'turnstile' or mode == 'recaptcha_v3'
    unless key == blank or key == 'none'
      echo key
    endunless
  endif
-%}
