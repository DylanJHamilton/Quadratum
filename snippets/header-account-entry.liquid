{%- comment -%}
  Shopify owns account state, the signed-in avatar and the account sheet.
  Native header markup is a loading/no-JS fallback, never a second active menu.
  desktop_enabled is optional; Header One keeps its independent mobile setting.
{%- endcomment -%}
{%- if shop.customer_accounts_enabled -%}
  {%- liquid
    assign menu_handle = account_menu.handle | default: account_menu | default: 'customer-account-main-menu'
    assign account_display = display | default: 'icon'
  -%}
  {{ 'header-account-entry.css' | asset_url | stylesheet_tag }}
  <shopify-account
    class="qtm-account-entry qtm-account-entry--{{ variant | escape }}{% if desktop_enabled == false %} qtm-account-entry--mobile-only{% endif %}"
    menu="{{ menu_handle | escape }}"
  >
    <div slot="signed-out-avatar" class="{{ avatar_class | escape }} qtm-account-entry__avatar qtm-account-entry__avatar--{{ account_display | escape }}">
      {{ icon }}
      <span class="qtm-account-entry__label">{{ 'customer.login.sign_in' | t | escape }}</span>
    </div>
  </shopify-account>
  <div class="qtm-account-entry__fallback{% if desktop_enabled == false %} qtm-account-entry__fallback--mobile-only{% endif %}" data-qtm-account-fallback>
    {{ fallback }}
  </div>
{%- endif -%}
