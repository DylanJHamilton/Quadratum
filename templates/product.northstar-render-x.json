          "settings": {
            "question": "Can I change the configuration before it ships?",
            "answer": "<p>Yes, until assembly starts. A specialist confirms compatibility before any change.</p>"
          }
        },
        "ns_1": {
          "type": "faq_item",
          "settings": {
            "question": "Does it ship with an operating system?",
            "answer": "<p>The concept illustrates Windows 11 Pro or a system without an operating system. These are not checkout options in this demonstration store.</p>"
          }
        },
        "ns_2": {
          "type": "faq_item",
          "settings": {
            "question": "How loud is it under load?",
            "answer": "<p>We publish noise measurements only with the method, distance and workload. Ask for the record for this configuration.</p>"
          }
        },
        "ns_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if a part fails?",
            "answer": "<p>Contact support. We diagnose the whole system and handle the repair under one warranty.</p>"
          }
        }
