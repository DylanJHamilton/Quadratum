<div
  id="HeaderFiveMobileDrawer-{{ section_id }}"
  class="qtmHeaderFive__mobileDrawer"
  hidden
  aria-hidden="true"
  data-qtm-h5-mobile-panel
>
  <div class="qtmHeaderFive__mobileOverlay" data-qtm-h5-mobile-close></div>

  <div class="qtmHeaderFive__mobileDialog" role="dialog" aria-modal="true" aria-label="Marketplace menu">
    <div class="qtmHeaderFive__mobileTop">
      <a class="qtmHeaderFive__mobileBrand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% if settings.logo_primary != blank %}
          <img
            class="qtmHeaderFive__mobileLogo"
            src="{{ settings.logo_primary | image_url: width: 460 }}"
            alt="{{ shop.name | escape }}"
            loading="eager"
          >
        {% elsif settings.logo_mobile != blank %}
          <img
            class="qtmHeaderFive__mobileLogo"
            src="{{ settings.logo_mobile | image_url: width: 460 }}"
            alt="{{ shop.name | escape }}"
            loading="eager"
          >
        {% else %}
          <span class="qtmHeaderFive__mobileBrandText">{{ shop.name }}</span>
        {% endif %}
      </a>

      <button
        type="button"
        class="qtmHeaderFive__mobileClose"
        aria-label="Close menu"
        data-qtm-h5-mobile-close
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="qtmHeaderFive__mobileSearch">
      {% if search_display == 'inline_static' or search_display == 'predictive' %}
        {% render 'search-form-static',
          form_context: 'header-five-mobile',
          input_id: 'HeaderFiveMobileSearchInput-' | append: section_id,
          placeholder: section_settings.search_placeholder,
          show_button: true
        %}
      {% elsif search_display == 'popup' and settings.enable_search_popup %}
        <button type="button" class="qtmHeaderFive__mobileSearchButton" data-search-popup-open>
          Search products
        </button>
      {% else %}
        <a class="qtmHeaderFive__mobileSearchButton" href="{{ routes.search_url }}">
          Search products
        </a>
      {% endif %}
    </div>

    {% if section_settings.show_tracking_link and section_settings.tracking_url != blank %}
      <a class="qtmHeaderFive__mobileTracking" href="{{ section_settings.tracking_url }}">
        {{ section_settings.tracking_label }}
      </a>
    {% endif %}

    <div class="qtmHeaderFive__mobileSection">
      <h2 class="qtmHeaderFive__mobileHeading">Departments</h2>

      <nav class="qtmHeaderFive__mobileDepartments" aria-label="Mobile departments">
        {% if department_menu != blank %}
          {% for link in department_menu.links %}
            <div class="qtmHeaderFive__mobileDepartmentItem">
              {% if link.links != blank %}
                <button
                  type="button"
                  class="qtmHeaderFive__mobileDepartmentToggle"
                  aria-expanded="false"
                  aria-controls="HeaderFiveMobileChildren-{{ section_id }}-{{ forloop.index }}"
                  data-qtm-h5-mobile-nested-toggle
                >
                  <span>{{ link.title }}</span>
                  <svg viewBox="0 0 12 8" fill="none" aria-hidden="true">
                    <path d="M1 1.25L6 6.25L11 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <div
                  id="HeaderFiveMobileChildren-{{ section_id }}-{{ forloop.index }}"
                  class="qtmHeaderFive__mobileDepartmentChildren"
                  hidden
                >
                  <a
                    class="qtmHeaderFive__mobileDepartmentChild qtmHeaderFive__mobileDepartmentChild--parent"
                    href="{{ link.url }}"
                    {% if link.active %}aria-current="page"{% endif %}
                  >
                    View {{ link.title }}
                  </a>

                  {% for child_link in link.links %}
                    <a
                      class="qtmHeaderFive__mobileDepartmentChild{% if child_link.active %} qtmHeaderFive__mobileDepartmentChild--active{% endif %}"
                      href="{{ child_link.url }}"
                      {% if child_link.active %}aria-current="page"{% endif %}
                    >
                      {{ child_link.title }}
                    </a>
                  {% endfor %}
                </div>
              {% else %}
                <a
                  class="qtmHeaderFive__mobileDepartmentLink{% if link.active %} qtmHeaderFive__mobileDepartmentLink--active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.active %}aria-current="page"{% endif %}
                >
                  {{ link.title }}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </nav>
    </div>

    {% if section_settings.show_category_row and category_menu != blank %}
      <div class="qtmHeaderFive__mobileSection">
        <h2 class="qtmHeaderFive__mobileHeading">Popular Categories</h2>

        <nav class="qtmHeaderFive__mobileCategoryGrid" aria-label="Mobile categories">
          {% for link in category_menu.links %}
            <a
              class="qtmHeaderFive__mobileCategoryLink{% if link.active %} qtmHeaderFive__mobileCategoryLink--active{% endif %}"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>
          {% endfor %}
        </nav>
      </div>
    {% endif %}

    <div class="qtmHeaderFive__mobileUtilities">
      {% if section_settings.show_account %}
        <a class="qtmHeaderFive__mobileUtilityLink" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          {% if customer %}Account{% else %}Sign In{% endif %}
        </a>
      {% endif %}

      {% if section_settings.show_cart %}
        <button type="button" class="qtmHeaderFive__mobileUtilityLink" data-cart-drawer-open>
          Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
        </button>
      {% endif %}

      {% for block in blocks %}
        {% if block.type == 'utility_link' %}
          {% if block.settings.label != blank and block.settings.url != blank %}
            <a class="qtmHeaderFive__mobileUtilityLink" href="{{ block.settings.url }}">
              {{ block.settings.label }}
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>