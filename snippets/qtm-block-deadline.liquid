{%- liquid
  assign valid = true
  assign date_value = target_date | strip
  assign time_value = target_time | strip
  assign offset_value = offset | strip
  assign date_parts = date_value | split: '-'
  assign time_parts = time_value | split: ':'
  assign offset_parts = offset_value | slice: 1, 5 | split: ':'
  assign sign = offset_value | slice: 0, 1
  assign digits = date_parts | join: '' | append: time_parts[0] | append: time_parts[1] | append: time_parts[2] | append: offset_parts[0] | append: offset_parts[1]
  assign remainder = digits | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
  if date_value.size != 10 or date_parts.size != 3 or remainder != blank
    assign valid = false
  endif
  if date_parts[0].size != 4 or date_parts[1].size != 2 or date_parts[2].size != 2 or time_parts[0].size != 2 or time_parts[1].size != 2
    assign valid = false
  endif
  if time_value.size == 5 and time_parts.size == 2
    assign time_value = time_value | append: ':00'
  elsif time_value.size != 8 or time_parts.size != 3 or time_parts[2].size != 2
    assign valid = false
  endif
  if offset_value.size != 6 or offset_parts.size != 2 or offset_parts[0].size != 2 or offset_parts[1].size != 2
    assign valid = false
  endif
  if sign != '+' and sign != '-'
    assign valid = false
  endif
  assign year = date_parts[0] | plus: 0
  assign month = date_parts[1] | plus: 0
  assign day = date_parts[2] | plus: 0
  assign hours = time_parts[0] | plus: 0
  assign minutes = time_parts[1] | plus: 0
  assign seconds = time_parts[2] | plus: 0
  assign offset_hours = offset_parts[0] | plus: 0
  assign offset_minutes = offset_parts[1] | plus: 0
  assign month_days = 31
  case month
    when 4, 6, 9, 11
      assign month_days = 30
    when 2
      assign month_days = 28
      assign mod4 = year | modulo: 4
      assign mod100 = year | modulo: 100
      assign mod400 = year | modulo: 400
      if mod400 == 0
        assign month_days = 29
      elsif mod4 == 0 and mod100 != 0
        assign month_days = 29
      endif
  endcase
  if year < 1970 or year > 9999 or month < 1 or month > 12 or day < 1 or day > month_days or hours > 23 or minutes > 59 or seconds > 59 or offset_hours > 14 or offset_minutes > 59
    assign valid = false
  endif
  if offset_hours == 14 and offset_minutes != 0
    assign valid = false
  endif
  if valid
    assign timestamp = date_value | append: 'T' | append: time_value | append: offset_value
    assign epoch = timestamp | date: '%s'
    assign epoch_remainder = epoch | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    if epoch != blank and epoch_remainder == blank
      echo epoch
    endif
  endif
-%}
