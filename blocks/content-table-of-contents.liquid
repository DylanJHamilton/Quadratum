{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-toc
    qtm-toc-{{ block_id }}
    qtm-toc--width-{{ block_width }}
    qtm-toc--align-{{ block_alignment }}
    qtm-toc--layout-{{ block.settings.layout_style }}
    qtm-toc--animation-{{ animation }}
    {% if block.settings.enable_sticky %} qtm-toc--sticky{% endif %}
    {% unless block.settings.show_desktop %} qtm-toc--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-toc--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-toc--hide-mobile{% endunless %}
  "
  style="
    --qtm-toc-margin-top: {{ block.settings.margin_top }}px;
    --qtm-toc-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-toc-padding: {{ block.settings.padding }}px;
    --qtm-toc-gap: {{ block.settings.gap }}px;
    --qtm-toc-heading-color: {{ block.settings.heading_color }};
    --qtm-toc-text-color: {{ block.settings.text_color }};
    --qtm-toc-background-color: {{ block.settings.background_color }};
    --qtm-toc-card-background: {{ block.settings.card_background_color }};
    --qtm-toc-item-background: {{ block.settings.item_background_color }};
    --qtm-toc-item-hover-background: {{ block.settings.item_hover_background_color }};
    --qtm-toc-border-color: {{ block.settings.border_color }};
    --qtm-toc-link-color: {{ block.settings.link_color }};
    --qtm-toc-number-background: {{ block.settings.number_background_color }};
    --qtm-toc-number-color: {{ block.settings.number_color }};
    --qtm-toc-arrow-color: {{ block.settings.arrow_color }};
    --qtm-toc-border-width: {{ block.settings.border_width }}px;
    --qtm-toc-border-radius: {{ block.settings.border_radius }}px;
    --qtm-toc-sticky-offset: {{ block.settings.sticky_offset }}px;
  "
  {{ block.shopify_attributes }}
>
  <nav class="qtm-toc__nav" aria-label="{{ block.settings.nav_label | escape }}">
    <div class="qtm-toc__card">
      {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
        <div class="qtm-toc__header">
          {% if block.settings.eyebrow != blank %}
            <p class="qtm-toc__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="qtm-toc__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="qtm-toc__text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <ol class="qtm-toc__list" role="list">
        {% for i in (1..10) %}
          {% liquid
            assign enabled_key = 'item_' | append: i | append: '_enabled'
            assign label_key = 'item_' | append: i | append: '_label'
            assign anchor_key = 'item_' | append: i | append: '_anchor'
            assign description_key = 'item_' | append: i | append: '_description'

            assign item_enabled = block.settings[enabled_key]
            assign item_label = block.settings[label_key]
            assign item_anchor = block.settings[anchor_key] | remove: '#'
            assign item_description = block.settings[description_key]
          %}

          {% if item_enabled and item_label != blank and item_anchor != blank %}
            <li class="qtm-toc__item">
              <a class="qtm-toc__link" href="#{{ item_anchor | escape }}">
                {% if block.settings.show_numbers %}
                  <span class="qtm-toc__number" aria-hidden="true">
                    {{ forloop.index }}
                  </span>
                {% endif %}

                <span class="qtm-toc__copy">
                  <span class="qtm-toc__label">
                    {{ item_label | escape }}
                  </span>

                  {% if block.settings.show_descriptions and item_description != blank %}
                    <span class="qtm-toc__description">
                      {{ item_description | escape }}
                    </span>
                  {% endif %}
                </span>

                {% if block.settings.show_arrows %}
                  <span class="qtm-toc__arrow" aria-hidden="true">
                    {{ block.settings.arrow_icon | escape }}
                  </span>
                {% endif %}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>
  </nav>
</div>

<style>
  .qtm-toc-{{ block_id }} {
    margin-top: var(--qtm-toc-margin-top);
    margin-bottom: var(--qtm-toc-margin-bottom);
    padding: var(--qtm-toc-padding);
    color: var(--qtm-toc-text-color);
    background: var(--qtm-toc-background-color);
    border: var(--qtm-toc-border-width) solid var(--qtm-toc-border-color);
    border-radius: var(--qtm-toc-border-radius);
  }

  .qtm-toc-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--width-auto {
    width: auto;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--width-small {
    max-width: 520px;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--width-medium {
    max-width: 760px;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--width-large {
    max-width: 1040px;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--sticky {
    position: sticky;
    top: var(--qtm-toc-sticky-offset);
    z-index: 5;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__nav {
    display: block;
    width: 100%;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__card {
    display: grid;
    gap: var(--qtm-toc-gap);
    width: 100%;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--layout-card .qtm-toc__card,
  .qtm-toc-{{ block_id }}.qtm-toc--layout-sticky .qtm-toc__card {
    padding: clamp(1rem, 2vw, 1.4rem);
    background: var(--qtm-toc-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-toc-border-color), transparent 10%);
    border-radius: calc(var(--qtm-toc-border-radius) * 0.75);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
  }

  .qtm-toc-{{ block_id }}.qtm-toc--layout-minimal .qtm-toc__card {
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__header {
    display: grid;
    gap: 0.65rem;
    max-width: 720px;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-center .qtm-toc__header {
    margin-inline: auto;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-right .qtm-toc__header {
    margin-left: auto;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__eyebrow {
    margin: 0;
    color: var(--qtm-toc-link-color);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__heading {
    margin: 0;
    color: var(--qtm-toc-heading-color);
    line-height: 1.08;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__text {
    color: var(--qtm-toc-text-color);
    line-height: 1.7;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__text p {
    margin-top: 0;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__list {
    display: grid;
    gap: calc(var(--qtm-toc-gap) * 0.45);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: qtm-toc-counter;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__item {
    min-width: 0;
    counter-increment: qtm-toc-counter;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    min-height: {{ block.settings.item_min_height }}px;
    padding: 0.75rem 0.9rem;
    color: var(--qtm-toc-link-color);
    background: var(--qtm-toc-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-toc-border-color), transparent 12%);
    border-radius: calc(var(--qtm-toc-border-radius) * 0.5);
    text-align: left;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-center .qtm-toc__link {
    text-align: center;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--align-right .qtm-toc__link {
    text-align: right;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__link:hover {
    background: var(--qtm-toc-item-hover-background);
    border-color: color-mix(in srgb, var(--qtm-toc-link-color), transparent 72%);
    opacity: 0.95;
    transform: translateY(-1px);
  }

  .qtm-toc-{{ block_id }} .qtm-toc__link:focus-visible {
    outline: 3px solid var(--qtm-toc-link-color);
    outline-offset: 4px;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__number {
    display: grid;
    place-items: center;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    color: var(--qtm-toc-number-color);
    background: var(--qtm-toc-number-background);
    border-radius: 999px;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__label {
    color: inherit;
    font-weight: 850;
    line-height: 1.25;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__description {
    color: var(--qtm-toc-text-color);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__arrow {
    color: var(--qtm-toc-arrow-color);
    font-weight: 900;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .qtm-toc-{{ block_id }} .qtm-toc__link:hover .qtm-toc__arrow {
    transform: translateY(2px);
  }

  .qtm-toc-{{ block_id }}.qtm-toc--layout-list .qtm-toc__link {
    background: transparent;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--layout-minimal .qtm-toc__link {
    min-height: auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--layout-minimal .qtm-toc__link:hover {
    background: transparent;
    border-color: transparent;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--animation-fade {
    animation: qtm-toc-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--animation-fade-up {
    animation: qtm-toc-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--animation-fade-down {
    animation: qtm-toc-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--animation-fade-left {
    animation: qtm-toc-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--animation-fade-right {
    animation: qtm-toc-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-toc-{{ block_id }}.qtm-toc--animation-zoom {
    animation: qtm-toc-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-toc-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-toc-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-toc-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-toc-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-toc-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-toc-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-toc-{{ block_id }}.qtm-toc--hide-tablet {
      display: none !important;
    }

    .qtm-toc-{{ block_id }}.qtm-toc--sticky {
      position: static;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-toc-{{ block_id }}.qtm-toc--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-toc-{{ block_id }} {
      padding: min(var(--qtm-toc-padding), 24px);
    }

    .qtm-toc-{{ block_id }}.qtm-toc--hide-mobile {
      display: none !important;
    }

    .qtm-toc-{{ block_id }}.qtm-toc--layout-card .qtm-toc__card,
    .qtm-toc-{{ block_id }}.qtm-toc--layout-sticky .qtm-toc__card {
      padding: 1rem;
    }

    .qtm-toc-{{ block_id }} .qtm-toc__link {
      min-height: max(42px, {{ block.settings.item_min_height | minus: 8 }}px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-toc-{{ block_id }},
    .qtm-toc-{{ block_id }} *,
    .qtm-toc-{{ block_id }} *::before,
    .qtm-toc-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Table of contents",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "On this page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Table of contents"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Jump to the section you want to read.</p>"
    },
    {
