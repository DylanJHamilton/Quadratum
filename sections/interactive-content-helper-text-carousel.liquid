    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "default": "800",
      "options": [
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" },
        { "value": "800", "label": "800" }
      ]
    },
    { "type": "range", "id": "subtext_size", "label": "Subtext size (px)", "min": 10, "max": 26, "step": 1, "default": 14 },
