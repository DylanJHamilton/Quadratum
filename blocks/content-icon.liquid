    },
    {
      "name": "Linked icon",
      "settings": {
        "icon_mode": "text",
        "icon_text": "→",
        "icon_size": 36,
        "icon_color": "#ffffff",
        "show_background": true,
        "icon_background": "#111111",
        "icon_padding": 14,
        "icon_radius": 80,
        "icon_border_width": 1,
        "icon_border_color": "#111111",
        "open_new_tab": false,
        "decorative": false,
        "aria_label": "Open link",
        "content_width": "auto",
        "alignment": "left",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "none",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    }
  ]
}
{% endschema %}