      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "Supplier catalog"
    },
    {
      "type": "select",
      "id": "collection_source",
      "label": "Collection source",
      "default": "metaobject",
      "options": [
        {
          "value": "metaobject",
          "label": "Supplier metaobject field (catalog_collection)"
