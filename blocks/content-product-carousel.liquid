{%- liquid
  assign block_id = 'content-product-carousel-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign source = block.settings.product_source | default: 'collection'
  assign selected_collection = block.settings.collection
  assign product_limit = block.settings.product_limit | default: 8
  assign carousel_layout = block.settings.carousel_layout | default: 'standard'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-product-carousel
    content-product-carousel--{{ carousel_layout }}
    content-product-carousel--width-{{ width }}
    content-product-carousel--align-{{ alignment }}
    {% unless show_on_desktop %} content-product-carousel--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-product-carousel--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-product-carousel--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-product-carousel--animate content-product-carousel--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-product-carousel-margin-top: {{ block.settings.margin_top }}px;
    --content-product-carousel-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-product-carousel-padding: {{ block.settings.padding }}px;
    --content-product-carousel-gap: {{ block.settings.slide_gap }}px;
    --content-product-carousel-card-padding: {{ block.settings.card_padding }}px;
    --content-product-carousel-card-radius: {{ block.settings.card_radius }}px;
    --content-product-carousel-border-width: {{ block.settings.border_width }}px;
    --content-product-carousel-columns-desktop: {{ block.settings.columns_desktop }};
    --content-product-carousel-columns-tablet: {{ block.settings.columns_tablet }};
    --content-product-carousel-columns-mobile: {{ block.settings.columns_mobile }};
    --content-product-carousel-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-product-carousel-heading-color: {{ block.settings.heading_color }};
    --content-product-carousel-text-color: {{ block.settings.text_color }};
    --content-product-carousel-price-color: {{ block.settings.price_color }};
    --content-product-carousel-sale-color: {{ block.settings.sale_color }};
    --content-product-carousel-background: {{ block.settings.background_color }};
    --content-product-carousel-card-background: {{ block.settings.card_background_color }};
    --content-product-carousel-border-color: {{ block.settings.border_color }};
    --content-product-carousel-button-background: {{ block.settings.button_background_color }};
    --content-product-carousel-button-text: {{ block.settings.button_text_color }};
    --content-product-carousel-arrow-background: {{ block.settings.arrow_background_color }};
    --content-product-carousel-arrow-text: {{ block.settings.arrow_text_color }};
    --content-product-carousel-dot-color: {{ block.settings.dot_color }};
    --content-product-carousel-dot-active: {{ block.settings.dot_active_color }};
    --content-product-carousel-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-product-carousel
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-product-carousel-margin-top);
      margin-bottom: var(--content-product-carousel-margin-bottom);
      padding: var(--content-product-carousel-padding);
      color: var(--content-product-carousel-text-color);
      background: var(--content-product-carousel-background);
    }

    #{{ block_id }}.content-product-carousel--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-product-carousel--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.content-product-carousel--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.content-product-carousel--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.content-product-carousel--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-product-carousel--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-product-carousel--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-product-carousel--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-product-carousel__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-product-carousel__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.content-product-carousel--centered .content-product-carousel__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-product-carousel__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .content-product-carousel__eyebrow {
      margin: 0;
      color: var(--content-product-carousel-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-product-carousel__heading {
      margin: 0;
      color: var(--content-product-carousel-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-product-carousel__description {
      margin: 0;
      color: var(--content-product-carousel-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-product-carousel__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .content-product-carousel__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--content-product-carousel-arrow-text);
      background: var(--content-product-carousel-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-product-carousel__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-carousel__arrow:focus-visible {
      outline: 2px solid var(--content-product-carousel-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-carousel__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .content-product-carousel__viewport {
      width: 100%;
      overflow: hidden;
    }

    #{{ block_id }}.content-product-carousel--peek .content-product-carousel__viewport {
      overflow: visible;
    }

    #{{ block_id }} .content-product-carousel__track {
      display: flex;
      gap: var(--content-product-carousel-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    #{{ block_id }} .content-product-carousel__track::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }} .content-product-carousel__slide {
      flex: 0 0 calc((100% - (var(--content-product-carousel-gap) * (var(--content-product-carousel-columns-desktop) - 1))) / var(--content-product-carousel-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }}.content-product-carousel--centered .content-product-carousel__slide {
      scroll-snap-align: center;
    }

    #{{ block_id }}.content-product-carousel--peek .content-product-carousel__slide {
      flex-basis: calc((92% - (var(--content-product-carousel-gap) * (var(--content-product-carousel-columns-desktop) - 1))) / var(--content-product-carousel-columns-desktop));
    }

    #{{ block_id }} .content-product-carousel__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--content-product-carousel-text-color);
      text-decoration: none;
    }

    #{{ block_id }}.content-product-carousel--standard .content-product-carousel__card,
    #{{ block_id }}.content-product-carousel--centered .content-product-carousel__card,
    #{{ block_id }}.content-product-carousel--peek .content-product-carousel__card {
      padding: var(--content-product-carousel-card-padding);
      background: var(--content-product-carousel-card-background);
      border: var(--content-product-carousel-border-width) solid var(--content-product-carousel-border-color);
      border-radius: var(--content-product-carousel-card-radius);
      overflow: hidden;
    }

    #{{ block_id }} .content-product-carousel__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--content-product-carousel-card-radius) - 8px), 0px);
      aspect-ratio: var(--content-product-carousel-image-ratio);
    }

    #{{ block_id }} .content-product-carousel__media img,
    #{{ block_id }} .content-product-carousel__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .content-product-carousel__card:hover .content-product-carousel__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .content-product-carousel__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .content-product-carousel__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--content-product-carousel-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .content-product-carousel__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.content-product-carousel--centered .content-product-carousel__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-product-carousel__vendor {
      color: var(--content-product-carousel-text-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.68;
    }

    #{{ block_id }} .content-product-carousel__title {
      margin: 0;
      color: var(--content-product-carousel-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .content-product-carousel__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .content-product-carousel__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .content-product-carousel__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--content-product-carousel-price-color);
      line-height: 1.25;
    }

    #{{ block_id }} .content-product-carousel__price {
      color: var(--content-product-carousel-price-color);
      font-weight: 700;
    }

    #{{ block_id }} .content-product-carousel__compare {
      color: var(--content-product-carousel-text-color);
      text-decoration: line-through;
      opacity: 0.55;
    }

    #{{ block_id }} .content-product-carousel__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-product-carousel-button-text);
      background: var(--content-product-carousel-button-background);
      border: 1px solid var(--content-product-carousel-button-background);
      border-radius: max(calc(var(--content-product-carousel-card-radius) - 10px), 6px);
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-product-carousel__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-carousel__media:focus-visible,
    #{{ block_id }} .content-product-carousel__title a:focus-visible,
    #{{ block_id }} .content-product-carousel__button:focus-visible {
      outline: 2px solid var(--content-product-carousel-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-carousel__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 4px;
    }

    #{{ block_id }} .content-product-carousel__dot {
      appearance: none;
      width: 9px;
      height: 9px;
      padding: 0;
      background: var(--content-product-carousel-dot-color);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      opacity: 0.48;
    }

    #{{ block_id }} .content-product-carousel__dot.is-active {
      background: var(--content-product-carousel-dot-active);
      opacity: 1;
    }

    #{{ block_id }} .content-product-carousel__dot:focus-visible {
      outline: 2px solid var(--content-product-carousel-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-carousel__empty {
      padding: 18px;
      color: var(--content-product-carousel-text-color);
      background: var(--content-product-carousel-card-background);
      border: var(--content-product-carousel-border-width) solid var(--content-product-carousel-border-color);
      border-radius: var(--content-product-carousel-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-product-carousel--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-product-carousel--animate-fade {
      animation-name: contentProductCarouselFade;
    }

    #{{ block_id }}.content-product-carousel--animate-fade_up {
      animation-name: contentProductCarouselFadeUp;
    }

    #{{ block_id }}.content-product-carousel--animate-zoom {
      animation-name: contentProductCarouselZoom;
    }

    @keyframes contentProductCarouselFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentProductCarouselFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentProductCarouselZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-product-carousel--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-product-carousel--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-product-carousel__slide {
        flex-basis: calc((100% - (var(--content-product-carousel-gap) * (var(--content-product-carousel-columns-tablet) - 1))) / var(--content-product-carousel-columns-tablet));
      }

      #{{ block_id }}.content-product-carousel--peek .content-product-carousel__slide {
        flex-basis: calc((92% - (var(--content-product-carousel-gap) * (var(--content-product-carousel-columns-tablet) - 1))) / var(--content-product-carousel-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-product-carousel--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-product-carousel__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .content-product-carousel__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }

      #{{ block_id }} .content-product-carousel__slide {
        flex-basis: calc((100% - (var(--content-product-carousel-gap) * (var(--content-product-carousel-columns-mobile) - 1))) / var(--content-product-carousel-columns-mobile));
      }

      #{{ block_id }}.content-product-carousel--peek .content-product-carousel__slide {
        flex-basis: 82%;
      }

      #{{ block_id }} .content-product-carousel__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-product-carousel--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-product-carousel__track {
        scroll-behavior: auto;
      }

      #{{ block_id }} .content-product-carousel__media img,
      #{{ block_id }} .content-product-carousel__button,
      #{{ block_id }} .content-product-carousel__arrow {
        transition: none;
      }

      #{{ block_id }} .content-product-carousel__card:hover .content-product-carousel__media img,
      #{{ block_id }} .content-product-carousel__button:hover,
      #{{ block_id }} .content-product-carousel__arrow:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-product-carousel__inner">
    {% if block.settings.show_header %}
      <div class="content-product-carousel__header-row">
        <div class="content-product-carousel__header">
          {% if block.settings.eyebrow != blank %}
            <p class="content-product-carousel__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="content-product-carousel__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="content-product-carousel__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>

        {% if block.settings.show_arrows %}
          <div class="content-product-carousel__controls">
            <button
              type="button"
              class="content-product-carousel__arrow"
              data-content-product-carousel-prev
              aria-label="{{ block.settings.previous_label | escape }}"
            >
              ‹
            </button>

            <button
              type="button"
              class="content-product-carousel__arrow"
              data-content-product-carousel-next
              aria-label="{{ block.settings.next_label | escape }}"
            >
              ›
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {%- liquid
      assign rendered_products = 0
    -%}

    <div class="content-product-carousel__viewport">
      <div
        class="content-product-carousel__track"
        data-content-product-carousel-track
        tabindex="0"
        aria-label="{{ block.settings.carousel_label | escape }}"
      >
        {% if source == 'manual' %}
          {% for carousel_product in block.settings.products limit: product_limit %}
            {%- liquid
              assign rendered_products = rendered_products | plus: 1
              assign carousel_variant = carousel_product.selected_or_first_available_variant
              assign is_on_sale = false

              if carousel_variant.compare_at_price > carousel_variant.price
                assign is_on_sale = true
              endif
            -%}

            <article class="content-product-carousel__slide" data-content-product-carousel-slide>
              <div class="content-product-carousel__card">
                <a class="content-product-carousel__media" href="{{ carousel_product.url }}" aria-label="{{ carousel_product.title | escape }}">
                  {% if carousel_product.featured_image %}
                    {% if forloop.first %}
                      {{ carousel_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: carousel_product.featured_image.alt | default: carousel_product.title }}
                    {% else %}
                      {{ carousel_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: carousel_product.featured_image.alt | default: carousel_product.title }}
                    {% endif %}
                  {% else %}
                    <span class="content-product-carousel__placeholder" aria-hidden="true"></span>
                  {% endif %}

                  {% if block.settings.show_sale_badge and is_on_sale %}
                    <span class="content-product-carousel__badge">
                      {{ block.settings.sale_badge_text | escape }}
                    </span>
                  {% endif %}
                </a>

                <div class="content-product-carousel__content">
                  {% if block.settings.show_vendor and carousel_product.vendor != blank %}
                    <div class="content-product-carousel__vendor">
                      {{ carousel_product.vendor | escape }}
                    </div>
                  {% endif %}

                  <h3 class="content-product-carousel__title">
                    <a href="{{ carousel_product.url }}">
                      {{ carousel_product.title | escape }}
                    </a>
                  </h3>

                  {% if block.settings.show_price %}
                    <div class="content-product-carousel__price-row">
                      <span class="content-product-carousel__price">
                        {{ carousel_variant.price | money }}
                      </span>

                      {% if is_on_sale %}
                        <span class="content-product-carousel__compare">
                          {{ carousel_variant.compare_at_price | money }}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.show_button %}
                    <a class="content-product-carousel__button" href="{{ carousel_product.url }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}

        {% elsif selected_collection != blank %}
          {% for carousel_product in selected_collection.products limit: product_limit %}
            {%- liquid
              assign rendered_products = rendered_products | plus: 1
              assign carousel_variant = carousel_product.selected_or_first_available_variant
              assign is_on_sale = false

              if carousel_variant.compare_at_price > carousel_variant.price
                assign is_on_sale = true
              endif
            -%}

            <article class="content-product-carousel__slide" data-content-product-carousel-slide>
              <div class="content-product-carousel__card">
                <a class="content-product-carousel__media" href="{{ carousel_product.url }}" aria-label="{{ carousel_product.title | escape }}">
                  {% if carousel_product.featured_image %}
                    {% if forloop.first %}
                      {{ carousel_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: carousel_product.featured_image.alt | default: carousel_product.title }}
                    {% else %}
                      {{ carousel_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: carousel_product.featured_image.alt | default: carousel_product.title }}
                    {% endif %}
                  {% else %}
                    <span class="content-product-carousel__placeholder" aria-hidden="true"></span>
                  {% endif %}

                  {% if block.settings.show_sale_badge and is_on_sale %}
                    <span class="content-product-carousel__badge">
                      {{ block.settings.sale_badge_text | escape }}
                    </span>
                  {% endif %}
                </a>

                <div class="content-product-carousel__content">
                  {% if block.settings.show_vendor and carousel_product.vendor != blank %}
                    <div class="content-product-carousel__vendor">
                      {{ carousel_product.vendor | escape }}
                    </div>
                  {% endif %}

                  <h3 class="content-product-carousel__title">
                    <a href="{{ carousel_product.url }}">
                      {{ carousel_product.title | escape }}
                    </a>
                  </h3>

                  {% if block.settings.show_price %}
                    <div class="content-product-carousel__price-row">
                      <span class="content-product-carousel__price">
                        {{ carousel_variant.price | money }}
                      </span>

                      {% if is_on_sale %}
                        <span class="content-product-carousel__compare">
                          {{ carousel_variant.compare_at_price | money }}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.show_button %}
                    <a class="content-product-carousel__button" href="{{ carousel_product.url }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_dots %}
      <div class="content-product-carousel__dots" data-content-product-carousel-dots aria-label="{{ block.settings.dots_label | escape }}"></div>
    {% endif %}

    {% if rendered_products == 0 and block.settings.show_empty_state %}
      <div class="content-product-carousel__empty">
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.contentProductCarouselReady === 'true') return;

      root.dataset.contentProductCarouselReady = 'true';

      const track = root.querySelector('[data-content-product-carousel-track]');
      const slides = Array.from(root.querySelectorAll('[data-content-product-carousel-slide]'));
      const previousButton = root.querySelector('[data-content-product-carousel-prev]');
      const nextButton = root.querySelector('[data-content-product-carousel-next]');
      const dotsWrap = root.querySelector('[data-content-product-carousel-dots]');

      if (!track || !slides.length) return;

      let autoplayTimer = null;

      const getActiveIndex = () => {
        const trackLeft = track.scrollLeft;
        let activeIndex = 0;
        let activeDistance = Infinity;

        slides.forEach((slide, index) => {
          const distance = Math.abs(slide.offsetLeft - trackLeft);

          if (distance < activeDistance) {
            activeDistance = distance;
            activeIndex = index;
          }
        });

        return activeIndex;
      };

      const scrollToIndex = (index) => {
        const normalizedIndex = Math.max(0, Math.min(index, slides.length - 1));
        const slide = slides[normalizedIndex];

        if (!slide) return;

        track.scrollTo({
          left: slide.offsetLeft,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      };

      const updateControls = () => {
        const activeIndex = getActiveIndex();
        const maxScroll = track.scrollWidth - track.clientWidth - 2;

        if (previousButton) {
          previousButton.disabled = track.scrollLeft <= 2;
        }

        if (nextButton) {
          nextButton.disabled = track.scrollLeft >= maxScroll;
        }

        if (dotsWrap) {
          dotsWrap.querySelectorAll('[data-content-product-carousel-dot]').forEach((dot, index) => {
            dot.classList.toggle('is-active', index === activeIndex);
          });
        }
      };

      const buildDots = () => {
        if (!dotsWrap) return;

        dotsWrap.innerHTML = '';

        const goToSlideLabel = {{ block.settings.go_to_slide_label | json }};

        slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'content-product-carousel__dot';
          dot.dataset.contentProductCarouselDot = 'true';
          dot.setAttribute('aria-label', `${goToSlideLabel} ${index + 1}`);

          dot.addEventListener('click', () => {
            scrollToIndex(index);
          });

          dotsWrap.appendChild(dot);
        });
      };

      const startAutoplay = () => {
        if (root.dataset.autoplay !== 'true' || slides.length < 2) return;

        const speed = Math.max(Number(root.dataset.autoplaySpeed || 5000), 2000);

        stopAutoplay();

        autoplayTimer = window.setInterval(() => {
          const activeIndex = getActiveIndex();
          const nextIndex = activeIndex >= slides.length - 1 ? 0 : activeIndex + 1;

          scrollToIndex(nextIndex);
        }, speed);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      if (previousButton) {
        previousButton.addEventListener('click', () => {
          scrollToIndex(getActiveIndex() - 1);
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', () => {
          scrollToIndex(getActiveIndex() + 1);
        });
      }

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateControls);
      }, { passive: true });

      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);
      root.addEventListener('focusin', stopAutoplay);
      root.addEventListener('focusout', startAutoplay);

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          scrollToIndex(getActiveIndex() - 1);
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          scrollToIndex(getActiveIndex() + 1);
        }
      });

      window.addEventListener('resize', updateControls, { passive: true });

      buildDots();
      updateControls();
      startAutoplay();
    })();
  </script>
</div>

