{% liquid
  assign footer_layout = section.settings.footer_layout | default: 'cta_centered'
  assign visual_style = section.settings.visual_style | default: 'soft_minimal'

  assign has_branding_block = false
  assign has_cta_block = false
  assign has_trust_items = false

  for block in section.blocks
    if block.type == 'branding'
      assign has_branding_block = true
    elsif block.type == 'cta'
      assign has_cta_block = true
    elsif block.type == 'trust_item'
      assign has_trust_items = true
    endif
  endfor
%}

<footer
  id="FooterFour-{{ section.id }}"
  class="q-footer-four q-footer-four--layout-{{ footer_layout }} q-footer-four--style-{{ visual_style }}"
  aria-label="Site footer"
>
  <style>
    #FooterFour-{{ section.id }} {
      --qf4-bg: {{ section.settings.bg_color }};
      --qf4-text: {{ section.settings.text_color }};
      --qf4-muted: {{ section.settings.muted_color }};
      --qf4-heading: {{ section.settings.heading_color }};
      --qf4-link: {{ section.settings.link_color }};
      --qf4-link-hover: {{ section.settings.link_hover_color }};
      --qf4-border: {{ section.settings.border_color }};
      --qf4-cta-bg: {{ section.settings.cta_bg }};
      --qf4-cta-text: {{ section.settings.cta_text }};
      --qf4-button-bg: {{ section.settings.button_bg }};
      --qf4-button-text: {{ section.settings.button_text }};
      --qf4-bottom-bg: {{ section.settings.bottom_bg }};
      --qf4-bottom-text: {{ section.settings.bottom_text_color }};
      --qf4-button-radius: {{ section.settings.button_radius }}px;
      --qf4-card-radius: {{ section.settings.card_radius }}px;
      --qf4-padding-top: {{ section.settings.padding_top }}px;
      --qf4-padding-bottom: {{ section.settings.padding_bottom }}px;
      --qf4-section-gap: {{ section.settings.section_gap }}px;
      --qf4-block-padding: {{ section.settings.block_padding }}px;
      --qf4-block-border-width: {{ section.settings.block_border_width }}px;
      --qf4-logo-height: {{ section.settings.default_logo_height }}px;

      width: 100%;
      margin: 0;
      padding: 0;
      background: var(--qf4-bg);
      color: var(--qf4-text);
      border-top: 1px solid var(--qf4-border);
    }

    #FooterFour-{{ section.id }},
    #FooterFour-{{ section.id }} * {
      box-sizing: border-box;
    }

    #FooterFour-{{ section.id }} a {
      color: var(--qf4-link);
      text-decoration: none;
      transition:
        color 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        transform 180ms ease,
        opacity 180ms ease;
    }

    #FooterFour-{{ section.id }} a:hover {
      color: var(--qf4-link-hover);
    }

    #FooterFour-{{ section.id }} a:focus-visible,
    #FooterFour-{{ section.id }} button:focus-visible,
    #FooterFour-{{ section.id }} input:focus-visible {
      outline: 2px solid var(--qf4-link-hover);
      outline-offset: 3px;
    }

    #FooterFour-{{ section.id }} .qf4__shell,
    #FooterFour-{{ section.id }} .qf4__bottom-inner {
      width: 100%;
      max-width: {{ section.settings.container_width }}px;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    #FooterFour-{{ section.id }} .qf4__main {
      width: 100%;
      padding-top: var(--qf4-padding-top);
      padding-bottom: var(--qf4-padding-bottom);
    }

    #FooterFour-{{ section.id }} .qf4__stack {
      display: grid;
      gap: var(--qf4-section-gap);
    }

    #FooterFour-{{ section.id }} .qf4__campaign-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 14px 18px;
      border: var(--qf4-block-border-width) solid var(--qf4-border);
      border-radius: var(--qf4-card-radius);
      background: color-mix(in srgb, var(--qf4-button-bg), transparent 90%);
      color: var(--qf4-text);
      text-align: center;
    }

    #FooterFour-{{ section.id }}.q-footer-four--style-soft_minimal .qf4__campaign-bar,
    #FooterFour-{{ section.id }}.q-footer-four--style-borderless .qf4__campaign-bar {
      border-color: transparent;
      background: color-mix(in srgb, var(--qf4-button-bg), transparent 94%);
    }

    #FooterFour-{{ section.id }} .qf4__campaign-label {
      margin: 0;
      color: var(--qf4-heading);
      font-weight: 800;
      line-height: 1.35;
    }

    #FooterFour-{{ section.id }} .qf4__campaign-date,
    #FooterFour-{{ section.id }} .qf4__campaign-message {
      margin: 0;
      color: var(--qf4-muted);
      font-size: 0.95rem;
      line-height: 1.4;
    }

    #FooterFour-{{ section.id }} .qf4__cta-zone {
      display: grid;
      gap: 22px;
      padding: clamp(28px, 5vw, 56px);
      border-radius: var(--qf4-card-radius);
      background: var(--qf4-cta-bg);
      color: var(--qf4-cta-text);
      text-align: center;
      border: var(--qf4-block-border-width) solid var(--qf4-border);
      overflow: hidden;
      position: relative;
    }

    #FooterFour-{{ section.id }}.q-footer-four--style-borderless .qf4__cta-zone {
      border-color: transparent;
    }

    #FooterFour-{{ section.id }} .qf4__cta-zone::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,0.16), transparent 28%),
        radial-gradient(circle at 80% 0%, rgba(255,255,255,0.10), transparent 30%);
      pointer-events: none;
    }

    #FooterFour-{{ section.id }} .qf4__cta-inner {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 18px;
      max-width: {{ section.settings.cta_max_width }}px;
      margin: 0 auto;
    }

    #FooterFour-{{ section.id }} .qf4__cta-heading {
      margin: 0;
      color: inherit;
      font-size: clamp({{ section.settings.cta_heading_min }}rem, 5vw, {{ section.settings.cta_heading_max }}rem);
      font-weight: 900;
      line-height: 0.98;
      letter-spacing: -0.04em;
    }

    #FooterFour-{{ section.id }} .qf4__cta-text {
      max-width: 62ch;
      margin: 0 auto;
      color: inherit;
      opacity: 0.84;
      font-size: clamp(1rem, 1.4vw, 1.16rem);
      line-height: 1.65;
    }

    #FooterFour-{{ section.id }} .qf4__cta-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 4px;
    }

    #FooterFour-{{ section.id }} .qf4__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 0 24px;
      border-radius: var(--qf4-button-radius);
      border: 1px solid var(--qf4-button-bg);
      background: var(--qf4-button-bg);
      color: var(--qf4-button-text);
      font-size: 0.96rem;
      font-weight: 900;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
    }

    #FooterFour-{{ section.id }} .qf4__button:hover {
      color: var(--qf4-button-text);
      transform: translateY(-1px);
      opacity: 0.92;
    }

    #FooterFour-{{ section.id }} .qf4__button--secondary {
      background: transparent;
      color: inherit;
      border-color: currentColor;
    }

    #FooterFour-{{ section.id }} .qf4__button--secondary:hover {
      color: inherit;
      opacity: 0.82;
    }

    #FooterFour-{{ section.id }} .qf4__trust {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    #FooterFour-{{ section.id }} .qf4__trust-item {
      display: grid;
      gap: 8px;
      min-width: 0;
      padding: var(--qf4-block-padding);
      border: var(--qf4-block-border-width) solid var(--qf4-border);
      border-radius: var(--qf4-card-radius);
      background: color-mix(in srgb, var(--qf4-text), transparent 96%);
    }

    #FooterFour-{{ section.id }}.q-footer-four--style-soft_minimal .qf4__trust-item {
      background: color-mix(in srgb, var(--qf4-text), transparent 98%);
    }

    #FooterFour-{{ section.id }}.q-footer-four--style-borderless .qf4__trust-item {
      border-color: transparent;
      background: transparent;
      padding-inline: 0;
    }

    #FooterFour-{{ section.id }} .qf4__trust-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-width: 34px;
      height: 34px;
      padding: 0 8px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--qf4-button-bg), transparent 86%);
      color: var(--qf4-heading);
      font-size: 0.9rem;
      font-weight: 900;
      line-height: 1;
    }

    #FooterFour-{{ section.id }} .qf4__trust-heading {
      margin: 0;
      color: var(--qf4-heading);
      font-size: 1rem;
      font-weight: 900;
      line-height: 1.2;
    }

    #FooterFour-{{ section.id }} .qf4__trust-text {
      margin: 0;
      color: var(--qf4-muted);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    #FooterFour-{{ section.id }} .qf4__content-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 18px;
      align-items: start;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-cta_centered .qf4__content-grid,
    #FooterFour-{{ section.id }}.q-footer-four--layout-minimal_campaign .qf4__content-grid {
      grid-template-columns: 1fr;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-zone {
      text-align: left;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-inner {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-text,
    #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-heading {
      margin-left: 0;
      margin-right: 0;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-actions {
      justify-content: flex-end;
      margin-top: 0;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-trust_first .qf4__trust {
      order: -2;
    }

    #FooterFour-{{ section.id }}.q-footer-four--layout-trust_first .qf4__cta-zone {
      order: -1;
    }

    #FooterFour-{{ section.id }} .qf4__block {
      min-width: 0;
      padding: var(--qf4-block-padding);
      border: var(--qf4-block-border-width) solid var(--qf4-border);
      border-radius: var(--qf4-card-radius);
      background: color-mix(in srgb, var(--qf4-text), transparent 97%);
    }

    #FooterFour-{{ section.id }}.q-footer-four--style-soft_minimal .qf4__block {
      background: color-mix(in srgb, var(--qf4-text), transparent 98%);
    }

    #FooterFour-{{ section.id }}.q-footer-four--style-borderless .qf4__block {
      border-color: transparent;
      background: transparent;
      padding-inline: 0;
    }

    #FooterFour-{{ section.id }} .qf4__block-heading {
      margin: 0 0 10px;
      color: var(--qf4-heading);
      font-size: 1.05rem;
      font-weight: 900;
      line-height: 1.2;
    }

    #FooterFour-{{ section.id }} .qf4__block-text,
    #FooterFour-{{ section.id }} .qf4__support-text {
      margin: 0;
      color: var(--qf4-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    #FooterFour-{{ section.id }} .qf4__branding {
      display: grid;
      gap: 14px;
    }

    #FooterFour-{{ section.id }} .qf4__brand-link {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      align-items: center;
      color: inherit;
      text-decoration: none;
    }

    #FooterFour-{{ section.id }} .qf4__brand-logo {
      display: block;
      width: auto;
      height: var(--qf4-brand-logo-height, var(--qf4-logo-height));
      max-width: min(240px, 80vw);
      object-fit: contain;
    }

    #FooterFour-{{ section.id }} .qf4__brand-name {
      display: inline-block;
      color: var(--qf4-heading);
      font-size: 1.25rem;
      font-weight: 900;
      line-height: 1.05;
    }

    #FooterFour-{{ section.id }} .qf4__brand-socials {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 2px;
    }

    #FooterFour-{{ section.id }} .qf4__brand-social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 34px;
      min-height: 34px;
      padding: 0 10px;
      border: 1px solid var(--qf4-border);
      border-radius: 999px;
      color: var(--qf4-link);
      font-size: 0.78rem;
      font-weight: 900;
      line-height: 1;
      text-transform: uppercase;
    }

    #FooterFour-{{ section.id }} .qf4__brand-social:hover {
      color: var(--qf4-button-text);
      background: var(--qf4-button-bg);
      border-color: var(--qf4-button-bg);
    }

    #FooterFour-{{ section.id }} .qf4__newsletter-form {
      display: grid;
      gap: 12px;
      margin-top: 16px;
    }

    #FooterFour-{{ section.id }} .qf4__newsletter-row {
      display: flex;
      align-items: stretch;
      gap: 8px;
      min-width: 0;
    }

    #FooterFour-{{ section.id }} .qf4__newsletter-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #FooterFour-{{ section.id }} .qf4__newsletter-input {
      flex: 1 1 auto;
      min-width: 0;
      min-height: 48px;
      padding: 0 14px;
      border: 1px solid var(--qf4-border);
      border-radius: var(--qf4-button-radius);
      background: var(--qf4-bg);
      color: var(--qf4-text);
      font-size: 0.95rem;
      box-shadow: none;
    }

    #FooterFour-{{ section.id }} .qf4__newsletter-submit {
      flex: 0 0 auto;
      min-height: 48px;
      padding: 0 18px;
      border: 1px solid var(--qf4-button-bg);
      border-radius: var(--qf4-button-radius);
      background: var(--qf4-button-bg);
      color: var(--qf4-button-text);
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 900;
      line-height: 1;
      white-space: nowrap;
    }

    #FooterFour-{{ section.id }} .qf4__form-message {
      margin: 0;
      color: var(--qf4-muted);
      font-size: 0.9rem;
      line-height: 1.45;
    }

    #FooterFour-{{ section.id }} .qf4__form-message--success {
      color: var(--qf4-link-hover);
      font-weight: 800;
    }

    #FooterFour-{{ section.id }} .qf4__menu-list,
    #FooterFour-{{ section.id }} .qf4__support-list,
    #FooterFour-{{ section.id }} .qf4__bottom-menu,
    #FooterFour-{{ section.id }} .qf4__policy-links {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #FooterFour-{{ section.id }} .qf4__menu-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px 16px;
    }

    #FooterFour-{{ section.id }} .qf4__menu-list a {
      display: inline-flex;
      color: var(--qf4-link);
      font-size: 0.92rem;
      font-weight: 800;
      line-height: 1.35;
    }

    #FooterFour-{{ section.id }} .qf4__support-list {
      display: grid;
      gap: 8px;
      margin-top: 14px;
      color: var(--qf4-muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    #FooterFour-{{ section.id }} .qf4__support-list a {
      color: var(--qf4-link);
      font-weight: 800;
    }

    #FooterFour-{{ section.id }} .qf4__support-button {
      margin-top: 16px;
    }

    #FooterFour-{{ section.id }} .qf4__custom-liquid {
      color: var(--qf4-text);
    }

    #FooterFour-{{ section.id }} .qf4__bottom {
      width: 100%;
      background: var(--qf4-bottom-bg);
      color: var(--qf4-bottom-text);
      border-top: 1px solid var(--qf4-border);
    }

    #FooterFour-{{ section.id }} .qf4__bottom-inner {
      display: grid;
      gap: 14px;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    #FooterFour-{{ section.id }} .qf4__bottom-top,
    #FooterFour-{{ section.id }} .qf4__bottom-lower {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    #FooterFour-{{ section.id }} .qf4__copyright,
    #FooterFour-{{ section.id }} .qf4__bottom-message {
      margin: 0;
      color: var(--qf4-bottom-text);
      font-size: 0.88rem;
      line-height: 1.45;
    }

    #FooterFour-{{ section.id }} .qf4__bottom-menu,
    #FooterFour-{{ section.id }} .qf4__policy-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px 14px;
    }

    #FooterFour-{{ section.id }} .qf4__bottom-menu a,
    #FooterFour-{{ section.id }} .qf4__policy-links a {
      color: var(--qf4-bottom-text);
      font-size: 0.88rem;
      line-height: 1.35;
      opacity: 0.84;
    }

    #FooterFour-{{ section.id }} .qf4__bottom-menu a:hover,
    #FooterFour-{{ section.id }} .qf4__policy-links a:hover {
      opacity: 1;
      color: var(--qf4-link-hover);
    }

    #FooterFour-{{ section.id }} .qf4__payments {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterFour-{{ section.id }} .qf4__payment-icon {
      display: block;
      width: auto;
      height: 22px;
    }

    #FooterFour-{{ section.id }} .qf4__payment-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 28px;
      padding: 5px 10px;
      border: 1px solid var(--qf4-border);
      border-radius: 999px;
      color: var(--qf4-bottom-text);
      background: rgba(255,255,255,0.04);
      font-size: 0.74rem;
      line-height: 1;
    }

    @supports not (color: color-mix(in srgb, #000, #fff)) {
      #FooterFour-{{ section.id }} .qf4__campaign-bar,
      #FooterFour-{{ section.id }} .qf4__trust-item,
      #FooterFour-{{ section.id }} .qf4__block {
        background: rgba(255,255,255,0.04);
      }
    }

    @media (max-width: 980px) {
      #FooterFour-{{ section.id }} .qf4__content-grid {
        grid-template-columns: 1fr;
      }

      #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }

      #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-heading,
      #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-text {
        margin-left: auto;
        margin-right: auto;
      }

      #FooterFour-{{ section.id }}.q-footer-four--layout-cta_split .qf4__cta-actions {
        justify-content: center;
      }
    }

    @media (max-width: 700px) {
      #FooterFour-{{ section.id }} .qf4__shell,
      #FooterFour-{{ section.id }} .qf4__bottom-inner {
        padding-left: 14px;
        padding-right: 14px;
      }

      #FooterFour-{{ section.id }} .qf4__main {
        padding-top: 38px;
        padding-bottom: 38px;
      }

      #FooterFour-{{ section.id }} .qf4__cta-zone {
        padding: 28px 18px;
      }

      #FooterFour-{{ section.id }} .qf4__cta-actions,
      #FooterFour-{{ section.id }} .qf4__newsletter-row {
        flex-direction: column;
        align-items: stretch;
      }

      #FooterFour-{{ section.id }} .qf4__button,
      #FooterFour-{{ section.id }} .qf4__newsletter-submit {
        width: 100%;
      }

      #FooterFour-{{ section.id }} .qf4__trust {
        grid-template-columns: 1fr;
      }

      #FooterFour-{{ section.id }} .qf4__menu-list {
        align-items: flex-start;
        flex-direction: column;
      }

      #FooterFour-{{ section.id }} .qf4__bottom-top,
      #FooterFour-{{ section.id }} .qf4__bottom-lower {
        align-items: flex-start;
        justify-content: flex-start;
        flex-direction: column;
      }
    }
  </style>

  <div class="qf4__main">
    <div class="qf4__shell">
      <div class="qf4__stack">
        {% if section.settings.show_countdown or section.settings.show_progress_message %}
          <div class="qf4__campaign-bar" aria-label="Campaign information">
            {% if section.settings.show_countdown %}
              {% if section.settings.countdown_label != blank %}
                <p class="qf4__campaign-label">{{ section.settings.countdown_label }}</p>
              {% endif %}

              {% if section.settings.countdown_end_date != blank %}
                <p class="qf4__campaign-date">
                  Ends {{ section.settings.countdown_end_date }}
                </p>
              {% elsif section.settings.countdown_expired_message != blank %}
                <p class="qf4__campaign-date">
                  {{ section.settings.countdown_expired_message }}
                </p>
              {% endif %}
            {% endif %}

            {% if section.settings.show_progress_message and section.settings.progress_message != blank %}
              <p class="qf4__campaign-message">{{ section.settings.progress_message }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if has_cta_block %}
          {% for block in section.blocks %}
            {% if block.type == 'cta' %}
              <section class="qf4__cta-zone" aria-label="Campaign call to action" {{ block.shopify_attributes }}>
                <div class="qf4__cta-inner">
                  <div class="qf4__cta-copy">
                    {% if block.settings.heading != blank %}
                      <h2 class="qf4__cta-heading">{{ block.settings.heading }}</h2>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="qf4__cta-text">
                        {{ block.settings.text }}
                      </div>
                    {% endif %}
                  </div>

                  {% if block.settings.button_label != blank or block.settings.secondary_label != blank %}
                    <div class="qf4__cta-actions">
                      {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                        <a class="qf4__button" href="{{ block.settings.button_url }}">
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}

                      {% if block.settings.secondary_label != blank and block.settings.secondary_url != blank %}
                        <a class="qf4__button qf4__button--secondary" href="{{ block.settings.secondary_url }}">
                          {{ block.settings.secondary_label }}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </section>
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if has_trust_items %}
          <div class="qf4__trust" aria-label="Store guarantees">
            {% for block in section.blocks %}
              {% if block.type == 'trust_item' %}
                <div class="qf4__trust-item" {{ block.shopify_attributes }}>
                  {% if block.settings.icon_text != blank %}
                    <span class="qf4__trust-icon" aria-hidden="true">{{ block.settings.icon_text }}</span>
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <p class="qf4__trust-heading">{{ block.settings.heading }}</p>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <p class="qf4__trust-text">{{ block.settings.text }}</p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="qf4__content-grid">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'branding' %}
                  <div
                    class="qf4__block qf4__block--branding"
                    {{ block.shopify_attributes }}
                    style="--qf4-brand-logo-height: {{ block.settings.logo_height | default: section.settings.default_logo_height }}px;"
                  >
                    <div class="qf4__branding">
                      <a class="qf4__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
                        {% if block.settings.logo != blank %}
                          <img
                            class="qf4__brand-logo"
                            src="{{ block.settings.logo | image_url: width: 520 }}"
                            alt="{{ block.settings.logo_alt | default: shop.name | escape }}"
                            loading="lazy"
                          >
                        {% elsif settings.logo_primary != blank %}
                          <img
                            class="qf4__brand-logo"
                            src="{{ settings.logo_primary | image_url: width: 520 }}"
                            alt="{{ shop.name | escape }}"
                            loading="lazy"
                          >
                        {% else %}
                          <span class="qf4__brand-name">{{ block.settings.heading | default: shop.name }}</span>
                        {% endif %}
                      </a>

                      {% if block.settings.heading != blank %}
                        <h3 class="qf4__block-heading">{{ block.settings.heading }}</h3>
                      {% endif %}

                      {% if block.settings.text != blank %}
                        <div class="qf4__block-text">{{ block.settings.text }}</div>
                      {% endif %}

                      <ul class="qf4__support-list">
                        {% if block.settings.email != blank %}
                          <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                        {% endif %}

                        {% if block.settings.phone != blank %}
                          <li>
                            <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">
                              {{ block.settings.phone }}
                            </a>
                          </li>
                        {% endif %}
                      </ul>

                      {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                        <div class="qf4__support-button">
                          <a class="qf4__button qf4__button--secondary" href="{{ block.settings.button_url }}">
                            {{ block.settings.button_label }}
                          </a>
                        </div>
                      {% endif %}

                      {% if block.settings.facebook_url != blank or block.settings.instagram_url != blank or block.settings.tiktok_url != blank or block.settings.youtube_url != blank or block.settings.x_url != blank %}
                        <div class="qf4__brand-socials" aria-label="Social links">
                          {% if block.settings.facebook_url != blank %}
                            <a class="qf4__brand-social" href="{{ block.settings.facebook_url }}" aria-label="Facebook">FB</a>
                          {% endif %}

                          {% if block.settings.instagram_url != blank %}
                            <a class="qf4__brand-social" href="{{ block.settings.instagram_url }}" aria-label="Instagram">IG</a>
                          {% endif %}

                          {% if block.settings.tiktok_url != blank %}
                            <a class="qf4__brand-social" href="{{ block.settings.tiktok_url }}" aria-label="TikTok">TT</a>
                          {% endif %}

                          {% if block.settings.youtube_url != blank %}
                            <a class="qf4__brand-social" href="{{ block.settings.youtube_url }}" aria-label="YouTube">YT</a>
                          {% endif %}

                          {% if block.settings.x_url != blank %}
                            <a class="qf4__brand-social" href="{{ block.settings.x_url }}" aria-label="X">X</a>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>

                {% when 'newsletter' %}
                  <div class="qf4__block qf4__block--newsletter" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <h3 class="qf4__block-heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="qf4__block-text">{{ block.settings.text }}</div>
                    {% endif %}

                    {% form 'customer', class: 'qf4__newsletter-form' %}
                      <input type="hidden" name="contact[tags]" value="newsletter">

                      <div class="qf4__newsletter-row">
                        <label class="qf4__newsletter-label" for="FooterFourNewsletterEmail-{{ section.id }}-{{ block.id }}">
                          Email address
                        </label>

                        <input
                          id="FooterFourNewsletterEmail-{{ section.id }}-{{ block.id }}"
                          class="qf4__newsletter-input"
                          type="email"
                          name="contact[email]"
                          value="{{ form.email }}"
                          autocorrect="off"
                          autocapitalize="off"
                          autocomplete="email"
                          placeholder="{{ block.settings.placeholder | escape }}"
                          aria-label="{{ block.settings.placeholder | default: 'Email address' | escape }}"
                          required
                        >

                        <button class="qf4__newsletter-submit" type="submit">
                          {{ block.settings.button_label }}
                        </button>
                      </div>

                      {% if form.posted_successfully? %}
                        <p class="qf4__form-message qf4__form-message--success" tabindex="-1">
                          Thanks for subscribing.
                        </p>
                      {% endif %}

                      {% if form.errors %}
                        <div class="qf4__form-message">
                          {{ form.errors | default_errors }}
                        </div>
                      {% endif %}
                    {% endform %}
                  </div>

                {% when 'menu' %}
                  <div class="qf4__block qf4__block--menu" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <h3 class="qf4__block-heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    {% if block.settings.menu != blank and block.settings.menu.links != blank %}
                      <ul class="qf4__menu-list">
                        {% for link in block.settings.menu.links %}
                          <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% elsif request.design_mode %}
                      <p class="qf4__form-message">Select a menu for this footer block.</p>
                    {% endif %}
                  </div>

                {% when 'support' %}
                  <div class="qf4__block qf4__block--support" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <h3 class="qf4__block-heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="qf4__support-text">{{ block.settings.text }}</div>
                    {% endif %}

                    <ul class="qf4__support-list">
                      {% if block.settings.email != blank %}
                        <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                      {% endif %}

                      {% if block.settings.phone != blank %}
                        <li>
                          <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">
                            {{ block.settings.phone }}
                          </a>
                        </li>
                      {% endif %}
                    </ul>

                    {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                      <div class="qf4__support-button">
                        <a class="qf4__button qf4__button--secondary" href="{{ block.settings.button_url }}">
                          {{ block.settings.button_label }}
                        </a>
                      </div>
                    {% endif %}
                  </div>

                {% when 'custom_liquid' %}
                  <div class="qf4__block qf4__block--custom-liquid" {{ block.shopify_attributes }}>
                    <div class="qf4__custom-liquid">
                      {{ block.settings.custom_liquid }}
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="qf4__bottom">
    <div class="qf4__bottom-inner">
      <div class="qf4__bottom-top">
        <p class="qf4__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>

        {% if section.settings.bottom_menu != blank and section.settings.bottom_menu.links != blank %}
          <ul class="qf4__bottom-menu" aria-label="Footer utility links">
            {% for link in section.settings.bottom_menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% if section.settings.bottom_message != blank %}
        <p class="qf4__bottom-message">{{ section.settings.bottom_message }}</p>
      {% endif %}

      <div class="qf4__bottom-lower">
        {% if section.settings.show_policy_links and shop.policies != blank %}
          <ul class="qf4__policy-links" aria-label="Policy links">
            {% for policy in shop.policies %}
              {% if policy != blank and policy.url != blank %}
                <li>
                  <a href="{{ policy.url }}">{{ policy.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <div class="qf4__payments" aria-label="Accepted payment methods">
            {% if shop.enabled_payment_types != blank %}
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'qf4__payment-icon' }}
              {% endfor %}
            {% elsif section.settings.show_payment_fallback %}
              <span class="qf4__payment-pill" aria-hidden="true">Visa</span>
              <span class="qf4__payment-pill" aria-hidden="true">Mastercard</span>
              <span class="qf4__payment-pill" aria-hidden="true">Amex</span>
              <span class="qf4__payment-pill" aria-hidden="true">PayPal</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Four",
  "class": "qtm-footer-four-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "footer_layout",
      "label": "Footer layout",
      "default": "cta_centered",
      "options": [
        { "value": "cta_centered", "label": "CTA centered" },
        { "value": "cta_split", "label": "CTA split" },
        { "value": "trust_first", "label": "Trust first" },
        { "value": "minimal_campaign", "label": "Minimal campaign" }
      ]
    },
    {
      "type": "select",
      "id": "visual_style",
      "label": "Visual style",
      "default": "soft_minimal",
      "options": [
        { "value": "campaign_cards", "label": "Campaign cards" },
        { "value": "soft_minimal", "label": "Soft minimal" },
        { "value": "borderless", "label": "Borderless" }
      ]
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "default": 1240,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Campaign elements"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown message",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Limited-time offer"
    },
    {
      "type": "text",
      "id": "countdown_end_date",
      "label": "Countdown end date",
      "default": "Sunday at midnight"
    },
    {
      "type": "text",
      "id": "countdown_expired_message",
      "label": "Expired message",
      "default": "This campaign has ended."
    },
    {
      "type": "checkbox",
      "id": "show_progress_message",
      "label": "Show progress message",
      "default": true
    },
    {
      "type": "text",
      "id": "progress_message",
      "label": "Progress message",
      "default": "Add one more item to unlock the best offer."
    },
    {
      "type": "header",
      "content": "CTA sizing"
    },
    {
      "type": "range",
      "id": "cta_max_width",
      "label": "CTA max width",
      "min": 620,
      "max": 1100,
      "step": 20,
      "default": 820,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "cta_heading_min",
      "label": "CTA heading minimum size",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.8,
      "unit": "rem"
    },
    {
      "type": "range",
      "id": "cta_heading_max",
      "label": "CTA heading maximum size",
      "min": 2,
      "max": 6,
      "step": 0.1,
      "default": 4,
      "unit": "rem"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_message",
      "label": "Bottom message",
      "default": "Secure checkout. Fast support. Built for confident shopping."
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_fallback",
      "label": "Show fallback payment pills if icons are unavailable",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0f1115"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f4f4f5"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#b8bcc7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#facc15"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#2b2f3a"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "CTA background",
      "default": "#1d4ed8"
    },
    {
      "type": "color",
      "id": "cta_text",
      "label": "CTA text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#facc15"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "bottom_bg",
      "label": "Bottom background",
      "default": "#090a0d"
    },
    {
      "type": "color",
      "id": "bottom_text_color",
      "label": "Bottom text color",
      "default": "#d4d4d8"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 28,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 28,
      "max": 120,
      "step": 4,
      "default": 52,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Section gap",
      "min": 16,
      "max": 64,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_padding",
      "label": "Block padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_border_width",
      "label": "Block border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Radius"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "default_logo_height",
      "label": "Default brand logo height",
      "min": 20,
      "max": 90,
      "step": 2,
      "default": 38,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "branding",
      "name": "Branding",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo alt text"
        },
        {
          "type": "range",
          "id": "logo_height",
          "label": "Logo height",
          "min": 20,
          "max": 90,
          "step": 2,
          "default": 38,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Brand heading",
          "default": "Built for confident shopping."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Brand text",
          "default": "<p>Add a short brand statement, customer promise, or campaign support message.</p>"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "url",
          "id": "facebook_url",
          "label": "Facebook URL"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram URL"
        },
        {
          "type": "url",
          "id": "tiktok_url",
          "label": "TikTok URL"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "YouTube URL"
        },
        {
          "type": "url",
          "id": "x_url",
          "label": "X URL"
        }
      ]
    },
    {
      "type": "cta",
      "name": "CTA",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Last chance to claim the offer."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Complete your order today and lock in this campaign pricing before it expires.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop the Offer"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary label",
          "default": "View Details"
        },
        {
          "type": "url",
          "id": "secondary_url",
          "label": "Secondary URL"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Secure Checkout"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your payment information is protected from cart to confirmation."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter / Lead capture",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Get the next offer first"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Join the list for campaign drops, early access, and exclusive offers.</p>"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Enter your email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Join Now"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Minimal menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Helpful Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "support",
      "name": "Support",
      "settings": [
        {
          "type": "text",
