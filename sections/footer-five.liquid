{% liquid
  assign footer_layout = section.settings.footer_layout | default: 'marketplace'
  assign footer_width = section.settings.footer_width | default: 'wide'
  assign mobile_layout = section.settings.mobile_layout | default: 'accordion'
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_tablet = section.settings.columns_tablet | default: 2

  assign has_trust_items = false
  assign has_department_menu = false
  assign has_support_menu = false
  assign has_account_links = false
  assign has_tracking_cta = false
  assign has_contact = false
  assign has_payment_security = false
  assign has_newsletter = false
  assign has_custom_liquid = false

  for block in section.blocks
    if block.type == 'trust_item'
      assign has_trust_items = true
    elsif block.type == 'department_menu'
      assign has_department_menu = true
    elsif block.type == 'support_menu'
      assign has_support_menu = true
    elsif block.type == 'account_links'
      assign has_account_links = true
    elsif block.type == 'tracking_cta'
      assign has_tracking_cta = true
    elsif block.type == 'contact'
      assign has_contact = true
    elsif block.type == 'payment_security'
      assign has_payment_security = true
    elsif block.type == 'newsletter'
      assign has_newsletter = true
    elsif block.type == 'custom_liquid'
      assign has_custom_liquid = true
    endif
  endfor
%}

<footer
  id="FooterFive-{{ section.id }}"
  class="q-footer-five q-footer-five--layout-{{ footer_layout }} q-footer-five--width-{{ footer_width }} q-footer-five--mobile-{{ mobile_layout }}"
  aria-label="Site footer"
>
  <style>
    #FooterFive-{{ section.id }}{
      --qf5-bg: {{ section.settings.bg_color }};
      --qf5-text: {{ section.settings.text_color }};
      --qf5-muted: {{ section.settings.muted_color }};
      --qf5-heading: {{ section.settings.heading_color }};
      --qf5-link: {{ section.settings.link_color }};
      --qf5-link-hover: {{ section.settings.link_hover_color }};
      --qf5-border: {{ section.settings.border_color }};
      --qf5-utility-bg: {{ section.settings.utility_bg }};
      --qf5-utility-text: {{ section.settings.utility_text_color }};
      --qf5-bottom-bg: {{ section.settings.bottom_bg }};
      --qf5-bottom-text: {{ section.settings.bottom_text_color }};
      --qf5-card-bg: {{ section.settings.card_bg }};
      --qf5-radius: {{ section.settings.card_radius }}px;
      --qf5-button-radius: {{ section.settings.button_radius }}px;
      --qf5-pill-radius: {{ section.settings.pill_radius }}px;
      --qf5-heading-size: {{ section.settings.heading_size }}px;
      --qf5-body-size: {{ section.settings.body_size }}px;
      --qf5-link-size: {{ section.settings.link_size }}px;
      --qf5-utility-size: {{ section.settings.utility_size }}px;
      --qf5-padding-top: {{ section.settings.padding_top }}px;
      --qf5-padding-bottom: {{ section.settings.padding_bottom }}px;
      --qf5-section-gap: {{ section.settings.section_gap }}px;
      --qf5-column-gap: {{ section.settings.column_gap }}px;
      --qf5-row-gap: {{ section.settings.row_gap }}px;
      --qf5-columns-desktop: {{ columns_desktop }};
      --qf5-columns-tablet: {{ columns_tablet }};

      width: 100%;
      margin: 0;
      padding: 0;
      background: var(--qf5-bg);
      color: var(--qf5-text);
      border-top: 1px solid var(--qf5-border);
    }

    #FooterFive-{{ section.id }},
    #FooterFive-{{ section.id }} *{
      box-sizing: border-box;
    }

    #FooterFive-{{ section.id }} a{
      color: var(--qf5-link);
      text-decoration: none;
      transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease, opacity .18s ease;
    }

    #FooterFive-{{ section.id }} a:hover{
      color: var(--qf5-link-hover);
    }

    #FooterFive-{{ section.id }} a:focus-visible,
    #FooterFive-{{ section.id }} button:focus-visible,
    #FooterFive-{{ section.id }} input:focus-visible,
    #FooterFive-{{ section.id }} select:focus-visible,
    #FooterFive-{{ section.id }} summary:focus-visible{
      outline: 2px solid var(--qf5-link-hover);
      outline-offset: 3px;
    }

    #FooterFive-{{ section.id }} .qf5__shell,
    #FooterFive-{{ section.id }} .qf5__utility-inner,
    #FooterFive-{{ section.id }} .qf5__bottom-inner{
      width: 100%;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    #FooterFive-{{ section.id }}.q-footer-five--width-wide .qf5__shell,
    #FooterFive-{{ section.id }}.q-footer-five--width-wide .qf5__utility-inner,
    #FooterFive-{{ section.id }}.q-footer-five--width-wide .qf5__bottom-inner{
      max-width: 1480px;
    }

    #FooterFive-{{ section.id }}.q-footer-five--width-contained .qf5__shell,
    #FooterFive-{{ section.id }}.q-footer-five--width-contained .qf5__utility-inner,
    #FooterFive-{{ section.id }}.q-footer-five--width-contained .qf5__bottom-inner{
      max-width: 1240px;
    }

    #FooterFive-{{ section.id }} .qf5__utility{
      width: 100%;
      background: var(--qf5-utility-bg);
      color: var(--qf5-utility-text);
      border-bottom: 1px solid var(--qf5-border);
    }

    #FooterFive-{{ section.id }} .qf5__utility-inner{
      display: grid;
      grid-template-columns: minmax(220px, .75fr) minmax(0, 1.25fr);
      gap: 16px;
      align-items: center;
      padding-top: 14px;
      padding-bottom: 14px;
    }

    #FooterFive-{{ section.id }} .qf5__utility-message{
      margin: 0;
      color: var(--qf5-utility-text);
      font-size: var(--qf5-utility-size);
      font-weight: 800;
      line-height: 1.35;
    }

    #FooterFive-{{ section.id }} .qf5__utility-trust{
      display: flex;
      justify-content: flex-end;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterFive-{{ section.id }} .qf5__utility-pill{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 6px 12px;
      border: 1px solid color-mix(in srgb, var(--qf5-utility-text), transparent 80%);
      border-radius: var(--qf5-pill-radius);
      color: var(--qf5-utility-text);
      background: color-mix(in srgb, var(--qf5-utility-text), transparent 94%);
      font-size: .86rem;
      line-height: 1.2;
    }

    #FooterFive-{{ section.id }} .qf5__utility-icon{
      font-weight: 900;
      line-height: 1;
    }

    #FooterFive-{{ section.id }} .qf5__main{
      width: 100%;
      padding-top: var(--qf5-padding-top);
      padding-bottom: var(--qf5-padding-bottom);
    }

    #FooterFive-{{ section.id }} .qf5__stack{
      display: grid;
      gap: var(--qf5-section-gap);
    }

    #FooterFive-{{ section.id }} .qf5__grid{
      display: grid;
      grid-template-columns: repeat(var(--qf5-columns-desktop), minmax(0, 1fr));
      gap: var(--qf5-row-gap) var(--qf5-column-gap);
      align-items: start;
    }

    #FooterFive-{{ section.id }}.q-footer-five--layout-department_hub .qf5__grid{
      grid-template-columns: minmax(0, 1.4fr) repeat(calc(var(--qf5-columns-desktop) - 1), minmax(0, 1fr));
    }

    #FooterFive-{{ section.id }}.q-footer-five--layout-support_heavy .qf5__block--tracking,
    #FooterFive-{{ section.id }}.q-footer-five--layout-support_heavy .qf5__block--contact,
    #FooterFive-{{ section.id }}.q-footer-five--layout-support_heavy .qf5__block--support{
      border-color: color-mix(in srgb, var(--qf5-link-hover), transparent 64%);
    }

    #FooterFive-{{ section.id }}.q-footer-five--layout-dense_utility .qf5__main{
      padding-top: calc(var(--qf5-padding-top) * .7);
      padding-bottom: calc(var(--qf5-padding-bottom) * .7);
    }

    #FooterFive-{{ section.id }}.q-footer-five--layout-dense_utility .qf5__grid{
      gap: calc(var(--qf5-row-gap) * .75) calc(var(--qf5-column-gap) * .75);
    }

    #FooterFive-{{ section.id }} .qf5__block{
      min-width: 0;
      display: grid;
      gap: 14px;
      padding: 20px;
      border: 1px solid var(--qf5-border);
      border-radius: var(--qf5-radius);
      background: var(--qf5-card-bg);
    }

    #FooterFive-{{ section.id }} .qf5__block--department{
      grid-column: span 2;
    }

    #FooterFive-{{ section.id }}.q-footer-five--layout-dense_utility .qf5__block{
      padding: 16px;
    }

    #FooterFive-{{ section.id }} .qf5__heading{
      margin: 0;
      color: var(--qf5-heading);
      font-size: var(--qf5-heading-size);
      font-weight: 900;
      line-height: 1.2;
    }

    #FooterFive-{{ section.id }} .qf5__text,
    #FooterFive-{{ section.id }} .qf5__support-text,
    #FooterFive-{{ section.id }} .qf5__security-text{
      margin: 0;
      color: var(--qf5-muted);
      font-size: var(--qf5-body-size);
      line-height: 1.6;
    }

    #FooterFive-{{ section.id }} .qf5__menu-list,
    #FooterFive-{{ section.id }} .qf5__account-list,
    #FooterFive-{{ section.id }} .qf5__contact-list,
    #FooterFive-{{ section.id }} .qf5__trust-list,
    #FooterFive-{{ section.id }} .qf5__bottom-menu,
    #FooterFive-{{ section.id }} .qf5__policy-links{
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #FooterFive-{{ section.id }} .qf5__menu-list{
      display: grid;
      gap: 9px 16px;
    }

    #FooterFive-{{ section.id }} .qf5__menu-list--cols-1{
      grid-template-columns: 1fr;
    }

    #FooterFive-{{ section.id }} .qf5__menu-list--cols-2{
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #FooterFive-{{ section.id }} .qf5__menu-list--cols-3{
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #FooterFive-{{ section.id }} .qf5__menu-list--cols-4{
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #FooterFive-{{ section.id }} .qf5__menu-list a,
    #FooterFive-{{ section.id }} .qf5__account-list a,
    #FooterFive-{{ section.id }} .qf5__contact-list a{
      display: inline-block;
      width: fit-content;
      max-width: 100%;
      color: var(--qf5-link);
      font-size: var(--qf5-link-size);
      line-height: 1.42;
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    #FooterFive-{{ section.id }} .qf5__menu-list a:hover,
    #FooterFive-{{ section.id }} .qf5__account-list a:hover,
    #FooterFive-{{ section.id }} .qf5__contact-list a:hover{
      color: var(--qf5-link-hover);
      transform: translateX(2px);
    }

    #FooterFive-{{ section.id }} .qf5__details{
      margin: 0;
    }

    #FooterFive-{{ section.id }} .qf5__summary{
      display: block;
      list-style: none;
      cursor: default;
    }

    #FooterFive-{{ section.id }} .qf5__summary::-webkit-details-marker{
      display: none;
    }

    #FooterFive-{{ section.id }} .qf5__summary .qf5__heading{
      margin: 0;
    }

    #FooterFive-{{ section.id }} .qf5__account-list,
    #FooterFive-{{ section.id }} .qf5__contact-list{
      display: grid;
      gap: 10px;
    }

    #FooterFive-{{ section.id }} .qf5__contact-list{
      color: var(--qf5-muted);
      font-size: var(--qf5-body-size);
      line-height: 1.55;
    }

    #FooterFive-{{ section.id }} .qf5__tracking{
      display: grid;
      gap: 14px;
      align-content: start;
    }

    #FooterFive-{{ section.id }} .qf5__button{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 44px;
      padding: 0 18px;
      border: 1px solid var(--qf5-link);
      border-radius: var(--qf5-button-radius);
      background: var(--qf5-link);
      color: var(--qf5-bg);
      font-size: .92rem;
      font-weight: 900;
      line-height: 1;
      white-space: nowrap;
    }

    #FooterFive-{{ section.id }} .qf5__button:hover{
      color: var(--qf5-bg);
      background: var(--qf5-link-hover);
      border-color: var(--qf5-link-hover);
      transform: translateY(-1px);
    }

    #FooterFive-{{ section.id }} .qf5__trust-list{
      display: grid;
      gap: 10px;
    }

    #FooterFive-{{ section.id }} .qf5__trust-item{
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 10px;
      align-items: start;
      min-width: 0;
      padding: 10px;
      border: 1px solid var(--qf5-border);
      border-radius: calc(var(--qf5-radius) - 4px);
      background: color-mix(in srgb, var(--qf5-text), transparent 97%);
    }

    #FooterFive-{{ section.id }} .qf5__trust-icon{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 30px;
      height: 30px;
      padding: 0 8px;
      border-radius: var(--qf5-pill-radius);
      background: color-mix(in srgb, var(--qf5-link-hover), transparent 86%);
      color: var(--qf5-heading);
      font-size: .84rem;
      font-weight: 900;
      line-height: 1;
    }

    #FooterFive-{{ section.id }} .qf5__trust-heading{
      margin: 0;
      color: var(--qf5-heading);
      font-size: .94rem;
      font-weight: 900;
      line-height: 1.25;
    }

    #FooterFive-{{ section.id }} .qf5__trust-text{
      margin: 3px 0 0;
      color: var(--qf5-muted);
      font-size: .86rem;
      line-height: 1.45;
    }

    #FooterFive-{{ section.id }} .qf5__payments{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterFive-{{ section.id }} .qf5__payment-icon{
      display: block;
      width: auto;
      height: 23px;
    }

    #FooterFive-{{ section.id }} .qf5__payment-pill,
    #FooterFive-{{ section.id }} .qf5__security-pill{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 6px 10px;
      border: 1px solid var(--qf5-border);
      border-radius: var(--qf5-pill-radius);
      color: var(--qf5-muted);
      background: color-mix(in srgb, var(--qf5-text), transparent 96%);
      font-size: .76rem;
      font-weight: 800;
      line-height: 1;
    }

    #FooterFive-{{ section.id }} .qf5__newsletter-form{
      display: grid;
      gap: 12px;
      margin-top: 2px;
    }

    #FooterFive-{{ section.id }} .qf5__newsletter-row{
      display: flex;
      align-items: stretch;
      gap: 8px;
      min-width: 0;
    }

    #FooterFive-{{ section.id }} .qf5__newsletter-label{
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #FooterFive-{{ section.id }} .qf5__newsletter-input{
      flex: 1 1 auto;
      min-width: 0;
      min-height: 44px;
      padding: 0 12px;
      border: 1px solid var(--qf5-border);
      border-radius: var(--qf5-button-radius);
      background: var(--qf5-bg);
      color: var(--qf5-text);
      font-size: .92rem;
      box-shadow: none;
    }

    #FooterFive-{{ section.id }} .qf5__newsletter-submit{
      flex: 0 0 auto;
      min-height: 44px;
      padding: 0 16px;
      border: 1px solid var(--qf5-link);
      border-radius: var(--qf5-button-radius);
      background: var(--qf5-link);
      color: var(--qf5-bg);
      cursor: pointer;
      font-size: .9rem;
      font-weight: 900;
      line-height: 1;
      white-space: nowrap;
    }

    #FooterFive-{{ section.id }} .qf5__form-message{
      margin: 0;
      color: var(--qf5-muted);
      font-size: .86rem;
      line-height: 1.4;
    }

    #FooterFive-{{ section.id }} .qf5__form-message--success{
      color: var(--qf5-link-hover);
      font-weight: 800;
    }

    #FooterFive-{{ section.id }} .qf5__custom-liquid{
      color: var(--qf5-text);
    }

    #FooterFive-{{ section.id }} .qf5__bottom{
      width: 100%;
      background: var(--qf5-bottom-bg);
      color: var(--qf5-bottom-text);
      border-top: 1px solid var(--qf5-border);
    }

    #FooterFive-{{ section.id }} .qf5__bottom-inner{
      display: grid;
      gap: 14px;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    #FooterFive-{{ section.id }} .qf5__bottom-top,
    #FooterFive-{{ section.id }} .qf5__bottom-lower{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    #FooterFive-{{ section.id }} .qf5__copyright,
    #FooterFive-{{ section.id }} .qf5__bottom-message{
      margin: 0;
      color: var(--qf5-bottom-text);
      font-size: .88rem;
      line-height: 1.45;
    }

    #FooterFive-{{ section.id }} .qf5__bottom-menu,
    #FooterFive-{{ section.id }} .qf5__policy-links{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px 14px;
    }

    #FooterFive-{{ section.id }} .qf5__bottom-menu a,
    #FooterFive-{{ section.id }} .qf5__policy-links a{
      color: var(--qf5-bottom-text);
      font-size: .88rem;
      line-height: 1.35;
      opacity: .84;
    }

    #FooterFive-{{ section.id }} .qf5__bottom-menu a:hover,
    #FooterFive-{{ section.id }} .qf5__policy-links a:hover{
      opacity: 1;
      color: var(--qf5-link-hover);
    }

    #FooterFive-{{ section.id }} .qf5__localization{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterFive-{{ section.id }} .qf5__localization-form{
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    #FooterFive-{{ section.id }} .qf5__localization-label{
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #FooterFive-{{ section.id }} .qf5__localization-select{
      min-height: 34px;
      padding: 0 30px 0 10px;
      border: 1px solid var(--qf5-border);
      border-radius: var(--qf5-pill-radius);
      background: transparent;
      color: var(--qf5-bottom-text);
      font-size: .84rem;
    }

    @supports not (color: color-mix(in srgb, #000, #fff)){
      #FooterFive-{{ section.id }} .qf5__utility-pill,
      #FooterFive-{{ section.id }} .qf5__trust-item,
      #FooterFive-{{ section.id }} .qf5__payment-pill,
      #FooterFive-{{ section.id }} .qf5__security-pill{
        background: rgba(255,255,255,.04);
      }
    }

    @media (min-width: 741px){
      #FooterFive-{{ section.id }} .qf5__details{
        pointer-events: none;
      }

      #FooterFive-{{ section.id }} .qf5__details:not([open]) .qf5__menu-list,
      #FooterFive-{{ section.id }} .qf5__details:not([open]) .qf5__account-list{
        display: grid;
      }
    }

    @media (max-width: 1180px){
      #FooterFive-{{ section.id }} .qf5__grid{
        grid-template-columns: repeat(var(--qf5-columns-tablet), minmax(0, 1fr));
      }

      #FooterFive-{{ section.id }} .qf5__block--department{
        grid-column: span 1;
      }

      #FooterFive-{{ section.id }} .qf5__menu-list--cols-3,
      #FooterFive-{{ section.id }} .qf5__menu-list--cols-4{
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #FooterFive-{{ section.id }} .qf5__utility-inner{
        grid-template-columns: 1fr;
      }

      #FooterFive-{{ section.id }} .qf5__utility-trust{
        justify-content: flex-start;
      }
    }

    @media (max-width: 740px){
      #FooterFive-{{ section.id }} .qf5__shell,
      #FooterFive-{{ section.id }} .qf5__utility-inner,
      #FooterFive-{{ section.id }} .qf5__bottom-inner{
        padding-left: 14px;
        padding-right: 14px;
      }

      #FooterFive-{{ section.id }} .qf5__main{
        padding-top: 34px;
        padding-bottom: 34px;
      }

      #FooterFive-{{ section.id }} .qf5__grid{
        grid-template-columns: 1fr;
        gap: 14px;
      }

      #FooterFive-{{ section.id }} .qf5__block{
        padding: 16px;
      }

      #FooterFive-{{ section.id }} .qf5__menu-list,
      #FooterFive-{{ section.id }} .qf5__menu-list--cols-1,
      #FooterFive-{{ section.id }} .qf5__menu-list--cols-2,
      #FooterFive-{{ section.id }} .qf5__menu-list--cols-3,
      #FooterFive-{{ section.id }} .qf5__menu-list--cols-4{
        grid-template-columns: 1fr;
      }

      #FooterFive-{{ section.id }}.q-footer-five--mobile-accordion .qf5__details{
        padding-bottom: 2px;
      }

      #FooterFive-{{ section.id }}.q-footer-five--mobile-accordion .qf5__summary{
        position: relative;
        cursor: pointer;
        padding-right: 28px;
      }

      #FooterFive-{{ section.id }}.q-footer-five--mobile-accordion .qf5__summary::after{
        content: "+";
        position: absolute;
        top: 0;
        right: 0;
        color: var(--qf5-heading);
        font-weight: 900;
      }

      #FooterFive-{{ section.id }}.q-footer-five--mobile-accordion .qf5__details[open] .qf5__summary::after{
        content: "–";
      }

      #FooterFive-{{ section.id }}.q-footer-five--mobile-accordion .qf5__details:not([open]) .qf5__menu-list,
      #FooterFive-{{ section.id }}.q-footer-five--mobile-accordion .qf5__details:not([open]) .qf5__account-list{
        display: none;
      }

      #FooterFive-{{ section.id }} .qf5__newsletter-row{
        flex-direction: column;
      }

      #FooterFive-{{ section.id }} .qf5__newsletter-submit,
      #FooterFive-{{ section.id }} .qf5__button{
        width: 100%;
      }

      #FooterFive-{{ section.id }} .qf5__bottom-top,
      #FooterFive-{{ section.id }} .qf5__bottom-lower{
        align-items: flex-start;
        justify-content: flex-start;
        flex-direction: column;
      }
    }
  </style>

  {% if section.settings.show_utility_strip %}
    <div class="qf5__utility">
      <div class="qf5__utility-inner">
        {% if section.settings.utility_message != blank %}
          <p class="qf5__utility-message">{{ section.settings.utility_message }}</p>
        {% endif %}

        {% if has_trust_items %}
          <div class="qf5__utility-trust" aria-label="Store trust signals">
            {% for block in section.blocks %}
              {% if block.type == 'trust_item' %}
                <div class="qf5__utility-pill" {{ block.shopify_attributes }}>
                  {% if block.settings.icon_text != blank %}
                    <span class="qf5__utility-icon" aria-hidden="true">{{ block.settings.icon_text }}</span>
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <span>{{ block.settings.heading }}</span>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="qf5__main">
    <div class="qf5__shell">
      <div class="qf5__stack">
        <div class="qf5__grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'department_menu' %}
                <div class="qf5__block qf5__block--department" {{ block.shopify_attributes }}>
                  {% if mobile_layout == 'accordion' %}
                    <details class="qf5__details">
                      <summary class="qf5__summary">
                        {% if block.settings.heading != blank %}
                          <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                        {% endif %}
                      </summary>

                      {% if block.settings.menu != blank %}
                        <ul class="qf5__menu-list qf5__menu-list--cols-{{ block.settings.columns }}">
                          {% for link in block.settings.menu.links %}
                            <li>
                              <a href="{{ link.url }}">{{ link.title }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </details>
                  {% else %}
                    {% if block.settings.heading != blank %}
                      <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    {% if block.settings.menu != blank %}
                      <ul class="qf5__menu-list qf5__menu-list--cols-{{ block.settings.columns }}">
                        {% for link in block.settings.menu.links %}
                          <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  {% endif %}
                </div>

              {% when 'support_menu' %}
                <div class="qf5__block qf5__block--support" {{ block.shopify_attributes }}>
                  {% if mobile_layout == 'accordion' %}
                    <details class="qf5__details">
                      <summary class="qf5__summary">
                        {% if block.settings.heading != blank %}
                          <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                        {% endif %}
                      </summary>

                      {% if block.settings.menu != blank %}
                        <ul class="qf5__menu-list qf5__menu-list--cols-1">
                          {% for link in block.settings.menu.links %}
                            <li>
                              <a href="{{ link.url }}">{{ link.title }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </details>
                  {% else %}
                    {% if block.settings.heading != blank %}
                      <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    {% if block.settings.menu != blank %}
                      <ul class="qf5__menu-list qf5__menu-list--cols-1">
                        {% for link in block.settings.menu.links %}
                          <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  {% endif %}
                </div>

              {% when 'account_links' %}
                <div class="qf5__block qf5__block--account" {{ block.shopify_attributes }}>
                  {% if mobile_layout == 'accordion' %}
                    <details class="qf5__details">
                      <summary class="qf5__summary">
                        {% if block.settings.heading != blank %}
                          <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                        {% endif %}
                      </summary>

                      <ul class="qf5__account-list">
                        {% if block.settings.show_login %}
                          <li>
                            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                              {% if customer %}My Account{% else %}Sign In{% endif %}
                            </a>
                          </li>
                        {% endif %}

                        {% if block.settings.show_orders %}
                          <li>
                            <a href="{{ routes.account_url }}">Orders</a>
                          </li>
                        {% endif %}

                        {% if block.settings.show_addresses %}
                          <li>
                            <a href="{{ routes.account_addresses_url }}">Addresses</a>
                          </li>
                        {% endif %}

                        {% if block.settings.show_tracking and block.settings.tracking_url != blank %}
                          <li>
                            <a href="{{ block.settings.tracking_url }}">Track Order</a>
                          </li>
                        {% endif %}
                      </ul>
                    </details>
                  {% else %}
                    {% if block.settings.heading != blank %}
                      <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    <ul class="qf5__account-list">
                      {% if block.settings.show_login %}
                        <li>
                          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                            {% if customer %}My Account{% else %}Sign In{% endif %}
                          </a>
                        </li>
                      {% endif %}

                      {% if block.settings.show_orders %}
                        <li>
                          <a href="{{ routes.account_url }}">Orders</a>
                        </li>
                      {% endif %}

                      {% if block.settings.show_addresses %}
                        <li>
                          <a href="{{ routes.account_addresses_url }}">Addresses</a>
                        </li>
                      {% endif %}

                      {% if block.settings.show_tracking and block.settings.tracking_url != blank %}
                        <li>
                          <a href="{{ block.settings.tracking_url }}">Track Order</a>
                        </li>
                      {% endif %}
                    </ul>
                  {% endif %}
                </div>

              {% when 'tracking_cta' %}
                <div class="qf5__block qf5__block--tracking" {{ block.shopify_attributes }}>
                  <div class="qf5__tracking">
                    {% if block.settings.heading != blank %}
                      <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="qf5__text">{{ block.settings.text }}</div>
                    {% endif %}

                    {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                      <a class="qf5__button" href="{{ block.settings.button_url }}">
                        {{ block.settings.button_label }}
                      </a>
                    {% endif %}
                  </div>
                </div>

              {% when 'contact' %}
                <div class="qf5__block qf5__block--contact" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}
                    <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                  {% endif %}

                  {% if block.settings.support_text != blank %}
                    <div class="qf5__support-text">{{ block.settings.support_text }}</div>
                  {% endif %}

                  <ul class="qf5__contact-list">
                    {% if block.settings.phone != blank %}
                      <li>
                        <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">
                          {{ block.settings.phone }}
                        </a>
                      </li>
                    {% endif %}

                    {% if block.settings.email != blank %}
                      <li>
                        <a href="mailto:{{ block.settings.email }}">
                          {{ block.settings.email }}
                        </a>
                      </li>
                    {% endif %}

                    {% if block.settings.address != blank %}
                      <li>{{ block.settings.address | newline_to_br }}</li>
                    {% endif %}

                    {% if block.settings.hours != blank %}
                      <li>{{ block.settings.hours | newline_to_br }}</li>
                    {% endif %}
                  </ul>
                </div>

              {% when 'trust_item' %}
                {% unless section.settings.show_utility_strip %}
                  <div class="qf5__block qf5__block--trust" {{ block.shopify_attributes }}>
                    <ul class="qf5__trust-list">
                      <li class="qf5__trust-item">
                        {% if block.settings.icon_text != blank %}
                          <span class="qf5__trust-icon" aria-hidden="true">{{ block.settings.icon_text }}</span>
                        {% endif %}

                        <div>
                          {% if block.settings.heading != blank %}
                            <p class="qf5__trust-heading">{{ block.settings.heading }}</p>
                          {% endif %}

                          {% if block.settings.text != blank %}
                            <p class="qf5__trust-text">{{ block.settings.text }}</p>
                          {% endif %}
                        </div>
                      </li>
                    </ul>
                  </div>
                {% endunless %}

              {% when 'payment_security' %}
                <div class="qf5__block qf5__block--payment-security" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}
                    <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                  {% endif %}

                  {% if block.settings.show_security_text and block.settings.security_text != blank %}
                    <div class="qf5__security-text">{{ block.settings.security_text }}</div>
                  {% endif %}

                  {% if block.settings.show_payment_icons %}
                    <div class="qf5__payments" aria-label="Accepted payment methods">
                      {% if shop.enabled_payment_types != blank %}
                        {% for type in shop.enabled_payment_types %}
                          {{ type | payment_type_svg_tag: class: 'qf5__payment-icon' }}
                        {% endfor %}
                      {% else %}
                        <span class="qf5__payment-pill" aria-hidden="true">Visa</span>
                        <span class="qf5__payment-pill" aria-hidden="true">Mastercard</span>
                        <span class="qf5__payment-pill" aria-hidden="true">Amex</span>
                        <span class="qf5__payment-pill" aria-hidden="true">PayPal</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.show_security_text %}
                    <div class="qf5__payments" aria-hidden="true">
                      <span class="qf5__security-pill">Secure Checkout</span>
                      <span class="qf5__security-pill">Encrypted Payments</span>
                    </div>
                  {% endif %}
                </div>

              {% when 'newsletter' %}
                <div class="qf5__block qf5__block--newsletter" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}
                    <h3 class="qf5__heading">{{ block.settings.heading }}</h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="qf5__text">{{ block.settings.text }}</div>
                  {% endif %}

                  {% form 'customer', class: 'qf5__newsletter-form' %}
                    <input type="hidden" name="contact[tags]" value="newsletter">

                    <div class="qf5__newsletter-row">
                      <label class="qf5__newsletter-label" for="FooterFiveNewsletterEmail-{{ section.id }}-{{ block.id }}">
                        Email address
                      </label>

                      <input
                        id="FooterFiveNewsletterEmail-{{ section.id }}-{{ block.id }}"
                        class="qf5__newsletter-input"
                        type="email"
                        name="contact[email]"
                        value="{{ form.email }}"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        placeholder="{{ block.settings.placeholder | escape }}"
                        aria-label="{{ block.settings.placeholder | default: 'Email address' | escape }}"
                        required
                      >

                      <button class="qf5__newsletter-submit" type="submit">
                        {{ block.settings.button_label }}
                      </button>
                    </div>

                    {% if form.posted_successfully? %}
                      <p class="qf5__form-message qf5__form-message--success" tabindex="-1">
                        Thanks for subscribing.
                      </p>
                    {% endif %}

                    {% if form.errors %}
                      <div class="qf5__form-message">
                        {{ form.errors | default_errors }}
                      </div>
                    {% endif %}
                  {% endform %}
                </div>

              {% when 'custom_liquid' %}
                <div class="qf5__block qf5__block--custom-liquid" {{ block.shopify_attributes }}>
                  <div class="qf5__custom-liquid">
                    {{ block.settings.custom_liquid }}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="qf5__bottom">
    <div class="qf5__bottom-inner">
      <div class="qf5__bottom-top">
        <p class="qf5__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>

        {% if section.settings.bottom_menu != blank %}
          <ul class="qf5__bottom-menu" aria-label="Footer utility links">
            {% for link in section.settings.bottom_menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% if section.settings.bottom_message != blank %}
        <p class="qf5__bottom-message">{{ section.settings.bottom_message }}</p>
      {% endif %}

      <div class="qf5__bottom-lower">
        {% if section.settings.show_policy_links and shop.policies != blank %}
          <ul class="qf5__policy-links" aria-label="Policy links">
            {% for policy in shop.policies %}
              {% if policy != blank and policy.url != blank %}
                <li>
                  <a href="{{ policy.url }}">{{ policy.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.show_country_selector or section.settings.show_language_selector %}
          <div class="qf5__localization">
            {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}
              {% form 'localization', id: 'FooterFiveCountryForm-' | append: section.id, class: 'qf5__localization-form' %}
                <label class="qf5__localization-label" for="FooterFiveCountrySelector-{{ section.id }}">Country/region</label>
                <select
                  id="FooterFiveCountrySelector-{{ section.id }}"
                  class="qf5__localization-select"
                  name="country_code"
                  onchange="this.form.submit()"
                >
                  {% for country in localization.available_countries %}
                    <option
                      value="{{ country.iso_code }}"
                      {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {% endfor %}
                </select>
              {% endform %}
            {% endif %}

            {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
              {% form 'localization', id: 'FooterFiveLanguageForm-' | append: section.id, class: 'qf5__localization-form' %}
                <label class="qf5__localization-label" for="FooterFiveLanguageSelector-{{ section.id }}">Language</label>
                <select
                  id="FooterFiveLanguageSelector-{{ section.id }}"
                  class="qf5__localization-select"
                  name="locale_code"
                  onchange="this.form.submit()"
                >
                  {% for language in localization.available_languages %}
                    <option
                      value="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                    >
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {% endfor %}
                </select>
              {% endform %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Five",
  "class": "qtm-footer-five-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "footer_layout",
      "label": "Footer layout",
      "default": "marketplace",
      "options": [
        { "value": "marketplace", "label": "Marketplace" },
        { "value": "department_hub", "label": "Department hub" },
        { "value": "support_heavy", "label": "Support heavy" },
        { "value": "dense_utility", "label": "Dense utility" }
      ]
    },
    {
      "type": "select",
      "id": "footer_width",
      "label": "Footer width",
      "default": "wide",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "accordion",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "accordion", "label": "Accordion" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Utility strip"
    },
    {
      "type": "checkbox",
      "id": "show_utility_strip",
      "label": "Show utility strip",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_message",
      "label": "Utility message",
      "default": "Need help? Track orders, find support, and shop departments from one place."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_message",
      "label": "Bottom message",
      "default": "Marketplace-style support, secure checkout, and fast access to store resources."
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f9fafb"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#cbd5e1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#60a5fa"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#334155"
    },
    {
      "type": "color",
      "id": "utility_bg",
      "label": "Utility background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "utility_text_color",
      "label": "Utility text color",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "bottom_bg",
      "label": "Bottom background",
      "default": "#020617"
    },
    {
      "type": "color",
      "id": "bottom_text_color",
      "label": "Bottom text color",
      "default": "#cbd5e1"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#1e293b"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 13,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 17,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "utility_size",
      "label": "Utility text size",
      "min": 12,
      "max": 17,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 24,
      "max": 96,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 24,
      "max": 96,
      "step": 4,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Section gap",
      "min": 16,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 14,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 14,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Radius"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pill_radius",
      "label": "Pill radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "department_menu",
      "name": "Department menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop Departments"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Columns",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2
