{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-newsletter
    qtm-newsletter-{{ block_id }}
    qtm-newsletter--width-{{ block_width }}
    qtm-newsletter--align-{{ block_alignment }}
    qtm-newsletter--layout-{{ block.settings.layout_style }}
    qtm-newsletter--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-newsletter--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-newsletter--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-newsletter--hide-mobile{% endunless %}
  "
  style="
    --qtm-newsletter-margin-top: {{ block.settings.margin_top }}px;
    --qtm-newsletter-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-newsletter-padding: {{ block.settings.padding }}px;
    --qtm-newsletter-gap: {{ block.settings.gap }}px;
    --qtm-newsletter-heading-color: {{ block.settings.heading_color }};
    --qtm-newsletter-text-color: {{ block.settings.text_color }};
    --qtm-newsletter-background-color: {{ block.settings.background_color }};
    --qtm-newsletter-card-background: {{ block.settings.card_background_color }};
    --qtm-newsletter-border-color: {{ block.settings.border_color }};
    --qtm-newsletter-link-color: {{ block.settings.link_color }};
    --qtm-newsletter-input-background: {{ block.settings.input_background_color }};
    --qtm-newsletter-input-text: {{ block.settings.input_text_color }};
    --qtm-newsletter-button-background: {{ block.settings.button_background_color }};
    --qtm-newsletter-button-text: {{ block.settings.button_text_color }};
    --qtm-newsletter-success-color: {{ block.settings.success_color }};
    --qtm-newsletter-error-color: {{ block.settings.error_color }};
    --qtm-newsletter-border-width: {{ block.settings.border_width }}px;
    --qtm-newsletter-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-newsletter__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-newsletter__content">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-newsletter__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-newsletter__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-newsletter__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-newsletter__form-card">
      {% form 'customer', class: 'qtm-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="{{ block.settings.customer_tags | default: 'newsletter' | escape }}">

        {% if form.posted_successfully? %}
          <div
            class="qtm-newsletter__message qtm-newsletter__message--success"
            role="status"
            tabindex="-1"
          >
            {{ block.settings.success_message | escape }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div
            class="qtm-newsletter__message qtm-newsletter__message--error"
            role="alert"
          >
            {{ block.settings.error_message | escape }}
          </div>
        {% endif %}

        <div class="qtm-newsletter__fields">
          <div class="qtm-newsletter__field">
            <label class="qtm-newsletter__label {% unless block.settings.show_email_label %}visually-hidden{% endunless %}" for="qtm-newsletter-email-{{ block_id }}">
              {{ block.settings.email_label | escape }}
            </label>

            <input
              id="qtm-newsletter-email-{{ block_id }}"
              class="qtm-newsletter__input"
              type="email"
              name="contact[email]"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ block.settings.email_placeholder | escape }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="qtm-newsletter-error-{{ block_id }}"
              {% endif %}
            >
          </div>

          <button class="qtm-newsletter__button" type="submit">
            {{ block.settings.button_label | escape }}
          </button>
        </div>

        {% if block.settings.show_consent %}
          <div class="qtm-newsletter__consent">
            <input
              id="qtm-newsletter-consent-{{ block_id }}"
              class="qtm-newsletter__checkbox"
              type="checkbox"
              name="contact[accepts_marketing]"
              value="true"
              required
            >

            <label class="qtm-newsletter__consent-label" for="qtm-newsletter-consent-{{ block_id }}">
              {{ block.settings.consent_text | escape }}
            </label>
          </div>
        {% else %}
          <input type="hidden" name="contact[accepts_marketing]" value="true">
        {% endif %}

        {% if form.errors %}
          <span id="qtm-newsletter-error-{{ block_id }}" class="visually-hidden">
            {{ block.settings.error_message | escape }}
          </span>
        {% endif %}

        {% if block.settings.disclaimer != blank %}
          <div class="qtm-newsletter__disclaimer">
            {{ block.settings.disclaimer }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

<style>
  .qtm-newsletter-{{ block_id }} {
    margin-top: var(--qtm-newsletter-margin-top);
    margin-bottom: var(--qtm-newsletter-margin-bottom);
    padding: var(--qtm-newsletter-padding);
    color: var(--qtm-newsletter-text-color);
    background: var(--qtm-newsletter-background-color);
    border: var(--qtm-newsletter-border-width) solid var(--qtm-newsletter-border-color);
    border-radius: var(--qtm-newsletter-border-radius);
  }

  .qtm-newsletter-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--width-auto {
    width: auto;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--width-small {
    max-width: 640px;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--width-medium {
    max-width: 860px;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--width-large {
    max-width: 1120px;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__inner {
    display: grid;
    gap: var(--qtm-newsletter-gap);
    align-items: center;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-inline .qtm-newsletter__inner,
  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-card .qtm-newsletter__inner {
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-stacked .qtm-newsletter__inner,
  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-minimal .qtm-newsletter__inner {
    grid-template-columns: 1fr;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__content {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--align-center .qtm-newsletter__content {
    margin-inline: auto;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--align-right .qtm-newsletter__content {
    margin-left: auto;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__eyebrow {
    margin: 0;
    color: var(--qtm-newsletter-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__heading {
    margin: 0;
    color: var(--qtm-newsletter-heading-color);
    line-height: 1.05;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__text,
  .qtm-newsletter-{{ block_id }} .qtm-newsletter__disclaimer {
    color: var(--qtm-newsletter-text-color);
    line-height: 1.7;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__text p,
  .qtm-newsletter-{{ block_id }} .qtm-newsletter__disclaimer p {
    margin-top: 0;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__text p:last-child,
  .qtm-newsletter-{{ block_id }} .qtm-newsletter__disclaimer p:last-child {
    margin-bottom: 0;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__form-card {
    width: 100%;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-card .qtm-newsletter__form-card,
  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-inline .qtm-newsletter__form-card {
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--qtm-newsletter-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-newsletter-border-color), transparent 10%);
    border-radius: calc(var(--qtm-newsletter-border-radius) * 0.75);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-minimal .qtm-newsletter__form-card {
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__form {
    display: grid;
    gap: 0.85rem;
    width: 100%;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: end;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-stacked .qtm-newsletter__fields,
  .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-card .qtm-newsletter__fields {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__label {
    color: var(--qtm-newsletter-heading-color);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.8rem 1rem;
    color: var(--qtm-newsletter-input-text);
    background: var(--qtm-newsletter-input-background);
    border: 1px solid color-mix(in srgb, var(--qtm-newsletter-border-color), transparent 5%);
    border-radius: calc(var(--qtm-newsletter-border-radius) * 0.45);
    font: inherit;
    line-height: 1.2;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__input::placeholder {
    color: color-mix(in srgb, var(--qtm-newsletter-input-text), transparent 45%);
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__input:focus-visible,
  .qtm-newsletter-{{ block_id }} .qtm-newsletter__checkbox:focus-visible {
    outline: 3px solid var(--qtm-newsletter-link-color);
    outline-offset: 3px;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.2rem;
    color: var(--qtm-newsletter-button-text);
    background: var(--qtm-newsletter-button-background);
    border: 1px solid var(--qtm-newsletter-button-background);
    border-radius: calc(var(--qtm-newsletter-border-radius) * 0.45);
    font: inherit;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__button:focus-visible {
    outline: 3px solid var(--qtm-newsletter-link-color);
    outline-offset: 4px;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__consent {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    text-align: left;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__checkbox {
    width: 1rem;
    height: 1rem;
    margin-top: 0.18rem;
    accent-color: var(--qtm-newsletter-link-color);
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__consent-label {
    color: var(--qtm-newsletter-text-color);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__message {
    padding: 0.75rem 0.85rem;
    border-radius: calc(var(--qtm-newsletter-border-radius) * 0.42);
    font-weight: 700;
    line-height: 1.45;
    text-align: left;
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__message--success {
    color: var(--qtm-newsletter-success-color);
    background: color-mix(in srgb, var(--qtm-newsletter-success-color), transparent 92%);
    border: 1px solid color-mix(in srgb, var(--qtm-newsletter-success-color), transparent 72%);
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__message--error {
    color: var(--qtm-newsletter-error-color);
    background: color-mix(in srgb, var(--qtm-newsletter-error-color), transparent 92%);
    border: 1px solid color-mix(in srgb, var(--qtm-newsletter-error-color), transparent 72%);
  }

  .qtm-newsletter-{{ block_id }} .qtm-newsletter__disclaimer {
    font-size: 0.82rem;
    opacity: 0.78;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--animation-fade {
    animation: qtm-newsletter-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--animation-fade-up {
    animation: qtm-newsletter-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--animation-fade-down {
    animation: qtm-newsletter-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--animation-fade-left {
    animation: qtm-newsletter-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--animation-fade-right {
    animation: qtm-newsletter-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-newsletter-{{ block_id }}.qtm-newsletter--animation-zoom {
    animation: qtm-newsletter-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-newsletter-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-newsletter-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-newsletter-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-newsletter-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-newsletter-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-newsletter-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-newsletter-{{ block_id }}.qtm-newsletter--hide-tablet {
      display: none !important;
    }

    .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-inline .qtm-newsletter__inner,
    .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-card .qtm-newsletter__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-newsletter-{{ block_id }}.qtm-newsletter--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-newsletter-{{ block_id }} {
      padding: min(var(--qtm-newsletter-padding), 24px);
    }

    .qtm-newsletter-{{ block_id }}.qtm-newsletter--hide-mobile {
      display: none !important;
    }

    .qtm-newsletter-{{ block_id }} .qtm-newsletter__fields {
      grid-template-columns: 1fr;
    }

    .qtm-newsletter-{{ block_id }} .qtm-newsletter__button {
      width: 100%;
    }

    .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-card .qtm-newsletter__form-card,
    .qtm-newsletter-{{ block_id }}.qtm-newsletter--layout-inline .qtm-newsletter__form-card {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-newsletter-{{ block_id }},
    .qtm-newsletter-{{ block_id }} *,
    .qtm-newsletter-{{ block_id }} *::before,
    .qtm-newsletter-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our newsletter"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get updates, offers, product news, and helpful resources delivered to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Customer tags",
      "default": "newsletter"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "checkbox",
      "id": "show_email_label",
      "label": "Show email label",
      "default": false
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for signing up."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Please enter a valid email address."
    },
    {
      "type": "checkbox",
      "id": "show_consent",
      "label": "Show consent checkbox",
      "default": false
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Consent text",
      "default": "I agree to receive marketing emails and understand I can unsubscribe at any time."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>No spam. Unsubscribe anytime.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
