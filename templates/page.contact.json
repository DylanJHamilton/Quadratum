    "faq": {
      "type": "interactive-content-helper-tabs-accordion",
      "settings": {
        "show_header": true,
        "heading": "Answers, by category.",
        "subheading": "<p>Twelve most-asked questions. Everything else is in the search above.</p>",
        "layout_mode": "tabs_vertical",
        "style_preset": "faq",
        "icon_position": "left",
        "accordion_default_open": "first_open",
