{%- comment -%}Native GET filters remain usable without JavaScript and reset pagination.{%- endcomment -%}
{%- if search.filters.size > 0 -%}
  {{ 'search-facets.css' | asset_url | stylesheet_tag }}
  <form class="q-search-facets" action="{{ routes.search_url | escape }}" method="get" aria-label="{{ 'search.filters.heading' | t | escape }}">
    <input type="hidden" name="q" value="{{ search.terms | escape }}">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <h2>{{ 'search.filters.heading' | t }}</h2>
    <div class="q-search-facets__groups">
      {% for filter in search.filters %}
        {% assign filter_index = forloop.index %}
        <details {% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %}open{% endif %}>
          <summary>{{ filter.label | escape }}</summary>
          <div class="q-search-facets__values">
            {% if filter.type == 'price_range' %}
              <div class="q-search-facets__price">
                <label for="SearchFilter-{{ section.id }}-{{ filter_index }}-min">{{ 'search.filters.minimum' | t }} ({{ cart.currency.iso_code | escape }})</label>
                <input id="SearchFilter-{{ section.id }}-{{ filter_index }}-min" type="number" inputmode="decimal" min="0" step="any" max="{{ filter.range_max | divided_by: 100.0 }}" name="{{ filter.min_value.param_name | escape }}" {% if filter.min_value.value != blank %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}>
                <label for="SearchFilter-{{ section.id }}-{{ filter_index }}-max">{{ 'search.filters.maximum' | t }} ({{ cart.currency.iso_code | escape }})</label>
                <input id="SearchFilter-{{ section.id }}-{{ filter_index }}-max" type="number" inputmode="decimal" min="0" step="any" max="{{ filter.range_max | divided_by: 100.0 }}" name="{{ filter.max_value.param_name | escape }}" {% if filter.max_value.value != blank %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}>
              </div>
            {% else %}
              {% for value in filter.values %}
                <div class="q-search-facets__value">
                  <input id="SearchFilter-{{ section.id }}-{{ filter_index }}-{{ forloop.index }}" type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                  <label for="SearchFilter-{{ section.id }}-{{ filter_index }}-{{ forloop.index }}">{{ value.label | escape }} ({{ value.count }})</label>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
    <div class="q-search-facets__actions">
      {% if search.sort_options.size > 0 %}
        {% assign selected_sort = search.sort_by | default: search.default_sort_by %}
        <label for="SearchSort-{{ section.id }}">{{ 'search.filters.sort' | t }}</label>
        <select id="SearchSort-{{ section.id }}" name="sort_by">
          {% for option in search.sort_options %}<option value="{{ option.value | escape }}" {% if selected_sort == option.value %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
        </select>
      {% endif %}
      <button class="button" type="submit">{{ 'search.filters.apply' | t }}</button>
      <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&amp;type={{ search_types | url_encode }}&amp;options%5Bprefix%5D=last">{{ 'search.filters.clear' | t }}</a>
    </div>
  </form>
{%- endif -%}
