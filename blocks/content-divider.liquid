{%- liquid
  assign divider_type = block.settings.divider_type | default: 'line'
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'divider' %}

<div
  class="
    qtm-divider
    qtm-divider--{{ divider_type }}
  "
  role="separator"
  aria-orientation="horizontal"
  style="
    --qtm-divider-width: {{ block.settings.divider_width }}%;
    --qtm-divider-thickness: {{ block.settings.thickness }}px;
    --qtm-divider-color: {{ block.settings.divider_color }};
    --qtm-divider-gradient: {{ block.settings.divider_gradient }};
    --qtm-divider-opacity: {{ block.settings.opacity | divided_by: 100.0 }};
  "
></div>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "select",
      "id": "divider_type",
      "label": "Type",
      "default": "line",
      "options": [
        {
          "value": "line",
          "label": "Line"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#dddddd"
    },
    {
      "type": "color_background",
      "id": "divider_gradient",
      "label": "Divider gradient"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade-up",
          "label": "Fade up"
        },
        {
          "value": "fade-down",
          "label": "Fade down"
        },
        {
          "value": "fade-left",
          "label": "Fade left"
        },
        {
          "value": "fade-right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Simple line divider",
      "settings": {
        "divider_type": "line",
        "divider_width": 100,
        "thickness": 1,
        "opacity": 100,
        "divider_color": "#dddddd",
        "content_width": "auto",
        "alignment": "center",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 24,
        "margin_bottom": 24,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "none",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    },
    {
      "name": "Short centered divider",
      "settings": {
        "divider_type": "line",
        "divider_width": 30,
        "thickness": 2,
        "opacity": 100,
        "divider_color": "#111111",
        "content_width": "auto",
        "alignment": "center",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 20,
        "margin_bottom": 20,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "fade-up",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    },
    {
      "name": "Gradient divider",
      "settings": {
        "divider_type": "gradient",
        "divider_width": 100,
        "thickness": 3,
        "opacity": 100,
        "divider_color": "#111111",
        "content_width": "auto",
        "alignment": "center",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 32,
        "margin_bottom": 32,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "fade",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    }
  ]
}
{% endschema %}