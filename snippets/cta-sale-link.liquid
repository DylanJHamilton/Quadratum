{%- comment -%}Primary sale action; preserve destination query/fragment and encode the merchant's discount code.{%- endcomment -%}
{%- assign destination = url | default: fallback_url -%}
{%- if label != blank -%}
  {%- if destination != blank and destination != '#' -%}
    {%- if auto_apply and discount_code != blank -%}
      {%- assign destination_parts = destination | split: '#' -%}
      {%- assign destination_base = destination_parts | first -%}
      {%- unless destination_base contains 'discount=' -%}
        {%- assign separator = '?' -%}
        {%- if destination_base contains '?' -%}{%- assign separator = '&' -%}{%- endif -%}
        {%- assign encoded_code = discount_code | url_encode -%}
        {%- assign destination = destination_base | append: separator | append: 'discount=' | append: encoded_code -%}
        {%- if destination_parts.size > 1 -%}
          {%- assign fragment = destination_parts | last -%}
          {%- assign destination = destination | append: '#' | append: fragment -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}
    <a href="{{ destination | escape }}" class="btn" data-cta="primary">{{ label | escape }}</a>
  {%- else -%}
    <span class="btn" aria-disabled="true">{{ label | escape }}</span>
  {%- endif -%}
{%- endif -%}
