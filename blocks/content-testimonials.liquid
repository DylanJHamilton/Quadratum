    },
    {
      "type": "text",
      "id": "testimonial_3_name",
      "label": "Name",
      "default": "Taylor Reed"
    },
    {
      "type": "text",
      "id": "testimonial_3_role",
      "label": "Role",
      "default": "Marketing Lead"
    },
    {
      "type": "text",
      "id": "testimonial_3_company",
      "label": "Company",
      "default": "Commerce Brand"
    },
    {
      "type": "select",
      "id": "testimonial_3_rating",
      "label": "Rating",
      "default": "5",
      "options": [
        {
          "value": "none",
          "label": "No rating"
        },
        {
          "value": "1",
          "label": "1 star"
        },
        {
          "value": "2",
          "label": "2 stars"
        },
        {
          "value": "3",
          "label": "3 stars"
        },
        {
          "value": "4",
          "label": "4 stars"
        },
        {
          "value": "5",
          "label": "5 stars"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "testimonial_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "testimonial_3_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "testimonial_3_link_label",
      "label": "Link label",
      "default": "Read story"
    },
    {
