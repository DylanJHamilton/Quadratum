{%- liquid
  assign share_image = page_image | default: settings.social_share_image | default: settings.logo_primary
  assign share_title = page_title | default: shop.name
  assign share_description = page_description | default: shop.description | default: settings.site_tagline
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url | default: request.origin | escape }}">
<meta property="og:title" content="{{ share_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
{%- if share_description != blank -%}
  <meta property="og:description" content="{{ share_description | strip_html | escape }}">
{%- endif -%}
{%- if share_image != blank -%}
  {%- assign share_image_url = share_image | image_url: width: 1200 -%}
  {%- assign share_image_prefix = share_image_url | slice: 0, 2 -%}
  {%- if share_image_prefix == '//' -%}{%- assign share_image_url = share_image_url | prepend: 'https:' -%}{%- endif -%}
  <meta property="og:image" content="{{ share_image_url | escape }}">
  <meta property="og:image:alt" content="{{ share_image.alt | default: share_title | escape }}">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
