    "manifesto": {
      "type": "basic-content-helper-text-centered-full-width",
      "settings": {
        "kicker": "What we believe",
        "title": "Good design earns its place.",
        "body": "<p>Good objects disappear into the day. They answer a call, charge a laptop, carry a load, and then get out of the way. We design for that moment of not noticing.</p>",
        "alignment": "center",
        "max_width": "wide",
        "surface": "none",
        "pad_y": 88,
        "bg_color": "#f5f5f1",
        "text_color": "#111111",
        "muted_text_color": "#545450",
        "accent_color": "#111111"
      }
    },
    "timeline": {
      "type": "interactive-content-helper-story-timeline",
      "settings": {
        "show_heading": true,
        "title": "Seven years, five categories.",
        "subtitle": "<p>Each new category arrived only when it could share the same finish, warranty and control logic as the last.</p>",
        "orientation": "vertical",
        "vertical_alignment": "alternating",
        "show_line_connector": true,
        "marker_style": "dot",
        "card_style": "minimal",
        "show_card_media": true,
        "card_media_position": "top",
        "show_accent_bar": false,
        "max_width": 1440,
        "pad_y": 88,
        "bg_color": "#f5f5f1",
        "text_color": "#111111",
        "muted_color": "#545450",
        "accent_color": "#111111",
        "surface_color": "#e7e7e2"
      },
      "blocks": {
        "arc_131": {
          "type": "milestone",
          "settings": {
            "year_or_date": "2019",
            "title": "Two people, one table",
            "description": "<p>ARC//FORM starts in a shared studio with one product: a cable kit.</p>",
            "image": "shopify://shop_images/cable-kit-08-lifestyle.webp"
          }
        },
        "arc_132": {
          "type": "milestone",
          "settings": {
            "year_or_date": "2021",
            "title": "The first carry",
            "description": "<p>Transit Pack 22 ships. It is still our most-bought object.</p>",
            "image": "shopify://shop_images/transit-pack-22-08-lifestyle.webp"
          }
        },
        "arc_133": {
          "type": "milestone",
          "settings": {
            "year_or_date": "2023",
            "title": "Power, simplified",
            "description": "<p>Core 65 and Reserve 10 bring the same finish to charging.</p>",
            "image": "shopify://shop_images/core-65-08-lifestyle.webp"
          }
        },
        "arc_134": {
          "type": "milestone",
          "settings": {
            "year_or_date": "2025",
            "title": "On the wrist",
            "description": "<p>Index One brings the system to wearables.</p>",
            "image": "shopify://shop_images/index-one-08-lifestyle.webp"
          }
        },
        "arc_135": {
          "type": "milestone",
          "settings": {
            "year_or_date": "2026",
            "title": "Eyewear and the desk",
            "description": "<p>Vector smart glasses and the Workday System arrive together.</p>",
            "image": "shopify://shop_images/vector-one-08-lifestyle.webp"
          }
        }
      },
      "block_order": [
        "arc_131",
        "arc_132",
        "arc_133",
        "arc_134",
        "arc_135"
      ]
    },
    "principles": {
      "type": "interactive-content-helper-cards",
      "settings": {
        "show_header": true,
        "heading": "Four rules on the studio wall.",
        "subheading": "<p>Tap a card to see the rule in practice.</p>",
        "design_preset": "bold",
        "hover_style": "none",
        "content_align": "left",
        "layout_mode": "grid",
        "card_variant": "flip_box",
        "columns_desktop": 4,
        "columns_tablet": 2,
        "columns_mobile": 1,
        "equal_height_cards": true,
        "flip_trigger": "click",
        "flip_mobile_fallback": "enable_flip",
        "max_width": 1440,
        "pad_y": 88,
        "card_radius": 24,
        "use_custom_colors": true,
        "color_bg": "#f5f5f1",
        "color_surface": "#e7e7e2",
        "color_text": "#111111",
        "color_accent": "#111111",
        "color_border": "#cfcfca"
      },
      "blocks": {
        "arc_136": {
          "type": "card",
          "settings": {
            "title": "Physical first",
            "body": "<p>Every primary action has a button you can find without looking.</p>",
            "icon": "lucide-scan",
            "back_title": "In practice",
            "back_body": "<p>Touch surfaces are only added where a button cannot do the job.</p>",
            "back_cta_label": "Shop with it",
            "back_cta_url": "shopify://collections/all-products"
          }
        },
        "arc_137": {
          "type": "card",
          "settings": {
            "title": "Honest materials",
            "body": "<p>Aluminum, acetate, steel, recycled nylon.</p>",
            "icon": "lucide-droplet",
            "back_title": "In practice",
            "back_body": "<p>No coatings pretending to be metal. Wear shows, and it looks right when it does.</p>",
            "back_cta_label": "Shop with it",
            "back_cta_url": "shopify://collections/all-products"
          }
        },
        "arc_138": {
          "type": "card",
          "settings": {
            "title": "Quiet packaging",
            "body": "<p>One recycled fiber box per object.</p>",
            "icon": "lucide-package",
            "back_title": "In practice",
            "back_body": "<p>No plastic windows, no foam. The box is sized to the object, not the shelf.</p>",
            "back_cta_label": "Shop with it",
            "back_cta_url": "shopify://collections/all-products"
          }
        },
        "arc_139": {
          "type": "card",
          "settings": {
            "title": "Repair over replace",
            "body": "<p>Parts and batteries sold separately.</p>",
            "icon": "lucide-wrench",
            "back_title": "In practice",
            "back_body": "<p>Hinges, bands, temple batteries and straps can be swapped at home or by post.</p>",
            "back_cta_label": "Shop with it",
            "back_cta_url": "shopify://collections/all-products"
          }
        }
      },
      "block_order": [
        "arc_136",
        "arc_137",
        "arc_138",
        "arc_139"
      ]
    },
