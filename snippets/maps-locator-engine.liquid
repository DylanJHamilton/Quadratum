{% comment %}Explicit DOM configuration for the shared locator; no inline JavaScript or JSON string interpolation.{% endcomment %}
{{ 'maps-locator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maps-locator.js' | asset_url }}" defer></script>
{% assign map_key = settings.gmap_api_key | strip %}
{% capture center %}{% render 'maps-coordinates', lat: section.settings.default_lat, lng: section.settings.default_lng %}{% endcapture %}
<div data-map-config hidden data-enabled="{% if section.settings.enable_map and settings.gmap_enable and map_key != blank and map_key != 'none' %}true{% else %}false{% endif %}" data-key="{% if section.settings.enable_map and settings.gmap_enable %}{{ map_key | escape }}{% endif %}" data-center="{{ center | strip }}" data-zoom="{{ section.settings.default_zoom }}" data-pin-label="{{ section.settings.pin_primary_label | default: 'Open details' | escape }}"></div>
