                  "settings": {
                    "picker_style": "buttons",
                    "show_selected_value": true,
                    "show_status": false,
                    "heading_color": "#182E2A",
                    "text_color": "#182E2A",
                    "background_color": "#FFFFFF",
                    "border_color": "#62665E",
                    "active_background_color": "#182E2A",
                    "active_text_color": "#F6F1E7",
                    "active_border_color": "#182E2A",
                    "border_width": 1,
                    "border_radius": 4,
                    "margin_bottom": 20
                  }
                },
                "product_layout_row_1_product_layout_column_2_product_add_to_cart_7": {
                  "type": "product-add-to-cart",
                  "settings": {
                    "add_to_cart_label": "Add to cart",
                    "sold_out_label": "Sold out",
