{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  assign highlighted_column = block.settings.highlighted_column | plus: 0
%}

<div
  class="
    qtm-comparison-matrix
    qtm-comparison-matrix-{{ block_id }}
    qtm-comparison-matrix--width-{{ block_width }}
    qtm-comparison-matrix--align-{{ block_alignment }}
    qtm-comparison-matrix--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-comparison-matrix--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-comparison-matrix--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-comparison-matrix--hide-mobile{% endunless %}
  "
  style="
    --qtm-comparison-margin-top: {{ block.settings.margin_top }}px;
    --qtm-comparison-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-comparison-padding: {{ block.settings.padding }}px;
    --qtm-comparison-gap: {{ block.settings.gap }}px;
    --qtm-comparison-heading-color: {{ block.settings.heading_color }};
    --qtm-comparison-text-color: {{ block.settings.text_color }};
    --qtm-comparison-background-color: {{ block.settings.background_color }};
    --qtm-comparison-border-color: {{ block.settings.border_color }};
    --qtm-comparison-link-color: {{ block.settings.link_color }};
    --qtm-comparison-card-background: {{ block.settings.card_background_color }};
    --qtm-comparison-highlight-background: {{ block.settings.highlight_background_color }};
    --qtm-comparison-highlight-text: {{ block.settings.highlight_text_color }};
    --qtm-comparison-positive-color: {{ block.settings.positive_color }};
    --qtm-comparison-negative-color: {{ block.settings.negative_color }};
    --qtm-comparison-partial-color: {{ block.settings.partial_color }};
    --qtm-comparison-border-width: {{ block.settings.border_width }}px;
    --qtm-comparison-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-comparison-matrix__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-comparison-matrix__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-comparison-matrix__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-comparison-matrix__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-comparison-matrix__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-comparison-matrix__desktop-table-wrap" role="region" aria-label="{{ block.settings.heading | default: 'Comparison matrix' | escape }}" tabindex="0">
      <table class="qtm-comparison-matrix__table">
        <caption class="qtm-comparison-matrix__caption">
          {{ block.settings.heading | default: 'Comparison matrix' | escape }}
        </caption>

        <thead>
          <tr>
            <th scope="col" class="qtm-comparison-matrix__feature-heading">
              {{ block.settings.feature_column_label | escape }}
            </th>

            {% for i in (1..4) %}
              {% liquid
                assign column_enabled_key = 'column_' | append: i | append: '_enabled'
                assign column_title_key = 'column_' | append: i | append: '_title'
                assign column_subtitle_key = 'column_' | append: i | append: '_subtitle'
                assign column_badge_key = 'column_' | append: i | append: '_badge'
                assign column_price_key = 'column_' | append: i | append: '_price'
                assign column_enabled = block.settings[column_enabled_key]
                assign column_title = block.settings[column_title_key]
                assign column_subtitle = block.settings[column_subtitle_key]
                assign column_badge = block.settings[column_badge_key]
                assign column_price = block.settings[column_price_key]
              %}

              {% if column_enabled %}
                <th
                  scope="col"
                  class="
                    qtm-comparison-matrix__column-heading
                    {% if highlighted_column == i %} qtm-comparison-matrix__column-heading--highlight{% endif %}
                  "
                >
                  {% if column_badge != blank %}
                    <span class="qtm-comparison-matrix__badge">
                      {{ column_badge | escape }}
                    </span>
                  {% endif %}

                  {% if column_title != blank %}
                    <span class="qtm-comparison-matrix__column-title">
                      {{ column_title | escape }}
                    </span>
                  {% endif %}

                  {% if column_subtitle != blank %}
                    <span class="qtm-comparison-matrix__column-subtitle">
                      {{ column_subtitle | escape }}
                    </span>
                  {% endif %}

                  {% if column_price != blank %}
                    <span class="qtm-comparison-matrix__column-price">
                      {{ column_price | escape }}
                    </span>
                  {% endif %}
                </th>
              {% endif %}
            {% endfor %}
          </tr>
        </thead>

        <tbody>
          {% for row in (1..8) %}
            {% liquid
              assign row_enabled_key = 'row_' | append: row | append: '_enabled'
              assign row_label_key = 'row_' | append: row | append: '_label'
              assign row_enabled = block.settings[row_enabled_key]
              assign row_label = block.settings[row_label_key]
            %}

            {% if row_enabled %}
              <tr>
                <th scope="row" class="qtm-comparison-matrix__feature-cell">
                  {{ row_label | escape }}
                </th>

                {% for column in (1..4) %}
                  {% liquid
                    assign column_enabled_key = 'column_' | append: column | append: '_enabled'
                    assign value_key = 'row_' | append: row | append: '_column_' | append: column | append: '_value'
                    assign note_key = 'row_' | append: row | append: '_column_' | append: column | append: '_note'

                    assign column_enabled = block.settings[column_enabled_key]
                    assign value = block.settings[value_key]
                    assign note = block.settings[note_key]
                  %}

                  {% if column_enabled %}
                    <td class="{% if highlighted_column == column %}qtm-comparison-matrix__cell--highlight{% endif %}">
                      <span class="qtm-comparison-matrix__value qtm-comparison-matrix__value--{{ value }}">
                        {% case value %}
                          {% when 'yes' %}
                            <span aria-label="Included">✓</span>
                          {% when 'no' %}
                            <span aria-label="Not included">×</span>
                          {% when 'partial' %}
                            <span aria-label="Partially included">—</span>
                          {% else %}
                            <span>{{ value | escape }}</span>
                        {% endcase %}
                      </span>

                      {% if note != blank %}
                        <span class="qtm-comparison-matrix__note">
                          {{ note | escape }}
                        </span>
                      {% endif %}
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>

        {% if block.settings.show_cta_row %}
          <tfoot>
            <tr>
              <th scope="row" class="qtm-comparison-matrix__feature-cell">
                {{ block.settings.cta_row_label | escape }}
              </th>

              {% for i in (1..4) %}
                {% liquid
                  assign column_enabled_key = 'column_' | append: i | append: '_enabled'
                  assign cta_text_key = 'column_' | append: i | append: '_cta_text'
                  assign cta_url_key = 'column_' | append: i | append: '_cta_url'

                  assign column_enabled = block.settings[column_enabled_key]
                  assign cta_text = block.settings[cta_text_key]
                  assign cta_url = block.settings[cta_url_key]
                %}

                {% if column_enabled %}
                  <td class="{% if highlighted_column == i %}qtm-comparison-matrix__cell--highlight{% endif %}">
                    {% if cta_text != blank and cta_url != blank %}
                      <a class="qtm-comparison-matrix__button" href="{{ cta_url }}">
                        {{ cta_text | escape }}
                      </a>
                    {% endif %}
                  </td>
                {% endif %}
              {% endfor %}
            </tr>
          </tfoot>
        {% endif %}
      </table>
    </div>

    <div class="qtm-comparison-matrix__mobile-cards">
      {% for column in (1..4) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: column | append: '_enabled'
          assign column_title_key = 'column_' | append: column | append: '_title'
          assign column_subtitle_key = 'column_' | append: column | append: '_subtitle'
          assign column_badge_key = 'column_' | append: column | append: '_badge'
          assign column_price_key = 'column_' | append: column | append: '_price'
          assign cta_text_key = 'column_' | append: column | append: '_cta_text'
          assign cta_url_key = 'column_' | append: column | append: '_cta_url'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_title = block.settings[column_title_key]
          assign column_subtitle = block.settings[column_subtitle_key]
          assign column_badge = block.settings[column_badge_key]
          assign column_price = block.settings[column_price_key]
          assign cta_text = block.settings[cta_text_key]
          assign cta_url = block.settings[cta_url_key]
        %}

        {% if column_enabled %}
          <article class="qtm-comparison-matrix__mobile-card {% if highlighted_column == column %}qtm-comparison-matrix__mobile-card--highlight{% endif %}">
            <div class="qtm-comparison-matrix__mobile-card-header">
              {% if column_badge != blank %}
                <span class="qtm-comparison-matrix__badge">
                  {{ column_badge | escape }}
                </span>
              {% endif %}

              {% if column_title != blank %}
                <h3 class="qtm-comparison-matrix__mobile-card-title">
                  {{ column_title | escape }}
                </h3>
              {% endif %}

              {% if column_subtitle != blank %}
                <p class="qtm-comparison-matrix__mobile-card-subtitle">
                  {{ column_subtitle | escape }}
                </p>
              {% endif %}

              {% if column_price != blank %}
                <p class="qtm-comparison-matrix__mobile-card-price">
                  {{ column_price | escape }}
                </p>
              {% endif %}
            </div>

            <dl class="qtm-comparison-matrix__mobile-feature-list">
              {% for row in (1..8) %}
                {% liquid
                  assign row_enabled_key = 'row_' | append: row | append: '_enabled'
                  assign row_label_key = 'row_' | append: row | append: '_label'
                  assign value_key = 'row_' | append: row | append: '_column_' | append: column | append: '_value'
                  assign note_key = 'row_' | append: row | append: '_column_' | append: column | append: '_note'

                  assign row_enabled = block.settings[row_enabled_key]
                  assign row_label = block.settings[row_label_key]
                  assign value = block.settings[value_key]
                  assign note = block.settings[note_key]
                %}

                {% if row_enabled %}
                  <div class="qtm-comparison-matrix__mobile-feature">
                    <dt>{{ row_label | escape }}</dt>
                    <dd>
                      <span class="qtm-comparison-matrix__value qtm-comparison-matrix__value--{{ value }}">
                        {% case value %}
                          {% when 'yes' %}
                            <span aria-label="Included">✓</span>
                          {% when 'no' %}
                            <span aria-label="Not included">×</span>
                          {% when 'partial' %}
                            <span aria-label="Partially included">—</span>
                          {% else %}
                            <span>{{ value | escape }}</span>
                        {% endcase %}
                      </span>

                      {% if note != blank %}
                        <span class="qtm-comparison-matrix__note">
                          {{ note | escape }}
                        </span>
                      {% endif %}
                    </dd>
                  </div>
                {% endif %}
              {% endfor %}
            </dl>

            {% if cta_text != blank and cta_url != blank %}
              <a class="qtm-comparison-matrix__button" href="{{ cta_url }}">
                {{ cta_text | escape }}
              </a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .qtm-comparison-matrix-{{ block_id }} {
    margin-top: var(--qtm-comparison-margin-top);
    margin-bottom: var(--qtm-comparison-margin-bottom);
    padding: var(--qtm-comparison-padding);
    color: var(--qtm-comparison-text-color);
    background: var(--qtm-comparison-background-color);
    border: var(--qtm-comparison-border-width) solid var(--qtm-comparison-border-color);
    border-radius: var(--qtm-comparison-border-radius);
  }

  .qtm-comparison-matrix-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--width-auto {
    width: auto;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--width-small {
    max-width: 720px;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--width-medium {
    max-width: 960px;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--width-large {
    max-width: 1200px;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__inner {
    display: grid;
    gap: var(--qtm-comparison-gap);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__header {
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--align-center .qtm-comparison-matrix__header {
    margin-inline: auto;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--align-right .qtm-comparison-matrix__header {
    margin-left: auto;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__eyebrow {
    margin: 0;
    color: var(--qtm-comparison-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__heading {
    margin: 0;
    color: var(--qtm-comparison-heading-color);
    line-height: 1.05;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__text {
    color: var(--qtm-comparison-text-color);
    line-height: 1.7;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__text p {
    margin-top: 0;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__desktop-table-wrap {
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--qtm-comparison-border-color), transparent 15%);
    border-radius: calc(var(--qtm-comparison-border-radius) * 0.8);
    background: var(--qtm-comparison-card-background);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.05);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__desktop-table-wrap:focus-visible {
    outline: 3px solid var(--qtm-comparison-link-color);
    outline-offset: 4px;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__table {
    width: 100%;
    min-width: 720px;
    border-collapse: separate;
    border-spacing: 0;
    color: var(--qtm-comparison-text-color);
    text-align: center;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .qtm-comparison-matrix-{{ block_id }} th,
  .qtm-comparison-matrix-{{ block_id }} td {
    padding: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--qtm-comparison-border-color), transparent 20%);
    vertical-align: middle;
  }

  .qtm-comparison-matrix-{{ block_id }} thead th {
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    color: var(--qtm-comparison-heading-color);
    background: color-mix(in srgb, var(--qtm-comparison-card-background), var(--qtm-comparison-text-color) 3%);
  }

  .qtm-comparison-matrix-{{ block_id }} tfoot th,
  .qtm-comparison-matrix-{{ block_id }} tfoot td {
    border-bottom: 0;
    background: color-mix(in srgb, var(--qtm-comparison-card-background), var(--qtm-comparison-text-color) 2%);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__feature-heading,
  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__feature-cell {
    width: 26%;
    min-width: 12rem;
    text-align: left;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__feature-cell {
    color: var(--qtm-comparison-heading-color);
    font-weight: 750;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__column-heading {
    position: relative;
    min-width: 10rem;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__column-heading--highlight,
  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__cell--highlight {
    color: var(--qtm-comparison-highlight-text);
    background: var(--qtm-comparison-highlight-background);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__badge {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.6rem;
    padding: 0.35rem 0.6rem;
    color: var(--qtm-comparison-highlight-text);
    background: var(--qtm-comparison-link-color);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__column-title {
    display: block;
    color: inherit;
    font-size: 1.05rem;
    font-weight: 850;
    line-height: 1.15;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__column-subtitle {
    display: block;
    margin-top: 0.35rem;
    color: inherit;
    font-size: 0.85rem;
    line-height: 1.45;
    opacity: 0.72;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__column-price {
    display: block;
    margin-top: 0.65rem;
    color: inherit;
    font-size: 1.25rem;
    font-weight: 850;
    line-height: 1.1;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__value {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    min-height: 1.6rem;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__value--yes {
    color: var(--qtm-comparison-positive-color);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__value--no {
    color: var(--qtm-comparison-negative-color);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__value--partial {
    color: var(--qtm-comparison-partial-color);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__note {
    display: block;
    margin-top: 0.35rem;
    color: inherit;
    font-size: 0.8rem;
    line-height: 1.35;
    opacity: 0.72;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.8rem 1.1rem;
    color: #ffffff;
    background: var(--qtm-comparison-link-color);
    border: 1px solid var(--qtm-comparison-link-color);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__button:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__button:focus-visible {
    outline: 3px solid var(--qtm-comparison-link-color);
    outline-offset: 4px;
  }

  .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-cards {
    display: none;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--animation-fade {
    animation: qtm-comparison-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--animation-fade-up {
    animation: qtm-comparison-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--animation-fade-down {
    animation: qtm-comparison-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--animation-fade-left {
    animation: qtm-comparison-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--animation-fade-right {
    animation: qtm-comparison-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--animation-zoom {
    animation: qtm-comparison-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-comparison-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-comparison-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-comparison-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-comparison-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-comparison-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-comparison-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--hide-tablet {
      display: none !important;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-comparison-matrix-{{ block_id }} {
      padding: min(var(--qtm-comparison-padding), 24px);
    }

    .qtm-comparison-matrix-{{ block_id }}.qtm-comparison-matrix--hide-mobile {
      display: none !important;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__desktop-table-wrap {
      display: none;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-cards {
      display: grid;
      gap: 1rem;
      text-align: left;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card {
      display: grid;
      gap: 1rem;
      padding: 1rem;
      color: var(--qtm-comparison-text-color);
      background: var(--qtm-comparison-card-background);
      border: 1px solid color-mix(in srgb, var(--qtm-comparison-border-color), transparent 10%);
      border-radius: calc(var(--qtm-comparison-border-radius) * 0.75);
      box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.05);
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card--highlight {
      color: var(--qtm-comparison-highlight-text);
      background: var(--qtm-comparison-highlight-background);
      border-color: color-mix(in srgb, var(--qtm-comparison-link-color), transparent 35%);
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-header {
      display: grid;
      gap: 0.35rem;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-title,
    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-subtitle,
    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-price {
      margin: 0;
      color: inherit;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-title {
      font-size: 1.25rem;
      line-height: 1.15;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-subtitle {
      line-height: 1.55;
      opacity: 0.78;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-card-price {
      margin-top: 0.25rem;
      font-size: 1.35rem;
      font-weight: 850;
      line-height: 1.1;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-feature-list {
      display: grid;
      gap: 0;
      margin: 0;
      border-top: 1px solid color-mix(in srgb, currentColor, transparent 86%);
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-feature {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: center;
      padding: 0.85rem 0;
      border-bottom: 1px solid color-mix(in srgb, currentColor, transparent 86%);
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-feature dt {
      font-weight: 750;
    }

    .qtm-comparison-matrix-{{ block_id }} .qtm-comparison-matrix__mobile-feature dd {
      display: grid;
      justify-items: end;
      gap: 0.25rem;
      margin: 0;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-comparison-matrix-{{ block_id }},
    .qtm-comparison-matrix-{{ block_id }} *,
    .qtm-comparison-matrix-{{ block_id }} *::before,
    .qtm-comparison-matrix-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

