{%- liquid
  assign context = context | default: 'page'
  assign compact = compact | default: false
-%}

<article
  class="qtm-cart-line-item qtm-cart-line-item--{{ context }} {% if compact %}qtm-cart-line-item--compact{% endif %}"
  data-cart-item
  data-key="{{ item.key | escape }}"
  data-can-remove="{% if item.instructions.can_remove == false %}false{% else %}true{% endif %}"
  data-line="{{ line_index }}"
>
  <div class="qtm-cart-line-item__media">
    <a
      href="{{ item.url | escape }}"
      class="qtm-cart-line-item__image-link"
      aria-label="{{ item.product.title | escape }}"
    >
      {%- if item.image -%}
        {%- liquid
          assign qtm_image_alt = item.image.alt | default: item.product.title
        -%}
        {{ item.image
          | image_url: width: 320
          | image_tag:
          loading: 'lazy',
          widths: '120,160,240,320',
          class: 'qtm-cart-line-item__image', alt: qtm_image_alt }}
      {%- else -%}
        <div class="qtm-cart-line-item__image-placeholder"></div>
      {%- endif -%}
    </a>
  </div>

  <div class="qtm-cart-line-item__content">
    <div class="qtm-cart-line-item__top">
      <div class="qtm-cart-line-item__details">
        <h2 class="qtm-cart-line-item__title">
          <a href="{{ item.url | escape }}">{{ item.product.title | escape }}</a>
        </h2>

        {%- unless item.product.has_only_default_variant -%}
          <div class="qtm-cart-line-item__variant">
            {{ item.variant.title | escape }}
          </div>
        {%- endunless -%}

        {% if item.selling_plan_allocation != blank %}<p class="qtm-cart-line-item__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
        {%- assign has_properties = false -%}
        {%- for property in item.properties -%}
          {%- assign property_key_first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and property_key_first_char != '_' -%}
            {%- assign has_properties = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_properties -%}
          <dl class="qtm-cart-line-item__properties">
            {%- for property in item.properties -%}
              {%- assign property_key_first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and property_key_first_char != '_' -%}
                <div class="qtm-cart-line-item__property">
                  <dt>{{ property.first | escape }}:</dt>
                  <dd>
                    {%- assign upload_prefix = property.last | slice: 0, 8 -%}
                    {%- assign upload_short_prefix = property.last | slice: 0, 2 -%}
                    {%- assign safe_upload = false -%}
                    {%- if upload_prefix == 'https://' or upload_short_prefix == '//' -%}{% assign safe_upload = true %}{%- endif -%}
                    {%- if property.last contains '/uploads/' and safe_upload -%}
                      <a href="{{ property.last | escape }}">{{ property.last | split: '/' | last | escape }}</a>
                    {%- else -%}
                      {{ property.last | escape }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="qtm-cart-line-item__discounts" role="list">
            {%- for discount_allocation in item.line_level_discount_allocations -%}
              <li class="qtm-cart-line-item__discount">
                {{ discount_allocation.discount_application.title | escape }}
                <span>-{{ discount_allocation.amount | money }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="qtm-cart-line-item__pricing">
        <div class="qtm-cart-line-item__price-block">
          <span class="qtm-cart-line-item__price-label">Each</span>
          <div class="qtm-cart-line-item__price-values">
            {%- if item.original_price > item.final_price -%}
              <span class="qtm-cart-line-item__compare-price">
                {{ item.original_price | money }}
              </span>
            {%- endif -%}
            <span class="qtm-cart-line-item__unit-price">
              {{ item.final_price | money }}
            </span>
          </div>
        </div>

        <div class="qtm-cart-line-item__price-block">
          <span class="qtm-cart-line-item__price-label">Total</span>
          <div class="qtm-cart-line-item__price-values">
            {%- if item.original_line_price > item.final_line_price -%}
              <span class="qtm-cart-line-item__compare-price">
                {{ item.original_line_price | money }}
              </span>
            {%- endif -%}
            <span class="qtm-cart-line-item__line-price" data-line-price>
              {{ item.final_line_price | money }}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="qtm-cart-line-item__bottom">
      <div class="qtm-cart-line-item__qty-wrap">
        <label class="visually-hidden" for="CartQty-{{ section_id }}-{{ item.key | escape }}">
          Quantity for {{ item.product.title | escape }}
        </label>

        <div class="qtm-cart-line-item__qty" data-cart-qty>
          <button
            type="button"
            class="qtm-cart-line-item__qty-btn"
            hidden {% if item.instructions.can_update_quantity == false %}disabled{% endif %}
            data-qty-decrease
            aria-label="Decrease quantity for {{ item.product.title | escape }}"
          >
            −
          </button>

          <input
            id="CartQty-{{ section_id }}-{{ item.key | escape }}"
            class="qtm-cart-line-item__qty-input"
            type="number"
            name="updates[]"
            required min="{{ item.variant.quantity_rule.min | default: 1 }}"
            step="{{ item.variant.quantity_rule.increment | default: 1 }}"
            {% if item.variant.quantity_rule.max != blank %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
            {% if item.instructions.can_update_quantity == false %}readonly{% endif %}
            data-current-quantity="{{ item.quantity }}"
            inputmode="numeric"
            value="{{ item.quantity }}"
            data-line="{{ line_index }}"
            data-key="{{ item.key | escape }}"
          >

          <button
            type="button"
            class="qtm-cart-line-item__qty-btn"
            hidden {% if item.instructions.can_update_quantity == false %}disabled{% endif %}
            data-qty-increase
            aria-label="Increase quantity for {{ item.product.title | escape }}"
          >
            +
          </button>
        </div>
      </div>

      {% unless item.instructions.can_remove == false %}
        <a href="{{ item.url_to_remove | escape }}" class="qtm-cart-line-item__remove" data-cart-remove data-key="{{ item.key | escape }}" aria-label="Remove {{ item.product.title | escape }} from cart">Remove</a>
      {% endunless %}
    </div>
  </div>
</article>