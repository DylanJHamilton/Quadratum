{%- comment -%}Blog feed: native pagination plus optional progressive load-more; filtered previews link to the complete tagged archive.{%- endcomment -%}

{%- liquid
  assign sid = section.id

  assign chosen_blog = section.settings.blog
  if chosen_blog == blank
    assign chosen_blog = blog
  endif

  assign filter_tag_raw = section.settings.filter_tag | default: ''
  assign filter_tag = filter_tag_raw | strip

  assign per_page = section.settings.per_page | default: 12 | at_least: 1 | at_most: 50
  assign layout_mode = section.settings.layout_mode | default: 'list'

  assign cols_m = section.settings.cols_mobile | default: 1
  assign cols_t = section.settings.cols_tablet | default: 2
  assign cols_d = section.settings.cols_desktop | default: 3

  assign gap_token = section.settings.gap_token | default: 'md'
  assign pad_token = section.settings.pad_token | default: 'lg'



  assign pagination_mode = section.settings.pagination_mode | default: 'standard'
  assign load_more_label = section.settings.load_more_label | default: 'Load more'

  assign list_img_cap = section.settings.list_image_cap | default: 240

  assign on_tagged_page = false
  if filter_tag != blank and chosen_blog.id == blog.id and current_tags contains filter_tag
    assign on_tagged_page = true
  endif

  assign tagged_url = ''
  if filter_tag != blank and chosen_blog != blank
    assign tag_handle = filter_tag | handleize
    assign tagged_url = chosen_blog.url | append: '/tagged/' | append: tag_handle
  endif

  assign tag_preview = false
  if filter_tag != blank and on_tagged_page == false
    assign tag_preview = true
  endif
  if on_tagged_page
    assign chosen_blog = blog
  endif

  comment
    Token -> CSS var mapping WITH FALLBACK LENGTHS.
    Critical fix: var(--q-gap-md) can be undefined in dev shells; use var(--q-gap-md, 28px).
  endcomment

  assign gap_var = 'var(--q-gap-md, 28px)'
  case gap_token
    when 'xs'
      assign gap_var = 'var(--q-gap-xs, 12px)'
    when 'sm'
      assign gap_var = 'var(--q-gap-sm, 18px)'
    when 'md'
      assign gap_var = 'var(--q-gap-md, 28px)'
    when 'lg'
      assign gap_var = 'var(--q-gap-lg, 36px)'
    when 'xl'
      assign gap_var = 'var(--q-gap-xl, 48px)'
  endcase

  assign pad_var = 'var(--q-gap-lg, 24px)'
  case pad_token
    when 'none'
      assign pad_var = '0px'
    when 'xs'
      assign pad_var = 'var(--q-gap-xs, 12px)'
    when 'sm'
      assign pad_var = 'var(--q-gap-sm, 16px)'
    when 'md'
      assign pad_var = 'var(--q-gap-md, 20px)'
    when 'lg'
      assign pad_var = 'var(--q-gap-lg, 24px)'
    when 'xl'
      assign pad_var = 'var(--q-gap-xl, 32px)'
  endcase
-%}

<script src="{{ 'feeds-blogs.js' | asset_url }}" defer></script>
{% if chosen_blog != blank or request.design_mode %}
<section
  id="QtmBlogFeed-{{ sid }}"
  class="q-feed q-feed--blog q-feed--{{ layout_mode }}"
  data-q-section="feeds-blogs"
  data-q-sid="{{ sid }}"
  style="
    --q-feed-gap: {{ gap_var }};
    --q-feed-pad: {{ pad_var }};
    --q-feed-cols-m: {{ cols_m }};
    --q-feed-cols-t: {{ cols_t }};
    --q-feed-cols-d: {{ cols_d }};
    --q-feed-list-img-cap: {{ list_img_cap }}px;
  "
>
  {%- if section.settings.bg_mode != 'none' -%}
    <div
      class="q-feed__bg"
      aria-hidden="true"
      style="
        {%- if section.settings.bg_mode == 'surface' -%}
          background: var(--q-surface);
        {%- elsif section.settings.bg_mode == 'contrast' -%}
          background: var(--q-surface-2);
        {%- endif -%}
      "
    ></div>
  {%- endif -%}

  <div class="q-feed__inner q-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank or section.settings.show_blog_title and chosen_blog != blank -%}
      <header class="q-feed__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="q-feed__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="q-feed__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="q-feed__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if chosen_blog != blank and section.settings.show_blog_title -%}
          <p class="q-feed__blogtitle">
            <a class="q-feed__bloglink" href="{{ chosen_blog.url | escape }}">
              {{ chosen_blog.title | escape }}
            </a>
            {%- if filter_tag != blank -%}
              <span class="q-feed__filterpill" aria-label="Filtered by tag">{{ filter_tag | escape }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if chosen_blog == blank -%}
      <div class="q-feed__empty" role="status">
        <p>Select a blog to display articles.</p>
      </div>
    {%- else -%}

      {%- if tag_preview -%}
        {% render 'blog-feed-items', articles: chosen_blog.articles, section: section, filter_tag: filter_tag, limit: per_page %}
        <nav class="q-feed__nav" aria-label="Tagged articles"><a class="q-feed__page" href="{{ tagged_url | escape }}">View all {{ filter_tag | escape }} articles</a></nav>
      {%- else -%}
        {% paginate chosen_blog.articles by per_page %}
          {% render 'blog-feed-items', articles: chosen_blog.articles, section: section, filter_tag: filter_tag, limit: per_page %}
          {% if paginate.pages > 1 %}
            <div class="q-feed__nav" data-q-feed-nav>
              {% if pagination_mode == 'load_more' and paginate.next %}
                <button class="q-feed__loadmore q-btn" type="button" hidden data-q-loadmore data-next-url="{{ paginate.next.url | escape }}" aria-controls="q-feed-items-{{ sid }}">
                  <span>{{ load_more_label | escape }}</span><span class="q-feed__spinner" aria-hidden="true"></span>
                </button>
              {% endif %}
              <nav class="q-feed__pagination" aria-label="Pagination" data-q-pagination-fallback>
                {% if paginate.previous %}<a class="q-feed__page" href="{{ paginate.previous.url | escape }}">Previous</a>{% endif %}
                <span class="q-feed__pageinfo">{{ paginate.current_page }} / {{ paginate.pages }}</span>
                {% if paginate.next %}<a class="q-feed__page" href="{{ paginate.next.url | escape }}">Next</a>{% endif %}
              </nav>
            </div>
          {% endif %}
        {% endpaginate %}
      {%- endif -%}
    {%- endif -%}
  </div>

  <style>
    #QtmBlogFeed-{{ sid }} { position: relative; }
    #QtmBlogFeed-{{ sid }} .q-feed__bg { position: absolute; inset: 0; z-index: 0; }
    #QtmBlogFeed-{{ sid }} .q-feed__inner { position: relative; z-index: 1; padding-block: var(--q-pad-y, var(--q-section-pad-y, 48px)); }

    #QtmBlogFeed-{{ sid }} .q-feed__header { margin-bottom: var(--q-feed-gap); }
    #QtmBlogFeed-{{ sid }} .q-feed__eyebrow { margin: 0 0 var(--q-gap-xs, 8px); font-size: var(--q-fs-sm, 0.95rem); opacity: .85; }
    #QtmBlogFeed-{{ sid }} .q-feed__heading { margin: 0; font-size: var(--q-heading-fs, var(--q-fs-2xl, 2rem)); line-height: var(--q-heading-lh, 1.15); }
    #QtmBlogFeed-{{ sid }} .q-feed__subheading { margin-top: var(--q-gap-sm, 12px); max-width: var(--q-prose, 72ch); }
    #QtmBlogFeed-{{ sid }} .q-feed__blogtitle { margin-top: var(--q-gap-sm, 12px); display: flex; gap: var(--q-gap-sm, 12px); align-items: center; flex-wrap: wrap; }
    #QtmBlogFeed-{{ sid }} .q-feed__bloglink { text-decoration: none; }
    #QtmBlogFeed-{{ sid }} .q-feed__filterpill {
      display: inline-flex;
      align-items: center;
      padding: .25em .6em;
      border-radius: var(--q-radius-pill, 999px);
      border: 1px solid var(--q-border, rgba(0,0,0,.12));
      font-size: var(--q-fs-xs, .85rem);
    }

    /* Items base */
    #QtmBlogFeed-{{ sid }} .q-feed__items{
      display: grid;
      gap: var(--q-feed-gap);
      padding: var(--q-feed-pad); /* OUTER breathing room (you asked for this) */
    }
    #QtmBlogFeed-{{ sid }} .q-feed__item{ margin: 0; min-width: 0; } /* safety wrapper so cards can't collapse gutters */

    /* LIST */
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-feed__items { grid-template-columns: 1fr; }
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard{
      border: 0;
      border-radius: 0;
      background: transparent;
      overflow: visible;
      padding: var(--q-gap-lg, 24px) 0;
      border-bottom: 1px solid var(--q-border, rgba(0,0,0,.12));
    }
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard__media{
      display: block;
      border-radius: var(--q-radius-md, 16px);
      overflow: hidden;
      margin-bottom: var(--q-gap-md, 16px);
    }
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard__img{
      width: 100%;
      height: auto;
      display: block;
      max-height: var(--q-feed-list-img-cap);
      object-fit: cover;
    }
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard__body{
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--q-gap-sm, 12px);
    }
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard__title{
      font-size: var(--q-fs-xl, 1.35rem);
      line-height: 1.18;
    }
    #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard__excerpt{ max-width: var(--q-prose, 72ch); }

    @media (max-width: 749px){
      #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard{ padding: var(--q-gap-md, 16px) 0; }
      #QtmBlogFeed-{{ sid }}.q-feed--list .q-blogcard__img{ max-height: calc(var(--q-feed-list-img-cap) - 40px); }
    }

    /* GRID — real gutters, always */
    #QtmBlogFeed-{{ sid }}.q-feed--grid .q-feed__items{
      grid-template-columns: repeat(var(--q-feed-cols-m), minmax(0, 1fr));
      column-gap: var(--q-feed-gap);
      row-gap: var(--q-feed-gap);
    }
    @media (min-width: 750px){
      #QtmBlogFeed-{{ sid }}.q-feed--grid .q-feed__items{
        grid-template-columns: repeat(var(--q-feed-cols-t), minmax(0, 1fr));
        column-gap: var(--q-feed-gap);
        row-gap: var(--q-feed-gap);
      }
    }
    @media (min-width: 990px){
      #QtmBlogFeed-{{ sid }}.q-feed--grid .q-feed__items{
        grid-template-columns: repeat(var(--q-feed-cols-d), minmax(0, 1fr));
        column-gap: var(--q-feed-gap);
        row-gap: var(--q-feed-gap);
      }
    }

    /* Guardrails: cards cannot “eat” the gap via margins/width hacks */
    #QtmBlogFeed-{{ sid }}.q-feed--grid .q-feed__items > *{
      margin: 0 !important;
      width: auto !important;
      max-width: 100% !important;
      box-sizing: border-box;
    }

    /* Add breathing between image and content in grid */
    #QtmBlogFeed-{{ sid }}.q-feed--grid .q-blogcard__media{ margin-bottom: var(--q-gap-sm, 12px); }
    #QtmBlogFeed-{{ sid }}.q-feed--grid .q-blogcard__body{
      padding: var(--q-gap-md, 16px);
      display: flex;
      flex-direction: column;
      gap: var(--q-gap-sm, 12px);
    }

    /* MASONRY (unchanged) */
    #QtmBlogFeed-{{ sid }}.q-feed--masonry .q-feed__items{
      display: block;
      column-gap: var(--q-feed-gap);
      columns: var(--q-feed-cols-m);
      padding: var(--q-feed-pad);
    }
    #QtmBlogFeed-{{ sid }}.q-feed--masonry .q-feed__items > *{
      break-inside: avoid;
      margin: 0 0 var(--q-feed-gap);
      display: block;
    }
    @media (min-width: 750px){ #QtmBlogFeed-{{ sid }}.q-feed--masonry .q-feed__items{ columns: var(--q-feed-cols-t); } }
    @media (min-width: 990px){ #QtmBlogFeed-{{ sid }}.q-feed--masonry .q-feed__items{ columns: var(--q-feed-cols-d); } }

    /* Nav */
    #QtmBlogFeed-{{ sid }} .q-feed__nav { margin-top: var(--q-feed-gap); display: flex; justify-content: center; }
    #QtmBlogFeed-{{ sid }} .q-feed__pagination { display: inline-flex; align-items: center; gap: var(--q-gap-sm, 12px); }
    #QtmBlogFeed-{{ sid }} .q-feed__page { text-decoration: none; padding: .45em .8em; border-radius: var(--q-radius-sm, 10px); border: 1px solid var(--q-border, rgba(0,0,0,.12)); }
    #QtmBlogFeed-{{ sid }} .q-feed__pageinfo { font-size: var(--q-fs-sm, .95rem); opacity: .85; }

    #QtmBlogFeed-{{ sid }} .q-feed__loadmore { display: inline-flex; align-items: center; gap: var(--q-gap-sm, 12px); }
    #QtmBlogFeed-{{ sid }} .q-feed__spinner{
      width: 1em; height: 1em;
      border-radius: 999px;
      border: 2px solid currentColor;
      border-right-color: transparent;
      opacity: 0;
      transform: rotate(0deg);
    }
    #QtmBlogFeed-{{ sid }}.q-feed--blog.is-loading .q-feed__spinner{ opacity: .6; animation: qFeedBlogSpin 700ms linear infinite; }
    @keyframes qFeedBlogSpin { to { transform: rotate(360deg); } }

    #QtmBlogFeed-{{ sid }} .q-feed__empty { text-align: center; padding: var(--q-gap-lg, 24px) 0; }
    #QtmBlogFeed-{{ sid }} .q-feed__emptyhint { margin-top: var(--q-gap-sm, 12px); }
    #QtmBlogFeed-{{ sid }} *, #QtmBlogFeed-{{ sid }} { box-sizing: border-box; min-width: 0; overflow-wrap: anywhere; }
    #QtmBlogFeed-{{ sid }} .q-feed__nav, #QtmBlogFeed-{{ sid }} .q-feed__pagination { flex-wrap: wrap; gap: .75rem; }
    #QtmBlogFeed-{{ sid }} [hidden] { display: none; }
    #QtmBlogFeed-{{ sid }} :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
    @media (prefers-reduced-motion: reduce) { #QtmBlogFeed-{{ sid }} .q-feed__spinner { animation: none; } }
  </style>
</section>
{% endif %}

{% schema %}
{
  "name": "Feeds - Blog List / Grid",
  "tag": "section",
  "class": "section q-section q-section--feed-blog",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog source",
      "info": "Uses the current blog on blog/article pages when unselected. Choose a source on other pages."
    },
    {
      "type": "text",
      "id": "filter_tag",
      "label": "Optional tag filter",
      "info": "Shows matching articles from the available preview (up to 50 articles), with a link to the complete tagged archive. Leave blank for native pagination."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Posts per page",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "checkbox",
      "id": "show_blog_title",
      "label": "Show blog title link",
      "default": true
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Display mode",
      "default": "list",
      "options": [
        { "value": "list", "label": "List" },
        { "value": "grid", "label": "Grid" },
        { "value": "masonry", "label": "Masonry" }
      ]
    },
    {
      "type": "select",
      "id": "gap_token",
      "label": "Gap spacing",
      "default": "md",
      "options": [
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" },
        { "value": "lg", "label": "LG" },
        { "value": "xl", "label": "XL" }
      ]
    },
    {
      "type": "select",
      "id": "pad_token",
      "label": "Outer padding",
      "default": "lg",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" },
        { "value": "lg", "label": "LG" },
        { "value": "xl", "label": "XL" }
      ]
    },
    {
      "type": "range",
      "id": "cols_mobile",
      "label": "Columns (mobile) — Grid & Masonry",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "cols_tablet",
      "label": "Columns (tablet) — Grid & Masonry",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (desktop) — Grid & Masonry",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },

    { "type": "header", "content": "Card content" },
    { "type": "checkbox", "id": "show_image", "label": "Show featured image", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": true },
    { "type": "checkbox", "id": "show_read_time", "label": "Show estimated read time", "default": true },
    { "type": "checkbox", "id": "show_tags", "label": "Show tags / categories", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    {
      "type": "select",
      "id": "excerpt_mode",
      "label": "Excerpt length mode",
      "default": "words",
      "options": [
        { "value": "words", "label": "Words" },
        { "value": "chars", "label": "Characters" }
      ]
    },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt words", "min": 8, "max": 60, "step": 1, "default": 24 },
    { "type": "range", "id": "excerpt_chars", "label": "Excerpt characters", "min": 80, "max": 320, "step": 10, "default": 160 },
    { "type": "text", "id": "cta_label", "label": "Card CTA label", "default": "Read more" },

    { "type": "range", "id": "list_image_cap", "label": "List image max height (px)", "min": 140, "max": 420, "step": 10, "default": 240 },

    { "type": "header", "content": "Pagination" },
    {
      "type": "select",
      "id": "pagination_mode",
      "label": "Pagination mode",
      "default": "standard",
      "options": [
        { "value": "standard", "label": "Standard pagination (links)" },
        { "value": "load_more", "label": "Load more button (progressive enhancement)" }
      ]
    },
    { "type": "text", "id": "load_more_label", "label": "Load more button label", "default": "Load more" },

    { "type": "header", "content": "Root background" },
    {
      "type": "select",
      "id": "bg_mode",
      "label": "Background",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "surface", "label": "Surface" },
        { "value": "contrast", "label": "Contrast surface" }
      ]
    }
  ],
  "presets": [
    { "name": "Feeds - Blog List / Grid", "category": "Content Feeds" }
  ]
}
{% endschema %}
