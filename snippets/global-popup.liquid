{%- liquid
  assign qtm_popup_should_render = false

  if settings.popup_enable
    assign qtm_popup_should_render = true
  endif

  if request.design_mode and settings.popup_editor_preview
    assign qtm_popup_should_render = true
  endif

  assign popup_placement = settings.popup_placement | default: 'center'
  assign popup_animation = settings.popup_animation | default: 'fade'
  assign popup_type = settings.popup_type | default: 'newsletter'
  assign popup_trigger = settings.popup_trigger | default: 'delay'
  assign popup_frequency = settings.popup_frequency | default: 'once_per_session'
  assign popup_delay = settings.popup_delay_seconds | default: 1
  assign popup_scroll = settings.popup_scroll_percent | default: 45
-%}

{%- if qtm_popup_should_render -%}

<style>
  .qtm-popup,
  .qtm-popup *,
  .qtm-popup *::before,
  .qtm-popup *::after {
    box-sizing: border-box;
  }

  .qtm-popup {
    position: fixed !important;
    inset: 0 !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    margin: 0 !important;
    padding: 24px !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: transparent;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  .qtm-popup[hidden] {
    display: none !important;
  }

  .qtm-popup.is-visible {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .qtm-popup--center,
  .qtm-popup--top,
  .qtm-popup--bottom,
  .qtm-popup--left,
  .qtm-popup--right {
    align-items: center !important;
    justify-content: center !important;
  }

  .qtm-popup__overlay {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    width: 100% !important;
    height: 100% !important;
    border: 0 !important;
    background:
      radial-gradient(circle at center, rgba(255,255,255,.08), transparent 34%),
      rgba(10, 12, 18, .66) !important;
    cursor: pointer;
    appearance: none;
  }

  .qtm-popup__dialog {
    position: relative !important;
    z-index: 2 !important;
    display: grid !important;
    grid-template-columns: minmax(260px, .85fr) minmax(340px, 1fr);
    width: min(840px, calc(100vw - 48px)) !important;
    max-width: 840px !important;
    max-height: calc(100vh - 48px) !important;
    max-height: calc(100dvh - 48px) !important;
    margin: auto !important;
    overflow: hidden !important;
    border: 1px solid rgba(255, 255, 255, .26);
    border-radius: 28px;
    background: #ffffff;
    color: #111111;
    box-shadow:
      0 34px 100px rgba(0, 0, 0, .34),
      0 1px 0 rgba(255, 255, 255, .4) inset;
    transform: translateY(12px) scale(.985);
    transition: transform 220ms ease;
  }

  .qtm-popup.is-visible .qtm-popup__dialog {
    transform: translateY(0) scale(1);
  }

  .qtm-popup__dialog--no-image {
    grid-template-columns: 1fr !important;
    width: min(560px, calc(100vw - 48px)) !important;
    max-width: 560px !important;
  }

  .qtm-popup__close {
    position: absolute !important;
    top: 14px !important;
    right: 14px !important;
    z-index: 5 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 36px !important;
    height: 36px !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 1px solid rgba(17, 17, 17, .10) !important;
    border-radius: 999px !important;
    background: rgba(255, 255, 255, .86) !important;
    color: #111111 !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    cursor: pointer;
    appearance: none;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, .10);
    transition: background 180ms ease, transform 180ms ease;
  }

  .qtm-popup__close:hover {
    background: #ffffff !important;
    transform: scale(1.04);
  }

  .qtm-popup__media {
    position: relative;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    background: #f4f1eb;
  }

  .qtm-popup__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 62%, rgba(255,255,255,.22));
    pointer-events: none;
  }

  .qtm-popup__image {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 520px;
    object-fit: cover;
  }

  .qtm-popup__content {
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    min-width: 0;
    padding: 54px 44px 46px;
    background:
      linear-gradient(135deg, rgba(248, 250, 252, .9), #ffffff 42%);
    color: #111111;
  }

  .qtm-popup__eyebrow {
    margin: 0 0 2px;
    color: rgba(17, 17, 17, .52);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .qtm-popup__heading {
    margin: 0;
    max-width: 10ch;
    color: inherit;
    font-size: clamp(34px, 4.2vw, 48px);
    font-weight: 850;
    line-height: .96;
    letter-spacing: -.055em;
  }

  .qtm-popup__text {
    margin: 0;
    max-width: 36ch;
    color: rgba(17, 17, 17, .66);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .qtm-popup__text p {
    margin: 0;
  }

  .qtm-popup__text p + p {
    margin-top: 10px;
  }

  .qtm-popup__newsletter {
    display: grid;
    gap: 10px;
    margin: 6px 0 0;
  }

  .qtm-popup__newsletter-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border: 1px solid rgba(17, 17, 17, .12);
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
  }

  .qtm-popup__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .qtm-popup__input {
    width: 100%;
    min-width: 0;
    height: 44px;
    margin: 0;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #111111;
    font-size: 15px;
    line-height: 1;
    box-shadow: none;
    outline: none;
  }

  .qtm-popup__input::placeholder {
    color: rgba(17, 17, 17, .42);
  }

  .qtm-popup__submit {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 0;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    appearance: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  .qtm-popup__submit:hover {
    transform: translateY(-1px);
    background: #000000;
  }

  .qtm-popup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .qtm-popup__button {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin: 0;
    padding: 0 18px;
    border: 1px solid #111111;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    appearance: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .qtm-popup__button:hover {
    transform: translateY(-1px);
  }

  .qtm-popup__button--secondary {
    border-color: rgba(17, 17, 17, .14);
    background: rgba(17, 17, 17, .04);
    color: #111111;
  }

  .qtm-popup__button--secondary:hover {
    border-color: rgba(17, 17, 17, .22);
    background: rgba(17, 17, 17, .07);
  }

  .qtm-popup__message {
    margin: 0;
    color: rgba(17, 17, 17, .66);
    font-size: 14px;
    line-height: 1.4;
  }

  .qtm-popup__message--success {
    color: #047857;
  }

  body.qtm-popup-open,
  html.qtm-popup-open {
    overflow: hidden !important;
  }

  @media (max-width: 989px) {
    .qtm-popup__dialog {
      grid-template-columns: minmax(220px, .82fr) minmax(320px, 1fr);
      width: min(780px, calc(100vw - 40px)) !important;
      max-height: calc(100vh - 40px) !important;
      max-height: calc(100dvh - 40px) !important;
    }

    .qtm-popup__image {
      min-height: 500px;
    }

    .qtm-popup__content {
      padding: 46px 34px 40px;
    }

    .qtm-popup__heading {
      font-size: clamp(31px, 4.5vw, 42px);
    }
  }

  @media (max-width: 749px) {
    .qtm-popup {
      align-items: center !important;
      justify-content: center !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      padding: 16px !important;
    }

    .qtm-popup__dialog,
    .qtm-popup__dialog--no-image {
      width: min(100%, calc(100vw - 32px)) !important;
      max-width: none !important;
      max-height: calc(100vh - 32px) !important;
      max-height: calc(100dvh - 32px) !important;
      grid-template-columns: 1fr !important;
      overflow-y: auto !important;
      border-radius: 24px;
    }

    .qtm-popup__media {
      max-height: 260px;
    }

    .qtm-popup__image {
      min-height: 240px;
      max-height: 260px;
    }

    .qtm-popup__content {
      padding: 34px 24px 26px;
    }

    .qtm-popup__heading {
      max-width: 12ch;
      font-size: clamp(31px, 8vw, 40px);
    }

    .qtm-popup__text {
      max-width: none;
    }

    .qtm-popup__newsletter-row {
      grid-template-columns: 1fr;
      padding: 8px;
      border-radius: 22px;
    }

    .qtm-popup__input {
      height: 42px;
    }

    .qtm-popup__submit {
      width: 100%;
      min-height: 44px;
    }

    .qtm-popup__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .qtm-popup__button {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .qtm-popup {
      padding: 12px !important;
    }

    .qtm-popup__dialog,
    .qtm-popup__dialog--no-image {
      width: calc(100vw - 24px) !important;
      max-height: calc(100vh - 24px) !important;
      max-height: calc(100dvh - 24px) !important;
      border-radius: 22px;
    }

    .qtm-popup__content {
      padding: 30px 20px 24px;
    }

    .qtm-popup__close {
      top: 10px !important;
      right: 10px !important;
      width: 34px !important;
      height: 34px !important;
      font-size: 22px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-popup,
    .qtm-popup__dialog,
    .qtm-popup__submit,
    .qtm-popup__button {
      transition-duration: .01ms !important;
    }
  }

  /* ==========================================================
   QUADRATUM POPUP SAFE MODERN CARD OVERRIDE
   Put at the VERY BOTTOM of snippets/global-popup.liquid
   right before </style>
   ========================================================== */

#QuadratumGlobalPopup.qtm-popup,
#QuadratumGlobalPopup.qtm-popup.qtm-popup--center,
#QuadratumGlobalPopup.qtm-popup.qtm-popup--top,
#QuadratumGlobalPopup.qtm-popup.qtm-popup--bottom,
#QuadratumGlobalPopup.qtm-popup.qtm-popup--left,
#QuadratumGlobalPopup.qtm-popup.qtm-popup--right {
  position: fixed !important;
  inset: 0 !important;
  z-index: 999999 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 100vw !important;
  max-width: 100vw !important;
  height: 100vh !important;
  height: 100dvh !important;

  margin: 0 !important;
  padding: 24px !important;

  overflow: hidden !important;
  transform: none !important;
}

#QuadratumGlobalPopup .qtm-popup__dialog,
#QuadratumGlobalPopup .qtm-popup__dialog.qtm-popup__dialog--no-image {
  position: relative !important;
  inset: auto !important;

  display: grid !important;
  grid-template-columns: 1fr !important;

  width: min(680px, calc(100vw - 48px)) !important;
  max-width: 680px !important;
  min-width: 0 !important;

  height: auto !important;
  max-height: calc(100vh - 48px) !important;
  max-height: calc(100dvh - 48px) !important;

  margin: auto !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;

  border-radius: 28px !important;
  background: #ffffff !important;
  transform: none !important;
}

#QuadratumGlobalPopup .qtm-popup__media {
  width: 100% !important;
  height: auto !important;
  max-height: 280px !important;
  min-height: 0 !important;
  overflow: hidden !important;
}

#QuadratumGlobalPopup .qtm-popup__image {
  display: block !important;
  width: 100% !important;
  height: 280px !important;
  min-height: 0 !important;
  max-height: 280px !important;
  object-fit: cover !important;
  object-position: center !important;
}

#QuadratumGlobalPopup .qtm-popup__content {
  width: 100% !important;
  min-width: 0 !important;
  padding: 32px 34px 34px !important;
}

#QuadratumGlobalPopup .qtm-popup__heading {
  max-width: none !important;
  font-size: clamp(30px, 5vw, 44px) !important;
  line-height: 1 !important;
}

#QuadratumGlobalPopup .qtm-popup__text {
  max-width: 54ch !important;
}

#QuadratumGlobalPopup .qtm-popup__newsletter-row {
  width: 100% !important;
  max-width: 100% !important;
}

#QuadratumGlobalPopup .qtm-popup__actions {
  width: 100% !important;
}

@media (max-width: 749px) {
  #QuadratumGlobalPopup.qtm-popup {
    padding: 14px !important;
  }

  #QuadratumGlobalPopup .qtm-popup__dialog,
  #QuadratumGlobalPopup .qtm-popup__dialog.qtm-popup__dialog--no-image {
    width: calc(100vw - 28px) !important;
    max-width: calc(100vw - 28px) !important;
    max-height: calc(100vh - 28px) !important;
    max-height: calc(100dvh - 28px) !important;
    border-radius: 22px !important;
  }

  #QuadratumGlobalPopup .qtm-popup__media {
    max-height: 220px !important;
  }

  #QuadratumGlobalPopup .qtm-popup__image {
    height: 220px !important;
    max-height: 220px !important;
  }

  #QuadratumGlobalPopup .qtm-popup__content {
    padding: 28px 22px 24px !important;
  }

  #QuadratumGlobalPopup .qtm-popup__newsletter-row {
    grid-template-columns: 1fr !important;
    border-radius: 22px !important;
  }

  #QuadratumGlobalPopup .qtm-popup__submit,
  #QuadratumGlobalPopup .qtm-popup__button {
    width: 100% !important;
  }

  #QuadratumGlobalPopup .qtm-popup__actions {
    display: grid !important;
    grid-template-columns: 1fr !important;
  }
}
</style>

  <div
    id="QuadratumGlobalPopup"
    class="qtm-popup qtm-popup--{{ popup_placement }} qtm-popup--{{ popup_animation }}"
    data-qtm-popup
    data-popup-enabled="{{ settings.popup_enable }}"
    data-popup-type="{{ popup_type }}"
    data-popup-trigger="{{ popup_trigger }}"
    data-popup-frequency="{{ popup_frequency }}"
    data-popup-delay="{{ popup_delay }}"
    data-popup-scroll="{{ popup_scroll }}"
    data-popup-mobile="{{ settings.popup_show_on_mobile }}"
    data-popup-desktop="{{ settings.popup_show_on_desktop }}"
    data-popup-overlay-close="{{ settings.popup_overlay_click_close }}"
    data-popup-editor-preview="{{ settings.popup_editor_preview }}"
    hidden
    aria-hidden="true"
  >
    <button class="qtm-popup__overlay" type="button" data-qtm-popup-overlay aria-label="Close popup"></button>

    <div
      class="qtm-popup__dialog{% if settings.popup_image == blank %} qtm-popup__dialog--no-image{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="QuadratumGlobalPopupHeading"
      tabindex="-1"
      data-qtm-popup-dialog
    >
      <button class="qtm-popup__close" type="button" data-qtm-popup-close aria-label="Close popup">
        <span aria-hidden="true">&times;</span>
      </button>

      {%- if settings.popup_image != blank -%}
        <div class="qtm-popup__media">
          <img
            class="qtm-popup__image"
            src="{{ settings.popup_image | image_url: width: 1200 }}"
            alt="{{ settings.popup_heading | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="qtm-popup__content">
        {%- if settings.popup_eyebrow != blank -%}
          <p class="qtm-popup__eyebrow">{{ settings.popup_eyebrow }}</p>
        {%- endif -%}

        {%- if settings.popup_heading != blank -%}
          <h2 id="QuadratumGlobalPopupHeading" class="qtm-popup__heading">
            {{ settings.popup_heading }}
          </h2>
        {%- else -%}
          <h2 id="QuadratumGlobalPopupHeading" class="qtm-popup__heading">
            Stay in the loop
          </h2>
        {%- endif -%}

        {%- if settings.popup_text != blank -%}
          <div class="qtm-popup__text">
            {{ settings.popup_text }}
          </div>
        {%- endif -%}

        {%- if settings.popup_show_newsletter_form -%}
          {% form 'customer', class: 'qtm-popup__newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">

            <div class="qtm-popup__newsletter-row">
              <label class="qtm-popup__label" for="QuadratumPopupEmail">
                Email address
              </label>

              <input
                id="QuadratumPopupEmail"
                class="qtm-popup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ settings.popup_newsletter_placeholder | default: 'Email address' | escape }}"
                aria-label="{{ settings.popup_newsletter_placeholder | default: 'Email address' | escape }}"
                required
              >

              <button class="qtm-popup__submit" type="submit">
                {{ settings.popup_newsletter_button_label | default: 'Subscribe' }}
              </button>
            </div>

            {%- if form.posted_successfully? -%}
              <p class="qtm-popup__message qtm-popup__message--success" tabindex="-1">
                Thanks for subscribing.
              </p>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="qtm-popup__message">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {% endform %}
        {%- endif -%}

        {%- if settings.popup_button_label != blank or settings.popup_secondary_label != blank -%}
          <div class="qtm-popup__actions">
            {%- if settings.popup_button_label != blank and settings.popup_button_url != blank -%}
              <a class="qtm-popup__button" href="{{ settings.popup_button_url }}">
                {{ settings.popup_button_label }}
              </a>
            {%- endif -%}

            {%- if settings.popup_secondary_label != blank -%}
              {%- if settings.popup_secondary_url != blank -%}
                <a class="qtm-popup__button qtm-popup__button--secondary" href="{{ settings.popup_secondary_url }}">
                  {{ settings.popup_secondary_label }}
                </a>
              {%- else -%}
                <button class="qtm-popup__button qtm-popup__button--secondary" type="button" data-qtm-popup-close>
                  {{ settings.popup_secondary_label }}
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}