{%- assign locations = variant.store_availabilities | where: 'pick_up_enabled', true -%}
<div data-pickup-content>
  {% if locations.size > 0 %}
    {% assign nearest = locations.first %}
    <p class="q-pickup__summary">{% if nearest.available %}{{ 'products.services.pickup_available' | t }}{% else %}{{ 'products.services.pickup_unavailable' | t }}{% endif %} — {{ nearest.location.name | escape }}</p>
    {% if nearest.available %}<p>{{ nearest.pick_up_time | escape }}</p>{% endif %}
    <details class="q-pickup__details">
      <summary>{{ 'products.services.location_details' | t }}</summary>
      <ul role="list">
        {% for location in locations %}
          <li><strong>{{ location.location.name | escape }}</strong>
            <p>{% if location.available %}{{ 'products.services.pickup_available' | t }} — {{ location.pick_up_time | escape }}{% else %}{{ 'products.services.pickup_unavailable' | t }}{% endif %}</p>
            {{ location.location.address | format_address }}
            {% if location.location.address.phone != blank %}<p>{{ location.location.address.phone | escape }}</p>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</div>
