{%- liquid
  assign block_id = 'product-variant-picker-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign picker_style = block.settings.picker_style | default: 'pills'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{% unless product_context.has_only_default_variant %}
  <div
    id="{{ block_id }}"
    class="
      product-variant-picker
      product-variant-picker--{{ picker_style }}
      product-variant-picker--width-{{ width }}
      product-variant-picker--align-{{ alignment }}
      {% unless show_on_desktop %} product-variant-picker--hide-desktop{% endunless %}
      {% unless show_on_tablet %} product-variant-picker--hide-tablet{% endunless %}
      {% unless show_on_mobile %} product-variant-picker--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' %} product-variant-picker--animate product-variant-picker--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-variant-picker-margin-top: {{ block.settings.margin_top }}px;
      --product-variant-picker-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-variant-picker-padding: {{ block.settings.padding }}px;
      --product-variant-picker-gap: {{ block.settings.gap }}px;
      --product-variant-picker-option-gap: {{ block.settings.option_gap }}px;
      --product-variant-picker-button-gap: {{ block.settings.button_gap }}px;
      --product-variant-picker-border-width: {{ block.settings.border_width }}px;
      --product-variant-picker-border-radius: {{ block.settings.border_radius }}px;
      --product-variant-picker-swatch-size: {{ block.settings.swatch_size }}px;
      --product-variant-picker-heading-color: {{ block.settings.heading_color }};
      --product-variant-picker-text-color: {{ block.settings.text_color }};
      --product-variant-picker-background-color: {{ block.settings.background_color }};
      --product-variant-picker-border-color: {{ block.settings.border_color }};
      --product-variant-picker-active-background: {{ block.settings.active_background_color }};
      --product-variant-picker-active-text: {{ block.settings.active_text_color }};
      --product-variant-picker-active-border: {{ block.settings.active_border_color }};
      --product-variant-picker-disabled-opacity: {{ block.settings.disabled_opacity | divided_by: 100.0 }};
    "
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-product-variant-picker
    {{ block.shopify_attributes }}
  >
    <style>
      #{{ block_id }} {
        width: 100%;
        margin-top: var(--product-variant-picker-margin-top);
        margin-bottom: var(--product-variant-picker-margin-bottom);
        padding: var(--product-variant-picker-padding);
        color: var(--product-variant-picker-text-color);
        background: transparent;
      }

      #{{ block_id }}.product-variant-picker--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-variant-picker--width-small {
        max-width: 640px;
      }

      #{{ block_id }}.product-variant-picker--width-medium {
        max-width: 820px;
      }

      #{{ block_id }}.product-variant-picker--width-large {
        max-width: 1040px;
      }

      #{{ block_id }}.product-variant-picker--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-variant-picker--align-left {
        margin-left: 0;
        margin-right: auto;
        text-align: left;
      }

      #{{ block_id }}.product-variant-picker--align-center {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      #{{ block_id }}.product-variant-picker--align-right {
        margin-left: auto;
        margin-right: 0;
        text-align: right;
      }

      #{{ block_id }} .product-variant-picker__inner {
        display: grid;
        gap: var(--product-variant-picker-gap);
        min-width: 0;
      }

      #{{ block_id }} .product-variant-picker__option {
        display: grid;
        gap: var(--product-variant-picker-option-gap);
        min-width: 0;
      }

      #{{ block_id }} .product-variant-picker__label-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
      }

      #{{ block_id }}.product-variant-picker--align-center .product-variant-picker__label-row {
        justify-content: center;
      }

      #{{ block_id }}.product-variant-picker--align-right .product-variant-picker__label-row {
        justify-content: flex-end;
      }

      #{{ block_id }} .product-variant-picker__label {
        margin: 0;
        color: var(--product-variant-picker-heading-color);
        line-height: 1.25;
        font-size: 0.94em;
      }

      #{{ block_id }} .product-variant-picker__selected-value {
        color: var(--product-variant-picker-text-color);
        line-height: 1.25;
        font-size: 0.9em;
        opacity: 0.78;
      }

      #{{ block_id }} .product-variant-picker__select {
        width: 100%;
        min-height: 46px;
        padding: 0 38px 0 12px;
        color: var(--product-variant-picker-heading-color);
        background: var(--product-variant-picker-background-color);
        border: var(--product-variant-picker-border-width) solid var(--product-variant-picker-border-color);
        border-radius: var(--product-variant-picker-border-radius);
      }

      #{{ block_id }} .product-variant-picker__select:focus-visible {
        outline: 2px solid var(--product-variant-picker-active-border);
        outline-offset: 2px;
      }

      #{{ block_id }} .product-variant-picker__values {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--product-variant-picker-button-gap);
        min-width: 0;
      }

      #{{ block_id }}.product-variant-picker--align-center .product-variant-picker__values {
        justify-content: center;
      }

      #{{ block_id }}.product-variant-picker--align-right .product-variant-picker__values {
        justify-content: flex-end;
      }

      #{{ block_id }} .product-variant-picker__button {
        appearance: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        min-width: 42px;
        padding: 10px 14px;
        color: var(--product-variant-picker-text-color);
        background: var(--product-variant-picker-background-color);
        border: var(--product-variant-picker-border-width) solid var(--product-variant-picker-border-color);
        border-radius: var(--product-variant-picker-border-radius);
        cursor: pointer;
        line-height: 1.2;
        text-align: center;
        transition: border-color 180ms ease, background 180ms ease, color 180ms ease, opacity 180ms ease, transform 180ms ease;
      }

      #{{ block_id }}.product-variant-picker--buttons .product-variant-picker__button {
        border-radius: max(calc(var(--product-variant-picker-border-radius) - 8px), 6px);
      }

      #{{ block_id }}.product-variant-picker--pills .product-variant-picker__button {
        border-radius: 999px;
      }

      #{{ block_id }} .product-variant-picker__button:hover {
        border-color: var(--product-variant-picker-active-border);
        transform: translateY(-1px);
      }

      #{{ block_id }} .product-variant-picker__button:focus-visible {
        outline: 2px solid var(--product-variant-picker-active-border);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-variant-picker__button.is-active {
        color: var(--product-variant-picker-active-text);
        background: var(--product-variant-picker-active-background);
        border-color: var(--product-variant-picker-active-border);
      }

      #{{ block_id }} .product-variant-picker__button.is-unavailable {
        opacity: var(--product-variant-picker-disabled-opacity);
      }

      #{{ block_id }} .product-variant-picker__button.is-unavailable .product-variant-picker__button-text {
        text-decoration: line-through;
      }

      #{{ block_id }} .product-variant-picker__swatch {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--product-variant-picker-swatch-size);
        height: var(--product-variant-picker-swatch-size);
        padding: 3px;
        border-radius: 999px;
      }

      #{{ block_id }}.product-variant-picker--swatches .product-variant-picker__button {
        min-width: auto;
        min-height: auto;
        padding: 3px;
        border-radius: 999px;
      }

      #{{ block_id }} .product-variant-picker__swatch-color {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 999px;
        background: var(--swatch-color, #d8d8d8);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
      }

      #{{ block_id }} .product-variant-picker__swatch-label {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }

      #{{ block_id }} .product-variant-picker__status {
        min-height: 1.3em;
        color: var(--product-variant-picker-text-color);
        font-size: 0.9em;
        line-height: 1.35;
        opacity: 0.84;
      }

      #{{ block_id }}.product-variant-picker--dropdown .product-variant-picker__values,
      #{{ block_id }}.product-variant-picker--buttons .product-variant-picker__select,
      #{{ block_id }}.product-variant-picker--pills .product-variant-picker__select,
      #{{ block_id }}.product-variant-picker--swatches .product-variant-picker__select {
        display: none;
      }

      #{{ block_id }}.product-variant-picker--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-variant-picker--animate-fade {
        animation-name: productVariantPickerFade;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_up {
        animation-name: productVariantPickerFadeUp;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_down {
        animation-name: productVariantPickerFadeDown;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_left {
        animation-name: productVariantPickerFadeLeft;
      }

      #{{ block_id }}.product-variant-picker--animate-fade_right {
        animation-name: productVariantPickerFadeRight;
      }

      #{{ block_id }}.product-variant-picker--animate-zoom {
        animation-name: productVariantPickerZoom;
      }

      @keyframes productVariantPickerFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productVariantPickerFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productVariantPickerFadeDown {
        from {
          opacity: 0;
          transform: translateY(-20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productVariantPickerFadeLeft {
        from {
          opacity: 0;
          transform: translateX(20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productVariantPickerFadeRight {
        from {
          opacity: 0;
          transform: translateX(-20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productVariantPickerZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-variant-picker--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-variant-picker--hide-tablet {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }}.product-variant-picker--hide-mobile {
          display: none !important;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-variant-picker--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }

        #{{ block_id }} .product-variant-picker__button {
          transition: none;
        }

        #{{ block_id }} .product-variant-picker__button:hover {
          transform: none;
        }
      }
    </style>

    <div class="product-variant-picker__inner">
      {% for option in product_context.options_with_values %}
        <fieldset class="product-variant-picker__option" data-product-variant-option data-option-position="{{ option.position }}">
          <div class="product-variant-picker__label-row">
            <legend class="product-variant-picker__label">
              {{ option.name | escape }}
            </legend>

            {% if block.settings.show_selected_value %}
              <span class="product-variant-picker__selected-value" data-product-variant-selected-value>
                {{ option.selected_value | escape }}
              </span>
            {% endif %}
          </div>

          <select
            class="product-variant-picker__select"
            data-product-variant-select
            data-option-position="{{ option.position }}"
            aria-label="{{ option.name | escape }}"
          >
            {% for value in option.values %}
              <option
                value="{{ value | escape }}"
                {% if option.selected_value == value %}selected{% endif %}
              >
                {{ value | escape }}
              </option>
            {% endfor %}
          </select>

          <div class="product-variant-picker__values" role="radiogroup" aria-label="{{ option.name | escape }}">
            {% for value in option.values %}
              {%- liquid
                assign value_handle = value | handle
                assign swatch_color = value_handle

                if value_handle == 'white'
                  assign swatch_color = '#ffffff'
                elsif value_handle == 'black'
                  assign swatch_color = '#000000'
                elsif value_handle == 'gray' or value_handle == 'grey'
                  assign swatch_color = '#808080'
                elsif value_handle == 'silver'
                  assign swatch_color = '#c0c0c0'
                elsif value_handle == 'gold'
                  assign swatch_color = '#d4af37'
                elsif value_handle == 'red'
                  assign swatch_color = '#d92d20'
                elsif value_handle == 'orange'
                  assign swatch_color = '#f97316'
                elsif value_handle == 'yellow'
                  assign swatch_color = '#facc15'
                elsif value_handle == 'green'
                  assign swatch_color = '#16a34a'
                elsif value_handle == 'blue'
                  assign swatch_color = '#2563eb'
                elsif value_handle == 'purple'
                  assign swatch_color = '#7c3aed'
                elsif value_handle == 'pink'
                  assign swatch_color = '#ec4899'
                elsif value_handle == 'brown'
                  assign swatch_color = '#92400e'
                endif
              -%}

              <button
                type="button"
                class="product-variant-picker__button {% if option.selected_value == value %}is-active{% endif %}"
                data-product-variant-value
                data-option-position="{{ option.position }}"
                data-option-value="{{ value | escape }}"
                aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
              >
                {% if picker_style == 'swatches' %}
                  <span class="product-variant-picker__swatch" aria-hidden="true">
                    <span class="product-variant-picker__swatch-color" style="--swatch-color: {{ swatch_color }};"></span>
                  </span>
                  <span class="product-variant-picker__swatch-label">
                    {{ value | escape }}
                  </span>
                {% else %}
                  <span class="product-variant-picker__button-text">
                    {{ value | escape }}
                  </span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </fieldset>
      {% endfor %}

      {% if block.settings.show_status %}
        <div class="product-variant-picker__status" data-product-variant-status aria-live="polite">
          {% if current_variant.available %}
            {{ block.settings.available_text | escape }}
          {% else %}
            {{ block.settings.sold_out_text | escape }}
          {% endif %}
        </div>
      {% endif %}
    </div>

    <script type="application/json" data-product-variant-picker-variants>
      {{ product_context.variants | json }}
    </script>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productVariantPickerReady === 'true') return;

        root.dataset.productVariantPickerReady = 'true';

        const variantsJson = root.querySelector('[data-product-variant-picker-variants]');
        const optionGroups = Array.from(root.querySelectorAll('[data-product-variant-option]'));
        const selects = Array.from(root.querySelectorAll('[data-product-variant-select]'));
        const buttons = Array.from(root.querySelectorAll('[data-product-variant-value]'));
        const statusEl = root.querySelector('[data-product-variant-status]');

        if (!variantsJson) return;

        let variants = [];

        try {
          variants = JSON.parse(variantsJson.textContent || '[]');
        } catch (error) {
          variants = [];
        }

        const availableText = {{ block.settings.available_text | json }};
        const soldOutText = {{ block.settings.sold_out_text | json }};
        const unavailableText = {{ block.settings.unavailable_text | json }};

        const getSelectedOptions = () => {
          return optionGroups.map((group) => {
            const activeButton = group.querySelector('[data-product-variant-value].is-active');
            const select = group.querySelector('[data-product-variant-select]');

            if (activeButton) return activeButton.dataset.optionValue;
            if (select) return select.value;

            return '';
          });
        };

        const findVariant = (selectedOptions) => {
          return variants.find((variant) => {
            return selectedOptions.every((value, index) => variant.options[index] === value);
          });
        };

        const optionValueHasVariant = (optionPosition, value) => {
          const selectedOptions = getSelectedOptions();
          selectedOptions[optionPosition - 1] = value;

          return variants.some((variant) => {
            return selectedOptions.every((selectedValue, index) => {
              if (!selectedValue) return true;
              return variant.options[index] === selectedValue;
            });
          });
        };

        const optionValueHasAvailableVariant = (optionPosition, value) => {
          const selectedOptions = getSelectedOptions();
          selectedOptions[optionPosition - 1] = value;

          return variants.some((variant) => {
            if (!variant.available) return false;

            return selectedOptions.every((selectedValue, index) => {
              if (!selectedValue) return true;
              return variant.options[index] === selectedValue;
            });
          });
        };

        const dispatchVariantChange = (variant) => {
          if (!variant) return;

          root.dataset.variantId = String(variant.id);

          document.dispatchEvent(new CustomEvent('variant:change', {
            bubbles: true,
            detail: {
              productId: {{ product_context.id | json }},
              variantId: Number(variant.id),
              variant
            }
          }));

          document.dispatchEvent(new CustomEvent('qtm:variant:change', {
            bubbles: true,
            detail: {
              productId: {{ product_context.id | json }},
              variantId: Number(variant.id),
              variant
            }
          }));
        };

        const updateUi = () => {
          const selectedOptions = getSelectedOptions();
          const variant = findVariant(selectedOptions);

          optionGroups.forEach((group) => {
            const optionPosition = Number(group.dataset.optionPosition);
            const selectedValueEl = group.querySelector('[data-product-variant-selected-value]');
            const select = group.querySelector('[data-product-variant-select]');

            if (selectedValueEl) {
              selectedValueEl.textContent = selectedOptions[optionPosition - 1] || '';
            }

            if (select && select.value !== selectedOptions[optionPosition - 1]) {
              select.value = selectedOptions[optionPosition - 1] || select.value;
            }

            group.querySelectorAll('[data-product-variant-value]').forEach((button) => {
              const value = button.dataset.optionValue;
              const hasVariant = optionValueHasVariant(optionPosition, value);
              const hasAvailableVariant = optionValueHasAvailableVariant(optionPosition, value);
              const isActive = selectedOptions[optionPosition - 1] === value;

              button.classList.toggle('is-active', isActive);
              button.classList.toggle('is-unavailable', !hasAvailableVariant);
              button.disabled = !hasVariant;
              button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
          });

          if (statusEl) {
            if (!variant) {
              statusEl.textContent = unavailableText;
            } else if (variant.available) {
              statusEl.textContent = availableText;
            } else {
              statusEl.textContent = soldOutText;
            }
          }

          dispatchVariantChange(variant);
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            if (button.disabled) return;

            const group = button.closest('[data-product-variant-option]');

            if (!group) return;

            group.querySelectorAll('[data-product-variant-value]').forEach((item) => {
              item.classList.remove('is-active');
              item.setAttribute('aria-pressed', 'false');
            });

            button.classList.add('is-active');
            button.setAttribute('aria-pressed', 'true');

            const select = group.querySelector('[data-product-variant-select]');

            if (select) {
              select.value = button.dataset.optionValue;
            }

            updateUi();
          });
        });

        selects.forEach((select) => {
          select.addEventListener('change', () => {
            const group = select.closest('[data-product-variant-option]');

            if (!group) return;

            group.querySelectorAll('[data-product-variant-value]').forEach((button) => {
              const isActive = button.dataset.optionValue === select.value;
              button.classList.toggle('is-active', isActive);
              button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });

            updateUi();
          });
        });

        document.addEventListener('variant:change', (event) => {
          const detail = event.detail || {};
          const variant = detail.variant;

          if (!variant || !Array.isArray(variant.options)) return;
          if (String(detail.productId) !== String({{ product_context.id | json }})) return;
          if (String(variant.id) === String(root.dataset.variantId)) return;

          optionGroups.forEach((group, index) => {
            const value = variant.options[index];
            const select = group.querySelector('[data-product-variant-select]');

            if (select) select.value = value;

            group.querySelectorAll('[data-product-variant-value]').forEach((button) => {
              const isActive = button.dataset.optionValue === value;
              button.classList.toggle('is-active', isActive);
              button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
          });

          updateUi();
        });

        updateUi();
      })();
    </script>
  </div>
{% endunless %}

{% schema %}
{
  "name": "Product variant picker",
  "settings": [
    {
      "type": "header",
      "content": "Variant picker"
    },
    {
      "type": "select",
      "id": "picker_style",
      "label": "Picker style",
      "default": "pills",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "swatches",
          "label": "Swatches"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_selected_value",
      "label": "Show selected value",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show availability status",
      "default": true
    },
    {
      "type": "text",
      "id": "available_text",
      "label": "Available text",
      "default": "Available"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable text",
      "default": "Unavailable"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "disabled_opacity",
      "label": "Unavailable opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Label color",
      "default": "#111111"
    },
    {
      "type": "color",
