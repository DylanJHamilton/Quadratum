{{ 'product-services.css' | asset_url | stylesheet_tag }}
<q-gift-recipient class="q-recipient">
  <label class="q-recipient__toggle" for="RecipientToggle-{{ id }}"><input id="RecipientToggle-{{ id }}" type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" value="true" data-recipient-toggle {% if form.email != blank %}checked{% endif %}> {{ 'products.services.send_as_gift' | t }}</label>
  <fieldset data-recipient-fields>
    <legend>{{ 'products.services.recipient_details' | t }}</legend>
    {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <label for="RecipientEmail-{{ id }}">{{ 'products.services.recipient_email' | t }}</label>
    <input id="RecipientEmail-{{ id }}" type="email" name="properties[Recipient email]" value="{{ form.email | escape }}" autocomplete="email" data-recipient-email>
    <label for="RecipientName-{{ id }}">{{ 'products.services.recipient_name' | t }}</label>
    <input id="RecipientName-{{ id }}" type="text" name="properties[Recipient name]" value="{{ form.name | escape }}" maxlength="255" autocomplete="name">
    <label for="RecipientMessage-{{ id }}">{{ 'products.services.message' | t }}</label>
    <textarea id="RecipientMessage-{{ id }}" name="properties[Message]" maxlength="200" rows="3">{{ form.message | escape }}</textarea>
    <label for="RecipientDate-{{ id }}">{{ 'products.services.send_on' | t }}</label>
    <input id="RecipientDate-{{ id }}" type="date" name="properties[Send on]" value="{{ form.send_on | escape }}" data-recipient-date aria-describedby="RecipientHelp-{{ id }}">
    <p id="RecipientHelp-{{ id }}">{{ 'products.services.date_help' | t }}</p>
    <input type="hidden" name="properties[__shopify_offset]" data-recipient-offset disabled>
  </fieldset>
</q-gift-recipient>

<script src="{{ 'product-services.js' | asset_url }}" defer></script>
