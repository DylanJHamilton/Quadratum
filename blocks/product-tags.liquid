{%- liquid
  assign block_id = 'product-tags-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign tags_style = block.settings.tags_style | default: 'pills'
  assign max_tags = block.settings.max_tags | default: 8

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-tags
    product-tags--{{ tags_style }}
    product-tags--width-{{ width }}
    product-tags--align-{{ alignment }}
    {% unless show_on_desktop %} product-tags--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-tags--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-tags--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-tags--animate product-tags--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-tags-margin-top: {{ block.settings.margin_top }}px;
    --product-tags-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-tags-padding: {{ block.settings.padding }}px;
    --product-tags-gap: {{ block.settings.gap }}px;
    --product-tags-font-size: {{ block.settings.font_size }}px;
    --product-tags-letter-spacing: {{ block.settings.letter_spacing }}px;
    --product-tags-text-color: {{ block.settings.text_color }};
    --product-tags-label-color: {{ block.settings.label_color }};
    --product-tags-background-color: {{ block.settings.background_color }};
    --product-tags-border-color: {{ block.settings.border_color }};
    --product-tags-border-width: {{ block.settings.border_width }}px;
    --product-tags-border-radius: {{ block.settings.border_radius }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-tags
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-tags-margin-top);
      margin-bottom: var(--product-tags-margin-bottom);
      padding: var(--product-tags-padding);
      color: var(--product-tags-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-tags--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-tags--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-tags--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-tags--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-tags--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-tags--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-tags--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-tags--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-tags__inner {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-tags__label {
      color: var(--product-tags-label-color);
      font-size: var(--product-tags-font-size);
      line-height: 1.25;
    }

    #{{ block_id }} .product-tags__list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--product-tags-gap);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #{{ block_id }}.product-tags--align-center .product-tags__list {
      justify-content: center;
    }

    #{{ block_id }}.product-tags--align-right .product-tags__list {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-tags__item {
      display: inline-flex;
      min-width: 0;
    }

    #{{ block_id }} .product-tags__tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      max-width: 100%;
      color: var(--product-tags-text-color);
      font-size: var(--product-tags-font-size);
      line-height: 1.2;
      letter-spacing: var(--product-tags-letter-spacing);
      text-decoration: none;
      overflow-wrap: anywhere;
      text-transform: {{ block.settings.text_transform }};
    }

    #{{ block_id }}.product-tags--pills .product-tags__tag,
    #{{ block_id }}.product-tags--badges .product-tags__tag {
      padding: 7px 11px;
      background: var(--product-tags-background-color);
      border: var(--product-tags-border-width) solid var(--product-tags-border-color);
      border-radius: var(--product-tags-border-radius);
    }

    #{{ block_id }}.product-tags--badges .product-tags__tag {
      border-radius: max(calc(var(--product-tags-border-radius) - 8px), 4px);
    }

    #{{ block_id }}.product-tags--list .product-tags__list {
      display: grid;
      gap: 6px;
    }

    #{{ block_id }}.product-tags--list .product-tags__tag::before {
      content: "#";
      opacity: 0.6;
    }

    #{{ block_id }}.product-tags--minimal .product-tags__tag {
      opacity: 0.82;
    }

    #{{ block_id }} a.product-tags__tag {
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} a.product-tags__tag:hover {
      opacity: 0.72;
      transform: translateY(-1px);
    }

    #{{ block_id }} a.product-tags__tag:focus-visible {
      outline: 2px solid var(--product-tags-text-color);
      outline-offset: 3px;
      border-radius: 4px;
    }

    #{{ block_id }}.product-tags--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-tags--animate-fade {
      animation-name: productTagsFade;
    }

    #{{ block_id }}.product-tags--animate-fade_up {
      animation-name: productTagsFadeUp;
    }

    #{{ block_id }}.product-tags--animate-fade_down {
      animation-name: productTagsFadeDown;
    }

    #{{ block_id }}.product-tags--animate-fade_left {
      animation-name: productTagsFadeLeft;
    }

    #{{ block_id }}.product-tags--animate-fade_right {
      animation-name: productTagsFadeRight;
    }

    #{{ block_id }}.product-tags--animate-zoom {
      animation-name: productTagsZoom;
    }

    @keyframes productTagsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productTagsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTagsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTagsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productTagsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productTagsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-tags--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-tags--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-tags--hide-mobile {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-tags--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} a.product-tags__tag {
        transition: none;
      }

      #{{ block_id }} a.product-tags__tag:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-tags__inner">
    {% if block.settings.show_label and block.settings.label != blank %}
      <span class="product-tags__label">
        {{ block.settings.label | escape }}
      </span>
    {% endif %}

    {%- liquid
      assign visible_tag_count = 0
      assign rendered_any_tag = false
    -%}

    {% if product_context.tags.size > 0 %}
      <ul class="product-tags__list" aria-label="{{ block.settings.aria_label | escape }}">
        {%- for tag in product_context.tags -%}
          {%- liquid
            assign first_character = tag | slice: 0, 1
            assign should_render_tag = true

            if block.settings.hide_internal_tags and first_character == '_'
              assign should_render_tag = false
            endif

            if visible_tag_count >= max_tags
              assign should_render_tag = false
            endif
          -%}

          {% if should_render_tag %}
            {%- liquid
              assign visible_tag_count = visible_tag_count | plus: 1
              assign rendered_any_tag = true
              assign tag_url = routes.all_products_collection_url | append: '/' | append: tag | handle
            -%}

            <li class="product-tags__item">
              {% if block.settings.link_tags %}
                <a class="product-tags__tag" href="{{ tag_url }}">
                  {{ tag | escape }}
                </a>
              {% else %}
                <span class="product-tags__tag">
                  {{ tag | escape }}
                </span>
              {% endif %}
            </li>
          {% endif %}
        {%- endfor -%}
      </ul>
    {% endif %}

    {% if rendered_any_tag == false and block.settings.hide_when_empty == false %}
      <span class="product-tags__tag">
        {{ block.settings.empty_text | escape }}
      </span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product tags",
  "settings": [
    {
      "type": "header",
      "content": "Tags"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Tags:"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Product tags"
    },
    {
      "type": "range",
      "id": "max_tags",
      "label": "Maximum tags",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "link_tags",
      "label": "Link tags to collection filter",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_internal_tags",
      "label": "Hide tags starting with underscore",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide empty tags",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty tags text",
      "default": "No tags available"
    },
    {
      "type": "select",
      "id": "tags_style",
      "label": "Tags style",
      "default": "pills",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "badges",
          "label": "Badges"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tag color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tag background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Tag border",
      "default": "#e5e5e5"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 80
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tags List",
      "settings": {
        "show_label": true,
        "label": "Tags:",
        "aria_label": "Product tags",
        "max_tags": 8,
        "link_tags": false,
        "hide_internal_tags": true,
        "hide_when_empty": true,
        "empty_text": "No tags available",
        "tags_style": "list",
        "font_size": 13,
        "letter_spacing": 0,
        "text_transform": "none",
        "text_color": "#111111",
        "label_color": "#666666",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Tags Pills",
      "settings": {
        "show_label": false,
        "label": "Tags:",
        "aria_label": "Product tags",
        "max_tags": 8,
        "link_tags": true,
        "hide_internal_tags": true,
        "hide_when_empty": true,
        "empty_text": "No tags available",
        "tags_style": "pills",
        "font_size": 13,
        "letter_spacing": 0,
        "text_transform": "none",
        "text_color": "#111111",
        "label_color": "#666666",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Minimal Tags",
      "settings": {
        "show_label": false,
        "label": "Tags:",
        "aria_label": "Product tags",
        "max_tags": 6,
        "link_tags": false,
        "hide_internal_tags": true,
        "hide_when_empty": true,
        "empty_text": "No tags available",
        "tags_style": "minimal",
        "font_size": 12,
        "letter_spacing": 0,
        "text_transform": "none",
        "text_color": "#555555",
        "label_color": "#777777",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 8,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    }
  ]
}
{% endschema %}