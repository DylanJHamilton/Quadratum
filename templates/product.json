    "faq": {
      "type": "product-faq",
      "settings": {
        "title": "Before you buy.",
        "source": "manual",
        "layout": "accordion_split",
        "split_media_position": "left",
        "split_media_sticky": true,
        "open_first_item": true,
        "media_display": "image",
        "section_bg": "#f5f5f1",
        "title_color": "#111111",
        "padding_top": 88,
        "padding_bottom": 88
      },
      "blocks": {
        "arc_105": {
          "type": "faq_item",
          "settings": {
            "question": "Can other people hear what I am listening to?",
            "answer": "<p>At normal volume, people next to you hear very little. In a quiet room at high volume, someone sitting close may hear sound. For private listening in quiet places, keep volume under 60%.</p>",
            "media_type": "image",
            "image": "shopify://shop_images/vector-one-03-side.webp"
          }
        },
        "arc_106": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get prescription lenses?",
            "answer": "<p>Yes. Choose Prescription at checkout and upload your prescription, or order clear lenses and visit any optician. Single vision and progressive lenses are supported.</p>",
            "media_type": "image",
            "image": "shopify://shop_images/vector-one-03-side.webp"
          }
        },
        "arc_107": {
          "type": "faq_item",
          "settings": {
            "question": "Is there an app?",
            "answer": "<p>No app is required. The ARC//FORM app adds button remapping, equalizer presets and firmware updates on iOS and Android.</p>",
            "media_type": "image",
            "image": "shopify://shop_images/vector-one-03-side.webp"
          }
        },
        "arc_108": {
          "type": "faq_item",
          "settings": {
            "question": "Are they water resistant?",
            "answer": "<p>Vector One is rated IPX4: fine for sweat and light rain, not for swimming or showers.</p>",
            "media_type": "image",
            "image": "shopify://shop_images/vector-one-03-side.webp"
          }
        },
        "arc_109": {
          "type": "faq_item",
          "settings": {
            "question": "What happens if the battery wears out?",
            "answer": "<p>The two-year warranty covers battery capacity under 80%. After that, our service program replaces the temple batteries for a flat fee.</p>",
            "media_type": "image",
            "image": "shopify://shop_images/vector-one-03-side.webp"
          }
        }
      },
