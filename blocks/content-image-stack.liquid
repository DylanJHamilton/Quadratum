{% liquid
  assign block_id = block.id
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  if request.design_mode
    assign animation = 'none'
  endif
%}

{% assign has_intro = false %}
{% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}{% assign has_intro = true %}{% endif %}
{% if block.settings.cta_text != blank and block.settings.cta_url != blank %}{% assign has_intro = true %}{% endif %}
{% assign image_count = 0 %}
{% capture images_markup %}
    <div class="qtm-image-stack__visual" role="group" aria-label="{{ block.settings.heading | default: 'Image stack' | escape }}">
      {% for i in (1..4) %}
        {% liquid
          assign show_key = 'show_image_' | append: i
          assign image_key = 'image_' | append: i
          assign caption_key = 'image_' | append: i | append: '_caption'
          assign alt_caption_key = 'image_' | append: i | append: '_alt_caption'

          assign show_image = block.settings[show_key]
          assign stack_image = block.settings[image_key]
          assign caption = block.settings[caption_key]
          assign alt_caption = block.settings[alt_caption_key]
        %}

        {% assign populated = false %}
        {% if stack_image != blank or caption != blank or alt_caption != blank %}{% assign populated = true %}{% endif %}
        {% if show_image and populated %}{% assign image_count = image_count | plus: 1 %}
          <figure class="qtm-image-stack__figure qtm-image-stack__figure--{{ i }}">
            <div class="qtm-image-stack__media"{% if stack_image == blank and request.design_mode == false %} hidden{% endif %}>
              {% if stack_image != blank %}
                {{
                  stack_image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'qtm-image-stack__image',
                    loading: 'lazy',
                    widths: '320, 480, 640, 850, 1100, 1400, 1600',
                    sizes: '(min-width: 990px) 45vw, 100vw',
                    alt: stack_image.alt
                }}
              {% else %}
                <div class="qtm-image-stack__placeholder">
                  {% if i == 1 %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'qtm-image-stack__placeholder-svg' }}
                  {% elsif i == 2 %}
                    {{ 'product-1' | placeholder_svg_tag: 'qtm-image-stack__placeholder-svg' }}
                  {% elsif i == 3 %}
                    {{ 'collection-1' | placeholder_svg_tag: 'qtm-image-stack__placeholder-svg' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'qtm-image-stack__placeholder-svg' }}
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% if caption != blank or alt_caption != blank %}
              <figcaption class="qtm-image-stack__caption">
                {% if caption != blank %}
                  <span class="qtm-image-stack__caption-primary">
                    {{ caption | escape }}
                  </span>
                {% endif %}

                {% if alt_caption != blank %}
                  <span class="qtm-image-stack__caption-secondary">
                    {{ alt_caption | escape }}
                  </span>
                {% endif %}
              </figcaption>
            {% endif %}
          </figure>
        {% endif %}
      {% endfor %}
    </div>
{% endcapture %}
{% assign has_content = false %}
{% if image_count > 0 %}{% assign has_content = true %}{% endif %}
{% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}{% assign has_content = true %}{% endif %}
{% if block.settings.cta_text != blank and block.settings.cta_url != blank %}{% assign has_content = true %}{% endif %}

<div
  {% if has_content == false and request.design_mode == false %}hidden{% endif %}
  class="
    qtm-image-stack
    qtm-image-stack-{{ block_id }}
    {% if image_count < 4 %}qtm-image-stack--sparse{% endif %}
    {% if image_count == 0 or has_intro == false %}qtm-image-stack--single-column{% endif %}
    qtm-image-stack--width-{{ block_width }}
    qtm-image-stack--align-{{ block_alignment }}
    qtm-image-stack--layout-{{ block.settings.layout_style }}
    qtm-image-stack--animation-{{ animation }}
    {% unless block.settings.show_desktop or request.design_mode %} qtm-image-stack--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet or request.design_mode %} qtm-image-stack--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile or request.design_mode %} qtm-image-stack--hide-mobile{% endunless %}
  "
  style="
    --qtm-image-stack-margin-top: {{ block.settings.margin_top }}px;
    --qtm-image-stack-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-image-stack-padding: {{ block.settings.padding }}px;
    --qtm-image-stack-gap: {{ block.settings.gap }}px;
    --qtm-image-stack-heading-color: {{ block.settings.heading_color }};
    --qtm-image-stack-text-color: {{ block.settings.text_color }};
    --qtm-image-stack-background-color: {{ block.settings.background_color }};
    --qtm-image-stack-border-color: {{ block.settings.border_color }};
    --qtm-image-stack-link-color: {{ block.settings.link_color }};
    --qtm-image-stack-card-background: {{ block.settings.card_background_color }};
    --qtm-image-stack-caption-background: {{ block.settings.caption_background_color }};
    --qtm-image-stack-caption-text: {{ block.settings.caption_text_color }};
    --qtm-image-stack-border-width: {{ block.settings.border_width }}px;
    --qtm-image-stack-border-radius: {{ block.settings.border_radius }}px;
    --qtm-image-stack-visual-height: {{ block.settings.visual_min_height }}px;
    --qtm-image-stack-shadow-opacity: {{ block.settings.shadow_opacity | divided_by: 100.0 }};
  "
>
  <div class="qtm-image-stack__inner">
    {% if has_content == false and request.design_mode %}<p role="note">Choose images and optional captions.</p>{% endif %}
    {% if has_intro %}
      <div class="qtm-image-stack__content">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-image-stack__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-image-stack__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-image-stack__text">
            {{ block.settings.text }}
          </div>
        {% endif %}

        {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
          <a class="qtm-image-stack__button" href="{{ block.settings.cta_url | escape }}">
            {{ block.settings.cta_text | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

{% if image_count > 0 %}{{ images_markup }}{% endif %}
  </div>
</div>

<style>
  .qtm-image-stack-{{ block_id }} {
    margin-top: var(--qtm-image-stack-margin-top);
    margin-bottom: var(--qtm-image-stack-margin-bottom);
    padding: min(var(--qtm-image-stack-padding), 12%);
    color: var(--qtm-image-stack-text-color);
    background: var(--qtm-image-stack-background-color);
    border: var(--qtm-image-stack-border-width) solid var(--qtm-image-stack-border-color);
    border-radius: var(--qtm-image-stack-border-radius);
  }

  .qtm-image-stack-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--width-auto {
    width: auto;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--width-small {
    max-width: 720px;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--width-medium {
    max-width: 960px;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--width-large {
    max-width: 1180px;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__inner {
    display: grid;
    gap: var(--qtm-image-stack-gap);
    align-items: center;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__inner,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__inner {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__inner {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__visual {
    order: -1;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-stacked .qtm-image-stack__inner {
    grid-template-columns: 1fr;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__content {
    display: grid;
    gap: 0.8rem;
    align-content: center;
    max-width: 680px;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-center .qtm-image-stack__content {
    margin-inline: auto;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-right .qtm-image-stack__content {
    margin-left: auto;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__eyebrow {
    margin: 0;
    color: var(--qtm-image-stack-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__heading {
    margin: 0;
    color: var(--qtm-image-stack-heading-color);
    line-height: 1.04;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__text {
    color: var(--qtm-image-stack-text-color);
    line-height: 1.7;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__text p {
    margin-top: 0;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.9rem;
    margin-top: 0.25rem;
    padding: 0.9rem 1.25rem;
    color: #ffffff;
    background: var(--qtm-image-stack-link-color);
    border: 1px solid var(--qtm-image-stack-link-color);
    border-radius: 999px;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-center .qtm-image-stack__button {
    justify-self: center;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--align-right .qtm-image-stack__button {
    justify-self: end;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__button:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__button:focus-visible {
    outline: 3px solid var(--qtm-image-stack-link-color);
    outline-offset: 4px;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__visual {
    position: relative;
    display: grid;
    min-height: var(--qtm-image-stack-visual-height);
    isolation: isolate;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__figure {
    position: relative;
    display: grid;
    gap: 0.65rem;
    margin: 0;
    min-width: 0;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__media {
    overflow: hidden;
    background: var(--qtm-image-stack-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-image-stack-border-color), transparent 15%);
    border-radius: calc(var(--qtm-image-stack-border-radius) * 0.85);
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, var(--qtm-image-stack-shadow-opacity));
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }} .qtm-image-stack__placeholder {
    display: block;
    width: 100%;
    min-height: 220px;
    object-fit: cover;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__image {
    height: 100%;
    transition: transform 620ms ease;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__figure:hover .qtm-image-stack__image {
    transform: scale(1.035);
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__placeholder {
    display: grid;
    place-items: center;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.25;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__caption {
    display: grid;
    gap: 0.15rem;
    width: fit-content;
    max-width: 90%;
    padding: 0.65rem 0.75rem;
    color: var(--qtm-image-stack-caption-text);
    background: var(--qtm-image-stack-caption-background);
    border: 1px solid color-mix(in srgb, var(--qtm-image-stack-caption-text), transparent 88%);
    border-radius: calc(var(--qtm-image-stack-border-radius) * 0.45);
    text-align: left;
    box-shadow: 0 0.8rem 1.8rem rgba(0, 0, 0, 0.08);
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__caption-primary {
    color: inherit;
    font-size: 0.82rem;
    font-weight: 850;
    line-height: 1.15;
  }

  .qtm-image-stack-{{ block_id }} .qtm-image-stack__caption-secondary {
    color: inherit;
    font-size: 0.76rem;
    line-height: 1.3;
    opacity: 0.72;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__visual,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__visual,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__visual {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(12, minmax(24px, 1fr));
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure {
    position: absolute;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--1,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--1,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--1 {
    z-index: 2;
    left: 2%;
    top: 4%;
    width: 64%;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--1 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--1 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--1 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--1 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--1 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--1 .qtm-image-stack__placeholder {
    min-height: calc(var(--qtm-image-stack-visual-height) * 0.72);
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--2,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--2,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--2 {
    z-index: 3;
    right: 0;
    top: 22%;
    width: 44%;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--2 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--2 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--2 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--2 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--2 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--2 .qtm-image-stack__placeholder {
    min-height: calc(var(--qtm-image-stack-visual-height) * 0.44);
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--3,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--3,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--3 {
    z-index: 1;
    left: 20%;
    bottom: 0;
    width: 48%;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--3 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--3 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--3 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--3 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--3 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--3 .qtm-image-stack__placeholder {
    min-height: calc(var(--qtm-image-stack-visual-height) * 0.36);
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--4,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--4,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--4 {
    z-index: 4;
    right: 10%;
    bottom: 8%;
    width: 28%;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--4 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-editorial .qtm-image-stack__figure--4 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--4 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-side-by-side .qtm-image-stack__figure--4 .qtm-image-stack__placeholder,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--4 .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-visual-first .qtm-image-stack__figure--4 .qtm-image-stack__placeholder {
    min-height: calc(var(--qtm-image-stack-visual-height) * 0.24);
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-stacked .qtm-image-stack__visual {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--qtm-image-stack-gap);
    min-height: auto;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-stacked .qtm-image-stack__figure {
    position: relative;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-stacked .qtm-image-stack__image,
  .qtm-image-stack-{{ block_id }}.qtm-image-stack--layout-stacked .qtm-image-stack__placeholder {
    min-height: {{ block.settings.stacked_image_height }}px;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--animation-fade {
    animation: qtm-image-stack-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--animation-fade-up {
    animation: qtm-image-stack-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--animation-fade-down {
    animation: qtm-image-stack-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--animation-fade-left {
    animation: qtm-image-stack-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--animation-fade-right {
    animation: qtm-image-stack-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-image-stack-{{ block_id }}.qtm-image-stack--animation-zoom {
    animation: qtm-image-stack-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-image-stack-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-image-stack-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-image-stack-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-image-stack-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

