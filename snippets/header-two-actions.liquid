{%- comment -%}
  Snippet: header-two-actions
  Reusable actions cluster for Header Two.

  Accepts:
    search_mode, search_placeholder, show_account, account_display,
    cart_display, show_cart_subtotal, tracking_label, tracking_url
{%- endcomment -%}

<div class="qtm-hm-actions">
  {%- if search_mode == 'popup' or search_mode == 'page' -%}
    {% render 'header-two-search',
      mode: search_mode,
      placeholder: search_placeholder
    %}
  {%- endif -%}

  {%- if show_account -%}
    {% render 'header-two-account',
      display: account_display,
      tracking_label: tracking_label,
      tracking_url: tracking_url
    %}
  {%- endif -%}

  {% render 'header-two-cart',
    display: cart_display,
    show_subtotal: show_cart_subtotal
  %}
</div>
