<section id="morrow-cat-collections" class="mc-collections" aria-labelledby="MorrowCollectionsTitle-{{ section.id }}">
  <header class="mc-section-heading">
    <div><p class="mc-eyebrow">{{ section.settings.kicker | escape }}</p><h2 id="MorrowCollectionsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    {% if section.settings.link_label != blank %}<a class="mc-text-link" href="{{ section.settings.link | default: '#morrow-cat-catalog' }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
  </header>
  <div class="mc-collection-grid">
    {% for block in section.blocks %}
      {%- liquid
        assign tile_asset = block.settings.image_asset | default: 'mc-cat-curious.webp'
        assign tile_alt = block.settings.alt | default: block.settings.title
      -%}
      <a class="mc-collection-card" href="{{ block.settings.link | default: '#morrow-cat-catalog' }}" data-mc-filter-link="{{ block.settings.category }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 900 | image_tag: class: 'mc-collection-card__image', alt: tile_alt, loading: 'lazy', widths: '360, 540, 720, 900' }}
        {% else %}
          <img class="mc-collection-card__image" src="{{ tile_asset | asset_url }}" alt="{{ tile_alt | escape }}" width="900" height="1080" loading="lazy">
        {% endif %}
        <span class="mc-collection-card__number">{{ block.settings.number | escape }} / {{ block.settings.category | upcase | escape }}</span>
        <span class="mc-collection-card__title">{{ block.settings.title | escape }} <span aria-hidden="true">↗</span></span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Morrow Collections",
  "max_blocks":4,
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"Four corners of cat life"},
    {"type":"text","id":"heading","label":"Heading","default":"What’s their kind of day?"},
    {"type":"text","id":"link_label","label":"Link label","default":"See all 24 concepts"},
    {"type":"url","id":"link","label":"Link"}
  ],
  "blocks":[{"type":"category","name":"Collection tile","settings":[
    {"type":"select","id":"category","label":"Collection","options":[{"value":"Play","label":"Play"},{"value":"Rest","label":"Rest"},{"value":"Feeding","label":"Feeding"},{"value":"Care","label":"Care"}],"default":"Play"},
    {"type":"text","id":"number","label":"Number","default":"01"},
    {"type":"text","id":"title","label":"Tile title","default":"A little mischief"},
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"text","id":"image_asset","label":"Theme asset filename","default":"mc-cat-play.webp"},
    {"type":"text","id":"alt","label":"Image description","default":"A curious cat stretches in a colorful room."},
    {"type":"url","id":"link","label":"Collection link override"}
  ]}],
  "presets":[{"name":"Morrow Collections","blocks":[{"type":"category"},{"type":"category","settings":{"category":"Rest","number":"02","title":"Very good naps","image_asset":"mc-cat-rest.webp","alt":"An orange cat curled up on a lilac cushion."}},{"type":"category","settings":{"category":"Feeding","number":"03","title":"Dinner, with a side-eye","image_asset":"mc-cat-home.webp","alt":"Cats enjoy a sunny moment at home."}},{"type":"category","settings":{"category":"Care","number":"04","title":"The everyday stuff","image_asset":"mc-cat-curious.webp","alt":"A curious cat looks toward the camera."}}]}]
}
{% endschema %}

