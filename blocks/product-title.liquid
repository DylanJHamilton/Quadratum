{%- liquid
  assign block_id = 'product-title-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign heading_tag = block.settings.heading_tag | default: 'h1'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-title
    product-title--width-{{ width }}
    product-title--align-{{ alignment }}
    {% unless show_on_desktop %} product-title--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-title--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-title--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-title--animate product-title--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-title-margin-top: {{ block.settings.margin_top }}px;
    --product-title-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-title-padding: {{ block.settings.padding }}px;
    --product-title-size-desktop: {{ block.settings.title_size_desktop }}px;
    --product-title-size-mobile: {{ block.settings.title_size_mobile }}px;
    --product-title-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
    --product-title-letter-spacing: {{ block.settings.letter_spacing }}px;
    --product-title-transform: {{ block.settings.text_transform }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-title-margin-top);
      margin-bottom: var(--product-title-margin-bottom);
      padding: var(--product-title-padding);
      color: inherit;
      background: transparent;
    }

    #{{ block_id }}.product-title--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-title--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-title--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-title--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-title--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-title--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-title--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-title--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-title__heading {
      margin: 0;
      color: inherit;
      font-size: clamp(var(--product-title-size-mobile), 4vw, var(--product-title-size-desktop));
      line-height: var(--product-title-line-height);
      letter-spacing: var(--product-title-letter-spacing);
      text-transform: var(--product-title-transform);
      overflow-wrap: anywhere;
    }

    #{{ block_id }}.product-title--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-title--animate-fade {
      animation-name: productTitleFade;
    }

    #{{ block_id }}.product-title--animate-fade_up {
      animation-name: productTitleFadeUp;
    }

    #{{ block_id }}.product-title--animate-fade_down {
      animation-name: productTitleFadeDown;
    }

    #{{ block_id }}.product-title--animate-fade_left {
      animation-name: productTitleFadeLeft;
    }

    #{{ block_id }}.product-title--animate-fade_right {
      animation-name: productTitleFadeRight;
    }

    #{{ block_id }}.product-title--animate-zoom {
      animation-name: productTitleZoom;
    }

    @keyframes productTitleFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productTitleFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTitleFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTitleFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productTitleFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productTitleZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-title--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-title--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-title--hide-mobile {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-title--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  {% if product_context.title != blank %}
    <{{ heading_tag }} class="product-title__heading">
      {{ product_context.title | escape }}
    </{{ heading_tag }}>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product title",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML tag",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "div",
          "label": "Div"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Desktop title size",
      "min": 20,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Mobile title size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 90,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -3,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Title",
      "settings": {
        "heading_tag": "h1",
        "title_size_desktop": 44,
        "title_size_mobile": 32,
        "line_height": 110,
        "letter_spacing": 0,
        "text_transform": "none",
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 16,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Large Hero Title",
      "settings": {
        "heading_tag": "h1",
        "title_size_desktop": 64,
        "title_size_mobile": 40,
        "line_height": 100,
        "letter_spacing": -1,
        "text_transform": "none",
        "width": "large",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 20,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "fade_up"
      }
    },
    {
      "name": "Minimal Product Title",
      "settings": {
        "heading_tag": "h2",
        "title_size_desktop": 32,
        "title_size_mobile": 26,
        "line_height": 115,
        "letter_spacing": 0,
        "text_transform": "none",
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    }
  ]
}
{% endschema %}