{%- liquid
  assign quote_text = block.settings.quote_text | default: 'Add a customer quote, testimonial, or pull quote here.'
  assign quote_author = block.settings.quote_author
  assign quote_role = block.settings.quote_role
  assign quote_avatar = block.settings.avatar
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'quote' %}

<figure
  class="
    qtm-quote
    qtm-quote--{{ block.settings.quote_layout }}
  "
  style="
    --qtm-quote-max-width: {{ block.settings.max_width }}px;
    --qtm-quote-padding: {{ block.settings.quote_padding }}px;
    --qtm-quote-background: {{ block.settings.quote_background }};
    --qtm-quote-border-width: {{ block.settings.quote_border_width }}px;
    --qtm-quote-border-color: {{ block.settings.quote_border_color }};
    --qtm-quote-radius: {{ block.settings.quote_radius }}px;
    --qtm-quote-mark-color: {{ block.settings.quote_mark_color }};
    --qtm-quote-text-color: {{ block.settings.quote_text_color }};
    --qtm-quote-author-color: {{ block.settings.author_color }};
    --qtm-quote-role-color: {{ block.settings.role_color }};
    --qtm-quote-font-family: {% if block.settings.font_family == 'heading' %}var(--font-heading-family){% elsif block.settings.font_family == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
    --qtm-quote-font-weight: {{ block.settings.font_weight }};
    --qtm-quote-letter-spacing: {{ block.settings.letter_spacing }}px;
    --qtm-quote-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
    --qtm-quote-avatar-size: {{ block.settings.avatar_size }}px;
  "
>
  {% if block.settings.show_quote_mark %}
    <span class="qtm-quote__mark" aria-hidden="true">“</span>
  {% endif %}

  <blockquote class="qtm-quote__text">
    {{ quote_text | escape }}
  </blockquote>

  {% if quote_author != blank or quote_role != blank or quote_avatar != blank %}
    <figcaption class="qtm-quote__meta">
      {% if quote_avatar != blank %}
        {{
          quote_avatar
          | image_url: width: 160
          | image_tag:
            class: 'qtm-quote__avatar',
            loading: 'lazy',
            alt: quote_author
        }}
      {% endif %}

      <span class="qtm-quote__person">
        {% if quote_author != blank %}
          <span class="qtm-quote__author">
            {{ quote_author | escape }}
          </span>
        {% endif %}

        {% if quote_role != blank %}
          <span class="qtm-quote__role">
            {{ quote_role | escape }}
          </span>
        {% endif %}
      </span>
    </figcaption>
  {% endif %}
</figure>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
