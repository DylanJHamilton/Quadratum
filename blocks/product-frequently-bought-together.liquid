{%- liquid
  assign block_id = 'product-frequently-bought-together-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign layout_style = block.settings.layout_style | default: 'cards'
  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign rendered_items = 0
  assign bundle_total = 0
  assign bundle_compare_total = 0
-%}

<div
  id="{{ block_id }}"
  class="
    product-frequently-bought-together
    product-frequently-bought-together--{{ layout_style }}
    product-frequently-bought-together--width-{{ width }}
    product-frequently-bought-together--align-{{ alignment }}
    {% unless show_on_desktop %} product-frequently-bought-together--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-frequently-bought-together--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-frequently-bought-together--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-frequently-bought-together--animate product-frequently-bought-together--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-fbt-margin-top: {{ block.settings.margin_top }}px;
    --product-fbt-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-fbt-padding: {{ block.settings.padding }}px;
    --product-fbt-card-padding: {{ block.settings.card_padding }}px;
    --product-fbt-gap: {{ block.settings.item_gap }}px;
    --product-fbt-radius: {{ block.settings.card_radius }}px;
    --product-fbt-image-radius: {{ block.settings.image_radius }}px;
    --product-fbt-border-width: {{ block.settings.border_width }}px;
    --product-fbt-image-size: {{ block.settings.image_size }}px;
    --product-fbt-image-size-mobile: {{ block.settings.image_size_mobile }}px;
    --product-fbt-heading-color: {{ block.settings.heading_color }};
    --product-fbt-text-color: {{ block.settings.text_color }};
    --product-fbt-muted-color: {{ block.settings.muted_color }};
    --product-fbt-price-color: {{ block.settings.price_color }};
    --product-fbt-sale-color: {{ block.settings.sale_color }};
    --product-fbt-background: {{ block.settings.background_color }};
    --product-fbt-card-background: {{ block.settings.card_background_color }};
    --product-fbt-border-color: {{ block.settings.border_color }};
    --product-fbt-button-background: {{ block.settings.button_background_color }};
    --product-fbt-button-text: {{ block.settings.button_text_color }};
    --product-fbt-accent-color: {{ block.settings.accent_color }};
    --product-fbt-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-frequently-bought-together
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-fbt-margin-top);
      margin-bottom: var(--product-fbt-margin-bottom);
      padding: var(--product-fbt-padding);
      color: var(--product-fbt-text-color);
      background: var(--product-fbt-background);
    }

    #{{ block_id }}.product-frequently-bought-together--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-frequently-bought-together--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-frequently-bought-together--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-frequently-bought-together--width-large {
      max-width: 1240px;
    }

    #{{ block_id }}.product-frequently-bought-together--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-frequently-bought-together--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-frequently-bought-together--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-frequently-bought-together--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-frequently-bought-together__inner {
      display: grid;
      gap: 18px;
      min-width: 0;
      padding: var(--product-fbt-card-padding);
      background: var(--product-fbt-card-background);
      border: var(--product-fbt-border-width) solid var(--product-fbt-border-color);
      border-radius: var(--product-fbt-radius);
    }

    #{{ block_id }} .product-frequently-bought-together__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }}.product-frequently-bought-together--align-center .product-frequently-bought-together__header {
      margin-left: auto;
      margin-right: auto;
      justify-items: center;
    }

    #{{ block_id }}.product-frequently-bought-together--align-right .product-frequently-bought-together__header {
      margin-left: auto;
      margin-right: 0;
      justify-items: end;
    }

    #{{ block_id }} .product-frequently-bought-together__eyebrow {
      margin: 0;
      color: var(--product-fbt-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-frequently-bought-together__heading {
      margin: 0;
      color: var(--product-fbt-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.12;
    }

    #{{ block_id }} .product-frequently-bought-together__description {
      margin: 0;
      color: var(--product-fbt-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-frequently-bought-together__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, {{ block.settings.summary_width }}px);
      gap: 20px;
      align-items: start;
      min-width: 0;
    }

    #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__body {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .product-frequently-bought-together__items {
      display: grid;
      gap: var(--product-fbt-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-frequently-bought-together--cards .product-frequently-bought-together__items {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    }

    #{{ block_id }}.product-frequently-bought-together--compact .product-frequently-bought-together__items,
    #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .product-frequently-bought-together__item {
      position: relative;
      display: grid;
      gap: 12px;
      min-width: 0;
      padding: {{ block.settings.item_padding }}px;
      background: {{ block.settings.item_background_color }};
      border: 1px solid var(--product-fbt-border-color);
      border-radius: max(calc(var(--product-fbt-radius) - 8px), 8px);
    }

    #{{ block_id }}.product-frequently-bought-together--compact .product-frequently-bought-together__item,
    #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__item {
      grid-template-columns: auto var(--product-fbt-image-size) minmax(0, 1fr);
      align-items: center;
    }

    #{{ block_id }}.product-frequently-bought-together--cards .product-frequently-bought-together__item {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .product-frequently-bought-together__check {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #{{ block_id }}.product-frequently-bought-together--compact .product-frequently-bought-together__check,
    #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__check {
      position: static;
    }

    #{{ block_id }} .product-frequently-bought-together__checkbox {
      width: 20px;
      height: 20px;
      margin: 0;
      accent-color: var(--product-fbt-accent-color);
      cursor: pointer;
    }

    #{{ block_id }} .product-frequently-bought-together__checkbox:focus-visible {
      outline: 2px solid var(--product-fbt-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-frequently-bought-together__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: var(--product-fbt-image-radius);
      aspect-ratio: 1;
    }

    #{{ block_id }}.product-frequently-bought-together--compact .product-frequently-bought-together__media,
    #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__media {
      width: var(--product-fbt-image-size);
      height: var(--product-fbt-image-size);
      aspect-ratio: auto;
    }

    #{{ block_id }} .product-frequently-bought-together__media img,
    #{{ block_id }} .product-frequently-bought-together__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 260ms ease;
    }

    #{{ block_id }} .product-frequently-bought-together__item:hover .product-frequently-bought-together__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .product-frequently-bought-together__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .product-frequently-bought-together__content {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    #{{ block_id }} .product-frequently-bought-together__badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      padding: 4px 8px;
      color: #ffffff;
      background: var(--product-fbt-accent-color);
      border-radius: 999px;
      font-size: 11px;
      line-height: 1.2;
      font-weight: 700;
    }

    #{{ block_id }} .product-frequently-bought-together__title {
      margin: 0;
      color: var(--product-fbt-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-frequently-bought-together__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-frequently-bought-together__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }

    #{{ block_id }} .product-frequently-bought-together__vendor {
      color: var(--product-fbt-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-frequently-bought-together__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--product-fbt-price-color);
      line-height: 1.25;
    }

    #{{ block_id }} .product-frequently-bought-together__price {
      color: var(--product-fbt-price-color);
      font-weight: 800;
    }

    #{{ block_id }} .product-frequently-bought-together__compare {
      color: var(--product-fbt-muted-color);
      text-decoration: line-through;
      opacity: 0.72;
    }

    #{{ block_id }} .product-frequently-bought-together__summary {
      position: sticky;
      top: {{ block.settings.summary_sticky_offset }}px;
      display: grid;
      gap: 12px;
      min-width: 0;
      padding: {{ block.settings.summary_padding }}px;
      background: {{ block.settings.summary_background_color }};
      border: 1px solid var(--product-fbt-border-color);
      border-radius: max(calc(var(--product-fbt-radius) - 6px), 10px);
    }

    #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__summary {
      position: static;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    #{{ block_id }} .product-frequently-bought-together__summary-heading {
      margin: 0;
      color: var(--product-fbt-heading-color);
      font-size: {{ block.settings.summary_heading_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-frequently-bought-together__summary-prices {
      display: grid;
      gap: 4px;
    }

    #{{ block_id }} .product-frequently-bought-together__summary-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      color: var(--product-fbt-text-color);
      line-height: 1.3;
    }

    #{{ block_id }} .product-frequently-bought-together__summary-label {
      color: var(--product-fbt-muted-color);
      font-size: 0.92em;
    }

    #{{ block_id }} .product-frequently-bought-together__summary-total {
      color: var(--product-fbt-price-color);
      font-size: {{ block.settings.summary_price_size }}px;
      font-weight: 900;
    }

    #{{ block_id }} .product-frequently-bought-together__summary-compare {
      color: var(--product-fbt-muted-color);
      text-decoration: line-through;
    }

    #{{ block_id }} .product-frequently-bought-together__savings {
      display: inline-flex;
      width: fit-content;
      padding: 6px 9px;
      color: var(--product-fbt-sale-color);
      background: color-mix(in srgb, var(--product-fbt-sale-color), transparent 90%);
      border-radius: 999px;
      font-size: {{ block.settings.savings_size }}px;
      line-height: 1.2;
      font-weight: 800;
    }

    #{{ block_id }} .product-frequently-bought-together__note {
      margin: 0;
      color: var(--product-fbt-muted-color);
      font-size: {{ block.settings.note_size }}px;
      line-height: 1.45;
    }

    #{{ block_id }} .product-frequently-bought-together__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: {{ block.settings.button_height }}px;
      padding: 12px 18px;
      color: var(--product-fbt-button-text);
      background: var(--product-fbt-button-background);
      border: 1px solid var(--product-fbt-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 800;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-frequently-bought-together__button:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-frequently-bought-together__button[disabled] {
      cursor: not-allowed;
      opacity: 0.48;
      transform: none;
    }

    #{{ block_id }} .product-frequently-bought-together__button:focus-visible,
    #{{ block_id }} .product-frequently-bought-together__title a:focus-visible,
    #{{ block_id }} .product-frequently-bought-together__media:focus-visible {
      outline: 2px solid var(--product-fbt-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-frequently-bought-together__status {
      min-height: 18px;
      color: var(--product-fbt-muted-color);
      font-size: 0.9em;
      line-height: 1.35;
    }

    #{{ block_id }} .product-frequently-bought-together__empty {
      padding: 18px;
      color: var(--product-fbt-text-color);
      background: var(--product-fbt-card-background);
      border: var(--product-fbt-border-width) solid var(--product-fbt-border-color);
      border-radius: var(--product-fbt-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-frequently-bought-together--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-frequently-bought-together--animate-fade {
      animation-name: productFbtFade;
    }

    #{{ block_id }}.product-frequently-bought-together--animate-fade_up {
      animation-name: productFbtFadeUp;
    }

    #{{ block_id }}.product-frequently-bought-together--animate-zoom {
      animation-name: productFbtZoom;
    }

    @keyframes productFbtFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productFbtFadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFbtZoom {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-frequently-bought-together--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-frequently-bought-together--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .product-frequently-bought-together__body {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-frequently-bought-together__summary {
        position: static;
      }

      #{{ block_id }}.product-frequently-bought-together--cards .product-frequently-bought-together__items {
        grid-template-columns: repeat({{ block.settings.columns_tablet }}, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-frequently-bought-together--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-frequently-bought-together__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-frequently-bought-together__body {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-frequently-bought-together__summary {
        position: static;
      }

      #{{ block_id }}.product-frequently-bought-together--cards .product-frequently-bought-together__items {
        grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      }

      #{{ block_id }}.product-frequently-bought-together--compact .product-frequently-bought-together__item,
      #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__item {
        grid-template-columns: auto var(--product-fbt-image-size-mobile) minmax(0, 1fr);
      }

      #{{ block_id }}.product-frequently-bought-together--compact .product-frequently-bought-together__media,
      #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__media {
        width: var(--product-fbt-image-size-mobile);
        height: var(--product-fbt-image-size-mobile);
      }

      #{{ block_id }}.product-frequently-bought-together--inline .product-frequently-bought-together__summary {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-frequently-bought-together--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-frequently-bought-together__media img,
      #{{ block_id }} .product-frequently-bought-together__button {
        transition: none;
      }

      #{{ block_id }} .product-frequently-bought-together__item:hover .product-frequently-bought-together__media img,
      #{{ block_id }} .product-frequently-bought-together__button:hover {
        transform: none;
      }
    }
  </style>

  {%- capture bundle_items_markup -%}
    {% if block.settings.include_current_product and product_context != blank %}
      {%- liquid
        assign rendered_items = rendered_items | plus: 1
        assign bundle_product = product_context
        assign bundle_variant = current_variant
        assign image_alt = bundle_product.title

        if bundle_product.featured_image.alt != blank
          assign image_alt = bundle_product.featured_image.alt
        endif

        assign bundle_total = bundle_total | plus: bundle_variant.price

        if bundle_variant.compare_at_price > bundle_variant.price
          assign bundle_compare_total = bundle_compare_total | plus: bundle_variant.compare_at_price
        else
          assign bundle_compare_total = bundle_compare_total | plus: bundle_variant.price
        endif
      -%}

      <article
        class="product-frequently-bought-together__item"
        data-product-fbt-item
        data-variant-id="{{ bundle_variant.id }}"
        data-price="{{ bundle_variant.price }}"
        data-compare-price="{% if bundle_variant.compare_at_price > bundle_variant.price %}{{ bundle_variant.compare_at_price }}{% else %}{{ bundle_variant.price }}{% endif %}"
        data-available="{{ bundle_variant.available }}"
      >
        <label class="product-frequently-bought-together__check">
          <input
            class="product-frequently-bought-together__checkbox"
            type="checkbox"
            data-product-fbt-checkbox
            {% if bundle_variant.available %}checked{% else %}disabled{% endif %}
            aria-label="{{ block.settings.select_item_label | escape }} {{ bundle_product.title | escape }}"
          >
        </label>

        <a class="product-frequently-bought-together__media" href="{{ bundle_product.url }}" aria-label="{{ bundle_product.title | escape }}">
          {% if bundle_product.featured_image %}
            {{ bundle_product.featured_image | image_url: width: 600 | image_tag: loading: 'eager', widths: '160, 240, 360, 480, 600', alt: image_alt }}
          {% else %}
            <span class="product-frequently-bought-together__placeholder" aria-hidden="true"></span>
          {% endif %}
        </a>

        <div class="product-frequently-bought-together__content">
          {% if block.settings.current_product_badge != blank %}
            <span class="product-frequently-bought-together__badge">
              {{ block.settings.current_product_badge | escape }}
            </span>
          {% endif %}

          {% if block.settings.show_vendor and bundle_product.vendor != blank %}
            <div class="product-frequently-bought-together__vendor">
              {{ bundle_product.vendor | escape }}
            </div>
          {% endif %}

          <h3 class="product-frequently-bought-together__title">
            <a href="{{ bundle_product.url }}">
              {{ bundle_product.title | escape }}
            </a>
          </h3>

          {% if block.settings.show_price %}
            <div class="product-frequently-bought-together__price-row">
              <span class="product-frequently-bought-together__price">
                {{ bundle_variant.price | money }}
              </span>

              {% if bundle_variant.compare_at_price > bundle_variant.price %}
                <span class="product-frequently-bought-together__compare">
                  {{ bundle_variant.compare_at_price | money }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </article>
    {% endif %}

    {% for bundle_product in block.settings.products limit: block.settings.product_limit %}
      {% if bundle_product != blank %}
        {%- liquid
          assign bundle_variant = bundle_product.selected_or_first_available_variant
          assign image_alt = bundle_product.title

          if bundle_product.featured_image.alt != blank
            assign image_alt = bundle_product.featured_image.alt
          endif

          unless block.settings.include_current_product and product_context != blank and bundle_product.id == product_context.id
            assign rendered_items = rendered_items | plus: 1
            assign bundle_total = bundle_total | plus: bundle_variant.price

            if bundle_variant.compare_at_price > bundle_variant.price
              assign bundle_compare_total = bundle_compare_total | plus: bundle_variant.compare_at_price
            else
              assign bundle_compare_total = bundle_compare_total | plus: bundle_variant.price
            endif
          endunless
        -%}

        {% unless block.settings.include_current_product and product_context != blank and bundle_product.id == product_context.id %}
          <article
            class="product-frequently-bought-together__item"
            data-product-fbt-item
            data-variant-id="{{ bundle_variant.id }}"
            data-price="{{ bundle_variant.price }}"
            data-compare-price="{% if bundle_variant.compare_at_price > bundle_variant.price %}{{ bundle_variant.compare_at_price }}{% else %}{{ bundle_variant.price }}{% endif %}"
            data-available="{{ bundle_variant.available }}"
          >
            <label class="product-frequently-bought-together__check">
              <input
                class="product-frequently-bought-together__checkbox"
                type="checkbox"
                data-product-fbt-checkbox
                {% if bundle_variant.available %}checked{% else %}disabled{% endif %}
                aria-label="{{ block.settings.select_item_label | escape }} {{ bundle_product.title | escape }}"
              >
            </label>

            <a class="product-frequently-bought-together__media" href="{{ bundle_product.url }}" aria-label="{{ bundle_product.title | escape }}">
              {% if bundle_product.featured_image %}
                {{ bundle_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '160, 240, 360, 480, 600', alt: image_alt }}
              {% else %}
                <span class="product-frequently-bought-together__placeholder" aria-hidden="true"></span>
              {% endif %}
            </a>

            <div class="product-frequently-bought-together__content">
              {% if block.settings.show_vendor and bundle_product.vendor != blank %}
                <div class="product-frequently-bought-together__vendor">
                  {{ bundle_product.vendor | escape }}
                </div>
              {% endif %}

              <h3 class="product-frequently-bought-together__title">
                <a href="{{ bundle_product.url }}">
                  {{ bundle_product.title | escape }}
                </a>
              </h3>

              {% if block.settings.show_price %}
                <div class="product-frequently-bought-together__price-row">
                  <span class="product-frequently-bought-together__price">
                    {{ bundle_variant.price | money }}
                  </span>

                  {% if bundle_variant.compare_at_price > bundle_variant.price %}
                    <span class="product-frequently-bought-together__compare">
                      {{ bundle_variant.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endunless %}
      {% endif %}
    {% endfor %}
  {%- endcapture -%}

  {% if rendered_items > 0 %}
    {%- liquid
      assign discount_amount = 0
      assign displayed_total = bundle_total

      if block.settings.discount_percent > 0
        assign discount_amount = bundle_total | times: block.settings.discount_percent | divided_by: 100
        assign displayed_total = bundle_total | minus: discount_amount
      endif

      assign compare_savings = bundle_compare_total | minus: displayed_total
    -%}

    <div class="product-frequently-bought-together__inner">
      {% if block.settings.show_header %}
        <div class="product-frequently-bought-together__header">
          {% if block.settings.eyebrow != blank %}
            <p class="product-frequently-bought-together__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="product-frequently-bought-together__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="product-frequently-bought-together__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      <div class="product-frequently-bought-together__body">
        <div
          class="product-frequently-bought-together__items"
          data-product-fbt-items
          aria-label="{{ block.settings.bundle_items_label | escape }}"
        >
          {{ bundle_items_markup }}
        </div>

        <div class="product-frequently-bought-together__summary" data-product-fbt-summary>
          <div class="product-frequently-bought-together__summary-prices">
            {% if block.settings.summary_heading != blank %}
              <h3 class="product-frequently-bought-together__summary-heading">
                {{ block.settings.summary_heading | escape }}
              </h3>
            {% endif %}

            <div class="product-frequently-bought-together__summary-row">
              <span class="product-frequently-bought-together__summary-label">
                {{ block.settings.selected_total_label | escape }}
              </span>
              <span class="product-frequently-bought-together__summary-total" data-product-fbt-total>
                {{ displayed_total | money }}
              </span>
            </div>

            {% if block.settings.show_compare_total and bundle_compare_total > displayed_total %}
              <div class="product-frequently-bought-together__summary-row" data-product-fbt-compare-row>
                <span class="product-frequently-bought-together__summary-label">
                  {{ block.settings.compare_total_label | escape }}
                </span>
                <span class="product-frequently-bought-together__summary-compare" data-product-fbt-compare>
                  {{ bundle_compare_total | money }}
                </span>
              </div>
            {% endif %}
          </div>

          {% if block.settings.show_savings and compare_savings > 0 %}
            <span class="product-frequently-bought-together__savings" data-product-fbt-savings>
              {{ block.settings.savings_prefix | escape }} {{ compare_savings | money }}
            </span>
          {% else %}
            <span class="product-frequently-bought-together__savings" data-product-fbt-savings hidden>
              {{ block.settings.savings_prefix | escape }} {{ 0 | money }}
            </span>
          {% endif %}

          {% if block.settings.note != blank %}
            <p class="product-frequently-bought-together__note">
              {{ block.settings.note | escape }}
            </p>
          {% endif %}

          <button
            type="button"
            class="product-frequently-bought-together__button"
            data-product-fbt-add
            data-add-to-cart
            data-ajax-cart-submit
          >
            {{ block.settings.button_label | escape }}
          </button>

          <div
            class="product-frequently-bought-together__status"
            data-product-fbt-status
            role="status"
            aria-live="polite"
          ></div>
        </div>
      </div>
    </div>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productFbtReady === 'true') return;

        root.dataset.productFbtReady = 'true';

        const items = Array.from(root.querySelectorAll('[data-product-fbt-item]'));
        const checkboxes = Array.from(root.querySelectorAll('[data-product-fbt-checkbox]'));
        const addButton = root.querySelector('[data-product-fbt-add]');
        const totalNode = root.querySelector('[data-product-fbt-total]');
        const compareNode = root.querySelector('[data-product-fbt-compare]');
        const compareRow = root.querySelector('[data-product-fbt-compare-row]');
        const savingsNode = root.querySelector('[data-product-fbt-savings]');
        const statusNode = root.querySelector('[data-product-fbt-status]');

        const discountPercent = {{ block.settings.discount_percent | json }};
        const savingsPrefix = {{ block.settings.savings_prefix | json }};
        const buttonLabel = {{ block.settings.button_label | json }};
        const loadingLabel = {{ block.settings.loading_label | json }};
        const successLabel = {{ block.settings.success_label | json }};
        const emptySelectionLabel = {{ block.settings.empty_selection_label | json }};
        const errorLabel = {{ block.settings.error_label | json }};
        const moneyFormat = {{ shop.money_format | json }};
        const currencyCode = {{ cart.currency.iso_code | json }};

        const formatMoney = (cents) => {
          const value = Number(cents || 0);

          if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
            return window.Shopify.formatMoney(value, moneyFormat);
          }

          return new Intl.NumberFormat(document.documentElement.lang || 'en-US', {
            style: 'currency',
            currency: currencyCode
          }).format(value / 100);
        };

        const getSelectedItems = () => {
          return items
            .filter((item) => {
              const checkbox = item.querySelector('[data-product-fbt-checkbox]');
              return checkbox && checkbox.checked && !checkbox.disabled;
            })
            .map((item) => {
              const price = Number(item.dataset.price || 0);
              const comparePrice = Number(item.dataset.comparePrice || price);

              return {
                id: Number(item.dataset.variantId),
                quantity: 1,
                price,
                comparePrice
              };
            })
            .filter((item) => item.id);
        };

        const updateSummary = () => {
          const selectedItems = getSelectedItems();
          const subtotal = selectedItems.reduce((sum, item) => sum + item.price, 0);
          const compareTotal = selectedItems.reduce((sum, item) => sum + item.comparePrice, 0);
          const discount = discountPercent > 0 ? Math.round(subtotal * discountPercent / 100) : 0;
          const total = Math.max(subtotal - discount, 0);
          const savings = Math.max(compareTotal - total, 0);

          if (totalNode) {
            totalNode.textContent = formatMoney(total);
          }

          if (compareNode) {
            compareNode.textContent = formatMoney(compareTotal);
          }

          if (compareRow) {
            compareRow.hidden = compareTotal <= total;
          }

          if (savingsNode) {
            savingsNode.hidden = savings <= 0;
            savingsNode.textContent = `${savingsPrefix} ${formatMoney(savings)}`;
          }

          if (addButton) {
            addButton.disabled = selectedItems.length === 0;
          }
        };

        const setStatus = (message) => {
          if (statusNode) {
            statusNode.textContent = message;
          }
        };

        const dispatchCartEvents = (cartData) => {
          document.dispatchEvent(new CustomEvent('ajaxCart:refresh', {
            bubbles: true,
            detail: { cart: cartData }
          }));

          document.dispatchEvent(new CustomEvent('cart:updated', {
            bubbles: true,
            detail: { cart: cartData }
          }));

          document.dispatchEvent(new CustomEvent('qtm:cart:updated', {
            bubbles: true,
            detail: { cart: cartData }
          }));
        };

        checkboxes.forEach((checkbox) => {
          checkbox.addEventListener('change', updateSummary);
        });

        if (addButton) {
          addButton.addEventListener('click', async () => {
            const selectedItems = getSelectedItems();

            if (!selectedItems.length) {
              setStatus(emptySelectionLabel);
              return;
            }

            addButton.disabled = true;
            addButton.textContent = loadingLabel;
            setStatus('');

            try {
              const response = await fetch({{ routes.cart_add_url | append: '.js' | json }}, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  items: selectedItems.map((item) => ({
                    id: item.id,
                    quantity: item.quantity
                  }))
                })
              });

              if (!response.ok) {
                throw new Error('Bundle add failed');
              }

              const cartResponse = await fetch({{ routes.cart_url | append: '.js' | json }}, {
                headers: {
                  'Accept': 'application/json'
                }
              });

              const cartData = cartResponse.ok ? await cartResponse.json() : null;

              dispatchCartEvents(cartData);
              setStatus(successLabel);
            } catch (error) {
              setStatus(errorLabel);
            } finally {
              addButton.textContent = buttonLabel;
              updateSummary();
            }
          });
        }

        updateSummary();
      })();
    </script>
  {% elsif block.settings.show_empty_state %}
    <div class="product-frequently-bought-together__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

