{%- liquid
  assign block_id = 'content-recently-viewed-products-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign recently_layout = block.settings.recently_layout | default: 'grid'
  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-recently-viewed-products
    content-recently-viewed-products--{{ recently_layout }}
    content-recently-viewed-products--width-{{ width }}
    content-recently-viewed-products--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} content-recently-viewed-products--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} content-recently-viewed-products--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} content-recently-viewed-products--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} content-recently-viewed-products--animate content-recently-viewed-products--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-recently-viewed-products-margin-top: {{ block.settings.margin_top }}px;
    --content-recently-viewed-products-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-recently-viewed-products-padding: {{ block.settings.padding }}px;
    --content-recently-viewed-products-gap: {{ block.settings.grid_gap }}px;
    --content-recently-viewed-products-card-padding: {{ block.settings.card_padding }}px;
    --content-recently-viewed-products-card-radius: {{ block.settings.card_radius }}px;
    --content-recently-viewed-products-border-width: {{ block.settings.border_width }}px;
    --content-recently-viewed-products-columns-desktop: {{ block.settings.columns_desktop }};
    --content-recently-viewed-products-columns-tablet: {{ block.settings.columns_tablet }};
    --content-recently-viewed-products-columns-mobile: {{ block.settings.columns_mobile }};
    --content-recently-viewed-products-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-recently-viewed-products-heading-color: {{ block.settings.heading_color }};
    --content-recently-viewed-products-text-color: {{ block.settings.text_color }};
    --content-recently-viewed-products-price-color: {{ block.settings.price_color }};
    --content-recently-viewed-products-sale-color: {{ block.settings.sale_color }};
    --content-recently-viewed-products-background: {{ block.settings.background_color }};
    --content-recently-viewed-products-card-background: {{ block.settings.card_background_color }};
    --content-recently-viewed-products-border-color: {{ block.settings.border_color }};
    --content-recently-viewed-products-button-background: {{ block.settings.button_background_color }};
    --content-recently-viewed-products-button-text: {{ block.settings.button_text_color }};
    --content-recently-viewed-products-arrow-background: {{ block.settings.arrow_background_color }};
    --content-recently-viewed-products-arrow-text: {{ block.settings.arrow_text_color }};
    --content-recently-viewed-products-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-recently-viewed-products
  data-storage-key="{{ block.settings.storage_key | escape }}"
  data-product-limit="{{ block.settings.product_limit }}"
  data-exclude-current="{{ block.settings.exclude_current_product }}"
  data-layout="{{ recently_layout }}"
  data-qtm-recently-viewed data-qtm-product-cards data-carousel="{% if recently_layout == 'carousel' %}true{% else %}false{% endif %}"
  data-section-id="{{ section.id | escape }}" data-root-url="{{ routes.root_url | escape }}"
  data-current-handle="{{ product_context.handle | escape }}"
  data-page-product="{% if request.page_type == 'product' %}{{ product_context.handle | escape }}{% endif %}"
  data-show-when-empty="{{ block.settings.show_when_empty }}" data-design-mode="{{ request.design_mode }}"
  {% unless block.settings.show_when_empty or request.design_mode %}hidden{% endunless %}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-recently-viewed-products-margin-top);
      margin-bottom: var(--content-recently-viewed-products-margin-bottom);
      padding: min(var(--content-recently-viewed-products-padding), 8%);
      color: var(--content-recently-viewed-products-text-color);
      background: var(--content-recently-viewed-products-background);
    }

    #{{ block_id }}.content-recently-viewed-products--width-auto {
      max-width: 100%;
    }

    #{{ block_id }}.content-recently-viewed-products--width-small {
      max-width: min(100%, 900px);
    }

    #{{ block_id }}.content-recently-viewed-products--width-medium {
      max-width: min(100%, 1100px);
    }

    #{{ block_id }}.content-recently-viewed-products--width-large {
      max-width: min(100%, 1320px);
    }

    #{{ block_id }}.content-recently-viewed-products--width-full {
      max-width: 100%;
    }

    #{{ block_id }}.content-recently-viewed-products--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-recently-viewed-products--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-recently-viewed-products--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-recently-viewed-products__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-recently-viewed-products__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.content-recently-viewed-products--align-center .content-recently-viewed-products__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-recently-viewed-products__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .content-recently-viewed-products__eyebrow {
      margin: 0;
      color: var(--content-recently-viewed-products-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-recently-viewed-products__heading {
      margin: 0;
      color: var(--content-recently-viewed-products-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-recently-viewed-products__description {
      margin: 0;
      color: var(--content-recently-viewed-products-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-recently-viewed-products__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .content-recently-viewed-products__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--content-recently-viewed-products-arrow-text);
      background: var(--content-recently-viewed-products-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-recently-viewed-products__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-recently-viewed-products__arrow:focus-visible {
      outline: 2px solid var(--content-recently-viewed-products-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-recently-viewed-products__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .content-recently-viewed-products__items {
      display: grid;
      grid-template-columns: repeat(var(--content-recently-viewed-products-columns-desktop), minmax(0, 1fr));
      gap: var(--content-recently-viewed-products-gap);
      min-width: 0;
    }

    #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__items {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: thin;
      padding-bottom: 2px;
    }

    #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__items::-webkit-scrollbar {
      height: 8px;
    }

    #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__item {
      flex: 0 0 calc((100% - (var(--content-recently-viewed-products-gap) * (var(--content-recently-viewed-products-columns-desktop) - 1))) / var(--content-recently-viewed-products-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }} .content-recently-viewed-products__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--content-recently-viewed-products-text-color);
      text-decoration: none;
    }

    #{{ block_id }}.content-recently-viewed-products--grid .content-recently-viewed-products__card,
    #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__card,
    #{{ block_id }}.content-recently-viewed-products--cards .content-recently-viewed-products__card {
      padding: min(var(--content-recently-viewed-products-card-padding), 8%);
      background: var(--content-recently-viewed-products-card-background);
      border: var(--content-recently-viewed-products-border-width) solid var(--content-recently-viewed-products-border-color);
      border-radius: var(--content-recently-viewed-products-card-radius);
      overflow: hidden;
    }

    #{{ block_id }} .content-recently-viewed-products__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--content-recently-viewed-products-card-radius) - 8px), 0px);
      aspect-ratio: var(--content-recently-viewed-products-image-ratio);
    }

    #{{ block_id }} .content-recently-viewed-products__media img,
    #{{ block_id }} .content-recently-viewed-products__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .content-recently-viewed-products__card:hover .content-recently-viewed-products__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .content-recently-viewed-products__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .content-recently-viewed-products__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--content-recently-viewed-products-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .content-recently-viewed-products__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.content-recently-viewed-products--cards .content-recently-viewed-products__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-recently-viewed-products__vendor {
      color: var(--content-recently-viewed-products-text-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.68;
    }

    #{{ block_id }} .content-recently-viewed-products__title {
      margin: 0;
      color: var(--content-recently-viewed-products-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .content-recently-viewed-products__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .content-recently-viewed-products__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .content-recently-viewed-products__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--content-recently-viewed-products-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.content-recently-viewed-products--cards .content-recently-viewed-products__price-row {
      justify-content: center;
    }

    #{{ block_id }} .content-recently-viewed-products__price {
      color: var(--content-recently-viewed-products-price-color);
      font-weight: 700;
    }

    #{{ block_id }} .content-recently-viewed-products__compare {
      color: var(--content-recently-viewed-products-text-color);
      text-decoration: line-through;
      opacity: 0.55;
    }

    #{{ block_id }} .content-recently-viewed-products__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-recently-viewed-products-button-text);
      background: var(--content-recently-viewed-products-button-background);
      border: 1px solid var(--content-recently-viewed-products-button-background);
      border-radius: max(calc(var(--content-recently-viewed-products-card-radius) - 10px), 6px);
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.content-recently-viewed-products--cards .content-recently-viewed-products__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }} .content-recently-viewed-products__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-recently-viewed-products__media:focus-visible,
    #{{ block_id }} .content-recently-viewed-products__title a:focus-visible,
    #{{ block_id }} .content-recently-viewed-products__button:focus-visible {
      outline: 2px solid var(--content-recently-viewed-products-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-recently-viewed-products__empty {
      padding: 18px;
      color: var(--content-recently-viewed-products-text-color);
      background: var(--content-recently-viewed-products-card-background);
      border: var(--content-recently-viewed-products-border-width) solid var(--content-recently-viewed-products-border-color);
      border-radius: var(--content-recently-viewed-products-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-recently-viewed-products--hidden {
      display: none !important;
    }

    #{{ block_id }}.content-recently-viewed-products--animate {
      opacity: 1;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-recently-viewed-products--animate-fade {
      animation-name: contentRecentlyViewedProductsFade;
    }

    #{{ block_id }}.content-recently-viewed-products--animate-fade_up {
      animation-name: contentRecentlyViewedProductsFadeUp;
    }

    #{{ block_id }}.content-recently-viewed-products--animate-zoom {
      animation-name: contentRecentlyViewedProductsZoom;
    }

    @keyframes contentRecentlyViewedProductsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentRecentlyViewedProductsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentRecentlyViewedProductsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-recently-viewed-products--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-recently-viewed-products--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-recently-viewed-products__items {
        grid-template-columns: repeat(var(--content-recently-viewed-products-columns-tablet), minmax(0, 1fr));
      }

      #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__item {
        flex-basis: calc((100% - (var(--content-recently-viewed-products-gap) * (var(--content-recently-viewed-products-columns-tablet) - 1))) / var(--content-recently-viewed-products-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-recently-viewed-products--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-recently-viewed-products__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .content-recently-viewed-products__items {
        grid-template-columns: repeat(var(--content-recently-viewed-products-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__item {
        flex-basis: calc((100% - (var(--content-recently-viewed-products-gap) * (var(--content-recently-viewed-products-columns-mobile) - 1))) / var(--content-recently-viewed-products-columns-mobile));
      }

      #{{ block_id }} .content-recently-viewed-products__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .content-recently-viewed-products__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-recently-viewed-products--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__items {
        scroll-behavior: auto;
      }

      #{{ block_id }} .content-recently-viewed-products__media img,
      #{{ block_id }} .content-recently-viewed-products__button,
      #{{ block_id }} .content-recently-viewed-products__arrow {
        transition: none;
      }

      #{{ block_id }} .content-recently-viewed-products__card:hover .content-recently-viewed-products__media img,
      #{{ block_id }} .content-recently-viewed-products__button:hover,
      #{{ block_id }} .content-recently-viewed-products__arrow:hover {
        transform: none;
      }
    }
    #{{ block_id }} { min-width: 0; overflow-wrap: anywhere; container-type: inline-size; }
    #{{ block_id }}, #{{ block_id }} * { box-sizing: border-box; }
    #{{ block_id }}[hidden], #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} .content-recently-viewed-products__card { grid-template-rows: auto; align-content: start; }
    #{{ block_id }} .content-recently-viewed-products__badge--inline { position: static; width: fit-content; max-width: 100%; }
    #{{ block_id }} .content-recently-viewed-products__button { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
    #{{ block_id }} :focus-visible { outline: 2px solid var(--content-recently-viewed-products-focus-color); outline-offset: -3px; }
    #{{ block_id }} .content-recently-viewed-products__controls { flex-wrap: wrap; }
    @container (max-width: 749px) {
      #{{ block_id }} .content-recently-viewed-products__items { grid-template-columns: repeat(var(--content-recently-viewed-products-columns-mobile), minmax(0, 1fr)); }
      #{{ block_id }}.content-recently-viewed-products--carousel .content-recently-viewed-products__item { flex-basis: calc((100% - (var(--content-recently-viewed-products-gap) * (var(--content-recently-viewed-products-columns-mobile) - 1))) / var(--content-recently-viewed-products-columns-mobile)); }
      #{{ block_id }} .content-recently-viewed-products__heading { font-size: {{ block.settings.heading_size_mobile }}px; }
      #{{ block_id }} .content-recently-viewed-products__controls { {% unless block.settings.show_mobile_arrows %}display: none;{% endunless %} }
    }
  </style>

  <div class="content-recently-viewed-products__inner">
    {% if block.settings.show_header %}{% if block.settings.heading != blank or block.settings.eyebrow != blank or block.settings.description != blank %}
      <div class="content-recently-viewed-products__header">
        {% if block.settings.eyebrow != blank %}<p class="content-recently-viewed-products__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2 class="content-recently-viewed-products__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<p class="content-recently-viewed-products__description">{{ block.settings.description | escape }}</p>{% endif %}
      </div>
    {% endif %}{% endif %}
    {% if recently_layout == 'carousel' and block.settings.show_arrows %}
      <div class="content-recently-viewed-products__controls" data-card-controls hidden>
        <button type="button" class="content-recently-viewed-products__arrow" data-card-prev aria-controls="{{ block_id }}-items" aria-label="{{ block.settings.previous_label | default: 'Previous recently viewed products' | escape }}">‹</button>
        <button type="button" class="content-recently-viewed-products__arrow" data-card-next aria-controls="{{ block_id }}-items" aria-label="{{ block.settings.next_label | default: 'Next recently viewed products' | escape }}">›</button>
      </div>
    {% endif %}
    <div id="{{ block_id }}-items" class="content-recently-viewed-products__items" data-card-items role="region" aria-label="{{ block.settings.recently_viewed_label | default: 'Recently viewed products' | escape }}" {% if recently_layout == 'carousel' %}tabindex="0"{% endif %}></div>
    {% if block.settings.show_empty_state and block.settings.empty_text != blank %}<p class="content-recently-viewed-products__empty" data-card-empty>{{ block.settings.empty_text | escape }}</p>{% endif %}
    {% if request.design_mode %}<p role="note">This block shows each shopper's browsing history. Product cards appear on the storefront after products have been viewed.</p>{% endif %}
  </div>
  {% if product_context != blank %}<template data-recent-card-template>{% render 'qtm-block-product-card', card_product: product_context, block: block, prefix: 'content-recently-viewed-products', price_scope: 'product', media_policy: 'omit-missing', image_alt_fallback: block.settings.image_alt_fallback %}</template>{% endif %}
</div>
