    "reading-groups": {
      "type": "interactive-content-helper-tabs-accordion",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "label": "How do I join a reading group?",
            "icon": "",
            "anchor_id": "reading-groups",
            "content": "<p>Pick up the book, come to the back room on the posted date, and sit down. There is no sign-up and no fee. The current four books are on the Reading Together page.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "Do I have to finish the book?",
            "icon": "",
            "anchor_id": "do-i-have-to-finish-the-book",
            "content": "<p>No. Each session opens with a question rather than a summary, so you can take part wherever you are in the book.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Can my own group meet in the shop?",
            "icon": "",
            "anchor_id": "can-my-own-group-meet-in-the-shop",
            "content": "<p>Outside opening hours by arrangement. Use the contact form with a rough size and preferred evening.</p>"
          }
        }
      },
      "block_order": [
