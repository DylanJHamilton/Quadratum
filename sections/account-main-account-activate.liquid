{% comment %}
  Quadratum Account System
  File 8 of 10 — Customer Account Activation Only

  Handles:
  - Account activation password form
  - Password confirmation
  - Native Shopify activation submit
  - Native Shopify decline invitation action
  - Optional benefits/content panel
  - Optional accessible password visibility toggles

  Does NOT handle:
  - Login
  - Register
  - Dashboard
  - Orders
  - Addresses
  - Order tracking
{% endcomment %}

{{ 'account-main-account-activate.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_password_toggle %}
  <script src="{{ 'account-main-account-activate.js' | asset_url }}" defer="defer"></script>
{% endif %}

<section
  id="QtmAccountMainActivate-{{ section.id }}"
  class="
    qtmAccountActivate
    qtmAccountActivate--{{ section.settings.layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-subheading-size: {{ section.settings.subheading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-gap: {{ section.settings.field_spacing }}px;
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-field-radius: {{ section.settings.field_radius }}px;
    --qtm-account-field-padding: {{ section.settings.field_padding }}px;
    --qtm-account-button-radius: {{ section.settings.button_radius }}px;
    --qtm-account-button-padding: {{ section.settings.button_padding }}px;
  "
  data-qtm-account-activate
>
  <div class="qtmAccountActivate__shell">
    <div class="qtmAccountActivate__layout">
      <div class="qtmAccountActivate__formColumn">
        <div class="qtmAccountActivate__card">
          <header class="qtmAccountActivate__header">
            <h1 class="qtmAccountActivate__heading">
              {{ section.settings.heading | default: 'Activate your account' }}
            </h1>

            {% if section.settings.subheading != blank %}
              <p class="qtmAccountActivate__subheading">
                {{ section.settings.subheading }}
              </p>
            {% endif %}

            {% if section.settings.content != blank %}
              <div class="qtmAccountActivate__content rte">
                {{ section.settings.content }}
              </div>
            {% endif %}
          </header>

          {% form 'activate_customer_password', class: 'qtmAccountActivate__form', novalidate: 'novalidate' %}
            {% if form.errors %}
              <div
                class="qtmAccountActivate__errors"
                role="alert"
                aria-live="assertive"
                tabindex="-1"
              >
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="qtmAccountActivate__field">
              <label for="QtmAccountActivatePassword-{{ section.id }}">
                Password <span aria-hidden="true">*</span>
              </label>

              <div class="qtmAccountActivate__passwordField">
                <input
                  id="QtmAccountActivatePassword-{{ section.id }}"
                  type="password"
                  name="customer[password]"
                  autocomplete="new-password"
                  {% if form.errors contains 'password' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                  data-qtm-account-activate-password-input
                >

                {% if section.settings.show_password_toggle %}
                  <button
                    type="button"
                    class="qtmAccountActivate__passwordToggle"
                    aria-label="Show password"
                    data-qtm-account-activate-password-toggle
                    data-show-label="Show password"
                    data-hide-label="Hide password"
                  >
                    <span data-qtm-account-activate-password-toggle-text>
                      Show
                    </span>
                  </button>
                {% endif %}
              </div>
            </div>

            <div class="qtmAccountActivate__field">
              <label for="QtmAccountActivatePasswordConfirmation-{{ section.id }}">
                Confirm password <span aria-hidden="true">*</span>
              </label>

              <div class="qtmAccountActivate__passwordField">
                <input
                  id="QtmAccountActivatePasswordConfirmation-{{ section.id }}"
                  type="password"
                  name="customer[password_confirmation]"
                  autocomplete="new-password"
                  {% if form.errors contains 'password_confirmation' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                  data-qtm-account-activate-password-input
                >

                {% if section.settings.show_password_toggle %}
                  <button
                    type="button"
                    class="qtmAccountActivate__passwordToggle"
                    aria-label="Show password"
                    data-qtm-account-activate-password-toggle
                    data-show-label="Show password"
                    data-hide-label="Hide password"
                  >
                    <span data-qtm-account-activate-password-toggle-text>
                      Show
                    </span>
                  </button>
                {% endif %}
              </div>
            </div>

            <div class="qtmAccountActivate__actions">
              <button
                type="submit"
                class="qtmAccountActivate__button qtmAccountActivate__button--{{ section.settings.button_style }}"
              >
                {{ section.settings.activate_button_label | default: 'Activate Account' }}
              </button>

              {% comment %}
                Shopify supports invitation decline from the native activation form
                by submitting the form with a button named "decline".
              {% endcomment %}
              <button
                type="submit"
                name="decline"
                class="qtmAccountActivate__declineButton"
              >
                {{ section.settings.decline_button_label | default: 'Decline Invitation' }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>

      {% if section.settings.benefits_heading != blank or section.settings.benefits_text != blank or section.blocks.size > 0 %}
        <aside class="qtmAccountActivate__benefitsColumn" aria-label="Account activation benefits">
          <div class="qtmAccountActivate__benefitsCard">
            {% if section.settings.benefits_heading != blank %}
              <h2 class="qtmAccountActivate__benefitsHeading">
                {{ section.settings.benefits_heading }}
              </h2>
            {% endif %}

            {% if section.settings.benefits_text != blank %}
              <div class="qtmAccountActivate__benefitsText rte">
                {{ section.settings.benefits_text }}
              </div>
            {% endif %}

            {% if section.blocks.size > 0 %}
              <div class="qtmAccountActivate__benefitsList">
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when 'benefit' %}
                      <div class="qtmAccountActivate__benefit" {{ block.shopify_attributes }}>
                        {% if block.settings.icon != blank %}
                          <div class="qtmAccountActivate__benefitIcon" aria-hidden="true">
                            {{ block.settings.icon }}
                          </div>
                        {% endif %}

                        <div class="qtmAccountActivate__benefitContent">
                          {% if block.settings.title != blank %}
                            <h3 class="qtmAccountActivate__benefitTitle">
                              {{ block.settings.title }}
                            </h3>
                          {% endif %}

                          {% if block.settings.text != blank %}
                            <p class="qtmAccountActivate__benefitText">
                              {{ block.settings.text }}
                            </p>
                          {% endif %}
                        </div>
                      </div>
                  {% endcase %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account Main Activate",
  "tag": "section",
  "class": "qtm-account-main-activate",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Activate your account"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Create a password to complete your account setup."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Once activated, you can access your account details, orders, and saved addresses.</p>"
    },
    {
      "type": "text",
      "id": "activate_button_label",
      "label": "Activate button label",
      "default": "Activate Account"
    },
    {
      "type": "text",
      "id": "decline_button_label",
      "label": "Decline button label",
      "default": "Decline Invitation"
    },
    {
      "type": "checkbox",
      "id": "show_password_toggle",
      "label": "Show password toggles",
      "default": true
    },
    {
      "type": "header",
      "content": "Benefits panel"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Your account is almost ready"
    },
    {
      "type": "richtext",
      "id": "benefits_text",
      "label": "Benefits text",
      "default": "<p>Activate your account to manage your customer experience in one place.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Fields"
    },
    {
      "type": "range",
      "id": "field_radius",
      "label": "Field radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "field_padding",
      "label": "Field padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "field_spacing",
      "label": "Field spacing",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "View order history"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Access past orders from your customer account."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Account Main Activate",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "View order history",
            "text": "Review previous purchases from your account."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Track shipments",
            "text": "Follow order progress from your account area."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Save addresses",
            "text": "Make future checkouts easier with saved details."
          }
        }
      ]
    }
  ]
}
{% endschema %}