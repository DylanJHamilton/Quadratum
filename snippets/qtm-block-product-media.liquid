{%- liquid
  assign media_alt = media.alt | default: product.title
  assign mute_value = 0
  if muted
    assign mute_value = 1
  endif
-%}
{%- case media.media_type -%}
  {%- when 'image' -%}
    {{ media | image_url: width: 1800 | image_tag: loading: image_loading, widths: '400, 600, 800, 1000, 1400, 1800', alt: media_alt }}
  {%- when 'video' -%}
    {{ media | video_tag: image_size: '1200x', controls: true, autoplay: false, muted: muted, playsinline: true, preload: 'metadata', aria-label: media_alt }}
  {%- when 'external_video' -%}
    {%- assign video_id = media.external_id | url_encode -%}
    {%- if media.host == 'youtube' or media.host == 'vimeo' -%}
      <a data-gallery-embed-link href="{% if media.host == 'youtube' %}https://www.youtube.com/watch?v={{ video_id }}{% else %}https://vimeo.com/{{ video_id }}{% endif %}" target="_blank" rel="noopener noreferrer" aria-label="{{ media_alt | escape }}">
        {% if media.preview_image %}{{ media.preview_image | image_url: width: 1400 | image_tag: loading: image_loading, alt: '' }}{% endif %}
        <span>▶ {{ media_alt | escape }}</span>
      </a>
      <template data-gallery-embed-template>{{ media | external_video_url: autoplay: 0, mute: mute_value, muted: mute_value | external_video_tag: title: media_alt, loading: 'lazy' }}</template>
    {%- endif -%}
  {%- when 'model' -%}
    {{ media | model_viewer_tag: image_size: '1200x', alt: media_alt }}
    <div data-gallery-model-fallback>
      {% if media.preview_image %}{{ media.preview_image | image_url: width: 1400 | image_tag: loading: image_loading, alt: media_alt }}{% endif %}
      <div class="product-gallery__model-links">{% for source in media.sources %}<a href="{{ source.url | escape }}">{{ media_alt | escape }} ({{ source.format | default: '3D' | escape }})</a>{% endfor %}</div>
    </div>
{%- endcase -%}
