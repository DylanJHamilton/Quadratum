    "orvaine_4": {
      "type": "form-support-request",
      "settings": {
        "template_style": "split",
        "surface_style": "card",
        "split_media_side": "right",
        "split_image": "shopify://shop_images/orvaine-wallets-small-leather-goods-editorial.webp",
        "kicker": "Ask a question",
        "heading": "Write to client care.",
        "subheading": "Fields marked with an asterisk are required.",
        "success_text": "Thank you. We will reply by email.",
        "destination": "shopify_contact",
        "hidden_tags": "client-care, orvaine",
        "button_label": "Send question",
        "bg_color": "#F8F6F2",
        "form_bg": "#FFFFFF",
        "input_radius": 2,
        "input_border": "#8F8478",
        "card_radius": 4,
        "anchor_id": "request"
      },
      "blocks": {
        "or_field_1": {
          "type": "field",
          "settings": {
            "label": "Full name",
            "field_type": "text",
            "name_attr": "contact[name]",
            "required": true,
            "width": "half"
          }
        },
        "or_field_2": {
          "type": "field",
          "settings": {
            "label": "Email",
            "field_type": "email",
            "name_attr": "contact[email]",
            "required": true,
            "width": "half"
          }
        },
        "or_field_3": {
          "type": "field",
          "settings": {
            "label": "Topic",
            "field_type": "select",
            "name_attr": "contact[topic]",
            "required": true,
            "width": "half",
            "options": "A specific design\nSpecifications\nColors\nCare\nThis concept store\nSomething else"
          }
        },
        "or_field_4": {
          "type": "field",
          "settings": {
            "label": "Design name or SKU",
            "field_type": "text",
            "name_attr": "contact[design]",
            "required": false,
            "width": "half",
            "help_text": "Optional. For example, ORV-001-OXBLOOD."
          }
        },
        "or_field_5": {
          "type": "field",
          "settings": {
            "label": "Your question",
            "field_type": "textarea",
            "name_attr": "contact[body]",
            "required": true,
            "width": "full"
          }
        }
      },
      "block_order": [
        "or_field_1",
        "or_field_2",
        "or_field_3",
        "or_field_4",
