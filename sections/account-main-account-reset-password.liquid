{% comment %}
  Quadratum Account System
  File 9 of 10 — Reset Password Only

  Handles:
  - Customer reset password form
  - New password field
  - Password confirmation field
  - Native Shopify reset password submit
  - Optional help/reassurance panel
  - Optional accessible password visibility toggles

  Does NOT handle:
  - Login
  - Register
  - Dashboard
  - Orders
  - Addresses
  - Activation
  - Order tracking
{% endcomment %}

{{ 'account-main-account-reset-password.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_password_toggle %}
  <script src="{{ 'account-main-account-reset-password.js' | asset_url }}" defer="defer"></script>
{% endif %}

<section
  id="QtmAccountMainResetPassword-{{ section.id }}"
  class="
    qtmAccountResetPassword
    qtmAccountResetPassword--{{ section.settings.layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-subheading-size: {{ section.settings.subheading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-gap: {{ section.settings.field_spacing }}px;
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-field-radius: {{ section.settings.field_radius }}px;
    --qtm-account-field-padding: {{ section.settings.field_padding }}px;
    --qtm-account-button-radius: {{ section.settings.button_radius }}px;
    --qtm-account-button-padding: {{ section.settings.button_padding }}px;
  "
  data-qtm-account-reset-password
>
  <div class="qtmAccountResetPassword__shell">
    <div class="qtmAccountResetPassword__layout">
      <div class="qtmAccountResetPassword__formColumn">
        <div class="qtmAccountResetPassword__card">
          <header class="qtmAccountResetPassword__header">
            <h1 class="qtmAccountResetPassword__heading">
              {{ section.settings.heading | default: 'Reset your password' }}
            </h1>

            {% if section.settings.subheading != blank %}
              <p class="qtmAccountResetPassword__subheading">
                {{ section.settings.subheading }}
              </p>
            {% endif %}

            {% if section.settings.content != blank %}
              <div class="qtmAccountResetPassword__content rte">
                {{ section.settings.content }}
              </div>
            {% endif %}
          </header>

          {% form 'reset_customer_password', class: 'qtmAccountResetPassword__form', novalidate: 'novalidate' %}
            {% if form.errors %}
              <div
                class="qtmAccountResetPassword__errors"
                role="alert"
                aria-live="assertive"
                tabindex="-1"
              >
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="qtmAccountResetPassword__field">
              <label for="QtmAccountResetPasswordInput-{{ section.id }}">
                New password <span aria-hidden="true">*</span>
              </label>

              <div class="qtmAccountResetPassword__passwordField">
                <input
                  id="QtmAccountResetPasswordInput-{{ section.id }}"
                  type="password"
                  name="customer[password]"
                  autocomplete="new-password"
                  {% if form.errors contains 'password' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                  data-qtm-account-reset-password-input
                >

                {% if section.settings.show_password_toggle %}
                  <button
                    type="button"
                    class="qtmAccountResetPassword__passwordToggle"
                    aria-label="Show password"
                    data-qtm-account-reset-password-toggle
                    data-show-label="Show password"
                    data-hide-label="Hide password"
                  >
                    <span data-qtm-account-reset-password-toggle-text>
                      Show
                    </span>
                  </button>
                {% endif %}
              </div>
            </div>

            <div class="qtmAccountResetPassword__field">
              <label for="QtmAccountResetPasswordConfirmation-{{ section.id }}">
                Confirm password <span aria-hidden="true">*</span>
              </label>

              <div class="qtmAccountResetPassword__passwordField">
                <input
                  id="QtmAccountResetPasswordConfirmation-{{ section.id }}"
                  type="password"
                  name="customer[password_confirmation]"
                  autocomplete="new-password"
                  {% if form.errors contains 'password_confirmation' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                  data-qtm-account-reset-password-input
                >

                {% if section.settings.show_password_toggle %}
                  <button
                    type="button"
                    class="qtmAccountResetPassword__passwordToggle"
                    aria-label="Show password"
                    data-qtm-account-reset-password-toggle
                    data-show-label="Show password"
                    data-hide-label="Hide password"
                  >
                    <span data-qtm-account-reset-password-toggle-text>
                      Show
                    </span>
                  </button>
                {% endif %}
              </div>
            </div>

            <div class="qtmAccountResetPassword__actions">
              <button
                type="submit"
                class="qtmAccountResetPassword__button qtmAccountResetPassword__button--{{ section.settings.button_style }}"
              >
                {{ section.settings.reset_button_label | default: 'Reset Password' }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>

      {% if section.settings.help_heading != blank or section.settings.help_text != blank or section.settings.support_link_label != blank %}
        <aside class="qtmAccountResetPassword__helpColumn" aria-label="Password reset help">
          <div class="qtmAccountResetPassword__helpCard">
            {% if section.settings.help_heading != blank %}
              <h2 class="qtmAccountResetPassword__helpHeading">
                {{ section.settings.help_heading }}
              </h2>
            {% endif %}

            {% if section.settings.help_text != blank %}
              <div class="qtmAccountResetPassword__helpText rte">
                {{ section.settings.help_text }}
              </div>
            {% endif %}

            {% if section.settings.support_link_label != blank and section.settings.support_link_url != blank %}
              <a
                href="{{ section.settings.support_link_url }}"
                class="qtmAccountResetPassword__supportLink"
              >
                {{ section.settings.support_link_label }}
              </a>
            {% endif %}
          </div>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account Reset Password",
  "tag": "section",
  "class": "qtm-account-main-reset-password",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reset your password"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Enter a new password for your account."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Choose a secure password you have not used before.</p>"
    },
    {
      "type": "text",
      "id": "reset_button_label",
      "label": "Reset button label",
      "default": "Reset Password"
    },
    {
      "type": "checkbox",
      "id": "show_password_toggle",
      "label": "Show password toggles",
      "default": true
    },
    {
      "type": "header",
      "content": "Help panel"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help heading",
      "default": "Password security"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help text",
      "default": "<p>Use a strong password with a mix of letters, numbers, and symbols. Avoid using the same password across multiple websites.</p>"
    },
    {
      "type": "text",
      "id": "support_link_label",
      "label": "Support link label",
      "default": "Need help? Contact support"
    },
    {
      "type": "url",
      "id": "support_link_url",
      "label": "Support link URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Fields"
    },
    {
      "type": "range",
      "id": "field_radius",
      "label": "Field radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "field_padding",
      "label": "Field padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "field_spacing",
      "label": "Field spacing",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Account Main Reset Password"
    }
  ]
}
{% endschema %}