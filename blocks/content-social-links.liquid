{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation

  assign instagram_url = block.settings.instagram_url
  assign tiktok_url = block.settings.tiktok_url
  assign facebook_url = block.settings.facebook_url
  assign youtube_url = block.settings.youtube_url
  assign pinterest_url = block.settings.pinterest_url
  assign twitter_url = block.settings.twitter_url
  assign linkedin_url = block.settings.linkedin_url

  if instagram_url == blank and settings.social_instagram_link != blank
    assign instagram_url = settings.social_instagram_link
  endif

  if tiktok_url == blank and settings.social_tiktok_link != blank
    assign tiktok_url = settings.social_tiktok_link
  endif

  if facebook_url == blank and settings.social_facebook_link != blank
    assign facebook_url = settings.social_facebook_link
  endif

  if youtube_url == blank and settings.social_youtube_link != blank
    assign youtube_url = settings.social_youtube_link
  endif

  if pinterest_url == blank and settings.social_pinterest_link != blank
    assign pinterest_url = settings.social_pinterest_link
  endif

  if twitter_url == blank and settings.social_twitter_link != blank
    assign twitter_url = settings.social_twitter_link
  endif

  if linkedin_url == blank and settings.social_linkedin_link != blank
    assign linkedin_url = settings.social_linkedin_link
  endif
%}

<div
  class="
    qtm-social-links
    qtm-social-links-{{ block_id }}
    qtm-social-links--width-{{ block_width }}
    qtm-social-links--align-{{ block_alignment }}
    qtm-social-links--layout-{{ block.settings.layout_style }}
    qtm-social-links--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-social-links--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-social-links--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-social-links--hide-mobile{% endunless %}
  "
  style="
    --qtm-social-links-margin-top: {{ block.settings.margin_top }}px;
    --qtm-social-links-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-social-links-padding: {{ block.settings.padding }}px;
    --qtm-social-links-gap: {{ block.settings.gap }}px;
    --qtm-social-links-heading-color: {{ block.settings.heading_color }};
    --qtm-social-links-text-color: {{ block.settings.text_color }};
    --qtm-social-links-background-color: {{ block.settings.background_color }};
    --qtm-social-links-item-background: {{ block.settings.item_background_color }};
    --qtm-social-links-border-color: {{ block.settings.border_color }};
    --qtm-social-links-link-color: {{ block.settings.link_color }};
    --qtm-social-links-icon-background: {{ block.settings.icon_background_color }};
    --qtm-social-links-icon-color: {{ block.settings.icon_color }};
    --qtm-social-links-border-width: {{ block.settings.border_width }}px;
    --qtm-social-links-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-social-links__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-social-links__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-social-links__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-social-links__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-social-links__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <nav class="qtm-social-links__nav" aria-label="{{ block.settings.nav_label | escape }}">
      <ul class="qtm-social-links__list" role="list">
        {% if instagram_url != blank and block.settings.show_instagram %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <span class="qtm-social-links__icon" aria-hidden="true">IG</span>
              <span class="qtm-social-links__label">Instagram</span>
            </a>
          </li>
        {% endif %}

        {% if tiktok_url != blank and block.settings.show_tiktok %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
              <span class="qtm-social-links__icon" aria-hidden="true">TT</span>
              <span class="qtm-social-links__label">TikTok</span>
            </a>
          </li>
        {% endif %}

        {% if facebook_url != blank and block.settings.show_facebook %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
              <span class="qtm-social-links__icon" aria-hidden="true">FB</span>
              <span class="qtm-social-links__label">Facebook</span>
            </a>
          </li>
        {% endif %}

        {% if youtube_url != blank and block.settings.show_youtube %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
              <span class="qtm-social-links__icon" aria-hidden="true">YT</span>
              <span class="qtm-social-links__label">YouTube</span>
            </a>
          </li>
        {% endif %}

        {% if pinterest_url != blank and block.settings.show_pinterest %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest">
              <span class="qtm-social-links__icon" aria-hidden="true">PT</span>
              <span class="qtm-social-links__label">Pinterest</span>
            </a>
          </li>
        {% endif %}

        {% if twitter_url != blank and block.settings.show_twitter %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ twitter_url }}" target="_blank" rel="noopener" aria-label="X or Twitter">
              <span class="qtm-social-links__icon" aria-hidden="true">X</span>
              <span class="qtm-social-links__label">X / Twitter</span>
            </a>
          </li>
        {% endif %}

        {% if linkedin_url != blank and block.settings.show_linkedin %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <span class="qtm-social-links__icon" aria-hidden="true">IN</span>
              <span class="qtm-social-links__label">LinkedIn</span>
            </a>
          </li>
        {% endif %}

        {% if block.settings.custom_url != blank and block.settings.show_custom %}
          <li class="qtm-social-links__item">
            <a class="qtm-social-links__link" href="{{ block.settings.custom_url }}" target="_blank" rel="noopener" aria-label="{{ block.settings.custom_label | escape }}">
              <span class="qtm-social-links__icon" aria-hidden="true">
                {{ block.settings.custom_icon | default: '↗' | escape }}
              </span>
              <span class="qtm-social-links__label">
                {{ block.settings.custom_label | escape }}
              </span>
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>
  </div>
</div>

<style>
  .qtm-social-links-{{ block_id }} {
    margin-top: var(--qtm-social-links-margin-top);
    margin-bottom: var(--qtm-social-links-margin-bottom);
    padding: var(--qtm-social-links-padding);
    color: var(--qtm-social-links-text-color);
    background: var(--qtm-social-links-background-color);
    border: var(--qtm-social-links-border-width) solid var(--qtm-social-links-border-color);
    border-radius: var(--qtm-social-links-border-radius);
  }

  .qtm-social-links-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--width-auto {
    width: auto;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--width-small {
    max-width: 560px;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--width-medium {
    max-width: 760px;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--width-large {
    max-width: 1040px;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__inner {
    display: grid;
    gap: var(--qtm-social-links-gap);
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__header {
    display: grid;
    gap: 0.75rem;
    max-width: 680px;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-center .qtm-social-links__header {
    margin-inline: auto;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-right .qtm-social-links__header {
    margin-left: auto;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__eyebrow {
    margin: 0;
    color: var(--qtm-social-links-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__heading {
    margin: 0;
    color: var(--qtm-social-links-heading-color);
    line-height: 1.05;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__text {
    color: var(--qtm-social-links-text-color);
    line-height: 1.7;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__text p {
    margin-top: 0;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__list {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--qtm-social-links-gap) * 0.5);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-center .qtm-social-links__list {
    justify-content: center;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--align-right .qtm-social-links__list {
    justify-content: flex-end;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 2.8rem;
    color: var(--qtm-social-links-link-color);
    background: var(--qtm-social-links-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-social-links-border-color), transparent 8%);
    border-radius: calc(var(--qtm-social-links-border-radius) * 0.55);
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease, background 180ms ease;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__link:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__link:focus-visible {
    outline: 3px solid var(--qtm-social-links-link-color);
    outline-offset: 4px;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--qtm-social-links-icon-color);
    background: var(--qtm-social-links-icon-background);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .qtm-social-links-{{ block_id }} .qtm-social-links__label {
    color: inherit;
    white-space: nowrap;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons .qtm-social-links__link {
    width: 2.8rem;
    padding: 0;
    border-radius: 999px;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons .qtm-social-links__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons .qtm-social-links__icon {
    width: 100%;
    height: 100%;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons-text .qtm-social-links__link {
    padding: 0.35rem 0.9rem 0.35rem 0.35rem;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-buttons .qtm-social-links__link {
    padding: 0.8rem 1rem;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-minimal .qtm-social-links__link {
    min-height: auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--layout-minimal .qtm-social-links__icon {
    width: auto;
    height: auto;
    color: var(--qtm-social-links-link-color);
    background: transparent;
    border-radius: 0;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--animation-fade {
    animation: qtm-social-links-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--animation-fade-up {
    animation: qtm-social-links-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--animation-fade-down {
    animation: qtm-social-links-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--animation-fade-left {
    animation: qtm-social-links-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--animation-fade-right {
    animation: qtm-social-links-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-social-links-{{ block_id }}.qtm-social-links--animation-zoom {
    animation: qtm-social-links-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-social-links-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-social-links-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-social-links-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-social-links-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-social-links-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-social-links-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-social-links-{{ block_id }}.qtm-social-links--hide-tablet {
      display: none !important;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-social-links-{{ block_id }}.qtm-social-links--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-social-links-{{ block_id }} {
      padding: min(var(--qtm-social-links-padding), 24px);
    }

    .qtm-social-links-{{ block_id }}.qtm-social-links--hide-mobile {
      display: none !important;
    }

    .qtm-social-links-{{ block_id }}.qtm-social-links--layout-buttons .qtm-social-links__list,
    .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons-text .qtm-social-links__list {
      align-items: stretch;
    }

    .qtm-social-links-{{ block_id }}.qtm-social-links--layout-buttons .qtm-social-links__item,
    .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons-text .qtm-social-links__item {
      flex: 1 1 100%;
    }

    .qtm-social-links-{{ block_id }}.qtm-social-links--layout-buttons .qtm-social-links__link,
    .qtm-social-links-{{ block_id }}.qtm-social-links--layout-icons-text .qtm-social-links__link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-social-links-{{ block_id }},
    .qtm-social-links-{{ block_id }} *,
    .qtm-social-links-{{ block_id }} *::before,
    .qtm-social-links-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Social links",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Connect"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Follow along for updates, launches, behind-the-scenes content, and community moments.</p>"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation label",
      "default": "Social media links"
    },
    {
      "type": "header",
      "content": "Social platforms"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL override"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL override"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL override"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "Show YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL override"
    },
    {
      "type": "checkbox",
      "id": "show_pinterest",
      "label": "Show Pinterest",
      "default": true
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL override"
    },
    {
      "type": "checkbox",
      "id": "show_twitter",
      "label": "Show X / Twitter",
      "default": true
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter URL override"
    },
    {
      "type": "checkbox",
      "id": "show_linkedin",
      "label": "Show LinkedIn",
      "default": true
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL override"
    },
    {
      "type": "checkbox",
      "id": "show_custom",
      "label": "Show custom link",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Custom label",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "custom_icon",
      "label": "Custom icon text",
      "default": "↗"
    },
    {
      "type": "url",
      "id": "custom_url",
      "label": "Custom URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "icons",
      "options": [
        {
          "value": "icons",
          "label": "Icons"
        },
        {
          "value": "icons-text",
          "label": "Icons with text"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
