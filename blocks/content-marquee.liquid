{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-marquee
    qtm-marquee-{{ block_id }}
    qtm-marquee--width-{{ block_width }}
    qtm-marquee--align-{{ block_alignment }}
    qtm-marquee--type-{{ block.settings.marquee_type }}
    qtm-marquee--direction-{{ block.settings.direction }}
    qtm-marquee--animation-{{ animation }}
    {% if block.settings.pause_on_hover %} qtm-marquee--pause-hover{% endif %}
    {% unless block.settings.show_desktop %} qtm-marquee--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-marquee--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-marquee--hide-mobile{% endunless %}
  "
  style="
    --qtm-marquee-margin-top: {{ block.settings.margin_top }}px;
    --qtm-marquee-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-marquee-padding: {{ block.settings.padding }}px;
    --qtm-marquee-gap: {{ block.settings.gap }}px;
    --qtm-marquee-speed: {{ block.settings.speed }}s;
    --qtm-marquee-heading-color: {{ block.settings.heading_color }};
    --qtm-marquee-text-color: {{ block.settings.text_color }};
    --qtm-marquee-background-color: {{ block.settings.background_color }};
    --qtm-marquee-border-color: {{ block.settings.border_color }};
    --qtm-marquee-link-color: {{ block.settings.link_color }};
    --qtm-marquee-item-background: {{ block.settings.item_background_color }};
    --qtm-marquee-border-width: {{ block.settings.border_width }}px;
    --qtm-marquee-border-radius: {{ block.settings.border_radius }}px;
  "
  aria-label="{{ block.settings.accessibility_label | default: 'Marquee' | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="qtm-marquee__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-marquee__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-marquee__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-marquee__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-marquee__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-marquee__viewport">
      <div class="qtm-marquee__track" aria-hidden="false">
        {% for repeat in (1..2) %}
          <div class="qtm-marquee__group" {% if repeat == 2 %}aria-hidden="true"{% endif %}>
            {% for i in (1..8) %}
              {% liquid
                assign enabled_key = 'item_' | append: i | append: '_enabled'
                assign text_key = 'item_' | append: i | append: '_text'
                assign image_key = 'item_' | append: i | append: '_image'
                assign link_key = 'item_' | append: i | append: '_link'

                assign item_enabled = block.settings[enabled_key]
                assign item_text = block.settings[text_key]
                assign item_image = block.settings[image_key]
                assign item_link = block.settings[link_key]
              %}

              {% if item_enabled %}
                <div class="qtm-marquee__item">
                  {% if item_link != blank %}
                    <a class="qtm-marquee__item-link" href="{{ item_link }}">
                  {% else %}
                    <span class="qtm-marquee__item-static">
                  {% endif %}

                    {% if block.settings.marquee_type == 'logos' and item_image != blank %}
                      {{
                        item_image
                        | image_url: width: 360
                        | image_tag:
                          class: 'qtm-marquee__logo',
                          loading: 'lazy',
                          widths: '120, 180, 240, 300, 360',
                          sizes: '180px',
                          alt: item_image.alt
                      }}
                    {% elsif item_image != blank and block.settings.show_item_images %}
                      {{
                        item_image
                        | image_url: width: 160
                        | image_tag:
                          class: 'qtm-marquee__icon-image',
                          loading: 'lazy',
                          widths: '60, 90, 120, 160',
                          sizes: '60px',
                          alt: item_image.alt
                      }}
                    {% endif %}

                    {% if item_text != blank %}
                      <span class="qtm-marquee__item-text">
                        {{ item_text | escape }}
                      </span>
                    {% endif %}

                  {% if item_link != blank %}
                    </a>
                  {% else %}
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.show_separator and block.settings.marquee_type != 'logos' %}
                  <span class="qtm-marquee__separator" aria-hidden="true">
                    {{ block.settings.separator_text | escape }}
                  </span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  .qtm-marquee-{{ block_id }} {
    margin-top: var(--qtm-marquee-margin-top);
    margin-bottom: var(--qtm-marquee-margin-bottom);
    padding: var(--qtm-marquee-padding);
    color: var(--qtm-marquee-text-color);
    background: var(--qtm-marquee-background-color);
    border: var(--qtm-marquee-border-width) solid var(--qtm-marquee-border-color);
    border-radius: var(--qtm-marquee-border-radius);
    overflow: hidden;
  }

  .qtm-marquee-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--width-auto {
    width: auto;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--width-small {
    max-width: 720px;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--width-medium {
    max-width: 960px;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--width-large {
    max-width: 1240px;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__inner {
    display: grid;
    gap: var(--qtm-marquee-gap);
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__header {
    display: grid;
    gap: 0.7rem;
    max-width: 780px;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--align-center .qtm-marquee__header {
    margin-inline: auto;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--align-right .qtm-marquee__header {
    margin-left: auto;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__eyebrow {
    margin: 0;
    color: var(--qtm-marquee-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__heading {
    margin: 0;
    color: var(--qtm-marquee-heading-color);
    line-height: 1.05;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__text {
    color: var(--qtm-marquee-text-color);
    line-height: 1.7;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__text p {
    margin-top: 0;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: calc(var(--qtm-marquee-border-radius) * 0.65);
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__viewport::before,
  .qtm-marquee-{{ block_id }} .qtm-marquee__viewport::after {
    content: "";
    position: absolute;
    top: 0;
    z-index: 3;
    width: min(9vw, 90px);
    height: 100%;
    pointer-events: none;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--qtm-marquee-background-color), transparent);
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--qtm-marquee-background-color), transparent);
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__track {
    display: flex;
    width: max-content;
    animation: qtm-marquee-scroll-{{ block_id }} var(--qtm-marquee-speed) linear infinite;
    will-change: transform;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--direction-right .qtm-marquee__track {
    animation-name: qtm-marquee-scroll-reverse-{{ block_id }};
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--pause-hover:hover .qtm-marquee__track,
  .qtm-marquee-{{ block_id }}.qtm-marquee--pause-hover:focus-within .qtm-marquee__track {
    animation-play-state: paused;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--qtm-marquee-gap);
    min-width: max-content;
    padding-right: var(--qtm-marquee-gap);
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__item {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__item-link,
  .qtm-marquee-{{ block_id }} .qtm-marquee__item-static {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: {{ block.settings.item_min_height }}px;
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    color: var(--qtm-marquee-text-color);
    background: var(--qtm-marquee-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-marquee-border-color), transparent 20%);
    border-radius: calc(var(--qtm-marquee-border-radius) * 0.55);
    text-decoration: none;
    white-space: nowrap;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__item-link {
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__item-link:hover {
    opacity: 0.78;
    transform: translateY(-1px);
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__item-link:focus-visible {
    outline: 3px solid var(--qtm-marquee-link-color);
    outline-offset: 4px;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__item-text {
    color: inherit;
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}em;
    line-height: 1;
    text-transform: {% if block.settings.uppercase_text %}uppercase{% else %}none{% endif %};
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__logo {
    display: block;
    width: auto;
    max-width: {{ block.settings.logo_max_width }}px;
    height: {{ block.settings.logo_height }}px;
    object-fit: contain;
    opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};
    filter: {% if block.settings.logo_grayscale %}grayscale(1){% else %}none{% endif %};
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__icon-image {
    display: block;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    object-fit: contain;
    border-radius: 999px;
  }

  .qtm-marquee-{{ block_id }} .qtm-marquee__separator {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: var(--qtm-marquee-link-color);
    font-size: {{ block.settings.separator_size }}px;
    font-weight: 800;
    line-height: 1;
    opacity: 0.72;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--type-logos .qtm-marquee__item-link,
  .qtm-marquee-{{ block_id }}.qtm-marquee--type-logos .qtm-marquee__item-static {
    min-width: {{ block.settings.logo_item_width }}px;
    background: var(--qtm-marquee-item-background);
  }

  @keyframes qtm-marquee-scroll-{{ block_id }} {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @keyframes qtm-marquee-scroll-reverse-{{ block_id }} {
    from {
      transform: translateX(-50%);
    }

    to {
      transform: translateX(0);
    }
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--animation-fade {
    animation: qtm-marquee-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--animation-fade-up {
    animation: qtm-marquee-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--animation-fade-down {
    animation: qtm-marquee-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--animation-fade-left {
    animation: qtm-marquee-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--animation-fade-right {
    animation: qtm-marquee-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-marquee-{{ block_id }}.qtm-marquee--animation-zoom {
    animation: qtm-marquee-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-marquee-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-marquee-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-marquee-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-marquee-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-marquee-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-marquee-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-marquee-{{ block_id }}.qtm-marquee--hide-tablet {
      display: none !important;
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__item-text {
      font-size: min({{ block.settings.text_size }}px, 24px);
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-marquee-{{ block_id }}.qtm-marquee--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-marquee-{{ block_id }} {
      padding: min(var(--qtm-marquee-padding), 24px);
    }

    .qtm-marquee-{{ block_id }}.qtm-marquee--hide-mobile {
      display: none !important;
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__header {
      text-align: inherit;
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__item-link,
    .qtm-marquee-{{ block_id }} .qtm-marquee__item-static {
      min-height: max(40px, {{ block.settings.item_min_height | minus: 8 }}px);
      padding: max(8px, {{ block.settings.item_padding_vertical | minus: 2 }}px) max(12px, {{ block.settings.item_padding_horizontal | minus: 6 }}px);
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__item-text {
      font-size: min({{ block.settings.text_size }}px, 18px);
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__logo {
      max-width: min({{ block.settings.logo_max_width }}px, 140px);
      height: min({{ block.settings.logo_height }}px, 42px);
    }

    .qtm-marquee-{{ block_id }}.qtm-marquee--type-logos .qtm-marquee__item-link,
    .qtm-marquee-{{ block_id }}.qtm-marquee--type-logos .qtm-marquee__item-static {
      min-width: min({{ block.settings.logo_item_width }}px, 180px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-marquee-{{ block_id }},
    .qtm-marquee-{{ block_id }} *,
    .qtm-marquee-{{ block_id }} *::before,
    .qtm-marquee-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__track {
      width: 100%;
      transform: none !important;
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__group {
      flex-wrap: wrap;
      width: 100%;
      min-width: 0;
      justify-content: center;
    }

    .qtm-marquee-{{ block_id }} .qtm-marquee__group[aria-hidden="true"] {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Scrolling announcements"
    },
    {
      "type": "header",
      "content": "Marquee behavior"
    },
    {
      "type": "select",
      "id": "marquee_type",
      "label": "Marquee type",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "logos",
          "label": "Logos"
        },
        {
          "value": "trust",
          "label": "Trust messages"
        }
      ]
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover or focus",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Separator",
      "default": "•"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "show_item_images",
      "label": "Show item images for text/trust marquee",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 0.3,
      "step": 0.1,
      "unit": "em",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "uppercase_text",
      "label": "Uppercase text",
      "default": false
    },
    {
      "type": "header",
      "content": "Logo settings"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo maximum width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_item_width",
      "label": "Logo item width",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "logo_grayscale",
      "label": "Make logos grayscale",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon image size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "header",
      "content": "Item style"
    },
    {
      "type": "range",
      "id": "item_min_height",
