{%- liquid
  assign block_id = 'product-bundle-builder-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'cards'
  assign product_count = block.settings.product_count | default: 3

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign bundle_total = 0
  assign available_item_count = 0

  if block.settings.include_current_product and current_variant.available
    assign bundle_total = bundle_total | plus: current_variant.price
    assign available_item_count = available_item_count | plus: 1
  endif

  for index in (1..4)
    if index <= product_count
      assign product_key = 'bundle_product_' | append: index
      assign bundle_product = block.settings[product_key]
      if bundle_product != blank
        assign bundle_variant = bundle_product.selected_or_first_available_variant
        if bundle_variant.available
          assign bundle_total = bundle_total | plus: bundle_variant.price
          assign available_item_count = available_item_count | plus: 1
        endif
      endif
    endif
  endfor
-%}

<div
  id="{{ block_id }}"
  class="
    product-bundle-builder
    product-bundle-builder--{{ layout_style }}
    product-bundle-builder--width-{{ block_width }}
    product-bundle-builder--align-{{ alignment }}
    {% unless show_on_desktop %} product-bundle-builder--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-bundle-builder--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-bundle-builder--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-bundle-builder--animate product-bundle-builder--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-bundle-builder-margin-top: {{ block.settings.margin_top }}px;
    --product-bundle-builder-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-bundle-builder-padding: {{ block.settings.padding }}px;
    --product-bundle-builder-gap: {{ block.settings.gap }}px;
    --product-bundle-builder-card-padding: {{ block.settings.card_padding }}px;
    --product-bundle-builder-border-width: {{ block.settings.border_width }}px;
    --product-bundle-builder-border-radius: {{ block.settings.border_radius }}px;
    --product-bundle-builder-heading-color: {{ block.settings.heading_color }};
    --product-bundle-builder-text-color: {{ block.settings.text_color }};
    --product-bundle-builder-background-color: {{ block.settings.background_color }};
    --product-bundle-builder-card-background-color: {{ block.settings.card_background_color }};
    --product-bundle-builder-border-color: {{ block.settings.border_color }};
    --product-bundle-builder-link-color: {{ block.settings.link_color }};
    --product-bundle-builder-badge-background: {{ block.settings.badge_background_color }};
    --product-bundle-builder-badge-text: {{ block.settings.badge_text_color }};
    --product-bundle-builder-button-background: {{ block.settings.button_background_color }};
    --product-bundle-builder-button-text: {{ block.settings.button_text_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-bundle-builder-margin-top);
      margin-bottom: var(--product-bundle-builder-margin-bottom);
      padding: var(--product-bundle-builder-padding);
      color: var(--product-bundle-builder-text-color);
      background: var(--product-bundle-builder-background-color);
    }

    #{{ block_id }}.product-bundle-builder--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-bundle-builder--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-bundle-builder--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-bundle-builder--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-bundle-builder--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-bundle-builder--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-bundle-builder--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-bundle-builder--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-bundle-builder__inner {
      display: grid;
      gap: var(--product-bundle-builder-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .product-bundle-builder__header {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-bundle-builder__heading {
      margin: 0;
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-bundle-builder__text {
      color: var(--product-bundle-builder-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-bundle-builder__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-bundle-builder__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-bundle-builder__badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      padding: 6px 10px;
      border-radius: 999px;
      color: var(--product-bundle-builder-badge-text);
      background: var(--product-bundle-builder-badge-background);
      line-height: 1.2;
      font-size: 0.84em;
    }

    #{{ block_id }}.product-bundle-builder--align-center .product-bundle-builder__badge {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-bundle-builder--align-right .product-bundle-builder__badge {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-bundle-builder__layout {
      display: grid;
      gap: var(--product-bundle-builder-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__layout {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    #{{ block_id }} .product-bundle-builder__items {
      display: grid;
      gap: var(--product-bundle-builder-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-bundle-builder--grid .product-bundle-builder__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.product-bundle-builder--cards .product-bundle-builder__items,
    #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .product-bundle-builder__item {
      position: relative;
      min-width: 0;
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr) auto;
      gap: 14px;
      align-items: center;
      padding: var(--product-bundle-builder-card-padding);
      color: var(--product-bundle-builder-text-color);
      background: var(--product-bundle-builder-card-background-color);
      border: var(--product-bundle-builder-border-width) solid var(--product-bundle-builder-border-color);
      border-radius: var(--product-bundle-builder-border-radius);
    }

    #{{ block_id }}.product-bundle-builder--cards .product-bundle-builder__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .product-bundle-builder__image-wrap {
      width: 88px;
      height: 88px;
      overflow: hidden;
      border-radius: max(calc(var(--product-bundle-builder-border-radius) - 8px), 0px);
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .product-bundle-builder__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #{{ block_id }} .product-bundle-builder__image-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 88px;
      height: 88px;
      color: var(--product-bundle-builder-text-color);
      background: rgba(0, 0, 0, 0.06);
      border-radius: max(calc(var(--product-bundle-builder-border-radius) - 8px), 0px);
      font-size: 0.82em;
      text-align: center;
    }

    #{{ block_id }} .product-bundle-builder__item-content {
      display: grid;
      gap: 5px;
      min-width: 0;
    }

    #{{ block_id }} .product-bundle-builder__item-title {
      margin: 0;
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.25;
    }

    #{{ block_id }} .product-bundle-builder__item-title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-bundle-builder__item-title a:hover {
      color: var(--product-bundle-builder-link-color);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    #{{ block_id }} .product-bundle-builder__variant {
      color: var(--product-bundle-builder-text-color);
      line-height: 1.35;
      opacity: 0.72;
      font-size: 0.9em;
    }

    #{{ block_id }} .product-bundle-builder__price {
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.2;
      white-space: nowrap;
    }

    #{{ block_id }} .product-bundle-builder__unavailable {
      color: var(--product-bundle-builder-text-color);
      opacity: 0.72;
      white-space: nowrap;
    }

    #{{ block_id }} .product-bundle-builder__summary {
      display: grid;
      gap: 12px;
      min-width: 0;
      padding: var(--product-bundle-builder-card-padding);
      color: var(--product-bundle-builder-text-color);
      background: var(--product-bundle-builder-card-background-color);
      border: var(--product-bundle-builder-border-width) solid var(--product-bundle-builder-border-color);
      border-radius: var(--product-bundle-builder-border-radius);
    }

    #{{ block_id }}.product-bundle-builder--cards .product-bundle-builder__summary {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .product-bundle-builder__total-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.25;
    }

    #{{ block_id }} .product-bundle-builder__savings {
      color: var(--product-bundle-builder-link-color);
      line-height: 1.4;
    }

    #{{ block_id }} .product-bundle-builder__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 46px;
      padding: 12px 18px;
      border: var(--product-bundle-builder-border-width) solid var(--product-bundle-builder-button-background);
      border-radius: var(--product-bundle-builder-border-radius);
      color: var(--product-bundle-builder-button-text);
      background: var(--product-bundle-builder-button-background);
      cursor: pointer;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-bundle-builder__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-bundle-builder__button:focus-visible {
      outline: 2px solid var(--product-bundle-builder-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-bundle-builder__button[disabled] {
      cursor: not-allowed;
      opacity: 0.55;
      transform: none;
    }

    #{{ block_id }} .product-bundle-builder__message {
      min-height: 1.4em;
      color: var(--product-bundle-builder-text-color);
      line-height: 1.4;
      font-size: 0.92em;
    }

    #{{ block_id }}.product-bundle-builder--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade {
      animation-name: productBundleBuilderFade;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_up {
      animation-name: productBundleBuilderFadeUp;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_down {
      animation-name: productBundleBuilderFadeDown;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_left {
      animation-name: productBundleBuilderFadeLeft;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_right {
      animation-name: productBundleBuilderFadeRight;
    }

    #{{ block_id }}.product-bundle-builder--animate-zoom {
      animation-name: productBundleBuilderZoom;
    }

    @keyframes productBundleBuilderFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productBundleBuilderFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productBundleBuilderFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productBundleBuilderFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productBundleBuilderFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productBundleBuilderZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-bundle-builder--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-bundle-builder--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__layout {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-bundle-builder--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__layout,
      #{{ block_id }}.product-bundle-builder--grid .product-bundle-builder__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-bundle-builder__item {
        grid-template-columns: 72px minmax(0, 1fr);
        padding: min(var(--product-bundle-builder-card-padding), 20px);
      }

      #{{ block_id }} .product-bundle-builder__price,
      #{{ block_id }} .product-bundle-builder__unavailable {
        grid-column: 2;
      }

      #{{ block_id }} .product-bundle-builder__image-wrap,
      #{{ block_id }} .product-bundle-builder__image-placeholder {
        width: 72px;
        height: 72px;
      }

      #{{ block_id }} .product-bundle-builder__summary {
        padding: min(var(--product-bundle-builder-card-padding), 20px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-bundle-builder--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-bundle-builder__button {
        transition: none;
      }

      #{{ block_id }} .product-bundle-builder__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-bundle-builder__inner">
    {% if block.settings.bundle_title != blank or block.settings.bundle_description != blank or block.settings.bundle_savings != blank %}
      <div class="product-bundle-builder__header">
        {% if block.settings.bundle_savings != blank %}
          <span class="product-bundle-builder__badge">
            {{ block.settings.bundle_savings | escape }}
          </span>
        {% endif %}

        {% if block.settings.bundle_title != blank %}
          <h3 class="product-bundle-builder__heading">
            {{ block.settings.bundle_title | escape }}
          </h3>
        {% endif %}

        {% if block.settings.bundle_description != blank %}
          <div class="product-bundle-builder__text">
            {{ block.settings.bundle_description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <form
      class="product-bundle-builder__form"
      action="{{ routes.cart_add_url }}"
      method="post"
      enctype="multipart/form-data"
      data-product-bundle-builder-form
      data-product-form
      data-ajax-cart-form
      data-cart-add-form
    >
      <div class="product-bundle-builder__layout">
        <div class="product-bundle-builder__items">
          {% if block.settings.include_current_product %}
            <article class="product-bundle-builder__item">
              {% if product_context.featured_image != blank %}
                <a class="product-bundle-builder__image-wrap" href="{{ product_context.url }}" aria-label="{{ product_context.title | escape }}">
                  {{
                    product_context.featured_image
                    | image_url: width: 240
                    | image_tag:
                      class: 'product-bundle-builder__image',
                      loading: 'lazy',
                      alt: product_context.featured_image.alt
                  }}
                </a>
              {% else %}
                <div class="product-bundle-builder__image-placeholder">
                  Product
                </div>
              {% endif %}

              <div class="product-bundle-builder__item-content">
                <h4 class="product-bundle-builder__item-title">
                  <a href="{{ product_context.url }}">{{ product_context.title | escape }}</a>
                </h4>

                {% unless current_variant.title == 'Default Title' %}
                  <span class="product-bundle-builder__variant">
                    {{ current_variant.title | escape }}
                  </span>
                {% endunless %}

                {% if current_variant.available %}
                  <input type="hidden" name="items[][id]" value="{{ current_variant.id }}" data-bundle-variant-id>
                  <input type="hidden" name="items[][quantity]" value="1" data-bundle-quantity>
                {% endif %}
              </div>

              {% if current_variant.available %}
                <span class="product-bundle-builder__price">
                  {{ current_variant.price | money }}
                </span>
              {% else %}
                <span class="product-bundle-builder__unavailable">
                  Unavailable
                </span>
              {% endif %}
            </article>
          {% endif %}

          {%- for index in (1..4) -%}
            {%- if index <= product_count -%}
              {%- liquid
                assign product_key = 'bundle_product_' | append: index
                assign bundle_product = block.settings[product_key]
              -%}

              {% if bundle_product != blank %}
                {%- liquid
                  assign bundle_variant = bundle_product.selected_or_first_available_variant
                -%}

                <article class="product-bundle-builder__item">
                  {% if bundle_product.featured_image != blank %}
                    <a class="product-bundle-builder__image-wrap" href="{{ bundle_product.url }}" aria-label="{{ bundle_product.title | escape }}">
                      {{
                        bundle_product.featured_image
                        | image_url: width: 240
                        | image_tag:
                          class: 'product-bundle-builder__image',
                          loading: 'lazy',
                          alt: bundle_product.featured_image.alt
                      }}
                    </a>
                  {% else %}
                    <div class="product-bundle-builder__image-placeholder">
                      Product
                    </div>
                  {% endif %}

                  <div class="product-bundle-builder__item-content">
                    <h4 class="product-bundle-builder__item-title">
                      <a href="{{ bundle_product.url }}">{{ bundle_product.title | escape }}</a>
                    </h4>

                    {% unless bundle_variant.title == 'Default Title' %}
                      <span class="product-bundle-builder__variant">
                        {{ bundle_variant.title | escape }}
                      </span>
                    {% endunless %}

                    {% if bundle_variant.available %}
                      <input type="hidden" name="items[][id]" value="{{ bundle_variant.id }}" data-bundle-variant-id>
                      <input type="hidden" name="items[][quantity]" value="1" data-bundle-quantity>
                    {% endif %}
                  </div>

                  {% if bundle_variant.available %}
                    <span class="product-bundle-builder__price">
                      {{ bundle_variant.price | money }}
                    </span>
                  {% else %}
                    <span class="product-bundle-builder__unavailable">
                      Unavailable
                    </span>
                  {% endif %}
                </article>
              {% endif %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="product-bundle-builder__summary">
          <div class="product-bundle-builder__total-row">
            <span>{{ block.settings.total_label | escape }}</span>
            <strong>{{ bundle_total | money }}</strong>
          </div>

          {% if block.settings.bundle_savings != blank %}
            <div class="product-bundle-builder__savings">
              {{ block.settings.bundle_savings | escape }}
            </div>
          {% endif %}

          <button
            class="product-bundle-builder__button"
            type="submit"
            {% if available_item_count == 0 %}disabled{% endif %}
            data-add-to-cart
            data-ajax-cart-submit
            data-cart-drawer-trigger
          >
            {% if available_item_count > 0 %}
              {{ block.settings.cta_label | escape }}
            {% else %}
              {{ block.settings.unavailable_label | escape }}
            {% endif %}
          </button>

          <div
            class="product-bundle-builder__message"
            data-product-bundle-builder-message
            role="status"
            aria-live="polite"
          ></div>
        </div>
      </div>
    </form>
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productBundleBuilderReady === 'true') return;

      root.dataset.productBundleBuilderReady = 'true';

      const form = root.querySelector('[data-product-bundle-builder-form]');
      const button = root.querySelector('[data-add-to-cart]');
      const message = root.querySelector('[data-product-bundle-builder-message]');

      if (!form || !button) return;

      const setMessage = (text) => {
        if (message) message.textContent = text;
      };

      const dispatchCartEvents = () => {
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('ajaxCart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('mini-cart:open', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart-drawer:open', { bubbles: true }));
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const variantInputs = Array.from(form.querySelectorAll('[data-bundle-variant-id]'));

        if (!variantInputs.length) {
          setMessage('No available bundle items to add.');
          return;
        }

        const items = variantInputs.map((input) => ({
          id: Number(input.value),
          quantity: 1
        })).filter((item) => item.id);

        if (!items.length) {
          setMessage('No available bundle items to add.');
          return;
        }

        button.disabled = true;
        setMessage('Adding bundle...');

        try {
          const response = await fetch({{ routes.cart_add_url | json }}, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ items })
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.description || data.message || 'Unable to add bundle.');
          }

          setMessage('Bundle added to cart.');
          dispatchCartEvents();
        } catch (error) {
          setMessage(error.message || 'Unable to add bundle.');
        } finally {
          button.disabled = false;
        }
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product bundle builder",
  "settings": [
    {
      "type": "header",
      "content": "Bundle"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Bundle title",
      "default": "Complete the set"
    },
    {
      "type": "richtext",
      "id": "bundle_description",
      "label": "Bundle description",
      "default": "<p>Pair this product with recommended items to increase value and make checkout easier.</p>"
    },
    {
      "type": "text",
      "id": "bundle_savings",
      "label": "Bundle savings",
