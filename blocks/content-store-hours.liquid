{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-store-hours
    qtm-store-hours-{{ block_id }}
    qtm-store-hours--width-{{ block_width }}
    qtm-store-hours--align-{{ block_alignment }}
    qtm-store-hours--layout-{{ block.settings.layout_style }}
    qtm-store-hours--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-store-hours--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-store-hours--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-store-hours--hide-mobile{% endunless %}
  "
  style="
    --qtm-store-hours-margin-top: {{ block.settings.margin_top }}px;
    --qtm-store-hours-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-store-hours-padding: {{ block.settings.padding }}px;
    --qtm-store-hours-gap: {{ block.settings.gap }}px;
    --qtm-store-hours-heading-color: {{ block.settings.heading_color }};
    --qtm-store-hours-text-color: {{ block.settings.text_color }};
    --qtm-store-hours-background-color: {{ block.settings.background_color }};
    --qtm-store-hours-card-background: {{ block.settings.card_background_color }};
    --qtm-store-hours-item-background: {{ block.settings.item_background_color }};
    --qtm-store-hours-highlight-background: {{ block.settings.highlight_background_color }};
    --qtm-store-hours-border-color: {{ block.settings.border_color }};
    --qtm-store-hours-link-color: {{ block.settings.link_color }};
    --qtm-store-hours-day-color: {{ block.settings.day_color }};
    --qtm-store-hours-hours-color: {{ block.settings.hours_color }};
    --qtm-store-hours-closed-color: {{ block.settings.closed_color }};
    --qtm-store-hours-badge-background: {{ block.settings.badge_background_color }};
    --qtm-store-hours-badge-color: {{ block.settings.badge_color }};
    --qtm-store-hours-border-width: {{ block.settings.border_width }}px;
    --qtm-store-hours-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-store-hours__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-store-hours__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-store-hours__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-store-hours__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-store-hours__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-store-hours__card">
      {% if block.settings.status_badge != blank %}
        <div class="qtm-store-hours__badge">
          {{ block.settings.status_badge | escape }}
        </div>
      {% endif %}

      {% if block.settings.layout_style == 'table' %}
        <table class="qtm-store-hours__table">
          <caption class="visually-hidden">
            {{ block.settings.table_caption | escape }}
          </caption>
          <tbody>
            {% for i in (1..7) %}
              {% liquid
                assign day_key = 'day_' | append: i | append: '_label'
                assign hours_key = 'day_' | append: i | append: '_hours'
                assign closed_key = 'day_' | append: i | append: '_closed'
                assign highlight_key = 'day_' | append: i | append: '_highlight'

                assign day_label = block.settings[day_key]
                assign day_hours = block.settings[hours_key]
                assign day_closed = block.settings[closed_key]
                assign day_highlight = block.settings[highlight_key]
              %}

              {% if day_label != blank %}
                <tr class="qtm-store-hours__table-row {% if day_closed %}is-closed{% endif %} {% if day_highlight %}is-highlighted{% endif %}">
                  <th class="qtm-store-hours__table-day" scope="row">
                    {{ day_label | escape }}
                  </th>
                  <td class="qtm-store-hours__table-hours">
                    {% if day_closed %}
                      {{ block.settings.closed_label | escape }}
                    {% else %}
                      {{ day_hours | escape }}
                    {% endif %}
                  </td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <ul class="qtm-store-hours__list" role="list" aria-label="{{ block.settings.table_caption | escape }}">
          {% for i in (1..7) %}
            {% liquid
              assign day_key = 'day_' | append: i | append: '_label'
              assign hours_key = 'day_' | append: i | append: '_hours'
              assign closed_key = 'day_' | append: i | append: '_closed'
              assign highlight_key = 'day_' | append: i | append: '_highlight'

              assign day_label = block.settings[day_key]
              assign day_hours = block.settings[hours_key]
              assign day_closed = block.settings[closed_key]
              assign day_highlight = block.settings[highlight_key]
            %}

            {% if day_label != blank %}
              <li class="qtm-store-hours__item {% if day_closed %}is-closed{% endif %} {% if day_highlight %}is-highlighted{% endif %}">
                <span class="qtm-store-hours__day">
                  {{ day_label | escape }}
                </span>

                <span class="qtm-store-hours__hours">
                  {% if day_closed %}
                    {{ block.settings.closed_label | escape }}
                  {% else %}
                    {{ day_hours | escape }}
                  {% endif %}
                </span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if block.settings.note != blank %}
        <div class="qtm-store-hours__note">
          {{ block.settings.note }}
        </div>
      {% endif %}

      {% if block.settings.timezone_label != blank %}
        <p class="qtm-store-hours__timezone">
          {{ block.settings.timezone_label | escape }}
        </p>
      {% endif %}

      {% if block.settings.button_label != blank and block.settings.button_url != blank %}
        <a class="qtm-store-hours__button" href="{{ block.settings.button_url }}">
          {{ block.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-store-hours-{{ block_id }} {
    margin-top: var(--qtm-store-hours-margin-top);
    margin-bottom: var(--qtm-store-hours-margin-bottom);
    padding: var(--qtm-store-hours-padding);
    color: var(--qtm-store-hours-text-color);
    background: var(--qtm-store-hours-background-color);
    border: var(--qtm-store-hours-border-width) solid var(--qtm-store-hours-border-color);
    border-radius: var(--qtm-store-hours-border-radius);
  }

  .qtm-store-hours-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--width-auto {
    width: auto;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--width-small {
    max-width: 560px;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--width-medium {
    max-width: 760px;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--width-large {
    max-width: 1040px;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__inner {
    display: grid;
    gap: var(--qtm-store-hours-gap);
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__header {
    display: grid;
    gap: 0.7rem;
    max-width: 720px;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-center .qtm-store-hours__header {
    margin-inline: auto;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-right .qtm-store-hours__header {
    margin-left: auto;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__eyebrow {
    margin: 0;
    color: var(--qtm-store-hours-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__heading {
    margin: 0;
    color: var(--qtm-store-hours-heading-color);
    line-height: 1.05;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__text,
  .qtm-store-hours-{{ block_id }} .qtm-store-hours__note {
    color: var(--qtm-store-hours-text-color);
    line-height: 1.7;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__text p,
  .qtm-store-hours-{{ block_id }} .qtm-store-hours__note p {
    margin-top: 0;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__text p:last-child,
  .qtm-store-hours-{{ block_id }} .qtm-store-hours__note p:last-child {
    margin-bottom: 0;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__card {
    display: grid;
    gap: calc(var(--qtm-store-hours-gap) * 0.55);
    width: 100%;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-cards .qtm-store-hours__card,
  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-table .qtm-store-hours__card {
    padding: clamp(1rem, 2vw, 1.4rem);
    background: var(--qtm-store-hours-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 10%);
    border-radius: calc(var(--qtm-store-hours-border-radius) * 0.75);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-compact .qtm-store-hours__card,
  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-minimal .qtm-store-hours__card {
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.35rem 0.7rem;
    color: var(--qtm-store-hours-badge-color);
    background: var(--qtm-store-hours-badge-background);
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-center .qtm-store-hours__badge {
    justify-self: center;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-right .qtm-store-hours__badge {
    justify-self: end;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-cards .qtm-store-hours__list {
    grid-template-columns: repeat({{ block.settings.card_columns }}, minmax(0, 1fr));
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    min-height: {{ block.settings.item_height }}px;
    padding: 0.75rem 0.9rem;
    background: var(--qtm-store-hours-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
    border-radius: calc(var(--qtm-store-hours-border-radius) * 0.5);
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-cards .qtm-store-hours__item {
    display: grid;
    align-content: center;
    gap: 0.4rem;
    min-height: {{ block.settings.card_min_height }}px;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-compact .qtm-store-hours__item,
  .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-minimal .qtm-store-hours__item {
    min-height: auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__item.is-highlighted,
  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-row.is-highlighted {
    background: var(--qtm-store-hours-highlight-background);
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__day {
    color: var(--qtm-store-hours-day-color);
    font-weight: 850;
    line-height: 1.25;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__hours {
    color: var(--qtm-store-hours-hours-color);
    font-weight: 650;
    line-height: 1.35;
    text-align: right;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__item.is-closed .qtm-store-hours__hours,
  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-row.is-closed .qtm-store-hours__table-hours {
    color: var(--qtm-store-hours-closed-color);
    font-weight: 800;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 0.55rem;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-row {
    background: var(--qtm-store-hours-item-background);
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-day,
  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-hours {
    min-height: {{ block.settings.item_height }}px;
    padding: 0.8rem 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
    border-bottom: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
    line-height: 1.35;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-day {
    width: 42%;
    color: var(--qtm-store-hours-day-color);
    border-left: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
    border-radius: calc(var(--qtm-store-hours-border-radius) * 0.45) 0 0 calc(var(--qtm-store-hours-border-radius) * 0.45);
    font-weight: 850;
    text-align: left;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-hours {
    color: var(--qtm-store-hours-hours-color);
    border-right: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
    border-radius: 0 calc(var(--qtm-store-hours-border-radius) * 0.45) calc(var(--qtm-store-hours-border-radius) * 0.45) 0;
    font-weight: 650;
    text-align: right;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__note {
    font-size: 0.92rem;
    opacity: 0.88;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__timezone {
    margin: 0;
    color: color-mix(in srgb, var(--qtm-store-hours-text-color), transparent 18%);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.8rem;
    padding: 0.82rem 1.15rem;
    color: #ffffff;
    background: var(--qtm-store-hours-link-color);
    border: 1px solid var(--qtm-store-hours-link-color);
    border-radius: calc(var(--qtm-store-hours-border-radius) * 0.45);
    font-weight: 850;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-center .qtm-store-hours__button {
    justify-self: center;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--align-right .qtm-store-hours__button {
    justify-self: end;
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-store-hours-{{ block_id }} .qtm-store-hours__button:focus-visible {
    outline: 3px solid var(--qtm-store-hours-link-color);
    outline-offset: 4px;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--animation-fade {
    animation: qtm-store-hours-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--animation-fade-up {
    animation: qtm-store-hours-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--animation-fade-down {
    animation: qtm-store-hours-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--animation-fade-left {
    animation: qtm-store-hours-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--animation-fade-right {
    animation: qtm-store-hours-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-store-hours-{{ block_id }}.qtm-store-hours--animation-zoom {
    animation: qtm-store-hours-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-store-hours-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-store-hours-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-store-hours-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-store-hours-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-store-hours-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-store-hours-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-store-hours-{{ block_id }}.qtm-store-hours--hide-tablet {
      display: none !important;
    }

    .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-cards .qtm-store-hours__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-store-hours-{{ block_id }}.qtm-store-hours--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-store-hours-{{ block_id }} {
      padding: min(var(--qtm-store-hours-padding), 24px);
    }

    .qtm-store-hours-{{ block_id }}.qtm-store-hours--hide-mobile {
      display: none !important;
    }

    .qtm-store-hours-{{ block_id }}.qtm-store-hours--layout-cards .qtm-store-hours__list {
      grid-template-columns: 1fr;
    }

    .qtm-store-hours-{{ block_id }} .qtm-store-hours__item {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .qtm-store-hours-{{ block_id }} .qtm-store-hours__hours {
      text-align: left;
    }

    .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-day,
    .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-hours {
      display: block;
      width: 100%;
      border-left: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
      border-right: 1px solid color-mix(in srgb, var(--qtm-store-hours-border-color), transparent 12%);
      text-align: left;
    }

    .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-day {
      border-bottom: 0;
      border-radius: calc(var(--qtm-store-hours-border-radius) * 0.45) calc(var(--qtm-store-hours-border-radius) * 0.45) 0 0;
      padding-bottom: 0.25rem;
    }

    .qtm-store-hours-{{ block_id }} .qtm-store-hours__table-hours {
      border-top: 0;
      border-radius: 0 0 calc(var(--qtm-store-hours-border-radius) * 0.45) calc(var(--qtm-store-hours-border-radius) * 0.45);
      padding-top: 0.25rem;
    }

    .qtm-store-hours-{{ block_id }} .qtm-store-hours__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-store-hours-{{ block_id }},
    .qtm-store-hours-{{ block_id }} *,
    .qtm-store-hours-{{ block_id }} *::before,
    .qtm-store-hours-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Store hours",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Store hours"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Visit us during regular business hours or contact our team for support.</p>"
    },
    {
      "type": "text",
      "id": "status_badge",
      "label": "Status badge",
      "default": "Open weekly"
    },
    {
      "type": "text",
      "id": "closed_label",
      "label": "Closed label",
      "default": "Closed"
    },
    {
      "type": "text",
      "id": "table_caption",
      "label": "Accessibility caption",
      "default": "Weekly store hours"
