    { "type": "range", "id": "slides_tablet", "label": "Slides per view (tablet)", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "slides_mobile", "label": "Slides per view (mobile)", "min": 1, "max": 3, "step": 1, "default": 1 },

    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (carousel mode)", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed (ms)", "min": 3000, "max": 8000, "step": 500, "default": 4500 },
    { "type": "checkbox", "id": "loop", "label": "Loop (carousel mode)", "default": true },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows (carousel mode)", "default": false },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots (carousel mode)", "default": false },

    { "type": "header", "content": "A11y" },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Key messages carousel" },
    { "type": "checkbox", "id": "announce_changes", "label": "Announce manual slide changes", "info": "Automatic rotation is not announced.", "default": false },

    { "type": "header", "content": "Layout controls" },
    {
      "type": "select",
      "id": "max_width",
      "label": "Max width",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "standard", "label": "Standard" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "select",
      "id": "pad_y",
      "label": "Vertical padding token",
