{% comment %}
  Quadratum — 3rd Party · Fulfilled By Partner Product Strip (Theme-only)
  File: sections/3rd-party-partner-fulfillment-strip.liquid

  • Native Shopify collection + strict optional tag filter over a bounded native preview
  • Styled with Quadratum tokens (no bare HTML look)
  • No external JS / no API calls / no new snippets/assets
  • Layouts: strip | carousel (scroll-snap) | grid
{% endcomment %}

{%- assign s = section.settings -%}

{%- liquid
  assign base_collection = s.collection
  if s.collection != blank and s.collection.handle == blank
    assign base_collection = collections[s.collection]
  endif
  assign tag_filter = s.filter_tag | default: '' | strip
  assign max_items = s.max_items | default: 4 | at_least: 2 | at_most: 12
  assign preview_products = base_collection.products | slice: 0, 50
  assign sorted_products = preview_products
  assign native_sort = ''
  case s.sort_order
    when 'price_asc'
      assign sorted_products = preview_products | sort: 'price'
      assign native_sort = 'price-ascending'
    when 'price_desc'
      assign sorted_products = preview_products | sort: 'price' | reverse
      assign native_sort = 'price-descending'
    when 'created_desc'
      assign sorted_products = preview_products | sort: 'created_at' | reverse
      assign native_sort = 'created-descending'
    when 'best_selling'
      assign native_sort = 'best-selling'
  endcase
  assign has_products = false
  for item in sorted_products
    if tag_filter == blank or item.tags contains tag_filter
      assign has_products = true
      break
    endif
  endfor
  assign view_all_url = ''
  if s.show_view_all_link and s.view_all_label != blank
    if s.view_all_url_mode == 'custom'
      assign view_all_url = s.view_all_custom_url
    elsif base_collection.url != blank
      assign view_all_url = base_collection.url
      if tag_filter != blank
        assign tag_handle = tag_filter | handleize
        if tag_handle != blank
          assign view_all_url = view_all_url | append: '/' | append: tag_handle
        else
          assign view_all_url = ''
        endif
      endif
      if native_sort != blank and view_all_url != blank
        assign view_all_url = view_all_url | append: '?sort_by=' | append: native_sort
      endif
    endif
  endif
  assign has_header = false
  if s.kicker != blank or s.heading != blank or s.body != blank or s.shipping_note != blank or s.partner_name != blank
    assign has_header = true
  endif
  if s.show_partner_logo and s.partner_logo != blank
    assign has_header = true
  endif
  assign show_partner = false
  if s.partner_name != blank
    assign show_partner = true
  endif
  if s.show_partner_logo and s.partner_logo != blank
    assign show_partner = true
  endif
  assign should_render = false
  if s.enable_section
    if has_products or view_all_url != blank or request.design_mode
      assign should_render = true
    endif
  endif
-%}

{%- if should_render -%}
<section
  id="fulfilled-strip-{{ section.id }}"
  class="q-section q-section--products q-section--bg-{{ s.background_style }} q-section--layout-{{ s.layout_style }} q-section--align-{{ s.alignment }} q-fulfilled-strip"
  aria-label="{{ s.aria_label | default: s.heading | default: 'Partner products' | escape }}"
  data-q-section="fulfilled-by-partner"
>
  <style>
    #fulfilled-strip-{{ section.id }}{
      --q-fs-pad-x: var(--q-pad-x, clamp(16px, 3vw, 32px));
      --q-fs-pad-y: var(--q-pad-y, clamp(22px, 3vw, 44px));
      --q-fs-gap: var(--q-gap-md, 16px);
      --q-fs-radius: var(--q-radius-lg, var(--q-radius, 16px));
      --q-fs-border: var(--q-border, rgba(0,0,0,0.12));
      --q-fs-soft: var(--q-soft, rgba(0,0,0,0.05));
      --q-fs-shadow: var(--q-shadow-md, 0 12px 28px rgba(0,0,0,0.08));
    }

    #fulfilled-strip-{{ section.id }} .q-section__inner{
      margin-inline: auto;
      padding-inline: min(var(--q-fs-pad-x),8vw);
      box-sizing:border-box;
      padding-block: var(--q-fs-pad-y);
      max-width: var(--container-lg,1152px);
    }

    #fulfilled-strip-{{ section.id }} .q-section__header{ margin-bottom: 1rem; }
    #fulfilled-strip-{{ section.id }}.q-section--align-center .q-section__header{ text-align: center; }

    #fulfilled-strip-{{ section.id }} .q-kicker{
      margin: 0 0 0.35rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
      font-size: var(--q-kicker-fs, 0.85rem);
    }

    #fulfilled-strip-{{ section.id }} .q-heading--section{
      margin: 0;
      font-size: var(--fs-h2,clamp(1.55rem,2.3vw,2.15rem));
      line-height: 1.12;
      letter-spacing: -0.01em;
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__partner{
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-top: 0.75rem;
      padding: 0.4rem 0.65rem;
      border-radius: 999px;
      border: 1px solid var(--q-fs-border);
      background: var(--q-fs-soft);
    }
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__partner-logo{
      display: block;
      width: auto;
      height: auto;
      max-height: 28px;
    }
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__partner-name{
      font-weight: 650;
      font-size: 0.95rem;
      opacity: 0.9;
      line-height: 1.2;
      white-space: normal;
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__body{
      margin-top: 0.85rem;
      max-width: 80ch;
      font-size: var(--fs-body,1.02rem);
      line-height: var(--lh-body,1.7);
      opacity: 0.92;
    }
    #fulfilled-strip-{{ section.id }}.q-section--align-center .q-fulfilled-strip__body{ margin-inline: auto; }
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__body.rte p{ margin: 0 0 0.75rem; }
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__body.rte p:last-child{ margin-bottom: 0; }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__note{
      margin-top: 0.65rem;
      opacity: 0.75;
      font-size: 0.96rem;
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products{
      margin-top: 1.05rem;
      gap: var(--q-fs-gap);
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--strip{
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(min(100%,220px),1fr));
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--grid{
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    @media (min-width: 750px){
      #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (min-width: 990px){
      #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--grid{ grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel{
      display: flex;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.25rem;
    }
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel:focus-visible{
      outline: 2px solid currentColor;
      outline-offset: 3px;
      border-radius: var(--q-fs-radius);
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__card{ min-width:0; max-width:100%; scroll-snap-align:start; }
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel>.q-fulfilled-strip__card{flex:0 0 72%;}
    @media (min-width: 750px){ #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel>.q-fulfilled-strip__card{flex-basis:40%;} }
    @media (min-width: 990px){ #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel>.q-fulfilled-strip__card{flex-basis:28%;} }

    #fulfilled-strip-{{ section.id }} .q-product-card{
      position: relative;
      border-radius: var(--q-fs-radius);
      border: 1px solid var(--q-fs-border);
      background:var(--c-bg,#fff);
      color:var(--c-text,#111);
      box-shadow: var(--q-fs-shadow);
      overflow: hidden;
      height: 100%;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__link{
      display: grid;
      grid-template-rows: auto 1fr;
      text-decoration: none;
      color: inherit;
      height: 100%;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__media{
      position: relative;
      aspect-ratio: 4 / 3;
      background: var(--q-fs-soft);
      overflow: hidden;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform: scale(1);
      transition: transform 160ms ease;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__info{
      padding: 0.9rem 0.95rem 1rem;
      display: grid;
      gap: 0.35rem;
      align-content: start;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__title{
      margin: 0;
      font-size: 1.02rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
      font-weight: 650;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__price{
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: baseline;
      opacity: 0.92;
      font-size: 0.98rem;
    }
    #fulfilled-strip-{{ section.id }} .q-product-card__compare{
      opacity: 0.6;
      text-decoration: line-through;
      font-size: 0.95rem;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card__link:focus-visible{
      outline: 2px solid currentColor;
      outline-offset: 3px;
      border-radius:max(0px,calc(var(--q-fs-radius) - 2px));
      outline-offset:-3px;
    }

    #fulfilled-strip-{{ section.id }} .q-product-card:hover .q-product-card__img{ transform: scale(1.03); }
    @media (prefers-reduced-motion: reduce){
      #fulfilled-strip-{{ section.id }} .q-product-card__img{ transition: none; }
      #fulfilled-strip-{{ section.id }} .q-product-card:hover .q-product-card__img{ transform: none; }
    }

    #fulfilled-strip-{{ section.id }} .q-badge{
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.55rem;
      border-radius: 999px;
      font-size: 0.86rem;
      line-height: 1.1;
      border: 1px solid var(--q-fs-border);
      background: var(--q-fs-soft);
      font-weight: 650;
      letter-spacing: -0.005em;
    }
    #fulfilled-strip-{{ section.id }} .q-badge--partner{
      position: absolute;
      top: 0.65rem;
      inset-inline-start:0.65rem;
      z-index: 2;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    #fulfilled-strip-{{ section.id }} .q-section__footer{ margin-top: 1.1rem; }
    #fulfilled-strip-{{ section.id }}.q-section--align-center .q-section__footer{ text-align: center; }
    #fulfilled-strip-{{ section.id }} .q-link{ text-decoration: none; font-weight: 650; }
    #fulfilled-strip-{{ section.id }} .q-link--inline{ opacity: 0.85; }
    #fulfilled-strip-{{ section.id }} .q-link--inline:hover{
      opacity: 1;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    #fulfilled-strip-{{ section.id }} .q-link:focus-visible{
      outline: 2px solid currentColor;
      outline-offset: 3px;
      border-radius: 8px;
    }

    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__placeholder{
      margin-top: 0.9rem;
      padding: 0.9rem 1rem;
      border: 1px dashed var(--q-fs-border);
      border-radius: var(--q-fs-radius);
      background: var(--q-fs-soft);
      opacity: 0.85;
    }

    #fulfilled-strip-{{ section.id }}{min-width:0;overflow-wrap:anywhere;font-family:var(--font-body,inherit);}
    #fulfilled-strip-{{ section.id }}.q-section--align-left .q-section__header,#fulfilled-strip-{{ section.id }}.q-section--align-left .q-section__footer{text-align:start;}
    #fulfilled-strip-{{ section.id }} .q-heading,#fulfilled-strip-{{ section.id }} .q-product-card__title{font-family:var(--font-head,inherit);text-transform:var(--tt-head,none);}
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__partner{max-width:100%;box-sizing:border-box;}
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__partner-name,#fulfilled-strip-{{ section.id }} .q-fulfilled-strip__logo-wrap{min-width:0;}
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__logo-wrap{max-width:50%;}
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__partner-logo{max-width:100%;object-fit:contain;}
    #fulfilled-strip-{{ section.id }} .q-product-card__link,#fulfilled-strip-{{ section.id }} .q-product-card__info{min-width:0;box-sizing:border-box;}
    #fulfilled-strip-{{ section.id }} .q-badge--partner{max-width:calc(100% - 1.3rem);box-sizing:border-box;overflow-wrap:anywhere;background:var(--c-bg,#fff);color:var(--c-text,#111);}
    #fulfilled-strip-{{ section.id }} .q-product-card:focus-within{outline:2px solid currentColor;outline-offset:3px;}
    #fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel{scroll-padding-inline:4px;padding:4px 4px 8px;}
    @media(max-width:479.98px){#fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--grid{grid-template-columns:minmax(0,1fr);}}
    @media(prefers-reduced-motion:reduce){#fulfilled-strip-{{ section.id }} .q-fulfilled-strip__products--carousel{scroll-behavior:auto;scroll-snap-type:none;}}
  </style>

  <div class="q-section__inner">
    {%- if has_header -%}
    <div class="q-section__header q-section__header--{{ s.alignment }}">
      {%- if s.kicker != blank -%}
        <p class="q-kicker">{{ s.kicker | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="q-heading q-heading--section">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if show_partner -%}
        <div class="q-fulfilled-strip__partner">
          {%- if s.show_partner_logo and s.partner_logo != blank -%}
            {%- assign partner_alt = s.partner_logo.alt | default: s.partner_name | default: 'Partner logo' -%}
            <span class="q-fulfilled-strip__logo-wrap"{% if s.partner_name != blank %} aria-hidden="true"{% endif %}>
              {{ s.partner_logo | image_url: width: 160 | image_tag: loading: 'lazy', class: 'q-fulfilled-strip__partner-logo', alt: partner_alt }}
            </span>
          {%- endif -%}
          {%- if s.partner_name != blank -%}<span class="q-fulfilled-strip__partner-name">{{ s.partner_name | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="q-fulfilled-strip__body rte">
          {{ s.body }}
        </div>
      {%- endif -%}

      {%- if s.shipping_note != blank -%}
        <div class="q-fulfilled-strip__note">{{ s.shipping_note | escape }}</div>
      {%- endif -%}
    </div>

    {%- endif -%}
    {%- if has_products -%}
      <div class="q-section__body">
        <div
          class="q-fulfilled-strip__products q-fulfilled-strip__products--{{ s.layout_style }}"
          {% if s.layout_style == 'carousel' %}tabindex="0"{% endif %}
          role="list"
          aria-label="{{ s.aria_label | default: s.heading | default: 'Partner products' | escape }}"
        >
          {%- assign shown = 0 -%}
          {%- for product in sorted_products -%}
            {%- if shown >= max_items -%}{%- break -%}{%- endif -%}

            {%- assign include_product = true -%}
            {%- if tag_filter != blank -%}
              {%- if product.tags contains tag_filter -%}
                {%- assign include_product = true -%}
              {%- else -%}
                {%- assign include_product = false -%}
              {%- endif -%}
            {%- endif -%}

            {%- if include_product -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- assign img_alt = product.featured_image.alt | default: product.title | strip -%}

              {%- liquid
                assign price_variant = product.selected_or_first_available_variant | default: product.variants.first
                assign current_price = product.price
                assign compare_price = 0
                assign product_link = product.url
                if price_variant != blank
                  assign current_price = price_variant.price
                  assign compare_price = price_variant.compare_at_price | default: 0
                  assign product_link = price_variant.url | default: product.url
                endif
              -%}
              <article class="q-product-card q-fulfilled-strip__card" role="listitem">
                <a class="q-product-card__link" href="{{ product_link | escape }}">
                  <div class="q-product-card__media">
                    {%- if s.fulfilled_badge_text != blank -%}
                      <span class="q-badge q-badge--partner">{{ s.fulfilled_badge_text | escape }}</span>
                    {%- endif -%}

                    {%- if product.featured_image != blank -%}
                      {{ product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'q-product-card__img',
                          loading: 'lazy',
                          alt: img_alt,
                          widths: '360,540,720,900',
                          sizes: '(min-width: 990px) 320px, (min-width: 750px) 38vw, 72vw'
                      }}
                    {%- endif -%}
                  </div>

                  <div class="q-product-card__info">
                    <h3 class="q-product-card__title">{{ product.title | escape }}</h3>

                    <div class="q-product-card__price">
                      {%- if compare_price > current_price -%}
                        <span class="q-product-card__compare">{{ compare_price | money }}</span>
                      {%- endif -%}
                      <span class="q-product-card__current">{{ current_price | money }}</span>
                    </div>
                  </div>
                </a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <div class="q-fulfilled-strip__placeholder" role="status">
        <strong>Setup required:</strong> Select a collection with matching products. This preview checks at most the first 50 native products; an unmatched tag never substitutes other products.
      </div>
    {%- endif -%}

    {%- if request.design_mode and s.sort_order == 'best_selling' -%}
      <p role="status">Best selling uses the collection order in this preview. Set the selected collection’s default sort to Best selling; the collection link applies the requested sort to the full catalog.</p>
    {%- endif -%}
    {%- if view_all_url != blank -%}
      <div class="q-section__footer q-fulfilled-strip__footer">
        <a href="{{ view_all_url | escape }}" class="q-link q-link--inline">
          {{ s.view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
  <p role="status">Partner products: enable the section and select a collection with matching products.</p>
{%- endif -%}

{% schema %}
{
  "name": "3P - Partner Strip",
  "tag": "section",
  "class": "q-section q-fulfilled-strip",
  "settings": [
    { "type": "paragraph", "content": "A native collection preview, not fulfillment integration. Use a collection/tag containing only the intended partner products and enter accurate delivery copy. Filtering and local price/date sorting inspect at most the first 50 products supplied by Shopify. The collection link opens the full tagged/sorted catalog; Shopify can redirect unused tags." },
    { "type": "checkbox", "id": "enable_section", "label": "Enable section", "default": true },
    { "type": "text", "id": "aria_label", "label": "Section aria-label", "default": "Fulfilled by partner product strip" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Fulfilled by partner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our partner selection" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Browse this selection and check individual product pages for current delivery information.</p>" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "See each product’s delivery details." },

    { "type": "header", "content": "Partner labeling" },
    { "type": "text", "id": "partner_name", "label": "Partner / network name", "default": "Our fulfillment partners" },
    { "type": "text", "id": "fulfilled_badge_text", "label": "Badge text", "default": "Fulfilled by partner" },
    { "type": "checkbox", "id": "show_partner_logo", "label": "Show partner logo", "default": false },
    { "type": "image_picker", "id": "partner_logo", "label": "Partner logo" },

    { "type": "header", "content": "Products source" },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "text", "id": "filter_tag", "label": "Filter by product tag (optional)" },
    { "type": "range", "id": "max_items", "label": "Max products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "sort_order",
      "label": "Preview sort order",
      "info": "Price/newest sorts apply within the preview. Best selling requires the collection’s native order to be Best selling.",
      "default": "collection_default",
      "options": [
        { "value": "collection_default", "label": "Collection default" },
        { "value": "best_selling", "label": "Best selling (collection order)" },
        { "value": "price_asc", "label": "Price, low to high" },
        { "value": "price_desc", "label": "Price, high to low" },
        { "value": "created_desc", "label": "Newest first" }
      ]
    },

    { "type": "header", "content": "Layout & styling" },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "strip",
      "options": [
        { "value": "strip", "label": "Strip" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "surface",
      "options": [
        { "value": "surface", "label": "Surface" },
        { "value": "contrast", "label": "Contrast" },
        { "value": "brand", "label": "Brand color" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "View all link" },
    { "type": "checkbox", "id": "show_view_all_link", "label": "Show \"View all\" link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "Browse the collection" },
    {
      "type": "select",
      "id": "view_all_url_mode",
      "label": "\"View all\" link destination",
      "default": "collection",
      "options": [
        { "value": "collection", "label": "Selected collection" },
        { "value": "custom", "label": "Custom URL" }
