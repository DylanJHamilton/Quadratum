{%- liquid
  assign block_id = 'product-sticky-add-to-cart-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'full'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'conversion'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign featured_image = current_variant.featured_image | default: product_context.featured_image
-%}

<div
  id="{{ block_id }}"
  class="
    product-sticky-add-to-cart
    product-sticky-add-to-cart--{{ layout_style }}
    product-sticky-add-to-cart--width-{{ block_width }}
    product-sticky-add-to-cart--align-{{ alignment }}
    {% unless show_on_desktop %} product-sticky-add-to-cart--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-sticky-add-to-cart--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-sticky-add-to-cart--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-sticky-add-to-cart--animate product-sticky-add-to-cart--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-sticky-add-to-cart-margin-top: {{ block.settings.margin_top }}px;
    --product-sticky-add-to-cart-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-sticky-add-to-cart-padding: {{ block.settings.padding }}px;
    --product-sticky-add-to-cart-gap: {{ block.settings.gap }}px;
    --product-sticky-add-to-cart-border-width: {{ block.settings.border_width }}px;
    --product-sticky-add-to-cart-border-radius: {{ block.settings.border_radius }}px;
    --product-sticky-add-to-cart-heading-color: {{ block.settings.heading_color }};
    --product-sticky-add-to-cart-text-color: {{ block.settings.text_color }};
    --product-sticky-add-to-cart-background-color: {{ block.settings.background_color }};
    --product-sticky-add-to-cart-card-background-color: {{ block.settings.card_background_color }};
    --product-sticky-add-to-cart-border-color: {{ block.settings.border_color }};
    --product-sticky-add-to-cart-link-color: {{ block.settings.link_color }};
    --product-sticky-add-to-cart-button-background: {{ block.settings.button_background_color }};
    --product-sticky-add-to-cart-button-text: {{ block.settings.button_text_color }};
    --product-sticky-add-to-cart-offset: {{ block.settings.sticky_offset }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-sticky-add-to-cart
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      position: sticky;
      bottom: var(--product-sticky-add-to-cart-offset);
      z-index: 30;
      width: 100%;
      margin-top: var(--product-sticky-add-to-cart-margin-top);
      margin-bottom: var(--product-sticky-add-to-cart-margin-bottom);
      padding: var(--product-sticky-add-to-cart-padding);
      color: var(--product-sticky-add-to-cart-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-sticky-add-to-cart--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-sticky-add-to-cart--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-sticky-add-to-cart--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-sticky-add-to-cart--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-sticky-add-to-cart--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-sticky-add-to-cart--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-sticky-add-to-cart--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-sticky-add-to-cart--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-sticky-add-to-cart__form {
      display: block;
      width: 100%;
      margin: 0;
    }

    #{{ block_id }} .product-sticky-add-to-cart__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--product-sticky-add-to-cart-gap);
      width: 100%;
      min-width: 0;
      padding: 14px;
      color: var(--product-sticky-add-to-cart-text-color);
      background: var(--product-sticky-add-to-cart-card-background-color);
      border: var(--product-sticky-add-to-cart-border-width) solid var(--product-sticky-add-to-cart-border-color);
      border-radius: var(--product-sticky-add-to-cart-border-radius);
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.14);
      backdrop-filter: blur(16px);
    }

    #{{ block_id }}.product-sticky-add-to-cart--minimal .product-sticky-add-to-cart__inner {
      box-shadow: none;
      border-radius: var(--product-sticky-add-to-cart-border-radius);
    }

    #{{ block_id }}.product-sticky-add-to-cart--mobile_focused .product-sticky-add-to-cart__inner {
      border-radius: var(--product-sticky-add-to-cart-border-radius) var(--product-sticky-add-to-cart-border-radius) 0 0;
    }

    #{{ block_id }} .product-sticky-add-to-cart__product {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    #{{ block_id }} .product-sticky-add-to-cart__image-wrap {
      width: {{ block.settings.image_size }}px;
      height: {{ block.settings.image_size }}px;
      overflow: hidden;
      flex: 0 0 {{ block.settings.image_size }}px;
      background: rgba(0, 0, 0, 0.06);
      border-radius: max(calc(var(--product-sticky-add-to-cart-border-radius) - 8px), 0px);
    }

    #{{ block_id }} .product-sticky-add-to-cart__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #{{ block_id }} .product-sticky-add-to-cart__placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: {{ block.settings.image_size }}px;
      height: {{ block.settings.image_size }}px;
      color: var(--product-sticky-add-to-cart-text-color);
      background: rgba(0, 0, 0, 0.06);
      border-radius: max(calc(var(--product-sticky-add-to-cart-border-radius) - 8px), 0px);
      font-size: 0.75em;
    }

    #{{ block_id }} .product-sticky-add-to-cart__details {
      display: grid;
      gap: 4px;
      min-width: 0;
    }

    #{{ block_id }} .product-sticky-add-to-cart__title {
      margin: 0;
      color: var(--product-sticky-add-to-cart-heading-color);
      line-height: 1.2;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #{{ block_id }} .product-sticky-add-to-cart__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-sticky-add-to-cart__title a:hover {
      color: var(--product-sticky-add-to-cart-link-color);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    #{{ block_id }} .product-sticky-add-to-cart__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--product-sticky-add-to-cart-text-color);
      line-height: 1.25;
      font-size: 0.92em;
    }

    #{{ block_id }} .product-sticky-add-to-cart__price {
      color: var(--product-sticky-add-to-cart-heading-color);
      white-space: nowrap;
    }

    #{{ block_id }} .product-sticky-add-to-cart__compare-price {
      opacity: 0.65;
      text-decoration: line-through;
      white-space: nowrap;
    }

    #{{ block_id }} .product-sticky-add-to-cart__variant-label {
      opacity: 0.75;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #{{ block_id }} .product-sticky-add-to-cart__controls {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      min-width: 0;
    }

    #{{ block_id }} .product-sticky-add-to-cart__select-wrap,
    #{{ block_id }} .product-sticky-add-to-cart__quantity-wrap {
      display: grid;
      gap: 4px;
      min-width: 0;
    }

    #{{ block_id }} .product-sticky-add-to-cart__label {
      color: var(--product-sticky-add-to-cart-text-color);
      line-height: 1.2;
      font-size: 0.75em;
      opacity: 0.78;
    }

    #{{ block_id }} .product-sticky-add-to-cart__select,
    #{{ block_id }} .product-sticky-add-to-cart__quantity {
      min-height: 44px;
      color: var(--product-sticky-add-to-cart-heading-color);
      background: var(--product-sticky-add-to-cart-background-color);
      border: var(--product-sticky-add-to-cart-border-width) solid var(--product-sticky-add-to-cart-border-color);
      border-radius: max(calc(var(--product-sticky-add-to-cart-border-radius) - 10px), 6px);
    }

    #{{ block_id }} .product-sticky-add-to-cart__select {
      width: min(240px, 28vw);
      padding: 0 36px 0 12px;
    }

    #{{ block_id }} .product-sticky-add-to-cart__quantity {
      width: 76px;
      padding: 0 10px;
      text-align: center;
    }

    #{{ block_id }} .product-sticky-add-to-cart__select:focus-visible,
    #{{ block_id }} .product-sticky-add-to-cart__quantity:focus-visible {
      outline: 2px solid var(--product-sticky-add-to-cart-link-color);
      outline-offset: 2px;
    }

    #{{ block_id }} .product-sticky-add-to-cart__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      min-width: 150px;
      padding: 12px 18px;
      color: var(--product-sticky-add-to-cart-button-text);
      background: var(--product-sticky-add-to-cart-button-background);
      border: var(--product-sticky-add-to-cart-border-width) solid var(--product-sticky-add-to-cart-button-background);
      border-radius: max(calc(var(--product-sticky-add-to-cart-border-radius) - 10px), 6px);
      cursor: pointer;
      line-height: 1.2;
      text-align: center;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-sticky-add-to-cart__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-sticky-add-to-cart__button:focus-visible {
      outline: 2px solid var(--product-sticky-add-to-cart-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-sticky-add-to-cart__button[disabled] {
      cursor: not-allowed;
      opacity: 0.55;
      transform: none;
    }

    #{{ block_id }} .product-sticky-add-to-cart__message {
      grid-column: 1 / -1;
      min-height: 1.3em;
      color: var(--product-sticky-add-to-cart-text-color);
      line-height: 1.35;
      font-size: 0.9em;
    }

    #{{ block_id }}.product-sticky-add-to-cart--minimal .product-sticky-add-to-cart__message {
      display: none;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate-fade {
      animation-name: productStickyAddToCartFade;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate-fade_up {
      animation-name: productStickyAddToCartFadeUp;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate-fade_down {
      animation-name: productStickyAddToCartFadeDown;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate-fade_left {
      animation-name: productStickyAddToCartFadeLeft;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate-fade_right {
      animation-name: productStickyAddToCartFadeRight;
    }

    #{{ block_id }}.product-sticky-add-to-cart--animate-zoom {
      animation-name: productStickyAddToCartZoom;
    }

    @keyframes productStickyAddToCartFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productStickyAddToCartFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productStickyAddToCartFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productStickyAddToCartFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productStickyAddToCartFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productStickyAddToCartZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-sticky-add-to-cart--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-sticky-add-to-cart--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .product-sticky-add-to-cart__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-sticky-add-to-cart__controls {
        width: 100%;
        justify-content: stretch;
      }

      #{{ block_id }} .product-sticky-add-to-cart__select-wrap {
        flex: 1 1 auto;
      }

      #{{ block_id }} .product-sticky-add-to-cart__select {
        width: 100%;
      }

      #{{ block_id }} .product-sticky-add-to-cart__button {
        flex: 1 1 auto;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }} {
        bottom: 0;
        padding-left: 0;
        padding-right: 0;
        padding-bottom: max(var(--product-sticky-add-to-cart-padding), env(safe-area-inset-bottom));
      }

      #{{ block_id }}.product-sticky-add-to-cart--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-sticky-add-to-cart__inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
        border-left: 0;
        border-right: 0;
        border-bottom: 0;
        border-radius: var(--product-sticky-add-to-cart-border-radius) var(--product-sticky-add-to-cart-border-radius) 0 0;
      }

      #{{ block_id }} .product-sticky-add-to-cart__product {
        grid-template-columns: auto minmax(0, 1fr);
      }

      #{{ block_id }} .product-sticky-add-to-cart__image-wrap,
      #{{ block_id }} .product-sticky-add-to-cart__placeholder {
        width: 48px;
        height: 48px;
      }

      #{{ block_id }} .product-sticky-add-to-cart__controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 72px;
        width: 100%;
      }

      #{{ block_id }} .product-sticky-add-to-cart__select-wrap {
        grid-column: 1 / -1;
      }

      #{{ block_id }} .product-sticky-add-to-cart__select {
        width: 100%;
      }

      #{{ block_id }} .product-sticky-add-to-cart__quantity {
        width: 100%;
      }

      #{{ block_id }} .product-sticky-add-to-cart__button {
        width: 100%;
        min-width: 0;
      }

      #{{ block_id }}.product-sticky-add-to-cart--mobile_focused .product-sticky-add-to-cart__label {
        display: none;
      }

      #{{ block_id }}.product-sticky-add-to-cart--mobile_focused .product-sticky-add-to-cart__controls {
        grid-template-columns: 68px minmax(0, 1fr);
      }

      #{{ block_id }}.product-sticky-add-to-cart--mobile_focused .product-sticky-add-to-cart__select-wrap {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-sticky-add-to-cart--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-sticky-add-to-cart__button {
        transition: none;
      }

      #{{ block_id }} .product-sticky-add-to-cart__button:hover {
        transform: none;
      }
    }
  </style>

  <form
    class="product-sticky-add-to-cart__form"
    action="{{ routes.cart_add_url }}"
    method="post"
    enctype="multipart/form-data"
    data-product-form
    data-ajax-cart-form
    data-cart-add-form
    data-product-sticky-add-to-cart-form
  >
    <div class="product-sticky-add-to-cart__inner">
      <div class="product-sticky-add-to-cart__product">
        {% if block.settings.show_image %}
          {% if featured_image != blank %}
            <a class="product-sticky-add-to-cart__image-wrap" href="{{ product_context.url }}" aria-label="{{ product_context.title | escape }}">
              {{
                featured_image
                | image_url: width: 180
                | image_tag:
                  class: 'product-sticky-add-to-cart__image',
                  loading: 'lazy',
                  alt: featured_image.alt
              }}
            </a>
          {% else %}
            <div class="product-sticky-add-to-cart__placeholder" aria-hidden="true">
              Item
            </div>
          {% endif %}
        {% endif %}

        <div class="product-sticky-add-to-cart__details">
          {% if block.settings.show_title %}
            <h3 class="product-sticky-add-to-cart__title">
              <a href="{{ product_context.url }}">{{ product_context.title | escape }}</a>
            </h3>
          {% endif %}

          <div class="product-sticky-add-to-cart__meta">
            {% if block.settings.show_price %}
              <span class="product-sticky-add-to-cart__price" data-product-sticky-price>
                {{ current_variant.price | money }}
              </span>

              <span
                class="product-sticky-add-to-cart__compare-price"
                data-product-sticky-compare-price
                {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
              >
                {{ current_variant.compare_at_price | money }}
              </span>
            {% endif %}

            {% if block.settings.show_variant_label and current_variant.title != 'Default Title' %}
              <span class="product-sticky-add-to-cart__variant-label" data-product-sticky-variant-label>
                {{ current_variant.title | escape }}
              </span>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="product-sticky-add-to-cart__controls">
        {% if block.settings.show_variant_selector and product_context.has_only_default_variant == false %}
          <div class="product-sticky-add-to-cart__select-wrap">
            <label class="product-sticky-add-to-cart__label" for="{{ block_id }}-variant">
              {{ block.settings.variant_label | escape }}
            </label>

            <select
              id="{{ block_id }}-variant"
              class="product-sticky-add-to-cart__select"
              name="id"
              data-product-sticky-variant-select
              aria-label="{{ block.settings.variant_label | escape }}"
            >
              {%- for variant in product_context.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant.id == current_variant.id %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-available="{{ variant.available }}"
                  data-title="{{ variant.title | escape }}"
                  data-image="{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 180 }}{% endif %}"
                >
                  {{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-sticky-variant-input>
        {% endif %}

        {% if block.settings.show_quantity %}
          <div class="product-sticky-add-to-cart__quantity-wrap">
            <label class="product-sticky-add-to-cart__label" for="{{ block_id }}-quantity">
              {{ block.settings.quantity_label | escape }}
            </label>

            <input
              id="{{ block_id }}-quantity"
              class="product-sticky-add-to-cart__quantity"
              type="number"
              name="quantity"
              min="1"
              value="1"
              inputmode="numeric"
              aria-label="{{ block.settings.quantity_label | escape }}"
              data-product-sticky-quantity
            >
          </div>
        {% else %}
          <input type="hidden" name="quantity" value="1">
        {% endif %}

        <button
          class="product-sticky-add-to-cart__button"
          type="submit"
          {% unless current_variant.available %}disabled{% endunless %}
          data-add-to-cart
          data-ajax-cart-submit
          data-cart-drawer-trigger
          data-product-sticky-submit
        >
          {% if current_variant.available %}
            {{ block.settings.add_to_cart_label | escape }}
          {% else %}
            {{ block.settings.sold_out_label | escape }}
          {% endif %}
        </button>
      </div>

      <div
        class="product-sticky-add-to-cart__message"
        data-product-sticky-message
        role="status"
        aria-live="polite"
      ></div>
    </div>
  </form>

  <script type="application/json" data-product-sticky-variants>
    {{ product_context.variants | json }}
  </script>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productStickyAddToCartReady === 'true') return;

      root.dataset.productStickyAddToCartReady = 'true';

      const form = root.querySelector('[data-product-sticky-add-to-cart-form]');
      const select = root.querySelector('[data-product-sticky-variant-select]');
      const hiddenInput = root.querySelector('[data-product-sticky-variant-input]');
      const button = root.querySelector('[data-product-sticky-submit]');
      const priceEl = root.querySelector('[data-product-sticky-price]');
      const comparePriceEl = root.querySelector('[data-product-sticky-compare-price]');
      const variantLabelEl = root.querySelector('[data-product-sticky-variant-label]');
      const imageEl = root.querySelector('.product-sticky-add-to-cart__image');
      const messageEl = root.querySelector('[data-product-sticky-message]');

      if (!form || !button) return;

      const currency = {{ cart.currency.iso_code | default: shop.currency | json }};

      const formatMoney = (cents) => {
        const amount = Number(cents || 0) / 100;

        try {
          return new Intl.NumberFormat(document.documentElement.lang || 'en-US', {
            style: 'currency',
            currency
          }).format(amount);
        } catch (error) {
          return `$${amount.toFixed(2)}`;
        }
      };

      const setMessage = (text) => {
        if (messageEl) messageEl.textContent = text || '';
      };

      const dispatchVariantChange = (variantId) => {
        root.dataset.variantId = String(variantId);

        document.dispatchEvent(new CustomEvent('variant:change', {
          bubbles: true,
          detail: {
            productId: {{ product_context.id | json }},
            variantId: Number(variantId)
          }
        }));
      };

      const updateFromSelectedOption = () => {
        if (!select) return;

        const selectedOption = select.options[select.selectedIndex];

        if (!selectedOption) return;

        const variantId = selectedOption.value;
        const price = Number(selectedOption.dataset.price || 0);
        const comparePrice = Number(selectedOption.dataset.comparePrice || 0);
        const available = selectedOption.dataset.available === 'true';
        const title = selectedOption.dataset.title || '';
        const image = selectedOption.dataset.image || '';

        if (hiddenInput) hiddenInput.value = variantId;

        if (priceEl) priceEl.textContent = formatMoney(price);

        if (comparePriceEl) {
          if (comparePrice > price) {
            comparePriceEl.textContent = formatMoney(comparePrice);
            comparePriceEl.hidden = false;
          } else {
            comparePriceEl.hidden = true;
          }
        }

        if (variantLabelEl) {
          variantLabelEl.textContent = title;
          variantLabelEl.hidden = !title || title === 'Default Title';
        }

        if (imageEl && image) {
          imageEl.src = image;
        }

        button.disabled = !available;
        button.textContent = available
          ? {{ block.settings.add_to_cart_label | json }}
          : {{ block.settings.sold_out_label | json }};

        setMessage('');
        dispatchVariantChange(variantId);
      };

      if (select) {
        select.addEventListener('change', updateFromSelectedOption);
        updateFromSelectedOption();
      }

      form.addEventListener('submit', () => {
        setMessage({{ block.settings.adding_message | json }});

        window.setTimeout(() => {
          setMessage('');
        }, 3500);
      });

      document.addEventListener('cart:updated', () => {
        setMessage({{ block.settings.added_message | json }});
      });

      document.addEventListener('ajaxCart:refresh', () => {
        setMessage({{ block.settings.added_message | json }});
      });
    })();
  </script>
</div>

