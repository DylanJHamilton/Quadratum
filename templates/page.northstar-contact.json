            "tags": "Demo contact",
            "cta_label": "View support",
            "cta_url": "/pages/northstar-support"
          }
        },
        "ns_2": {
          "type": "location",
          "settings": {
            "name": "Orders and shipping",
            "address": "Build status, tracking and returns.",
            "email": "orders@northstar.example",
            "hours": "<p>Illustrative service desk / Mon to Fri</p>",
            "tags": "Demo contact",
            "cta_label": "View support",
            "cta_url": "/pages/northstar-support"
          }
        }
      },
      "block_order": [
        "ns_0",
        "ns_1",
        "ns_2"
      ]
    },
    "northstar_4": {
      "type": "interactive-content-helper-tabs-accordion",
      "settings": {
        "heading": "Quick answers.",
        "layout_mode": "accordion",
        "style_preset": "faq",
        "use_custom_colors": true,
        "bg": "#080B10",
        "text": "#F4F7F8",
        "accent": "#C7FF4A",
        "border": "#253241",
        "surface": "#111821",
        "muted": "#BBC7D1",
        "tab_bg": "#1B2530",
        "tab_text": "#F4F7F8",
        "tab_border": "#344454",
        "tab_active_bg": "#C7FF4A",
        "tab_active_text": "#080B10",
        "tab_active_border": "#C7FF4A",
        "acc_bg": "#1B2530",
        "acc_text": "#F4F7F8",
        "acc_border": "#344454",
        "acc_active_bg": "#C7FF4A",
        "acc_active_text": "#080B10",
        "acc_active_border": "#C7FF4A"
      },
      "blocks": {
        "ns_0": {
          "type": "item",
          "settings": {
            "label": "How fast will I hear back?",
            "content": "<p>Within one business day. Calls during hours are answered by a technician.</p>",
            "anchor_id": "question-1",
            "icon": ""
          }
        },
        "ns_1": {
          "type": "item",
          "settings": {
            "label": "Can I send my configuration record?",
            "content": "<p>Yes. Attach it to the reply email and we will read it before we respond.</p>",
            "anchor_id": "question-2",
            "icon": ""
          }
        },
        "ns_2": {
          "type": "item",
          "settings": {
            "label": "Do you offer quotes for teams?",
            "content": "<p>Yes. Choose &quot;Studio or team order&quot; and tell us how many systems you need.</p>",
            "anchor_id": "question-3",
            "icon": ""
          }
        }
      },
      "block_order": [
        "ns_0",
        "ns_1",
        "ns_2"
