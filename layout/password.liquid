<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name | escape }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% render 'global-theme-vars' %}
  {{ 'styles.css' | asset_url | stylesheet_tag }}
</head>
<body><main id="MainContent" class="page-width" style="max-width: 48rem; margin: 4rem auto; padding: 1.5rem;">{{ content_for_layout }}</main></body>
</html>
