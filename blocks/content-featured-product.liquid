  {% if featured_product != blank %}
    {% render 'qtm-product-block-data', product: featured_product %}
    <div class="content-featured-product__shell">
      {% render 'qtm-block-featured-product-gallery', product: featured_product, current_variant: current_variant, block: block, block_id: block_id %}
      <div class="content-featured-product__content">
        {% if block.settings.eyebrow != blank %}<p class="content-featured-product__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        {% if block.settings.show_vendor and featured_product.vendor != blank %}<div class="content-featured-product__vendor">{{ featured_product.vendor | escape }}</div>{% endif %}
        <h2 class="content-featured-product__title"><a href="{{ featured_product.url | escape }}">{{ featured_product.title | escape }}</a></h2>
        {% if block.settings.show_sale_badge and block.settings.sale_badge_text != blank %}<span class="content-featured-product__badge" data-product-price-badge {% unless is_on_sale %}hidden{% endunless %}>{{ block.settings.sale_badge_text | escape }}</span>{% endif %}
        {% if block.settings.show_price and current_variant != blank %}<div class="content-featured-product__price-row">
          <span class="content-featured-product__price" data-product-price-current>{{ purchase_price | money }}</span>
          <s class="content-featured-product__compare" data-product-price-compare {% unless is_on_sale %}hidden{% endunless %}>{% if is_on_sale %}{{ purchase_compare | money }}{% endif %}</s>
        </div>{% endif %}
        {% if featured_description != blank %}<div class="content-featured-product__description">{{ featured_description | escape }}</div>{% endif %}
        {% if block.settings.show_atc and current_variant != blank %}
          {% form 'product', featured_product, id: form_id, class: 'content-featured-product__form', data-product-form: '', data-cart-drawer-add: '' %}
            {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            <div data-b8-fallback>
              <label for="{{ block_id }}-variant">{{ block.settings.variant_label | default: 'Variant' | escape }}</label>
              <select id="{{ block_id }}-variant" name="id" data-b8-variant-id>
                <option value="{{ current_variant.id }}" selected>{{ current_variant.title | escape }}{% unless current_variant.available %} — {{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% endunless %}</option>
                {% for variant in featured_product.variants %}{% unless variant.id == current_variant.id %}<option value="{{ variant.id }}">{{ variant.title | escape }}{% unless variant.available %} — {{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% endunless %}</option>{% endunless %}{% endfor %}
              </select>
            </div>
            {% if featured_product.selling_plan_groups.size > 0 %}{% render 'product-selling-plans', product: featured_product, id: block_id, label: block.settings.selling_plan_label, one_time_label: block.settings.one_time_purchase_label %}{% else %}<input type="hidden" name="selling_plan" value="">{% endif %}
            {% if block.settings.show_quantity %}
              <label class="content-featured-product__quantity" for="{{ block_id }}-quantity"><span class="content-featured-product__quantity-label">{{ block.settings.quantity_label | default: 'Quantity' | escape }}</span>
                <input id="{{ block_id }}-quantity" class="content-featured-product__quantity-input" type="number" name="quantity" min="{{ quantity_min }}" step="{{ quantity_step }}" {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %} value="{{ quantity_min }}" inputmode="numeric">
              </label>
            {% else %}<input type="hidden" name="quantity" value="{{ quantity_min }}">{% endif %}
            <div class="content-featured-product__buttons">
              <button type="submit" name="add" class="content-featured-product__button" data-add-to-cart data-b8-submit {% unless purchase_available %}disabled{% endunless %}>{% if purchase_available %}{{ block.settings.atc_label | default: 'Add to cart' | escape }}{% elsif current_variant.available == false %}{{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% else %}{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}{% endif %}</button>
              {% if block.settings.show_secondary_button and block.settings.secondary_button_label != blank %}<a class="content-featured-product__button content-featured-product__button--secondary" href="{{ featured_product.url | escape }}">{{ block.settings.secondary_button_label | escape }}</a>{% endif %}
            </div>
            <div data-cart-add-status role="status" aria-live="polite"></div>
          {% endform %}
        {% elsif block.settings.show_secondary_button and block.settings.secondary_button_label != blank %}<div class="content-featured-product__buttons"><a class="content-featured-product__button content-featured-product__button--secondary" href="{{ featured_product.url | escape }}">{{ block.settings.secondary_button_label | escape }}</a></div>{% endif %}
      </div>
    </div>
  {% elsif request.design_mode and block.settings.show_empty_state %}<div class="content-featured-product__empty" role="note">{{ block.settings.empty_text | default: 'Select a product for this block.' | escape }}</div>{% endif %}
</div>

