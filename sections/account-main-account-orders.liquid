{% comment %}
  Quadratum Account System
  File 3 of 5 — Full Customer Orders Page

  Handles:
  - Full order history
  - Client-side order search on rendered orders
  - Client-side status filtering on rendered orders
  - Client-side sorting on rendered orders
  - Responsive table/cards/hybrid display
  - Account navigation
  - Empty state

  Does NOT handle:
  - Individual order detail page
  - Order tracking logic
  - Address management
{% endcomment %}

{{ 'account-main-account-orders.css' | asset_url | stylesheet_tag }}
<script src="{{ 'account-main-account-orders.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign layout_style = section.settings.layout_style

  assign tracking_url = section.settings.tracking_url
  if tracking_url == blank
    assign tracking_url = '/pages/order-tracking'
  endif

  assign empty_button_url = section.settings.empty_button_url
  if empty_button_url == blank
    assign empty_button_url = routes.all_products_collection_url
  endif
-%}

<section
  id="QtmAccountMainOrders-{{ section.id }}"
  class="
    qtmAccountOrders
    qtmAccountOrders--{{ layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-meta-size: {{ section.settings.meta_font_size }}px;
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-gap: {{ section.settings.row_gap }}px;
    --qtm-account-badge-radius: {{ section.settings.badge_radius }}px;
    --qtm-account-badge-size: {{ section.settings.badge_font_size }}px;
    --qtm-account-control-radius: {{ section.settings.control_radius }}px;
    --qtm-account-control-border: {{ section.settings.control_border }};
  "
  data-qtm-account-orders
>
  <div class="qtmAccountOrders__shell">
    {% if customer %}
      <header class="qtmAccountOrders__header">
        <div>
          <h1 class="qtmAccountOrders__heading">
            {{ section.settings.heading }}
          </h1>

          {% if section.settings.subheading != blank %}
            <p class="qtmAccountOrders__subheading">
              {{ section.settings.subheading }}
            </p>
          {% endif %}
        </div>
      </header>

      {% if section.settings.show_account_nav %}
        <nav class="qtmAccountOrders__accountNav" aria-label="Account navigation">
          <a href="{{ routes.account_url }}" class="qtmAccountOrders__accountNavLink">
            {{ section.settings.dashboard_label }}
          </a>

          <a href="{{ routes.account_url }}" class="qtmAccountOrders__accountNavLink is-active" aria-current="page">
            {{ section.settings.orders_label }}
          </a>

          <a href="{{ routes.account_addresses_url }}" class="qtmAccountOrders__accountNavLink">
            {{ section.settings.addresses_label }}
          </a>

          <a href="{{ tracking_url }}" class="qtmAccountOrders__accountNavLink">
            {{ section.settings.tracking_label }}
          </a>

          <a href="{{ routes.account_logout_url }}" class="qtmAccountOrders__accountNavLink">
            {{ section.settings.logout_label }}
          </a>
        </nav>
      {% endif %}

      {% paginate customer.orders by section.settings.orders_per_page %}
        {% if customer.orders.size > 0 %}
          {% if section.settings.show_order_search or section.settings.show_status_filters or section.settings.show_sort %}
            <div class="qtmAccountOrders__controls" aria-label="Order controls">
              {% if section.settings.show_order_search %}
                <div class="qtmAccountOrders__controlGroup qtmAccountOrders__controlGroup--search">
                  <label for="QtmAccountOrdersSearch-{{ section.id }}" class="qtmAccountOrders__controlLabel">
                    Search orders
                  </label>

                  <input
                    id="QtmAccountOrdersSearch-{{ section.id }}"
                    class="qtmAccountOrders__search"
                    type="search"
                    placeholder="{{ section.settings.search_placeholder }}"
                    autocomplete="off"
                    data-qtm-account-orders-search
                  >
                </div>
              {% endif %}

              {% if section.settings.show_sort %}
                <div class="qtmAccountOrders__controlGroup qtmAccountOrders__controlGroup--sort">
                  <label for="QtmAccountOrdersSort-{{ section.id }}" class="qtmAccountOrders__controlLabel">
                    Sort orders
                  </label>

                  <select
                    id="QtmAccountOrdersSort-{{ section.id }}"
                    class="qtmAccountOrders__sort"
                    data-qtm-account-orders-sort
                  >
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="highest">Highest total</option>
                    <option value="lowest">Lowest total</option>
                  </select>
                </div>
              {% endif %}

              {% if section.settings.show_status_filters %}
                <div class="qtmAccountOrders__filters" aria-label="Filter orders by status">
                  <button type="button" class="qtmAccountOrders__filter is-active" data-qtm-account-orders-filter="all" aria-pressed="true">
                    All
                  </button>

                  <button type="button" class="qtmAccountOrders__filter" data-qtm-account-orders-filter="paid" aria-pressed="false">
                    Paid
                  </button>

                  <button type="button" class="qtmAccountOrders__filter" data-qtm-account-orders-filter="pending" aria-pressed="false">
                    Pending
                  </button>

                  <button type="button" class="qtmAccountOrders__filter" data-qtm-account-orders-filter="fulfilled" aria-pressed="false">
                    Fulfilled
                  </button>

                  <button type="button" class="qtmAccountOrders__filter" data-qtm-account-orders-filter="unfulfilled" aria-pressed="false">
                    Unfulfilled
                  </button>

                  <button type="button" class="qtmAccountOrders__filter" data-qtm-account-orders-filter="partially-fulfilled" aria-pressed="false">
                    Partially fulfilled
                  </button>

                  <button type="button" class="qtmAccountOrders__filter" data-qtm-account-orders-filter="cancelled" aria-pressed="false">
                    Cancelled
                  </button>
                </div>
              {% endif %}
            </div>
          {% endif %}

          <p
            class="qtmAccountOrders__resultCount"
            aria-live="polite"
            data-qtm-account-orders-count
          ></p>

          <div
            class="qtmAccountOrders__list"
            data-qtm-account-orders-list
            aria-label="Customer orders"
          >
            <div class="qtmAccountOrders__tableWrap">
              <table class="qtmAccountOrders__table">
                <caption class="qtmAccountOrders__visuallyHidden">
                  Full customer order history
                </caption>

                <thead>
                  <tr>
                    <th scope="col">Order</th>
                    <th scope="col">Date</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Fulfillment</th>
                    <th scope="col">Items</th>
                    <th scope="col">Total</th>
                    <th scope="col">
                      <span class="qtmAccountOrders__visuallyHidden">Order actions</span>
                    </th>
                  </tr>
                </thead>

                <tbody data-qtm-account-orders-table-body>
                  {% for order in customer.orders %}
                    {%- liquid
                      assign financial_status = order.financial_status_label | downcase | handleize
                      assign fulfillment_status = order.fulfillment_status_label | downcase | handleize

                      assign order_statuses = financial_status | append: ' ' | append: fulfillment_status

                      if order.cancelled
                        assign order_statuses = order_statuses | append: ' cancelled'
                      endif

                      assign order_search = order.name | append: ' ' | append: order.created_at | append: ' ' | append: order.financial_status_label | append: ' ' | append: order.fulfillment_status_label | append: ' ' | append: order.total_price | strip_html | downcase

                      assign item_count = order.item_count
                      if item_count == blank
                        assign item_count = order.line_items.size
                      endif
                    -%}

                    <tr
                      class="qtmAccountOrders__row"
                      data-qtm-account-orders-item
                      data-order-status="{{ order_statuses | escape }}"
                      data-order-date="{{ order.created_at | date: '%s' }}"
                      data-order-total="{{ order.total_price }}"
                      data-order-search="{{ order_search | escape }}"
                    >
                      <td data-label="Order">
                        <a href="{{ order.customer_url }}" class="qtmAccountOrders__orderLink">
                          {{ order.name }}
                        </a>
                      </td>

                      <td data-label="Date">
                        {{ order.created_at | date: format: 'abbreviated_date' }}
                      </td>

                      <td data-label="Payment">
                        <span class="qtmAccountOrders__badge qtmAccountOrders__badge--{{ financial_status }}">
                          {{ order.financial_status_label }}
                        </span>
                      </td>

                      <td data-label="Fulfillment">
                        <span class="qtmAccountOrders__badge qtmAccountOrders__badge--{{ fulfillment_status }}">
                          {{ order.fulfillment_status_label }}
                        </span>
                      </td>

                      <td data-label="Items">
                        {{ item_count }}
                      </td>

                      <td data-label="Total">
                        {{ order.total_price | money }}
                      </td>

                      <td data-label="Action">
                        <a href="{{ order.customer_url }}" class="qtmAccountOrders__viewLink">
                          View order
                        </a>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

            <div class="qtmAccountOrders__cards" data-qtm-account-orders-card-list>
              {% for order in customer.orders %}
                {%- liquid
                  assign financial_status = order.financial_status_label | downcase | handleize
                  assign fulfillment_status = order.fulfillment_status_label | downcase | handleize

                  assign order_statuses = financial_status | append: ' ' | append: fulfillment_status

                  if order.cancelled
                    assign order_statuses = order_statuses | append: ' cancelled'
                  endif

                  assign order_search = order.name | append: ' ' | append: order.created_at | append: ' ' | append: order.financial_status_label | append: ' ' | append: order.fulfillment_status_label | append: ' ' | append: order.total_price | strip_html | downcase

                  assign item_count = order.item_count
                  if item_count == blank
                    assign item_count = order.line_items.size
                  endif
                -%}

                <article
                  class="qtmAccountOrders__card"
                  data-qtm-account-orders-item
                  data-order-status="{{ order_statuses | escape }}"
                  data-order-date="{{ order.created_at | date: '%s' }}"
                  data-order-total="{{ order.total_price }}"
                  data-order-search="{{ order_search | escape }}"
                  aria-label="Order {{ order.name }}"
                >
                  <div class="qtmAccountOrders__cardHeader">
                    <div>
                      <h2 class="qtmAccountOrders__cardTitle">
                        <a href="{{ order.customer_url }}">
                          {{ order.name }}
                        </a>
                      </h2>

                      <p class="qtmAccountOrders__cardDate">
                        {{ order.created_at | date: format: 'abbreviated_date' }}
                      </p>
                    </div>

                    <a href="{{ order.customer_url }}" class="qtmAccountOrders__viewLink">
                      View order
                    </a>
                  </div>

                  <dl class="qtmAccountOrders__details">
                    <div>
                      <dt>Payment</dt>
                      <dd>
                        <span class="qtmAccountOrders__badge qtmAccountOrders__badge--{{ financial_status }}">
                          {{ order.financial_status_label }}
                        </span>
                      </dd>
                    </div>

                    <div>
                      <dt>Fulfillment</dt>
                      <dd>
                        <span class="qtmAccountOrders__badge qtmAccountOrders__badge--{{ fulfillment_status }}">
                          {{ order.fulfillment_status_label }}
                        </span>
                      </dd>
                    </div>

                    <div>
                      <dt>Items</dt>
                      <dd>{{ item_count }}</dd>
                    </div>

                    <div>
                      <dt>Total</dt>
                      <dd>{{ order.total_price | money }}</dd>
                    </div>
                  </dl>
                </article>
              {% endfor %}
            </div>
          </div>

          <div class="qtmAccountOrders__noMatches" hidden data-qtm-account-orders-no-matches>
            <h2>No matching orders found.</h2>
            <p>Try adjusting your search or status filter.</p>
          </div>

          {% if paginate.pages > 1 %}
            <nav class="qtmAccountOrders__pagination" aria-label="Order pagination">
              {{ paginate | default_pagination }}
            </nav>

            <p class="qtmAccountOrders__paginationNote">
              Search, filters, and sorting apply only to the orders shown on this page.
            </p>
          {% endif %}
        {% else %}
          <div class="qtmAccountOrders__empty">
            <h2>{{ section.settings.empty_heading }}</h2>

            {% if section.settings.empty_text != blank %}
              <p>{{ section.settings.empty_text }}</p>
            {% endif %}

            {% if section.settings.empty_button_label != blank %}
              <a
                href="{{ empty_button_url }}"
                class="qtmAccountOrders__button qtmAccountOrders__button--{{ section.settings.button_style }}"
              >
                {{ section.settings.empty_button_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="qtmAccountOrders__empty">
        <h1 class="qtmAccountOrders__heading">
          {{ section.settings.heading }}
        </h1>

        <p>Please sign in to view your orders.</p>

        <a
          href="{{ routes.account_login_url }}"
          class="qtmAccountOrders__button qtmAccountOrders__button--{{ section.settings.button_style }}"
        >
          Sign in
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Account Main Orders",
  "tag": "section",
  "class": "qtm-account-main-orders",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "hybrid",
      "options": [
        {
          "value": "table",
          "label": "Table"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "hybrid",
          "label": "Hybrid"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Orders"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Review your order history, check statuses, and open order details."
    },
    {
      "type": "header",
      "content": "Account navigation"
    },
    {
      "type": "checkbox",
      "id": "show_account_nav",
      "label": "Show account navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "dashboard_label",
      "label": "Dashboard label",
      "default": "Dashboard"
    },
    {
      "type": "text",
      "id": "orders_label",
      "label": "Orders label",
      "default": "Orders"
    },
    {
      "type": "text",
      "id": "addresses_label",
      "label": "Addresses label",
      "default": "Addresses"
    },
    {
      "type": "text",
      "id": "tracking_label",
      "label": "Order tracking label",
      "default": "Order Tracking"
    },
    {
      "type": "url",
      "id": "tracking_url",
      "label": "Order tracking URL"
    },
    {
      "type": "text",
      "id": "logout_label",
      "label": "Logout label",
      "default": "Logout"
    },
    {
      "type": "header",
      "content": "Order controls"
    },
    {
      "type": "checkbox",
      "id": "show_order_search",
      "label": "Show order search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by order number, date, or status"
    },
    {
      "type": "checkbox",
      "id": "show_status_filters",
      "label": "Show status filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort control",
      "default": true
    },
    {
      "type": "range",
      "id": "orders_per_page",
      "label": "Orders per page",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 10
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "You have not placed any orders yet."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "When you place an order, it will appear here."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Empty button label",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Empty button URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "label": "Meta font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Table and cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Badge radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge font size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "range",
      "id": "control_radius",
      "label": "Control radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "control_border",
      "label": "Control border",
      "default": "#d1d5db"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Account Main Orders"
    }
  ]
}
{% endschema %}