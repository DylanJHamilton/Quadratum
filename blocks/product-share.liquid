{%- liquid
  assign block_id = 'product-share-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign share_style = block.settings.share_style | default: 'buttons'

  assign product_url = shop.url | append: product_context.url
  assign product_title = product_context.title
  assign share_text = block.settings.share_text | default: product_title

  assign encoded_url = product_url | url_encode
  assign encoded_title = product_title | url_encode
  assign encoded_share_text = share_text | url_encode

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-share
    product-share--{{ share_style }}
    product-share--width-{{ width }}
    product-share--align-{{ alignment }}
    {% unless show_on_desktop %} product-share--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-share--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-share--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-share--animate product-share--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-share-margin-top: {{ block.settings.margin_top }}px;
    --product-share-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-share-padding: {{ block.settings.padding }}px;
    --product-share-gap: {{ block.settings.gap }}px;
    --product-share-button-size: {{ block.settings.button_size }}px;
    --product-share-border-width: {{ block.settings.border_width }}px;
    --product-share-border-radius: {{ block.settings.border_radius }}px;
    --product-share-label-color: {{ block.settings.label_color }};
    --product-share-text-color: {{ block.settings.text_color }};
    --product-share-background-color: {{ block.settings.background_color }};
    --product-share-border-color: {{ block.settings.border_color }};
    --product-share-hover-background: {{ block.settings.hover_background_color }};
    --product-share-hover-text: {{ block.settings.hover_text_color }};
    --product-share-focus-color: {{ block.settings.focus_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-share
  data-share-url="{{ product_url }}"
  data-share-title="{{ product_title | escape }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-share-margin-top);
      margin-bottom: var(--product-share-margin-bottom);
      padding: var(--product-share-padding);
      color: var(--product-share-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-share--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-share--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-share--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-share--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-share--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-share--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-share--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-share--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-share__inner {
      display: grid;
      gap: var(--product-share-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-share--inline .product-share__inner,
    #{{ block_id }}.product-share--minimal .product-share__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--product-share-gap);
    }

    #{{ block_id }}.product-share--align-center .product-share__inner {
      justify-content: center;
    }

    #{{ block_id }}.product-share--align-right .product-share__inner {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-share__label {
      margin: 0;
      color: var(--product-share-label-color);
      line-height: 1.25;
      font-size: {{ block.settings.label_font_size }}px;
    }

    #{{ block_id }} .product-share__items {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--product-share-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-share--align-center .product-share__items {
      justify-content: center;
    }

    #{{ block_id }}.product-share--align-right .product-share__items {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-share__item {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: var(--product-share-button-size);
      min-height: var(--product-share-button-size);
      padding: 0 12px;
      color: var(--product-share-text-color);
      background: var(--product-share-background-color);
      border: var(--product-share-border-width) solid var(--product-share-border-color);
      border-radius: var(--product-share-border-radius);
      cursor: pointer;
      text-decoration: none;
      line-height: 1;
      font: inherit;
      transition: background 180ms ease, color 180ms ease, border-color 180ms ease, opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.product-share--buttons .product-share__item,
    #{{ block_id }}.product-share--icons .product-share__item {
      width: var(--product-share-button-size);
      height: var(--product-share-button-size);
      padding: 0;
    }

    #{{ block_id }}.product-share--icons .product-share__item {
      border-radius: 999px;
    }

    #{{ block_id }}.product-share--minimal .product-share__item {
      min-width: 0;
      min-height: auto;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      color: var(--product-share-text-color);
    }

    #{{ block_id }} .product-share__item:hover {
      color: var(--product-share-hover-text);
      background: var(--product-share-hover-background);
      border-color: var(--product-share-hover-background);
      transform: translateY(-1px);
    }

    #{{ block_id }}.product-share--minimal .product-share__item:hover {
      color: var(--product-share-hover-background);
      background: transparent;
      border-color: transparent;
    }

    #{{ block_id }} .product-share__item:focus-visible {
      outline: 2px solid var(--product-share-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-share__icon {
      display: inline-flex;
      width: 18px;
      height: 18px;
      flex: 0 0 18px;
    }

    #{{ block_id }} .product-share__icon svg {
      width: 100%;
      height: 100%;
      display: block;
      fill: currentColor;
    }

    #{{ block_id }}.product-share--buttons .product-share__text,
    #{{ block_id }}.product-share--icons .product-share__text {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    #{{ block_id }} .product-share__message {
      min-height: 1.3em;
      color: var(--product-share-label-color);
      line-height: 1.35;
      font-size: 0.9em;
    }

    #{{ block_id }}.product-share--align-center .product-share__message {
      text-align: center;
    }

    #{{ block_id }}.product-share--align-right .product-share__message {
      text-align: right;
    }

    #{{ block_id }}.product-share--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-share--animate-fade {
      animation-name: productShareFade;
    }

    #{{ block_id }}.product-share--animate-fade_up {
      animation-name: productShareFadeUp;
    }

    #{{ block_id }}.product-share--animate-fade_down {
      animation-name: productShareFadeDown;
    }

    #{{ block_id }}.product-share--animate-fade_left {
      animation-name: productShareFadeLeft;
    }

    #{{ block_id }}.product-share--animate-fade_right {
      animation-name: productShareFadeRight;
    }

    #{{ block_id }}.product-share--animate-zoom {
      animation-name: productShareZoom;
    }

    @keyframes productShareFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productShareFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productShareFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productShareFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productShareFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productShareZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-share--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-share--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-share--hide-mobile {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-share--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-share__item {
        transition: none;
      }

      #{{ block_id }} .product-share__item:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-share__inner">
    {% if block.settings.show_label and block.settings.label != blank %}
      <p class="product-share__label">
        {{ block.settings.label | escape }}
      </p>
    {% endif %}

    <div class="product-share__items" aria-label="{{ block.settings.aria_label | escape }}">
      {% if block.settings.show_native_share %}
        <button
          type="button"
          class="product-share__item"
          data-product-share-native
          aria-label="{{ block.settings.native_share_label | escape }}"
        >
          <span class="product-share__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11A2.99 2.99 0 1 0 15 5c0 .24.04.47.09.7L8.04 9.81A3 3 0 1 0 8.04 14.2l7.12 4.17c-.05.2-.08.42-.08.64a2.92 2.92 0 1 0 2.92-2.92Z"/>
            </svg>
          </span>
          <span class="product-share__text">
            {{ block.settings.native_share_label | escape }}
          </span>
        </button>
      {% endif %}

      {% if block.settings.show_facebook %}
        <a
          class="product-share__item"
          href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ block.settings.facebook_label | escape }}"
        >
          <span class="product-share__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M14 8h2V5h-2c-2.76 0-5 2.24-5 5v2H7v3h2v7h3v-7h3l1-3h-4v-2c0-1.1.9-2 2-2Z"/>
            </svg>
          </span>
          <span class="product-share__text">
            {{ block.settings.facebook_label | escape }}
          </span>
        </a>
      {% endif %}

      {% if block.settings.show_x %}
        <a
          class="product-share__item"
          href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ encoded_share_text }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ block.settings.x_label | escape }}"
        >
          <span class="product-share__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M18.9 2H22l-6.8 7.78L23.2 22h-6.27l-4.91-6.42L6.4 22H3.29l7.27-8.31L2.88 2h6.43l4.43 5.86L18.9 2Zm-1.1 17.85h1.72L8.38 4.04H6.53L17.8 19.85Z"/>
            </svg>
          </span>
          <span class="product-share__text">
            {{ block.settings.x_label | escape }}
          </span>
        </a>
      {% endif %}

      {% if block.settings.show_pinterest %}
        <a
          class="product-share__item"
          href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ encoded_title }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ block.settings.pinterest_label | escape }}"
        >
          <span class="product-share__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12.2 2C6.8 2 4 5.86 4 9.95c0 2.49 1.39 5.6 3.62 6.58.34.15.52.08.6-.24.06-.24.36-1.46.5-2.02.04-.18.02-.34-.13-.52-.74-.89-1.33-2.52-1.33-4.05 0-3.75 2.84-7.38 7.68-7.38 4.18 0 7.11 2.85 7.11 6.92 0 4.59-2.32 7.77-5.33 7.77-1.66 0-2.9-1.37-2.5-3.05.47-2 .55-2.27.55-3.06 0-.7-.38-1.29-1.16-1.29-.92 0-1.66.95-1.66 2.23 0 .81.27 1.36.27 1.36s-.9 3.8-1.06 4.5c-.18.76-.11 1.82-.03 2.52C11.13 21.18 12.33 22 12.33 22c.45-.62 1.21-1.84 1.52-3.02.12-.45.61-2.38.61-2.38.55 1.05 2.16 1.94 3.87 1.94 5.1 0 8.78-4.69 8.78-10.52C27.11 4.07 23.14 2 12.2 2Z"/>
            </svg>
          </span>
          <span class="product-share__text">
            {{ block.settings.pinterest_label | escape }}
          </span>
        </a>
      {% endif %}

      {% if block.settings.show_email %}
        <a
          class="product-share__item"
          href="mailto:?subject={{ encoded_title }}&body={{ encoded_url }}"
          aria-label="{{ block.settings.email_label | escape }}"
        >
          <span class="product-share__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z"/>
            </svg>
          </span>
          <span class="product-share__text">
            {{ block.settings.email_label | escape }}
          </span>
        </a>
      {% endif %}

      {% if block.settings.show_copy_link %}
        <button
          type="button"
          class="product-share__item"
          data-product-share-copy
          aria-label="{{ block.settings.copy_label | escape }}"
        >
          <span class="product-share__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M16 1H4a2 2 0 0 0-2 2v12h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z"/>
            </svg>
          </span>
          <span class="product-share__text" data-product-share-copy-text>
            {{ block.settings.copy_label | escape }}
          </span>
        </button>
      {% endif %}
    </div>

    {% if block.settings.show_message %}
      <div
        class="product-share__message"
        data-product-share-message
        role="status"
        aria-live="polite"
      ></div>
    {% endif %}
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productShareReady === 'true') return;

      root.dataset.productShareReady = 'true';

      const nativeButton = root.querySelector('[data-product-share-native]');
      const copyButton = root.querySelector('[data-product-share-copy]');
      const copyText = root.querySelector('[data-product-share-copy-text]');
      const messageEl = root.querySelector('[data-product-share-message]');

      const shareUrl = root.dataset.shareUrl || window.location.href;
      const shareTitle = root.dataset.shareTitle || document.title;

      const copiedLabel = {{ block.settings.copied_label | json }};
      const copyLabel = {{ block.settings.copy_label | json }};
      const copiedMessage = {{ block.settings.copied_message | json }};
      const unsupportedMessage = {{ block.settings.unsupported_message | json }};

      const setMessage = (message) => {
        if (!messageEl) return;

        messageEl.textContent = message || '';

        if (message) {
          window.clearTimeout(root.productShareMessageTimer);
          root.productShareMessageTimer = window.setTimeout(() => {
            messageEl.textContent = '';
          }, 3000);
        }
      };

      if (nativeButton) {
        if (!navigator.share) {
          nativeButton.hidden = true;
        }

        nativeButton.addEventListener('click', async () => {
          if (!navigator.share) {
            setMessage(unsupportedMessage);
            return;
          }

          try {
            await navigator.share({
              title: shareTitle,
              url: shareUrl
            });
          } catch (error) {
            if (error && error.name !== 'AbortError') {
              setMessage(unsupportedMessage);
            }
          }
        });
      }

      if (copyButton) {
        copyButton.addEventListener('click', async () => {
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(shareUrl);
            } else {
              const tempInput = document.createElement('input');
              tempInput.value = shareUrl;
              tempInput.setAttribute('readonly', 'readonly');
              tempInput.style.position = 'absolute';
              tempInput.style.left = '-9999px';
              document.body.appendChild(tempInput);
              tempInput.select();
              document.execCommand('copy');
              document.body.removeChild(tempInput);
            }

            if (copyText) {
              copyText.textContent = copiedLabel;
            }

            setMessage(copiedMessage);

            window.setTimeout(() => {
              if (copyText) {
                copyText.textContent = copyLabel;
              }
            }, 2500);
          } catch (error) {
            setMessage(unsupportedMessage);
          }
        });
      }
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product share",
  "settings": [
    {
      "type": "header",
      "content": "Share"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Share"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Share this product"
    },
    {
      "type": "text",
      "id": "share_text",
      "label": "Share text",
      "default": "Check out this product"
    },
    {
      "type": "checkbox",
      "id": "show_native_share",
      "label": "Show native share",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_x",
      "label": "Show X",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pinterest",
      "label": "Show Pinterest",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copy_link",
      "label": "Show copy link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "Show status message",
      "default": true
    },

    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "native_share_label",
      "label": "Native share label",
      "default": "Share"
    },
    {
      "type": "text",
      "id": "facebook_label",
      "label": "Facebook label",
      "default": "Facebook"
    },
    {
      "type": "text",
      "id": "x_label",
      "label": "X label",
      "default": "X"
    },
    {
      "type": "text",
      "id": "pinterest_label",
      "label": "Pinterest label",
      "default": "Pinterest"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy label",
      "default": "Copy link"
    },
    {
      "type": "text",
      "id": "copied_label",
      "label": "Copied label",
      "default": "Copied"
    },
    {
      "type": "text",
      "id": "copied_message",
      "label": "Copied message",
      "default": "Product link copied."
    },
    {
      "type": "text",
      "id": "unsupported_message",
      "label": "Unsupported message",
      "default": "Sharing is not available right now."
    },

    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "share_style",
      "label": "Share style",
      "default": "buttons",
      "options": [
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "icons",
          "label": "Icons"
        },
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Label font size",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button size",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Share item text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Share item background",
      "default": "#ffffff"
    },
