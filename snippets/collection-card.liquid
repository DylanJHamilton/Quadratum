{% comment %}
  Quadratum — Collection Card (shared)
  File: snippets/collection-card.liquid

  NON-BREAKING PATCH:
  - Adds optional params:
    subtitle, body, cta_label, cta_url, featured, modifier
    cta_style (string, optional)
    cta_use_custom_colors (bool)
    cta_bg, cta_text, cta_border
    cta_bg_hover, cta_text_hover, cta_border_hover
  - CTA rendered outside main <a> to avoid nested interactive elements
  - If new params are not provided, output matches prior behavior
{% endcomment %}

{%- liquid
  assign c = collection

  assign card_preset = card_preset | default: 'catalog'
  assign density = density | default: 'compact'

  assign show_image = show_image
  if show_image == nil
    assign show_image = true
  endif

  assign show_count = show_count
  if show_count == nil
    assign show_count = true
  endif

  assign show_description = show_description
  if show_description == nil
    assign show_description = false
  endif

  assign overlay_text_enabled = overlay_text_enabled
  if overlay_text_enabled == nil
    assign overlay_text_enabled = false
  endif

  assign overlay_text_source = overlay_text_source | default: 'title'
  assign overlay_custom_text = overlay_custom_text | default: ''

  assign image_aspect = image_aspect | default: 'auto'

  assign text_align = text_align | default: 'left'


  assign enable_color_overrides = enable_color_overrides

  assign subtitle = subtitle
  if subtitle == nil
    assign subtitle = ''
  endif

  assign body = body
  if body == nil
    assign body = ''
  endif

  assign cta_label = cta_label
  if cta_label == nil
    assign cta_label = ''
  endif

  assign cta_url = cta_url
  if cta_url == nil
    assign cta_url = ''
  endif

  assign cta_style = cta_style
  if cta_style == nil
    assign cta_style = ''
  endif

  assign cta_use_custom_colors = cta_use_custom_colors
  if cta_use_custom_colors == nil
    assign cta_use_custom_colors = false
  endif

  assign cta_bg = cta_bg | default: ''
  assign cta_text = cta_text | default: ''
  assign cta_border = cta_border | default: ''

  assign cta_bg_hover = cta_bg_hover | default: ''
  assign cta_text_hover = cta_text_hover | default: ''
  assign cta_border_hover = cta_border_hover | default: ''

  assign featured = featured
  if featured == nil
    assign featured = false
  endif

  assign modifier = modifier
  if modifier == nil
    assign modifier = ''
  endif

  assign card_style = ''
  if title_size != nil
  assign card_style = card_style | append: '--q-cc-title-size:' | append: title_size | append: 'px;'
  endif
  if title_weight != nil
  assign card_style = card_style | append: '--q-cc-title-weight:' | append: title_weight | append: ';'
  endif
  if meta_size != nil
  assign card_style = card_style | append: '--q-cc-meta-size:' | append: meta_size | append: 'px;'
  endif
  if meta_opacity != nil
  assign card_style = card_style | append: '--q-cc-meta-opacity:' | append: meta_opacity | append: ';'
  endif

  if enable_color_overrides
    assign card_style = card_style | append: '--q-cc-card-bg:' | append: card_bg | append: ';'
    assign card_style = card_style | append: '--q-cc-card-border:' | append: card_border | append: ';'
    assign card_style = card_style | append: '--q-cc-title-color:' | append: title_color | append: ';'
    assign card_style = card_style | append: '--q-cc-meta-color:' | append: meta_color | append: ';'
    assign card_style = card_style | append: '--q-cc-overlay-color:' | append: overlay_color | append: ';'
    assign card_style = card_style | append: '--q-cc-overlay-text:' | append: overlay_text_color | append: ';'
  endif

  assign cta_style_attr = ''
  if cta_use_custom_colors
    if cta_bg != blank
      assign cta_style_attr = cta_style_attr | append: '--q-cc-cta-bg:' | append: cta_bg | append: ';'
    endif
    if cta_text != blank
      assign cta_style_attr = cta_style_attr | append: '--q-cc-cta-text:' | append: cta_text | append: ';'
    endif
    if cta_border != blank
      assign cta_style_attr = cta_style_attr | append: '--q-cc-cta-border:' | append: cta_border | append: ';'
    endif
    if cta_bg_hover != blank
      assign cta_style_attr = cta_style_attr | append: '--q-cc-cta-bg-hover:' | append: cta_bg_hover | append: ';'
    endif
    if cta_text_hover != blank
      assign cta_style_attr = cta_style_attr | append: '--q-cc-cta-text-hover:' | append: cta_text_hover | append: ';'
    endif
    if cta_border_hover != blank
      assign cta_style_attr = cta_style_attr | append: '--q-cc-cta-border-hover:' | append: cta_border_hover | append: ';'
    endif
  endif

  assign preset_class = 'q-collection-card--' | append: card_preset
  assign density_class = 'q-collection-card--density-' | append: density
  assign align_class = 'q-collection-card--align-' | append: text_align
  assign aspect_class = 'q-collection-card--aspect-' | append: image_aspect

  assign modifier_class = ''
  if modifier != blank
    assign modifier_class = 'q-collection-card--' | append: modifier
  endif

  assign featured_class = ''
  if featured
    assign featured_class = 'q-collection-card--featured'
  endif

  assign has_image = false
  assign img = nil
  if c.featured_image
    assign has_image = true
    assign img = c.featured_image
  endif

  assign overlay_text = ''
  if overlay_text_enabled
    if overlay_text_source == 'custom' and overlay_custom_text != blank
      assign overlay_text = overlay_custom_text
    elsif overlay_text_source == 'description' and c.description != blank
      assign overlay_text = c.description | strip_html | truncate: 90
    else
      assign overlay_text = c.title
    endif
  endif

  assign count_label = ''
  if show_count
    assign count_label = c.products_count | append: ' products'
  endif

  assign resolved_cta_url = cta_url
  if resolved_cta_url == blank
    assign resolved_cta_url = c.url
  endif
-%}

{% if c.url != blank %}
<article
  class="q-collection-card {{ preset_class }} {{ density_class }} {{ align_class }} {{ aspect_class }} {{ featured_class }} {{ modifier_class }}"
  style="{{ card_style }}"
  {{ shopify_attributes }}
  data-collection-card
>
  <a class="q-collection-card__link" href="{{ c.url | escape }}" aria-label="{{ c.title | escape }}">
    {%- if show_image -%}
      <div class="q-collection-card__media" aria-hidden="true">
        <div class="q-collection-card__media-inner">
          {%- if has_image and img -%}
            <img
              class="q-collection-card__img"
              src="{{ img | image_url: width: 1200 }}"
              alt="{{ img.alt | default: c.title | escape }}"
              loading="lazy"
              width="{{ img.width | default: 1200 }}"
              height="{{ img.height | default: 1200 }}"
            />
          {%- else -%}
            <div class="q-collection-card__media-placeholder"></div>
          {%- endif -%}

          {%- if overlay_text_enabled and overlay_text != blank -%}
            <div class="q-collection-card__overlay" aria-hidden="true">
              <div class="q-collection-card__overlay-inner">
                <span class="q-collection-card__overlay-text">{{ overlay_text | escape }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="q-collection-card__content">
      <h3 class="q-collection-card__title">{{ c.title | escape }}</h3>

      {%- if subtitle != blank -%}
        <div class="q-collection-card__subtitle">{{ subtitle | escape }}</div>
      {%- endif -%}

      {%- if show_count and count_label != blank -%}
        <div class="q-collection-card__meta">{{ count_label }}</div>
      {%- endif -%}

      {%- if body != blank -%}
        <div class="q-collection-card__body">{{ body | escape }}</div>
      {%- endif -%}

      {%- if show_description and c.description != blank -%}
        <div class="q-collection-card__desc">{{ c.description | strip_html | truncate: 120 | escape }}</div>
      {%- endif -%}
    </div>
  </a>

  {%- if cta_label != blank -%}
    <div class="q-collection-card__cta" style="{{ cta_style_attr }}">
      <a
        class="q-button q-collection-card__cta-link{% if cta_style != blank %} q-button--{{ cta_style }}{% endif %}"
        href="{{ resolved_cta_url | escape }}"
      >
        {{ cta_label | escape }}
      </a>
    </div>
  {%- endif -%}

  <style>
    .q-collection-card{
      position: relative;
      min-width: 0;
      overflow-wrap: anywhere;
      box-sizing: border-box;
      background: var(--q-cc-card-bg, var(--q-card-bg, transparent));
      border: 1px solid var(--q-cc-card-border, var(--q-card-border, rgba(0,0,0,.10)));
      border-radius: var(--q-radius, 12px);
      overflow: hidden;
    }

    .q-collection-card__link{
      display:block;
      color: inherit;
      text-decoration:none;
      outline: none;
    }
    .q-collection-card__link:focus-visible{
      outline: 2px solid currentColor;
      outline-offset: -3px;
      border-radius: var(--q-radius, 12px);
    }

    .q-collection-card__media{ position: relative; overflow:hidden; }
    .q-collection-card__media-inner{ position: relative; }

    .q-collection-card--aspect-auto .q-collection-card__media-inner{ padding-top: var(--q-ch-media-ratio, var(--q-cc-media-auto, 62%)); height: 0; }
    .q-collection-card--aspect-square .q-collection-card__media-inner{ padding-top: 100%; height: 0; }
    .q-collection-card--aspect-landscape .q-collection-card__media-inner{ padding-top: 66.666%; height: 0; }

    .q-collection-card__img,
    .q-collection-card__media-placeholder{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit: var(--q-cc-media-fit, cover);
      display:block;
      background: rgba(0,0,0,.04);
    }

    .q-collection-card__overlay{
      position:absolute;
      inset:0;
      display:flex;
      align-items:flex-end;
      padding: .8rem;
      pointer-events:none;
    }
    .q-collection-card__overlay-inner{
      width:100%;
      border-radius: 12px;
      padding: .6rem .7rem;
      background: var(--q-cc-overlay-color, rgba(0,0,0,.55));
      backdrop-filter: blur(6px);
    }
    .q-collection-card__overlay-text{
      display:block;
      color: var(--q-cc-overlay-text, #fff);
      font-size: .95rem;
      line-height: 1.2;
    }

    .q-collection-card__content{
      padding: .9rem .95rem;
      text-align: left;
    }
    .q-collection-card--align-center .q-collection-card__content{ text-align:center; }

    .q-collection-card__title{
      margin:0;
      font-size: var(--q-cc-title-size, 16px);
      font-weight: var(--q-cc-title-weight, 600);
      color: var(--q-cc-title-color, inherit);
      font-family: var(--q-cc-title-ff, inherit);
      letter-spacing: var(--q-cc-title-ls, normal);
    }

    .q-collection-card__subtitle,
    .q-collection-card__meta{
      margin-top: .35rem;
      font-size: var(--q-cc-meta-size, 13px);
      opacity: var(--q-cc-meta-opacity, .82);
      color: var(--q-cc-meta-color, inherit);
    }

    .q-collection-card__body{
      margin-top: .45rem;
      font-size: var(--q-cc-body-size, var(--q-body-fs, 1rem));
      opacity: .95;
      color: var(--q-cc-meta-color, inherit);
      line-height: 1.35;
    }

    .q-collection-card__desc{
      margin-top: .45rem;
      font-size: var(--q-body-fs, 1rem);
      opacity: .9;
      color: var(--q-cc-meta-color, inherit);
    }

    .q-collection-card__cta{
      padding: 0 .95rem .95rem;
    }

    /* HARD GUARANTEE: CTA looks like a button even if global q-button CSS is missing */
    .q-collection-card__cta-link{
      box-sizing: border-box;
      white-space: normal;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 44px;
      padding: .72rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--q-cc-cta-border, rgba(0,0,0,.14));
      background: var(--q-cc-cta-bg, rgba(0,0,0,.06));
      color: var(--q-cc-cta-text, currentColor);
      text-decoration: none;
      font-weight: 600;
      line-height: 1.1;
      transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
    }
    .q-collection-card__cta-link:hover{
      background: var(--q-cc-cta-bg-hover, var(--q-cc-cta-bg, rgba(0,0,0,.08)));
      color: var(--q-cc-cta-text-hover, var(--q-cc-cta-text, currentColor));
      border-color: var(--q-cc-cta-border-hover, var(--q-cc-cta-border, rgba(0,0,0,.18)));
      transform: translateY(-1px);
    }
    .q-collection-card__cta-link:focus-visible{
      outline: 2px solid currentColor;
      outline-offset: -3px;
    }

    .q-collection-card--density-compact .q-collection-card__content{ padding: .8rem .9rem; }
    .q-collection-card--density-comfortable .q-collection-card__content{ padding: 1rem 1rem; }
    .q-collection-card--density-compact .q-collection-card__cta{ padding: 0 .9rem .9rem; }
    .q-collection-card--density-comfortable .q-collection-card__cta{ padding: 0 1rem 1rem; }
    .q-collection-card__cta-link.q-button--primary { background: var(--q-cc-cta-bg, var(--q-ch-accent, #111)); color: var(--q-cc-cta-text, #fff); }
    .q-collection-card__cta-link.q-button--secondary { background: var(--q-cc-cta-bg, #eee); color: var(--q-cc-cta-text, #111); }
    .q-collection-card__cta-link.q-button--outline { background: transparent; border-color: currentColor; }
    .q-collection-card__cta-link.q-button--ghost { background: transparent; border-color: transparent; }
    .q-collection-card__cta-link.q-button--link { background: transparent; border-color: transparent; text-decoration: underline; border-radius: 0; }
    /* Existing preset choices now have bounded, shared visual treatments. */
    .q-collection-card.q-collection-card--editorial { --q-cc-media-auto: 75%; }
    .q-collection-card.q-collection-card--tech { border-radius: 4px; border-width: 2px; }
    .q-collection-card.q-collection-card--minimal { border-color: var(--q-cc-card-border, transparent); background: var(--q-cc-card-bg, transparent); }
    .q-collection-card.q-collection-card--pill { border-radius: 28px; }
    .q-collection-card.q-collection-card--pill .q-collection-card__media { margin: .75rem .75rem 0; border-radius: 999px; }
    .q-collection-card.q-collection-card--catalog { --q-cc-media-auto: 62%; }

    @media (prefers-reduced-motion: reduce) {
      .q-collection-card__cta-link { transition: none; }
      .q-collection-card__cta-link:hover { transform: none; }
    }
  </style>
</article>

{% endif %}
