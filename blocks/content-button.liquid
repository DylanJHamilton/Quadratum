{%- liquid
  assign button_label = block.settings.label | default: 'Shop now'
  assign button_url = block.settings.url
  assign button_aria_label = block.settings.aria_label | default: button_label
  assign button_tag = 'button'

  if button_url != blank
    assign button_tag = 'a'
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'button' %}

<{{ button_tag }}
  class="
    qtm-button
    qtm-button--{{ block.settings.button_style }}
    qtm-button--{{ block.settings.button_size }}
    {% if block.settings.full_width %} qtm-button--full{% endif %}
  "
  {% if button_url != blank %}
    href="{{ button_url }}"
    {% if block.settings.open_new_tab %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  {% else %}
    type="button"
  {% endif %}
  aria-label="{{ button_aria_label | escape }}"
  style="
    --qtm-button-text-color: {{ block.settings.text_color }};
    --qtm-button-background-color: {{ block.settings.background_color_button }};
    --qtm-button-border-color: {{ block.settings.border_color_button }};
    --qtm-button-hover-text-color: {{ block.settings.hover_text_color }};
    --qtm-button-hover-background-color: {{ block.settings.hover_background_color }};
    --qtm-button-hover-border-color: {{ block.settings.hover_border_color }};
    --qtm-button-radius: {{ block.settings.button_radius }}px;
    --qtm-button-border-width: {{ block.settings.button_border_width }}px;
    --qtm-button-font-family: {% if block.settings.font_family == 'heading' %}var(--font-heading-family){% elsif block.settings.font_family == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
    --qtm-button-font-weight: {{ block.settings.font_weight }};
    --qtm-button-letter-spacing: {{ block.settings.letter_spacing }}px;
  "
>
  {% if block.settings.icon_left != blank %}
    <span class="qtm-button__icon qtm-button__icon--left" aria-hidden="true">
      {{ block.settings.icon_left | escape }}
    </span>
  {% endif %}

  <span class="qtm-button__label">
    {{ button_label | escape }}
  </span>

  {% if block.settings.icon_right != blank %}
    <span class="qtm-button__icon qtm-button__icon--right" aria-hidden="true">
      {{ block.settings.icon_right | escape }}
    </span>
  {% endif %}
</{{ button_tag }}>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
