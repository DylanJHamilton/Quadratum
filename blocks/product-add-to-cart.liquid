{% if product != blank %}
{%- liquid
  assign block_id = 'product-add-to-cart-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant
  assign form_id = block_id | append: '-form'
  assign quantity_min = current_variant.quantity_rule.min | default: 1
  assign quantity_step = current_variant.quantity_rule.increment | default: 1
  assign quantity_max = current_variant.quantity_rule.max
  assign selected_allocation = current_variant.selected_selling_plan_allocation
  if selected_allocation == blank and product_context.requires_selling_plan
    assign selected_allocation = current_variant.selling_plan_allocations.first
  endif
  assign purchase_available = current_variant.available
  if product_context.requires_selling_plan and selected_allocation == blank
    assign purchase_available = false
  endif

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign selector_style = block.settings.selector_style | default: 'standard'

  assign min_quantity = block.settings.min_quantity | default: 1 | at_least: quantity_min
  assign quantity_offset = min_quantity | minus: quantity_min | modulo: quantity_step
  if quantity_offset > 0
    assign min_quantity = min_quantity | plus: quantity_step | minus: quantity_offset
  endif
  assign max_quantity = block.settings.max_quantity | default: 99
  if quantity_max != blank
    assign max_quantity = max_quantity | at_most: quantity_max
  endif
  assign initial_quantity = block.settings.default_quantity | at_least: min_quantity | at_most: max_quantity
  assign quantity_offset = initial_quantity | minus: quantity_min | modulo: quantity_step
  assign initial_quantity = initial_quantity | minus: quantity_offset | at_least: min_quantity

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-add-to-cart
    product-add-to-cart--{{ selector_style }}
    product-add-to-cart--width-{{ width }}
    product-add-to-cart--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} product-add-to-cart--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} product-add-to-cart--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} product-add-to-cart--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-add-to-cart--animate product-add-to-cart--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-add-to-cart-margin-top: {{ block.settings.margin_top }}px;
    --product-add-to-cart-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-add-to-cart-padding: {{ block.settings.padding }}px;
    --product-add-to-cart-gap: {{ block.settings.gap }}px;
    --product-add-to-cart-width: {{ block.settings.control_width }}px;
    --product-add-to-cart-height: {{ block.settings.control_height }}px;
    --product-add-to-cart-border-width: {{ block.settings.border_width }}px;
    --product-add-to-cart-border-radius: {{ block.settings.border_radius }}px;
    --product-add-to-cart-heading-color: {{ block.settings.heading_color }};
    --product-add-to-cart-text-color: {{ block.settings.text_color }};
    --product-add-to-cart-background-color: {{ block.settings.background_color }};
    --product-add-to-cart-border-color: {{ block.settings.border_color }};
    --product-add-to-cart-active-color: {{ block.settings.active_color }};
  "
  data-qtm-product-block-commerce="add-to-cart"
  data-product-url="{{ product_context.url | escape }}"
  data-requires-plan="{{ product_context.requires_selling_plan }}"
  data-initial-plan="{{ selected_allocation.selling_plan.id }}"
  data-add-label="{{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}"
  data-sold-label="{{ block.settings.sold_out_label | default: 'Sold out' | escape }}"
  data-unavailable-label="{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}"
  data-available-label="{{ 'Available' | escape }}"
  data-cart-adding-message="{{ block.settings.adding_message | default: 'Adding to cart...' | escape }}"
  data-cart-added-message="{{ block.settings.added_message | default: 'Added to cart.' | escape }}"
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-add-to-cart
  data-min-quantity="{{ block.settings.min_quantity }}"
  data-max-quantity="{{ block.settings.max_quantity }}"

>
  {% render 'qtm-product-block-data', product: product_context %}
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--product-add-to-cart-margin-top);
      margin-bottom: var(--product-add-to-cart-margin-bottom);
      padding: var(--product-add-to-cart-padding);
      color: var(--product-add-to-cart-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-add-to-cart--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-add-to-cart--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-add-to-cart--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-add-to-cart--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-add-to-cart--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-add-to-cart--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-add-to-cart--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-add-to-cart--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-add-to-cart__inner {
      display: grid;
      gap: var(--product-add-to-cart-gap);
      min-width: 0;
    }

    #{{ block_id }} .product-add-to-cart__label {
      margin: 0;
      color: var(--product-add-to-cart-heading-color);
      line-height: 1.25;
      font-size: 0.94em;
    }

    #{{ block_id }} .product-add-to-cart__control {
      display: inline-grid;
      grid-template-columns: minmax(24px, 1fr) minmax(0, 2fr) minmax(24px, 1fr);
      align-items: stretch;
      width: var(--product-add-to-cart-width);
      max-width: 100%;
      height: var(--product-add-to-cart-height);
      overflow: hidden;
      color: var(--product-add-to-cart-text-color);
      background: var(--product-add-to-cart-background-color);
      border: var(--product-add-to-cart-border-width) solid var(--product-add-to-cart-border-color);
      border-radius: var(--product-add-to-cart-border-radius);
    }

    #{{ block_id }}.product-add-to-cart--compact .product-add-to-cart__control {
      grid-template-columns: minmax(24px, 1fr) minmax(0, 2fr) minmax(24px, 1fr);
      height: var(--product-add-to-cart-height);
    }

    #{{ block_id }}.product-add-to-cart--minimal .product-add-to-cart__control {
      border-left: 0;
      border-right: 0;
      border-radius: 0;
      width: min(var(--product-add-to-cart-width), 180px);
    }

    #{{ block_id }}.product-add-to-cart--align-center .product-add-to-cart__control {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-add-to-cart--align-right .product-add-to-cart__control {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-add-to-cart__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      color: var(--product-add-to-cart-heading-color);
      background: transparent;
      border: 0;
      cursor: pointer;
      font: inherit;
      font-size: 1.25em;
      line-height: 1;
      transition: background 180ms ease, color 180ms ease, opacity 180ms ease;
    }

    #{{ block_id }} .product-add-to-cart__button:hover {
      color: var(--product-add-to-cart-active-color);
      background: rgba(0, 0, 0, 0.04);
    }

    #{{ block_id }} .product-add-to-cart__button:focus-visible {
      outline: 2px solid var(--product-add-to-cart-active-color);
      outline-offset: -2px;
    }

    #{{ block_id }} .product-add-to-cart__button[disabled] {
      cursor: not-allowed;
      opacity: 0.4;
    }

    #{{ block_id }} .product-add-to-cart__input {
      width: 100%;
      height: 100%;
      min-width: 0;
      padding: 0 8px;
      color: var(--product-add-to-cart-heading-color);
      background: transparent;
      border-top: 0;
      border-bottom: 0;
      border-left: var(--product-add-to-cart-border-width) solid var(--product-add-to-cart-border-color);
      border-right: var(--product-add-to-cart-border-width) solid var(--product-add-to-cart-border-color);
      border-radius: 0;
      text-align: center;
      font: inherit;
      font-variant-numeric: tabular-nums;
      appearance: textfield;
      -moz-appearance: textfield;
    }

    #{{ block_id }} .product-add-to-cart__input::-webkit-outer-spin-button,
    #{{ block_id }} .product-add-to-cart__input::-webkit-inner-spin-button {
      margin: 0;
      appearance: none;
      -webkit-appearance: none;
    }

    #{{ block_id }} .product-add-to-cart__input:focus-visible {
      outline: 2px solid var(--product-add-to-cart-active-color);
      outline-offset: -2px;
    }

    #{{ block_id }} .product-add-to-cart__note {
      color: var(--product-add-to-cart-text-color);
      line-height: 1.35;
      font-size: 0.88em;
      opacity: 0.78;
    }

    #{{ block_id }}.product-add-to-cart--align-center .product-add-to-cart__note {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-add-to-cart--align-right .product-add-to-cart__note {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.product-add-to-cart--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-add-to-cart--animate-fade {
      animation-name: productAddToCartFade;
    }

    #{{ block_id }}.product-add-to-cart--animate-fade_up {
      animation-name: productAddToCartFadeUp;
    }

    #{{ block_id }}.product-add-to-cart--animate-fade_down {
      animation-name: productAddToCartFadeDown;
    }

    #{{ block_id }}.product-add-to-cart--animate-fade_left {
      animation-name: productAddToCartFadeLeft;
    }

    #{{ block_id }}.product-add-to-cart--animate-fade_right {
      animation-name: productAddToCartFadeRight;
    }

    #{{ block_id }}.product-add-to-cart--animate-zoom {
      animation-name: productAddToCartZoom;
    }

    @keyframes productAddToCartFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productAddToCartFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productAddToCartFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productAddToCartFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productAddToCartFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productAddToCartZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-add-to-cart--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-add-to-cart--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-add-to-cart--hide-mobile {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-add-to-cart--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-add-to-cart__button {
        transition: none;
      }
    }
    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} :is(button, select, input, a):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    #{{ block_id }} :is(button, select, input) { max-width: 100%; }
    #{{ block_id }}:focus-within { opacity: 1; transform: none; animation: none; }
    #{{ block_id }} [data-b8-fallback] { display: grid; gap: 6px; min-width: 0; }
    #{{ block_id }} [data-b8-fallback] select, #{{ block_id }} [name="selling_plan"] { width: 100%; min-width: 0; min-height: 44px; }
      #{{ block_id }} .product-add-to-cart__submit { min-height: var(--product-add-to-cart-height); width: 100%; padding: 12px; border: var(--product-add-to-cart-border-width) solid var(--product-add-to-cart-border-color); border-radius: var(--product-add-to-cart-border-radius); background: var(--product-add-to-cart-background-color); color: var(--product-add-to-cart-heading-color); cursor: pointer; }
    #{{ block_id }} .product-add-to-cart__submit:hover { color: var(--product-add-to-cart-active-color); }
  {% unless block.settings.show_on_desktop or request.design_mode %}@media screen and (min-width: 990px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_tablet or request.design_mode %}@media screen and (min-width: 750px) and (max-width: 989px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_mobile or request.design_mode %}@media screen and (max-width: 749px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
  </style>

  {% form 'product', product_context, id: form_id, class: 'product-add-to-cart__inner', data-cart-drawer-add: '' %}
<div data-b8-fallback>
        <label for="{{ block_id }}-native-variant">{{ 'Variant' | escape }}</label>
        <select id="{{ block_id }}-native-variant" name="id" class="product-add-to-cart__variant" data-b8-variant-id>
          {% assign selected_listed = false %}{% for variant in product_context.variants %}{% if variant.id == current_variant.id %}{% assign selected_listed = true %}{% endif %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}
        {% unless selected_listed %}<option value="{{ current_variant.id }}" selected>{{ current_variant.title | escape }}{% unless current_variant.available %} — Sold out{% endunless %}</option>{% endunless %}
        </select>
      </div>
    {% if block.settings.show_label and block.settings.label != blank %}
      <label class="product-add-to-cart__label" for="{{ block_id }}-quantity">
        {{ block.settings.label | escape }}
      </label>
    {% endif %}

    <div class="product-add-to-cart__control">
      <button
        type="button"
        class="product-add-to-cart__button"
        data-product-quantity-minus data-b8-minus disabled
        aria-label="{{ block.settings.decrease_label | default: 'Decrease quantity' | escape }}"
      >
        −
      </button>

      <input
        id="{{ block_id }}-quantity"
        class="product-add-to-cart__input"
        type="number"
        name="quantity"
        min="{{ min_quantity }}"
        max="{{ max_quantity }}"
        value="{{ initial_quantity }}"
        step="{{ quantity_step }}"
        inputmode="numeric"
        data-product-quantity-input
        aria-label="{{ block.settings.input_label | default: 'Quantity' | escape }}"
      >

      <button
        type="button"
        class="product-add-to-cart__button"
        data-product-quantity-plus data-b8-plus disabled
        aria-label="{{ block.settings.increase_label | default: 'Increase quantity' | escape }}"
      >
        +
      </button>
    </div>

    {% if block.settings.show_note and block.settings.note != blank %}
      <div class="product-add-to-cart__note">
        {{ block.settings.note | escape }}
      </div>
    {% endif %}
    {% render 'product-selling-plans', product: product_context, id: block_id %}
    <button type="submit" name="add" data-b8-submit class="product-add-to-cart__submit" {% unless purchase_available %}disabled{% endunless %}>{{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}</button>
    <p data-cart-add-status role="status" aria-live="polite"></p>
  {% endform %}

</div>

{% elsif request.design_mode %}<p>Select a product to configure this block.</p>{% endif %}

{% schema %}
{
  "name": "Product add to cart",
  "settings": [
    {
      "type": "header",
      "content": "Purchase"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "Unavailable"
    },
    {
      "type": "text",
      "id": "adding_message",
      "label": "Adding message",
      "default": "Adding to cart..."
    },
    {
      "type": "text",
      "id": "added_message",
      "label": "Added message",
      "default": "Added to cart."
    },
    {
      "type": "header",
      "content": "Quantity"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input accessibility label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "decrease_label",
      "label": "Decrease button label",
      "default": "Decrease quantity"
    },
    {
      "type": "text",
      "id": "increase_label",
      "label": "Increase button label",
      "default": "Increase quantity"
    },
    {
      "type": "range",
      "id": "default_quantity",
      "label": "Default quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "min_quantity",
      "label": "Minimum quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum quantity",
      "min": 1,
      "max": 101,
      "step": 1,
      "default": 99
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note",
      "default": false
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "select",
      "id": "selector_style",
      "label": "Selector style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "control_width",
      "label": "Control width",
      "min": 120,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "control_height",
      "label": "Control height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Label color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Control background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Control border",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
