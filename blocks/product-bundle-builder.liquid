{%- liquid
  assign block_id = 'product-bundle-builder-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'cards'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

-%}

{% assign rendered_items = 0 %}{% assign extra_items = 0 %}{% assign bundle_total = 0 %}{% assign available_item_count = 0 %}{% assign bundle_seen = '|' %}
{% assign bundle_limit = block.settings.product_count %}
{% capture bundle_items_markup %}
  {% for bundle_index in (0..bundle_limit) %}
    {% if bundle_index == 0 %}
      {% unless block.settings.include_current_product %}{% continue %}{% endunless %}
      {% assign bundle_product = product_context %}
    {% else %}
      {% assign bundle_key = 'bundle_product_' | append: bundle_index %}{% assign bundle_product = block.settings[bundle_key] %}
    {% endif %}
    {% if bundle_product == blank %}{% continue %}{% endif %}
    {% assign bundle_token = '|' | append: bundle_product.id | append: '|' %}{% if bundle_seen contains bundle_token %}{% continue %}{% endif %}
    {% if bundle_index > 0 and extra_items >= bundle_limit %}{% break %}{% endif %}
    {% assign bundle_seen = bundle_seen | append: bundle_token %}
    {% assign is_current = false %}{% if bundle_product.id == product_context.id %}{% assign is_current = true %}{% endif %}
    {% render 'qtm-block-bundle-item', bundle_product: bundle_product, prefix: 'product-bundle-builder', block: block, index: available_item_count, selectable: false, is_current: is_current %}
    {% capture bundle_line %}{% render 'qtm-block-bundle-item', bundle_product: bundle_product, output: 'line' %}{% endcapture %}{% assign bundle_line = bundle_line | plus: 0 %}{% assign bundle_total = bundle_total | plus: bundle_line %}
    {% capture bundle_available %}{% render 'qtm-block-bundle-item', bundle_product: bundle_product, output: 'available' %}{% endcapture %}{% if bundle_available == 'true' %}{% assign available_item_count = available_item_count | plus: 1 %}{% endif %}
    {% assign rendered_items = rendered_items | plus: 1 %}{% if bundle_index > 0 %}{% assign extra_items = extra_items | plus: 1 %}{% endif %}
  {% endfor %}
{% endcapture %}

<div
  id="{{ block_id }}"
  class="
    product-bundle-builder
    product-bundle-builder--{{ layout_style }}
    product-bundle-builder--width-{{ block_width }}
    product-bundle-builder--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} product-bundle-builder--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} product-bundle-builder--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} product-bundle-builder--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-bundle-builder--animate product-bundle-builder--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-bundle-builder-margin-top: {{ block.settings.margin_top }}px;
    --product-bundle-builder-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-bundle-builder-padding: {{ block.settings.padding }}px;
    --product-bundle-builder-gap: {{ block.settings.gap }}px;
    --product-bundle-builder-card-padding: {{ block.settings.card_padding }}px;
    --product-bundle-builder-border-width: {{ block.settings.border_width }}px;
    --product-bundle-builder-border-radius: {{ block.settings.border_radius }}px;
    --product-bundle-builder-heading-color: {{ block.settings.heading_color }};
    --product-bundle-builder-text-color: {{ block.settings.text_color }};
    --product-bundle-builder-background-color: {{ block.settings.background_color }};
    --product-bundle-builder-card-background-color: {{ block.settings.card_background_color }};
    --product-bundle-builder-border-color: {{ block.settings.border_color }};
    --product-bundle-builder-link-color: {{ block.settings.link_color }};
    --product-bundle-builder-badge-background: {{ block.settings.badge_background_color }};
    --product-bundle-builder-badge-text: {{ block.settings.badge_text_color }};
    --product-bundle-builder-button-background: {{ block.settings.button_background_color }};
    --product-bundle-builder-button-text: {{ block.settings.button_text_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-qtm-block-bundle
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-base-currency="{{ shop.currency | escape }}"
  data-options-required="{{ block.settings.options_required_label | escape }}"
  data-item-unavailable="{{ block.settings.item_unavailable_label | escape }}"
  {% if rendered_items == 0 and request.design_mode == false %}hidden{% endif %}
>
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--product-bundle-builder-margin-top);
      margin-bottom: var(--product-bundle-builder-margin-bottom);
      padding: var(--product-bundle-builder-padding);
      color: var(--product-bundle-builder-text-color);
      background: var(--product-bundle-builder-background-color);
    }

    #{{ block_id }}.product-bundle-builder--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-bundle-builder--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-bundle-builder--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-bundle-builder--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-bundle-builder--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-bundle-builder--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-bundle-builder--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-bundle-builder--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-bundle-builder__inner {
      display: grid;
      gap: var(--product-bundle-builder-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .product-bundle-builder__header {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-bundle-builder__heading {
      margin: 0;
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-bundle-builder__text {
      color: var(--product-bundle-builder-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-bundle-builder__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-bundle-builder__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-bundle-builder__badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      padding: 6px 10px;
      border-radius: 999px;
      color: var(--product-bundle-builder-badge-text);
      background: var(--product-bundle-builder-badge-background);
      line-height: 1.2;
      font-size: 0.84em;
    }

    #{{ block_id }}.product-bundle-builder--align-center .product-bundle-builder__badge {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-bundle-builder--align-right .product-bundle-builder__badge {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-bundle-builder__layout {
      display: grid;
      gap: var(--product-bundle-builder-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
      align-items: center;
    }

    #{{ block_id }} .product-bundle-builder__items {
      display: grid;
      gap: var(--product-bundle-builder-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-bundle-builder--grid .product-bundle-builder__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.product-bundle-builder--cards .product-bundle-builder__items,
    #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .product-bundle-builder__item {
      position: relative;
      min-width: 0;
      display: grid;
      grid-template-columns: min(88px, 30%) minmax(0, 1fr);
      gap: 14px;
      align-items: center;
      padding: min(var(--product-bundle-builder-card-padding), 12%);
      color: var(--product-bundle-builder-text-color);
      background: var(--product-bundle-builder-card-background-color);
      border: var(--product-bundle-builder-border-width) solid var(--product-bundle-builder-border-color);
      border-radius: var(--product-bundle-builder-border-radius);
    }

    #{{ block_id }}.product-bundle-builder--cards .product-bundle-builder__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .product-bundle-builder__image-wrap {
      width: 88px;
      height: 88px;
      overflow: hidden;
      border-radius: max(calc(var(--product-bundle-builder-border-radius) - 8px), 0px);
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .product-bundle-builder__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #{{ block_id }} .product-bundle-builder__image-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 88px;
      height: 88px;
      color: var(--product-bundle-builder-text-color);
      background: rgba(0, 0, 0, 0.06);
      border-radius: max(calc(var(--product-bundle-builder-border-radius) - 8px), 0px);
      font-size: 0.82em;
      text-align: center;
    }

    #{{ block_id }} .product-bundle-builder__item-content {
      display: grid;
      gap: 5px;
      min-width: 0;
    }

    #{{ block_id }} .product-bundle-builder__item-title {
      margin: 0;
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.25;
    }

    #{{ block_id }} .product-bundle-builder__item-title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-bundle-builder__item-title a:hover {
      color: var(--product-bundle-builder-link-color);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    #{{ block_id }} .product-bundle-builder__variant {
      color: var(--product-bundle-builder-text-color);
      line-height: 1.35;
      opacity: 0.72;
      font-size: 0.9em;
    }

    #{{ block_id }} .product-bundle-builder__price {
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.2;
      white-space: normal;
    }

    #{{ block_id }} .product-bundle-builder__unavailable {
      color: var(--product-bundle-builder-text-color);
      opacity: 0.72;
      white-space: normal;
    }

    #{{ block_id }} .product-bundle-builder__summary {
      display: grid;
      gap: 12px;
      min-width: 0;
      padding: min(var(--product-bundle-builder-card-padding), 12%);
      color: var(--product-bundle-builder-text-color);
      background: var(--product-bundle-builder-card-background-color);
      border: var(--product-bundle-builder-border-width) solid var(--product-bundle-builder-border-color);
      border-radius: var(--product-bundle-builder-border-radius);
    }

    #{{ block_id }}.product-bundle-builder--cards .product-bundle-builder__summary {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .product-bundle-builder__total-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      color: var(--product-bundle-builder-heading-color);
      line-height: 1.25;
    }

    #{{ block_id }} .product-bundle-builder__savings {
      color: var(--product-bundle-builder-link-color);
      line-height: 1.4;
    }

    #{{ block_id }} .product-bundle-builder__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 46px;
      padding: 12px 18px;
      border: var(--product-bundle-builder-border-width) solid var(--product-bundle-builder-button-background);
      border-radius: var(--product-bundle-builder-border-radius);
      color: var(--product-bundle-builder-button-text);
      background: var(--product-bundle-builder-button-background);
      cursor: pointer;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-bundle-builder__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-bundle-builder__button:focus-visible {
      outline: 2px solid var(--product-bundle-builder-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-bundle-builder__button[disabled] {
      cursor: not-allowed;
      opacity: 0.55;
      transform: none;
    }

    #{{ block_id }} .product-bundle-builder__message {
      min-height: 1.4em;
      color: var(--product-bundle-builder-text-color);
      line-height: 1.4;
      font-size: 0.92em;
    }

    #{{ block_id }}.product-bundle-builder--animate {
      opacity: 1;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade {
      animation-name: productBundleBuilderFade;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_up {
      animation-name: productBundleBuilderFadeUp;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_down {
      animation-name: productBundleBuilderFadeDown;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_left {
      animation-name: productBundleBuilderFadeLeft;
    }

    #{{ block_id }}.product-bundle-builder--animate-fade_right {
      animation-name: productBundleBuilderFadeRight;
    }

    #{{ block_id }}.product-bundle-builder--animate-zoom {
      animation-name: productBundleBuilderZoom;
    }

    @keyframes productBundleBuilderFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productBundleBuilderFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productBundleBuilderFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productBundleBuilderFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productBundleBuilderFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productBundleBuilderZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-bundle-builder--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-bundle-builder--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__layout {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-bundle-builder--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-bundle-builder--inline .product-bundle-builder__layout,
      #{{ block_id }}.product-bundle-builder--grid .product-bundle-builder__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-bundle-builder__item {
        grid-template-columns: min(72px, 30%) minmax(0, 1fr);
        padding: min(var(--product-bundle-builder-card-padding), 20px, 12%);
      }

      #{{ block_id }} .product-bundle-builder__price,
      #{{ block_id }} .product-bundle-builder__unavailable {
        grid-column: 2;
      }

      #{{ block_id }} .product-bundle-builder__image-wrap,
      #{{ block_id }} .product-bundle-builder__image-placeholder {
        width: 72px;
        height: 72px;
      }

      #{{ block_id }} .product-bundle-builder__summary {
        padding: min(var(--product-bundle-builder-card-padding), 20px, 12%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-bundle-builder--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-bundle-builder__button {
        transition: none;
      }

      #{{ block_id }} .product-bundle-builder__button:hover {
        transform: none;
      }
    }
    #{{ block_id }}[hidden], #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} a:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
    #{{ block_id }} .product-bundle-builder__button { max-width: 100%; white-space: normal; }
    #{{ block_id }} .product-bundle-builder__summary-row, #{{ block_id }} .product-bundle-builder__total-row { flex-wrap: wrap; }
    #{{ block_id }} [aria-busy="true"] .product-bundle-builder__button { opacity: .6; }
    #{{ block_id }} .product-bundle-builder__placeholder { display: block; width: 100%; height: 100%; }
    #{{ block_id }} .product-bundle-builder__image-wrap { max-width: 100%; height: auto; aspect-ratio: 1; }
  </style>


  {% if rendered_items > 0 %}
  <div class="product-bundle-builder__inner">
    {% if block.settings.bundle_title != blank or block.settings.bundle_description != blank or block.settings.bundle_savings != blank %}
      <div class="product-bundle-builder__header">
        {% if block.settings.bundle_savings != blank %}
          <span class="product-bundle-builder__badge">
            {{ block.settings.bundle_savings | escape }}
          </span>
        {% endif %}

        {% if block.settings.bundle_title != blank %}
          <h3 class="product-bundle-builder__heading">
            {{ block.settings.bundle_title | escape }}
          </h3>
        {% endif %}

        {% if block.settings.bundle_description != blank %}
          <div class="product-bundle-builder__text">
            {{ block.settings.bundle_description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <form
      class="product-bundle-builder__form"
      action="{{ routes.cart_add_url | escape }}"
      method="post"
      enctype="multipart/form-data"
      data-bundle-form data-cart-drawer-add data-empty-message="{{ block.settings.unavailable_label | escape }}"
    >
      <div class="product-bundle-builder__layout">
        <div class="product-bundle-builder__items">
          {{ bundle_items_markup }}
        </div>

        <div class="product-bundle-builder__summary">
          <div class="product-bundle-builder__total-row">
            <span>{{ block.settings.total_label | escape }}</span>
            <strong data-bundle-total>{{ bundle_total | money }}</strong>
          </div>

          {% if block.settings.bundle_savings != blank %}
            <div class="product-bundle-builder__savings">
              {{ block.settings.bundle_savings | escape }}
            </div>
          {% endif %}

          <button
            class="product-bundle-builder__button"
            type="submit"
            {% if available_item_count == 0 %}disabled{% endif %}
            data-bundle-submit data-available-label="{{ block.settings.cta_label | default: 'Add bundle to cart' | escape }}" data-unavailable-label="{{ block.settings.unavailable_label | escape }}"
          >
            {% if available_item_count > 0 %}
              {{ block.settings.cta_label | default: 'Add bundle to cart' | escape }}
            {% else %}
              {{ block.settings.unavailable_label | escape }}
            {% endif %}
          </button>

          <div
            class="product-bundle-builder__message"
            data-cart-add-status
            role="status"
            aria-live="polite"
          ></div>
        </div>
      </div>
    </form>
  </div>
  {% elsif request.design_mode %}<p>Select products to build a bundle.</p>{% endif %}
{% if product_context != blank %}{% render 'qtm-product-block-data', product: product_context, image_width: 600 %}{% endif %}
</div>

{% schema %}
{
  "name": "Product bundle builder",
  "settings": [
    {
      "type": "header",
      "content": "Bundle"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Bundle title",
      "default": "Selected products"
    },
    {
      "type": "richtext",
      "id": "bundle_description",
      "label": "Bundle description"
    },
    {
      "type": "text",
      "id": "bundle_savings",
      "label": "Optional bundle offer text",
      "info": "Merchant-written offer only. This text does not create a discount."
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Bundle total"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Add bundle to cart"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "Bundle unavailable"
    },
    {
      "type": "checkbox",
      "id": "include_current_product",
      "label": "Include current product",
      "default": true
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Number of bundle products",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "product",
      "id": "bundle_product_1",
      "label": "Bundle product 1"
    },
    {
      "type": "product",
      "id": "bundle_product_2",
      "label": "Bundle product 2"
    },
    {
      "type": "product",
      "id": "bundle_product_3",
      "label": "Bundle product 3"
    },
    {
      "type": "product",
      "id": "bundle_product_4",
      "label": "Bundle product 4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
