<section class="mc-editorial" aria-labelledby="MorrowEditorialTitle-{{ section.id }}">
  <header class="mc-section-heading">
    <div><p class="mc-eyebrow">{{ section.settings.kicker | escape }}</p><h2 id="MorrowEditorialTitle-{{ section.id }}">{{ section.settings.heading | escape }}<br><em>{{ section.settings.heading_accent | escape }}</em></h2></div>
    {% if section.settings.body != blank %}<div class="mc-editorial__intro">{{ section.settings.body }}</div>{% endif %}
  </header>
  <div class="mc-editorial-grid">
    {% for block in section.blocks %}
      {%- assign story_asset = block.settings.image_asset | default: 'mc-cat-peek.webp' -%}
      <a class="mc-editorial-card mc-editorial-card--{{ forloop.index }}" href="{{ block.settings.link | default: '#morrow-cat-demo-note' }}" {{ block.shopify_attributes }}>
        <span class="mc-editorial-card__kicker">{{ block.settings.kicker | escape }}</span>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'mc-editorial-card__image', alt: block.settings.image_alt, loading: 'lazy', widths: '400, 600, 800, 1000' }}
        {% else %}
          <img class="mc-editorial-card__image" src="{{ story_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1000" height="700" loading="lazy">
        {% endif %}
        <span class="mc-editorial-card__title">{{ block.settings.title | escape }}</span><span class="mc-editorial-card__arrow" aria-hidden="true">↗</span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Morrow Cat Journal",
  "max_blocks":3,
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"Notes from the cat room"},
    {"type":"text","id":"heading","label":"Heading","default":"Read the room."},
    {"type":"text","id":"heading_accent","label":"Accent line","default":"Then the cat."},
    {"type":"richtext","id":"body","label":"Description","default":"<p>Good ideas start with the space you have and the cat who lives there.</p>"}
  ],
  "blocks":[{"type":"story","name":"Journal card","settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"01 / A small-space guide"},
    {"type":"text","id":"title","label":"Title","default":"Make room for the zoomies."},
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"text","id":"image_asset","label":"Theme asset filename","default":"mc-cat-peek.webp"},
    {"type":"text","id":"image_alt","label":"Image description","default":"A curious cat peeks around a colorful block."},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"Morrow Cat Journal","blocks":[{"type":"story"},{"type":"story","settings":{"kicker":"02 / The color file","title":"A brighter kind of cat corner.","image_asset":"mc-cat-home.webp","image_alt":"A cat in a sunlit, colorful living room."}},{"type":"story","settings":{"kicker":"03 / Before you browse","title":"A note on what we know so far.","image_asset":"mc-cat-curious.webp","image_alt":"A curious cat looks toward the camera."}}]}]
}
{% endschema %}

