                },
                "product_layout_row_1_product_layout_column_2_product_price_4": {
                  "type": "product-price",
                  "settings": {
                    "show_compare_price": true,
                    "show_sale_badge": true,
                    "savings_display": "text",
                    "show_unit_price": false,
                    "price_style": "standard",
                    "price_font_size": 30,
                    "compare_font_size": 18,
                    "text_color": "#182E2A",
                    "sale_color": "#793D43",
                    "compare_color": "#62665E",
                    "badge_background_color": "#793D43",
                    "badge_text_color": "#F6F1E7",
                    "background_color": "#F6F1E7",
                    "border_color": "#E5D8BE",
