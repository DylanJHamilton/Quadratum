{%- liquid
  assign block_id = 'product-dynamic-checkout-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign checkout_style = block.settings.checkout_style | default: 'standard'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-dynamic-checkout
    product-dynamic-checkout--{{ checkout_style }}
    product-dynamic-checkout--width-{{ width }}
    product-dynamic-checkout--align-{{ alignment }}
    {% unless current_variant.available %} product-dynamic-checkout--unavailable{% endunless %}
    {% unless show_on_desktop %} product-dynamic-checkout--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-dynamic-checkout--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-dynamic-checkout--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-dynamic-checkout--animate product-dynamic-checkout--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-dynamic-checkout-margin-top: {{ block.settings.margin_top }}px;
    --product-dynamic-checkout-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-dynamic-checkout-padding: {{ block.settings.padding }}px;
    --product-dynamic-checkout-gap: {{ block.settings.gap }}px;
    --product-dynamic-checkout-border-width: {{ block.settings.border_width }}px;
    --product-dynamic-checkout-border-radius: {{ block.settings.border_radius }}px;
    --product-dynamic-checkout-background-color: {{ block.settings.background_color }};
    --product-dynamic-checkout-border-color: {{ block.settings.border_color }};
    --product-dynamic-checkout-text-color: {{ block.settings.text_color }};
    --product-dynamic-checkout-note-color: {{ block.settings.note_color }};
    --product-dynamic-checkout-focus-color: {{ block.settings.focus_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-dynamic-checkout
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-dynamic-checkout-margin-top);
      margin-bottom: var(--product-dynamic-checkout-margin-bottom);
      padding: var(--product-dynamic-checkout-padding);
      color: var(--product-dynamic-checkout-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-dynamic-checkout--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-dynamic-checkout--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-dynamic-checkout--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-dynamic-checkout--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-dynamic-checkout--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-dynamic-checkout--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-dynamic-checkout--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-dynamic-checkout--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-dynamic-checkout__inner {
      display: grid;
      gap: var(--product-dynamic-checkout-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-dynamic-checkout--card .product-dynamic-checkout__inner,
    #{{ block_id }}.product-dynamic-checkout--conversion .product-dynamic-checkout__inner {
      padding: 16px;
      color: var(--product-dynamic-checkout-text-color);
      background: var(--product-dynamic-checkout-background-color);
      border: var(--product-dynamic-checkout-border-width) solid var(--product-dynamic-checkout-border-color);
      border-radius: var(--product-dynamic-checkout-border-radius);
    }

    #{{ block_id }} .product-dynamic-checkout__heading {
      margin: 0;
      color: var(--product-dynamic-checkout-text-color);
      line-height: 1.25;
      font-size: 0.96em;
    }

    #{{ block_id }} .product-dynamic-checkout__form {
      display: grid;
      gap: var(--product-dynamic-checkout-gap);
      margin: 0;
      min-width: 0;
    }

    #{{ block_id }} .product-dynamic-checkout__payment {
      min-width: 0;
    }

    #{{ block_id }} .product-dynamic-checkout__payment .shopify-payment-button {
      width: 100%;
    }

    #{{ block_id }} .product-dynamic-checkout__payment .shopify-payment-button__button {
      width: 100%;
      min-height: {{ block.settings.button_height }}px;
      border-radius: var(--product-dynamic-checkout-border-radius);
      overflow: hidden;
    }

    #{{ block_id }}.product-dynamic-checkout--compact .product-dynamic-checkout__payment .shopify-payment-button__button {
      min-height: 44px;
    }

    #{{ block_id }}.product-dynamic-checkout--minimal .product-dynamic-checkout__payment .shopify-payment-button__button {
      min-height: 42px;
      border-radius: max(calc(var(--product-dynamic-checkout-border-radius) - 6px), 6px);
    }

    #{{ block_id }} .product-dynamic-checkout__payment .shopify-payment-button__button:focus-visible,
    #{{ block_id }} .product-dynamic-checkout__payment button:focus-visible {
      outline: 2px solid var(--product-dynamic-checkout-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-dynamic-checkout__note {
      color: var(--product-dynamic-checkout-note-color);
      line-height: 1.4;
      font-size: 0.9em;
    }

    #{{ block_id }}.product-dynamic-checkout--align-center .product-dynamic-checkout__note,
    #{{ block_id }}.product-dynamic-checkout--align-center .product-dynamic-checkout__heading {
      text-align: center;
    }

    #{{ block_id }}.product-dynamic-checkout--align-right .product-dynamic-checkout__note,
    #{{ block_id }}.product-dynamic-checkout--align-right .product-dynamic-checkout__heading {
      text-align: right;
    }

    #{{ block_id }}.product-dynamic-checkout--unavailable .product-dynamic-checkout__payment {
      opacity: 0.48;
      pointer-events: none;
    }

    #{{ block_id }} .product-dynamic-checkout__unavailable {
      color: var(--product-dynamic-checkout-note-color);
      line-height: 1.35;
      font-size: 0.92em;
    }

    #{{ block_id }}.product-dynamic-checkout--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade {
      animation-name: productDynamicCheckoutFade;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_up {
      animation-name: productDynamicCheckoutFadeUp;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_down {
      animation-name: productDynamicCheckoutFadeDown;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_left {
      animation-name: productDynamicCheckoutFadeLeft;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_right {
      animation-name: productDynamicCheckoutFadeRight;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-zoom {
      animation-name: productDynamicCheckoutZoom;
    }

    @keyframes productDynamicCheckoutFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productDynamicCheckoutFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productDynamicCheckoutFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productDynamicCheckoutFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productDynamicCheckoutFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productDynamicCheckoutZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-dynamic-checkout--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-dynamic-checkout--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-dynamic-checkout--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-dynamic-checkout--card .product-dynamic-checkout__inner,
      #{{ block_id }}.product-dynamic-checkout--conversion .product-dynamic-checkout__inner {
        padding: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-dynamic-checkout--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-dynamic-checkout__inner">
    {% if block.settings.heading != blank %}
      <h3 class="product-dynamic-checkout__heading">
        {{ block.settings.heading | escape }}
      </h3>
    {% endif %}

    {% form 'product', product_context, class: 'product-dynamic-checkout__form', data-product-dynamic-checkout-form: '' %}
      <input
        type="hidden"
        name="id"
        value="{{ current_variant.id }}"
        data-product-dynamic-checkout-variant-input
      >

      <input
        type="hidden"
        name="quantity"
        value="1"
        data-product-dynamic-checkout-quantity-input
      >

      <div class="product-dynamic-checkout__payment" data-product-dynamic-checkout-payment>
        {{ form | payment_button }}
      </div>
    {% endform %}

    {% if block.settings.show_note and block.settings.note != blank %}
      <div class="product-dynamic-checkout__note">
        {{ block.settings.note | escape }}
      </div>
    {% endif %}

    {% if block.settings.show_unavailable_text %}
      <div
        class="product-dynamic-checkout__unavailable"
        data-product-dynamic-checkout-unavailable
        {% if current_variant.available %}hidden{% endif %}
        role="status"
        aria-live="polite"
      >
        {{ block.settings.unavailable_text | escape }}
      </div>
    {% endif %}
  </div>

  <script type="application/json" data-product-dynamic-checkout-variants>
    {{ product_context.variants | json }}
  </script>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productDynamicCheckoutReady === 'true') return;

      root.dataset.productDynamicCheckoutReady = 'true';

      const variantsJson = root.querySelector('[data-product-dynamic-checkout-variants]');
      const variantInput = root.querySelector('[data-product-dynamic-checkout-variant-input]');
      const quantityInput = root.querySelector('[data-product-dynamic-checkout-quantity-input]');
      const unavailableEl = root.querySelector('[data-product-dynamic-checkout-unavailable]');

      if (!variantsJson || !variantInput || !quantityInput) return;

      let variants = [];

      try {
        variants = JSON.parse(variantsJson.textContent || '[]');
      } catch (error) {
        variants = [];
      }

      const updateVariant = (variantId, variantFromEvent) => {
        if (!variantId) return;

        const variant = variantFromEvent || variants.find((item) => String(item.id) === String(variantId));

        if (!variant) return;

        variantInput.value = variant.id;
        root.dataset.variantId = String(variant.id);

        root.classList.toggle('product-dynamic-checkout--unavailable', !variant.available);

        if (unavailableEl) {
          unavailableEl.hidden = Boolean(variant.available);
        }
      };

      const updateQuantity = (quantity) => {
        const parsed = Math.max(Number(quantity || 1), 1);
        quantityInput.value = String(Math.floor(parsed));
      };

      document.addEventListener('variant:change', (event) => {
        const detail = event.detail || {};
        const variant = detail.variant || {};
        const variantId = variant.id || detail.variantId || detail.variant_id || detail.id;

        updateVariant(variantId, variant.id ? variant : null);
      });

      document.addEventListener('qtm:variant:change', (event) => {
        const detail = event.detail || {};
        const variant = detail.variant || {};
        const variantId = variant.id || detail.variantId || detail.variant_id || detail.id;

        updateVariant(variantId, variant.id ? variant : null);
      });

      document.addEventListener('quantity:change', (event) => {
        const detail = event.detail || {};
        updateQuantity(detail.quantity);
      });

      document.addEventListener('qtm:quantity:change', (event) => {
        const detail = event.detail || {};
        updateQuantity(detail.quantity);
      });

      const initialVariant = variants.find((item) => String(item.id) === String(variantInput.value));

      if (initialVariant) {
        updateVariant(initialVariant.id, initialVariant);
      }

      updateQuantity(quantityInput.value);
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product dynamic checkout",
  "settings": [
    {
      "type": "header",
      "content": "Dynamic checkout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note",
      "default": false
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "checkbox",
      "id": "show_unavailable_text",
      "label": "Show unavailable message",
      "default": true
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable message",
      "default": "This option is currently unavailable."
    },
    {
      "type": "select",
      "id": "checkout_style",
      "label": "Checkout style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "conversion",
          "label": "Conversion"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Note color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Dynamic Checkout",
      "settings": {
        "show_note": false,
        "show_unavailable_text": true,
        "unavailable_text": "This option is currently unavailable.",
        "checkout_style": "standard",
        "button_height": 52,
        "text_color": "#111111",
        "note_color": "#555555",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "focus_color": "#111111",
        "border_width": 1,
        "border_radius": 14,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 16,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Compact Dynamic Checkout",
      "settings": {
        "show_note": false,
        "show_unavailable_text": true,
        "unavailable_text": "This option is currently unavailable.",
        "checkout_style": "compact",
        "button_height": 44,
        "text_color": "#111111",
        "note_color": "#555555",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "focus_color": "#111111",
        "border_width": 1,
        "border_radius": 12,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Conversion Dynamic Checkout",
      "settings": {
        "heading": "Buy now",
        "show_note": true,
        "note": "Fast checkout options appear automatically when available.",
        "show_unavailable_text": true,
        "unavailable_text": "This option is currently unavailable.",
        "checkout_style": "conversion",
        "button_height": 56,
        "text_color": "#111111",
        "note_color": "#555555",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "focus_color": "#111111",
        "border_width": 1,
        "border_radius": 18,
        "width": "full",
        "alignment": "left",
        "gap": 10,
        "margin_top": 0,
        "margin_bottom": 20,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "fade_up"
      }
    }
  ]
}
{% endschema %}