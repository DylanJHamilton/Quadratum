{% comment %}
  Merchant-owned raw provider HTML/scripts are preserved. The theme frames content;
  the provider owns iframe titles, transport, resizing and editor lifecycle.
  Only known legacy placeholder defaults are treated as unconfigured content.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign embed_content = s.embed_code | default: '' | strip
  assign has_embed = false
  if embed_content != blank
    unless embed_content == '<!-- Paste your CRM or booking embed code here -->' or embed_content == '<!-- Paste your calendar or booking embed code here (GoHighLevel, Calendly, etc.) -->' or embed_content == '<!-- Replace this with your GoHighLevel or Calendly embed code. -->'
      assign has_embed = true
    endunless
  endif
  assign has_help = false
  assign max_width = 'var(--container-md,960px)'
  case s.max_width
    when 'sm'
      assign max_width = 'var(--container-sm,720px)'
    when 'lg'
      assign max_width = 'var(--container-lg,1152px)'
  endcase
  assign has_content = false
  capture bullets
    if s.show_bullets
      for block in section.blocks
        if block.type == 'bullet' and block.settings.text != blank
          assign has_content = true
          echo '<li class="q-third-party-crm-embed__bullet" '
          echo block.shopify_attributes
          echo '>'
          echo block.settings.text | escape
          echo '</li>'
        endif
      endfor
    endif
  endcapture
  capture badges
    if s.show_trust_row
      for block in section.blocks
        if block.type == 'trust_badge'
          assign b = block.settings
          if b.logo != blank or b.label != blank
            assign has_content = true
            echo '<figure class="q-third-party-crm-embed__trust" '
            echo block.shopify_attributes
            echo '>'
            if b.logo != blank
              assign logo_alt = b.alt | default: b.logo.alt | default: b.label | default: 'Badge'
              echo b.logo | image_url: width: 200 | image_tag: alt: logo_alt, loading: 'lazy', class: 'q-third-party-crm-embed__trust-logo'
            endif
            if b.label != blank
              echo '<figcaption class="q-third-party-crm-embed__trust-label">'
              echo b.label | escape
              echo '</figcaption>'
            endif
            echo '</figure>'
          endif
        endif
      endfor
    endif
  endcapture
  assign visible = false
  if s.enable_section
    if has_embed or has_help
      assign visible = true
    endif
  endif
-%}
{%- if visible -%}
<section id="third-party-crm-embed-{{ section.id }}" class="q-section q-third-party-crm-embed q-section--bg-{{ s.background_style }}" aria-label="{{ s.aria_label | default: s.heading | default: 'Contact and booking' | escape }}" data-q-third-party="crm-embed" data-q-crm-type="{{ s.embed_type }}" style="--q-embed-width:{{ max_width }};--q-embed-min-h:{{ s.iframe_min_height | default: 740 }}px;--q-embed-min-h-mobile:{{ s.iframe_mobile_min_height | default: 740 }}px;">
  <div class="q-section__inner">
    {%- if s.kicker != blank or s.heading != blank or s.subheading != blank -%}
      <header class="q-section__header q-section__header--{{ s.content_align }}">
        {%- if s.kicker != blank -%}<p class="q-section__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="q-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="q-section__body"><p>{{ s.subheading | escape | newline_to_br }}</p></div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="q-third-party-crm-embed__layout q-third-party-crm-embed__layout--{{ s.layout_variant }}{% if has_content %} q-third-party-crm-embed__layout--with-content{% endif %}">
      {%- if has_content -%}<div class="q-third-party-crm-embed__content">
        {%- if bullets != blank -%}<ul class="q-third-party-crm-embed__bullets">{{ bullets }}</ul>{%- endif -%}
        {%- if badges != blank -%}<div class="q-third-party-crm-embed__trust-row">{{ badges }}</div>{%- endif -%}
      </div>{%- endif -%}
      <div class="q-third-party-crm-embed__embed" tabindex="0" role="region" aria-label="Embedded form or funnel">{{ s.embed_code }}</div>
    </div>
  </div>
  <style data-q-embed-style>

    #third-party-crm-embed-{{ section.id }}{font-family:var(--font-body,inherit);color:var(--q-section-fg,var(--c-text,#111));overflow-wrap:anywhere;padding:48px 24px}
    #third-party-crm-embed-{{ section.id }} .q-section__inner{box-sizing:border-box;max-width:var(--q-embed-width);margin-inline:auto;min-width:0}
    #third-party-crm-embed-{{ section.id }} .q-section__header{display:grid;gap:.75rem;margin-bottom:1rem}
    #third-party-crm-embed-{{ section.id }} .q-section__header--center{text-align:center;justify-items:center}
    #third-party-crm-embed-{{ section.id }} .q-section__header--left{text-align:start;justify-items:start}
    #third-party-crm-embed-{{ section.id }} :is(.q-section__kicker,.q-section__heading,.q-section__body p){margin:0}
    #third-party-crm-embed-{{ section.id }} .q-section__heading{font-family:var(--font-head,inherit);font-size:var(--fs-h2,2rem);line-height:1.2;color:inherit}
    #third-party-crm-embed-{{ section.id }} .q-section__body{max-width:68ch;color:var(--q-section-muted,var(--c-muted,#666))}
    #third-party-crm-embed-{{ section.id }} .q-section__kicker{letter-spacing:.08em;text-transform:uppercase;font-weight:700;font-size:.85em;color:var(--q-section-muted,var(--c-muted,#666))}

    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__layout{display:grid;gap:24px;grid-template-columns:minmax(0,1fr)}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__content{display:grid;align-content:start;gap:16px;min-width:0}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__bullets{margin:0;padding-inline-start:1.15em;display:grid;gap:10px}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__trust-row{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__trust{margin:0;display:inline-flex;align-items:center;gap:10px;min-width:0;max-width:100%;flex-wrap:wrap}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__trust-logo{max-width:100%;width:auto;height:28px;object-fit:contain}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__trust-label{min-width:0;font-size:.9rem;color:var(--q-section-muted,var(--c-muted,#666))}
    @media(min-width:768px){#third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__layout--split.q-third-party-crm-embed__layout--with-content{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}}

    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__embed{box-sizing:border-box;min-width:0;width:100%;max-width:100%;border-radius:16px;padding:16px;background:var(--c-bg,#fff);color:var(--c-text,#111);border:1px solid var(--c-border,#d1d5db);box-shadow:0 10px 30px rgb(0 0 0 / .08);overflow:auto}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__embed>*{max-width:100%;box-sizing:border-box}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__embed iframe{display:block;width:100%;max-width:100%;border:0;min-height:var(--q-embed-min-h)}
    #third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__embed:focus-visible,#third-party-crm-embed-{{ section.id }} a:focus-visible,#third-party-crm-embed-{{ section.id }} iframe:focus-visible{outline:3px solid currentColor;outline-offset:3px}
    @media(max-width:749px){#third-party-crm-embed-{{ section.id }}{padding-inline:16px}#third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__embed{padding:12px}#third-party-crm-embed-{{ section.id }} .q-third-party-crm-embed__embed iframe{min-height:var(--q-embed-min-h-mobile)}}
  </style>
</section>
{%- endif -%}
{%- if request.design_mode -%}
  {%- unless visible -%}<p role="status">CRM embed: enable the section and paste your provider's configured HTML/iframe/script snippet.</p>{%- endunless -%}
  {%- for block in section.blocks -%}
    {%- assign block_visible = false -%}
    {%- if visible -%}
      {%- if block.type == 'bullet' and s.show_bullets and block.settings.text != blank -%}{%- assign block_visible = true -%}{%- endif -%}
      {%- if block.type == 'trust_badge' and s.show_trust_row -%}{%- if block.settings.logo != blank or block.settings.label != blank -%}{%- assign block_visible = true -%}{%- endif -%}{%- endif -%}
    {%- endif -%}
    {%- unless block_visible -%}<div {{ block.shopify_attributes }} style="padding:8px;border:1px dashed currentColor;">{{ block.type | replace: '_', ' ' | capitalize }}: add content and enable its display to preview it with a configured embed.</div>{%- endunless -%}
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "3rd Party - CRM Embed",
  "tag": "div",
  "class": "q-third-party-crm-embed",
  "settings": [
    {
      "type": "paragraph",
      "content": "Merchant-owned provider code runs as supplied. The provider must supply accessible iframe titles, its form/calendar configuration, and any editor reload support. Add an actual configured embed; this wrapper does not submit data or confirm bookings."
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Get started today"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book your call or request a quote"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading / description",
      "default": "Use the form below to request a quote, schedule a call, or take the next step with our team."
    },
    {
      "type": "checkbox",
      "id": "show_bullets",
      "label": "Show bullet list",
      "default": false
    },
    {
      "type": "select",
      "id": "embed_type",
      "label": "Embed type",
      "default": "form",
      "options": [
        {
          "value": "form",
          "label": "Form"
        },
        {
          "value": "funnel",
          "label": "Full funnel page"
        }
      ],
      "info": "Describes this embed for theme integrations. Rendering and behavior are determined by the provider code."
    },
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed code (form, funnel, or calendar)",
      "info": "Paste the full provider HTML/iframe/script snippet. Minimum iframe heights below frame the widget; its script owns resizing and behavior. Test multiple instances and Theme Editor reload with your provider."
    },
    {
      "type": "checkbox",
      "id": "show_trust_row",
      "label": "Show trust badges / logos",
      "default": false
    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Layout",
      "default": "split",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked (content above embed)"
        },
        {
          "value": "split",
          "label": "Split: content + embed side by side"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "surface",
      "options": [
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "contrast",
          "label": "Contrast"
        },
        {
          "value": "brand",
          "label": "Brand color"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "md",
      "options": [
        {
          "value": "sm",
          "label": "Narrow"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria label",
      "default": "CRM form and booking section"
    },
    {
      "type": "range",
      "id": "iframe_min_height",
      "label": "Minimum iframe height (desktop)",
      "min": 240,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 740
    },
    {
      "type": "range",
      "id": "iframe_mobile_min_height",
      "label": "Minimum iframe height (mobile)",
      "min": 240,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 740
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet text",
          "default": "Share your requirements"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo / badge image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Trust badge"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption (optional)",
          "default": "Add your verified credential"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3rd Party - CRM Form/Funnel Embed",
      "category": "3rd Party Integrations",
      "settings": {
        "kicker": "Get started",
        "heading": "Request a consultation",
        "subheading": "Use the form below to request a quote or schedule a call with our team.",
        "embed_type": "form",
        "show_bullets": true
      },
      "blocks": [
        {
          "type": "bullet",
          "settings": {
            "text": "Share your requirements"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Ask about available options"
          }
        }
      ]
    }
  ]
}
{% endschema %}
