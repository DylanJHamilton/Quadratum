{%- comment -%}Shopify CDN source candidates, shared by initial and selected-variant images.{%- endcomment -%}
{%- liquid
  assign candidate_widths = '160,320,480,640,900,1200,1600,2000,2400,3000' | split: ','
  assign source_max = max_width | default: 1600 | plus: 0
  assign native_width = image.width | default: image.preview_image.width | default: source_max
  assign source_max = source_max | at_most: native_width
  assign separator = ''
-%}
{%- for candidate in candidate_widths -%}{%- assign candidate_width = candidate | plus: 0 -%}{%- if candidate_width < source_max -%}
  {{- separator -}}{%- if crop != blank and crop_height != blank -%}{%- assign candidate_height = candidate_width | times: crop_height | divided_by: max_width | round -%}{{ image | image_url: width: candidate_width, height: candidate_height, crop: crop }}{%- else -%}{{ image | image_url: width: candidate_width }}{%- endif -%}{{ ' ' }}{{ candidate_width }}w{%- assign separator = ', ' -%}
{%- endif -%}{%- endfor -%}{{ separator }}{%- if crop != blank and crop_height != blank -%}{%- assign final_height = source_max | times: crop_height | divided_by: max_width | round -%}{{ image | image_url: width: source_max, height: final_height, crop: crop }}{%- else -%}{{ image | image_url: width: source_max }}{%- endif -%}{{ ' ' }}{{ source_max }}w
