        "source_consumers": [
          "data-add-label=\"{{ block.settings.atc_label | default: 'Add to cart' | escape }}\"",
          "<button type=\"submit\" name=\"add\" class=\"content-featured-product__button\" data-add-to-cart data-b8-submit {% unless purchase_available %}disabled{% endunless %}>{% if purchase_available %}{{ block.settings.atc_label | default: 'Add to cart' | escape }}{% elsif current_variant.available == false %}{{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% else %}{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}{% endif %}</button>"
        ]
      },
      {
        "schema": {
          "type": "text",
          "id": "sold_out_label",
          "label": "Sold out label",
          "default": "Sold out"
        },
        "source_consumers": [
          "data-sold-label=\"{{ block.settings.sold_out_label | default: 'Sold out' | escape }}\"",
          "<option value=\"{{ current_variant.id }}\" selected>{{ current_variant.title | escape }}{% unless current_variant.available %} — {{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% endunless %}</option>",
          "{% for variant in featured_product.variants %}{% unless variant.id == current_variant.id %}<option value=\"{{ variant.id }}\">{{ variant.title | escape }}{% unless variant.available %} — {{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% endunless %}</option>{% endunless %}{% endfor %}",
          "<button type=\"submit\" name=\"add\" class=\"content-featured-product__button\" data-add-to-cart data-b8-submit {% unless purchase_available %}disabled{% endunless %}>{% if purchase_available %}{{ block.settings.atc_label | default: 'Add to cart' | escape }}{% elsif current_variant.available == false %}{{ block.settings.sold_out_label | default: 'Sold out' | escape }}{% else %}{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}{% endif %}</button>"
