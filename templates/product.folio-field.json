    "story": {
      "type": "product-story",
      "blocks": {
        "story_paragraph_1": {
          "type": "story_paragraph",
          "settings": {
            "content": "<p>We chose this one because the question it leaves you with is the kind we most want to hear eight people answer around the long table. If it is on the Reading Together shelf this season, pick up a copy before the first meeting; if not, bring it to the counter and we will talk about it anyway.</p>"
          }
        },
        "story_paragraph_2": {
          "type": "story_paragraph",
          "settings": {
            "content": "<p><a href=\"/pages/reading-together\">See this season's reading groups</a> or <a href=\"/products/ff-reading-circle-conversation-cards\">get the conversation cards</a>.</p>"
          }
        }
      },
      "block_order": [
        "story_paragraph_1",
        "story_paragraph_2"
      ],
      "settings": {
        "title": "A note from the booksellers.",
        "intro": "<p>Every title on these shelves was read by one of us first. This is the part of the shelf note that did not fit on the card.</p>",
        "source": "manual",
        "layout": "split",
        "media_position_desktop": "left",
        "media_ratio": "landscape",
        "media_fit": "cover",
        "content_width": "content-center-aligned",
        "text_alignment": "left",
        "show_media": true,
        "media_type": "image",
        "image": "shopify://shop_images/ff-reading-circle.webp",
        "media_caption": "The reading group table in the back room",
        "show_timeline": false,
        "padding_top": 72,
        "padding_bottom": 72,
        "bg_color": "#D5E0CD",
        "surface_color": "#F6F1E7",
        "text_color": "#182E2A",
        "heading_color": "#182E2A",
        "muted_text_color": "#62665E",
        "border_color": "#E5D8BE",
        "media_bg_color": "#E5D8BE",
        "timeline_dot_color": "#496440"
      }
    },
    "faq": {
      "type": "product-faq",
      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Is this a real book?",
            "answer": "<p>No. Folio & Field is a sample store and this title, its creator and its cover are fictional placeholders built to demonstrate the Quadratum theme.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get it in large print or audio?",
            "answer": "<p>In a real store this panel would list the editions that can be ordered in. Here it shows how the FAQ block attaches to a product.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I gift wrap it?",
            "answer": "<p>Choose gift wrap in the cart. Wrapped orders include a gift receipt and a hand-written shelf note.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_1",
        "faq_item_2",
        "faq_item_3"
      ],
      "settings": {
        "title": "Before you buy.",
        "subheading": "",
