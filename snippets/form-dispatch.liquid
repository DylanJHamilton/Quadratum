{% comment %}
  Quadratum — Form Dispatch (BC-safe w/ optional integrations)
  - Accepts optional parameters (if not provided, falls back to section.settings):
      eff_endpoint_url, eff_tags, eff_captcha_mode, eff_captcha_key
      eff_marketing_app, eff_marketing_proxy, eff_marketing_map_name, eff_marketing_map_phone, eff_marketing_map_company
      eff_marketing_consent_mode, eff_marketing_double_opt_in
      eff_utm_source, eff_utm_medium, eff_utm_campaign
{% endcomment %}

{%- assign s = settings -%}

{%- assign has_file = false -%}
{%- for b in blocks -%}
  {%- if b.type == 'field' and b.settings.field_type == 'file' -%}{%- assign has_file = true -%}{%- endif -%}
{%- endfor -%}

{%- comment %} Effective values (use provided overrides, else fallback to section settings) {% endcomment -%}
{%- assign eff_endpoint   = eff_endpoint_url | default: s.endpoint_url | strip -%}
{%- assign eff_tags       = eff_tags | default: s.hidden_tags | default: '' -%}
{%- assign eff_captcha    = eff_captcha_mode | default: s.captcha_mode | default: 'none' -%}

{%- comment %} Optional marketing/UTM — only used if present (keeps current behavior otherwise) {% endcomment -%}
{%- assign m_app        = eff_marketing_app | default: '' -%}
{%- assign m_proxy      = eff_marketing_proxy | default: '' -%}
{%- assign m_map_name   = eff_marketing_map_name | default: '', allow_false: true -%}
{%- assign m_map_phone  = eff_marketing_map_phone | default: '', allow_false: true -%}
{%- assign m_map_company= eff_marketing_map_company | default: '', allow_false: true -%}
{%- assign m_consent    = eff_marketing_consent_mode | default: '' -%}
{%- assign m_double     = eff_marketing_double_opt_in | default: '', allow_false: true -%}
{%- assign m_utm_source = eff_utm_source | default: '' -%}
{%- assign m_utm_medium = eff_utm_medium | default: '' -%}
{%- assign m_utm_campaign = eff_utm_campaign | default: '' -%}

{%- assign tags_str = eff_tags | strip -%}
{%- assign now_unix = 'now' | date: '%s' -%}

{%- liquid
  assign endpoint_valid = false
  assign endpoint_start = eff_endpoint | slice: 0, 8 | downcase
  assign endpoint_first = eff_endpoint | slice: 0, 1
  assign endpoint_pair = eff_endpoint | slice: 0, 2
  assign endpoint_host = eff_endpoint | slice: 8, 2048 | split: '/' | first | split: '?' | first | split: '#' | first
  assign endpoint_encoded = eff_endpoint | url_encode
  if endpoint_start == 'https://' and endpoint_host != blank
    assign endpoint_valid = true
  elsif endpoint_first == '/' and endpoint_pair != '//'
    assign endpoint_valid = true
  endif
  if eff_endpoint contains ' ' or endpoint_encoded contains '%5C' or endpoint_encoded contains '%0A' or endpoint_encoded contains '%0D' or endpoint_encoded contains '%09' or endpoint_encoded contains '%00' or endpoint_host contains '@'
    assign endpoint_valid = false
  endif
-%}
{%- if s.destination == 'custom_endpoint' and endpoint_valid == false -%}
  <p class="q-live" role="status">{% if request.design_mode %}Configure a valid HTTPS or store-relative custom endpoint to enable this form.{% else %}This form is currently unavailable.{% endif %}</p>
{%- elsif s.destination == 'custom_endpoint' -%}
  <form class="q-form" id="q-form-{{ id }}" data-q-destination="custom_endpoint" method="post" action="{{ eff_endpoint | escape }}"
        {% if has_file %}enctype="multipart/form-data"{% endif %}>
    {%- if tags_str != blank -%}<input type="hidden" name="tags" value="{{ tags_str | escape }}">{%- endif -%}
    <input type="hidden" name="source" value="{{ form_source | default: 'quote_form' | escape }}">
    <input type="hidden" name="section_id" value="{{ id }}">
    <input type="text" name="hp_field" tabindex="-1" autocomplete="off" class="q-hp" aria-hidden="true" aria-label="Leave this field empty" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
    <input type="hidden" name="submitted_at" value="{{ now_unix }}">

    {%- if eff_captcha == 'turnstile' -%}<input type="hidden" name="cf-turnstile-response" value="">
    {%- elsif eff_captcha == 'recaptcha_v3' -%}<input type="hidden" name="g-recaptcha-response" value="">{%- endif -%}

    {%- comment %} Optional marketing meta (only output if provided) {% endcomment -%}
    {%- if m_app != blank -%}<input type="hidden" name="marketing[app]" value="{{ m_app | escape }}">{%- endif -%}
    {%- if m_proxy != blank -%}<input type="hidden" name="marketing[proxy]" value="{{ m_proxy | escape }}">{%- endif -%}
    {%- if m_map_name != blank or m_map_name == false -%}<input type="hidden" name="marketing[map_name]" value="{{ m_map_name | escape }}">{%- endif -%}
    {%- if m_map_phone != blank or m_map_phone == false -%}<input type="hidden" name="marketing[map_phone]" value="{{ m_map_phone | escape }}">{%- endif -%}
    {%- if m_map_company != blank or m_map_company == false -%}<input type="hidden" name="marketing[map_company]" value="{{ m_map_company | escape }}">{%- endif -%}
    {%- if m_consent != blank -%}<input type="hidden" name="marketing[consent_mode]" value="{{ m_consent | escape }}">{%- endif -%}
    {%- if m_double != blank or m_double == false -%}<input type="hidden" name="marketing[double_opt_in]" value="{{ m_double | escape }}">{%- endif -%}
    {%- if m_utm_source != blank -%}<input type="hidden" name="utm[source]" value="{{ m_utm_source | escape }}">{%- endif -%}
    {%- if m_utm_medium != blank -%}<input type="hidden" name="utm[medium]" value="{{ m_utm_medium | escape }}">{%- endif -%}
    {%- if m_utm_campaign != blank -%}<input type="hidden" name="utm[campaign]" value="{{ m_utm_campaign | escape }}">{%- endif -%}

    {% if form_source == 'waitlist' %}
      {% render 'form-waitlist-fields', id: id, settings: s, theme_settings: theme_settings, waitlist_product: waitlist_product, waitlist_url: waitlist_url %}
    {% else %}
    {%- render 'form-core', id: id, settings: s, blocks: blocks, theme_settings: theme_settings, require_email: require_email -%}
    {% endif %}
  </form>
{%- else -%}
  {%- comment %} Shopify supplies each native form's action, identity and captcha wiring. {% endcomment -%}
  {%- assign form_dom_id = 'q-form-' | append: id -%}
  {%- assign native_form_type = 'contact' -%}
  {%- if s.destination == 'shopify_customer' -%}{%- assign native_form_type = 'customer' -%}{%- endif -%}
  {% form native_form_type, id: form_dom_id, class: 'q-form', data-shopify-captcha: 'true' %}
    {%- if tags_str != blank -%}<input type="hidden" name="contact[tags]" value="{{ tags_str | escape }}">{%- endif -%}
    <input type="text" name="contact[hp_field]" tabindex="-1" autocomplete="off" class="q-hp" aria-hidden="true" aria-label="Leave this field empty" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
    <input type="hidden" name="contact[submitted_at]" value="{{ now_unix }}">

    {%- comment %} Optional marketing meta recorded into contact[...] only if provided {% endcomment -%}
    {%- if m_app != blank -%}<input type="hidden" name="contact[marketing_app]" value="{{ m_app | escape }}">{%- endif -%}
    {%- if m_proxy != blank -%}<input type="hidden" name="contact[marketing_proxy]" value="{{ m_proxy | escape }}">{%- endif -%}
    {%- if m_map_name != blank or m_map_name == false -%}<input type="hidden" name="contact[marketing_map_name]" value="{{ m_map_name | escape }}">{%- endif -%}
    {%- if m_map_phone != blank or m_map_phone == false -%}<input type="hidden" name="contact[marketing_map_phone]" value="{{ m_map_phone | escape }}">{%- endif -%}
    {%- if m_map_company != blank or m_map_company == false -%}<input type="hidden" name="contact[marketing_map_company]" value="{{ m_map_company | escape }}">{%- endif -%}
    {%- if m_consent != blank -%}<input type="hidden" name="contact[marketing_consent_mode]" value="{{ m_consent | escape }}">{%- endif -%}
    {%- if m_double != blank or m_double == false -%}<input type="hidden" name="contact[marketing_double_opt_in]" value="{{ m_double | escape }}">{%- endif -%}
    {%- if m_utm_source != blank -%}<input type="hidden" name="contact[utm_source]" value="{{ m_utm_source | escape }}">{%- endif -%}
    {%- if m_utm_medium != blank -%}<input type="hidden" name="contact[utm_medium]" value="{{ m_utm_medium | escape }}">{%- endif -%}
    {%- if m_utm_campaign != blank -%}<input type="hidden" name="contact[utm_campaign]" value="{{ m_utm_campaign | escape }}">{%- endif -%}

    {%- if form.posted_successfully? -%}
      <div class="q-live" role="status" tabindex="-1"><span class="ok">{{ s.success_text | default: 'Thanks! Your request has been sent.' | escape }}</span></div>
    {%- elsif form.errors -%}
      <div class="q-live" role="alert" tabindex="-1"><span class="bad">{{ s.error_text | default: 'Please fix the highlighted fields and try again.' | escape }}</span>{{ form.errors | default_errors }}</div>
    {%- else -%}
      <div class="q-live" aria-live="polite" role="status"></div>
    {%- endif -%}

    {% if form_source == 'waitlist' %}
      {% render 'form-waitlist-fields', id: id, settings: s, theme_settings: theme_settings, waitlist_product: waitlist_product, waitlist_url: waitlist_url, shopify_form: form %}
    {% else %}
    {%- render 'form-core', id: id, settings: s, blocks: blocks, shopify_form: form, theme_settings: theme_settings, require_email: require_email -%}
    {% endif %}
  {% endform %}
{%- endif -%}
