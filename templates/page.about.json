    "statement": {
      "type": "basic-content-helper-text-centered-full-width",
      "settings": {
        "kicker": "Why the shelves are small",
        "title": "We shelve by what a book does to an afternoon, not by where a distributor files it.",
        "body": "<p>Most bookstores are organized for finding. This one is organized for choosing. Each shelf holds fewer titles, each title carries a short note on who might enjoy it, and every section ends with a question you can take home.</p><p>The shop is a concept, built to show how a brand with a clear point of view can live inside a working Shopify theme. The books, creators and prices are placeholders. The structure is real.</p><p><a href=\"/pages/built-on-quadratum\">How this store was built on Quadratum</a></p>",
        "alignment": "left",
        "max_width": "default",
        "title_size": "2xl",
        "title_weight": "medium",
        "body_size": "lg",
        "kicker_size": "sm",
        "kicker_opacity": "84",
        "pad_y": 72,
        "surface": "none",
        "use_custom_colors": true,
        "bg_color": "#F6F1E7",
        "text_color": "#182E2A",
        "muted_text_color": "#62665E",
        "accent_color": "#793D43"
      }
    },
    "habits": {
      "type": "call-to-action-icon-list",
      "blocks": {
        "icon_1": {
          "type": "icon",
          "settings": {
            "icon_filename": "book-open.svg",
            "title": "Read first, shelve second",
            "caption": "Nothing goes on the shelf without a bookseller having read it. The note under the title is the sentence we would say if you asked."
          }
        },
        "icon_2": {
          "type": "icon",
          "settings": {
            "icon_filename": "users.svg",
            "title": "Make room to talk",
            "caption": "The back room table seats eight. Reading groups are free, start with a question, and are open to anyone who has the book."
          }
        },
        "icon_3": {
          "type": "icon",
          "settings": {
            "icon_filename": "leaf.svg",
            "title": "Keep the useful things",
            "caption": "Journals, totes and bookmarks are made to be used for years, in the shop's own quiet colors. No seasonal churn."
          }
        }
      },
      "block_order": [
        "icon_1",
        "icon_2",
        "icon_3"
      ],
      "settings": {
        "aria_label": "Three habits behind every shelf.",
