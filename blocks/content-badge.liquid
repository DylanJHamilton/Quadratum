{%- liquid
  assign badge_text = block.settings.badge_text | default: 'New'
  assign badge_tag = 'span'

  if block.settings.badge_link != blank
    assign badge_tag = 'a'
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'badge' %}

<{{ badge_tag }}
  class="
    qtm-badge
    qtm-badge--{{ block.settings.badge_style }}
    qtm-badge--{{ block.settings.badge_size }}
    {% if block.settings.uppercase %} qtm-badge--uppercase{% endif %}
  "
  {% if block.settings.badge_link != blank %}
    href="{{ block.settings.badge_link }}"
    {% if block.settings.open_new_tab %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  {% endif %}
  style="
    --qtm-badge-text-color: {{ block.settings.text_color }};
    --qtm-badge-background-color: {{ block.settings.badge_background }};
    --qtm-badge-border-color: {{ block.settings.badge_border_color }};
    --qtm-badge-hover-text-color: {{ block.settings.hover_text_color }};
    --qtm-badge-hover-background-color: {{ block.settings.hover_background }};
    --qtm-badge-hover-border-color: {{ block.settings.hover_border_color }};
    --qtm-badge-radius: {{ block.settings.badge_radius }}px;
    --qtm-badge-border-width: {{ block.settings.badge_border_width }}px;
    --qtm-badge-font-family: {% if block.settings.font_family == 'heading' %}var(--font-heading-family){% elsif block.settings.font_family == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
    --qtm-badge-font-weight: {{ block.settings.font_weight }};
    --qtm-badge-letter-spacing: {{ block.settings.letter_spacing }}px;
  "
>
  {% if block.settings.icon_left != blank %}
    <span class="qtm-badge__icon qtm-badge__icon--left" aria-hidden="true">
      {{ block.settings.icon_left | escape }}
    </span>
  {% endif %}

  <span class="qtm-badge__text">
    {{ badge_text | escape }}
  </span>

  {% if block.settings.icon_right != blank %}
    <span class="qtm-badge__icon qtm-badge__icon--right" aria-hidden="true">
      {{ block.settings.icon_right | escape }}
    </span>
  {% endif %}
</{{ badge_tag }}>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Badge",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "icon_left",
      "label": "Icon left"
    },
    {
      "type": "text",
      "id": "icon_right",
      "label": "Icon right"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in new tab",
