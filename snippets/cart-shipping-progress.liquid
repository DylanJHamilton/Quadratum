{%- assign shipping_target = settings.cart_free_ship_threshold_amount | default: 75 | times: 100 | at_least: 0 -%}
{%- if settings.cart_free_ship_threshold_enable and shipping_target > 0 -%}
  {%- assign remaining = shipping_target | minus: cart.total_price | at_least: 0 -%}
  <div class="qtm-cart-shipping-progress">
    <p>{% if remaining > 0 %}{{ remaining | money }} to the configured shipping threshold.{% else %}Configured shipping threshold reached.{% endif %}</p>
    <progress max="{{ shipping_target }}" value="{{ cart.total_price | at_least: 0 | at_most: shipping_target }}" aria-label="Progress toward shipping threshold"></progress>
    <small>Shipping eligibility is calculated at checkout.</small>
  </div>
{%- endif -%}
