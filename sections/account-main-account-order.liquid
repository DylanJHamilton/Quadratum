{% comment %}
  Quadratum Account System
  Single Order Detail Page

  Handles:
  - Single customer order detail
  - Order status summary
  - Line items
  - Shipping and billing addresses
  - Order totals
  - Tracking CTA handoff
  - Back link

  Does NOT handle:
  - Carrier API tracking
  - Full order history
  - Address management
{% endcomment %}

{{ 'account-main-account-order.css' | asset_url | stylesheet_tag }}

{%- capture account_card_fg -%}{%- render 'contrast-text', bg: section.settings.card_background, preferred: settings.text_base -%}{%- endcapture -%}
{%- liquid
  assign layout_style = section.settings.layout_style

  assign financial_status = order.financial_status | replace: '_', '-'
  assign fulfillment_status = order.fulfillment_status | default: 'unfulfilled' | replace: '_', '-'
  if fulfillment_status == 'complete'
    assign fulfillment_status = 'fulfilled'
  endif

  assign tracking_page_url = section.settings.tracking_page_url

  assign back_url = section.settings.orders_page_url
  if back_url == blank
    assign back_url = routes.account_url | append: '?view=orders'
  endif

  assign tax_price = order.tax_price
-%}

<section
  id="QtmAccountMainOrder-{{ section.id }}"
  class="
    qtmAccountOrder
    qtmAccountOrder--{{ layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-meta-size: {{ section.settings.meta_font_size }}px;
    --qtm-account-card-fg: {{ account_card_fg | strip }};
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-gap: {{ section.settings.row_gap }}px;
    --qtm-account-badge-radius: {{ section.settings.badge_radius }}px;
  "
>
  <div class="qtmAccountOrder__shell">
    {% if customer and order %}
      <div class="qtmAccountOrder__topBar">
        <a href="{{ back_url | escape }}" class="qtmAccountOrder__backLink">
          {{ section.settings.back_link_label | escape }}
        </a>
      </div>

      {% render 'account-main-account-nav', section: section,
        active: 'orders',
        show_tracking: true,
        tracking_url: tracking_page_url,
        orders_url: back_url,
        layout: 'horizontal'
      %}

      <header class="qtmAccountOrder__header">
        <div>
          <h1 class="qtmAccountOrder__heading">
            Order {{ order.name | escape }}
          </h1>

          <p class="qtmAccountOrder__meta">
            Placed {{ order.created_at | date: format: 'abbreviated_date' }}
          </p>
        </div>

        <div class="qtmAccountOrder__statusGroup" aria-label="Order statuses">
          <span class="qtmAccountOrder__badge qtmAccountOrder__badge--{{ financial_status | escape }}">
            {{ order.financial_status_label | escape }}
          </span>

          <span class="qtmAccountOrder__badge qtmAccountOrder__badge--{{ fulfillment_status | escape }}">
            {{ order.fulfillment_status_label | escape }}
          </span>

          {% if order.cancelled %}
            <span class="qtmAccountOrder__badge qtmAccountOrder__badge--cancelled">
              Cancelled
            </span>
          {% endif %}
        </div>
      </header>

      <div class="qtmAccountOrder__layout">
        <div class="qtmAccountOrder__main" aria-label="Order details">
          <section class="qtmAccountOrder__card qtmAccountOrder__lineItems" aria-labelledby="QtmAccountOrderItems-{{ section.id }}">
            <div class="qtmAccountOrder__cardHeader">
              <h2 id="QtmAccountOrderItems-{{ section.id }}" class="qtmAccountOrder__cardTitle">
                Items
              </h2>
            </div>

            <div class="qtmAccountOrder__itemsList">
              {% for line_item in order.line_items %}
                <article class="qtmAccountOrder__item" aria-label="{{ line_item.title | escape }}">
                  <div class="qtmAccountOrder__itemMedia">
                    {% if line_item.image %}
                      {{
                        line_item.image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          alt: line_item.title,
                          class: 'qtmAccountOrder__itemImage'
                      }}
                    {% else %}
                      <div class="qtmAccountOrder__itemImagePlaceholder" aria-hidden="true">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="qtmAccountOrder__itemContent">
                    <h3 class="qtmAccountOrder__itemTitle">
                      {{ line_item.title | escape }}
                    </h3>

                    {% if line_item.sku != blank %}
                      <p class="qtmAccountOrder__itemMeta">
                        SKU: {{ line_item.sku | escape }}
                      </p>
                    {% endif %}

                    {% if line_item.properties != blank %}
                      <dl class="qtmAccountOrder__properties">
                        {% for property in line_item.properties %}
                          {% assign property_first_char = property.first | slice: 0 %}
                          {% unless property.last == blank or property_first_char == '_' %}
                            <div>
                              <dt>{{ property.first | escape }}</dt>
                              <dd>{{ property.last | escape }}</dd>
                            </div>
                          {% endunless %}
                        {% endfor %}
                      </dl>
                    {% endif %}

                    {% if line_item.fulfillment %}
                      <div class="qtmAccountOrder__fulfillment">
                        <span>Fulfilled</span>

                        {% if line_item.fulfillment.tracking_company != blank %}
                          <span>{{ line_item.fulfillment.tracking_company | escape }}</span>
                        {% endif %}

                        {% capture shipment_url %}{% render 'account-safe-link', url: line_item.fulfillment.tracking_url %}{% endcapture %}
                        {% if shipment_url != blank %}<a href="{{ shipment_url | strip | escape }}">Track shipment</a>{% endif %}
                        {% if line_item.fulfillment.tracking_numbers.size > 1 %}
                          <ul aria-label="Tracking numbers">{% for number in line_item.fulfillment.tracking_numbers %}<li>{{ number | escape }}</li>{% endfor %}</ul>
                        {% elsif line_item.fulfillment.tracking_number != blank %}
                          <span>{{ line_item.fulfillment.tracking_number | escape }}</span>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>

                  <dl class="qtmAccountOrder__itemPricing">
                    <div>
                      <dt>Quantity</dt>
                      <dd>{{ line_item.quantity | escape }}</dd>
                    </div>

                    <div>
                      <dt>Unit price</dt>
                      <dd>{{ line_item.final_price | money }}</dd>
                    </div>

                    <div>
                      <dt>Line total</dt>
                      <dd>{{ line_item.final_line_price | money }}</dd>
                    </div>
                  </dl>
                </article>
              {% endfor %}
            </div>
          </section>

          <section class="qtmAccountOrder__addresses" aria-label="Order addresses">
            <div class="qtmAccountOrder__card qtmAccountOrder__addressCard">
              <h2 class="qtmAccountOrder__cardTitle">
                Shipping Address
              </h2>

              <div class="qtmAccountOrder__address">
                {% if order.shipping_address %}
                  {{ order.shipping_address | format_address }}
                {% else %}
                  <p>No shipping address available.</p>
                {% endif %}
              </div>
            </div>

            <div class="qtmAccountOrder__card qtmAccountOrder__addressCard">
              <h2 class="qtmAccountOrder__cardTitle">
                Billing Address
              </h2>

              <div class="qtmAccountOrder__address">
                {% if order.billing_address %}
                  {{ order.billing_address | format_address }}
                {% else %}
                  <p>No billing address available.</p>
                {% endif %}
              </div>
            </div>
          </section>
        </div>

        <aside class="qtmAccountOrder__aside" aria-label="Order summary">
          <section class="qtmAccountOrder__card qtmAccountOrder__summary" aria-labelledby="QtmAccountOrderSummary-{{ section.id }}">
            <h2 id="QtmAccountOrderSummary-{{ section.id }}" class="qtmAccountOrder__cardTitle">
              Order Summary
            </h2>

            <dl class="qtmAccountOrder__totals">
              <div>
                <dt>Subtotal</dt>
                <dd>{{ order.subtotal_price | money }}</dd>
              </div>

              <div>
                <dt>Discounts already included</dt>
                <dd>
                  {% if order.total_discounts > 0 %}
                    {{ order.total_discounts | money }}
                  {% else %}
                    {{ 0 | money }}
                  {% endif %}
                </dd>
              </div>

              <div>
                <dt>Shipping</dt>
                <dd>
                  {% if order.shipping_price != blank %}
                    {{ order.shipping_price | money }}
                  {% else %}
                    {{ 0 | money }}
                  {% endif %}
                </dd>
              </div>

              <div>
                <dt>Taxes</dt>
                <dd>
                  {% if tax_price != blank %}
                    {{ tax_price | money }}
                  {% else %}
                    {{ 0 | money }}
                  {% endif %}
                </dd>
              </div>

              <div class="qtmAccountOrder__total">
                <dt>Total</dt>
                <dd>{{ order.total_price | money }}</dd>
              </div>
            </dl>

            {% if section.settings.show_tracking_cta and section.settings.tracking_button_label != blank %}
              {% assign tracking_destination = tracking_page_url | default: order.order_status_url %}
              {% capture actual_tracking_url %}{% render 'account-safe-link', url: tracking_destination %}{% endcapture %}
              {% if actual_tracking_url != blank %}
              <a
                href="{{ actual_tracking_url | strip | escape }}"
                class="qtmAccountOrder__button qtmAccountOrder__button--{{ section.settings.button_style }}"
              >
                {{ section.settings.tracking_button_label | escape }}
              </a>
              {% endif %}
            {% endif %}
          </section>

          <section class="qtmAccountOrder__card qtmAccountOrder__statusSummary" aria-labelledby="QtmAccountOrderStatus-{{ section.id }}">
            <h2 id="QtmAccountOrderStatus-{{ section.id }}" class="qtmAccountOrder__cardTitle">
              Status
            </h2>

            <dl class="qtmAccountOrder__statusList">
              <div>
                <dt>Payment</dt>
                <dd>
                  <span class="qtmAccountOrder__badge qtmAccountOrder__badge--{{ financial_status | escape }}">
                    {{ order.financial_status_label | escape }}
                  </span>
                </dd>
              </div>

              <div>
                <dt>Fulfillment</dt>
                <dd>
                  <span class="qtmAccountOrder__badge qtmAccountOrder__badge--{{ fulfillment_status | escape }}">
                    {{ order.fulfillment_status_label | escape }}
                  </span>
                </dd>
              </div>

              <div>
                <dt>Order date</dt>
                <dd>{{ order.created_at | date: format: 'abbreviated_date' }}</dd>
              </div>
            </dl>
          </section>
        </aside>
      </div>
    {% else %}
      <div class="qtmAccountOrder__empty">
        <h1 class="qtmAccountOrder__heading">
          Order
        </h1>

        {% if customer %}
          <p>This order is unavailable. Return to your orders to choose another order.</p>
          <a href="{{ back_url | escape }}">View orders</a>
        {% else %}
        <p>Please sign in to view this order.</p>

        <a
          href="{{ routes.account_login_url | escape }}"
          class="qtmAccountOrder__button qtmAccountOrder__button--{{ section.settings.button_style }}"
        >
          Sign in
        </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Account Main Order",
  "tag": "section",
  "class": "qtm-account-main-order",
  "settings": [
    {
      "type": "paragraph",
      "content": "Legacy customer-account theme surface. Shopify owns authentication, account data and native form processing; current customer accounts are managed outside the theme. Tracking links require merchant configuration or native fulfillment data."
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "summary_sidebar",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "summary_sidebar",
          "label": "Summary Sidebar"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "text",
      "id": "back_link_label",
      "label": "Back link label",
      "default": "Back to account"
    },
    {
      "type": "url",
      "id": "orders_page_url",
      "label": "Orders page URL"
    },
    {
      "type": "header",
      "content": "Tracking CTA"
    },
    {
      "type": "checkbox",
      "id": "show_tracking_cta",
      "label": "Show tracking CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "tracking_button_label",
      "label": "Tracking button label",
      "default": "Track this order"
    },
    {
      "type": "url",
      "id": "tracking_page_url",
      "label": "Tracking page URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "label": "Meta font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Badge radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Account Main Order"
    }
  ]
}
{% endschema %}
