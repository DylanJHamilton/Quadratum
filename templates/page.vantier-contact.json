{
  "sections": {
    "vantier_1": {
      "type": "sub-banner-breadcrumb",
      "settings": {
        "layout_style": "plain",
        "plain_pad_y_desktop": 72,
        "plain_pad_y_mobile": 44,
        "section_bg_color": "#F4F0EA",
        "section_bg_opacity": 100,
        "content_max_w": "max-w-4xl",
        "text_alignment": "left",
        "show_breadcrumb": true,
        "home_label": "Home",
        "separator": "/",
        "crumb_color": "#55595F",
        "crumb_active_color": "#19191B",
        "show_heading": true,
        "heading": "Contact VANTIER.",
        "heading_level": "h1",
        "heading_size": "4xl",
        "subheading": "Questions about a design, an edit or this demonstration store. Write to us and we will answer by email.",
        "heading_color": "#19191B",
        "subheading_color": "#55595F",
        "enable_overlap": false,
        "simple_mode": true
      },
      "blocks": {
        "van_1": {
          "type": "button",
          "settings": {
            "label": "Write to us",
            "link": "#write",
            "size": "lg",
            "button_mode": "solid",
            "use_theme_colors": false,
            "bg_color": "#19191B",
            "text_color": "#FFFFFF",
            "border_color": "#19191B",
            "border_width": 1,
            "radius": 0
          }
        },
        "van_2": {
          "type": "button",
          "settings": {
            "label": "Client services",
            "link": "/pages/vantier-client-services",
            "size": "lg",
            "button_mode": "outline",
            "use_theme_colors": false,
            "bg_color": "transparent",
            "text_color": "#19191B",
            "border_color": "#857F78",
            "border_width": 1,
            "radius": 0
          }
        }
      },
      "block_order": [
        "van_1",
        "van_2"
      ]
    },
    "vantier_2": {
      "type": "form-support-request",
      "settings": {
        "template_style": "split",
        "surface_style": "card",
        "split_media_side": "right",
        "split_image": "shopify://shop_images/vantier-van-039-trace-point-pump-support.webp",
        "kicker": "Write to us",
        "heading": "Write to VANTIER.",
        "subheading": "Name the design or SKU if your question is about one piece.",
        "success_text": "Thank you. We will reply by email.",
        "destination": "shopify_contact",
        "hidden_tags": "client-services, vantier",
        "button_label": "Send question",
        "bg_color": "#FFFFFF",
        "form_bg": "#FFFFFF",
        "input_radius": 0,
        "input_border": "#857F78",
        "card_radius": 0,
        "anchor_id": "request"
      },
      "blocks": {
        "van_1": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "name",
            "label": "Full name",
            "required": true,
            "width": "half"
          }
        },
        "van_2": {
          "type": "field",
          "settings": {
            "field_type": "email",
            "name_attr": "email",
            "label": "Email",
            "required": true,
            "width": "half"
          }
        },
        "van_3": {
          "type": "field",
          "settings": {
            "field_type": "select",
            "name_attr": "topic",
            "label": "Topic",
            "required": true,
            "width": "half",
            "options": "A specific design\nSizing\nCare\nOrdering\nThis demonstration store\nSomething else"
          }
        },
        "van_4": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "design",
            "label": "Design name or SKU",
            "required": false,
            "width": "half",
            "help_text": "Optional. For example, VAN-001-01-04."
          }
        },
        "van_5": {
          "type": "field",
          "settings": {
            "field_type": "textarea",
            "name_attr": "body",
            "label": "Your question",
            "required": true,
            "width": "full"
          }
        }
      },
      "block_order": [
        "van_1",
        "van_2",
        "van_3",
        "van_4",
        "van_5"
      ]
    },
    "vantier_3": {
      "type": "interactive-content-helper-tabs-accordion",
      "settings": {
        "show_header": true,
        "heading": "Quick answers.",
        "subheading": "",
        "layout_mode": "accordion",
        "style_preset": "faq",
        "accordion_default_open": "all_closed",
        "use_custom_colors": true,
        "bg": "#F4F0EA",
        "text": "#19191B",
        "muted": "#55595F",
        "accent": "#692A35",
        "border": "#DDD6CB"
      },
      "blocks": {
        "van_1": {
          "type": "item",
          "settings": {
            "label": "Is there a showroom?",
            "content": "<p>No. VANTIER is a demonstration store without a physical location.</p>",
            "icon": ""
          }
        },
        "van_2": {
          "type": "item",
          "settings": {
            "label": "Can I order a design?",
            "content": "<p>Not here. Checkout is disabled and nothing is charged.</p>",
            "icon": ""
          }
        },
        "van_3": {
          "type": "item",
          "settings": {
            "label": "Do you work with press or partners?",
            "content": "<p>Not at present. This store exists to demonstrate a contemporary fashion brand on Quadratum.</p>",
            "icon": ""
          }
        }
      },
      "block_order": [
        "van_1",
        "van_2",
        "van_3"
      ]
    }
  },
  "order": [
    "vantier_1",
    "vantier_2",
    "vantier_3"
  ]
}