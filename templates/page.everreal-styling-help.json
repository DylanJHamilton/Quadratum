    "everreal_2": {
      "type": "interactive-content-helper-services-list-grid",
      "settings": {
        "layout": "grid",
        "columns_desktop": 2,
        "columns_tablet": 1,
        "columns_mobile": 1,
        "show_price_column": true,
        "show_cta_per_service": true,
        "title": "Four ways we help you get the look right.",
        "subtitle": "<p>Prices are shown up front. You never need a service to place an order.</p>",
        "use_custom_colors": true,
        "card_bg": "#FFFFFF",
        "border_color": "#E3DAF2",
        "radius_px": 14,
        "btn_bg": "#7047BD",
        "btn_text": "#FFFFFF",
        "btn_radius_px": 8
      },
      "blocks": {
        "er_1": {
          "type": "service",
          "settings": {
            "name": "Look consult",
            "short_description": "<p>Twenty minutes with a look stylist. Share the character and the event, and leave with a costume, wig and finishing list.</p>",
            "price_label": "Free",
            "service_cta_label": "Request a consult",
            "service_cta_url": "/pages/everreal-contact",
            "image": "shopify://shop_images/everreal-mythical-fantasy-mobile.webp"
          }
        },
        "er_2": {
          "type": "service",
          "settings": {
            "name": "Size check",
            "short_description": "<p>Tell us your usual size and the look. We share every fit note we have, and say clearly what is not measured yet.</p>",
            "price_label": "Free",
            "service_cta_label": "Request a size check",
            "service_cta_url": "/pages/everreal-contact",
            "image": "shopify://shop_images/everreal-anime-neo-pop-mobile.webp"
          }
        },
        "er_3": {
          "type": "service",
          "settings": {
            "name": "Group orders",
            "short_description": "<p>Matched looks for friend groups, clubs and convention teams of four or more, shipped together.</p>",
            "price_label": "Quoted per group",
            "service_cta_label": "Get a group quote",
            "service_cta_url": "#q-form-template--20314997063764__everreal_4",
            "image": "shopify://shop_images/everreal-uniforms-roleplay-mobile.webp"
          }
        },
        "er_4": {
          "type": "service",
          "settings": {
            "name": "Theater and events",
            "short_description": "<p>Costumes for school plays, themed parties and stage events, organized by character and size.</p>",
            "price_label": "Quoted per event",
            "service_cta_label": "Get an event quote",
            "service_cta_url": "#q-form-template--20314997063764__everreal_4",
            "image": "shopify://shop_images/everreal-princess-fairytale-mobile.webp"
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4"
      ]
    },
    "everreal_3": {
      "type": "interactive-content-helper-cards",
      "settings": {
        "show_header": true,
        "heading": "Five steps, about twenty minutes.",
        "subheading": "<p>You talk to the same stylist from start to finish, and the look plan arrives by email after the call.</p>",
        "layout_mode": "stacked_timeline",
        "timeline_show_line": true,
        "timeline_marker_style": "icon",
        "timeline_align": "left",
        "design_preset": "minimal",
        "hover_style": "none",
        "card_variant": "icon_card",
        "content_align": "left",
        "card_radius": 14,
        "use_custom_colors": true,
        "color_bg": "#202039",
        "color_text": "#FFFFFF",
        "color_muted": "#C9C3E0",
        "color_accent": "#F1C56D",
        "color_surface": "#2B2A4C",
        "color_border": "#3D3B63"
      },
      "blocks": {
        "er_1": {
          "type": "card",
          "settings": {
            "title": "Tell us the character",
            "body": "<p>Share the character, the event and any photos you are working from.</p>",
            "icon": "lucide-message-square",
            "cta_label": "",
            "cta_url": "",
            "badge": ""
          }
        },
        "er_2": {
          "type": "card",
          "settings": {
            "title": "Share your usual size",
            "body": "<p>The size you buy in everyday clothes is the best starting point.</p>",
            "icon": "lucide-ruler",
            "cta_label": "",
            "cta_url": "",
            "badge": ""
          }
        },
        "er_3": {
          "type": "card",
          "settings": {
            "title": "Get a look plan",
            "body": "<p>A costume, a wig if it needs one, and finishing pieces, with every included item listed.</p>",
            "icon": "lucide-list-checks",
            "cta_label": "",
            "cta_url": "",
            "badge": ""
          }
        },
        "er_4": {
          "type": "card",
          "settings": {
            "title": "Order or adjust",
            "body": "<p>Order the plan as it is, or swap pieces until it feels right.</p>",
            "icon": "lucide-shopping-bag",
            "cta_label": "",
            "cta_url": "",
            "badge": ""
          }
        },
        "er_5": {
          "type": "card",
          "settings": {
            "title": "Wear it out",
            "body": "<p>Plan shoes, pack a small repair kit and enjoy the day.</p>",
            "icon": "lucide-camera",
            "cta_label": "",
            "cta_url": "",
            "badge": ""
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4",
        "er_5"
      ]
    },
    "everreal_4": {
      "type": "form-quote-full",
      "settings": {
        "aria_label": "Group quote request",
        "template_style": "steps",
        "bg_color": "#F5F0FB",
        "overlay_type": "none",
        "kicker": "Group and event orders",
        "heading": "Get a group quote in three short steps.",
        "heading_level": "h2",
        "subheading": "Four or more looks. The quote lists every look, piece and size before you approve anything. Fields marked with an asterisk are required.",
        "success_text": "Thanks. A stylist will reply within one business day.",
        "error_text": "Please fix the highlighted fields and try again.",
        "destination": "shopify_contact",
        "hidden_tags": "group-quote, everreal",
        "captcha_mode": "inherit",
        "button_label": "Request a group quote",
        "button_variant": "solid",
        "form_bg": "#FFFFFF",
        "input_radius": 8,
        "input_border": 1,
        "container_mode": "contained",
        "padding_y": 96,
        "padding_x": 24,
        "card_radius": 16,
        "card_shadow": "sm",
        "anchor_id": "quote"
      },
      "blocks": {
        "er_1": {
          "type": "step",
          "settings": {
            "step_title": "Your group",
            "step_desc": "Tell us how many looks and what they are for."
          }
        },
        "er_2": {
          "type": "field",
          "settings": {
            "field_type": "select",
            "name_attr": "contact[group_size]",
            "label": "Group size",
            "required": true,
            "options": "4 to 6 looks\n7 to 10 looks\n11 to 20 looks\nMore than 20 looks",
            "width": "half"
          }
        },
        "er_3": {
          "type": "field",
          "settings": {
            "field_type": "date",
            "name_attr": "contact[event_date]",
            "label": "Event date",
            "required": false,
            "help_text": "Optional. Helps us plan shipping.",
            "width": "half"
          }
        },
        "er_4": {
          "type": "field",
          "settings": {
            "field_type": "select",
            "name_attr": "contact[event_type]",
            "label": "Event type",
            "required": true,
            "options": "Convention\nStage or school event\nThemed party\nPhoto shoot\nSomething else",
            "width": "full"
          }
        },
        "er_5": {
          "type": "step",
          "settings": {
            "step_title": "The looks",
            "step_desc": "Pick the worlds, then list each character and size."
          }
        },
        "er_6": {
          "type": "field",
          "settings": {
            "field_type": "checkbox",
            "name_attr": "contact[worlds]",
            "label": "Worlds you are considering",
            "options": "Anime & Neo Pop\nGaming Cosplay\nMythical & Fantasy\nPrincess & Fairytale\nUniforms & Roleplay\nSwimwear & Festival\nWigs and accessory kits\nNot sure yet",
            "width": "full"
          }
        },
        "er_7": {
          "type": "field",
          "settings": {
            "field_type": "textarea",
            "name_attr": "contact[looks]",
            "label": "Characters and sizes",
            "required": true,
            "help_text": "One line per person, for example: ranger, size M.",
            "width": "full"
          }
        },
        "er_8": {
          "type": "step",
          "settings": {
            "step_title": "Your details",
            "step_desc": "Where should we send the quote?"
          }
        },
        "er_9": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "contact[name]",
            "label": "Full name",
            "required": true,
            "width": "half"
          }
        },
        "er_10": {
          "type": "field",
          "settings": {
            "field_type": "email",
            "name_attr": "contact[email]",
            "label": "Email",
            "required": true,
            "width": "half"
          }
        },
        "er_11": {
          "type": "field",
          "settings": {
            "field_type": "tel",
            "name_attr": "contact[phone]",
            "label": "Phone",
            "required": false,
            "help_text": "Optional.",
            "width": "half"
          }
        },
        "er_12": {
          "type": "field",
          "settings": {
            "field_type": "consent",
            "name_attr": "contact[consent]",
            "label": "I agree to be contacted about this quote.",
            "required": true,
            "width": "full"
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4",
        "er_5",
        "er_6",
        "er_7",
        "er_8",
        "er_9",
        "er_10",
        "er_11",
        "er_12"
      ]
    },
    "everreal_5": {
      "type": "3rd-party-scheduling-booking-embed",
      "settings": {
        "enable_section": true,
        "kicker": "Request a consult",
        "heading": "Talk through your next look.",
