{%- if filters.size > 0 -%}
  {%- if placement == 'drawer' -%}
    <div id="QcmDrawer-{{ section.id }}" class="qcmDrawer" data-qcm-drawer hidden aria-hidden="true">
      <div class="qcmDrawer__overlay" data-qcm-drawer-close></div>
      <div class="qcmDrawer__panel" data-qcm-drawer-panel role="dialog" aria-modal="true" aria-label="Filters" tabindex="-1">
        <button type="button" class="qcm__btn" data-qcm-drawer-close>Close filters</button>
        {% render 'collection-modern-facets', section: section, s: s, filters: filters, results_url: results_url, is_search_context: is_search_context, terms_q: terms_q, sort_by: sort_by, placement: 'sidebar' %}
      </div>
    </div>
  {%- else -%}
    {% render 'collection-modern-facets', section: section, s: s, filters: filters, results_url: results_url, is_search_context: is_search_context, terms_q: terms_q, sort_by: sort_by, placement: 'sidebar' %}
  {%- endif -%}
{%- endif -%}
