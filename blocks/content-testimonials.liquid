        },
        {
          "value": "4",
          "label": "4 stars"
        },
        {
          "value": "5",
          "label": "5 stars"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "testimonial_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "testimonial_1_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "testimonial_1_link_label",
      "label": "Link label"
    },
    {
      "type": "url",
