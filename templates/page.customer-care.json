    "about-this-sample-store": {
      "type": "interactive-content-helper-tabs-accordion",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "label": "Is anything here for sale?",
            "icon": "",
            "anchor_id": "about-this-sample-store",
            "content": "<p>No. Folio & Field is a sample store built to show the Quadratum Shopify theme. Books, creators, prices and photographs are fictional placeholders and orders are not accepted.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "What is Quadratum?",
            "icon": "",
            "anchor_id": "what-is-quadratum",
            "content": "<p>A Shopify theme by TinkerRune. Every section on this site is a stock Quadratum section with brand settings applied. See the Built on Quadratum page for the full list.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Can I use this layout for my own store?",
            "icon": "",
            "anchor_id": "can-i-use-this-layout-for-my-own-store",
            "content": "<p>That is the idea. The same sections, blocks and settings are available to any store running the theme.</p>"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3"
