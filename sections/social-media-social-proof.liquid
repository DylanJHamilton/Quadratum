    },
    {
      "type": "select",
      "id": "bg_scheme",
      "label": "Background scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "subtle",
          "label": "Subtle surface"
        },
        {
          "value": "emphasis",
          "label": "Emphasis (primary)"
        }
