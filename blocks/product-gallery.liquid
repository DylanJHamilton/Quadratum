{%- liquid
  assign block_id = 'product-gallery-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant
  assign current_media = current_variant.featured_media | default: product_context.featured_media | default: product_context.media.first

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign gallery_mode = block.settings.gallery_mode | default: 'slider'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign media_count = product_context.media.size
  assign extra_current = false
  if current_media != blank
    assign current_found = false
    for media in product_context.media
      if media.id == current_media.id
        assign current_found = true
      endif
    endfor
    unless current_found
      assign extra_current = true
    endunless
  endif
  assign last_media_index = media_count | minus: 1
  if extra_current
    assign last_media_index = media_count
    assign media_count = media_count | plus: 1
  endif
-%}

{% if media_count > 0 %}
  {%- capture gallery_variants -%}[{% if current_variant != blank %}{"id":{{ current_variant.id | json }},"mediaId":{{ current_variant.featured_media.id | json }}}{% endif %}{% for variant in product_context.variants %}{% unless variant.id == current_variant.id %}{% if current_variant != blank or forloop.first == false %},{% endif %}{"id":{{ variant.id | json }},"mediaId":{{ variant.featured_media.id | json }}}{% endunless %}{% endfor %}]{%- endcapture -%}
  <div
    id="{{ block_id }}"
    class="
      product-gallery
      product-gallery--{{ gallery_mode }}
      product-gallery--width-{{ width }}
      product-gallery--align-{{ alignment }}
      product-gallery--thumbs-{{ block.settings.thumbnail_position }}
      {% unless show_on_desktop or request.design_mode %} product-gallery--hide-desktop{% endunless %}
      {% unless show_on_tablet or request.design_mode %} product-gallery--hide-tablet{% endunless %}
      {% unless show_on_mobile or request.design_mode %} product-gallery--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-gallery--animate product-gallery--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-gallery-margin-top: {{ block.settings.margin_top }}px;
      --product-gallery-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-gallery-padding: {{ block.settings.padding }}px;
      --product-gallery-gap: {{ block.settings.media_gap }}px;
      --product-gallery-main-ratio: {{ block.settings.main_media_ratio | divided_by: 100.0 }};
      --product-gallery-media-radius: {{ block.settings.media_radius }}px;
      --product-gallery-thumbnail-radius: {{ block.settings.thumbnail_radius }}px;
      --product-gallery-border-width: {{ block.settings.media_border_width }}px;
      --product-gallery-border-color: {{ block.settings.media_border_color }};
      --product-gallery-background: {{ block.settings.media_background }};
      --product-gallery-thumbnail-size: {{ block.settings.thumbnail_size }}px;
      --product-gallery-thumbnail-border: {{ block.settings.thumbnail_border_color }};
      --product-gallery-thumbnail-active: {{ block.settings.thumbnail_active_color }};
      --product-gallery-arrow-background: {{ block.settings.arrow_background }};
      --product-gallery-arrow-text: {{ block.settings.arrow_text_color }};
      --product-gallery-dot-color: {{ block.settings.dot_color }};
      --product-gallery-dot-active: {{ block.settings.dot_active_color }};
      --product-gallery-masonry-columns-desktop: {{ block.settings.masonry_columns_desktop }};
      --product-gallery-masonry-columns-tablet: {{ block.settings.masonry_columns_tablet }};
      --product-gallery-masonry-columns-mobile: {{ block.settings.masonry_columns_mobile }};
      --product-gallery-grid-columns-desktop: {{ block.settings.gallery_columns_desktop }};
      --product-gallery-grid-columns-mobile: {{ block.settings.gallery_columns_mobile }};
    "
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-qtm-block-gallery
    role="region" aria-label="{{ block.settings.dots_label | default: 'Product media' | escape }}"
    data-variants="{{ gallery_variants | escape }}"
    data-current-media="{{ current_media.id }}"
    data-design-mode="{{ request.design_mode }}"
    data-pause-label="{{ block.settings.pause_label | default: 'Pause slideshow' | escape }}"
    data-resume-label="{{ block.settings.resume_label | default: 'Resume slideshow' | escape }}"
    data-gallery-mode="{{ gallery_mode }}"
    data-autoplay="{{ block.settings.enable_autoplay }}"
    data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  >
    <style>
      #{{ block_id }} {
        box-sizing: border-box;
        min-width: 0;
        overflow-wrap: anywhere;
        width: 100%;
        margin-top: var(--product-gallery-margin-top);
        margin-bottom: var(--product-gallery-margin-bottom);
        padding: var(--product-gallery-padding);
      }

      #{{ block_id }}.product-gallery--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-gallery--width-small {
        max-width: 720px;
      }

      #{{ block_id }}.product-gallery--width-medium {
        max-width: 960px;
      }

      #{{ block_id }}.product-gallery--width-large {
        max-width: 1200px;
      }

      #{{ block_id }}.product-gallery--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-gallery--align-left {
        margin-left: 0;
        margin-right: auto;
      }

      #{{ block_id }}.product-gallery--align-center {
        margin-left: auto;
        margin-right: auto;
      }

      #{{ block_id }}.product-gallery--align-right {
        margin-left: auto;
        margin-right: 0;
      }

      #{{ block_id }} .product-gallery__inner {
        position: relative;
        width: 100%;
        min-width: 0;
      }

      #{{ block_id }} .product-gallery__media-frame {
        position: relative;
        display: block;
        width: 100%;
        overflow: hidden;
        background: var(--product-gallery-background);
        border: var(--product-gallery-border-width) solid var(--product-gallery-border-color);
        border-radius: var(--product-gallery-media-radius);
        aspect-ratio: var(--product-gallery-main-ratio);
      }

      #{{ block_id }} .product-gallery__media-frame img,
      #{{ block_id }} .product-gallery__media-frame video,
      #{{ block_id }} .product-gallery__media-frame iframe,
      #{{ block_id }} .product-gallery__media-frame model-viewer {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: {{ block.settings.image_fit }};
      }

      #{{ block_id }} .product-gallery__media-frame iframe,
      #{{ block_id }} .product-gallery__media-frame model-viewer {
        border: 0;
      }

      #{{ block_id }} .product-gallery__media-type {
        position: absolute;
        right: 12px;
        bottom: 12px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        min-height: 34px;
        padding: 7px 9px;
        color: var(--product-gallery-arrow-text);
        background: var(--product-gallery-arrow-background);
        border-radius: 999px;
        font-size: 12px;
        line-height: 1;
        pointer-events: none;
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__viewport {
        position: relative;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        border-radius: var(--product-gallery-media-radius);
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__track {
        display: flex;
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__slide {
        flex: 0 0 100%;
        min-width: 100%;
        scroll-snap-align: start;
      }


      #{{ block_id }} .product-gallery__arrow {
        appearance: none;
        position: absolute;
        top: 50%;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: var(--product-gallery-arrow-text);
        background: var(--product-gallery-arrow-background);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        transform: translateY(-50%);
        transition: opacity 180ms ease, transform 180ms ease;
      }

      #{{ block_id }} .product-gallery__arrow:hover {
        opacity: 0.82;
        transform: translateY(-50%) scale(1.04);
      }

      #{{ block_id }} .product-gallery__arrow:focus-visible {
        outline: 2px solid var(--product-gallery-thumbnail-active);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-gallery__arrow--previous {
        left: 14px;
      }

      #{{ block_id }} .product-gallery__arrow--next {
        right: 14px;
      }

      #{{ block_id }} .product-gallery__dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 12px;
      }

      #{{ block_id }} .product-gallery__dot {
        appearance: none;
        width: 24px;
        height: 24px;
        padding: 0;
        background: var(--product-gallery-dot-color);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        opacity: 0.48;
      }

      #{{ block_id }} .product-gallery__dot.is-active {
        background: var(--product-gallery-dot-active);
        opacity: 1;
      }

      #{{ block_id }} .product-gallery__dot:focus-visible {
        outline: 2px solid var(--product-gallery-dot-active);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-gallery__thumbnails {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        overflow-x: auto;
        scrollbar-width: thin;
      }

      #{{ block_id }} .product-gallery__thumbnail {
        appearance: none;
        position: relative;
        flex: 0 0 var(--product-gallery-thumbnail-size);
        width: var(--product-gallery-thumbnail-size);
        height: var(--product-gallery-thumbnail-size);
        padding: 0;
        overflow: hidden;
        background: var(--product-gallery-background);
        border: 1px solid var(--product-gallery-thumbnail-border);
        border-radius: var(--product-gallery-thumbnail-radius);
        cursor: pointer;
      }

      #{{ block_id }} .product-gallery__thumbnail.is-active {
        border-color: var(--product-gallery-thumbnail-active);
        box-shadow: 0 0 0 1px var(--product-gallery-thumbnail-active);
      }

      #{{ block_id }} .product-gallery__thumbnail:focus-visible {
        outline: 2px solid var(--product-gallery-thumbnail-active);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-gallery__thumbnail img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
      }

      #{{ block_id }} .product-gallery__thumbnail-badge {
        position: absolute;
        right: 4px;
        bottom: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        min-height: 20px;
        padding: 3px 5px;
        color: var(--product-gallery-arrow-text);
        background: var(--product-gallery-arrow-background);
        border-radius: 999px;
        font-size: 10px;
        line-height: 1;
      }

      #{{ block_id }}.product-gallery--gallery .product-gallery__grid {
        display: grid;
        grid-template-columns: repeat(var(--product-gallery-grid-columns-desktop), minmax(0, 1fr));
        gap: var(--product-gallery-gap);
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__masonry {
        column-count: var(--product-gallery-masonry-columns-desktop);
        column-gap: var(--product-gallery-gap);
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__masonry-item {
        display: inline-block;
        width: 100%;
        margin: 0 0 var(--product-gallery-gap);
        break-inside: avoid;
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__media-frame:has(> img, > video) {
        aspect-ratio: auto;
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__media-frame img,
      #{{ block_id }}.product-gallery--masonry .product-gallery__media-frame video {
        height: auto;
        object-fit: cover;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__horizontal-layout {
        display: grid;
        grid-template-columns: var(--product-gallery-thumbnail-size) minmax(0, 1fr);
        gap: var(--product-gallery-gap);
        align-items: start;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-layout {
        grid-template-columns: minmax(0, 1fr) var(--product-gallery-thumbnail-size);
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-main {
        order: 1;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__vertical-thumbs {
        order: 2;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs {
        display: grid;
        gap: 8px;
        max-height: 680px;
        overflow-y: auto;
        scrollbar-width: thin;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs .product-gallery__thumbnail {
        width: var(--product-gallery-thumbnail-size);
        height: var(--product-gallery-thumbnail-size);
      }


      #{{ block_id }}.product-gallery--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-gallery--animate-fade {
        animation-name: productGalleryFade;
      }

      #{{ block_id }}.product-gallery--animate-fade_up {
        animation-name: productGalleryFadeUp;
      }

      #{{ block_id }}.product-gallery--animate-zoom {
        animation-name: productGalleryZoom;
      }

      @keyframes productGalleryFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productGalleryFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productGalleryZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-gallery--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-gallery--hide-tablet {
          display: none !important;
        }

        #{{ block_id }}.product-gallery--masonry .product-gallery__masonry {
          column-count: var(--product-gallery-masonry-columns-tablet);
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }}.product-gallery--hide-mobile {
          display: none !important;
        }

        #{{ block_id }}.product-gallery--gallery .product-gallery__grid {
          grid-template-columns: repeat(var(--product-gallery-grid-columns-mobile), minmax(0, 1fr));
        }

        #{{ block_id }}.product-gallery--masonry .product-gallery__masonry {
          column-count: var(--product-gallery-masonry-columns-mobile);
        }

        #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__horizontal-layout,
        #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-layout {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
        }

        #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-main,
        #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__vertical-thumbs {
          order: initial;
        }

        #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs {
          display: flex;
          max-height: none;
          overflow-x: auto;
          overflow-y: hidden;
          margin-top: 10px;
        }

        #{{ block_id }} .product-gallery__arrow {
          width: 38px;
          height: 38px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-gallery--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }

        #{{ block_id }}.product-gallery--slider .product-gallery__track,
        #{{ block_id }} .product-gallery__arrow {
          transition: none;
        }
      }
      #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; min-width: 0; }
      #{{ block_id }} [hidden] { display: none !important; }
      #{{ block_id }} :is(a, button, [tabindex]):focus-visible { outline: 2px solid var(--product-gallery-thumbnail-active); outline-offset: 3px; }
      #{{ block_id }} .product-gallery__visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      #{{ block_id }} .product-gallery__dots { flex-wrap: wrap; }
      #{{ block_id }} .product-gallery__pause { color: var(--product-gallery-arrow-text); background: var(--product-gallery-arrow-background); border: 0; border-radius: 6px; padding: 10px; margin-top: 10px; cursor: pointer; max-width: 100%; }
      #{{ block_id }} [data-gallery-embed-link] { display: block; width: 100%; height: 100%; color: var(--product-gallery-arrow-text); }
      #{{ block_id }} [data-gallery-embed-link] span { position: absolute; inset-inline-start: 12px; bottom: 12px; background: var(--product-gallery-arrow-background); color: var(--product-gallery-arrow-text); padding: 8px; }
      #{{ block_id }} [data-gallery-embed-player] { width: 100%; height: 100%; }
      #{{ block_id }} model-viewer:not(:defined) { display: none; }
      #{{ block_id }} model-viewer:defined + [data-gallery-model-fallback] { display: none; }
      #{{ block_id }} [data-gallery-model-fallback] { display: block; width: 100%; height: 100%; }
      #{{ block_id }}.product-gallery--horizontal_thumbs:not(:has([data-product-gallery-thumbnail])),
      #{{ block_id }}.product-gallery--horizontal_thumbs:not([data-qtm-gallery-ready]) { --product-gallery-thumbnail-size: 0px; }
      #{{ block_id }}.product-gallery--horizontal_thumbs:not(:has([data-product-gallery-thumbnail])) .product-gallery__horizontal-layout,
      #{{ block_id }}.product-gallery--horizontal_thumbs:not([data-qtm-gallery-ready]) .product-gallery__horizontal-layout,
      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-bottom .product-gallery__horizontal-layout { grid-template-columns: minmax(0, 1fr); }
      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-bottom .product-gallery__horizontal-main { order: 1; }
      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-bottom .product-gallery__vertical-thumbs { order: 2; display: flex; overflow-x: auto; }
      #{{ block_id }} .product-gallery__horizontal-main { display: grid; gap: var(--product-gallery-gap); }
      #{{ block_id }} .product-gallery__thumbnail-badge { pointer-events: none; }
      @media (min-width: 750px) {
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready]:has(.product-gallery__thumbnails):not(.product-gallery--thumbs-bottom) .product-gallery__inner { display: grid; grid-template-columns: var(--product-gallery-thumbnail-size) minmax(0, 1fr); gap: var(--product-gallery-gap); }
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready].product-gallery--thumbs-right:has(.product-gallery__thumbnails) .product-gallery__inner { grid-template-columns: minmax(0, 1fr) var(--product-gallery-thumbnail-size); }
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready]:not(.product-gallery--thumbs-bottom) .product-gallery__slider-shell { grid-column: 2; grid-row: 1; }
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready].product-gallery--thumbs-right .product-gallery__slider-shell { grid-column: 1; }
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready]:not(.product-gallery--thumbs-bottom) .product-gallery__thumbnails { grid-column: 1; grid-row: 1; display: grid; overflow-y: auto; overflow-x: hidden; max-height: 680px; margin: 0; }
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready].product-gallery--thumbs-right .product-gallery__thumbnails { grid-column: 2; }
        #{{ block_id }}.product-gallery--slider[data-qtm-gallery-ready]:not(.product-gallery--thumbs-bottom) :is(.product-gallery__dots,.product-gallery__pause) { grid-column: 1 / -1; }
      }
      @media (max-width: 749px) {
        #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__horizontal-main { order: 1; }
        #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs { order: 2; }
      }
      @media (min-width: 990px) { .shopify-block:has(> #{{ block_id }}.product-gallery--hide-desktop) { display: none !important; } }
      @media (min-width: 750px) and (max-width: 989px) { .shopify-block:has(> #{{ block_id }}.product-gallery--hide-tablet) { display: none !important; } }
      @media (max-width: 749px) { .shopify-block:has(> #{{ block_id }}.product-gallery--hide-mobile) { display: none !important; } }
      #{{ block_id }} .product-gallery__slider-shell { position: relative; min-width: 0; }
      #{{ block_id }} [data-gallery-model-fallback] { position: relative; }
      #{{ block_id }} .product-gallery__model-links { position: absolute; inset-inline: 10px; bottom: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
      #{{ block_id }} .product-gallery__model-links a { color: var(--product-gallery-arrow-text); background: var(--product-gallery-arrow-background); padding: 8px; }
    </style>


    {%- capture gallery_items -%}
      {%- for i in (0..last_media_index) -%}
        {%- liquid
          assign media_index = i
          if extra_current
            assign media_index = i | minus: 1
          endif
          assign media = product_context.media[media_index]
          if extra_current and i == 0
            assign media = current_media
          endif
          assign image_loading = 'lazy'
          if media.id == current_media.id
            assign image_loading = 'eager'
          endif
        -%}
        <div id="{{ block_id }}-media-{{ media.id }}" data-gallery-item data-media-id="{{ media.id }}" role="group" aria-label="{{ block.settings.go_to_slide_label | default: 'Media' | escape }} {{ i | plus: 1 }} / {{ media_count }}" class="{% case gallery_mode %}{% when 'slider' %}product-gallery__slide{% when 'gallery' %}product-gallery__grid-item{% when 'masonry' %}product-gallery__masonry-item{% else %}product-gallery__horizontal-media{% endcase %}">
          <div class="product-gallery__media-frame">{% render 'qtm-block-product-media', media: media, product: product_context, image_loading: image_loading, muted: block.settings.mute_videos %}</div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture gallery_thumbs -%}
      {% if block.settings.show_thumbnails and media_count > 1 %}
        <div hidden data-gallery-nav class="{% if gallery_mode == 'horizontal_thumbs' %}product-gallery__vertical-thumbs{% else %}product-gallery__thumbnails{% endif %}" role="group" aria-label="{{ block.settings.thumbnails_label | default: 'Media thumbnails' | escape }}">
          {% for i in (0..last_media_index) %}
            {% liquid
              assign media_index = i
              if extra_current
                assign media_index = i | minus: 1
              endif
              assign media = product_context.media[media_index]
              if extra_current and i == 0
                assign media = current_media
              endif
            %}
            <button type="button" class="product-gallery__thumbnail" data-product-gallery-thumbnail data-index="{{ i }}" data-media-id="{{ media.id }}" aria-controls="{{ block_id }}-media-{{ media.id }}" aria-label="{{ block.settings.go_to_slide_label | default: 'View media' | escape }} {{ i | plus: 1 }}">
              {% if media.preview_image %}{{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: '' }}{% else %}{{ i | plus: 1 }}{% endif %}
              {% if media.media_type == 'video' or media.media_type == 'external_video' %}<span class="product-gallery__thumbnail-badge" aria-hidden="true">▶</span>{% elsif media.media_type == 'model' %}<span class="product-gallery__thumbnail-badge" aria-hidden="true">3D</span>{% endif %}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    {%- endcapture -%}
    <div class="product-gallery__inner">
      {% case gallery_mode %}
        {% when 'slider' %}
          <div class="product-gallery__slider-shell">
          <div class="product-gallery__viewport" data-product-gallery-viewport id="{{ block_id }}-viewport" tabindex="0" role="group" aria-label="{{ block.settings.dots_label | default: 'Product media' | escape }}">
            <div class="product-gallery__track" data-product-gallery-track>{{ gallery_items }}</div>
          </div>
            {% if block.settings.show_arrows and media_count > 1 %}
              <button hidden data-gallery-nav type="button" class="product-gallery__arrow product-gallery__arrow--previous" data-product-gallery-prev aria-controls="{{ block_id }}-viewport" aria-label="{{ block.settings.previous_label | default: 'Previous media' | escape }}">‹</button>
              <button hidden data-gallery-nav type="button" class="product-gallery__arrow product-gallery__arrow--next" data-product-gallery-next aria-controls="{{ block_id }}-viewport" aria-label="{{ block.settings.next_label | default: 'Next media' | escape }}">›</button>
            {% endif %}
          </div>
          {% if block.settings.show_dots and media_count > 1 %}<div hidden data-gallery-nav class="product-gallery__dots" role="group" aria-label="{{ block.settings.dots_label | default: 'Product media slides' | escape }}">{% for i in (0..last_media_index) %}<button type="button" class="product-gallery__dot" data-product-gallery-dot data-index="{{ i }}" aria-controls="{{ block_id }}-viewport" aria-label="{{ block.settings.go_to_slide_label | default: 'View media' | escape }} {{ i | plus: 1 }}"></button>{% endfor %}</div>{% endif %}
          {{ gallery_thumbs }}
          {% if block.settings.enable_autoplay and media_count > 1 %}<button hidden type="button" class="product-gallery__pause" data-gallery-pause>{{ block.settings.pause_label | default: 'Pause slideshow' | escape }}</button>{% endif %}
        {% when 'gallery' %}<div class="product-gallery__grid">{{ gallery_items }}</div>
        {% when 'masonry' %}<div class="product-gallery__masonry">{{ gallery_items }}</div>
        {% else %}<div class="product-gallery__horizontal-layout">{{ gallery_thumbs }}<div class="product-gallery__horizontal-main">{{ gallery_items }}</div></div>
      {% endcase %}
      <p class="product-gallery__visually-hidden" data-gallery-status role="status" aria-live="polite"></p>
    </div>
  </div>
{% elsif request.design_mode %}<p>Add product media to display this gallery.</p>{% endif %}
{% schema %}
{
  "name": "Product gallery",
  "settings": [
    {
      "type": "header",
      "content": "Gallery mode"
    },
    {
      "type": "select",
      "id": "gallery_mode",
      "label": "Gallery mode",
      "default": "slider",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "gallery",
          "label": "Gallery"
        },
        {
          "value": "masonry",
          "label": "Masonry"
        },
        {
          "value": "horizontal_thumbs",
          "label": "Horizontal thumbnails"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Media fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "main_media_ratio",
      "label": "Main media ratio",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 125,
      "info": "Width divided by height as a percentage; 125 produces a 1.25:1 frame."
    },
    {
      "type": "checkbox",
      "id": "mute_videos",
      "label": "Mute videos by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Slider controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false,
      "info": "Slider only. Includes a pause control; paused in the editor, hidden pages and reduced-motion mode."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "header",
      "content": "Thumbnails"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "Thumbnail position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "info": "Used by Slider and Horizontal thumbnails layouts; thumbnails move below media on small screens."
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size",
      "min": 48,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "Thumbnail radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Gallery grid"
    },
    {
      "type": "range",
      "id": "gallery_columns_desktop",
      "label": "Gallery columns desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gallery_columns_mobile",
      "label": "Gallery columns mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Masonry"
    },
    {
      "type": "range",
      "id": "masonry_columns_desktop",
      "label": "Masonry columns desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "masonry_columns_tablet",
      "label": "Masonry columns tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "masonry_columns_mobile",
      "label": "Masonry columns mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "media_gap",
      "label": "Media gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "media_border_width",
      "label": "Media border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
