{%- liquid
  assign block_id = 'product-recently-purchased-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign layout_style = block.settings.layout_style | default: 'inline_notice'
  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign message_text = block.settings.message_text

  if block.settings.message_source == 'product_fallback' and product_context != blank
    assign message_text = block.settings.product_prefix | append: ' ' | append: product_context.title | append: ' ' | append: block.settings.product_suffix
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    product-recently-purchased
    product-recently-purchased--{{ layout_style }}
    product-recently-purchased--width-{{ width }}
    product-recently-purchased--align-{{ alignment }}
    {% unless show_on_desktop %} product-recently-purchased--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-recently-purchased--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-recently-purchased--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-recently-purchased--animate product-recently-purchased--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-recently-purchased-margin-top: {{ block.settings.margin_top }}px;
    --product-recently-purchased-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-recently-purchased-padding: {{ block.settings.padding }}px;
    --product-recently-purchased-card-padding: {{ block.settings.card_padding }}px;
    --product-recently-purchased-gap: {{ block.settings.content_gap }}px;
    --product-recently-purchased-radius: {{ block.settings.card_radius }}px;
    --product-recently-purchased-border-width: {{ block.settings.border_width }}px;
    --product-recently-purchased-icon-size: {{ block.settings.icon_size }}px;
    --product-recently-purchased-heading-color: {{ block.settings.heading_color }};
    --product-recently-purchased-text-color: {{ block.settings.text_color }};
    --product-recently-purchased-muted-color: {{ block.settings.muted_color }};
    --product-recently-purchased-background: {{ block.settings.background_color }};
    --product-recently-purchased-card-background: {{ block.settings.card_background_color }};
    --product-recently-purchased-border-color: {{ block.settings.border_color }};
    --product-recently-purchased-icon-background: {{ block.settings.icon_background_color }};
    --product-recently-purchased-icon-color: {{ block.settings.icon_color }};
    --product-recently-purchased-accent-color: {{ block.settings.accent_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-recently-purchased
  data-randomize="{{ block.settings.randomize_messages }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-recently-purchased-margin-top);
      margin-bottom: var(--product-recently-purchased-margin-bottom);
      padding: var(--product-recently-purchased-padding);
      color: var(--product-recently-purchased-text-color);
      background: var(--product-recently-purchased-background);
    }

    #{{ block_id }}.product-recently-purchased--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-recently-purchased--width-small {
      max-width: 520px;
    }

    #{{ block_id }}.product-recently-purchased--width-medium {
      max-width: 760px;
    }

    #{{ block_id }}.product-recently-purchased--width-large {
      max-width: 980px;
    }

    #{{ block_id }}.product-recently-purchased--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-recently-purchased--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-recently-purchased--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-recently-purchased--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-recently-purchased__inner {
      display: inline-grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--product-recently-purchased-gap);
      width: 100%;
      min-width: 0;
      color: var(--product-recently-purchased-text-color);
      background: var(--product-recently-purchased-card-background);
      border: var(--product-recently-purchased-border-width) solid var(--product-recently-purchased-border-color);
      border-radius: var(--product-recently-purchased-radius);
    }

    #{{ block_id }}.product-recently-purchased--inline_notice .product-recently-purchased__inner {
      width: fit-content;
      max-width: 100%;
      padding: var(--product-recently-purchased-card-padding);
    }

    #{{ block_id }}.product-recently-purchased--card .product-recently-purchased__inner {
      padding: var(--product-recently-purchased-card-padding);
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }}.product-recently-purchased--minimal .product-recently-purchased__inner {
      width: fit-content;
      max-width: 100%;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    #{{ block_id }}.product-recently-purchased--align-center .product-recently-purchased__inner {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-recently-purchased--align-right .product-recently-purchased__inner {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-recently-purchased__icon {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--product-recently-purchased-icon-size);
      height: var(--product-recently-purchased-icon-size);
      color: var(--product-recently-purchased-icon-color);
      background: var(--product-recently-purchased-icon-background);
      border-radius: 999px;
      line-height: 1;
      font-weight: 900;
    }

    #{{ block_id }} .product-recently-purchased__icon::after {
      content: "";
      position: absolute;
      right: 2px;
      bottom: 2px;
      width: 8px;
      height: 8px;
      background: var(--product-recently-purchased-accent-color);
      border: 2px solid var(--product-recently-purchased-card-background);
      border-radius: 999px;
    }

    #{{ block_id }} .product-recently-purchased__content {
      display: grid;
      gap: 3px;
      min-width: 0;
    }

    #{{ block_id }} .product-recently-purchased__heading {
      margin: 0;
      color: var(--product-recently-purchased-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.25;
      font-weight: 800;
    }

    #{{ block_id }} .product-recently-purchased__message {
      margin: 0;
      color: var(--product-recently-purchased-text-color);
      font-size: {{ block.settings.message_size }}px;
      line-height: 1.45;
    }

    #{{ block_id }} .product-recently-purchased__caption {
      margin: 0;
      color: var(--product-recently-purchased-muted-color);
      font-size: {{ block.settings.caption_size }}px;
      line-height: 1.35;
    }

    #{{ block_id }}.product-recently-purchased--minimal .product-recently-purchased__heading {
      display: none;
    }

    #{{ block_id }}.product-recently-purchased--minimal .product-recently-purchased__caption {
      display: none;
    }

    #{{ block_id }}.product-recently-purchased--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-recently-purchased--animate-fade {
      animation-name: productRecentlyPurchasedFade;
    }

    #{{ block_id }}.product-recently-purchased--animate-fade_up {
      animation-name: productRecentlyPurchasedFadeUp;
    }

    #{{ block_id }}.product-recently-purchased--animate-pulse {
      opacity: 1;
      animation-name: productRecentlyPurchasedPulse;
      animation-duration: 1800ms;
      animation-iteration-count: infinite;
    }

    @keyframes productRecentlyPurchasedFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productRecentlyPurchasedFadeUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productRecentlyPurchasedPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.015); }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-recently-purchased--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-recently-purchased--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-recently-purchased--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-recently-purchased__inner {
        grid-template-columns: auto minmax(0, 1fr);
        width: 100%;
      }

      #{{ block_id }}.product-recently-purchased--minimal .product-recently-purchased__inner,
      #{{ block_id }}.product-recently-purchased--inline_notice .product-recently-purchased__inner {
        width: 100%;
      }

      #{{ block_id }} .product-recently-purchased__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-recently-purchased__message {
        font-size: {{ block.settings.message_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-recently-purchased--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-recently-purchased__inner">
    {% if block.settings.show_icon %}
      <span class="product-recently-purchased__icon" aria-hidden="true">
        {{ block.settings.icon_text | escape }}
      </span>
    {% endif %}

    <div class="product-recently-purchased__content">
      {% if block.settings.heading != blank %}
        <p class="product-recently-purchased__heading">
          {{ block.settings.heading | escape }}
        </p>
      {% endif %}

      <p class="product-recently-purchased__message" data-product-recently-purchased-message>
        {{ message_text | escape }}
      </p>

      {% if block.settings.caption != blank %}
        <p class="product-recently-purchased__caption">
          {{ block.settings.caption | escape }}
        </p>
      {% endif %}
    </div>
  </div>

  {% if block.settings.randomize_messages %}
    <script type="application/json" data-product-recently-purchased-messages>
      [
        {{ block.settings.random_message_1 | json }},
        {{ block.settings.random_message_2 | json }},
        {{ block.settings.random_message_3 | json }},
        {{ block.settings.random_message_4 | json }},
        {{ block.settings.random_message_5 | json }}
      ]
    </script>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productRecentlyPurchasedReady === 'true') return;

        root.dataset.productRecentlyPurchasedReady = 'true';

        const messageNode = root.querySelector('[data-product-recently-purchased-message]');
        const messagesScript = root.querySelector('[data-product-recently-purchased-messages]');

        if (!messageNode || !messagesScript) return;

        try {
          const messages = JSON.parse(messagesScript.textContent || '[]')
            .filter((message) => typeof message === 'string' && message.trim().length > 0);

          if (!messages.length) return;

          const index = Math.floor(Math.random() * messages.length);
          messageNode.textContent = messages[index];
        } catch (error) {
          return;
        }
      })();
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "Recently purchased",
  "settings": [
    {
      "type": "header",
      "content": "Message"
    },
    {
      "type": "select",
      "id": "message_source",
      "label": "Message source",
      "default": "static",
      "options": [
        {
          "value": "static",
          "label": "Static merchant text"
        },
        {
          "value": "product_fallback",
          "label": "Product-specific fallback"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently purchased"
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "Static message",
      "default": "12 customers bought this recently."
    },
    {
      "type": "text",
      "id": "product_prefix",
      "label": "Product fallback prefix",
      "default": "Shoppers are currently viewing"
    },
    {
      "type": "text",
      "id": "product_suffix",
      "label": "Product fallback suffix",
      "default": "this week."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Merchant-controlled social proof message."
    },

    {
      "type": "header",
      "content": "Randomized merchant messages"
    },
    {
      "type": "checkbox",
      "id": "randomize_messages",
      "label": "Randomize merchant-provided messages",
      "default": false
    },
    {
      "type": "text",
      "id": "random_message_1",
      "label": "Random message 1",
      "default": "12 customers bought this recently."
    },
    {
      "type": "text",
      "id": "random_message_2",
      "label": "Random message 2",
      "default": "Recently purchased by shoppers in your area."
    },
    {
      "type": "text",
      "id": "random_message_3",
      "label": "Random message 3",
      "default": "Trending with customers this week."
    },
    {
      "type": "text",
      "id": "random_message_4",
      "label": "Random message 4",
      "default": "Popular pick with returning customers."
    },
    {
      "type": "text",
      "id": "random_message_5",
      "label": "Random message 5",
      "default": "Customers are adding this to their carts."
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "inline_notice",
      "options": [
        {
          "value": "inline_notice",
          "label": "Inline notice"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },

    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "text",
      "id": "icon_text",
      "label": "Icon text",
      "default": "✓"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "message_size",
      "label": "Message size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "message_size_mobile",
      "label": "Message size mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "caption_size",
      "label": "Caption size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#6f6f6f"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Activity dot color",
      "default": "#147a3f"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 4,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "pulse",
          "label": "Pulse"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recently Purchased",
      "settings": {
        "message_source": "static",
        "heading": "Recently purchased",
        "message_text": "12 customers bought this recently.",
        "product_prefix": "Shoppers are currently viewing",
        "product_suffix": "this week.",
        "caption": "Merchant-controlled social proof message.",
        "randomize_messages": false,
        "random_message_1": "12 customers bought this recently.",
        "random_message_2": "Recently purchased by shoppers in your area.",
        "random_message_3": "Trending with customers this week.",
        "random_message_4": "Popular pick with returning customers.",
        "random_message_5": "Customers are adding this to their carts.",
        "layout_style": "inline_notice",
        "show_icon": true,
        "icon_text": "✓",
        "icon_size": 38,
        "heading_size": 14,
        "heading_size_mobile": 14,
        "message_size": 15,
        "message_size_mobile": 14,
        "caption_size": 12,
        "heading_color": "#111111",
        "text_color": "#444444",
        "muted_color": "#6f6f6f",
        "background_color": "#ffffff",
        "card_background_color": "#f7f7f7",
        "border_color": "#e5e5e5",
        "icon_background_color": "#111111",
        "icon_color": "#ffffff",
        "accent_color": "#147a3f",
        "border_width": 1,
        "card_radius": 16,
        "width": "auto",
        "alignment": "left",
        "content_gap": 12,
        "card_padding": 12,
        "margin_top": 0,
