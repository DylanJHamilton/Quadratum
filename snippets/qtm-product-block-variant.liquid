{%- comment -%}One explicitly typed variant record; caller escapes the completed JSON script.{%- endcomment -%}
  {%- assign savings = variant.compare_at_price | minus: variant.price | at_least: 0 -%}
  {%- capture unit_text -%}{% if variant.unit_price and variant.unit_price_measurement %}{{ variant.unit_price | money | strip_html }}/{% if variant.unit_price_measurement.reference_value != 1 %}{{ variant.unit_price_measurement.reference_value }}{% endif %}{{ variant.unit_price_measurement.reference_unit }}{% endif %}{%- endcapture -%}
  {
    "id":{{ variant.id | json }},"title":{{ variant.title | json }},"sku":{{ variant.sku | json }},
    "options":[{% for value in variant.options %}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},
    "money":{{ variant.price | money | strip_html | json }},"compareMoney":{{ variant.compare_at_price | money | strip_html | json }},
    "savingsMoney":{{ savings | money | strip_html | json }},"unit":{{ unit_text | json }},
    "quantity_rule":{"min":{{ variant.quantity_rule.min | default: 1 | json }},"max":{{ variant.quantity_rule.max | json }},"increment":{{ variant.quantity_rule.increment | default: 1 | json }}},
    "allocations":[{% for allocation in variant.selling_plan_allocations %}
      {% assign plan_compare = allocation.compare_at_price | default: variant.price %}
      {% assign savings = plan_compare | minus: allocation.price | at_least: 0 %}
      {%- capture unit_text -%}{% if allocation.unit_price and variant.unit_price_measurement %}{{ allocation.unit_price | money | strip_html }}/{% if variant.unit_price_measurement.reference_value != 1 %}{{ variant.unit_price_measurement.reference_value }}{% endif %}{{ variant.unit_price_measurement.reference_unit }}{% endif %}{%- endcapture -%}
      {"id":{{ allocation.selling_plan.id | json }},"name":{{ allocation.selling_plan.name | json }},"price":{{ allocation.price | json }},"compare_at_price":{{ plan_compare | json }},"money":{{ allocation.price | money | strip_html | json }},"compareMoney":{{ plan_compare | money | strip_html | json }},"savingsMoney":{{ savings | money | strip_html | json }},"unit":{{ unit_text | json }}}{% unless forloop.last %},{% endunless %}
    {% endfor %}],
    {% assign variant_image = variant.featured_image | default: product.featured_image %}{% assign variant_image_width = image_width | default: 180 %}
    "image":{% if variant_image != blank %}{"src":{{ variant_image | image_url: width: variant_image_width | json }},"alt":{{ variant_image.alt | default: product.title | json }},"width":{{ variant_image.width | json }},"height":{{ variant_image.height | json }}}{% else %}null{% endif %},
    "featured_media":{"id":{{ variant.featured_media.id | json }}}
  }
