      }
    },
    "everreal_6": {
      "type": "interactive-content-helper-tabs-accordion",
      "settings": {
        "show_header": true,
        "heading": "About styling help.",
        "layout_mode": "accordion",
        "style_preset": "faq",
        "accordion_default_open": "all_closed",
        "use_custom_colors": true,
        "bg": "#F5F0FB",
        "text": "#202039",
        "muted": "#514E6E",
        "accent": "#7047BD",
        "border": "#E3DAF2",
        "subheading": ""
      },
      "blocks": {
        "er_1": {
          "type": "item",
          "settings": {
            "label": "Do I have to buy anything after a consult?",
            "content": "<p>No. The look plan is yours to keep, whether you order from it or not.</p>"
          }
        },
        "er_2": {
          "type": "item",
          "settings": {
            "label": "Can you tell me exactly how a costume fits?",
            "content": "<p>We share every fit note we have. Measured size charts are added as supplier samples are graded, and we say so when a measurement is not available yet.</p>"
          }
        },
        "er_3": {
          "type": "item",
          "settings": {
            "label": "How big does a group need to be?",
            "content": "<p>Four or more looks. Mixed characters and sizes are fine, and the quote lists every piece.</p>"
          }
        },
        "er_4": {
          "type": "item",
          "settings": {
            "label": "Can you match a character from a photo?",
            "content": "<p>We can suggest the closest looks in the range and the pieces that finish them. We do not make custom costumes.</p>"
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4"
      ]
    }
  },
  "order": [
