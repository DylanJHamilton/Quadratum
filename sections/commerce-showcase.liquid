{{ 'commerce-showcase.css' | asset_url | stylesheet_tag }}
{% assign card_heading = 'h3' %}{% if section.settings.heading_tag == 'h1' %}{% assign card_heading = 'h2' %}{% endif %}
<section class="q-lab" aria-labelledby="Lab-{{ section.id }}">
  <header class="q-lab__header"><p class="q-lab__eyebrow">{{ section.settings.eyebrow | escape }}</p><{{ section.settings.heading_tag }} id="Lab-{{ section.id }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}><div class="q-lab__intro rte">{{ section.settings.intro }}</div></header>
  <div class="q-lab__products">
    {% for block in section.blocks %}
      {% assign item = block.settings.product %}
      {% if item != blank %}
      <article class="q-lab__product" {{ block.shopify_attributes }}>
        <a class="q-lab__media" href="{{ item.url }}" aria-label="Explore {{ item.title | escape }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy' }}{% endif %}</a>
        <div class="q-lab__details"><p class="q-lab__eyebrow">{{ block.settings.category | escape }}</p><{{ card_heading }}>{{ item.title | escape }}</{{ card_heading }}><p>{{ block.settings.description | escape }}</p><p class="q-lab__price">{% if item.price_varies %}From {% endif %}{{ item.price | money }}{% unless item.available %}<span>Sold out</span>{% endunless %}</p>
        <p class="q-lab__caption">Same product. Four presentations.</p><nav class="q-lab__layouts" aria-label="Layouts for {{ item.title | escape }}"><a href="{{ item.url }}">Modern <span aria-hidden="true">↗</span></a><a href="{{ item.url }}?view=classic">Classic <span aria-hidden="true">↗</span></a><a href="{{ item.url }}?view=simple">Image-led <span aria-hidden="true">↗</span></a><a href="{{ item.url }}?view=compact">Compact <span aria-hidden="true">↗</span></a></nav></div>
      </article>
      {% elsif request.design_mode %}<p>Select a product for this showcase card.</p>{% endif %}
    {% endfor %}
  </div>
  <details class="q-lab__guide"><summary>What changes between layouts?</summary><div class="q-lab__guide-grid"><p><strong>Modern</strong><br>Gallery thumbnails and a flexible block-based product summary.</p><p><strong>Classic</strong><br>A familiar gallery and summary, with tabbed product information.</p><p><strong>Image-led</strong><br>A stacked gallery that gives photography more space.</p><p><strong>Compact</strong><br>A concise product presentation with the essentials close together.</p></div><p>Prices, options and availability come from the same Shopify product. Choose an available option on the product page before adding it to your bag.</p></details>
</section>
{% schema %}
{"name":"Commerce showcase","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"EXPLORE THE EXPERIENCE"},{"type":"text","id":"heading","label":"Heading","default":"Take a closer look."},{"type":"select","id":"heading_tag","label":"Heading level","default":"h2","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"}]},{"type":"richtext","id":"intro","label":"Introduction"}],"blocks":[{"type":"product","name":"Product example","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"category","label":"Category"},{"type":"textarea","id":"description","label":"Introduction"}]}],"max_blocks":4,"presets":[{"name":"Commerce showcase"}]}
{% endschema %}
