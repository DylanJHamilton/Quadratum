{% liquid
  assign block_id = block.id
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  if request.design_mode
    assign animation = 'none'
  endif
%}

{% assign has_intro = false %}
{% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}{% assign has_intro = true %}{% endif %}
{% if block.settings.cta_text != blank and block.settings.cta_url != blank %}{% assign has_intro = true %}{% endif %}
{% assign feature_count = 0 %}
{% capture features_markup %}
      <div class="qtm-feature-showcase__features" role="list">
        {% for i in (1..6) %}
          {% liquid
            assign enabled_key = 'feature_' | append: i | append: '_enabled'
            assign icon_key = 'feature_' | append: i | append: '_icon'
            assign heading_key = 'feature_' | append: i | append: '_heading'
            assign text_key = 'feature_' | append: i | append: '_text'
            assign link_key = 'feature_' | append: i | append: '_link'
            assign link_text_key = 'feature_' | append: i | append: '_link_text'

            assign feature_enabled = block.settings[enabled_key]
            assign feature_icon = block.settings[icon_key]
            assign feature_heading = block.settings[heading_key]
            assign feature_text = block.settings[text_key]
            assign feature_link = block.settings[link_key]
            assign feature_link_text = block.settings[link_text_key]
          %}

          {% assign populated = false %}
          {% if feature_heading != blank or feature_text != blank %}{% assign populated = true %}{% endif %}
          {% if feature_link != blank and feature_link_text != blank %}{% assign populated = true %}{% endif %}
          {% if feature_enabled and populated %}{% assign feature_count = feature_count | plus: 1 %}
            <article class="qtm-feature-showcase__feature qtm-feature-showcase__feature--{{ i }}{% if feature_icon == blank and block.settings.show_feature_numbers == false %} qtm-feature-showcase__feature--no-icon{% endif %}" role="listitem">
              {% if feature_icon != blank or block.settings.show_feature_numbers %}
                <div class="qtm-feature-showcase__feature-icon" aria-hidden="true">
                  {% if feature_icon != blank %}
                    {{ feature_icon | escape }}
                  {% else %}
                    {{ i }}
                  {% endif %}
                </div>
              {% endif %}

              <div class="qtm-feature-showcase__feature-copy">
                {% if feature_heading != blank %}
                  <h3 class="qtm-feature-showcase__feature-heading">
                    {{ feature_heading | escape }}
                  </h3>
                {% endif %}

                {% if feature_text != blank %}
                  <div class="qtm-feature-showcase__feature-text">
                    {{ feature_text }}
                  </div>
                {% endif %}

                {% if feature_link != blank and feature_link_text != blank %}
                  <a class="qtm-feature-showcase__feature-link" href="{{ feature_link | escape }}">
                    {{ feature_link_text | escape }}
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
{% endcapture %}
{% liquid
  assign has_media = false
  if block.settings.image != blank
    assign has_media = true
  endif
  if block.settings.media_type == 'video' and block.settings.video != blank
    assign has_media = true
  endif
  if block.settings.media_type == 'external_video' and block.settings.external_video_url != blank
    assign has_media = true
  endif
  assign has_copy = false
  if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank or feature_count > 0
    assign has_copy = true
  endif
  if block.settings.cta_text != blank and block.settings.cta_url != blank
    assign has_copy = true
  endif
  assign has_content = has_copy
  if has_media
    assign has_content = true
  endif
%}

<div
  {% if has_content == false and request.design_mode == false %}hidden{% endif %}
  class="
    qtm-feature-showcase
    qtm-feature-showcase-{{ block_id }}
    {% unless has_media %}qtm-feature-showcase--no-media{% endunless %}
    {% unless has_copy %}qtm-feature-showcase--no-copy{% endunless %}
    qtm-feature-showcase--width-{{ block_width }}
    qtm-feature-showcase--align-{{ block_alignment }}
    qtm-feature-showcase--layout-{{ block.settings.layout_style }}
    qtm-feature-showcase--media-position-{{ block.settings.media_position }}
    qtm-feature-showcase--animation-{{ animation }}
    {% if block.settings.enable_sticky_media %} qtm-feature-showcase--sticky-media{% endif %}
    {% if block.settings.enable_progressive_reveal and request.design_mode == false %} qtm-feature-showcase--progressive{% endif %}
    {% unless block.settings.show_desktop or request.design_mode %} qtm-feature-showcase--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet or request.design_mode %} qtm-feature-showcase--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile or request.design_mode %} qtm-feature-showcase--hide-mobile{% endunless %}
  "
  style="
    --qtm-feature-showcase-margin-top: {{ block.settings.margin_top }}px;
    --qtm-feature-showcase-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-feature-showcase-padding: {{ block.settings.padding }}px;
    --qtm-feature-showcase-gap: {{ block.settings.gap }}px;
    --qtm-feature-showcase-heading-color: {{ block.settings.heading_color }};
    --qtm-feature-showcase-text-color: {{ block.settings.text_color }};
    --qtm-feature-showcase-background-color: {{ block.settings.background_color }};
    --qtm-feature-showcase-border-color: {{ block.settings.border_color }};
    --qtm-feature-showcase-link-color: {{ block.settings.link_color }};
    --qtm-feature-showcase-card-background: {{ block.settings.card_background_color }};
    --qtm-feature-showcase-card-border: {{ block.settings.card_border_color }};
    --qtm-feature-showcase-accent-color: {{ block.settings.accent_color }};
    --qtm-feature-showcase-media-background: {{ block.settings.media_background_color }};
    --qtm-feature-showcase-border-width: {{ block.settings.border_width }}px;
    --qtm-feature-showcase-border-radius: {{ block.settings.border_radius }}px;
    --qtm-feature-showcase-card-radius: {{ block.settings.card_radius }}px;
    --qtm-feature-showcase-media-height: {{ block.settings.media_height }}px;
    --qtm-feature-showcase-mobile-media-height: {{ block.settings.mobile_media_height }}px;
  "
>
  <div class="qtm-feature-showcase__inner">
    {% if has_content == false and request.design_mode %}<p role="note">Add feature content or choose an image or video.</p>{% endif %}
    <div class="qtm-feature-showcase__content">
      {% if has_intro %}
        <div class="qtm-feature-showcase__header">
          {% if block.settings.eyebrow != blank %}
            <p class="qtm-feature-showcase__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="qtm-feature-showcase__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="qtm-feature-showcase__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
            <a class="qtm-feature-showcase__button" href="{{ block.settings.cta_url | escape }}">
              {{ block.settings.cta_text | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}

{% if feature_count > 0 %}{{ features_markup }}{% endif %}
    </div>

    <div class="qtm-feature-showcase__media-column"{% unless has_media or request.design_mode %} hidden{% endunless %}
      data-qtm-visual-block="video" data-autoplay="{{ block.settings.autoplay_video }}" data-controls="{{ block.settings.show_video_controls }}" data-design-mode="{{ request.design_mode }}">
      <div class="qtm-feature-showcase__media-frame">
        {% if block.settings.media_type == 'video' and block.settings.video != blank %}
          {{
            block.settings.video
            | video_tag:
              class: 'qtm-feature-showcase__video',
              image_size: '1600x',
              autoplay: false,
              loop: true,
              muted: true,
              controls: true, playsinline: true, preload: 'metadata'
          }}
          <button type="button" class="qtm-feature-showcase__video-toggle" data-qtm-video-toggle hidden>Play video</button>
        {% elsif block.settings.media_type == 'external_video' and block.settings.external_video_url != blank %}
          <a class="qtm-feature-showcase__external-video" href="{{ block.settings.external_video_url | escape }}" target="_blank" rel="noopener">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  class: 'qtm-feature-showcase__image',
                  loading: 'lazy',
                  widths: '375, 550, 750, 950, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  alt: block.settings.image.alt
              }}
            {% else %}
              <div class="qtm-feature-showcase__placeholder">
                {{ 'image' | placeholder_svg_tag: 'qtm-feature-showcase__placeholder-svg' }}
              </div>
            {% endif %}

            <span class="qtm-feature-showcase__play" aria-hidden="true">▶</span>
            <span class="visually-hidden">Open feature video</span>
          </a>
        {% elsif block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'qtm-feature-showcase__image',
              loading: 'lazy',
              widths: '375, 550, 750, 950, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: block.settings.image.alt
          }}
        {% else %}
          <div class="qtm-feature-showcase__placeholder">
            <p role="note">Add an image or video.</p>
          </div>
        {% endif %}

        {% if block.settings.media_badge != blank %}
          <div class="qtm-feature-showcase__media-badge">
            {{ block.settings.media_badge | escape }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.media_caption != blank %}
        <div class="qtm-feature-showcase__media-caption">
          {{ block.settings.media_caption }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-feature-showcase-{{ block_id }} {
    margin-top: var(--qtm-feature-showcase-margin-top);
    margin-bottom: var(--qtm-feature-showcase-margin-bottom);
    padding: min(var(--qtm-feature-showcase-padding), 12%);
    color: var(--qtm-feature-showcase-text-color);
    background: var(--qtm-feature-showcase-background-color);
    border: var(--qtm-feature-showcase-border-width) solid var(--qtm-feature-showcase-border-color);
    border-radius: var(--qtm-feature-showcase-border-radius);
  }

  .qtm-feature-showcase-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--width-auto {
    width: auto;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--width-small {
    max-width: 760px;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--width-medium {
    max-width: 980px;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--width-large {
    max-width: 1240px;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__inner {
    display: grid;
    gap: var(--qtm-feature-showcase-gap);
    align-items: start;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--layout-split .qtm-feature-showcase__inner,
  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--layout-immersive .qtm-feature-showcase__inner {
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--media-position-left .qtm-feature-showcase__media-column {
    order: -1;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--layout-stacked .qtm-feature-showcase__inner {
    grid-template-columns: 1fr;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__content {
    display: grid;
    gap: var(--qtm-feature-showcase-gap);
    align-content: start;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__header {
    display: grid;
    gap: 0.8rem;
    max-width: 760px;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-center .qtm-feature-showcase__header {
    margin-inline: auto;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-right .qtm-feature-showcase__header {
    margin-left: auto;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__eyebrow {
    margin: 0;
    color: var(--qtm-feature-showcase-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__heading {
    margin: 0;
    color: var(--qtm-feature-showcase-heading-color);
    line-height: 1.04;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__text,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-text,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-caption {
    color: var(--qtm-feature-showcase-text-color);
    line-height: 1.7;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__text p,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-text p,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-caption p {
    margin-top: 0;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__text p:last-child,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-text p:last-child,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-caption p:last-child {
    margin-bottom: 0;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.9rem;
    margin-top: 0.25rem;
    padding: 0.9rem 1.25rem;
    color: #ffffff;
    background: var(--qtm-feature-showcase-link-color);
    border: 1px solid var(--qtm-feature-showcase-link-color);
    border-radius: 999px;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-center .qtm-feature-showcase__button {
    justify-self: center;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--align-right .qtm-feature-showcase__button {
    justify-self: end;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__button:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__button:focus-visible,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-link:focus-visible,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__external-video:focus-visible {
    outline: 3px solid var(--qtm-feature-showcase-link-color);
    outline-offset: 4px;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__features {
    display: grid;
    gap: 1rem;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--layout-stacked .qtm-feature-showcase__features {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 1rem;
    color: var(--qtm-feature-showcase-text-color);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--qtm-feature-showcase-accent-color), transparent 92%),
        transparent 42%
      ),
      var(--qtm-feature-showcase-card-background);
    border: 1px solid var(--qtm-feature-showcase-card-border);
    border-radius: var(--qtm-feature-showcase-card-radius);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.045);
    text-align: left;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature {
    opacity: 1;
    transform: none;
    animation: qtm-feature-card-reveal-{{ block_id }} 620ms ease both;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature--1 {
    animation-delay: 60ms;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature--2 {
    animation-delay: 140ms;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature--3 {
    animation-delay: 220ms;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature--4 {
    animation-delay: 300ms;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature--5 {
    animation-delay: 380ms;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--progressive .qtm-feature-showcase__feature--6 {
    animation-delay: 460ms;
  }

  @keyframes qtm-feature-card-reveal-{{ block_id }} {
    from { opacity: 0; transform: translateY(16px); }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    color: #ffffff;
    background: var(--qtm-feature-showcase-accent-color);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 0.8rem 1.8rem color-mix(in srgb, var(--qtm-feature-showcase-accent-color), transparent 72%);
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-copy {
    display: grid;
    gap: 0.45rem;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-heading {
    margin: 0;
    color: var(--qtm-feature-showcase-heading-color);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.15;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-link {
    display: inline-flex;
    width: fit-content;
    margin-top: 0.2rem;
    color: var(--qtm-feature-showcase-link-color);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 180ms ease;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__feature-link:hover {
    opacity: 0.72;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-column {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .qtm-feature-showcase-{{ block_id }}.qtm-feature-showcase--sticky-media .qtm-feature-showcase__media-column {
    position: sticky;
    top: 2rem;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-frame {
    position: relative;
    overflow: hidden;
    min-height: var(--qtm-feature-showcase-media-height);
    background:
      radial-gradient(
        circle at 20% 10%,
        color-mix(in srgb, var(--qtm-feature-showcase-accent-color), transparent 82%),
        transparent 38%
      ),
      var(--qtm-feature-showcase-media-background);
    border: 1px solid color-mix(in srgb, var(--qtm-feature-showcase-border-color), transparent 8%);
    border-radius: calc(var(--qtm-feature-showcase-border-radius) * 0.82);
    box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.075);
    isolation: isolate;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__image,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__video,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__placeholder,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__external-video {
    display: block;
    width: 100%;
    min-height: var(--qtm-feature-showcase-media-height);
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__image,
  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__video {
    height: 100%;
    object-fit: cover;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__placeholder {
    display: grid;
    place-items: center;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.24;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__external-video {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    color: #111111;
    background: #ffffff;
    border-radius: 999px;
    font-size: 1.1rem;
    line-height: 1;
    transform: translate(-50%, -50%);
    box-shadow: 0 1rem 2.4rem rgba(0, 0, 0, 0.2);
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 4;
    display: inline-flex;
    max-width: calc(100% - 2rem);
    padding: 0.5rem 0.7rem;
    color: #ffffff;
    background: color-mix(in srgb, var(--qtm-feature-showcase-accent-color), #000000 18%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 0 0.75rem 1.8rem rgba(0, 0, 0, 0.16);
  }

  .qtm-feature-showcase-{{ block_id }} .qtm-feature-showcase__media-caption {
