{%- liquid
  assign popup_enabled = settings.popup_enable
  assign popup_editor_preview = settings.popup_editor_preview

  assign popup_should_render = false

  if popup_enabled
    assign popup_should_render = true
  endif

  if request.design_mode and popup_editor_preview
    assign popup_should_render = true
  endif

  assign popup_trigger = settings.popup_trigger | default: 'delay'
  assign popup_frequency = settings.popup_frequency | default: 'once_per_session'
  assign popup_delay = settings.popup_delay_seconds | default: 8
  assign popup_scroll = settings.popup_scroll_percent | default: 45
  assign popup_placement = settings.popup_placement | default: 'center'
  assign popup_animation = settings.popup_animation | default: 'fade'
  assign popup_style = settings.popup_style | default: 'editorial'
  assign popup_image_position = settings.popup_image_position | default: 'top'
-%}

{%- capture popup_primary_url -%}{%- render 'account-safe-link', url: settings.popup_button_url -%}{%- endcapture -%}
{%- capture popup_secondary_url -%}{%- render 'account-safe-link', url: settings.popup_secondary_url -%}{%- endcapture -%}
{%- if popup_should_render -%}
  <style>
    #QuadratumGlobalPopup,
    #QuadratumGlobalPopup *,
    #QuadratumGlobalPopup *::before,
    #QuadratumGlobalPopup *::after {
      box-sizing: border-box;
    }

    #QuadratumGlobalPopup {
      position: fixed !important;
      inset: 0 !important;
      z-index: 999999 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      margin: 0 !important;
      padding: 24px !important;
      opacity: 0;
      visibility: visible;
      pointer-events: none;
      overflow: hidden !important;
      background: transparent;
      transition: opacity 220ms ease;
    }

    #QuadratumGlobalPopup[hidden] {
      display: none !important;
    }

    #QuadratumGlobalPopup.is-visible {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }


    #QuadratumGlobalPopup .qtm-popup__overlay {
      position: absolute !important;
      inset: 0 !important;
      z-index: 1 !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: var(--popup-overlay) !important;
      opacity: var(--popup-overlay-opacity);
      cursor: pointer;
      appearance: none;
    }

    #QuadratumGlobalPopup .qtm-popup__dialog {
      position: relative !important;
      inset: auto !important;
      z-index: 2 !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      padding: 0;
      width: min(var(--popup-width), calc(100vw - 48px)) !important;
      max-width: var(--popup-width) !important;
      min-width: 0 !important;
      max-height: calc(100vh - 48px) !important;
      max-height: calc(100dvh - 48px) !important;
      margin: 0 !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      border: 1px solid var(--popup-border);
      border-radius: var(--popup-radius);
      background: var(--popup-bg);
      color: var(--popup-text);
      box-shadow:
        0 36px 110px rgba(0, 0, 0, 0.34),
        0 1px 0 rgba(255, 255, 255, 0.72) inset;
      transform: var(--popup-enter, none);
      transition: transform 220ms ease;
    }

    #QuadratumGlobalPopup.is-visible .qtm-popup__dialog {
      transform: translateY(0) scale(1);
    }

    #QuadratumGlobalPopup .qtm-popup__close {
      position: absolute !important;
      top: 14px !important;
      right: 14px !important;
      z-index: 5 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 44px !important;
      height: 44px !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 1px solid rgba(17, 17, 17, 0.1) !important;
      border-radius: 999px !important;
      background: var(--popup-bg) !important;
      color: var(--popup-text) !important;
      font-size: 22px !important;
      font-weight: 400 !important;
      line-height: 1 !important;
      cursor: pointer;
      appearance: none;
      backdrop-filter: blur(12px);
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14);
      transition:
        transform 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease;
    }

    #QuadratumGlobalPopup .qtm-popup__close:hover {
      background: var(--popup-bg) !important;
      transform: scale(1.04);
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.18);
    }

    #QuadratumGlobalPopup .qtm-popup__media {
      position: relative;
      width: 100%;
      height: 240px;
      min-height: 0;
      overflow: hidden;
      background: #f4f1eb;
    }

    #QuadratumGlobalPopup .qtm-popup__media::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(180deg, transparent 62%, rgba(0, 0, 0, 0.08)),
        radial-gradient(circle at 70% 20%, rgba(255,255,255,.2), transparent 34%);
    }

    #QuadratumGlobalPopup .qtm-popup__image {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      object-fit: cover !important;
      object-position: center !important;
    }

    #QuadratumGlobalPopup .qtm-popup__content {
      display: flex !important;
      flex-direction: column;
      gap: 16px;
      width: 100%;
      min-width: 0;
      padding: var(--popup-padding);
      padding-top: max(var(--popup-padding), 64px);
      overflow-wrap: anywhere;
      background: var(--popup-bg);
      color: var(--popup-text);
    }

    #QuadratumGlobalPopup .qtm-popup__eyebrow {
      margin: 0 0 -2px;
      color: var(--popup-text);
      font-size: 12px;
      font-weight: 850;
      line-height: 1.2;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #QuadratumGlobalPopup .qtm-popup__heading {
      margin: 0;
      max-width: 13ch;
      color: var(--popup-heading);
      font-size: clamp(32px, 5vw, 44px);
      font-weight: 850;
      line-height: 0.98;
      letter-spacing: -0.055em;
    }

    #QuadratumGlobalPopup .qtm-popup__text {
      margin: 0;
      max-width: 50ch;
      color: var(--popup-text);
      font-size: 15.5px;
      line-height: 1.6;
    }

    #QuadratumGlobalPopup .qtm-popup__text p {
      margin: 0;
    }

    #QuadratumGlobalPopup .qtm-popup__text p + p {
      margin-top: 10px;
    }

    #QuadratumGlobalPopup .qtm-popup__newsletter {
      display: grid;
      gap: 10px;
      margin: 4px 0 0;
    }

    #QuadratumGlobalPopup .qtm-popup__newsletter-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 6px;
      border: 1px solid var(--popup-border);
      border-radius: 999px;
      background: var(--popup-bg);
      box-shadow:
        0 14px 34px rgba(15, 23, 42, 0.08),
        0 1px 0 rgba(255,255,255,.9) inset;
    }

    #QuadratumGlobalPopup .qtm-popup__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    #QuadratumGlobalPopup .qtm-popup__input {
      width: 100%;
      min-width: 0;
      height: 44px;
      margin: 0;
      padding: 0 14px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--popup-text);
      font-size: 15px;
      line-height: 1;
      outline: none;
      box-shadow: none;
    }

    #QuadratumGlobalPopup .qtm-popup__input::placeholder {
      color: var(--popup-text);
      opacity: .75;
    }

    #QuadratumGlobalPopup .qtm-popup__submit {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      margin: 0;
      padding: 0 18px;
      border: 0;
      border-radius: 999px;
      background: var(--popup-button-bg);
      color: var(--popup-button-text);
      font-size: 14px;
      font-weight: 850;
      line-height: 1;
      cursor: pointer;
      white-space: normal;
      overflow-wrap: anywhere;
      appearance: none;
      transition:
        transform 180ms ease,
        background 180ms ease;
    }

    #QuadratumGlobalPopup .qtm-popup__submit:hover {
      background: var(--popup-button-bg);
      transform: translateY(-1px);
    }

    #QuadratumGlobalPopup .qtm-popup__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      width: 100%;
      margin-top: 4px;
    }

    #QuadratumGlobalPopup .qtm-popup__button {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      margin: 0;
      padding: 0 18px;
      border: 1px solid var(--popup-button-bg);
      border-radius: 999px;
      background: var(--popup-button-bg);
      color: var(--popup-button-text);
      font-size: 14px;
      font-weight: 850;
      line-height: 1;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
      white-space: normal;
      overflow-wrap: anywhere;
      appearance: none;
      transition:
        transform 180ms ease,
        background 180ms ease,
        color 180ms ease,
        border-color 180ms ease;
    }

    #QuadratumGlobalPopup .qtm-popup__button:hover {
      transform: translateY(-1px);
    }

    #QuadratumGlobalPopup .qtm-popup__button--secondary {
      border-color: rgba(17, 17, 17, 0.13);
      background: rgba(17, 17, 17, 0.045);
      color: var(--popup-text);
    }

    #QuadratumGlobalPopup .qtm-popup__button--secondary:hover {
      border-color: rgba(17, 17, 17, 0.22);
      background: rgba(17, 17, 17, 0.07);
    }

    #QuadratumGlobalPopup .qtm-popup__message {
      margin: 0;
      color: var(--popup-text);
      font-size: 14px;
      line-height: 1.4;
    }

    #QuadratumGlobalPopup .qtm-popup__message--success {
      color: var(--popup-text);
    }

    #QuadratumGlobalPopup.qtm-popup--style-minimal .qtm-popup__dialog {
      width: min(var(--popup-width), calc(100vw - 48px)) !important;
      max-width: var(--popup-width) !important;
    }

    #QuadratumGlobalPopup.qtm-popup--style-minimal .qtm-popup__media {
      display: none;
    }

    #QuadratumGlobalPopup.qtm-popup--style-minimal .qtm-popup__content {
      padding: var(--popup-padding);
      padding-top: max(var(--popup-padding), 64px);
    }

    #QuadratumGlobalPopup.qtm-popup--style-commerce .qtm-popup__heading {
      max-width: 15ch;
    }

    #QuadratumGlobalPopup.qtm-popup--style-commerce .qtm-popup__button,
    #QuadratumGlobalPopup.qtm-popup--style-commerce .qtm-popup__submit {
      background: var(--popup-button-bg);
      color: var(--popup-button-text);
    }

    #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__dialog,
    #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__dialog {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr) !important;
      width: min(var(--popup-width), calc(100vw - 48px)) !important;
      max-width: var(--popup-width) !important;
    }

    #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__media,
    #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__media {
      height: 100%;
      min-height: 280px;
    }

    #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__content,
    #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__content {
      padding: var(--popup-padding);
      padding-top: max(var(--popup-padding), 64px);
    }

    #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__media {
      order: 2;
    }

    #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__content {
      order: 1;
    }

    #QuadratumGlobalPopup.qtm-popup--image-hidden .qtm-popup__media {
      display: none;
    }

    #QuadratumGlobalPopup.qtm-popup--image-hidden .qtm-popup__dialog {
      width: min(var(--popup-width), calc(100vw - 48px)) !important;
      max-width: var(--popup-width) !important;
    }

    #QuadratumGlobalPopup.qtm-popup--image-hidden .qtm-popup__content {
      padding: var(--popup-padding);
      padding-top: max(var(--popup-padding), 64px);
    }

    html.qtm-popup-open,
    body.qtm-popup-open {
      overflow: hidden !important;
    }

    @media (max-width: 989px) {
      #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__dialog,
      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__dialog {
        grid-template-columns: 1fr !important;
        width: min(var(--popup-width), calc(100vw - 48px)) !important;
        max-width: var(--popup-width) !important;
      }

      #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__media,
      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__media {
        height: 240px;
        min-height: 0;
      }

      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__media,
      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__content {
        order: initial;
      }
    }

    @media (max-width: 749px) {
      #QuadratumGlobalPopup {
        padding: 14px !important;
      }

      #QuadratumGlobalPopup .qtm-popup__dialog,
      #QuadratumGlobalPopup.qtm-popup--style-minimal .qtm-popup__dialog,
      #QuadratumGlobalPopup.qtm-popup--style-commerce .qtm-popup__dialog,
      #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__dialog,
      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__dialog,
      #QuadratumGlobalPopup.qtm-popup--image-hidden .qtm-popup__dialog {
        width: calc(100vw - 28px) !important;
        max-width: calc(100vw - 28px) !important;
        max-height: calc(100vh - 28px) !important;
        max-height: calc(100dvh - 28px) !important;
        grid-template-columns: 1fr !important;
        border-radius: var(--popup-radius);
      }

      #QuadratumGlobalPopup .qtm-popup__media,
      #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__media,
      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__media {
        height: 220px;
        min-height: 0;
        max-height: 220px;
      }

      #QuadratumGlobalPopup .qtm-popup__content,
      #QuadratumGlobalPopup.qtm-popup--style-minimal .qtm-popup__content,
      #QuadratumGlobalPopup.qtm-popup--style-commerce .qtm-popup__content,
      #QuadratumGlobalPopup.qtm-popup--image-left .qtm-popup__content,
      #QuadratumGlobalPopup.qtm-popup--image-right .qtm-popup__content,
      #QuadratumGlobalPopup.qtm-popup--image-hidden .qtm-popup__content {
        padding: var(--popup-padding);
        padding-top: max(var(--popup-padding), 64px);
      }

      #QuadratumGlobalPopup .qtm-popup__heading {
        max-width: 13ch;
        font-size: clamp(30px, 8vw, 38px);
      }

      #QuadratumGlobalPopup .qtm-popup__text {
        max-width: none;
      }

      #QuadratumGlobalPopup .qtm-popup__newsletter-row {
        grid-template-columns: 1fr;
        padding: 8px;
        border-radius: 22px;
      }

      #QuadratumGlobalPopup .qtm-popup__submit {
        width: 100%;
      }

      #QuadratumGlobalPopup .qtm-popup__actions {
        display: grid;
        grid-template-columns: 1fr;
      }

      #QuadratumGlobalPopup .qtm-popup__button {
        width: 100%;
      }

      #QuadratumGlobalPopup .qtm-popup__close {
        top: 10px !important;
        right: 10px !important;
        width: 44px !important;
        height: 44px !important;
        font-size: 21px !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #QuadratumGlobalPopup,
      #QuadratumGlobalPopup .qtm-popup__dialog,
      #QuadratumGlobalPopup .qtm-popup__button,
      #QuadratumGlobalPopup .qtm-popup__submit,
      #QuadratumGlobalPopup .qtm-popup__close {
        transition-duration: 0.01ms !important;
      }
    }

    #QuadratumGlobalPopup.qtm-popup--style-minimal .qtm-popup__dialog,
    #QuadratumGlobalPopup .qtm-popup__dialog--no-image { grid-template-columns: minmax(0, 1fr) !important; }
    #QuadratumGlobalPopup.qtm-popup--top { align-items: flex-start !important; }
    #QuadratumGlobalPopup.qtm-popup--bottom { align-items: flex-end !important; }
    #QuadratumGlobalPopup.qtm-popup--bottom_right { align-items: flex-end !important; justify-content: flex-end !important; }
    #QuadratumGlobalPopup.qtm-popup--bottom_left { align-items: flex-end !important; justify-content: flex-start !important; }
    #QuadratumGlobalPopup.qtm-popup--right_drawer { padding: 0 !important; justify-content: flex-end !important; }
    #QuadratumGlobalPopup.qtm-popup--left_drawer { padding: 0 !important; justify-content: flex-start !important; }
    #QuadratumGlobalPopup.qtm-popup--right_drawer .qtm-popup__dialog,
    #QuadratumGlobalPopup.qtm-popup--left_drawer .qtm-popup__dialog { height: 100%; max-height: 100% !important; width: min(var(--popup-width), 100%) !important; }
    #QuadratumGlobalPopup.qtm-popup--fullscreen { padding: 0 !important; }
    #QuadratumGlobalPopup.qtm-popup--fullscreen .qtm-popup__dialog { width: 100% !important; max-width: none !important; height: 100%; max-height: 100% !important; border-radius: 0; }
    #QuadratumGlobalPopup.qtm-popup--slide_up { --popup-enter: translateY(32px); }
    #QuadratumGlobalPopup.qtm-popup--slide_down { --popup-enter: translateY(-32px); }
    #QuadratumGlobalPopup.qtm-popup--slide_left { --popup-enter: translateX(32px); }
    #QuadratumGlobalPopup.qtm-popup--slide_right { --popup-enter: translateX(-32px); }
    #QuadratumGlobalPopup.qtm-popup--zoom { --popup-enter: scale(.94); }
    #QuadratumGlobalPopup.qtm-popup--none, #QuadratumGlobalPopup.qtm-popup--none .qtm-popup__dialog { transition: none; }
    #QuadratumGlobalPopup :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    #QuadratumGlobalPopup .qtm-popup__input:focus-visible { outline: 2px solid var(--popup-text); outline-offset: -2px; }
    #QuadratumGlobalPopup .qtm-popup__confirmation { display: flex; gap: 10px; align-items: center; font-size: 14px; min-height: 44px; }
    #QuadratumGlobalPopup .qtm-popup__confirmation input { flex: 0 0 auto; width: 20px; height: 20px; }
    @media (prefers-reduced-motion: reduce) { #QuadratumGlobalPopup .qtm-popup__dialog { transform: none !important; } }
  </style>

  <div
    id="QuadratumGlobalPopup"
    class="
      qtm-popup
      qtm-popup--{{ popup_placement }}
      qtm-popup--{{ popup_animation }}
      qtm-popup--style-{{ popup_style }}
      qtm-popup--image-{{ popup_image_position }}
    "
    style="--popup-bg: {{ settings.popup_bg | default: '#ffffff' | escape }};
      --popup-text: {{ settings.popup_text_color | default: '#111111' | escape }};
      --popup-heading: {{ settings.popup_heading_color | default: '#111111' | escape }};
      --popup-border: {{ settings.popup_border_color | default: '#e5e7eb' | escape }};
      --popup-button-bg: {{ settings.popup_button_bg | default: '#111827' | escape }};
      --popup-button-text: {{ settings.popup_button_text | default: '#ffffff' | escape }};
      --popup-overlay: {{ settings.popup_overlay_color | default: '#000000' | escape }};
      --popup-overlay-opacity: {{ settings.popup_overlay_opacity | default: 48 | divided_by: 100.0 }};
      --popup-width: {{ settings.popup_width | default: 520 | at_least: 320 | at_most: 960 }}px;
      --popup-radius: {{ settings.popup_radius | default: 20 | at_least: 0 | at_most: 40 }}px;
      --popup-padding: {{ settings.popup_padding | default: 28 | at_least: 16 | at_most: 64 }}px;"
    data-qtm-popup
    data-popup-enabled="{{ settings.popup_enable }}"
    data-popup-trigger="{{ popup_trigger }}"
    data-popup-frequency="{{ popup_frequency }}"
    data-popup-delay="{{ popup_delay }}"
    data-popup-scroll="{{ popup_scroll }}"
    data-popup-mobile="{{ settings.popup_show_on_mobile }}"
    data-popup-desktop="{{ settings.popup_show_on_desktop }}"
    data-popup-overlay-close="{{ settings.popup_overlay_click_close }}"
    data-popup-editor-preview="{{ settings.popup_editor_preview }}"
    hidden inert
    aria-hidden="true"
  >
    <div class="qtm-popup__overlay" data-qtm-popup-overlay aria-hidden="true"></div>

    <div
      class="qtm-popup__dialog{% if settings.popup_image == blank %} qtm-popup__dialog--no-image{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="QuadratumGlobalPopupHeading"
      tabindex="-1"
      data-qtm-popup-dialog
    >
      <button class="qtm-popup__close" type="button" data-qtm-popup-close aria-label="Close popup">
        <span aria-hidden="true">&times;</span>
      </button>

      {%- unless popup_image_position == 'hidden' -%}
        {%- if settings.popup_image != blank -%}
          <div class="qtm-popup__media">
            <img
              class="qtm-popup__image"
              src="{{ settings.popup_image | image_url: width: 1400 }}"
              alt="{{ settings.popup_heading | escape }}"
              loading="lazy"
              width="{{ settings.popup_image.width }}"
              height="{{ settings.popup_image.height }}"
            >
          </div>
        {%- endif -%}
      {%- endunless -%}

      <div class="qtm-popup__content">
        {%- if settings.popup_eyebrow != blank -%}
          <p class="qtm-popup__eyebrow">{{ settings.popup_eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="QuadratumGlobalPopupHeading" class="qtm-popup__heading">
          {%- if settings.popup_heading != blank -%}
            {{ settings.popup_heading | escape }}
          {%- else -%}
            Join the list
          {%- endif -%}
        </h2>

        {%- if settings.popup_text != blank -%}
          <div class="qtm-popup__text">
            {{ settings.popup_text }}
          </div>
        {%- endif -%}

        {%- if settings.popup_show_newsletter_form -%}
          {% form 'customer', id: 'QuadratumPopupNewsletter', class: 'qtm-popup__newsletter', data-shopify-captcha: 'true' %}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">

            <div class="qtm-popup__newsletter-row">
              <label class="qtm-popup__label" for="QuadratumPopupEmail">
                Email address
              </label>

              <input
                id="QuadratumPopupEmail"
                class="qtm-popup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ settings.popup_newsletter_placeholder | default: 'Enter your email' | escape }}"
                aria-label="{{ settings.popup_newsletter_placeholder | default: 'Enter your email' | escape }}"
                {% if form.errors %}aria-invalid="true" aria-describedby="QuadratumPopupErrors"{% endif %}
                required
              >

              <button class="qtm-popup__submit" type="submit">
                {{ settings.popup_newsletter_button_label | default: 'Sign Up' | escape }}
              </button>
            </div>

            <label class="qtm-popup__confirmation" for="QuadratumPopupConfirmation">
              <input id="QuadratumPopupConfirmation" type="checkbox" name="contact[marketing_confirmation]" value="true" required>
              <span>I agree to receive marketing emails.</span>
            </label>
            {%- if form.posted_successfully? -%}
              <p class="qtm-popup__message qtm-popup__message--success" tabindex="-1" role="status" data-popup-feedback>
                Thanks for subscribing.
              </p>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="qtm-popup__message" id="QuadratumPopupErrors" role="alert" tabindex="-1" data-popup-feedback>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {% endform %}
        {%- endif -%}

        {%- if settings.popup_button_label != blank or settings.popup_secondary_label != blank -%}
          <div class="qtm-popup__actions">
            {%- if settings.popup_button_label != blank and popup_primary_url != blank -%}
              <a class="qtm-popup__button" href="{{ popup_primary_url | escape }}">
                {{ settings.popup_button_label | escape }}
              </a>
            {%- endif -%}

            {%- if settings.popup_secondary_label != blank -%}
              {%- if popup_secondary_url != blank -%}
                <a class="qtm-popup__button qtm-popup__button--secondary" href="{{ popup_secondary_url | escape }}">
                  {{ settings.popup_secondary_label | escape }}
                </a>
              {%- else -%}
                <button class="qtm-popup__button qtm-popup__button--secondary" type="button" data-qtm-popup-close>
                  {{ settings.popup_secondary_label | escape }}
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}