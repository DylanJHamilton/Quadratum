{%- liquid
  assign hosts = settings.preconnect_hosts | split: ','
  assign seen_origins = '|'
-%}
{%- for host in hosts limit: 16 -%}
  {%- liquid
    assign value = host | strip
    assign prefix = value | slice: 0, 8 | downcase
    assign authority = value | slice: 8, 2048 | split: '/' | first | split: '?' | first | split: '#' | first
    assign encoded = authority | url_encode | downcase
    assign valid = true
    if prefix != 'https://' or authority == blank or authority contains '@' or encoded contains '%' or authority contains ' '
      assign valid = false
    endif
    assign origin = 'https://' | append: authority
    assign token = '|' | append: origin | append: '|'
    if seen_origins contains token
      assign valid = false
    endif
  -%}
  {%- if valid -%}
    <link rel="preconnect" href="{{ origin | escape }}" crossorigin>
    {%- assign seen_origins = seen_origins | append: origin | append: '|' -%}
  {%- endif -%}
{%- endfor -%}
