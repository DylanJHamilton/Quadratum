        "source_consumers": [
          "<div id=\"{{ block_id }}-media-{{ media.id }}\" data-gallery-item data-media-id=\"{{ media.id }}\" role=\"group\" aria-label=\"{{ block.settings.go_to_slide_label | default: 'Media' | escape }} {{ i | plus: 1 }} / {{ media_count }}\" class=\"{% case gallery_mode %}{% when 'slider' %}product-gallery__slide{% when 'gallery' %}product-gallery__grid-item{% when 'masonry' %}product-gallery__masonry-item{% else %}product-gallery__horizontal-media{% endcase %}\">",
          "<button type=\"button\" class=\"product-gallery__thumbnail\" data-product-gallery-thumbnail data-index=\"{{ i }}\" data-media-id=\"{{ media.id }}\" aria-controls=\"{{ block_id }}-media-{{ media.id }}\" aria-label=\"{{ block.settings.go_to_slide_label | default: 'View media' | escape }} {{ i | plus: 1 }}\">",
          "{% if block.settings.show_dots and media_count > 1 %}<div hidden data-gallery-nav class=\"product-gallery__dots\" role=\"group\" aria-label=\"{{ block.settings.dots_label | default: 'Product media slides' | escape }}\">{% for i in (0..last_media_index) %}<button type=\"button\" class=\"product-gallery__dot\" data-product-gallery-dot data-index=\"{{ i }}\" aria-controls=\"{{ block_id }}-viewport\" aria-label=\"{{ block.settings.go_to_slide_label | default: 'View media' | escape }} {{ i | plus: 1 }}\"></button>{% endfor %}</div>{% endif %}"
        ]
