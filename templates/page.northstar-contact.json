        "title_size": "md",
        "title_weight": "semibold",
        "use_custom_colors": true,
        "section_bg": "#111821",
        "card_bg": "#111821",
        "border_color": "#253241",
        "tag_bg": "#080B10",
        "tag_text": "#9AA7B2",
        "radius_style": "lg"
      },
      "blocks": {
        "ns_0": {
          "type": "location",
          "settings": {
