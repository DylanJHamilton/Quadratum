{%- comment -%}Full-page search supports these three resource types. Collections use predictive search.{%- endcomment -%}
{%- liquid
  assign search_types = ''
  if settings.search_src_products != false
    assign search_types = search_types | append: ',product'
  endif
  if settings.search_src_articles != false
    assign search_types = search_types | append: ',article'
  endif
  if settings.search_src_pages != false
    assign search_types = search_types | append: ',page'
  endif
  echo search_types | remove_first: ','
-%}
