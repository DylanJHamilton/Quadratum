{% comment %}Demo overlay only. Never include in the merchant theme package.{% endcomment %}
{{ 'quadratum-demo-bar.css' | asset_url | stylesheet_tag }}
<aside class="quadratum-demo-bar" aria-label="Quadratum theme demo" data-demo-theme="__THEME_ID__">
  <a class="quadratum-demo-bar__back" href="https://quadratum-theme.myshopify.com/?preview_theme_id=__SHOWROOM_THEME_ID__" target="_self"><span aria-hidden="true">←</span> Back to Quadratum</a>
  <span class="quadratum-demo-bar__name">__DEMO_NAME__ <small>THEME DEMO</small></span>
  <div class="quadratum-demo-bar__purchase">__PURCHASE_ACTION__</div>
</aside>
<script src="{{ 'quadratum-demo-bar.js' | asset_url }}" data-demo-theme="__THEME_ID__" defer></script>
