{%- liquid
  assign block_id = 'product-countdown-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'cards'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-countdown
    product-countdown--{{ layout_style }}
    product-countdown--width-{{ block_width }}
    product-countdown--align-{{ alignment }}
    {% unless show_on_desktop %} product-countdown--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-countdown--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-countdown--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-countdown--animate product-countdown--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-countdown-margin-top: {{ block.settings.margin_top }}px;
    --product-countdown-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-countdown-padding: {{ block.settings.padding }}px;
    --product-countdown-gap: {{ block.settings.gap }}px;
    --product-countdown-card-padding: {{ block.settings.card_padding }}px;
    --product-countdown-border-width: {{ block.settings.border_width }}px;
    --product-countdown-border-radius: {{ block.settings.border_radius }}px;
    --product-countdown-heading-color: {{ block.settings.heading_color }};
    --product-countdown-text-color: {{ block.settings.text_color }};
    --product-countdown-background-color: {{ block.settings.background_color }};
    --product-countdown-card-background-color: {{ block.settings.card_background_color }};
    --product-countdown-border-color: {{ block.settings.border_color }};
    --product-countdown-link-color: {{ block.settings.link_color }};
    --product-countdown-number-background: {{ block.settings.number_background_color }};
    --product-countdown-number-text: {{ block.settings.number_text_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-countdown
  data-target-date="{{ block.settings.target_date | escape }}"
  data-target-time="{{ block.settings.target_time | escape }}"
  data-timezone-offset="{{ block.settings.timezone_offset | escape }}"
  data-expired-message="{{ block.settings.expired_message | escape }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-countdown-margin-top);
      margin-bottom: var(--product-countdown-margin-bottom);
      padding: var(--product-countdown-padding);
      color: var(--product-countdown-text-color);
      background: var(--product-countdown-background-color);
    }

    #{{ block_id }}.product-countdown--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-countdown--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-countdown--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-countdown--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-countdown--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-countdown--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-countdown--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-countdown--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-countdown__inner {
      display: grid;
      gap: var(--product-countdown-gap);
      width: 100%;
      min-width: 0;
      color: var(--product-countdown-text-color);
    }

    #{{ block_id }}.product-countdown--cards .product-countdown__inner,
    #{{ block_id }}.product-countdown--banner .product-countdown__inner {
      padding: var(--product-countdown-card-padding);
      background: var(--product-countdown-card-background-color);
      border: var(--product-countdown-border-width) solid var(--product-countdown-border-color);
      border-radius: var(--product-countdown-border-radius);
    }

    #{{ block_id }}.product-countdown--banner .product-countdown__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    #{{ block_id }}.product-countdown--minimal .product-countdown__inner {
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    #{{ block_id }} .product-countdown__content {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-countdown__eyebrow {
      margin: 0;
      color: var(--product-countdown-link-color);
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.78em;
    }

    #{{ block_id }} .product-countdown__heading {
      margin: 0;
      color: var(--product-countdown-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-countdown__text {
      color: var(--product-countdown-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-countdown__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-countdown__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-countdown__timer {
      display: grid;
      grid-template-columns: repeat(4, minmax(68px, 1fr));
      gap: 10px;
      min-width: 0;
    }

    #{{ block_id }}.product-countdown--align-center .product-countdown__timer {
      justify-content: center;
    }

    #{{ block_id }}.product-countdown--align-right .product-countdown__timer {
      justify-content: end;
    }

    #{{ block_id }} .product-countdown__unit {
      display: grid;
      gap: 4px;
      min-width: 0;
      padding: 12px 10px;
      text-align: center;
      color: var(--product-countdown-number-text);
      background: var(--product-countdown-number-background);
      border: var(--product-countdown-border-width) solid var(--product-countdown-border-color);
      border-radius: max(calc(var(--product-countdown-border-radius) - 6px), 0px);
    }

    #{{ block_id }} .product-countdown__number {
      display: block;
      color: var(--product-countdown-number-text);
      line-height: 1;
      font-size: clamp(1.35rem, 4vw, 2.25rem);
      font-variant-numeric: tabular-nums;
    }

    #{{ block_id }} .product-countdown__label {
      display: block;
      color: var(--product-countdown-number-text);
      line-height: 1.2;
      opacity: 0.78;
      font-size: 0.78em;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    #{{ block_id }} .product-countdown__expired {
      display: none;
      color: var(--product-countdown-heading-color);
      line-height: 1.45;
    }

    #{{ block_id }}.is-expired .product-countdown__timer {
      display: none;
    }

    #{{ block_id }}.is-expired .product-countdown__expired {
      display: block;
    }

    #{{ block_id }}.product-countdown--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-countdown--animate-fade {
      animation-name: productCountdownFade;
    }

    #{{ block_id }}.product-countdown--animate-fade_up {
      animation-name: productCountdownFadeUp;
    }

    #{{ block_id }}.product-countdown--animate-fade_down {
      animation-name: productCountdownFadeDown;
    }

    #{{ block_id }}.product-countdown--animate-fade_left {
      animation-name: productCountdownFadeLeft;
    }

    #{{ block_id }}.product-countdown--animate-fade_right {
      animation-name: productCountdownFadeRight;
    }

    #{{ block_id }}.product-countdown--animate-zoom {
      animation-name: productCountdownZoom;
    }

    @keyframes productCountdownFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productCountdownFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productCountdownFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productCountdownFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productCountdownFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productCountdownZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-countdown--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-countdown--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-countdown--banner .product-countdown__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-countdown__timer {
        max-width: 520px;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-countdown--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-countdown--cards .product-countdown__inner,
      #{{ block_id }}.product-countdown--banner .product-countdown__inner {
        padding: min(var(--product-countdown-card-padding), 22px);
      }

      #{{ block_id }}.product-countdown--banner .product-countdown__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-countdown__timer {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }} .product-countdown__unit {
        padding: 12px 8px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-countdown--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-countdown__inner">
    <div class="product-countdown__content">
      {% if block.settings.eyebrow != blank %}
        <p class="product-countdown__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h3 class="product-countdown__heading">
          {{ block.settings.heading | escape }}
        </h3>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="product-countdown__text">
          {{ block.settings.text }}
        </div>
      {% endif %}

      <div class="product-countdown__expired" data-product-countdown-expired>
        {{ block.settings.expired_message | escape }}
      </div>
    </div>

    <div
      class="product-countdown__timer"
      data-product-countdown-timer
      role="timer"
      aria-live="polite"
      aria-label="{{ block.settings.timer_aria_label | escape }}"
    >
      <div class="product-countdown__unit">
        <span class="product-countdown__number" data-product-countdown-days>00</span>
        <span class="product-countdown__label">{{ block.settings.days_label | escape }}</span>
      </div>

      <div class="product-countdown__unit">
        <span class="product-countdown__number" data-product-countdown-hours>00</span>
        <span class="product-countdown__label">{{ block.settings.hours_label | escape }}</span>
      </div>

      <div class="product-countdown__unit">
        <span class="product-countdown__number" data-product-countdown-minutes>00</span>
        <span class="product-countdown__label">{{ block.settings.minutes_label | escape }}</span>
      </div>

      <div class="product-countdown__unit">
        <span class="product-countdown__number" data-product-countdown-seconds>00</span>
        <span class="product-countdown__label">{{ block.settings.seconds_label | escape }}</span>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productCountdownReady === 'true') return;

      root.dataset.productCountdownReady = 'true';

      const targetDate = root.dataset.targetDate;
      const targetTime = root.dataset.targetTime || '23:59:59';
      const timezoneOffset = root.dataset.timezoneOffset || '+00:00';

      const daysEl = root.querySelector('[data-product-countdown-days]');
      const hoursEl = root.querySelector('[data-product-countdown-hours]');
      const minutesEl = root.querySelector('[data-product-countdown-minutes]');
      const secondsEl = root.querySelector('[data-product-countdown-seconds]');

      if (!targetDate || !daysEl || !hoursEl || !minutesEl || !secondsEl) {
        root.classList.add('is-expired');
        return;
      }

      const normalizeTime = (time) => {
        if (/^\d{2}:\d{2}$/.test(time)) return `${time}:00`;
        if (/^\d{2}:\d{2}:\d{2}$/.test(time)) return time;
        return '23:59:59';
      };

      const parseTarget = () => {
        const safeTime = normalizeTime(targetTime);
        const isoString = `${targetDate}T${safeTime}${timezoneOffset}`;
        const date = new Date(isoString);

        if (Number.isNaN(date.getTime())) {
          return null;
        }

        return date;
      };

      const target = parseTarget();

      if (!target) {
        root.classList.add('is-expired');
        return;
      }

      const pad = (value) => String(value).padStart(2, '0');

      const update = () => {
        const now = new Date();
        const difference = target.getTime() - now.getTime();

        if (difference <= 0) {
          daysEl.textContent = '00';
          hoursEl.textContent = '00';
          minutesEl.textContent = '00';
          secondsEl.textContent = '00';
          root.classList.add('is-expired');
          window.clearInterval(timer);
          return;
        }

        const totalSeconds = Math.floor(difference / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        daysEl.textContent = pad(days);
        hoursEl.textContent = pad(hours);
        minutesEl.textContent = pad(minutes);
        secondsEl.textContent = pad(seconds);
      };

      const timer = window.setInterval(update, 1000);

      update();

      document.addEventListener('shopify:section:unload', () => {
        window.clearInterval(timer);
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product countdown",
  "settings": [
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Offer ends soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Create urgency for a sale, launch, limited offer, or product promotion.</p>"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target date",
      "info": "Use YYYY-MM-DD format.",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "target_time",
      "label": "Target time",
      "info": "Use 24-hour HH:MM or HH:MM:SS format.",
      "default": "23:59:59"
    },
    {
