{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation

  assign separator = block.settings.separator_text

  if block.settings.separator_style == 'slash'
    assign separator = '/'
  elsif block.settings.separator_style == 'chevron'
    assign separator = '›'
  elsif block.settings.separator_style == 'dot'
    assign separator = '•'
  elsif block.settings.separator_style == 'arrow'
    assign separator = '→'
  endif
%}

<nav
  class="
    qtm-breadcrumbs
    qtm-breadcrumbs-{{ block_id }}
    qtm-breadcrumbs--width-{{ block_width }}
    qtm-breadcrumbs--align-{{ block_alignment }}
    qtm-breadcrumbs--layout-{{ block.settings.layout_style }}
    qtm-breadcrumbs--separator-{{ block.settings.separator_style }}
    qtm-breadcrumbs--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-breadcrumbs--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-breadcrumbs--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-breadcrumbs--hide-mobile{% endunless %}
  "
  style="
    --qtm-breadcrumbs-margin-top: {{ block.settings.margin_top }}px;
    --qtm-breadcrumbs-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-breadcrumbs-padding: {{ block.settings.padding }}px;
    --qtm-breadcrumbs-gap: {{ block.settings.gap }}px;
    --qtm-breadcrumbs-heading-color: {{ block.settings.heading_color }};
    --qtm-breadcrumbs-text-color: {{ block.settings.text_color }};
    --qtm-breadcrumbs-background-color: {{ block.settings.background_color }};
    --qtm-breadcrumbs-item-background: {{ block.settings.item_background_color }};
    --qtm-breadcrumbs-border-color: {{ block.settings.border_color }};
    --qtm-breadcrumbs-link-color: {{ block.settings.link_color }};
    --qtm-breadcrumbs-current-color: {{ block.settings.current_color }};
    --qtm-breadcrumbs-border-width: {{ block.settings.border_width }}px;
    --qtm-breadcrumbs-border-radius: {{ block.settings.border_radius }}px;
  "
  aria-label="{{ block.settings.nav_label | escape }}"
  {{ block.shopify_attributes }}
>
  <ol class="qtm-breadcrumbs__list" role="list">
    {% if block.settings.show_home %}
      <li class="qtm-breadcrumbs__item">
        <a class="qtm-breadcrumbs__link" href="{{ routes.root_url }}">
          {{ block.settings.home_label | escape }}
        </a>
      </li>
    {% endif %}

    {% if block.settings.show_home %}
      {% unless request.page_type == 'index' %}
        <li class="qtm-breadcrumbs__separator" aria-hidden="true">
          {{ separator | escape }}
        </li>
      {% endunless %}
    {% endif %}

    {% case request.page_type %}
      {% when 'product' %}
        {% if collection and block.settings.show_collection %}
          <li class="qtm-breadcrumbs__item">
            <a class="qtm-breadcrumbs__link" href="{{ collection.url }}">
              {{ collection.title | escape }}
            </a>
          </li>

          <li class="qtm-breadcrumbs__separator" aria-hidden="true">
            {{ separator | escape }}
          </li>
        {% endif %}

        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ product.title | escape }}
          </span>
        </li>

      {% when 'collection' %}
        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ collection.title | escape }}
          </span>
        </li>

      {% when 'page' %}
        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ page.title | escape }}
          </span>
        </li>

      {% when 'blog' %}
        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ blog.title | escape }}
          </span>
        </li>

      {% when 'article' %}
        {% if blog and block.settings.show_blog %}
          <li class="qtm-breadcrumbs__item">
            <a class="qtm-breadcrumbs__link" href="{{ blog.url }}">
              {{ blog.title | escape }}
            </a>
          </li>

          <li class="qtm-breadcrumbs__separator" aria-hidden="true">
            {{ separator | escape }}
          </li>
        {% endif %}

        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ article.title | escape }}
          </span>
        </li>

      {% when 'cart' %}
        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ block.settings.cart_label | escape }}
          </span>
        </li>

      {% when 'search' %}
        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ block.settings.search_label | escape }}
          </span>
        </li>

      {% when 'customers/account' %}
        <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
          <span class="qtm-breadcrumbs__current">
            {{ block.settings.account_label | escape }}
          </span>
        </li>

      {% else %}
        {% if template.name != 'index' %}
          <li class="qtm-breadcrumbs__item qtm-breadcrumbs__item--current" aria-current="page">
            <span class="qtm-breadcrumbs__current">
              {{ page_title | escape }}
            </span>
          </li>
        {% endif %}
    {% endcase %}
  </ol>
</nav>

<style>
  .qtm-breadcrumbs-{{ block_id }} {
    margin-top: var(--qtm-breadcrumbs-margin-top);
    margin-bottom: var(--qtm-breadcrumbs-margin-bottom);
    padding: var(--qtm-breadcrumbs-padding);
    color: var(--qtm-breadcrumbs-text-color);
    background: var(--qtm-breadcrumbs-background-color);
    border: var(--qtm-breadcrumbs-border-width) solid var(--qtm-breadcrumbs-border-color);
    border-radius: var(--qtm-breadcrumbs-border-radius);
  }

  .qtm-breadcrumbs-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--width-auto {
    width: auto;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--width-small {
    max-width: 640px;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--width-medium {
    max-width: 860px;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--width-large {
    max-width: 1120px;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--qtm-breadcrumbs-gap) * 0.5);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--align-center .qtm-breadcrumbs__list {
    justify-content: center;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--align-right .qtm-breadcrumbs__list {
    justify-content: flex-end;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__item,
  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__separator {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    color: var(--qtm-breadcrumbs-text-color);
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.25;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__separator {
    color: color-mix(in srgb, var(--qtm-breadcrumbs-text-color), transparent 42%);
    user-select: none;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__link,
  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__current {
    display: inline-flex;
    align-items: center;
    min-height: {{ block.settings.item_height }}px;
    max-width: {{ block.settings.max_item_width }}px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__link {
    color: var(--qtm-breadcrumbs-link-color);
    text-decoration: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__link:hover {
    opacity: 0.74;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__link:focus-visible {
    outline: 3px solid var(--qtm-breadcrumbs-link-color);
    outline-offset: 4px;
  }

  .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__current {
    color: var(--qtm-breadcrumbs-current-color);
    font-weight: 750;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-pills .qtm-breadcrumbs__link,
  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-pills .qtm-breadcrumbs__current {
    padding: 0.45rem 0.75rem;
    background: var(--qtm-breadcrumbs-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-breadcrumbs-border-color), transparent 10%);
    border-radius: 999px;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-pills .qtm-breadcrumbs__current {
    background: color-mix(in srgb, var(--qtm-breadcrumbs-link-color), transparent 92%);
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-minimal .qtm-breadcrumbs__link,
  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-minimal .qtm-breadcrumbs__current {
    min-height: auto;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-chevrons .qtm-breadcrumbs__separator,
  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--layout-slash .qtm-breadcrumbs__separator {
    font-weight: 700;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--animation-fade {
    animation: qtm-breadcrumbs-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--animation-fade-up {
    animation: qtm-breadcrumbs-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--animation-fade-down {
    animation: qtm-breadcrumbs-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--animation-fade-left {
    animation: qtm-breadcrumbs-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--animation-fade-right {
    animation: qtm-breadcrumbs-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--animation-zoom {
    animation: qtm-breadcrumbs-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-breadcrumbs-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-breadcrumbs-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-breadcrumbs-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-breadcrumbs-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-breadcrumbs-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-breadcrumbs-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--hide-tablet {
      display: none !important;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-breadcrumbs-{{ block_id }} {
      padding: min(var(--qtm-breadcrumbs-padding), 20px);
    }

    .qtm-breadcrumbs-{{ block_id }}.qtm-breadcrumbs--hide-mobile {
      display: none !important;
    }

    .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__list {
      gap: max(6px, calc(var(--qtm-breadcrumbs-gap) * 0.32));
    }

    .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__item,
    .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__separator {
      font-size: min({{ block.settings.text_size }}px, 13px);
    }

    .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__link,
    .qtm-breadcrumbs-{{ block_id }} .qtm-breadcrumbs__current {
      max-width: min({{ block.settings.max_item_width }}px, 180px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-breadcrumbs-{{ block_id }},
    .qtm-breadcrumbs-{{ block_id }} *,
    .qtm-breadcrumbs-{{ block_id }} *::before,
    .qtm-breadcrumbs-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Breadcrumbs",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb content"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation label",
      "default": "Breadcrumb navigation"
    },
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Show home link",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_collection",
      "label": "Show collection on product pages when available",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_blog",
      "label": "Show blog on article pages",
      "default": true
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Account"
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator style",
      "default": "chevron",
      "options": [
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "slash",
          "label": "Slash"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Custom separator",
      "default": "›"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_height",
      "label": "Item height",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "max_item_width",
      "label": "Maximum item width",
      "min": 120,
      "max": 520,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "minimal",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "slash",
          "label": "Slash"
        },
        {
          "value": "chevrons",
          "label": "Chevrons"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6A6A6A"
    },
    {
      "type": "color",
      "id": "current_color",
      "label": "Current page color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "item_background_color",
      "label": "Item background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E5E5E5"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade-up",
          "label": "Fade up"
        },
        {
          "value": "fade-down",
          "label": "Fade down"
        },
        {
          "value": "fade-left",
          "label": "Fade left"
        },
        {
          "value": "fade-right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Basic Breadcrumbs",
