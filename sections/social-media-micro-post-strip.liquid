{%- comment -%}
  sections/social-media-micro-post-strip.liquid
  Quadratum — Social media · Micro-post highlight strip (X / Bluesky) (manual, Link-ready)
{%- endcomment -%}

{% liquid
 assign count = 0
 for block in section.blocks
   if block.settings.post_text != blank
     assign count = count | plus: 1
   elsif block.settings.post_url != blank and block.settings.post_url != '#' and block.settings.post_url != 'none'
     assign count = count | plus: 1
   endif
 endfor
 assign visible = false
 if section.settings.enable_section and section.settings.data_source_mode == 'manual' and count > 0
   assign visible = true
 endif
 if request.design_mode
   assign visible = true
 endif
%}
{% if visible %}
  {%- liquid
    assign s = section.settings
    assign layout_style = s.layout_style | default: 'strip'
    assign bg_style = s.background_style | default: 'default'
    assign data_source_mode = s.data_source_mode | default: 'manual'
  -%}

  <section
    id="social-media-micro-post-strip-{{ section.id }}"
    class="q-section q-social-micro-post-strip q-section--bg-{{ bg_style }}"
    aria-label="{{ s.aria_label | escape }}"
  >
    <div class="q-section__inner">{% if request.design_mode and s.enable_section == false %}<p>Section disabled on the storefront.</p>{% endif %}

      <header class="q-section__heading">
        {%- if s.kicker != blank -%}
          <p class="q-section__kicker">{{ s.kicker | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="q-section__title">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.body != blank -%}
          <div class="q-section__body">
            {{ s.body | escape | newline_to_br }}
          </div>
        {%- endif -%}
      </header>

      <div
        class="q-micro-post-strip q-micro-post-strip--{{ layout_style }}"
        tabindex="0" role="region" aria-label="{{ s.aria_label | default: 'Micro-posts' | escape }}"
        style="--q-micro-post-cols-desktop: {{ s.max_columns_desktop | default: 3 }};"
      >
        {%- if data_source_mode == 'manual' -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- render 'q-social-micro-post-card',
                block: block,
                section_settings: s
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- if request.design_mode -%}
              <div class="q-micro-post-strip__placeholder" role="status" aria-live="polite">
                <p>Add up to 8 “Micro-post” blocks to populate this strip.</p>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          {%- if request.design_mode -%}
            <div class="q-micro-post-strip__placeholder" role="status" aria-live="polite">
              <p>Timeline ID <strong>{{ s.timeline_id | escape }}</strong> is metadata only. The theme does not fetch posts. Use manual blocks or configure an external integration.</p>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

    </div>
  </section>
{%- endif -%}
<style>

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card {
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__platform {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.08);
    line-height: 1;
    white-space: normal;
    flex: 0 0 auto;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__platform-icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__platform-label {
    font-size: 0.9em;
    opacity: 0.85;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__identity {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: end;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__display-name {
    font-weight: 600;
    line-height: 1.2;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__handle {
    opacity: 0.75;
    font-size: 0.92em;
    line-height: 1.2;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__text {
    margin: 0;
    line-height: 1.45;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__timestamp {
    opacity: 0.75;
    font-size: 0.9em;
  }

  #social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__link {
    white-space: normal;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }



  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip {
    margin-top: 16px;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip--strip {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip--grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 750px) {
    #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip--grid {
      grid-template-columns: repeat(var(--q-micro-post-cols-desktop, 3), minmax(0, 1fr));
    }
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip__placeholder {
    padding: 16px;
    border: 1px dashed rgba(0, 0, 0, 0.2);
    border-radius: 12px;
  }
  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip__placeholder p { margin: 0; }

  /* Card layout only — colors handled by theme tokens / q-card */
  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card {
    min-width:0;
  }
  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-strip--grid .q-micro-post-card {
    min-width: 0;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__platform {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: normal;
    font-size: 0.9em;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__platform svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__identity {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__display-name {
    font-weight: 600;
    line-height: 1.2;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__handle {
    font-size: 0.92em;
    opacity: 0.8;
    line-height: 1.2;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__text {
    margin: 0;
    line-height: 1.45;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__timestamp {
    font-size: 0.9em;
    opacity: 0.8;
  }

  #social-media-micro-post-strip-{{ section.id }}.q-social-micro-post-strip .q-micro-post-card__link {
    font-size: 0.95em;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: normal;
  }


#social-media-micro-post-strip-{{ section.id }}{color:var(--c-text,#111111);font-family:var(--font-body);overflow-wrap:anywhere;min-width:0;max-width:100%}
#social-media-micro-post-strip-{{ section.id }} *,#social-media-micro-post-strip-{{ section.id }} *::before,#social-media-micro-post-strip-{{ section.id }} *::after{box-sizing:border-box;min-width:0}
#social-media-micro-post-strip-{{ section.id }} :is(h2,h3){font-family:var(--font-head)}
#social-media-micro-post-strip-{{ section.id }} :is(a,button,[tabindex]):focus-visible{outline:2px solid currentColor;outline-offset:3px}
#social-media-micro-post-strip-{{ section.id }} :is(a,button){max-width:100%;overflow-wrap:anywhere}
#social-media-micro-post-strip-{{ section.id }} [hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){#social-media-micro-post-strip-{{ section.id }} *,#social-media-micro-post-strip-{{ section.id }} *::before,#social-media-micro-post-strip-{{ section.id }} *::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}

#social-media-micro-post-strip-{{ section.id }} .q-section__inner{max-width:var(--container-lg,1152px);margin-inline:auto;padding-inline:20px}
#social-media-micro-post-strip-{{ section.id }}.q-section--bg-default{background:var(--c-bg,#fff)}
#social-media-micro-post-strip-{{ section.id }}.q-section--bg-contrast{background:var(--c-surface,#f6f7f8)}
#social-media-micro-post-strip-{{ section.id }}.q-section--bg-soft{background:color-mix(in srgb,var(--c-primary,#2563eb) 8%,var(--c-bg,#fff))}
#social-media-micro-post-strip-{{ section.id }} .q-micro-post-card{background:var(--c-bg,#fff);color:var(--c-text,#111);max-width:100%;border-color:currentColor}
#social-media-micro-post-strip-{{ section.id }} .q-micro-post-strip--strip .q-micro-post-card{flex:0 0 min(85%,360px)}
#social-media-micro-post-strip-{{ section.id }} .q-micro-post-strip{padding:4px;max-width:100%}
#social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__header,#social-media-micro-post-strip-{{ section.id }} .q-micro-post-card__footer{flex-wrap:wrap}

@media(min-width:750px){#social-media-micro-post-strip-{{ section.id }} .q-micro-post-strip--strip .q-micro-post-card{flex-basis:calc((100% - 16px * (var(--q-micro-post-cols-desktop,3) - 1)) / var(--q-micro-post-cols-desktop,3))}}
</style>

{% schema %}
{
  "name": "Social media - Micro Post",
  "tag": "section",
  "class": "q-host-social-media-micro-post-strip",
  "settings": [
    {
      "type": "paragraph",
      "content": "Manual highlights only; names, handles and timestamps are merchant text, not live or verified posts. Timeline mode requires a separately implemented provider/app integration."
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "From our socials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent highlights from X and Bluesky"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "strip",
      "options": [
        {
          "value": "strip",
          "label": "Horizontal strip (scroll on mobile)"
        },
        {
          "value": "grid",
          "label": "Grid (wrap to multiple rows)"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_columns_desktop",
      "label": "Max columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "contrast",
          "label": "Contrast surface"
        },
        {
          "value": "soft",
          "label": "Soft tint"
        }
      ]
    },
    {
      "type": "header",
      "content": "Micro-post chrome"
    },
    {
      "type": "checkbox",
      "id": "show_platform_badge",
      "label": "Show platform badge (icon + label)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_handle",
      "label": "Show handle",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_timestamp",
      "label": "Show timestamp text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_links_in_new_tab",
      "label": "Open micro-post links in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Data source"
    },
    {
      "type": "select",
      "id": "data_source_mode",
      "label": "Data source mode",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "Manual micro-posts (theme editor)"
        },
        {
          "value": "timeline",
          "label": "External timeline (integration required)"
        }
      ]
    },
    {
      "type": "text",
      "id": "timeline_id",
      "label": "Timeline ID (metadata only)"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "ARIA label for section",
      "default": "Micro-post highlight strip from X and Bluesky"
    }
  ],
  "blocks": [
    {
      "type": "micro_post",
      "name": "Micro-post",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "default": "x",
          "options": [
            {
              "value": "x",
              "label": "X (Twitter)"
            },
            {
              "value": "bluesky",
              "label": "Bluesky"
            }
          ]
        },
        {
          "type": "text",
          "id": "display_name",
          "label": "Display name"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle"
        },
        {
          "type": "textarea",
          "id": "post_text",
          "label": "Post text"
        },
        {
          "type": "text",
          "id": "timestamp",
          "label": "Timestamp / meta"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Original post URL (optional)"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View post"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Social media - Micro Post Highlight Strip (X / Bluesky)",
      "category": "Social Media",
      "blocks": [
        {
          "type": "micro_post"
        },
        {
          "type": "micro_post"
        },
        {
          "type": "micro_post"
        }
      ]
    }
  ]
}
{% endschema %}
