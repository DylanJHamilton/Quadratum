{% liquid
  assign main_menu = linklists[settings.desktop_menu]
  assign announce_text = settings.header_announce_text | default: settings.announcement_text
  assign header_search_mode = section.settings.search_display | default: 'none'
  assign header_search_action = section.settings.search_button_action | default: 'popup'
  assign header_search_placeholder = section.settings.search_placeholder | default: settings.search_placeholder

  assign header_width = section.settings.header_width | default: 'full_width'
  assign header_layout = section.settings.header_layout | default: 'logo_left'
  assign sticky_mode = section.settings.sticky_mode | default: 'inherit_global'
  assign mobile_menu_style = section.settings.mobile_menu_style | default: 'dropdown'

  assign sticky_enabled = false
  assign sticky_shadow_enabled = false

  if sticky_mode == 'inherit_global' and settings.header_sticky
    assign sticky_enabled = true
  elsif sticky_mode == 'sticky'
    assign sticky_enabled = true
  elsif sticky_mode == 'sticky_shadow'
    assign sticky_enabled = true
    assign sticky_shadow_enabled = true
  endif
%}

{% if settings.header_announce_enable and announce_text != blank %}
  <div id="HeaderOneAnnounce-{{ section.id }}" class="q-h1a q-h1a--align-{{ section.settings.announcement_alignment | default: 'center' }}">
    <div class="q-h1a__inner">
      <p class="q-h1a__text">
        <span>{{ announce_text }}</span>
        {% if section.settings.announcement_link_url != blank and section.settings.announcement_link_label != blank %}
          <a class="q-h1a__link" href="{{ section.settings.announcement_link_url }}">
            {{ section.settings.announcement_link_label }}
          </a>
        {% endif %}
      </p>
    </div>
  </div>
{% endif %}

<header
  id="HeaderOne-{{ section.id }}"
  class="q-header-one q-header-one--width-{{ header_width }} q-header-one--layout-{{ header_layout }} q-header-one--mobile-{{ mobile_menu_style }}{% if sticky_enabled %} q-header-one--sticky{% endif %}{% if sticky_shadow_enabled %} q-header-one--sticky-shadow{% endif %}{% if section.settings.icon_button_shadow %} q-header-one--icon-shadow{% endif %}"
  aria-label="Site header"
>
  <style>
    html, body{
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }}{
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      max-width: none !important;
    }

    #HeaderOneAnnounce-{{ section.id }}{
      --qh1-announce-bg: {{ section.settings.announce_bg }};
      --qh1-announce-text: {{ section.settings.announce_text }};
      --qh1-border: {{ section.settings.border_color }};
      --qh1-announce-font-size: {{ section.settings.announcement_font_size }}px;
      width: 100%;
      margin: 0;
      padding: 0;
      background: var(--qh1-announce-bg) !important;
      color: var(--qh1-announce-text) !important;
      border-bottom: 1px solid var(--qh1-border);
    }

    #HeaderOneAnnounce-{{ section.id }} .q-h1a__inner{
      width: 100%;
      max-width: 1440px;
      margin: 0 auto;
      padding: 10px 20px;
      color: var(--qh1-announce-text) !important;
    }

    #HeaderOneAnnounce-{{ section.id }}.q-h1a--align-left .q-h1a__inner{
      text-align: left;
    }

    #HeaderOneAnnounce-{{ section.id }}.q-h1a--align-center .q-h1a__inner{
      text-align: center;
    }

    #HeaderOneAnnounce-{{ section.id }}.q-h1a--align-right .q-h1a__inner{
      text-align: right;
    }

    #HeaderOneAnnounce-{{ section.id }} .q-h1a__text,
    #HeaderOneAnnounce-{{ section.id }} p,
    #HeaderOneAnnounce-{{ section.id }} span,
    #HeaderOneAnnounce-{{ section.id }} a{
      margin: 0;
      font-size: var(--qh1-announce-font-size);
      line-height: 1.35;
      color: var(--qh1-announce-text) !important;
    }

    #HeaderOneAnnounce-{{ section.id }} .q-h1a__text{
      display: inline-flex;
      align-items: center;
      justify-content: inherit;
      gap: 10px;
      flex-wrap: wrap;
      font-weight: 500;
    }

    #HeaderOneAnnounce-{{ section.id }} .q-h1a__link{
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      opacity: .92;
      transition: opacity .18s ease, transform .18s ease;
    }

    #HeaderOneAnnounce-{{ section.id }} .q-h1a__link:hover{
      opacity: 1;
      transform: translateY(-1px);
    }

    #HeaderOneAnnounce-{{ section.id }} .q-h1a__link:focus-visible{
      outline: 2px solid currentColor;
      outline-offset: 3px;
      border-radius: 4px;
    }

    #HeaderOne-{{ section.id }}{
      --qh1-bg: {{ section.settings.bg_color }};
      --qh1-bg-soft: {{ section.settings.bg_soft_color }};
      --qh1-text: {{ section.settings.text_color }};
      --qh1-border: {{ section.settings.border_color }};
      --qh1-link: {{ section.settings.link_color }};
      --qh1-link-hover: {{ section.settings.link_hover_color }};
      --qh1-nav-underline: {{ section.settings.nav_underline_color }};
      --qh1-icon-bg: {{ section.settings.icon_bg }};
      --qh1-icon-bg-hover: {{ section.settings.icon_bg_hover }};
      --qh1-icon-color: {{ section.settings.icon_color }};
      --qh1-radius: {{ section.settings.radius }}px;
      --qh1-logo-desktop: {{ section.settings.logo_height_desktop }}px;
      --qh1-logo-mobile: {{ section.settings.logo_height_mobile }}px;
      --qh1-cart-count-bg: {{ section.settings.cart_count_bg }};
      --qh1-cart-count-text: {{ section.settings.cart_count_text }};
      --qh1-shadow: 0 10px 30px rgba(0,0,0,.06);
      --qh1-sticky-shadow: 0 14px 36px rgba(15,23,42,.10);
      --qh1-icon-shadow: 0 8px 20px rgba(15,23,42,.08);
      --qh1-search-width: {{ section.settings.search_width }}px;
      --qh1-icon-size: {{ section.settings.icon_button_size }}px;
      --qh1-icon-border-width: {{ section.settings.icon_button_border_width }}px;
      --qh1-contained-width: 1180px;
      --qh1-wide-width: 1440px;

      position: relative;
      z-index: 40;
      width: 100%;
      margin: 0;
      padding: 0;
      background: var(--qh1-bg);
      color: var(--qh1-text);
      border-bottom: 1px solid var(--qh1-border);
      box-shadow: var(--qh1-shadow);
      overflow: visible;
    }

    #HeaderOne-{{ section.id }}.q-header-one--sticky{
      position: sticky;
      top: 0;
    }

    #HeaderOne-{{ section.id }}.q-header-one--sticky:not(.q-header-one--sticky-shadow){
      box-shadow: none;
    }

    #HeaderOne-{{ section.id }}.q-header-one--sticky-shadow{
      box-shadow: var(--qh1-sticky-shadow);
    }

    #HeaderOne-{{ section.id }},
    #HeaderOne-{{ section.id }} *{
      box-sizing: border-box;
    }

    #HeaderOne-{{ section.id }} .qh1__shell{
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    #HeaderOne-{{ section.id }} .qh1__bar{
      width: 100%;
      min-height: 72px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 20px;
      margin: 0;
      padding: 0 20px;
      overflow: visible;
    }

    #HeaderOne-{{ section.id }}.q-header-one--width-contained .qh1__bar{
      max-width: var(--qh1-contained-width);
      margin-left: auto;
      margin-right: auto;
    }

    #HeaderOne-{{ section.id }}.q-header-one--width-wide .qh1__bar{
      max-width: var(--qh1-wide-width);
      margin-left: auto;
      margin-right: auto;
    }

    #HeaderOne-{{ section.id }} .qh1__brand{
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      text-decoration: none;
      color: inherit;
      position: relative;
      z-index: 2;
    }

    #HeaderOne-{{ section.id }} .qh1__logo-wrap{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
      flex: 0 0 auto;
    }

    #HeaderOne-{{ section.id }} .qh1__logo{
      display: block;
      width: auto;
      height: var(--qh1-logo-desktop);
      max-width: 100%;
      object-fit: contain;
    }

    #HeaderOne-{{ section.id }} .qh1__brand-text{
      display: inline-block;
      margin: 0;
      color: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -.01em;
      white-space: nowrap;
    }

    #HeaderOne-{{ section.id }} .qh1__nav-wrap{
      min-width: 0;
      display: flex;
      justify-content: center;
      position: relative;
      z-index: 2;
      overflow: hidden;
    }

    #HeaderOne-{{ section.id }} .qh1__nav{
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 0;
      flex-wrap: nowrap;
      white-space: nowrap;
      overflow: hidden;
    }

    #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__bar{
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__nav-wrap{
      grid-column: 1;
      grid-row: 1;
      justify-content: flex-start;
    }

    #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__brand{
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
    }

    #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__actions{
      grid-column: 3;
      grid-row: 1;
      justify-self: flex-end;
    }

    #HeaderOne-{{ section.id }}.q-header-one--layout-logo_left_nav_left .qh1__nav-wrap,
    #HeaderOne-{{ section.id }}.q-header-one--layout-logo_left_nav_left .qh1__nav{
      justify-content: flex-start;
    }

    #HeaderOne-{{ section.id }} .qh1__nav a,
    #HeaderOne-{{ section.id }} .qh1__nav-link{
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 10px 14px;
      border: 1px solid transparent;
      border-radius: calc(var(--qh1-radius) - 4px);
      text-decoration: none;
      color: var(--qh1-link);
      font-size: .96rem;
      font-weight: 600;
      line-height: 1;
      transition: background .18s ease, color .18s ease, transform .18s ease, border-color .18s ease;
      flex: 0 0 auto;
    }

    #HeaderOne-{{ section.id }} .qh1__nav a::after,
    #HeaderOne-{{ section.id }} .qh1__nav-link::after{
      content: "";
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 5px;
      height: 2px;
      border-radius: 999px;
      background: var(--qh1-nav-underline);
      opacity: 0;
      transform: scaleX(.35);
      transform-origin: center;
      transition: opacity .2s ease, transform .2s ease;
    }

    #HeaderOne-{{ section.id }} .qh1__nav a:hover,
    #HeaderOne-{{ section.id }} .qh1__nav-link:hover{
      background: transparent;
      color: var(--qh1-link-hover);
      transform: translateY(-1px);
    }

    #HeaderOne-{{ section.id }} .qh1__nav a:hover::after,
    #HeaderOne-{{ section.id }} .qh1__nav-link:hover::after{
      opacity: .85;
      transform: scaleX(1);
    }

    #HeaderOne-{{ section.id }} .qh1__nav-link--active{
      background: transparent;
      color: var(--qh1-link-hover);
      border-color: transparent;
    }

    #HeaderOne-{{ section.id }} .qh1__nav-link--active::after{
      opacity: 1;
      transform: scaleX(1);
    }

    #HeaderOne-{{ section.id }} .qh1__brand:focus-visible,
    #HeaderOne-{{ section.id }} .qh1__nav a:focus-visible,
    #HeaderOne-{{ section.id }} .qh1__mobile-menu a:focus-visible,
    #HeaderOne-{{ section.id }} .qh1__mobile-utility-link:focus-visible,
    #HeaderOne-{{ section.id }} .qh1__icon-btn:focus-visible{
      outline: 2px solid var(--qh1-link-hover);
      outline-offset: 3px;
    }

    #HeaderOne-{{ section.id }} .qh1__actions{
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      min-width: 0;
      flex: 0 0 auto;
      position: relative;
      z-index: 2;
      overflow: visible;
    }

    #HeaderOne-{{ section.id }} .qh1__icon-btn{
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--qh1-icon-size);
      height: var(--qh1-icon-size);
      margin: 0;
      padding: 0;
      border: var(--qh1-icon-border-width) solid var(--qh1-border);
      border-radius: 999px;
      background: var(--qh1-icon-bg);
      color: var(--qh1-icon-color);
      cursor: pointer;
      text-decoration: none;
      appearance: none;
      transition: background .18s ease, transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      flex: 0 0 auto;
    }

    #HeaderOne-{{ section.id }}.q-header-one--icon-shadow .qh1__icon-btn{
      box-shadow: var(--qh1-icon-shadow);
    }

    #HeaderOne-{{ section.id }} .qh1__icon-btn:hover{
      background: var(--qh1-icon-bg-hover);
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--qh1-border), var(--qh1-link-hover) 25%);
    }

    #HeaderOne-{{ section.id }} .qh1__icon{
      width: 20px;
      height: 20px;
      display: block;
      flex: 0 0 auto;
    }

    #HeaderOne-{{ section.id }} .qh1__cart-count{
      position: absolute;
      top: -5px;
      right: -5px;
      min-width: 20px;
      height: 20px;
      padding: 0 5px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      background: var(--qh1-cart-count-bg);
      color: var(--qh1-cart-count-text);
      border: 1px solid var(--qh1-bg);
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline{
      width: min(var(--qh1-search-width), 30vw);
      min-width: 220px;
      max-width: 100%;
      position: relative;
      flex: 0 1 auto;
      overflow: visible;
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__form{
      display: flex;
      gap: 8px;
      align-items: center;
      margin: 0;
      flex-wrap: nowrap;
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__field{
      flex: 1 1 auto;
      min-width: 0;
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__actions{
      flex: 0 0 auto;
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__input{
      width: 100%;
      min-width: 0;
      height: 44px;
      padding: 0 14px;
      border: 1px solid var(--qh1-border);
      border-radius: 999px;
      background: var(--qh1-bg);
      color: var(--qh1-text);
      box-shadow: none;
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__input:focus-visible,
    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__input:focus-visible{
      outline: none;
      border-color: var(--qh1-link-hover);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--qh1-link-hover), transparent 80%);
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__submit{
      min-height: 44px;
      padding: 0 20px;
      border: 1px solid var(--qh1-border);
      border-radius: 999px;
      background: var(--qh1-icon-bg);
      color: var(--qh1-icon-color);
      font-size: .92rem;
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      appearance: none;
      box-shadow: none;
      transition: background .18s ease, color .18s ease, border-color .18s ease, transform .18s ease, box-shadow .18s ease;
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__submit:hover{
      background: var(--qh1-icon-bg-hover);
      color: var(--qh1-link-hover);
      border-color: var(--qh1-link-hover);
      transform: translateY(-1px);
    }

    #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__submit:focus-visible{
      outline: 2px solid var(--qh1-link-hover);
      outline-offset: 3px;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-toggle{
      display: none;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-panel{
      display: none;
      width: 100%;
      margin: 0;
      padding: 10px 20px 16px;
      border-top: 1px solid var(--qh1-border);
      background: var(--qh1-bg);
    }

    #HeaderOne-{{ section.id }}.q-header-one--width-contained .qh1__mobile-panel,
    #HeaderOne-{{ section.id }}.q-header-one--width-wide .qh1__mobile-panel{
      max-width: var(--qh1-wide-width);
      margin-left: auto;
      margin-right: auto;
    }

    #HeaderOne-{{ section.id }}.q-header-one--width-contained .qh1__mobile-panel{
      max-width: var(--qh1-contained-width);
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-panel.is-open{
      display: block;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search{
      margin-bottom: 12px;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__form{
      display: flex;
      gap: 8px;
      align-items: center;
      margin: 0;
      flex-wrap: wrap;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__field{
      flex: 1 1 100%;
      min-width: 0;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__input{
      width: 100%;
      min-width: 0;
      height: 44px;
      padding: 0 14px;
      border: 1px solid var(--qh1-border);
      border-radius: 999px;
      background: var(--qh1-bg);
      color: var(--qh1-text);
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__submit{
      min-height: 44px;
      padding: 0 20px;
      border: 1px solid var(--qh1-border);
      border-radius: 999px;
      background: var(--qh1-icon-bg);
      color: var(--qh1-icon-color);
      font-size: .92rem;
      font-weight: 700;
      line-height: 1;
      cursor: pointer;
      appearance: none;
      box-shadow: none;
      transition: background .18s ease, color .18s ease, border-color .18s ease, transform .18s ease, box-shadow .18s ease;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__submit:hover{
      background: var(--qh1-icon-bg-hover);
      color: var(--qh1-link-hover);
      border-color: var(--qh1-link-hover);
      transform: translateY(-1px);
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__submit:focus-visible{
      outline: 2px solid var(--qh1-link-hover);
      outline-offset: 3px;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-menu{
      display: grid;
      gap: 6px;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-menu a,
    #HeaderOne-{{ section.id }} .qh1__mobile-link{
      display: block;
      margin: 0;
      padding: 12px 14px;
      border: 1px solid transparent;
      border-radius: calc(var(--qh1-radius) - 4px);
      text-decoration: none;
      color: var(--qh1-link);
      background: transparent;
      transition: background .18s ease, color .18s ease, border-color .18s ease;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-menu a:hover,
    #HeaderOne-{{ section.id }} .qh1__mobile-link:hover{
      background: var(--qh1-bg-soft);
      color: var(--qh1-link-hover);
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-link--active{
      background: var(--qh1-bg-soft);
      color: var(--qh1-link-hover);
      border-color: transparent;
      font-weight: 700;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-utilities{
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--qh1-border);
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-utility-link{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid var(--qh1-border);
      border-radius: calc(var(--qh1-radius) - 4px);
      color: var(--qh1-link);
      background: var(--qh1-bg-soft);
      text-decoration: none;
      font-size: .95rem;
      font-weight: 700;
    }

    #HeaderOne-{{ section.id }} .qh1__mobile-utility-link:hover{
      color: var(--qh1-link-hover);
      border-color: currentColor;
    }

    #HeaderOne-{{ section.id }}.q-header-one--mobile-drawer_like .qh1__mobile-panel.is-open{
      margin: 0 14px 14px;
      width: calc(100% - 28px);
      border: 1px solid var(--qh1-border);
      border-radius: var(--qh1-radius);
      box-shadow: 0 18px 44px rgba(15,23,42,.12);
    }

    #HeaderOne-{{ section.id }}.q-header-one--mobile-minimal .qh1__mobile-panel{
      padding-top: 6px;
      padding-bottom: 10px;
    }

    #HeaderOne-{{ section.id }}.q-header-one--mobile-minimal .qh1__mobile-menu{
      gap: 2px;
    }

    #HeaderOne-{{ section.id }}.q-header-one--mobile-minimal .qh1__mobile-menu a,
    #HeaderOne-{{ section.id }}.q-header-one--mobile-minimal .qh1__mobile-link{
      padding-top: 9px;
      padding-bottom: 9px;
      border-radius: 10px;
    }

    @supports not (color: color-mix(in srgb, #000, #fff)){
      #HeaderOne-{{ section.id }} .qh1__icon-btn:hover{
        border-color: var(--qh1-link-hover);
      }

      #HeaderOne-{{ section.id }} .qh1__search-inline .qtm-search-form__input:focus-visible,
      #HeaderOne-{{ section.id }} .qh1__mobile-search .qtm-search-form__input:focus-visible{
        box-shadow: 0 0 0 3px rgba(37,99,235,.16);
      }
    }

    @media (max-width: 1180px){
      #HeaderOne-{{ section.id }} .qh1__search-inline{
        width: min(var(--qh1-search-width), 24vw);
        min-width: 180px;
      }

      #HeaderOne-{{ section.id }} .qh1__nav a,
      #HeaderOne-{{ section.id }} .qh1__nav-link{
        padding: 10px 10px;
        font-size: .92rem;
      }
    }

    @media (max-width: 989px){
      #HeaderOne-{{ section.id }} .qh1__bar,
      #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__bar,
      #HeaderOne-{{ section.id }}.q-header-one--layout-logo_left_nav_left .qh1__bar{
        grid-template-columns: auto 1fr auto;
      }

      #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__brand,
      #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__actions,
      #HeaderOne-{{ section.id }}.q-header-one--layout-logo_center .qh1__nav-wrap{
        grid-column: auto;
        grid-row: auto;
      }

      #HeaderOne-{{ section.id }} .qh1__mobile-toggle{
        display: inline-flex;
      }

      #HeaderOne-{{ section.id }} .qh1__nav-wrap{
        display: none;
      }

      #HeaderOne-{{ section.id }} .qh1__search-inline{
        display: none;
      }

      #HeaderOne-{{ section.id }} .qh1__logo{
        height: var(--qh1-logo-mobile);
      }

      #HeaderOne-{{ section.id }} .qh1__brand-text{
        font-size: 1rem;
      }
    }

    @media (max-width: 640px){
      #HeaderOne-{{ section.id }} .qh1__bar{
        min-height: 64px;
        gap: 12px;
        padding-left: 14px;
        padding-right: 14px;
      }

      #HeaderOne-{{ section.id }} .qh1__mobile-panel{
        padding-left: 14px;
        padding-right: 14px;
      }

      #HeaderOne-{{ section.id }} .qh1__brand{
        gap: 10px;
      }

      #HeaderOne-{{ section.id }} .qh1__brand-text{
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      #HeaderOne-{{ section.id }} .qh1__actions{
        gap: 8px;
      }

      #HeaderOne-{{ section.id }}{
        --qh1-icon-size: min({{ section.settings.icon_button_size }}px, 42px);
      }
    }

    @media (max-width: 420px){
      #HeaderOne-{{ section.id }} .qh1__account-btn{
        display: none;
      }

      #HeaderOne-{{ section.id }} .qh1__mobile-utilities{
        grid-template-columns: 1fr;
      }
    }

    {{ settings.header_custom_css }}
  </style>

  <div class="qh1__shell">
    <div class="qh1__bar">
      <button
        type="button"
        class="qh1__icon-btn qh1__mobile-toggle"
        aria-expanded="false"
        aria-controls="qh1-mobile-panel-{{ section.id }}"
        data-qh1-mobile-toggle
        aria-label="Open mobile menu"
      >
        <svg class="qh1__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>

      <a class="qh1__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <span class="qh1__logo-wrap">
          {% if settings.logo_primary != blank %}
            <img
              class="qh1__logo"
              src="{{ settings.logo_primary | image_url: width: 600 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% elsif settings.logo_mobile != blank %}
            <img
              class="qh1__logo"
              src="{{ settings.logo_mobile | image_url: width: 600 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% endif %}
        </span>
      </a>

      <div class="qh1__nav-wrap">
        <nav class="qh1__nav" aria-label="Primary navigation">
          {% if main_menu != blank %}
            {% for link in main_menu.links %}
              <a
                class="qh1__nav-link{% if link.active %} qh1__nav-link--active{% endif %}"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            {% endfor %}
          {% endif %}
        </nav>
      </div>

      <div class="qh1__actions">
        {%- if header_search_mode == 'inline_static' -%}
          <div class="qh1__search-inline">
            {% render 'search-form-static',
              form_context: 'header-inline',
              input_id: 'HeaderOneStaticSearchInput-' | append: section.id,
              placeholder: header_search_placeholder,
              show_button: section.settings.show_inline_search_button
            %}
          </div>
        {%- elsif header_search_mode == 'search_button' -%}
          {%- if header_search_action == 'popup' and settings.enable_search_popup -%}
            <button
              type="button"
              class="qh1__icon-btn qh1__search-btn"
              data-search-popup-open
              aria-label="Open search"
              aria-haspopup="dialog"
            >
              <svg class="qh1__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          {%- else -%}
            <a
              href="{{ routes.search_url }}"
              class="qh1__icon-btn qh1__search-btn"
              aria-label="Go to search page"
            >
              <svg class="qh1__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </a>
          {%- endif -%}
        {%- endif -%}

        {% if section.settings.show_account_icon %}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="qh1__icon-btn qh1__account-btn"
            aria-label="{% if customer %}Account{% else %}Sign in{% endif %}"
          >
            <svg class="qh1__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="M5 20C5.7 16.4 8.25 14.4 12 14.4C15.75 14.4 18.3 16.4 19 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}

        <button
          type="button"
          class="qh1__icon-btn"
          data-cart-drawer-open
          aria-label="Open cart"
        >
          <svg class="qh1__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 7H21L19.5 15H8L6 7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M6 7L5.4 4.8C5.17 3.98 4.43 3.4 3.58 3.4H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="9.5" cy="19" r="1.2" fill="currentColor"/>
            <circle cx="18" cy="19" r="1.2" fill="currentColor"/>
          </svg>
          <span class="qh1__cart-count" data-cart-count>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>

    <div
      id="qh1-mobile-panel-{{ section.id }}"
      class="qh1__mobile-panel"
      hidden
    >
      {%- if header_search_mode == 'inline_static' -%}
        <div class="qh1__mobile-search">
          {% render 'search-form-static',
            form_context: 'header-mobile',
            input_id: 'HeaderOneMobileStaticSearchInput-' | append: section.id,
            placeholder: header_search_placeholder,
            show_button: true
          %}
        </div>
      {%- elsif header_search_mode == 'search_button' and header_search_action == 'page' -%}
        <div class="qh1__mobile-search">
          {% render 'search-form-static',
            form_context: 'header-mobile',
            input_id: 'HeaderOneMobileStaticSearchInput-' | append: section.id,
            placeholder: header_search_placeholder,
            show_button: true
          %}
        </div>
      {%- elsif header_search_mode == 'search_button' and header_search_action == 'popup' and settings.enable_search_popup -%}
        <div class="qh1__mobile-search">
          <button
            type="button"
            class="qh1__icon-btn qh1__search-btn"
            data-search-popup-open
            aria-label="Open search"
            aria-haspopup="dialog"
          >
            <svg class="qh1__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}

      <nav class="qh1__mobile-menu" aria-label="Mobile navigation">
        {% if main_menu != blank %}
          {% for link in main_menu.links %}
            <a
              class="qh1__mobile-link{% if link.active %} qh1__mobile-link--active{% endif %}"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>
          {% endfor %}
        {% endif %}
      </nav>

      {% if section.settings.show_mobile_account_link or section.settings.show_mobile_cart_link %}
        <div class="qh1__mobile-utilities">
          {% if section.settings.show_mobile_account_link %}
            <a class="qh1__mobile-utility-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              {% if customer %}Account{% else %}Sign in{% endif %}
            </a>
          {% endif %}

          {% if section.settings.show_mobile_cart_link %}
            <a class="qh1__mobile-utility-link" href="{{ routes.cart_url }}">
              Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <script>
    (function() {
      var root = document.getElementById('HeaderOne-{{ section.id }}');
      if (!root) return;

      var toggle = root.querySelector('[data-qh1-mobile-toggle]');
      var panel = document.getElementById('qh1-mobile-panel-{{ section.id }}');

      if (!toggle || !panel) return;

      function setOpen(isOpen) {
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

        if (isOpen) {
          panel.hidden = false;
          panel.classList.add('is-open');
        } else {
          panel.hidden = true;
          panel.classList.remove('is-open');
        }
      }

      toggle.addEventListener('click', function() {
        var isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setOpen(!isOpen);
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 989) {
          setOpen(false);
        }
      });

      setOpen(false);
    })();
  </script>
</header>

{% schema %}
{
