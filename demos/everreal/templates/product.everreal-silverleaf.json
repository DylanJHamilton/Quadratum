    "everreal_2": {
      "type": "product-story",
      "settings": {
        "title": "Built as a woodland ranger.",
        "intro": "",
        "source": "manual",
        "layout": "split",
        "media_position_desktop": "right",
        "media_ratio": "portrait",
        "media_fit": "cover",
