o.liquid · TXT
{%- comment -%}
  Section: Header Two — Mega Commerce Header
  Quadratum Theme
 
  Structure:
    Announcement bar (optional)
    Commerce row: logo / inline search / actions
    Navigation row: mega menu navigation
    Mobile drawer navigation
 
  Global contracts preserved:
    data-search-popup-open
    data-cart-drawer-open
    data-cart-count
 
  Header Two contracts:
    data-header-two-mobile-open
    data-header-two-mobile-close
{%- endcomment -%}
 
{{ 'header-two.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-two.js' | asset_url }}" defer></script>
 
{%- liquid
  if section.settings.menu != blank
    assign main_menu = linklists[section.settings.menu]
  else
    assign main_menu = linklists[settings.desktop_menu]
  endif
 
  assign header_layout = section.settings.header_layout | default: 'logo_search_actions'
  assign header_width = section.settings.header_width | default: 'full_width'
  assign sticky_mode = section.settings.sticky_mode | default: 'none'
 
  assign header_search_mode = section.settings.search_display | default: 'popup'
  assign header_search_placeholder = section.settings.search_placeholder | default: settings.search_placeholder
 
  assign sticky_positioned = false
  if sticky_mode == 'sticky' or sticky_mode == 'sticky_shadow' or sticky_mode == 'hide_on_scroll'
    assign sticky_positioned = true
  endif
 
  assign announce_text = section.settings.announcement_text
-%}
 
<style>
  html, body{
    margin: 0;
    padding: 0;
  }
 
  #shopify-section-{{ section.id }}{
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
  }
 
  {%- if sticky_positioned -%}
  #shopify-section-{{ section.id }}{
    position: sticky;
    top: 0;
    z-index: 60;
    transition: transform .28s ease;
  }
 
  #shopify-section-{{ section.id }}.qh2-section-hidden{
    transform: translateY(-100%);
  }
  {%- endif -%}
 
  #HeaderTwoAnnounce-{{ section.id }}{
    --qh2-announce-bg: {{ section.settings.announcement_bg }};
    --qh2-announce-text: {{ section.settings.announcement_text_color }};
    --qh2-announce-font-size: {{ section.settings.announcement_font_size }}px;
  }
 
  #HeaderTwo-{{ section.id }}{
    /* Colors */
    --qh2-bg: {{ section.settings.header_bg }};
    --qh2-text: {{ section.settings.header_text }};
    --qh2-link: {{ section.settings.header_link }};
    --qh2-link-hover: {{ section.settings.header_link_hover }};
    --qh2-border: {{ section.settings.header_border }};
    --qh2-dropdown-bg: {{ section.settings.dropdown_bg }};
    --qh2-dropdown-text: {{ section.settings.dropdown_text }};
    --qh2-dropdown-border: {{ section.settings.dropdown_border }};
    --qh2-badge-bg: {{ section.settings.badge_bg }};
    --qh2-badge-text: {{ section.settings.badge_text }};
 
    /* Typography */
    --qh2-menu-font-size: {{ section.settings.menu_font_size }}px;
    --qh2-menu-font-weight: {{ section.settings.menu_font_weight }};
    --qh2-dropdown-font-size: {{ section.settings.dropdown_font_size }}px;
 
    /* Spacing */
    --qh2-pad-y: {{ section.settings.header_padding_y }}px;
    --qh2-pad-x: {{ section.settings.header_padding_x }}px;
    --qh2-menu-gap: {{ section.settings.menu_gap }}px;
    --qh2-dropdown-pad: {{ section.settings.dropdown_padding }}px;
 
    /* Radius */
    --qh2-button-radius: {{ section.settings.button_radius }}px;
    --qh2-dropdown-radius: {{ section.settings.dropdown_radius }}px;
    --qh2-promo-radius: {{ section.settings.promo_radius }}px;
 
    /* Logo (consumed by header-two-logo snippet styles) */
    --qtm-hm-logo-desktop: {{ section.settings.logo_height_desktop }}px;
    --qtm-hm-logo-mobile: {{ section.settings.logo_height_mobile }}px;
 
    /* Width tracks */
    --qh2-contained-width: 1180px;
    --qh2-wide-width: 1440px;
  }
</style>
 
{%- if section.settings.announcement_enable and announce_text != blank -%}
  <div
    id="HeaderTwoAnnounce-{{ section.id }}"
    class="qtmHeaderTwoAnnounce qtmHeaderTwoAnnounce--align-{{ section.settings.announcement_alignment | default: 'center' }}"
    data-qh2-announce
  >
    <div class="qtmHeaderTwoAnnounce__inner">
      <p class="qtmHeaderTwoAnnounce__text">
        <span>{{ announce_text }}</span>
        {%- if section.settings.announcement_link_url != blank and section.settings.announcement_link_label != blank -%}
          <a class="qtmHeaderTwoAnnounce__link" href="{{ section.settings.announcement_link_url }}">
            {{ section.settings.announcement_link_label | escape }}
          </a>
        {%- endif -%}
      </p>
 
      {%- if section.settings.announcement_show_close -%}
        <button
          type="button"
          class="qtmHeaderTwoAnnounce__close"
          aria-label="Dismiss announcement"
          data-qh2-announce-close
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
 
<header
  id="HeaderTwo-{{ section.id }}"
  class="qtmHeaderTwo qtmHeaderTwo--layout-{{ header_layout }} qtmHeaderTwo--width-{{ header_width }} qtmHeaderTwo--sticky-{{ sticky_mode }}"
  data-qh2-header
  data-qh2-sticky-mode="{{ sticky_mode }}"
  aria-label="Site header"
>
  <div class="qtmHeaderTwo__shell">
    {%- comment -%} ---------- Commerce row ---------- {%- endcomment -%}
    <div class="qtmHeaderTwo__commerce">
      <button
        type="button"
        class="qtm-hm-icon-btn qtmHeaderTwo__mobile-toggle"
        aria-expanded="false"
        aria-controls="QH2MobileDrawer-{{ section.id }}"
        aria-label="Open menu"
        data-header-two-mobile-open
      >
        <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
 
      <div class="qtmHeaderTwo__brand">
        {% render 'header-two-logo' %}
      </div>
 
      {%- if header_search_mode == 'inline_static' -%}
        {%- assign header_search_input_id = 'HeaderTwoSearchInput-' | append: section.id -%}
        <div class="qtmHeaderTwo__search">
          {% render 'header-two-search',
            mode: 'inline_static',
            context: 'header-two',
            input_id: header_search_input_id,
            placeholder: header_search_placeholder,
            show_button: section.settings.show_inline_search_button
          %}
        </div>
      {%- endif -%}
 
      <div class="qtmHeaderTwo__actions">
        {% render 'header-two-actions',
          search_mode: header_search_mode,
          search_placeholder: header_search_placeholder,
          show_account: section.settings.show_account,
          account_display: section.settings.account_display,
          cart_display: section.settings.cart_display,
          show_cart_subtotal: section.settings.show_cart_subtotal
        %}
      </div>
    </div>
 
    {%- comment -%} ---------- Navigation row ---------- {%- endcomment -%}
    <div class="qtmHeaderTwo__navrow">
      {% render 'header-two-mega-menu',
        menu: main_menu,
        mega_blocks: section.blocks,
        section_id: section.id
      %}
    </div>
  </div>
 
  {%- comment -%} ---------- Mobile drawer ---------- {%- endcomment -%}
  {% render 'header-two-mobile-menu',
    menu: main_menu,
    section_id: section.id,
    search_mode: header_search_mode,
    search_placeholder: header_search_placeholder,
    show_account: section.settings.show_account,
    show_cart: true
  %}
</header>
 
{% schema %}
{
  "name": "Header Two",
  "class": "qtm-header-two-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Desktop layout",
      "default": "logo_search_actions",
      "options": [
        { "value": "logo_search_actions", "label": "Logo / Search / Actions, nav below" },
        { "value": "logo_center_nav_below", "label": "Logo centered, nav below" },
        { "value": "logo_left_nav_inline", "label": "Logo left, nav inline" }
      ]
    },
    {
      "type": "select",
      "id": "header_width",
      "label": "Header width",
      "default": "full_width",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky mode",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sticky", "label": "Sticky" },
        { "value": "sticky_shadow", "label": "Sticky with shadow" },
        { "value": "hide_on_scroll", "label": "Hide on scroll down" }
      ]
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Overrides the global desktop menu for this header."
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "checkbox",
      "id": "announcement_enable",
      "label": "Enable announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement link label"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link URL"
    },
    {
      "type": "select",
      "id": "announcement_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "announcement_font_size",
      "label": "Font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "announcement_show_close",
      "label": "Show close button",
      "default": false
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "select",
      "id": "search_display",
      "label": "Search display",
      "default": "inline_static",
      "options": [
        { "value": "none", "label": "No search" },
        { "value": "inline_static", "label": "Inline static search form" },
        { "value": "popup", "label": "Search button (popup)" },
        { "value": "page", "label": "Search button (search page)" }
      ]
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder override",
      "default": "Search products, articles, and pages"
    },
    {
      "type": "checkbox",
      "id": "show_inline_search_button",
      "label": "Show inline search button",
      "default": true
    },
    {
      "type": "header",
      "content": "Account"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "select",
      "id": "account_display",
      "label": "Account display",
      "default": "icon",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "text", "label": "Text" },
        { "value": "icon_text", "label": "Icon and text" }
      ]
    },
    {
      "type": "header",
      "content": "Cart"
    },
    {
      "type": "select",
      "id": "cart_display",
      "label": "Cart display",
      "default": "icon",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "icon_text", "label": "Icon and text" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_cart_subtotal",
      "label": "Show cart subtotal",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "header_link",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "header_link_hover",
      "label": "Link hover color",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Border color",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "dropdown_bg",
      "label": "Dropdown background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dropdown_text",
      "label": "Dropdown text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "dropdown_border",
      "label": "Dropdown border",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "menu_font_weight",
      "label": "Menu font weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "dropdown_font_size",
      "label": "Dropdown font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "header_padding_y",
      "label": "Header vertical padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_padding_x",
      "label": "Header horizontal padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "Menu item gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "dropdown_padding",
      "label": "Dropdown padding",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Radius"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "dropdown_radius",
      "label": "Dropdown radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "promo_radius",
      "label": "Promo card radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Logo height desktop",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height mobile",
      "min": 18,
      "max": 80,
      "step": 2,
      "default": 30,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item_title",
          "label": "Menu item title",
          "info": "Must exactly match a top-level menu item title (case-insensitive)."
        },
        {
          "type": "select",
          "id": "columns",
          "label": "Link columns",
          "default": "4",
          "options": [
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" },
            { "value": "6", "label": "6" }
          ]
        },
        {
          "type": "text",
          "id": "badge_label",
          "label": "Badge label",
          "info": "Optional. e.g. New, Hot, Sale, Trending, Exclusive."
        },
        {
          "type": "header",
          "content": "Promotional content"
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Promo image"
        },
        {
          "type": "text",
          "id": "promo_heading",
          "label": "Promo heading"
        },
        {
          "type": "textarea",
          "id": "promo_text",
          "label": "Promo text"
        },
        {
          "type": "text",
          "id": "promo_button_label",
          "label": "Promo button label"
        },
        {
          "type": "url",
          "id": "promo_button_url",
          "label": "Promo button URL"
        },
        {
          "type": "header",
          "content": "Featured collection"
        },
        {
          "type": "collection",
          "id": "featured_collection",
          "label": "Featured collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header Two",
      "blocks": [
        {
          "type": "mega_menu"
        }
      ]
    }
  ]
}
{% endschema %}