{%- comment -%}Shared native collection link; each caller owns its grid/slide and scoped styles.{%- endcomment -%}
{%- liquid
  assign collection_image = card_collection.image | default: card_collection.featured_image
  assign collection_alt = collection_image.alt | default: card_collection.title
  assign description = ''
  if block.settings.show_collection_description
    if card_collection.description != blank
      assign description = card_collection.description | strip_html | truncatewords: block.settings.description_words
    else
      assign description = block.settings.fallback_description
    endif
  endif
-%}
<a class="{{ prefix }}__card{% unless collection_image %} {{ prefix }}__card--no-image{% endunless %}" href="{{ card_collection.url | escape }}" aria-label="{{ card_collection.title | escape }}">
  {% if collection_image %}<span class="{{ prefix }}__media">{{ collection_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900, 1200', sizes: '(max-width: 749px) 90vw, (max-width: 989px) 45vw, 30vw', alt: collection_alt }}</span>{% endif %}
  <span class="{{ prefix }}__content">
    <span class="{{ prefix }}__title">{{ card_collection.title | escape }}</span>
    {% if block.settings.show_product_count %}<span class="{{ prefix }}__meta">{{ card_collection.products_count }} {{ block.settings.product_count_label | escape }}</span>{% endif %}
    {% if description != blank %}<span class="{{ prefix }}__copy">{{ description | escape }}</span>{% endif %}
    {% if block.settings.show_button and block.settings.button_label != blank %}<span class="{{ prefix }}__button">{{ block.settings.button_label | escape }}</span>{% endif %}
  </span>
</a>
