{% comment %}Native contact request. No calendar availability or booking is implied.{% endcomment %}
{{ 'forms-sections.css' | asset_url | stylesheet_tag }}
{% assign inquiry_id = 'Inquiry-' | append: id %}
{% form 'contact', id: inquiry_id, class: 'q-form q-native-inquiry', data-shopify-captcha: 'true' %}
  {% if form.posted_successfully? %}<p role="status" tabindex="-1">Your request has been sent. We will contact you to discuss the details.</p>{% endif %}
  {% if form.errors %}<div role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>{% endif %}
  <div class="q-input"><label for="{{ inquiry_id }}-name">Name</label><input class="q-input__control" id="{{ inquiry_id }}-name" name="contact[name]" type="text" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required></div>
  <div class="q-input"><label for="{{ inquiry_id }}-email">Email</label><input class="q-input__control" id="{{ inquiry_id }}-email" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required></div>
  {% if request_date %}<div class="q-input"><label for="{{ inquiry_id }}-date">Preferred date (optional)</label><input class="q-input__control" id="{{ inquiry_id }}-date" name="contact[Preferred date]" type="date"><p>This is a request. Availability and appointments are confirmed separately.</p></div>{% endif %}
  <div class="q-input"><label for="{{ inquiry_id }}-body">How can we help?</label><textarea class="q-input__control" id="{{ inquiry_id }}-body" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></div>
  <button class="q-btn q-btn--solid" type="submit">Send request</button>
{% endform %}
<style>.q-native-inquiry{display:grid;gap:18px}.q-native-inquiry .q-input{display:grid;gap:8px}.q-native-inquiry .q-input__control{box-sizing:border-box;width:100%;font:inherit;padding:12px;color:inherit;background:transparent;border:1px solid currentColor}.q-native-inquiry :is(input,textarea,button):focus-visible{outline:3px solid currentColor;outline-offset:3px}</style>
