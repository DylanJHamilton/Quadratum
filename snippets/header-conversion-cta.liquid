{% liquid
  assign cta_label = section_settings.cta_label | default: 'Shop Now'
  assign cta_url = section_settings.cta_url | default: routes.all_products_collection_url
  assign cta_style = section_settings.cta_style | default: 'solid'
  assign extra_class = class_name | default: ''
%}

<a
  class="qtmHeaderFour__cta qtmHeaderFour__cta--{{ cta_style }} {{ extra_class }}"
  href="{{ cta_url }}"
>
  {{ cta_label }}
</a>