{%- liquid
  assign block_id = 'content-press-mentions-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'center'
  assign layout_style = block.settings.layout_style | default: 'logos'
  assign desktop_columns = block.settings.desktop_columns | default: '4'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign item_count = block.settings.item_count | default: 4

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-press-mentions
    content-press-mentions--{{ layout_style }}
    content-press-mentions--width-{{ block_width }}
    content-press-mentions--align-{{ text_alignment }}
    content-press-mentions--desktop-{{ desktop_columns }}
    content-press-mentions--mobile-{{ mobile_columns }}
    {% unless show_on_desktop %} content-press-mentions--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-press-mentions--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-press-mentions--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-press-mentions--animate content-press-mentions--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-press-mentions-margin-top: {{ block.settings.margin_top }}px;
    --content-press-mentions-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-press-mentions-padding: {{ block.settings.padding }}px;
    --content-press-mentions-gap: {{ block.settings.gap }}px;
    --content-press-mentions-card-padding: {{ block.settings.card_padding }}px;
    --content-press-mentions-border-width: {{ block.settings.border_width }}px;
    --content-press-mentions-border-radius: {{ block.settings.border_radius }}px;
    --content-press-mentions-heading-color: {{ block.settings.heading_color }};
    --content-press-mentions-text-color: {{ block.settings.text_color }};
    --content-press-mentions-background-color: {{ block.settings.background_color }};
    --content-press-mentions-card-background-color: {{ block.settings.card_background_color }};
    --content-press-mentions-border-color: {{ block.settings.border_color }};
    --content-press-mentions-link-color: {{ block.settings.link_color }};
    --content-press-mentions-badge-background: {{ block.settings.badge_background_color }};
    --content-press-mentions-badge-text: {{ block.settings.badge_text_color }};
    --content-press-mentions-logo-height: {{ block.settings.logo_height }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-press-mentions-margin-top);
      margin-bottom: var(--content-press-mentions-margin-bottom);
      padding: var(--content-press-mentions-padding);
      color: var(--content-press-mentions-text-color);
      background: var(--content-press-mentions-background-color);
    }

    #{{ block_id }}.content-press-mentions--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-press-mentions--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-press-mentions--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-press-mentions--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-press-mentions--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-press-mentions--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-press-mentions--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-press-mentions--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-press-mentions__items {
      display: grid;
      width: 100%;
      gap: var(--content-press-mentions-gap);
    }

    #{{ block_id }}.content-press-mentions--desktop-1 .content-press-mentions__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.content-press-mentions--desktop-2 .content-press-mentions__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.content-press-mentions--desktop-3 .content-press-mentions__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.content-press-mentions--desktop-4 .content-press-mentions__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }}.content-press-mentions--desktop-5 .content-press-mentions__items {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    #{{ block_id }} .content-press-mentions__item {
      min-width: 0;
      display: grid;
      gap: 14px;
      align-content: center;
      color: var(--content-press-mentions-text-color);
      background: var(--content-press-mentions-card-background-color);
      border: var(--content-press-mentions-border-width) solid var(--content-press-mentions-border-color);
      border-radius: var(--content-press-mentions-border-radius);
      padding: var(--content-press-mentions-card-padding);
      text-decoration: none;
    }

    #{{ block_id }} a.content-press-mentions__item {
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} a.content-press-mentions__item:hover {
      opacity: 0.82;
      transform: translateY(-1px);
    }

    #{{ block_id }} a.content-press-mentions__item:focus-visible {
      outline: 2px solid var(--content-press-mentions-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }}.content-press-mentions--logos .content-press-mentions__item {
      min-height: 118px;
      place-items: center;
    }

    #{{ block_id }}.content-press-mentions--quotes .content-press-mentions__item,
    #{{ block_id }}.content-press-mentions--mixed .content-press-mentions__item,
    #{{ block_id }}.content-press-mentions--awards .content-press-mentions__item {
      align-content: start;
    }

    #{{ block_id }}.content-press-mentions--awards .content-press-mentions__item,
    #{{ block_id }}.content-press-mentions--mixed .content-press-mentions__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .content-press-mentions__logo-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: var(--content-press-mentions-logo-height);
    }

    #{{ block_id }}.content-press-mentions--align-left .content-press-mentions__logo-wrap {
      justify-content: flex-start;
    }

    #{{ block_id }}.content-press-mentions--align-right .content-press-mentions__logo-wrap {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-press-mentions__logo {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: var(--content-press-mentions-logo-height);
      object-fit: contain;
    }

    #{{ block_id }} .content-press-mentions__logo-placeholder {
      display: inline-flex;
      min-height: var(--content-press-mentions-logo-height);
      align-items: center;
      justify-content: center;
      color: var(--content-press-mentions-heading-color);
      line-height: 1.2;
      opacity: 0.72;
    }

    #{{ block_id }} .content-press-mentions__quote {
      margin: 0;
      color: var(--content-press-mentions-heading-color);
      line-height: 1.55;
    }

    #{{ block_id }} .content-press-mentions__source {
      margin: 0;
      color: var(--content-press-mentions-text-color);
      line-height: 1.3;
      opacity: 0.82;
    }

    #{{ block_id }} .content-press-mentions__badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      padding: 6px 10px;
      border-radius: 999px;
      color: var(--content-press-mentions-badge-text);
      background: var(--content-press-mentions-badge-background);
      line-height: 1.2;
      font-size: 0.82em;
    }

    #{{ block_id }}.content-press-mentions--align-center .content-press-mentions__badge {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-press-mentions--align-right .content-press-mentions__badge {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.content-press-mentions--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-press-mentions--animate-fade {
      animation-name: contentPressMentionsFade;
    }

    #{{ block_id }}.content-press-mentions--animate-fade_up {
      animation-name: contentPressMentionsFadeUp;
    }

    #{{ block_id }}.content-press-mentions--animate-fade_down {
      animation-name: contentPressMentionsFadeDown;
    }

    #{{ block_id }}.content-press-mentions--animate-fade_left {
      animation-name: contentPressMentionsFadeLeft;
    }

    #{{ block_id }}.content-press-mentions--animate-fade_right {
      animation-name: contentPressMentionsFadeRight;
    }

    #{{ block_id }}.content-press-mentions--animate-zoom {
      animation-name: contentPressMentionsZoom;
    }

    @keyframes contentPressMentionsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentPressMentionsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentPressMentionsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentPressMentionsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentPressMentionsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentPressMentionsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-press-mentions--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-press-mentions--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-press-mentions--desktop-3 .content-press-mentions__items,
      #{{ block_id }}.content-press-mentions--desktop-4 .content-press-mentions__items,
      #{{ block_id }}.content-press-mentions--desktop-5 .content-press-mentions__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-press-mentions--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-press-mentions--mobile-1 .content-press-mentions__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-press-mentions--mobile-2 .content-press-mentions__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }} .content-press-mentions__item {
        padding: min(var(--content-press-mentions-card-padding), 22px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-press-mentions--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} a.content-press-mentions__item {
        transition: none;
      }

      #{{ block_id }} a.content-press-mentions__item:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-press-mentions__items">
    {%- for index in (1..8) -%}
      {%- if index <= item_count -%}
        {%- liquid
          assign logo_key = 'item_' | append: index | append: '_logo'
          assign logo_alt_key = 'item_' | append: index | append: '_logo_alt'
          assign quote_key = 'item_' | append: index | append: '_quote'
          assign source_name_key = 'item_' | append: index | append: '_source_name'
          assign link_url_key = 'item_' | append: index | append: '_link_url'
          assign badge_label_key = 'item_' | append: index | append: '_badge_label'

          assign item_logo = block.settings[logo_key]
          assign item_logo_alt = block.settings[logo_alt_key]
          assign item_quote = block.settings[quote_key]
          assign item_source_name = block.settings[source_name_key]
          assign item_link_url = block.settings[link_url_key]
          assign item_badge_label = block.settings[badge_label_key]
        -%}

        {% if item_logo != blank or item_quote != blank or item_source_name != blank or item_badge_label != blank %}
          {% if item_link_url != blank %}
            <a class="content-press-mentions__item" href="{{ item_link_url }}" aria-label="{{ item_source_name | default: item_logo_alt | escape }}">
          {% else %}
            <article class="content-press-mentions__item">
          {% endif %}

            {% if item_logo != blank %}
              <div class="content-press-mentions__logo-wrap">
                {{
                  item_logo
                  | image_url: width: 500
                  | image_tag:
                    class: 'content-press-mentions__logo',
                    loading: 'lazy',
                    alt: item_logo_alt
                }}
              </div>
            {% elsif item_source_name != blank %}
              <div class="content-press-mentions__logo-placeholder">
                {{ item_source_name | escape }}
              </div>
            {% endif %}

            {% if item_badge_label != blank %}
              <span class="content-press-mentions__badge">
                {{ item_badge_label | escape }}
              </span>
            {% endif %}

            {% if item_quote != blank %}
              <blockquote class="content-press-mentions__quote">
                “{{ item_quote | escape }}”
              </blockquote>
            {% endif %}

            {% if item_source_name != blank %}
              <p class="content-press-mentions__source">
                {{ item_source_name | escape }}
              </p>
            {% endif %}

          {% if item_link_url != blank %}
            </a>
          {% else %}
            </article>
          {% endif %}
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Press mentions",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "logos",
      "options": [
        {
          "value": "logos",
          "label": "Logos"
        },
        {
          "value": "quotes",
          "label": "Quotes"
        },
        {
          "value": "mixed",
          "label": "Mixed"
        },
        {
          "value": "awards",
          "label": "Awards"
        }
      ]
    },
    {
      "type": "range",
      "id": "item_count",
      "label": "Number of items",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },

    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "image_picker",
      "id": "item_1_logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "item_1_logo_alt",
      "label": "Logo alt text",
      "default": "Press logo"
    },
    {
      "type": "textarea",
      "id": "item_1_quote",
      "label": "Quote",
      "default": "A standout customer experience built around clarity and trust."
    },
    {
      "type": "text",
      "id": "item_1_source_name",
      "label": "Source name",
      "default": "Featured Publication"
    },
    {
      "type": "url",
      "id": "item_1_link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "item_1_badge_label",
      "label": "Badge label",
      "default": "Featured"
    },

    {
