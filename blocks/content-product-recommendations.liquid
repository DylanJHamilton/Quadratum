{%- liquid
  assign block_id = 'content-product-recommendations-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign source = block.settings.product_source | default: 'recommendations'
  assign selected_collection = block.settings.collection
  assign recommendation_limit = block.settings.product_limit | default: 4
  assign recommendation_layout = block.settings.recommendation_layout | default: 'grid'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign recommendation_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product_context.id | append: '&limit=' | append: recommendation_limit
-%}

<div
  id="{{ block_id }}"
  class="
    content-product-recommendations
    content-product-recommendations--{{ recommendation_layout }}
    content-product-recommendations--width-{{ width }}
    content-product-recommendations--align-{{ alignment }}
    {% unless show_on_desktop %} content-product-recommendations--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-product-recommendations--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-product-recommendations--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-product-recommendations--animate content-product-recommendations--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-product-recommendations-margin-top: {{ block.settings.margin_top }}px;
    --content-product-recommendations-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-product-recommendations-padding: {{ block.settings.padding }}px;
    --content-product-recommendations-gap: {{ block.settings.grid_gap }}px;
    --content-product-recommendations-card-padding: {{ block.settings.card_padding }}px;
    --content-product-recommendations-card-radius: {{ block.settings.card_radius }}px;
    --content-product-recommendations-border-width: {{ block.settings.border_width }}px;
    --content-product-recommendations-columns-desktop: {{ block.settings.columns_desktop }};
    --content-product-recommendations-columns-tablet: {{ block.settings.columns_tablet }};
    --content-product-recommendations-columns-mobile: {{ block.settings.columns_mobile }};
    --content-product-recommendations-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-product-recommendations-heading-color: {{ block.settings.heading_color }};
    --content-product-recommendations-text-color: {{ block.settings.text_color }};
    --content-product-recommendations-price-color: {{ block.settings.price_color }};
    --content-product-recommendations-sale-color: {{ block.settings.sale_color }};
    --content-product-recommendations-background: {{ block.settings.background_color }};
    --content-product-recommendations-card-background: {{ block.settings.card_background_color }};
    --content-product-recommendations-border-color: {{ block.settings.border_color }};
    --content-product-recommendations-button-background: {{ block.settings.button_background_color }};
    --content-product-recommendations-button-text: {{ block.settings.button_text_color }};
    --content-product-recommendations-arrow-background: {{ block.settings.arrow_background_color }};
    --content-product-recommendations-arrow-text: {{ block.settings.arrow_text_color }};
    --content-product-recommendations-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-product-recommendations
  data-recommendations-source="{{ source }}"
  {% if product_context != blank %}
    data-recommendations-url="{{ recommendation_url }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-product-recommendations-margin-top);
      margin-bottom: var(--content-product-recommendations-margin-bottom);
      padding: var(--content-product-recommendations-padding);
      color: var(--content-product-recommendations-text-color);
      background: var(--content-product-recommendations-background);
    }

    #{{ block_id }}.content-product-recommendations--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-product-recommendations--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.content-product-recommendations--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.content-product-recommendations--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.content-product-recommendations--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-product-recommendations--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-product-recommendations--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-product-recommendations--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-product-recommendations__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-product-recommendations__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.content-product-recommendations--align-center .content-product-recommendations__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-product-recommendations__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .content-product-recommendations__eyebrow {
      margin: 0;
      color: var(--content-product-recommendations-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-product-recommendations__heading {
      margin: 0;
      color: var(--content-product-recommendations-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-product-recommendations__description {
      margin: 0;
      color: var(--content-product-recommendations-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-product-recommendations__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .content-product-recommendations__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--content-product-recommendations-arrow-text);
      background: var(--content-product-recommendations-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-product-recommendations__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-recommendations__arrow:focus-visible {
      outline: 2px solid var(--content-product-recommendations-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-recommendations__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .content-product-recommendations__items {
      display: grid;
      grid-template-columns: repeat(var(--content-product-recommendations-columns-desktop), minmax(0, 1fr));
      gap: var(--content-product-recommendations-gap);
      min-width: 0;
    }

    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__items {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__items::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item {
      flex: 0 0 calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-desktop) - 1))) / var(--content-product-recommendations-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }} .content-product-recommendations__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--content-product-recommendations-text-color);
      text-decoration: none;
    }

    #{{ block_id }}.content-product-recommendations--grid .content-product-recommendations__card,
    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__card,
    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__card {
      padding: var(--content-product-recommendations-card-padding);
      background: var(--content-product-recommendations-card-background);
      border: var(--content-product-recommendations-border-width) solid var(--content-product-recommendations-border-color);
      border-radius: var(--content-product-recommendations-card-radius);
      overflow: hidden;
    }

    #{{ block_id }} .content-product-recommendations__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--content-product-recommendations-card-radius) - 8px), 0px);
      aspect-ratio: var(--content-product-recommendations-image-ratio);
    }

    #{{ block_id }} .content-product-recommendations__media img,
    #{{ block_id }} .content-product-recommendations__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .content-product-recommendations__card:hover .content-product-recommendations__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .content-product-recommendations__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .content-product-recommendations__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--content-product-recommendations-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .content-product-recommendations__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-product-recommendations__vendor {
      color: var(--content-product-recommendations-text-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.68;
    }

    #{{ block_id }} .content-product-recommendations__title {
      margin: 0;
      color: var(--content-product-recommendations-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .content-product-recommendations__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .content-product-recommendations__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .content-product-recommendations__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--content-product-recommendations-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__price-row {
      justify-content: center;
    }

    #{{ block_id }} .content-product-recommendations__price {
      color: var(--content-product-recommendations-price-color);
      font-weight: 700;
    }

    #{{ block_id }} .content-product-recommendations__compare {
      color: var(--content-product-recommendations-text-color);
      text-decoration: line-through;
      opacity: 0.55;
    }

    #{{ block_id }} .content-product-recommendations__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-product-recommendations-button-text);
      background: var(--content-product-recommendations-button-background);
      border: 1px solid var(--content-product-recommendations-button-background);
      border-radius: max(calc(var(--content-product-recommendations-card-radius) - 10px), 6px);
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }} .content-product-recommendations__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-recommendations__media:focus-visible,
    #{{ block_id }} .content-product-recommendations__title a:focus-visible,
    #{{ block_id }} .content-product-recommendations__button:focus-visible {
      outline: 2px solid var(--content-product-recommendations-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-recommendations__empty {
      padding: 18px;
      color: var(--content-product-recommendations-text-color);
      background: var(--content-product-recommendations-card-background);
      border: var(--content-product-recommendations-border-width) solid var(--content-product-recommendations-border-color);
      border-radius: var(--content-product-recommendations-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-product-recommendations--is-loading .content-product-recommendations__items {
      opacity: 0.45;
      pointer-events: none;
    }

    #{{ block_id }}.content-product-recommendations--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-product-recommendations--animate-fade {
      animation-name: contentProductRecommendationsFade;
    }

    #{{ block_id }}.content-product-recommendations--animate-fade_up {
      animation-name: contentProductRecommendationsFadeUp;
    }

    #{{ block_id }}.content-product-recommendations--animate-zoom {
      animation-name: contentProductRecommendationsZoom;
    }

    @keyframes contentProductRecommendationsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentProductRecommendationsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentProductRecommendationsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-product-recommendations--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-product-recommendations--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-product-recommendations__items {
        grid-template-columns: repeat(var(--content-product-recommendations-columns-tablet), minmax(0, 1fr));
      }

      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item {
        flex-basis: calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-tablet) - 1))) / var(--content-product-recommendations-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-product-recommendations--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-product-recommendations__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .content-product-recommendations__items {
        grid-template-columns: repeat(var(--content-product-recommendations-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item {
        flex-basis: calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-mobile) - 1))) / var(--content-product-recommendations-columns-mobile));
      }

      #{{ block_id }} .content-product-recommendations__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .content-product-recommendations__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-product-recommendations--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__items {
        scroll-behavior: auto;
      }

      #{{ block_id }} .content-product-recommendations__media img,
      #{{ block_id }} .content-product-recommendations__button,
      #{{ block_id }} .content-product-recommendations__arrow {
        transition: none;
      }

      #{{ block_id }} .content-product-recommendations__card:hover .content-product-recommendations__media img,
      #{{ block_id }} .content-product-recommendations__button:hover,
      #{{ block_id }} .content-product-recommendations__arrow:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-product-recommendations__inner">
    {% if block.settings.show_header %}
      <div class="content-product-recommendations__header-row">
        <div class="content-product-recommendations__header">
          {% if block.settings.eyebrow != blank %}
            <p class="content-product-recommendations__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="content-product-recommendations__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="content-product-recommendations__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>

        {% if recommendation_layout == 'carousel' and block.settings.show_arrows %}
          <div class="content-product-recommendations__controls">
            <button
              type="button"
              class="content-product-recommendations__arrow"
              data-content-product-recommendations-prev
              aria-label="{{ block.settings.previous_label | escape }}"
            >
              ‹
            </button>

            <button
              type="button"
              class="content-product-recommendations__arrow"
              data-content-product-recommendations-next
              aria-label="{{ block.settings.next_label | escape }}"
            >
              ›
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {%- liquid
      assign rendered_products = 0
    -%}

    <div
      class="content-product-recommendations__items"
      data-content-product-recommendations-items
      aria-label="{{ block.settings.recommendations_label | escape }}"
      {% if recommendation_layout == 'carousel' %}tabindex="0"{% endif %}
    >
      {% if source == 'recommendations' and recommendations.performed and recommendations.products_count > 0 %}
        {% for recommended_product in recommendations.products limit: recommendation_limit %}
          {%- liquid
            assign rendered_products = rendered_products | plus: 1
            assign recommended_variant = recommended_product.selected_or_first_available_variant
            assign is_on_sale = false

            if recommended_variant.compare_at_price > recommended_variant.price
              assign is_on_sale = true
            endif
          -%}

          <article class="content-product-recommendations__item" data-content-product-recommendations-item>
            <div class="content-product-recommendations__card">
              <a class="content-product-recommendations__media" href="{{ recommended_product.url }}" aria-label="{{ recommended_product.title | escape }}">
                {% if recommended_product.featured_image %}
                  {% if forloop.first %}
                    {{ recommended_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% else %}
                    {{ recommended_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% endif %}
                {% else %}
                  <span class="content-product-recommendations__placeholder" aria-hidden="true"></span>
                {% endif %}

                {% if block.settings.show_sale_badge and is_on_sale %}
                  <span class="content-product-recommendations__badge">
                    {{ block.settings.sale_badge_text | escape }}
                  </span>
                {% endif %}
              </a>

              <div class="content-product-recommendations__content">
                {% if block.settings.show_vendor and recommended_product.vendor != blank %}
                  <div class="content-product-recommendations__vendor">
                    {{ recommended_product.vendor | escape }}
                  </div>
                {% endif %}

                <h3 class="content-product-recommendations__title">
                  <a href="{{ recommended_product.url }}">
                    {{ recommended_product.title | escape }}
                  </a>
                </h3>

                {% if block.settings.show_price %}
                  <div class="content-product-recommendations__price-row">
                    <span class="content-product-recommendations__price">
                      {{ recommended_variant.price | money }}
                    </span>

                    {% if is_on_sale %}
                      <span class="content-product-recommendations__compare">
                        {{ recommended_variant.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.show_button %}
                  <a class="content-product-recommendations__button" href="{{ recommended_product.url }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}

      {% elsif source == 'manual' %}
        {% for recommended_product in block.settings.products limit: recommendation_limit %}
          {%- liquid
            assign rendered_products = rendered_products | plus: 1
            assign recommended_variant = recommended_product.selected_or_first_available_variant
            assign is_on_sale = false

            if recommended_variant.compare_at_price > recommended_variant.price
              assign is_on_sale = true
            endif
          -%}

          <article class="content-product-recommendations__item" data-content-product-recommendations-item>
            <div class="content-product-recommendations__card">
              <a class="content-product-recommendations__media" href="{{ recommended_product.url }}" aria-label="{{ recommended_product.title | escape }}">
                {% if recommended_product.featured_image %}
                  {% if forloop.first %}
                    {{ recommended_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% else %}
                    {{ recommended_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% endif %}
                {% else %}
                  <span class="content-product-recommendations__placeholder" aria-hidden="true"></span>
                {% endif %}

                {% if block.settings.show_sale_badge and is_on_sale %}
                  <span class="content-product-recommendations__badge">
                    {{ block.settings.sale_badge_text | escape }}
                  </span>
                {% endif %}
              </a>

              <div class="content-product-recommendations__content">
                {% if block.settings.show_vendor and recommended_product.vendor != blank %}
                  <div class="content-product-recommendations__vendor">
                    {{ recommended_product.vendor | escape }}
                  </div>
                {% endif %}

                <h3 class="content-product-recommendations__title">
                  <a href="{{ recommended_product.url }}">
                    {{ recommended_product.title | escape }}
                  </a>
                </h3>

                {% if block.settings.show_price %}
                  <div class="content-product-recommendations__price-row">
                    <span class="content-product-recommendations__price">
                      {{ recommended_variant.price | money }}
                    </span>

                    {% if is_on_sale %}
                      <span class="content-product-recommendations__compare">
                        {{ recommended_variant.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.show_button %}
                  <a class="content-product-recommendations__button" href="{{ recommended_product.url }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}

      {% elsif source == 'collection' and selected_collection != blank %}
        {% for recommended_product in selected_collection.products limit: recommendation_limit %}
          {%- liquid
            assign rendered_products = rendered_products | plus: 1
            assign recommended_variant = recommended_product.selected_or_first_available_variant
            assign is_on_sale = false

            if recommended_variant.compare_at_price > recommended_variant.price
              assign is_on_sale = true
            endif
          -%}

          <article class="content-product-recommendations__item" data-content-product-recommendations-item>
            <div class="content-product-recommendations__card">
              <a class="content-product-recommendations__media" href="{{ recommended_product.url }}" aria-label="{{ recommended_product.title | escape }}">
                {% if recommended_product.featured_image %}
                  {% if forloop.first %}
                    {{ recommended_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% else %}
                    {{ recommended_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% endif %}
                {% else %}
                  <span class="content-product-recommendations__placeholder" aria-hidden="true"></span>
                {% endif %}

                {% if block.settings.show_sale_badge and is_on_sale %}
                  <span class="content-product-recommendations__badge">
                    {{ block.settings.sale_badge_text | escape }}
                  </span>
                {% endif %}
              </a>

              <div class="content-product-recommendations__content">
                {% if block.settings.show_vendor and recommended_product.vendor != blank %}
                  <div class="content-product-recommendations__vendor">
                    {{ recommended_product.vendor | escape }}
                  </div>
                {% endif %}

                <h3 class="content-product-recommendations__title">
                  <a href="{{ recommended_product.url }}">
                    {{ recommended_product.title | escape }}
                  </a>
                </h3>

                {% if block.settings.show_price %}
                  <div class="content-product-recommendations__price-row">
                    <span class="content-product-recommendations__price">
                      {{ recommended_variant.price | money }}
                    </span>

                    {% if is_on_sale %}
                      <span class="content-product-recommendations__compare">
                        {{ recommended_variant.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.show_button %}
                  <a class="content-product-recommendations__button" href="{{ recommended_product.url }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_products == 0 and block.settings.show_empty_state %}
      <div class="content-product-recommendations__empty" data-content-product-recommendations-empty>
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.contentProductRecommendationsReady === 'true') return;

      root.dataset.contentProductRecommendationsReady = 'true';

      const items = root.querySelector('[data-content-product-recommendations-items]');
      const previousButton = root.querySelector('[data-content-product-recommendations-prev]');
      const nextButton = root.querySelector('[data-content-product-recommendations-next]');
      const emptyState = root.querySelector('[data-content-product-recommendations-empty]');
      const source = root.dataset.recommendationsSource;
      const url = root.dataset.recommendationsUrl;

      if (!items) return;

      const updateControls = () => {
        if (!previousButton && !nextButton) return;

        const maxScroll = items.scrollWidth - items.clientWidth - 2;

        if (previousButton) {
          previousButton.disabled = items.scrollLeft <= 2;
        }

        if (nextButton) {
          nextButton.disabled = items.scrollLeft >= maxScroll;
        }
      };

      const scrollCarousel = (direction) => {
        const firstItem = items.querySelector('[data-content-product-recommendations-item]');
        const amount = firstItem ? firstItem.getBoundingClientRect().width + 20 : items.clientWidth * 0.8;

        items.scrollBy({
          left: amount * direction,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      };

      if (previousButton) {
        previousButton.addEventListener('click', () => scrollCarousel(-1));
      }

      if (nextButton) {
        nextButton.addEventListener('click', () => scrollCarousel(1));
      }

      items.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateControls);
      }, { passive: true });

      items.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          scrollCarousel(-1);
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          scrollCarousel(1);
        }
      });

      const hydrateRecommendations = async () => {
        if (source !== 'recommendations' || !url) return;
        if (items.children.length > 0) return;

        root.classList.add('content-product-recommendations--is-loading');

        try {
          const response = await fetch(url);

          if (!response.ok) return;

          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const incomingRoot = doc.querySelector(`#${CSS.escape(root.id)}`);
          const incomingItems = incomingRoot ? incomingRoot.querySelector('[data-content-product-recommendations-items]') : null;

          if (incomingItems && incomingItems.children.length > 0) {
            items.innerHTML = incomingItems.innerHTML;

            if (emptyState) {
              emptyState.hidden = true;
            }
          }
        } catch (error) {
          return;
        } finally {
          root.classList.remove('content-product-recommendations--is-loading');
          updateControls();
        }
      };

      hydrateRecommendations();
      updateControls();
      window.addEventListener('resize', updateControls, { passive: true });
    })();
  </script>
</div>

