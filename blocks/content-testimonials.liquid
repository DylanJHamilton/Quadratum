        },
        {
          "value": "5",
          "label": "5 stars"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "testimonial_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "testimonial_2_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "testimonial_2_link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "testimonial_2_link_url",
