{%- comment -%}
  Quadratum — Social Media: Facebook Basic Feed
  File: sections/social-facebook-basic.liquid
  Root: .q-social-facebook-basic

  Purpose:
  Simple, low-maintenance Facebook Page embed using the official Page Plugin.
  • No Graph API
  • No tokens/secret keys
  • Reads from global Integrations where possible
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign g = settings -%}

{%- comment %}
  Global integrations / tokens
{%- endcomment -%}
{%- assign fb_url_global   = g.social_url_facebook -%}
{%- assign fb_page_id_glob = g.fb_page_id -%}
{%- assign feed_radius     = g.feed_card_radius | default: 16 -%}

{%- comment %}
  Effective Facebook Page URL:
  1. Section-level URL
  2. Global social_url_facebook
  3. Derived from fb_page_id
{%- endcomment -%}
{%- assign fb_page_url = s.facebook_page_url | default: fb_url_global -%}
{%- if fb_page_url == blank and fb_page_id_glob != blank and fb_page_id_glob != 'none' -%}
  {%- assign fb_page_url = 'https://www.facebook.com/' | append: fb_page_id_glob -%}
{%- endif -%}

{%- assign fb_protocol = fb_page_url | slice: 0, 8 -%}
{%- assign fb_host = fb_page_url | remove_first: 'https://' | split: '/' | first | downcase -%}
{%- unless fb_protocol == 'https://' -%}{%- assign fb_page_url = '' -%}{%- endunless -%}
{%- unless fb_host == 'facebook.com' or fb_host == 'www.facebook.com' or fb_host == 'm.facebook.com' -%}{%- assign fb_page_url = '' -%}{%- endunless -%}
{%- assign heading_id = section.id | append: '-heading' -%}
{%- assign embed_width = s.embed_width | default: 500 -%}

{% if fb_page_url != blank or request.design_mode %}
<section
  id="social-media-facebook-{{ section.id }}"
  class="q-social-facebook-basic"
  data-section-type="social-facebook-basic"
  role="region"
  style="--q-radius-feed: {{ feed_radius }}px;"
  {% if s.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% else %}
    aria-label="Facebook feed"
  {% endif %}
>
  <div class="q-layer">
    <div class="q-container{% if s.layout_style == 'full_bleed' %} q-container--full{% endif %}"{% unless s.layout_style == 'full_bleed' %} style="max-width: {{ s.max_width }}px;"{% endunless %}>

        {%- if s.heading != blank or s.body != blank -%}
          <div class="q-social-header">
            {%- if s.heading != blank -%}
              <h2 class="q-heading" id="{{ heading_id }}">{{ s.heading | escape }}</h2>
            {%- endif -%}
            {%- if s.body != blank -%}
              <p class="q-body">{{ s.body | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div
          class="q-social-embed-wrap{% if s.embed_alignment == 'left' %} is-align-left{% elsif s.embed_alignment == 'right' %} is-align-right{% else %} is-align-center{% endif %}"
          style="max-width: {{ embed_width | plus: 24 }}px;"
          {% if fb_page_url != blank %}
            aria-label="Facebook feed from {{ fb_page_url | replace: 'https://', '' | replace: 'http://', '' | escape }}"
          {% else %}
            aria-label="Facebook feed placeholder"
          {% endif %}
        >
          {%- if fb_page_url != blank -%}
            {%- comment %}
              Build Page Plugin iframe URL
            {%- endcomment -%}
            {%- if s.show_posts -%}
              {%- assign tabs_param = 'timeline' -%}
            {%- else -%}
              {%- assign tabs_param = '' -%}
            {%- endif -%}

            {%- if s.show_cover -%}
              {%- assign hide_cover_param = 'false' -%}
            {%- else -%}
              {%- assign hide_cover_param = 'true' -%}
            {%- endif -%}

            {%- if s.show_facepile -%}
              {%- assign show_facepile_param = 'true' -%}
            {%- else -%}
              {%- assign show_facepile_param = 'false' -%}
            {%- endif -%}

            {%- assign encoded_url = fb_page_url | url_encode -%}

            <iframe
              title="Facebook Page plugin"
              class="q-facebook-iframe"
              width="{{ embed_width }}"
              height="{{ s.embed_height }}"
              src="https://www.facebook.com/plugins/page.php?href={{ encoded_url }}{% if tabs_param != '' %}&tabs={{ tabs_param }}{% endif %}&width={{ embed_width }}&height={{ s.embed_height }}&hide_cover={{ hide_cover_param }}&show_facepile={{ show_facepile_param }}&adapt_container_width=true"
              style="border:none; overflow:hidden; width:100%;"
              scrolling="auto"
              frameborder="0"
              allow="encrypted-media; picture-in-picture; clipboard-write"
              loading="{% if s.lazyload_embed %}lazy{% else %}eager{% endif %}"
            ></iframe>

            <p class="q-social-fallback-link">
              <a href="{{ fb_page_url | escape }}" target="_blank" rel="noopener noreferrer">
                Open our Facebook page in a new tab
              </a>
            </p>
          {%- else -%}
            <p class="q-social-placeholder">
              Add your Facebook Page URL in this section or in
              <strong>Theme Settings → Integrations</strong>
              to show your Facebook feed here.
            </p>
          {%- endif -%}
        </div>
      </div>
  </div>

  <style>
    /* ===== Quadratum — Social Media: Facebook Basic Feed (scoped) ===== */
    #social-media-facebook-{{ section.id }}.q-social-facebook-basic {
      background: var(--c-bg, #ffffff);
      color: var(--c-text, #111827);
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-layer {
      padding-block: var(--q-section-pad-y, 3rem);
      padding-inline: var(--q-section-pad-x, 1.25rem);
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-container {
      margin-inline: auto;
      width: 100%;
      max-width: var(--q-section-max-w, 72rem);
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-container--full {
      max-width: none !important;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-header {
      margin-bottom: var(--space-lg, 1.5rem);
      max-width: 40rem;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-heading {
      margin: 0 0 0.5rem 0;
      font-size: var(--text-2xl, 1.5rem);
      line-height: 1.15;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-body {
      margin: 0;
      color: var(--c-muted, #4b5563);
      font-size: var(--text-base, 1rem);
      line-height: 1.6;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-embed-wrap {
      border-radius: var(--q-radius-feed, 16px);
      overflow: auto;
      background: var(--c-surface, var(--c-surface, #f3f4f6));
      padding: var(--space-md, 1rem);
      margin-inline: auto; /* default center */
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-embed-wrap.is-align-left {
      margin-inline-start: 0;
      margin-inline-end: auto;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-embed-wrap.is-align-center {
      margin-inline: auto;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-embed-wrap.is-align-right {
      margin-inline-start: auto;
      margin-inline-end: 0;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-facebook-iframe {
      width: 100%;
      max-width: 100%;
      min-height: 200px;
      display: block;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-fallback-link {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      color: var(--c-muted, #6b7280);
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-fallback-link a {
      color: var(--c-primary, #2563eb);
      text-decoration: underline;
    }

    #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-social-placeholder {
      margin: 0;
      font-size: 0.9375rem;
      color: var(--c-muted, #6b7280);
    }

    @media (max-width: 639.98px) {
      #social-media-facebook-{{ section.id }}.q-social-facebook-basic .q-layer {
        padding-inline: 1rem;
      }
    }
  </style>
</section>





{% endif %}
<style>
#social-media-facebook-{{ section.id }}{font-family:var(--font-body);overflow-wrap:anywhere}
#social-media-facebook-{{ section.id }} :is(h2,h3){font-family:var(--font-head)}
#social-media-facebook-{{ section.id }} *{box-sizing:border-box;min-width:0}
#social-media-facebook-{{ section.id }} :focus-visible{outline:2px solid currentColor;outline-offset:3px}
#social-media-facebook-{{ section.id }} :is(.q-text-left,.q-align-left,.q-section-heading--left){text-align:start}
#social-media-facebook-{{ section.id }} :is(.q-text-center,.q-align-center,.q-section-heading--center){text-align:center}
#social-media-facebook-{{ section.id }} .q-section__inner{max-width:var(--container-lg);margin-inline:auto;padding:var(--section-pt,48px) 20px var(--section-pb,48px)}
#social-media-facebook-{{ section.id }} :is(a,button){max-width:100%;white-space:normal}
#social-media-facebook-{{ section.id }} [hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){#social-media-facebook-{{ section.id }} *{transition:none!important;scroll-behavior:auto!important}}
</style>
{% schema %}
{
  "name": "Social Media - FB Basic",
  "tag": "section",
  "class": "q-social-facebook-basic",
  "settings": [
    {
      "type": "paragraph",
      "content": "Merchant-curated content and native links unless an explicit provider embed is configured. The theme does not fetch social posts, authorize accounts, verify claims or implement feed synchronization. Future feed/playlist choices are retained configuration placeholders, not connected integrations."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us on Facebook"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Stay connected with our latest updates, news, and offers on Facebook."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "contained",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full_bleed",
          "label": "Full bleed"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 768,
      "max": 1440,
      "step": 16,
      "default": 1152
    },
    {
      "type": "select",
      "id": "embed_alignment",
      "label": "Embed alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Facebook Page"
    },
    {
      "type": "url",
      "id": "facebook_page_url",
      "label": "Facebook Page URL (optional)",
      "info": "If left blank, the theme's Integrations \u2192 Facebook URL will be used."
    },
    {
      "type": "range",
      "id": "embed_width",
      "label": "Embed width (px)",
      "min": 320,
      "max": 500,
      "step": 10,
      "default": 500
    },
    {
      "type": "range",
      "id": "embed_height",
      "label": "Embed height (px)",
      "min": 200,
      "max": 900,
      "step": 20,
      "default": 520
    },
    {
      "type": "checkbox",
      "id": "show_cover",
      "label": "Show cover photo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facepile",
      "label": "Show friend faces",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_posts",
      "label": "Show timeline posts",
      "default": true
    },
    {
      "type": "header",
      "content": "Performance"
    },
    {
      "type": "checkbox",
      "id": "lazyload_embed",
      "label": "Lazy-load Facebook embed (HTML loading attribute only)",
      "default": true,
      "info": "Enable native lazy loading for the Facebook iframe."
    }
  ],
  "presets": [
    {
      "name": "Social Media - FB Basic",
      "category": "Social Media"
    }
  ]
}
{% endschema %}
