{% comment %}
  Supplier metaobject page. Field-based contract, allowing custom definition types.
  Requires a name/title text field; optional native image, text/rich text facts,
  website URL and catalog collection fields. No fulfillment APIs or assignment.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign supplier = metaobject
  assign supplier_name = supplier.name.value | default: supplier.title.value | default: '' | strip
  assign supplier_url = supplier.system.url
  assign logo_file = supplier.logo.value
  assign logo_obj = logo_file.preview_image
  if logo_obj == blank and logo_file.width != blank
    assign logo_obj = logo_file
  endif
  assign lead_time = supplier.default_lead_time.value
  assign regions = supplier.regions_served.value
  if supplier.regions_served.type == 'list.single_line_text_field'
    assign regions = regions | join: ', '
  endif
  assign website = supplier.website_url.value
  capture short_desc
    if supplier.short_description.value != blank
      if supplier.short_description.type == 'rich_text_field'
        echo supplier.short_description | metafield_tag
      else
        echo supplier.short_description.value | escape | newline_to_br
      endif
    endif
  endcapture
  capture notes
    if supplier.shipping_notes.value != blank
      if supplier.shipping_notes.type == 'rich_text_field'
        echo supplier.shipping_notes | metafield_tag
      else
        echo supplier.shipping_notes.value | escape | newline_to_br
      endif
    endif
  endcapture
  assign source_collection = ''
  if s.collection_source == 'metaobject'
    assign source_collection = supplier.catalog_collection.value
    if source_collection != blank and source_collection.products == nil
      assign source_collection = collections[source_collection]
    endif
  endif
  if source_collection == blank
    assign source_collection = s.fallback_collection
  endif
  if source_collection != blank and source_collection.products == nil
    assign source_collection = collections[source_collection]
  endif
  assign show_logo = false
  if s.show_logo and logo_obj != blank
    assign show_logo = true
  endif
  assign facts_count = 0
  capture facts
    if s.show_facts
      if s.show_lead_time and lead_time != blank
        assign facts_count = facts_count | plus: 1
        echo '<div class="q-supplier-fact" role="listitem">'
        if s.label_lead_time != blank
          echo '<div class="q-supplier-fact__k">'
          echo s.label_lead_time | escape
          echo '</div>'
        endif
        echo '<div class="q-supplier-fact__v">'
        echo lead_time | escape | newline_to_br
        echo '</div></div>'
      endif
      if s.show_regions and regions != blank
        assign facts_count = facts_count | plus: 1
        echo '<div class="q-supplier-fact" role="listitem">'
        if s.label_regions != blank
          echo '<div class="q-supplier-fact__k">'
          echo s.label_regions | escape
          echo '</div>'
        endif
        echo '<div class="q-supplier-fact__v">'
        echo regions | escape | newline_to_br
        echo '</div></div>'
      endif
      if s.show_shipping_notes and notes != blank
        assign facts_count = facts_count | plus: 1
        echo '<div class="q-supplier-fact" role="listitem">'
        if s.label_notes != blank
          echo '<div class="q-supplier-fact__k">'
          echo s.label_notes | escape
          echo '</div>'
        endif
        echo '<div class="q-supplier-fact__v">'
        echo notes
        echo '</div></div>'
      endif
    endif
  endcapture
  assign max_products = s.max_products | at_least: 4 | at_most: 24
  assign shadow_value = '0 12px 34px rgba(0,0,0,.12)'
  case s.card_shadow_strength
    when 'none'
      assign shadow_value = 'none'
    when 'medium'
      assign shadow_value = '0 16px 44px rgba(0,0,0,.16)'
    when 'strong'
      assign shadow_value = '0 20px 60px rgba(0,0,0,.22)'
  endcase
  assign accent_text = 'var(--c-oncolor,#fff)'
  if s.use_custom_colors
    capture accent_text
      render 'contrast-text', background: s.custom_accent_color, preferred: settings.text_on_color
    endcapture
  endif
-%}
{%- if supplier != blank and supplier_name != blank -%}
{{ 'card-product.css' | asset_url | stylesheet_tag }}
<section id="q-supplier-{{ section.id }}" class="q-section q-section--supplier-detail q-supplier-layout--{{ s.layout_style }} q-supplier-align--{{ s.alignment }}" aria-labelledby="q-supplier-heading-{{ section.id }}" style="
  --q-sup-pad-y:{{ s.padding_y | times: 0.01 }}rem;--q-sup-pad-x:{{ s.padding_x | times: 0.01 }}rem;
  --q-sup-radius:{{ s.card_radius }}px;--q-sup-shadow:{{ shadow_value }};--q-sup-cols:{{ s.columns_desktop }};--q-sup-facts:{{ facts_count }};
  --q-sup-accent-text:{{ accent_text }};
  {% if s.use_custom_colors %}
    --q-sup-bg:{{ s.custom_bg_color }};--q-sup-surface:{{ s.custom_surface_color }};--q-sup-text:{{ s.custom_text_color }};--q-sup-muted:{{ s.custom_muted_text_color }};--q-sup-border:{{ s.custom_border_color }};--q-sup-accent:{{ s.custom_accent_color }};--q-sup-highlight:{{ s.custom_highlight_bg_color }};
  {% else %}
    --q-sup-bg:var(--c-bg,#fff);--q-sup-surface:var(--c-surface,#f5f5f5);--q-sup-text:var(--c-text,#111827);--q-sup-muted:var(--c-muted,#666);--q-sup-border:var(--c-border,#d1d5db);--q-sup-accent:var(--c-primary,#2563eb);--q-sup-highlight:var(--c-surface,#f5f5f5);
  {% endif %}
  --q-card-product-bg:var(--q-sup-surface);--q-card-product-text:var(--q-sup-text);--q-card-product-muted:var(--q-sup-muted);--q-card-product-radius:var(--q-sup-radius);--q-card-product-accent:var(--q-sup-accent);">
  <div class="q-supplier-inner">
    <header class="q-card q-supplier-card q-supplier-hero">
      <div class="q-supplier-hero__grid{% if show_logo %} q-supplier-hero__grid--logo{% endif %}">
        {%- if show_logo -%}<div class="q-supplier-hero__logo" aria-hidden="true">{{ logo_obj | image_url: width: 440 | image_tag: loading: 'eager', class: 'q-supplier-hero__logo-img', alt: '' }}</div>{%- endif -%}
        <div class="q-supplier-hero__content">
          {%- if s.kicker_label != blank -%}<div class="q-supplier-hero__kicker q-kicker"><span class="q-supplier-pill">{{ s.kicker_label | escape }}</span></div>{%- endif -%}
          <h1 class="q-heading q-heading--xl q-supplier-hero__title" id="q-supplier-heading-{{ section.id }}">{{ supplier_name | escape }}</h1>
          {%- if s.show_short_description and short_desc != blank -%}<div class="q-supplier-hero__desc rte">{{ short_desc }}</div>{%- endif -%}
          {%- capture actions -%}
            {%- if s.show_website_button and website != blank and s.website_button_label != blank -%}<a class="q-btn q-btn--{{ s.website_button_variant }}" href="{{ website | escape }}" rel="nofollow">{{ s.website_button_label | escape }}</a>{%- endif -%}
            {%- if s.show_storefront_link and supplier_url != blank and s.storefront_button_label != blank -%}<a class="q-btn q-btn--{{ s.storefront_button_variant }}" href="{{ supplier_url | escape }}">{{ s.storefront_button_label | escape }}</a>{%- endif -%}
          {%- endcapture -%}
          {%- if actions != blank -%}<div class="q-supplier-hero__actions">{{ actions }}</div>{%- endif -%}
        </div>
      </div>
      {%- if facts_count > 0 -%}<div class="q-supplier-facts" role="list" aria-label="Supplier details">{{ facts }}</div>{%- endif -%}
    </header>
    {%- if s.show_product_grid -%}
      {%- if source_collection.products.size > 0 -%}
        <section class="q-supplier-products" aria-label="Supplier products">
          {%- capture collection_link -%}{%- if s.show_collection_link and source_collection.url != blank and s.collection_link_label != blank -%}<a class="q-btn q-btn--{{ s.collection_link_variant }}" href="{{ source_collection.url | escape }}">{{ s.collection_link_label | escape }}</a>{%- endif -%}{%- endcapture -%}
          {%- if s.products_heading != blank or collection_link != blank -%}<div class="q-supplier-products__head">{%- if s.products_heading != blank -%}<h2 class="q-heading q-heading--lg">{{ s.products_heading | escape }}</h2>{%- endif -%}{{ collection_link }}</div>{%- endif -%}
          <ul class="q-supplier-grid" role="list">
            {%- for p in source_collection.products limit: max_products -%}<li>{%- render 'card-product', product: p -%}</li>{%- endfor -%}
          </ul>
        </section>
      {%- elsif request.design_mode -%}<p role="status">Supplier catalog is empty or unconfigured. Connect a catalog_collection reference or choose the section collection.</p>{%- endif -%}
    {%- endif -%}
  </div>
  <style>

    /* ========= Quadratum — Supplier Detail (scoped) ========= */
    #q-supplier-{{ section.id }}{
      padding:var(--q-sup-pad-y) var(--q-sup-pad-x);
      font-family:var(--font-body,inherit);overflow-wrap:anywhere;
      background: var(--q-sup-bg);
      color: var(--q-sup-text);
      --q-card-product-shadow:var(--q-sup-shadow);
    }

    #q-supplier-{{ section.id }} .q-supplier-card{
      border: 1px solid var(--q-sup-border);
      border-radius: var(--q-sup-radius);
      box-shadow: var(--q-sup-shadow);
      background: var(--q-sup-surface);
      padding: clamp(1.15rem, 2vw, 1.8rem);
    }

    /* Layout variants */
    #q-supplier-{{ section.id }}.q-supplier-layout--strip .q-supplier-card{
      background: transparent;
      box-shadow: none;
      border-inline-start: 0;
      border-inline-end: 0;
      border-radius: 0;
      padding-inline: 0;
    }

    /* Hero */
    #q-supplier-{{ section.id }} .q-supplier-hero{
      position: relative;
      overflow: hidden;
    }
    #q-supplier-{{ section.id }} .q-supplier-hero::before{
      content: "";
      position: absolute;
      inset: -40% -20% auto -20%;
      height: 70%;
      background: var(--q-sup-highlight);
      opacity: .32;
      filter: blur(60px);
      pointer-events: none;
    }
    #q-supplier-{{ section.id }} .q-supplier-hero__grid{
      position: relative;
      display: grid;
      gap: clamp(1rem, 2vw, 1.6rem);
      align-items: start;
    }
    @media (min-width: 990px){
      #q-supplier-{{ section.id }} .q-supplier-hero__grid--logo{
        grid-template-columns: minmax(0,220px) minmax(0,1fr);
      }
    }

    #q-supplier-{{ section.id }}.q-supplier-align--center .q-supplier-hero{
      text-align: center;
    }
    #q-supplier-{{ section.id }}.q-supplier-align--center .q-supplier-hero__grid{
      justify-items: center;
    }
    #q-supplier-{{ section.id }}.q-supplier-align--left .q-supplier-hero{
      text-align: start;
    }

    #q-supplier-{{ section.id }} .q-supplier-hero__logo-img{
      width: 100%;
      height: auto;
      max-height: 140px;
      object-fit: contain;
      border-radius: max(0px,calc(var(--q-sup-radius) - 8px));
      background: rgba(255,255,255,.0);
    }

    #q-supplier-{{ section.id }} .q-supplier-pill{
      display: inline-flex;
      align-items: center;
      padding: .35rem .7rem;
      border-radius: 999px;
      border: 1px solid var(--q-sup-border);
      background: var(--q-sup-highlight);
      color: var(--q-sup-text);
    }

    #q-supplier-{{ section.id }} .q-supplier-hero__desc{
      max-width: 72ch;
      margin-inline: auto;
    }
    #q-supplier-{{ section.id }}.q-supplier-align--left .q-supplier-hero__desc{
      margin-inline: 0;
    }

    #q-supplier-{{ section.id }} .q-supplier-hero__actions{
      display: flex;
      flex-wrap: wrap;
      gap: .75rem;
      align-items: center;
      justify-content: center;
      margin-top: .65rem;
    }
    #q-supplier-{{ section.id }}.q-supplier-align--left .q-supplier-hero__actions{
      justify-content: flex-start;
    }

    /* Facts */
    #q-supplier-{{ section.id }} .q-supplier-facts{
      position: relative;
      margin-top: clamp(1rem, 2vw, 1.4rem);
      display: grid;
      gap: .75rem;
    }
    @media (min-width: 990px){
      #q-supplier-{{ section.id }} .q-supplier-facts{
        grid-template-columns: repeat(var(--q-sup-facts),minmax(0,1fr));
      }
    }
    #q-supplier-{{ section.id }} .q-supplier-fact{
      padding: .85rem .95rem;
      border: 1px solid var(--q-sup-border);
      border-radius: max(0px,calc(var(--q-sup-radius) - 8px));
      background: rgba(255,255,255,0.0);
    }
    #q-supplier-{{ section.id }} .q-supplier-fact__k{
      font-size: var(--q-fs-xs, .8125rem);
      color: var(--q-sup-muted);
      font-weight: 700;
      letter-spacing: .01em;
    }
    #q-supplier-{{ section.id }} .q-supplier-fact__v{
      margin-top: .25rem;
      font-size: var(--q-fs-sm, .875rem);
      line-height: 1.45;
      color: var(--q-sup-text);
    }

    /* Products */
    #q-supplier-{{ section.id }} .q-supplier-products{
      margin-top: clamp(1.25rem, 3vw, 2rem);
    }
    #q-supplier-{{ section.id }} .q-supplier-products__head{
      display: flex;
      flex-wrap: wrap;
      gap: .8rem 1rem;
      align-items: center;
      justify-content: space-between;
      margin-bottom: .85rem;
    }
    #q-supplier-{{ section.id }} .q-supplier-grid{
      display: grid;
      gap: var(--q-gap-lg, 1rem);
    }
    @media (min-width: 990px){
      #q-supplier-{{ section.id }} .q-supplier-grid{
        grid-template-columns: repeat(var(--q-sup-cols), minmax(0, 1fr));
      }
    }

    /* Empty */
    #q-supplier-{{ section.id }} .q-supplier-empty{
      margin-top: 1rem;
    }

    #q-supplier-{{ section.id }} .q-supplier-inner{box-sizing:border-box;max-width:var(--container-lg,1200px);margin-inline:auto;min-width:0}
    #q-supplier-{{ section.id }} .q-supplier-hero__content,#q-supplier-{{ section.id }} .q-supplier-hero__logo{min-width:0;width:100%}
    #q-supplier-{{ section.id }} .q-supplier-hero__logo{max-width:220px}
    #q-supplier-{{ section.id }} :is(h1,h2,h3){font-family:var(--font-head,inherit);color:inherit}
    #q-supplier-{{ section.id }} .q-supplier-hero__desc{color:var(--q-sup-muted)}
    #q-supplier-{{ section.id }} :is(.q-supplier-hero__desc,.q-supplier-fact__v) a{color:inherit;text-decoration:underline}
    #q-supplier-{{ section.id }} .q-supplier-fact,#q-supplier-{{ section.id }} .q-supplier-grid>*{min-width:0}
    #q-supplier-{{ section.id }} .q-supplier-grid{list-style:none;padding:0;margin:0}
    #q-supplier-{{ section.id }} .q-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;max-width:100%;box-sizing:border-box;padding:.7rem 1.1rem;border:1px solid transparent;border-radius:var(--q-sup-radius);font:inherit;text-align:center;text-decoration:none;white-space:normal;overflow-wrap:anywhere;transition:opacity .16s ease}
    #q-supplier-{{ section.id }} .q-btn--primary{background:var(--q-sup-accent);color:var(--q-sup-accent-text)}
    #q-supplier-{{ section.id }} .q-btn--secondary{background:var(--q-sup-surface);color:var(--q-sup-text);border-color:var(--q-sup-border)}
    #q-supplier-{{ section.id }} .q-btn--outline{background:transparent;color:var(--q-sup-accent);border-color:currentColor}
    #q-supplier-{{ section.id }} .q-btn--ghost{background:transparent;color:var(--q-sup-accent);text-decoration:underline;text-underline-offset:.2em}
    #q-supplier-{{ section.id }} .q-btn:hover{opacity:.85}
    #q-supplier-{{ section.id }} :focus-visible{outline:3px solid var(--q-sup-accent);outline-offset:3px}
    #q-supplier-{{ section.id }} .q-card-product:focus-visible{outline-offset:-3px}
    #q-supplier-{{ section.id }}.q-supplier-layout--strip{--q-card-product-shadow:none}
    @media(min-width:560px) and (max-width:989px){#q-supplier-{{ section.id }} .q-supplier-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(prefers-reduced-motion:reduce){#q-supplier-{{ section.id }} .q-btn{transition:none}}
  </style>
</section>
{%- elsif request.design_mode -%}
  <div role="status" style="padding:16px;border:1px dashed currentColor;">Supplier section: use an accessible metaobject page with a nonblank name or title text field. See this section's field setup guidance.</div>
{%- endif -%}

{% schema %}
{
  "name": "3P - Metaobjects",
  "settings": [
    {
      "type": "paragraph",
      "content": "Use a published, storefront-accessible metaobject page with name or title (text). Optional fields: logo (image file), short_description and shipping_notes (text/rich text), default_lead_time (text), regions_served (text or text list), website_url (URL), catalog_collection (collection reference). Definition setup and fulfillment are managed outside this section."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "kicker_label",
      "label": "Kicker label",
      "default": "Fulfillment partner"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "hero",
      "options": [
        {
          "value": "hero",
          "label": "Hero card"
        },
        {
          "value": "strip",
          "label": "Strip"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content toggles"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facts",
      "label": "Show fulfillment facts row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_lead_time",
      "label": "Show lead time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_regions",
      "label": "Show regions served",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_notes",
      "label": "Show shipping notes",
      "default": true
    },
    {
      "type": "text",
      "id": "label_lead_time",
      "label": "Lead time label",
      "default": "Lead time"
    },
    {
      "type": "text",
      "id": "label_regions",
      "label": "Regions label",
      "default": "Regions served"
    },
    {
      "type": "text",
      "id": "label_notes",
      "label": "Notes label",
      "default": "Shipping notes"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_website_button",
      "label": "Show website button (uses supplier.website_url)",
      "default": true
    },
    {
      "type": "text",
      "id": "website_button_label",
      "label": "Website button label",
      "default": "Visit supplier"
    },
    {
      "type": "select",
      "id": "website_button_variant",
      "label": "Website button style",
      "default": "secondary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_storefront_link",
      "label": "Show storefront metaobject page link (supplier.system.url)",
      "default": false
    },
    {
      "type": "text",
      "id": "storefront_button_label",
      "label": "Storefront button label",
      "default": "View supplier page"
    },
    {
      "type": "select",
      "id": "storefront_button_variant",
      "label": "Storefront button style",
      "default": "ghost",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "header",
      "content": "Products grid"
    },
    {
      "type": "checkbox",
      "id": "show_product_grid",
