{%- liquid
  assign block_id = 'content-logo-cloud-' | append: block.id

  assign alignment = block.settings.alignment | default: 'center'
  assign width = block.settings.width | default: 'auto'
  assign desktop_columns = block.settings.desktop_columns | default: '5'
  assign mobile_columns = block.settings.mobile_columns | default: '2'
  assign logo_count = block.settings.logo_count | default: 6

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile

  assign has_logo = false
-%}

<div
  id="{{ block_id }}"
  class="
    content-logo-cloud
    content-logo-cloud--grid
    content-logo-cloud--align-{{ alignment }}
    content-logo-cloud--width-{{ width }}
    {% unless show_desktop %} content-logo-cloud--hide-desktop{% endunless %}
    {% unless show_tablet %} content-logo-cloud--hide-tablet{% endunless %}
    {% unless show_mobile %} content-logo-cloud--hide-mobile{% endunless %}
    {% if block.settings.animation != 'none' %} content-logo-cloud--animate content-logo-cloud--animate-{{ block.settings.animation }}{% endif %}
  "
  style="
    --content-logo-cloud-desktop-columns: {{ desktop_columns }};
    --content-logo-cloud-mobile-columns: {{ mobile_columns }};
    --content-logo-cloud-margin-top: {{ block.settings.margin_top }}px;
    --content-logo-cloud-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-logo-cloud-padding-top: {{ block.settings.padding_top }}px;
    --content-logo-cloud-padding-bottom: {{ block.settings.padding_bottom }}px;
    --content-logo-cloud-padding-left: {{ block.settings.padding_left }}px;
    --content-logo-cloud-padding-right: {{ block.settings.padding_right }}px;
    --content-logo-cloud-gap: {{ block.settings.gap }}px;
    --content-logo-cloud-logo-padding: {{ block.settings.logo_padding }}px;
    --content-logo-cloud-logo-max-height: {{ block.settings.logo_max_height }}px;
    --content-logo-cloud-border-width: {{ block.settings.border_width }}px;
    --content-logo-cloud-border-radius: {{ block.settings.border_radius }}px;
    --content-logo-cloud-heading-color: {{ block.settings.heading_color }};
    --content-logo-cloud-text-color: {{ block.settings.text_color }};
    --content-logo-cloud-link-color: {{ block.settings.link_color }};
    --content-logo-cloud-background-color: {{ block.settings.background_color }};
    --content-logo-cloud-logo-background-color: {{ block.settings.logo_background_color }};
    --content-logo-cloud-border-color: {{ block.settings.border_color }};
    --content-logo-cloud-opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};
    --content-logo-cloud-hover-opacity: {{ block.settings.logo_hover_opacity | divided_by: 100.0 }};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-logo-cloud-margin-top);
      margin-bottom: var(--content-logo-cloud-margin-bottom);
      padding-top: var(--content-logo-cloud-padding-top);
      padding-bottom: var(--content-logo-cloud-padding-bottom);
      padding-left: var(--content-logo-cloud-padding-left);
      padding-right: var(--content-logo-cloud-padding-right);
      background: var(--content-logo-cloud-background-color);
      color: var(--content-logo-cloud-text-color);
    }

    #{{ block_id }}.content-logo-cloud--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-logo-cloud--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-logo-cloud--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-logo-cloud--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-logo-cloud--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-logo-cloud--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-logo-cloud--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-logo-cloud--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-logo-cloud__header {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: var(--content-logo-cloud-gap);
    }

    #{{ block_id }} .content-logo-cloud__eyebrow {
      margin: 0;
      color: var(--content-logo-cloud-link-color);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      line-height: 1.2;
      font-size: 0.78em;
    }

    #{{ block_id }} .content-logo-cloud__heading {
      margin: 0;
      color: var(--content-logo-cloud-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .content-logo-cloud__text {
      margin: 0;
      color: var(--content-logo-cloud-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-logo-cloud__text p {
      margin-top: 0;
    }

    #{{ block_id }} .content-logo-cloud__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-logo-cloud__grid {
      display: grid;
      grid-template-columns: repeat(var(--content-logo-cloud-desktop-columns), minmax(0, 1fr));
      gap: var(--content-logo-cloud-gap);
      width: 100%;
    }

    #{{ block_id }} .content-logo-cloud__item {
      min-width: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 96px;
      padding: var(--content-logo-cloud-logo-padding);
      background: var(--content-logo-cloud-logo-background-color);
      border: var(--content-logo-cloud-border-width) solid var(--content-logo-cloud-border-color);
      border-radius: var(--content-logo-cloud-border-radius);
      color: var(--content-logo-cloud-link-color);
      text-decoration: none;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-logo-cloud__item:hover {
      opacity: var(--content-logo-cloud-hover-opacity);
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-logo-cloud__logo {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: var(--content-logo-cloud-logo-max-height);
      object-fit: contain;
      opacity: var(--content-logo-cloud-opacity);
      transition: opacity 180ms ease, filter 180ms ease;
    }

    #{{ block_id }} .content-logo-cloud__item:hover .content-logo-cloud__logo {
      opacity: var(--content-logo-cloud-hover-opacity);
    }

    #{{ block_id }} .content-logo-cloud__placeholder {
      width: 100%;
      padding: 24px;
      border: 1px dashed rgba(0, 0, 0, 0.25);
      border-radius: 14px;
      text-align: center;
      color: rgba(0, 0, 0, 0.65);
      background: rgba(0, 0, 0, 0.03);
    }

    #{{ block_id }}.content-logo-cloud--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-logo-cloud--animate-fade {
      animation-name: contentLogoCloudFade;
    }

    #{{ block_id }}.content-logo-cloud--animate-fade-up {
      animation-name: contentLogoCloudFadeUp;
    }

    #{{ block_id }}.content-logo-cloud--animate-fade-down {
      animation-name: contentLogoCloudFadeDown;
    }

    #{{ block_id }}.content-logo-cloud--animate-fade-left {
      animation-name: contentLogoCloudFadeLeft;
    }

    #{{ block_id }}.content-logo-cloud--animate-fade-right {
      animation-name: contentLogoCloudFadeRight;
    }

    #{{ block_id }}.content-logo-cloud--animate-zoom {
      animation-name: contentLogoCloudZoom;
    }

    @keyframes contentLogoCloudFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentLogoCloudFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentLogoCloudFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentLogoCloudFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentLogoCloudFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentLogoCloudZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-logo-cloud--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-logo-cloud--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-logo-cloud__grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-logo-cloud--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-logo-cloud__grid {
        grid-template-columns: repeat(var(--content-logo-cloud-mobile-columns), minmax(0, 1fr));
      }

      #{{ block_id }} .content-logo-cloud__item {
        min-height: 82px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-logo-cloud--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-logo-cloud__item,
      #{{ block_id }} .content-logo-cloud__logo {
        transition: none;
      }

      #{{ block_id }} .content-logo-cloud__item:hover {
        transform: none;
      }
    }
  </style>

  {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
    <div class="content-logo-cloud__header">
      {% if block.settings.eyebrow != blank %}
        <p class="content-logo-cloud__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="content-logo-cloud__heading">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="content-logo-cloud__text">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="content-logo-cloud__grid">
    {%- for index in (1..16) -%}
      {%- if index <= logo_count -%}
        {%- liquid
          assign logo_key = 'logo_' | append: index | append: '_image'
          assign alt_key = 'logo_' | append: index | append: '_alt'
          assign link_key = 'logo_' | append: index | append: '_link'

          assign logo_image = block.settings[logo_key]
          assign logo_alt = block.settings[alt_key] | default: 'Logo'
          assign logo_link = block.settings[link_key]
        -%}

        {% if logo_image != blank %}
          {%- assign has_logo = true -%}

          {% if logo_link != blank %}
            <a class="content-logo-cloud__item" href="{{ logo_link }}" aria-label="{{ logo_alt | escape }}">
              {{
                logo_image
                | image_url: width: 420
                | image_tag:
                  class: 'content-logo-cloud__logo',
                  loading: 'lazy',
                  alt: logo_alt
              }}
            </a>
          {% else %}
            <div class="content-logo-cloud__item">
              {{
                logo_image
                | image_url: width: 420
                | image_tag:
                  class: 'content-logo-cloud__logo',
                  loading: 'lazy',
                  alt: logo_alt
              }}
            </div>
          {% endif %}
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% if request.design_mode and has_logo == false %}
    <div class="content-logo-cloud__placeholder">
      Add logo images to build your logo cloud.
    </div>
  {% endif %}
</div>

