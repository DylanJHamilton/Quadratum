{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation

  assign phone_href = 'tel:' | append: block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign email_href = 'mailto:' | append: block.settings.email
%}

<div
  class="
    qtm-location-info
    qtm-location-info-{{ block_id }}
    qtm-location-info--width-{{ block_width }}
    qtm-location-info--align-{{ block_alignment }}
    qtm-location-info--layout-{{ block.settings.layout_style }}
    qtm-location-info--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-location-info--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-location-info--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-location-info--hide-mobile{% endunless %}
  "
  style="
    --qtm-location-info-margin-top: {{ block.settings.margin_top }}px;
    --qtm-location-info-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-location-info-padding: {{ block.settings.padding }}px;
    --qtm-location-info-gap: {{ block.settings.gap }}px;
    --qtm-location-info-heading-color: {{ block.settings.heading_color }};
    --qtm-location-info-text-color: {{ block.settings.text_color }};
    --qtm-location-info-background-color: {{ block.settings.background_color }};
    --qtm-location-info-card-background: {{ block.settings.card_background_color }};
    --qtm-location-info-item-background: {{ block.settings.item_background_color }};
    --qtm-location-info-border-color: {{ block.settings.border_color }};
    --qtm-location-info-link-color: {{ block.settings.link_color }};
    --qtm-location-info-icon-background: {{ block.settings.icon_background_color }};
    --qtm-location-info-icon-color: {{ block.settings.icon_color }};
    --qtm-location-info-button-background: {{ block.settings.button_background_color }};
    --qtm-location-info-button-text: {{ block.settings.button_text_color }};
    --qtm-location-info-secondary-button-background: {{ block.settings.secondary_button_background_color }};
    --qtm-location-info-secondary-button-text: {{ block.settings.secondary_button_text_color }};
    --qtm-location-info-border-width: {{ block.settings.border_width }}px;
    --qtm-location-info-border-radius: {{ block.settings.border_radius }}px;
    --qtm-location-info-image-radius: {{ block.settings.image_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-location-info__inner">
    {% if block.settings.image != blank %}
      <div class="qtm-location-info__media">
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            class: 'qtm-location-info__image',
            widths: '360, 540, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: block.settings.image_alt
        }}

        {% if block.settings.image_badge != blank %}
          <div class="qtm-location-info__image-badge">
            {{ block.settings.image_badge | escape }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-location-info__card">
      {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
        <div class="qtm-location-info__header">
          {% if block.settings.eyebrow != blank %}
            <p class="qtm-location-info__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="qtm-location-info__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="qtm-location-info__text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="qtm-location-info__details" role="list">
        {% if block.settings.address != blank %}
          <div class="qtm-location-info__detail" role="listitem">
            {% if block.settings.show_icons %}
              <span class="qtm-location-info__icon" aria-hidden="true">
                {{ block.settings.address_icon | escape }}
              </span>
            {% endif %}

            <div class="qtm-location-info__detail-copy">
              <span class="qtm-location-info__label">
                {{ block.settings.address_label | escape }}
              </span>

              {% if block.settings.map_url != blank %}
                <a class="qtm-location-info__value qtm-location-info__value--link" href="{{ block.settings.map_url }}" target="_blank" rel="noopener">
                  {{ block.settings.address | newline_to_br }}
                </a>
              {% else %}
                <span class="qtm-location-info__value">
                  {{ block.settings.address | newline_to_br }}
                </span>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if block.settings.pickup_text != blank %}
          <div class="qtm-location-info__detail" role="listitem">
            {% if block.settings.show_icons %}
              <span class="qtm-location-info__icon" aria-hidden="true">
                {{ block.settings.pickup_icon | escape }}
              </span>
            {% endif %}

            <div class="qtm-location-info__detail-copy">
              <span class="qtm-location-info__label">
                {{ block.settings.pickup_label | escape }}
              </span>

              <span class="qtm-location-info__value">
                {{ block.settings.pickup_text | newline_to_br }}
              </span>
            </div>
          </div>
        {% endif %}

        {% if block.settings.phone != blank %}
          <div class="qtm-location-info__detail" role="listitem">
            {% if block.settings.show_icons %}
              <span class="qtm-location-info__icon" aria-hidden="true">
                {{ block.settings.phone_icon | escape }}
              </span>
            {% endif %}

            <div class="qtm-location-info__detail-copy">
              <span class="qtm-location-info__label">
                {{ block.settings.phone_label | escape }}
              </span>

              <a class="qtm-location-info__value qtm-location-info__value--link" href="{{ phone_href }}">
                {{ block.settings.phone | escape }}
              </a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.email != blank %}
          <div class="qtm-location-info__detail" role="listitem">
            {% if block.settings.show_icons %}
              <span class="qtm-location-info__icon" aria-hidden="true">
                {{ block.settings.email_icon | escape }}
              </span>
            {% endif %}

            <div class="qtm-location-info__detail-copy">
              <span class="qtm-location-info__label">
                {{ block.settings.email_label | escape }}
              </span>

              <a class="qtm-location-info__value qtm-location-info__value--link" href="{{ email_href }}">
                {{ block.settings.email | escape }}
              </a>
            </div>
          </div>
        {% endif %}
      </div>

      {% if block.settings.note != blank %}
        <div class="qtm-location-info__note">
          {{ block.settings.note }}
        </div>
      {% endif %}

      {% if block.settings.primary_button_label != blank and block.settings.primary_button_url != blank or block.settings.secondary_button_label != blank and block.settings.secondary_button_url != blank %}
        <div class="qtm-location-info__actions">
          {% if block.settings.primary_button_label != blank and block.settings.primary_button_url != blank %}
            <a class="qtm-location-info__button qtm-location-info__button--primary" href="{{ block.settings.primary_button_url }}" {% if block.settings.primary_button_new_tab %}target="_blank" rel="noopener"{% endif %}>
              {{ block.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if block.settings.secondary_button_label != blank and block.settings.secondary_button_url != blank %}
            <a class="qtm-location-info__button qtm-location-info__button--secondary" href="{{ block.settings.secondary_button_url }}" {% if block.settings.secondary_button_new_tab %}target="_blank" rel="noopener"{% endif %}>
              {{ block.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-location-info-{{ block_id }} {
    margin-top: var(--qtm-location-info-margin-top);
    margin-bottom: var(--qtm-location-info-margin-bottom);
    padding: var(--qtm-location-info-padding);
    color: var(--qtm-location-info-text-color);
    background: var(--qtm-location-info-background-color);
    border: var(--qtm-location-info-border-width) solid var(--qtm-location-info-border-color);
    border-radius: var(--qtm-location-info-border-radius);
  }

  .qtm-location-info-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--width-auto {
    width: auto;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--width-small {
    max-width: 640px;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--width-medium {
    max-width: 860px;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--width-large {
    max-width: 1120px;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__inner {
    display: grid;
    gap: var(--qtm-location-info-gap);
    align-items: stretch;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-split .qtm-location-info__inner {
    grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr);
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-card .qtm-location-info__inner,
  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-minimal .qtm-location-info__inner,
  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-banner .qtm-location-info__inner {
    grid-template-columns: 1fr;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-banner .qtm-location-info__card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--qtm-location-info-gap);
    align-items: center;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__media {
    position: relative;
    min-height: {{ block.settings.image_min_height }}px;
    overflow: hidden;
    border-radius: var(--qtm-location-info-image-radius);
    background: color-mix(in srgb, var(--qtm-location-info-border-color), transparent 70%);
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.image_min_height }}px;
    object-fit: cover;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__image-badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.4rem 0.75rem;
    color: var(--qtm-location-info-button-text);
    background: var(--qtm-location-info-button-background);
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__card {
    display: grid;
    gap: var(--qtm-location-info-gap);
    width: 100%;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-card .qtm-location-info__card,
  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-split .qtm-location-info__card,
  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-banner .qtm-location-info__card {
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--qtm-location-info-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-location-info-border-color), transparent 10%);
    border-radius: calc(var(--qtm-location-info-border-radius) * 0.75);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-minimal .qtm-location-info__card {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__header {
    display: grid;
    gap: 0.75rem;
    max-width: 740px;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-center .qtm-location-info__header {
    margin-inline: auto;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-right .qtm-location-info__header {
    margin-left: auto;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__eyebrow {
    margin: 0;
    color: var(--qtm-location-info-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__heading {
    margin: 0;
    color: var(--qtm-location-info-heading-color);
    line-height: 1.05;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__text,
  .qtm-location-info-{{ block_id }} .qtm-location-info__note {
    color: var(--qtm-location-info-text-color);
    line-height: 1.7;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__text p,
  .qtm-location-info-{{ block_id }} .qtm-location-info__note p {
    margin-top: 0;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__text p:last-child,
  .qtm-location-info-{{ block_id }} .qtm-location-info__note p:last-child {
    margin-bottom: 0;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__details {
    display: grid;
    grid-template-columns: repeat({{ block.settings.detail_columns }}, minmax(0, 1fr));
    gap: calc(var(--qtm-location-info-gap) * 0.5);
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-minimal .qtm-location-info__details {
    gap: 0.65rem;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__detail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    min-width: 0;
    padding: 0.9rem;
    background: var(--qtm-location-info-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-location-info-border-color), transparent 12%);
    border-radius: calc(var(--qtm-location-info-border-radius) * 0.5);
    text-align: left;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--layout-minimal .qtm-location-info__detail {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__icon {
    display: grid;
    place-items: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: var(--qtm-location-info-icon-color);
    background: var(--qtm-location-info-icon-background);
    border-radius: 999px;
    font-size: {{ block.settings.icon_font_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__detail-copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__label {
    color: var(--qtm-location-info-heading-color);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__value {
    color: var(--qtm-location-info-text-color);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__value--link {
    text-decoration: none;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__value--link:hover {
    color: var(--qtm-location-info-link-color);
    opacity: 0.78;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__value--link:focus-visible,
  .qtm-location-info-{{ block_id }} .qtm-location-info__button:focus-visible {
    outline: 3px solid var(--qtm-location-info-link-color);
    outline-offset: 4px;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__note {
    font-size: 0.92rem;
    opacity: 0.86;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-center .qtm-location-info__actions {
    justify-content: center;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--align-right .qtm-location-info__actions {
    justify-content: flex-end;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0.85rem 1.15rem;
    border-radius: calc(var(--qtm-location-info-border-radius) * 0.45);
    font-weight: 850;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__button--primary {
    color: var(--qtm-location-info-button-text);
    background: var(--qtm-location-info-button-background);
    border: 1px solid var(--qtm-location-info-button-background);
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__button--secondary {
    color: var(--qtm-location-info-secondary-button-text);
    background: var(--qtm-location-info-secondary-button-background);
    border: 1px solid color-mix(in srgb, var(--qtm-location-info-border-color), transparent 8%);
  }

  .qtm-location-info-{{ block_id }} .qtm-location-info__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--animation-fade {
    animation: qtm-location-info-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--animation-fade-up {
    animation: qtm-location-info-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--animation-fade-down {
    animation: qtm-location-info-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--animation-fade-left {
    animation: qtm-location-info-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--animation-fade-right {
    animation: qtm-location-info-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-location-info-{{ block_id }}.qtm-location-info--animation-zoom {
    animation: qtm-location-info-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-location-info-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-location-info-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-location-info-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-location-info-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-location-info-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-location-info-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-location-info-{{ block_id }}.qtm-location-info--hide-tablet {
      display: none !important;
    }

    .qtm-location-info-{{ block_id }}.qtm-location-info--layout-split .qtm-location-info__inner,
    .qtm-location-info-{{ block_id }}.qtm-location-info--layout-banner .qtm-location-info__card {
      grid-template-columns: 1fr;
    }

    .qtm-location-info-{{ block_id }} .qtm-location-info__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-location-info-{{ block_id }}.qtm-location-info--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-location-info-{{ block_id }} {
      padding: min(var(--qtm-location-info-padding), 24px);
    }

    .qtm-location-info-{{ block_id }}.qtm-location-info--hide-mobile {
      display: none !important;
    }

    .qtm-location-info-{{ block_id }} .qtm-location-info__details {
      grid-template-columns: 1fr;
    }

    .qtm-location-info-{{ block_id }}.qtm-location-info--layout-card .qtm-location-info__card,
    .qtm-location-info-{{ block_id }}.qtm-location-info--layout-split .qtm-location-info__card,
    .qtm-location-info-{{ block_id }}.qtm-location-info--layout-banner .qtm-location-info__card {
      padding: 1rem;
    }

    .qtm-location-info-{{ block_id }} .qtm-location-info__media,
    .qtm-location-info-{{ block_id }} .qtm-location-info__image {
      min-height: max(220px, {{ block.settings.image_min_height | minus: 80 }}px);
    }

    .qtm-location-info-{{ block_id }} .qtm-location-info__actions,
    .qtm-location-info-{{ block_id }} .qtm-location-info__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-location-info-{{ block_id }},
    .qtm-location-info-{{ block_id }} *,
