{% liquid
  assign block_id = block.id
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  if request.design_mode
    assign animation = 'none'
  endif
%}

{% assign has_content = false %}{% if block.settings.heading != blank or block.settings.text != blank or block.settings.eyebrow != blank %}{% assign has_content = true %}{% endif %}{% if block.settings.show_support_points %}{% if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank %}{% assign has_content = true %}{% endif %}{% endif %}{% if block.settings.button_label != blank and block.settings.button_url != blank %}{% assign has_content = true %}{% endif %}

<div
  class="
    qtm-guarantee-box
    qtm-guarantee-box-{{ block_id }}
    qtm-guarantee-box--width-{{ block_width }}
    qtm-guarantee-box--align-{{ block_alignment }}
    qtm-guarantee-box--layout-{{ block.settings.layout_style }}
    qtm-guarantee-box--animation-{{ animation }}
    {% unless block.settings.show_desktop or request.design_mode %} qtm-guarantee-box--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet or request.design_mode %} qtm-guarantee-box--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile or request.design_mode %} qtm-guarantee-box--hide-mobile{% endunless %}
  "
  style="
    --qtm-guarantee-box-margin-top: {{ block.settings.margin_top }}px;
    --qtm-guarantee-box-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-guarantee-box-padding: {{ block.settings.padding }}px;
    --qtm-guarantee-box-gap: {{ block.settings.gap }}px;
    --qtm-guarantee-box-heading-color: {{ block.settings.heading_color }};
    --qtm-guarantee-box-text-color: {{ block.settings.text_color }};
    --qtm-guarantee-box-background-color: {{ block.settings.background_color }};
    --qtm-guarantee-box-card-background: {{ block.settings.card_background_color }};
    --qtm-guarantee-box-border-color: {{ block.settings.border_color }};
    --qtm-guarantee-box-link-color: {{ block.settings.link_color }};
    --qtm-guarantee-box-icon-background: {{ block.settings.icon_background_color }};
    --qtm-guarantee-box-icon-color: {{ block.settings.icon_color }};
    --qtm-guarantee-box-button-background: {{ block.settings.button_background_color }};
    --qtm-guarantee-box-button-text: {{ block.settings.button_text_color }};
    --qtm-guarantee-box-accent-color: {{ block.settings.accent_color }};
    --qtm-guarantee-box-border-width: {{ block.settings.border_width }}px;
    --qtm-guarantee-box-border-radius: {{ block.settings.border_radius }}px;
  "
  {% unless has_content or request.design_mode %}hidden{% endunless %}
>
  {% if has_content == false and request.design_mode %}<p role="note">Add the actual terms and policy link that support your guarantee.</p>{% endif %}
  <div class="qtm-guarantee-box__inner">
    {% if block.settings.show_icon and block.settings.icon != blank %}
      <div class="qtm-guarantee-box__icon-wrap" aria-hidden="true">
        <span class="qtm-guarantee-box__icon">
          {{ block.settings.icon | escape }}
        </span>
      </div>
    {% endif %}

    <div class="qtm-guarantee-box__content">
      {% if block.settings.eyebrow != blank %}
        <p class="qtm-guarantee-box__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="qtm-guarantee-box__heading">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="qtm-guarantee-box__text">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% assign has_points = false %}{% if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank %}{% assign has_points = true %}{% endif %}
      {% if block.settings.show_support_points and has_points %}
        <ul class="qtm-guarantee-box__points" role="list">
          {% if block.settings.point_1 != blank %}
            <li class="qtm-guarantee-box__point">
              <span class="qtm-guarantee-box__point-icon" aria-hidden="true">{{ block.settings.point_icon | escape }}</span>
              <span>{{ block.settings.point_1 | escape }}</span>
            </li>
          {% endif %}

          {% if block.settings.point_2 != blank %}
            <li class="qtm-guarantee-box__point">
              <span class="qtm-guarantee-box__point-icon" aria-hidden="true">{{ block.settings.point_icon | escape }}</span>
              <span>{{ block.settings.point_2 | escape }}</span>
            </li>
          {% endif %}

          {% if block.settings.point_3 != blank %}
            <li class="qtm-guarantee-box__point">
              <span class="qtm-guarantee-box__point-icon" aria-hidden="true">{{ block.settings.point_icon | escape }}</span>
              <span>{{ block.settings.point_3 | escape }}</span>
            </li>
          {% endif %}
        </ul>
      {% endif %}

      {% if block.settings.button_label != blank and block.settings.button_url != blank %}
        <a class="qtm-guarantee-box__button" href="{{ block.settings.button_url | escape }}">
          {{ block.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-guarantee-box-{{ block_id }} {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    margin-top: var(--qtm-guarantee-box-margin-top);
    margin-bottom: var(--qtm-guarantee-box-margin-bottom);
    padding: min(var(--qtm-guarantee-box-padding), 12%);
    color: var(--qtm-guarantee-box-text-color);
    background: var(--qtm-guarantee-box-background-color);
    border: var(--qtm-guarantee-box-border-width) solid var(--qtm-guarantee-box-border-color);
    border-radius: var(--qtm-guarantee-box-border-radius);
  }

  .qtm-guarantee-box-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--width-auto {
    width: auto;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--width-small {
    max-width: 620px;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--width-medium {
    max-width: 860px;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--width-large {
    max-width: 1120px;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__inner {
    position: relative;
    display: grid;
    grid-template-columns: {% if block.settings.show_icon and block.settings.icon != blank %}auto {% endif %}minmax(0, 1fr);
    gap: var(--qtm-guarantee-box-gap);
    align-items: start;
    padding: clamp(1rem, 2vw, 1.5rem);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--qtm-guarantee-box-accent-color), transparent 90%),
        transparent 48%
      ),
      var(--qtm-guarantee-box-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-guarantee-box-border-color), transparent 8%);
    border-radius: calc(var(--qtm-guarantee-box-border-radius) * 0.75);
    overflow: hidden;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--layout-banner .qtm-guarantee-box__inner {
    align-items: center;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--layout-minimal .qtm-guarantee-box__inner {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--layout-bordered .qtm-guarantee-box__inner {
    background: transparent;
    border: 1px solid var(--qtm-guarantee-box-border-color);
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-center .qtm-guarantee-box__inner {
    justify-items: center;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-right .qtm-guarantee-box__inner {
    justify-items: end;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-center .qtm-guarantee-box__inner,
  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-center .qtm-guarantee-box__content {
    text-align: center;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-right .qtm-guarantee-box__inner,
  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-right .qtm-guarantee-box__content {
    text-align: right;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__icon-wrap {
    display: grid;
    place-items: center;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__icon {
    display: grid;
    place-items: center;
    width: min({{ block.settings.icon_size }}px, 20vw);
    height: {{ block.settings.icon_size }}px;
    color: var(--qtm-guarantee-box-icon-color);
    background: var(--qtm-guarantee-box-icon-background);
    border-radius: 999px;
    font-size: {{ block.settings.icon_font_size }}px;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 0.9rem 2rem color-mix(in srgb, var(--qtm-guarantee-box-icon-background), transparent 76%);
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__content {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__eyebrow {
    margin: 0;
    color: var(--qtm-guarantee-box-link-color);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__heading {
    margin: 0;
    color: var(--qtm-guarantee-box-heading-color);
    line-height: 1.08;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__text {
    color: var(--qtm-guarantee-box-text-color);
    line-height: 1.7;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__text p {
    margin-top: 0;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__points {
    display: grid;
    gap: 0.45rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__point {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    color: var(--qtm-guarantee-box-text-color);
    line-height: 1.45;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-center .qtm-guarantee-box__point {
    justify-content: center;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-right .qtm-guarantee-box__point {
    justify-content: flex-end;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__point-icon {
    color: var(--qtm-guarantee-box-accent-color);
    font-weight: 900;
    line-height: 1.45;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.8rem;
    margin-top: 0.25rem;
    padding: 0.82rem 1.15rem;
    color: var(--qtm-guarantee-box-button-text);
    background: var(--qtm-guarantee-box-button-background);
    border: 1px solid var(--qtm-guarantee-box-button-background);
    border-radius: calc(var(--qtm-guarantee-box-border-radius) * 0.45);
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-center .qtm-guarantee-box__button {
    justify-self: center;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--align-right .qtm-guarantee-box__button {
    justify-self: end;
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__button:focus-visible {
    outline: 3px solid var(--qtm-guarantee-box-link-color);
    outline-offset: 4px;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--animation-fade {
    animation: qtm-guarantee-box-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--animation-fade-up {
    animation: qtm-guarantee-box-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--animation-fade-down {
    animation: qtm-guarantee-box-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--animation-fade-left {
    animation: qtm-guarantee-box-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--animation-fade-right {
    animation: qtm-guarantee-box-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--animation-zoom {
    animation: qtm-guarantee-box-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-guarantee-box-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-guarantee-box-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-guarantee-box-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-guarantee-box-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-guarantee-box-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-guarantee-box-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {

  }

  @media screen and (min-width: 990px) {
    .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-guarantee-box-{{ block_id }} {
      padding: min(var(--qtm-guarantee-box-padding), 24px);
    }

    .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--hide-mobile {
      display: none !important;
    }

    .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__inner {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--layout-banner .qtm-guarantee-box__inner {
      grid-template-columns: {% if block.settings.show_icon and block.settings.icon != blank %}auto {% endif %}minmax(0, 1fr);
    }

    .qtm-guarantee-box-{{ block_id }} .qtm-guarantee-box__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-guarantee-box-{{ block_id }},
    .qtm-guarantee-box-{{ block_id }} *,
    .qtm-guarantee-box-{{ block_id }} *::before,
    .qtm-guarantee-box-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .qtm-guarantee-box-{{ block_id }}.qtm-guarantee-box--hide-tablet {
      display: none !important;
    }
  }
  .qtm-guarantee-box-{{ block_id }}[hidden] { display: none !important; }
  .qtm-guarantee-box-{{ block_id }}, .qtm-guarantee-box-{{ block_id }} * { box-sizing: border-box; }
  .qtm-guarantee-box-{{ block_id }} :is(div,article,ul,li,a,span) { min-width: 0; }
  .qtm-guarantee-box-{{ block_id }} :is(img,a,button) { max-width: 100%; }
</style>

{% schema %}
{
  "name": "Guarantee box",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "✓"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Merchant-authored terms. This block does not create a return, warranty or payment policy."
    },
    {
      "type": "checkbox",
      "id": "show_support_points",
      "label": "Show support points",
      "default": true
    },
    {
      "type": "text",
      "id": "point_icon",
      "label": "Support point icon",
      "default": "✓"
    },
    {
      "type": "text",
      "id": "point_1",
      "label": "Support point 1"
    },
    {
      "type": "text",
      "id": "point_2",
      "label": "Support point 2"
    },
    {
      "type": "text",
      "id": "point_3",
      "label": "Support point 3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View policy"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "icon_font_size",
      "label": "Icon font size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "card",
      "options": [
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "banner",
          "label": "Banner"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
