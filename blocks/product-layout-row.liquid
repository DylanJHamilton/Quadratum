{%- liquid
  assign columns = block.settings.columns | default: '2'
  assign row_tag = block.settings.row_tag | default: 'div'
  assign row_label = block.settings.accessibility_label
  assign mobile_behavior = block.settings.mobile_behavior | default: 'inherit'
  assign vertical_alignment = block.settings.vertical_alignment | default: 'inherit'

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<{{ row_tag }}
  id="qtm-product-layout-row-{{ block.id }}"
  class="
    qtm-product-layout-row
    qtm-product-layout-row--columns-{{ columns }}
    qtm-product-layout-row--mobile-{{ mobile_behavior }}
    qtm-product-layout-row--align-{{ vertical_alignment }}
    {% if block.settings.is_primary_product_row %} qtm-product-layout-row--primary{% endif %}
    {% unless show_desktop %} qtm-product-layout-row--hide-desktop{% endunless %}
    {% unless show_tablet %} qtm-product-layout-row--hide-tablet{% endunless %}
    {% unless show_mobile %} qtm-product-layout-row--hide-mobile{% endunless %}
  "
  {% if row_label != blank %}
    aria-label="{{ row_label | escape }}"
  {% endif %}
  style="
    --qtm-product-layout-row-column-gap: {{ block.settings.column_gap }}px;
    --qtm-product-layout-row-row-gap: {{ block.settings.row_gap }}px;
    --qtm-product-layout-row-margin-top: {{ block.settings.margin_top }}px;
    --qtm-product-layout-row-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-product-layout-row-padding-top: {{ block.settings.padding_top }}px;
    --qtm-product-layout-row-padding-bottom: {{ block.settings.padding_bottom }}px;
    --qtm-product-layout-row-padding-left: {{ block.settings.padding_left }}px;
    --qtm-product-layout-row-padding-right: {{ block.settings.padding_right }}px;
    --qtm-product-layout-row-background-color: {{ block.settings.background_color }};
    {% if block.settings.background_gradient != blank %}
      --qtm-product-layout-row-background: {{ block.settings.background_gradient }};
    {% else %}
      --qtm-product-layout-row-background: {{ block.settings.background_color }};
    {% endif %}
    --qtm-product-layout-row-border-width: {{ block.settings.border_width }}px;
    --qtm-product-layout-row-border-color: {{ block.settings.border_color }};
    --qtm-product-layout-row-radius: {{ block.settings.border_radius }}px;
    --qtm-product-layout-row-shadow: {% if block.settings.shadow %}0 18px 60px rgba(0, 0, 0, 0.10){% else %}none{% endif %};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #qtm-product-layout-row-{{ block.id }} {
      margin-top: var(--qtm-product-layout-row-margin-top);
      margin-bottom: var(--qtm-product-layout-row-margin-bottom);
      padding-top: var(--qtm-product-layout-row-padding-top);
      padding-bottom: var(--qtm-product-layout-row-padding-bottom);
      padding-left: var(--qtm-product-layout-row-padding-left);
      padding-right: var(--qtm-product-layout-row-padding-right);
      background: var(--qtm-product-layout-row-background, transparent);
      border: var(--qtm-product-layout-row-border-width, 0) solid var(--qtm-product-layout-row-border-color, transparent);
      border-radius: var(--qtm-product-layout-row-radius, 0);
      box-shadow: var(--qtm-product-layout-row-shadow, none);
      min-width: 0;
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row {
      display: grid;
      gap: var(--qtm-product-layout-row-column-gap, var(--qtm-product-block-section-column-gap, 24px));
      row-gap: var(--qtm-product-layout-row-row-gap, var(--qtm-product-block-section-row-gap, 32px));
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-1 {
      grid-template-columns: minmax(0, 1fr);
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-6 {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--align-inherit {
      align-items: var(--qtm-product-block-section-row-align, stretch);
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--align-top {
      align-items: start;
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--align-center {
      align-items: center;
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--align-bottom {
      align-items: end;
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--align-stretch {
      align-items: stretch;
    }

    #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--primary {
      isolation: isolate;
    }

    @media screen and (min-width: 990px) {
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--hide-tablet {
        display: none !important;
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-4,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-5,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--columns-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--hide-mobile {
        display: none !important;
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-inherit {
        grid-template-columns: minmax(0, 1fr);
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack.qtm-product-layout-row--columns-1,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack.qtm-product-layout-row--columns-2,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack.qtm-product-layout-row--columns-3,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack.qtm-product-layout-row--columns-4,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack.qtm-product-layout-row--columns-5,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-stack.qtm-product-layout-row--columns-6 {
        grid-template-columns: minmax(0, 1fr);
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-scroll {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(78%, 1fr);
        grid-template-columns: none;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: max(var(--qtm-product-layout-row-padding-bottom), 8px);
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-scroll > .qtm-product-layout-column {
        scroll-snap-align: start;
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-keep-grid.qtm-product-layout-row--columns-1 {
        grid-template-columns: minmax(0, 1fr);
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-keep-grid.qtm-product-layout-row--columns-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-keep-grid.qtm-product-layout-row--columns-3,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-keep-grid.qtm-product-layout-row--columns-4,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-keep-grid.qtm-product-layout-row--columns-5,
      #qtm-product-layout-row-{{ block.id }}.qtm-product-layout-row--mobile-keep-grid.qtm-product-layout-row--columns-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>

  {% content_for 'blocks' %}
</{{ row_tag }}>

{% schema %}
{
  "name": "Product layout row",
  "tag": null,
  "blocks": [
    {
      "type": "product-layout-column"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Row layout"
    },
    {
      "type": "select",
      "id": "row_tag",
      "label": "HTML tag",
      "default": "div",
      "options": [
        {
          "value": "div",
          "label": "Div"
        },
        {
          "value": "section",
          "label": "Section"
        },
        {
          "value": "article",
          "label": "Article"
        },
        {
          "value": "aside",
          "label": "Aside"
        }
      ]
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label"
    },
    {
      "type": "checkbox",
      "id": "is_primary_product_row",
      "label": "Primary product row",
      "default": false
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        },
        {
          "value": "6",
          "label": "6 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit section setting"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_behavior",
      "label": "Mobile behavior",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit section setting"
        },
        {
          "value": "stack",
          "label": "Stack"
        },
        {
          "value": "scroll",
          "label": "Scroll"
        },
        {
          "value": "keep-grid",
          "label": "Keep grid"
        }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Row spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Row style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product 2 column row",
      "settings": {
        "is_primary_product_row": true,
        "columns": "2",
        "vertical_alignment": "top",
        "mobile_behavior": "stack",
        "column_gap": 40,
        "row_gap": 32
      },
      "blocks": [
        {
          "type": "product-layout-column",
          "settings": {
            "column_type": "media"
          }
        },
        {
          "type": "product-layout-column",
          "settings": {
            "column_type": "content"
          }
        }
      ]
    },
    {
      "name": "Product 1 column row",
      "settings": {
        "is_primary_product_row": false,
        "columns": "1",
        "vertical_alignment": "stretch",
        "mobile_behavior": "inherit",
        "column_gap": 24,
        "row_gap": 32
      },
      "blocks": [
        {
          "type": "product-layout-column",
          "settings": {
            "column_type": "content"
          }
        }
      ]
    },
    {
      "name": "Product 3 column row",
      "settings": {
        "is_primary_product_row": false,
        "columns": "3",
        "vertical_alignment": "stretch",
        "mobile_behavior": "stack",
        "column_gap": 24,
        "row_gap": 24
      },
      "blocks": [
        {
          "type": "product-layout-column",
          "settings": {
            "column_type": "content"
          }
        },
        {
          "type": "product-layout-column",
          "settings": {
            "column_type": "trust"
          }
        },
        {
          "type": "product-layout-column",
          "settings": {
            "column_type": "content"
          }
        }
      ]
    }
  ]
}
{% endschema %}