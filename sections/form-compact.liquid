{% comment %}Configurable native/custom form; shared fields, scoped controller and independent host settings.{% endcomment %}

{{ 'forms-sections.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
{%- assign g = settings -%}
{%- assign form_surface_color = s.form_bg | default: g.bg_base | default: '#ffffff' -%}
{%- capture form_surface_text -%}{% render 'contrast-text', background: form_surface_color, preferred: g.text_base %}{%- endcapture -%}
{%- capture form_input_text -%}{% render 'contrast-text', background: '#ffffff', preferred: g.text_base %}{%- endcapture -%}


{%- comment -%} Captcha: inherit-aware + provider-aware key selection {%- endcomment -%}
{%- assign captcha_choice = s.captcha_mode | default: 'inherit' -%}
{%- assign eff_captcha_mode = captcha_choice -%}
{%- if eff_captcha_mode == blank or eff_captcha_mode == 'inherit' -%}
  {%- assign eff_captcha_mode = g.forms_captcha_provider | default: 'none' -%}
{%- endif -%}

{%- assign eff_captcha_key = s.captcha_site_key | default: '' -%}
{%- if eff_captcha_key == blank -%}
  {%- if eff_captcha_mode == 'turnstile' -%}
    {%- assign eff_captcha_key = g.captcha_turnstile_site_key | default: '' -%}
  {%- elsif eff_captcha_mode == 'recaptcha_v3' -%}
    {%- assign eff_captcha_key = g.captcha_recaptcha_site_key | default: '' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Tags + endpoint {%- endcomment -%}
{%- assign tags_theme   = g.forms_default_tags | default: 'form, web' -%}
{%- assign tags_section = s.hidden_tags | default: '' -%}
{%- assign eff_tags = tags_theme -%}
{%- if tags_section != blank -%}{%- assign eff_tags = tags_theme | append: ', ' | append: tags_section -%}{%- endif -%}

{%- assign eff_endpoint = s.endpoint_url -%}
{%- if eff_endpoint == blank and s.destination == 'custom_endpoint' -%}
  {%- assign eff_endpoint = g.forms_global_endpoint | default: '' -%}
{%- endif -%}

{%- comment -%} Button: inherit-aware, maps to q-btn class {%- endcomment -%}
{%- assign btn_choice = s.button_variant | default: 'inherit' -%}
{%- assign btn_variant = g.button_variant_default | default: 'solid' -%}
{%- if btn_choice != blank and btn_choice != 'inherit' -%}{%- assign btn_variant = btn_choice -%}{%- endif -%}
{%- assign btn_mode_class = 'q-btn--solid' -%}
{%- if btn_variant == 'outline' -%}{%- assign btn_mode_class = 'q-btn--outline' -%}{%- endif -%}
{%- if btn_variant == 'ghost' -%}{%- assign btn_mode_class = 'q-btn--ghost' -%}{%- endif -%}

{%- assign hide_m = s.hide_on_mobile -%}
{%- assign hide_d = s.hide_on_desktop -%}

{%- assign anchor_id = s.anchor_id | strip -%}

<script src="{{ 'frontend-form-logic-form-sections.js' | asset_url }}" defer></script>

<section
  data-q-form-host data-video-hero data-video-hero-mobile-query="(max-width: 767.98px)"
  id="{{ section.id }}"
  class="q-form-scope-{{ section.id }} q-form q-form--compact{% if hide_m and request.design_mode == false %} is-hidden-m hide-mobile{% endif %}{% if hide_d and request.design_mode == false %} is-hidden-d hide-desktop{% endif %} q-cta-quote-form"
  role="region"
  aria-label="{{ s.aria_label | default: 'Quote request form' | escape }}"
  data-template="{{ s.template_style | escape }}"
  data-surface="{{ s.surface_style | default: 'card' | escape }}"
  data-captcha="{{ eff_captcha_mode | escape }}"
  data-captcha-key="{{ eff_captcha_key | escape }}"
  data-btn-variant="{{ btn_mode_class | escape }}"
  data-msg-error="{{ s.error_text | escape }}"
  data-msg-success="{{ s.success_text | escape }}"
  data-marketing-app="{{ g.email_marketing_app | default: 'none' | escape }}"
  data-marketing-consent="{{ g.marketing_consent_mode | default: 'optional' | escape }}"
  data-marketing-double-opt-in="{{ g.marketing_double_opt_in | default: true, allow_false: true | escape }}"
  data-marketing-map-name="{{ g.marketing_map_name | default: true, allow_false: true | escape }}"
  data-marketing-map-phone="{{ g.marketing_map_phone | default: true, allow_false: true | escape }}"
  data-marketing-map-company="{{ g.marketing_map_company | default: true, allow_false: true | escape }}"
  data-utm-source="{{ g.marketing_utm_source | default: 'quote_form' | escape }}"
  data-utm-medium="{{ g.marketing_utm_medium | default: 'web' | escape }}"
  data-utm-campaign="{{ g.marketing_utm_campaign | default: 'lead_gen' | escape }}"
  data-proxy-forms="{{ g.proxy_forms_endpoint | default: g.forms_global_endpoint | default: '' | escape }}"
  data-proxy-marketing="{{ g.marketing_proxy_endpoint | default: '' | escape }}"
  style="
    --q-text: {{ g.text_base | default: '#111111' }};
    --q-muted: {{ g.text_muted | default: '#6b7280' }};
    --q-btn-bg: {{ g.color_primary | default: '#2563eb' }};
    --q-btn-fg: {{ g.text_on_color | default: '#ffffff' }};
    --q-btn-br: {{ g.button_radius | default: 12 }}px;
    --q-btn-bw: {{ g.button_border_width | default: 1 }}px;
    --q-error: {{ g.color_error | default: '#dc2626' }};
    --q-bg: {{ s.bg_color | default: '#ffffff' }};
    --q-pad-y: {{ s.padding_y | default: 48 | divided_by: 10.0 }}rem;
    --q-pad-x: {{ s.padding_x | default: 24 | divided_by: 10.0 }}rem;
    --q-card-radius: {{ s.card_radius | default: 16 }}px;
    --q-input-radius: {{ s.input_radius | default: 10 }}px;
    --q-input-border-w: {{ s.input_border | default: 1 }}px;
    --q-form-bg: {{ s.form_bg | default: '#ffffff' }};
    --q-bg-color: {{ s.bg_color | default: '#ffffff' }};
    background-color: var(--q-bg-color);
  "
>
  {%- if anchor_id != blank and anchor_id != section.id -%}
    <span id="{{ anchor_id | escape }}" class="q-anchor" aria-hidden="true"></span>
  {%- endif -%}

  {% render 'form-background', settings: s, providers: false %}

  <div class="{% if s.container_mode == 'full' %}q-wrap-full{% else %}q-wrap{% endif %}">
    {%- assign heading_tag = 'h2' -%}{%- if s.heading_level == 'h3' -%}{%- assign heading_tag = 'h3' -%}{%- endif -%}
    <div class="q-head">
      {% if s.kicker != blank %}<p class="q-kicker">{{ s.kicker | escape }}</p>{% endif %}
      {% if s.heading != blank %}<{{ heading_tag }} class="q-title">{{ s.heading | escape }}</{{ heading_tag }}>{% endif %}
      {% if s.subheading != blank %}<p class="q-sub">{{ s.subheading | escape }}</p>{% endif %}
    </div>

    {%- if s.template_style == 'split' and s.split_image != blank -%}
      <div class="q-split q-split--{{ s.split_media_side | default: 'right' }}">
        <div class="q-surface{% if s.surface_style != 'frameless' %} q-shadow-{{ s.card_shadow | default: 'md' }}{% else %} is-frameless{% endif %}" style="background: var(--q-form-bg); border-radius: var(--q-card-radius);">
          {%- render 'form-dispatch',
            id: section.id,
            settings: s,
            blocks: section.blocks,
            theme_settings: g,
            eff_captcha_mode: eff_captcha_mode,
            eff_captcha_key: eff_captcha_key,
            eff_endpoint_url: eff_endpoint,
            eff_tags: eff_tags,
            eff_marketing_app: g.email_marketing_app,
            eff_marketing_proxy: g.marketing_proxy_endpoint,
            eff_marketing_map_name: g.marketing_map_name,
            eff_marketing_map_phone: g.marketing_map_phone,
            eff_marketing_map_company: g.marketing_map_company,
            eff_marketing_consent_mode: g.marketing_consent_mode,
            eff_marketing_double_opt_in: g.marketing_double_opt_in,
            eff_utm_source: g.marketing_utm_source,
            eff_utm_medium: g.marketing_utm_medium,
            eff_utm_campaign: g.marketing_utm_campaign
          -%}
          <div data-q-steps class="q-steps-ui" aria-hidden="true">
            <div class="q-steps-bar"><span class="q-steps-fill"></span></div>
            <div class="q-steps-count"></div>
          </div>
        </div>

        <aside class="q-media">
          {% if s.split_image != blank %}
            {%- liquid
              assign qtm_image_alt = s.split_image.alt | default: s.heading
            -%}
            {{ s.split_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: qtm_image_alt }}
          {% endif %}
        </aside>
      </div>
    {%- else -%}
      <div class="q-surface{% if s.surface_style != 'frameless' %} q-shadow-{{ s.card_shadow | default: 'md' }}{% else %} is-frameless{% endif %}" style="background: var(--q-form-bg); border-radius: var(--q-card-radius);">
        {%- render 'form-dispatch',
          id: section.id,
          settings: s,
          blocks: section.blocks,
          theme_settings: g,
          eff_captcha_mode: eff_captcha_mode,
          eff_captcha_key: eff_captcha_key,
          eff_endpoint_url: eff_endpoint,
          eff_tags: eff_tags,
          eff_marketing_app: g.email_marketing_app,
          eff_marketing_proxy: g.marketing_proxy_endpoint,
          eff_marketing_map_name: g.marketing_map_name,
          eff_marketing_map_phone: g.marketing_map_phone,
          eff_marketing_map_company: g.marketing_map_company,
          eff_marketing_consent_mode: g.marketing_consent_mode,
          eff_marketing_double_opt_in: g.marketing_double_opt_in,
          eff_utm_source: g.marketing_utm_source,
          eff_utm_medium: g.marketing_utm_medium,
          eff_utm_campaign: g.marketing_utm_campaign
        -%}
        <div data-q-steps class="q-steps-ui" aria-hidden="true">
          <div class="q-steps-bar"><span class="q-steps-fill"></span></div>
          <div class="q-steps-count"></div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <style>
    .q-form-scope-{{ section.id }} { position: relative; padding: var(--q-pad-y) min(var(--q-pad-x), 8vw); overflow: hidden; }
    .q-form-scope-{{ section.id }} .q-anchor{ position: relative; top: -80px; height: 0; width: 0; display:block; visibility:hidden; }
    .q-form-scope-{{ section.id }} .q-overlay { position:absolute; inset:0; pointer-events:none; }
    .q-form-scope-{{ section.id }} .q-bg-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
    .q-form-scope-{{ section.id }} .q-wrap { max-width: var(--q-cont-lg, 72rem); margin: 0 auto; position: relative; z-index: 1; }
    .q-form-scope-{{ section.id }} .q-wrap-full { width: 100%; margin: 0; position: relative; z-index: 1; }
    .q-form-scope-{{ section.id }} .q-head { margin-bottom: var(--space-md, 1rem); }
    .q-form-scope-{{ section.id }} .q-kicker { color: var(--q-muted); font-weight: 600; margin: 0 0 .25rem 0; }
    .q-form-scope-{{ section.id }} .q-title { margin: 0 0 .5rem 0; line-height: 1.1; }
    .q-form-scope-{{ section.id }} .q-sub { color: var(--q-muted); margin: 0 0 1rem 0; }

    .q-form-scope-{{ section.id }} .q-surface { padding: var(--space-lg, 1.5rem); }
    .q-form-scope-{{ section.id }} .q-shadow-none { box-shadow: none; }
    .q-form-scope-{{ section.id }} .q-shadow-sm { box-shadow: 0 1px 2px rgba(0,0,0,.06); }
    .q-form-scope-{{ section.id }} .q-shadow-md { box-shadow: 0 6px 18px rgba(0,0,0,.08); }
    .q-form-scope-{{ section.id }} .q-shadow-lg { box-shadow: 0 12px 32px rgba(0,0,0,.12); }

    .q-form-scope-{{ section.id }}[data-surface="frameless"] .q-surface.is-frameless {
      background: transparent !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
    }

    .q-form-scope-{{ section.id }} .q-split { display: grid; gap: var(--space-md, 1rem); align-items: stretch; }
    @media (min-width: 768px){
      .q-form-scope-{{ section.id }} .q-split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
      .q-form-scope-{{ section.id }} .q-split--left > .q-media { order:-1; }
      }
    .q-form-scope-{{ section.id }} .q-media img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--q-card-radius); }

    /* Steps UI: present for JS, hidden unless Steps layout */
    .q-form-scope-{{ section.id }} .q-steps-ui{ display:none; margin-top: var(--space-md, 1rem); }
    .q-form-scope-{{ section.id }}[data-template="steps"] .q-steps-ui{ display:block; }

    /* Text-like controls only (prevents checkbox/radio from becoming full width) */
    .q-form-scope-{{ section.id }} input.q-input:not([type="checkbox"]):not([type="radio"]),
    .q-form-scope-{{ section.id }} select.q-select,
    .q-form-scope-{{ section.id }} textarea.q-textarea {
      width: 100%;
      border-radius: var(--q-input-radius);
      border: var(--q-input-border-w) solid var(--border-color, #e5e7eb);
      padding: .65rem .8rem;
      background: #fff;
      color: var(--q-text);
    }

    /* Checkbox/radio: inline-size and aligned next to label text */
    .q-form-scope-{{ section.id }} input.q-input[type="checkbox"],
    .q-form-scope-{{ section.id }} input.q-input[type="radio"]{
      width: auto !important;
      min-width: 1rem;
      max-width: 1rem;
      height: 1.05rem;
      padding: 0 !important;
      margin: 0;
      display: inline-block;
      vertical-align: middle;
      border-radius: 3px;
    }

    /* Invalid state: only outline text inputs/select/textarea */
    .q-form-scope-{{ section.id }} input.q-input:not([type="checkbox"]):not([type="radio"])[aria-invalid="true"],
    .q-form-scope-{{ section.id }} select.q-select[aria-invalid="true"],
    .q-form-scope-{{ section.id }} textarea.q-textarea[aria-invalid="true"]{
      outline: 1px solid var(--q-error, #dc2626);
      border-color: var(--q-error, #dc2626);
    }

    /* Invalid state for checkbox/radio: outline only the control */
    .q-form-scope-{{ section.id }} input.q-input[type="checkbox"][aria-invalid="true"],
    .q-form-scope-{{ section.id }} input.q-input[type="radio"][aria-invalid="true"]{
      outline: 2px solid var(--q-error, #dc2626);
      outline-offset: 2px;
    }

    @media (max-width: 767.98px){ .q-form-scope-{{ section.id }}.is-hidden-m { display:none !important; } }
    @media (min-width: 768px){ .q-form-scope-{{ section.id }}.is-hidden-d { display:none !important; } }

  .q-form-scope-{{ section.id }}{min-width:0;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-wrap,.q-form-scope-{{ section.id }} .q-wrap-full{box-sizing:border-box;}
  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface,.q-form-scope-{{ section.id }} .q-grid>*{min-width:0;max-width:100%;}
  .q-form-scope-{{ section.id }} .q-field{min-width:0;max-width:100%;text-align:start;}
  .q-form-scope-{{ section.id }} .q-radio{width:auto;max-width:100%;text-align:start;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-radio span{min-width:0;}
  .q-form-scope-{{ section.id }} .q-bg{background:var(--q-bg);}
  .q-form-scope-{{ section.id }} .q-bg .q-form-background-video{position:absolute;inset:0;width:100%;height:100%;border:0;}
  .q-form-scope-{{ section.id }} .q-bg .q-form-poster{width:100%;height:100%;object-fit:cover;}
  .q-form-scope-{{ section.id }} .q-bg [hidden]{display:none !important;}
  .q-form-scope-{{ section.id }} .q-form-video-toggle{position:absolute;z-index:2;inset-inline-end:12px;bottom:12px;padding:8px 12px;border:1px solid currentColor;border-radius:4px;background:#fff;color:#111;max-width:calc(100% - 24px);}
  .q-form-scope-{{ section.id }} :is(button,a,input,select,textarea):focus-visible{outline:2px solid currentColor;outline-offset:3px;}
  .q-form-scope-{{ section.id }} .q-step{grid-column:1 / -1;min-width:0;}
  .q-form-scope-{{ section.id }} .q-step-heading{width:100%;}
  .q-form-scope-{{ section.id }} [data-q-submit]{grid-column:1 / -1;max-width:100%;}
  @media(max-width:767.98px){.q-form-scope-{{ section.id }}.hide-mobile{display:none;}}
  @media(min-width:768px){.q-form-scope-{{ section.id }}.hide-desktop{display:none;}}
  @media(prefers-reduced-motion:reduce){.q-form-scope-{{ section.id }} .q-btn{transition:none;}}
  .q-form-scope-{{ section.id }} .q-wrap,.q-form-scope-{{ section.id }} .q-wrap-full{padding:0;}
  .q-form-scope-{{ section.id }} .q-fields > .q-field{width:100%;}

  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface{--q-text:{{ form_surface_text | strip }};--q-muted:{{ form_surface_text | strip }};}
  .q-form-scope-{{ section.id }}[data-surface="frameless"] .q-card,.q-form-scope-{{ section.id }}[data-surface="frameless"] .q-surface{--q-text:{{ g.text_base | default: '#111111' }};--q-muted:{{ g.text_muted | default: '#6b7280' }};}
  .q-form-scope-{{ section.id }} input.q-input,.q-form-scope-{{ section.id }} select.q-select,.q-form-scope-{{ section.id }} textarea.q-textarea{color:{{ form_input_text | strip }};box-sizing:border-box;max-width:100%;}
  .q-form-scope-{{ section.id }}{--q-btn-hover-op:{{ g.button_hover_opacity | default: 92 }};--q-btn-active-scale:{{ g.button_active_scale | default: 98 | divided_by: 100.0 }};}
  {% if g.font_heading %}.q-form-scope-{{ section.id }} .q-head :is(h2,h3){font-family:{{ g.font_heading.family }},{{ g.font_heading.fallback_families }};}{% endif %}
</style>
</section>

{% schema %}
{  "name": "Forms – Compact", "tag": "section", "class": "q-form q-form--compact",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Quote request form" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "template_style", "label": "Template style", "default": "card", "options": [
      { "value": "card", "label": "Card" }, { "value": "split", "label": "Split" }, { "value": "steps", "label": "Steps" }
    ]},
    { "type": "select", "id": "surface_style", "label": "Surface", "default": "card", "options": [
      { "value": "card", "label": "Card surface" }, { "value": "frameless", "label": "Frameless (no card)" }
    ]},
    { "type": "select", "id": "split_media_side", "label": "Split media side", "default": "right", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ]},
    { "type": "image_picker", "id": "split_image", "label": "Split media image" },

    { "type": "header", "content": "Background & Overlay (root only)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "url", "id": "bg_video", "label": "Background video URL" , "info": "Decorative background; image/color remains without playback. Provide an HTTPS URL. Videos must allow embedding."},
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "select", "id": "overlay_type", "label": "Overlay type", "default": "none", "options": [
      { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid" }, { "value": "gradient", "label": "Gradient" }
    ]},
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity (×100)", "min": 0, "max": 100, "step": 1, "default": 24 },
    { "type": "color", "id": "gradient_from", "label": "Gradient from", "default": "#000000" },
    { "type": "color", "id": "gradient_to", "label": "Gradient to", "default": "#000000" },
    { "type": "range", "id": "gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 5, "default": 0 },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Request a quote" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get a Fast, Accurate Quote" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "default": "h2", "options": [
      { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
    ]},
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Tell us a few details and we’ll reply within 1 business day." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks! Your request has been sent." },
    { "type": "text", "id": "error_text", "label": "Error message", "default": "Please fix the highlighted fields and try again." },

    { "type": "header", "content": "Destination" },
    { "type": "select", "id": "destination", "label": "Submission destination", "default": "shopify_contact", "options": [
      { "value": "shopify_contact", "label": "Shopify Contact" },
      { "value": "shopify_customer", "label": "Shopify marketing signup" },
      { "value": "custom_endpoint", "label": "Custom endpoint" }
    ], "info": "Contact sends inquiries. Customer mode subscribes email to marketing and does not deliver all quote fields. Custom endpoints must process their own submissions."},
    { "type": "text", "id": "endpoint_url", "label": "Custom endpoint URL (overrides global)" },
    { "type": "text", "id": "hidden_tags", "label": "Hidden tags (comma-separated)", "default": "form, web, quote-full" },

    { "type": "header", "content": "Captcha" },
    { "type": "select", "id": "captcha_mode", "label": "Captcha mode (overrides global)", "default": "inherit", "options": [
      { "value": "inherit", "label": "Inherit from Theme → Integrations" },
      { "value": "none", "label": "None" },
      { "value": "turnstile", "label": "Cloudflare Turnstile" },
      { "value": "recaptcha_v3", "label": "reCAPTCHA v3" }
    ], "info": "Custom endpoints only. Native Shopify forms use Shopify captcha. Your endpoint must verify provider tokens on the server."},
    { "type": "text", "id": "captcha_site_key", "label": "Captcha site key (override)" },

    { "type": "header", "content": "Button & Inputs" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request Quote" },
    { "type": "select", "id": "button_variant", "label": "Button variant", "default": "inherit", "options": [
      { "value": "inherit", "label": "Inherit (theme default)" },
      { "value": "solid", "label": "Solid" },
      { "value": "outline", "label": "Outline" },
      { "value": "ghost", "label": "Ghost" }
    ]},
    { "type": "color", "id": "form_bg", "label": "Form surface color", "default": "#ffffff" },
    { "type": "range", "id": "input_radius", "label": "Input radius (px)", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "input_border", "label": "Input border (px)", "min": 0, "max": 3, "step": 1, "default": 1 },

