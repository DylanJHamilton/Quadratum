{%- liquid
  assign block_id = 'product-gallery-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant
  assign current_media = current_variant.featured_media | default: product_context.featured_media

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign gallery_mode = block.settings.gallery_mode | default: 'slider'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign media_count = product_context.media.size
-%}

{% if media_count > 0 %}
  <div
    id="{{ block_id }}"
    class="
      product-gallery
      product-gallery--{{ gallery_mode }}
      product-gallery--width-{{ width }}
      product-gallery--align-{{ alignment }}
      product-gallery--thumbs-{{ block.settings.thumbnail_position }}
      {% unless show_on_desktop %} product-gallery--hide-desktop{% endunless %}
      {% unless show_on_tablet %} product-gallery--hide-tablet{% endunless %}
      {% unless show_on_mobile %} product-gallery--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' %} product-gallery--animate product-gallery--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-gallery-margin-top: {{ block.settings.margin_top }}px;
      --product-gallery-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-gallery-padding: {{ block.settings.padding }}px;
      --product-gallery-gap: {{ block.settings.media_gap }}px;
      --product-gallery-main-ratio: {{ block.settings.main_media_ratio | divided_by: 100.0 }};
      --product-gallery-media-radius: {{ block.settings.media_radius }}px;
      --product-gallery-thumbnail-radius: {{ block.settings.thumbnail_radius }}px;
      --product-gallery-border-width: {{ block.settings.media_border_width }}px;
      --product-gallery-border-color: {{ block.settings.media_border_color }};
      --product-gallery-background: {{ block.settings.media_background }};
      --product-gallery-thumbnail-size: {{ block.settings.thumbnail_size }}px;
      --product-gallery-thumbnail-border: {{ block.settings.thumbnail_border_color }};
      --product-gallery-thumbnail-active: {{ block.settings.thumbnail_active_color }};
      --product-gallery-arrow-background: {{ block.settings.arrow_background }};
      --product-gallery-arrow-text: {{ block.settings.arrow_text_color }};
      --product-gallery-dot-color: {{ block.settings.dot_color }};
      --product-gallery-dot-active: {{ block.settings.dot_active_color }};
      --product-gallery-masonry-columns-desktop: {{ block.settings.masonry_columns_desktop }};
      --product-gallery-masonry-columns-tablet: {{ block.settings.masonry_columns_tablet }};
      --product-gallery-masonry-columns-mobile: {{ block.settings.masonry_columns_mobile }};
      --product-gallery-grid-columns-desktop: {{ block.settings.gallery_columns_desktop }};
      --product-gallery-grid-columns-mobile: {{ block.settings.gallery_columns_mobile }};
    "
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-product-gallery
    data-gallery-mode="{{ gallery_mode }}"
    data-autoplay="{{ block.settings.enable_autoplay }}"
    data-autoplay-speed="{{ block.settings.autoplay_speed }}"
    {{ block.shopify_attributes }}
  >
    <style>
      #{{ block_id }} {
        width: 100%;
        margin-top: var(--product-gallery-margin-top);
        margin-bottom: var(--product-gallery-margin-bottom);
        padding: var(--product-gallery-padding);
      }

      #{{ block_id }}.product-gallery--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-gallery--width-small {
        max-width: 720px;
      }

      #{{ block_id }}.product-gallery--width-medium {
        max-width: 960px;
      }

      #{{ block_id }}.product-gallery--width-large {
        max-width: 1200px;
      }

      #{{ block_id }}.product-gallery--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-gallery--align-left {
        margin-left: 0;
        margin-right: auto;
      }

      #{{ block_id }}.product-gallery--align-center {
        margin-left: auto;
        margin-right: auto;
      }

      #{{ block_id }}.product-gallery--align-right {
        margin-left: auto;
        margin-right: 0;
      }

      #{{ block_id }} .product-gallery__inner {
        position: relative;
        width: 100%;
        min-width: 0;
      }

      #{{ block_id }} .product-gallery__media-frame {
        position: relative;
        display: block;
        width: 100%;
        overflow: hidden;
        background: var(--product-gallery-background);
        border: var(--product-gallery-border-width) solid var(--product-gallery-border-color);
        border-radius: var(--product-gallery-media-radius);
        aspect-ratio: var(--product-gallery-main-ratio);
      }

      #{{ block_id }} .product-gallery__media-frame img,
      #{{ block_id }} .product-gallery__media-frame video,
      #{{ block_id }} .product-gallery__media-frame iframe,
      #{{ block_id }} .product-gallery__media-frame model-viewer {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: {{ block.settings.image_fit }};
      }

      #{{ block_id }} .product-gallery__media-frame iframe,
      #{{ block_id }} .product-gallery__media-frame model-viewer {
        border: 0;
      }

      #{{ block_id }} .product-gallery__media-type {
        position: absolute;
        right: 12px;
        bottom: 12px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        min-height: 34px;
        padding: 7px 9px;
        color: var(--product-gallery-arrow-text);
        background: var(--product-gallery-arrow-background);
        border-radius: 999px;
        font-size: 12px;
        line-height: 1;
        pointer-events: none;
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__viewport {
        position: relative;
        overflow: hidden;
        border-radius: var(--product-gallery-media-radius);
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__track {
        display: flex;
        transition: transform 360ms ease;
        will-change: transform;
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__slide {
        flex: 0 0 100%;
        min-width: 100%;
      }

      #{{ block_id }}.product-gallery--slider .product-gallery__slide[aria-hidden="true"] {
        visibility: hidden;
      }

      #{{ block_id }} .product-gallery__arrow {
        appearance: none;
        position: absolute;
        top: 50%;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: var(--product-gallery-arrow-text);
        background: var(--product-gallery-arrow-background);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        transform: translateY(-50%);
        transition: opacity 180ms ease, transform 180ms ease;
      }

      #{{ block_id }} .product-gallery__arrow:hover {
        opacity: 0.82;
        transform: translateY(-50%) scale(1.04);
      }

      #{{ block_id }} .product-gallery__arrow:focus-visible {
        outline: 2px solid var(--product-gallery-thumbnail-active);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-gallery__arrow--previous {
        left: 14px;
      }

      #{{ block_id }} .product-gallery__arrow--next {
        right: 14px;
      }

      #{{ block_id }} .product-gallery__dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 12px;
      }

      #{{ block_id }} .product-gallery__dot {
        appearance: none;
        width: 9px;
        height: 9px;
        padding: 0;
        background: var(--product-gallery-dot-color);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        opacity: 0.48;
      }

      #{{ block_id }} .product-gallery__dot.is-active {
        background: var(--product-gallery-dot-active);
        opacity: 1;
      }

      #{{ block_id }} .product-gallery__dot:focus-visible {
        outline: 2px solid var(--product-gallery-dot-active);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-gallery__thumbnails {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        overflow-x: auto;
        scrollbar-width: thin;
      }

      #{{ block_id }} .product-gallery__thumbnail {
        appearance: none;
        position: relative;
        flex: 0 0 var(--product-gallery-thumbnail-size);
        width: var(--product-gallery-thumbnail-size);
        height: var(--product-gallery-thumbnail-size);
        padding: 0;
        overflow: hidden;
        background: var(--product-gallery-background);
        border: 1px solid var(--product-gallery-thumbnail-border);
        border-radius: var(--product-gallery-thumbnail-radius);
        cursor: pointer;
      }

      #{{ block_id }} .product-gallery__thumbnail.is-active {
        border-color: var(--product-gallery-thumbnail-active);
        box-shadow: 0 0 0 1px var(--product-gallery-thumbnail-active);
      }

      #{{ block_id }} .product-gallery__thumbnail:focus-visible {
        outline: 2px solid var(--product-gallery-thumbnail-active);
        outline-offset: 3px;
      }

      #{{ block_id }} .product-gallery__thumbnail img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
      }

      #{{ block_id }} .product-gallery__thumbnail-badge {
        position: absolute;
        right: 4px;
        bottom: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        min-height: 20px;
        padding: 3px 5px;
        color: var(--product-gallery-arrow-text);
        background: var(--product-gallery-arrow-background);
        border-radius: 999px;
        font-size: 10px;
        line-height: 1;
      }

      #{{ block_id }}.product-gallery--gallery .product-gallery__grid {
        display: grid;
        grid-template-columns: repeat(var(--product-gallery-grid-columns-desktop), minmax(0, 1fr));
        gap: var(--product-gallery-gap);
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__masonry {
        column-count: var(--product-gallery-masonry-columns-desktop);
        column-gap: var(--product-gallery-gap);
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__masonry-item {
        display: inline-block;
        width: 100%;
        margin: 0 0 var(--product-gallery-gap);
        break-inside: avoid;
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__media-frame {
        aspect-ratio: auto;
      }

      #{{ block_id }}.product-gallery--masonry .product-gallery__media-frame img,
      #{{ block_id }}.product-gallery--masonry .product-gallery__media-frame video {
        height: auto;
        object-fit: cover;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__horizontal-layout {
        display: grid;
        grid-template-columns: var(--product-gallery-thumbnail-size) minmax(0, 1fr);
        gap: var(--product-gallery-gap);
        align-items: start;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-layout {
        grid-template-columns: minmax(0, 1fr) var(--product-gallery-thumbnail-size);
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-main {
        order: 1;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__vertical-thumbs {
        order: 2;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs {
        display: grid;
        gap: 8px;
        max-height: 680px;
        overflow-y: auto;
        scrollbar-width: thin;
      }

      #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs .product-gallery__thumbnail {
        width: var(--product-gallery-thumbnail-size);
        height: var(--product-gallery-thumbnail-size);
      }

      #{{ block_id }} .product-gallery__hidden {
        display: none !important;
      }

      #{{ block_id }}.product-gallery--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-gallery--animate-fade {
        animation-name: productGalleryFade;
      }

      #{{ block_id }}.product-gallery--animate-fade_up {
        animation-name: productGalleryFadeUp;
      }

      #{{ block_id }}.product-gallery--animate-zoom {
        animation-name: productGalleryZoom;
      }

      @keyframes productGalleryFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productGalleryFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productGalleryZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-gallery--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-gallery--hide-tablet {
          display: none !important;
        }

        #{{ block_id }}.product-gallery--masonry .product-gallery__masonry {
          column-count: var(--product-gallery-masonry-columns-tablet);
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }}.product-gallery--hide-mobile {
          display: none !important;
        }

        #{{ block_id }}.product-gallery--gallery .product-gallery__grid {
          grid-template-columns: repeat(var(--product-gallery-grid-columns-mobile), minmax(0, 1fr));
        }

        #{{ block_id }}.product-gallery--masonry .product-gallery__masonry {
          column-count: var(--product-gallery-masonry-columns-mobile);
        }

        #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__horizontal-layout,
        #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-layout {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
        }

        #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__horizontal-main,
        #{{ block_id }}.product-gallery--horizontal_thumbs.product-gallery--thumbs-right .product-gallery__vertical-thumbs {
          order: initial;
        }

        #{{ block_id }}.product-gallery--horizontal_thumbs .product-gallery__vertical-thumbs {
          display: flex;
          max-height: none;
          overflow-x: auto;
          overflow-y: hidden;
          margin-top: 10px;
        }

        #{{ block_id }} .product-gallery__arrow {
          width: 38px;
          height: 38px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-gallery--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }

        #{{ block_id }}.product-gallery--slider .product-gallery__track,
        #{{ block_id }} .product-gallery__arrow {
          transition: none;
        }
      }
    </style>

    <div class="product-gallery__inner">
      {% if gallery_mode == 'slider' %}
        <div class="product-gallery__viewport" data-product-gallery-viewport>
          <div class="product-gallery__track" data-product-gallery-track>
            {% for media in product_context.media %}
              <div
                class="product-gallery__slide"
                data-product-gallery-slide
                data-media-id="{{ media.id }}"
                aria-hidden="{% if media.id == current_media.id or forloop.first and current_media == blank %}false{% else %}true{% endif %}"
              >
                <div class="product-gallery__media-frame">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{ media | image_url: width: 1800 | image_tag: loading: forloop.first | default: 'eager', widths: '400, 600, 800, 1000, 1400, 1800', alt: media.alt | default: product_context.title }}
                    {% when 'video' %}
                      {{ media | video_tag: image_size: '1200x', controls: true, muted: block.settings.mute_videos, playsinline: true }}
                      <span class="product-gallery__media-type">Video</span>
                    {% when 'external_video' %}
                      {{ media | external_video_tag }}
                      <span class="product-gallery__media-type">Video</span>
                    {% when 'model' %}
                      {{ media | model_viewer_tag }}
                      <span class="product-gallery__media-type">3D</span>
                  {% endcase %}
                </div>
              </div>
            {% endfor %}
          </div>

          {% if block.settings.show_arrows and media_count > 1 %}
            <button type="button" class="product-gallery__arrow product-gallery__arrow--previous" data-product-gallery-prev aria-label="{{ block.settings.previous_label | escape }}">‹</button>
            <button type="button" class="product-gallery__arrow product-gallery__arrow--next" data-product-gallery-next aria-label="{{ block.settings.next_label | escape }}">›</button>
          {% endif %}
        </div>

        {% if block.settings.show_dots and media_count > 1 %}
          <div class="product-gallery__dots" aria-label="{{ block.settings.dots_label | escape }}">
            {% for media in product_context.media %}
              <button
                type="button"
                class="product-gallery__dot {% if media.id == current_media.id or forloop.first and current_media == blank %}is-active{% endif %}"
                data-product-gallery-dot
                data-index="{{ forloop.index0 }}"
                aria-label="{{ block.settings.go_to_slide_label | escape }} {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.show_thumbnails and media_count > 1 %}
          <div class="product-gallery__thumbnails" aria-label="{{ block.settings.thumbnails_label | escape }}">
            {% for media in product_context.media %}
              <button
                type="button"
                class="product-gallery__thumbnail {% if media.id == current_media.id or forloop.first and current_media == blank %}is-active{% endif %}"
                data-product-gallery-thumbnail
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                aria-label="{{ block.settings.go_to_slide_label | escape }} {{ forloop.index }}"
              >
                {% if media.preview_image %}
                  {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: media.alt | default: product_context.title }}
                {% endif %}
                {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                  <span class="product-gallery__thumbnail-badge">▶</span>
                {% elsif media.media_type == 'model' %}
                  <span class="product-gallery__thumbnail-badge">3D</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}

      {% elsif gallery_mode == 'gallery' %}
        <div class="product-gallery__grid">
          {% for media in product_context.media %}
            <div class="product-gallery__grid-item" data-media-id="{{ media.id }}">
              <div class="product-gallery__media-frame">
                {% case media.media_type %}
                  {% when 'image' %}
                    {{ media | image_url: width: 1400 | image_tag: loading: forloop.first | default: 'eager', widths: '400, 600, 800, 1000, 1400', alt: media.alt | default: product_context.title }}
                  {% when 'video' %}
                    {{ media | video_tag: image_size: '1000x', controls: true, muted: block.settings.mute_videos, playsinline: true }}
                    <span class="product-gallery__media-type">Video</span>
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                    <span class="product-gallery__media-type">Video</span>
                  {% when 'model' %}
                    {{ media | model_viewer_tag }}
                    <span class="product-gallery__media-type">3D</span>
                {% endcase %}
              </div>
            </div>
          {% endfor %}
        </div>

      {% elsif gallery_mode == 'masonry' %}
        <div class="product-gallery__masonry">
          {% for media in product_context.media %}
            <div class="product-gallery__masonry-item" data-media-id="{{ media.id }}">
              <div class="product-gallery__media-frame">
                {% case media.media_type %}
                  {% when 'image' %}
                    {{ media | image_url: width: 1200 | image_tag: loading: forloop.first | default: 'eager', widths: '400, 600, 800, 1000, 1200', alt: media.alt | default: product_context.title }}
                  {% when 'video' %}
                    {{ media | video_tag: image_size: '900x', controls: true, muted: block.settings.mute_videos, playsinline: true }}
                    <span class="product-gallery__media-type">Video</span>
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                    <span class="product-gallery__media-type">Video</span>
                  {% when 'model' %}
                    {{ media | model_viewer_tag }}
                    <span class="product-gallery__media-type">3D</span>
                {% endcase %}
              </div>
            </div>
          {% endfor %}
        </div>

      {% elsif gallery_mode == 'horizontal_thumbs' %}
        <div class="product-gallery__horizontal-layout">
          <div class="product-gallery__vertical-thumbs" aria-label="{{ block.settings.thumbnails_label | escape }}">
            {% for media in product_context.media %}
              <button
                type="button"
                class="product-gallery__thumbnail {% if media.id == current_media.id or forloop.first and current_media == blank %}is-active{% endif %}"
                data-product-gallery-thumbnail
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                aria-label="{{ block.settings.go_to_slide_label | escape }} {{ forloop.index }}"
              >
                {% if media.preview_image %}
                  {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: media.alt | default: product_context.title }}
                {% endif %}
                {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                  <span class="product-gallery__thumbnail-badge">▶</span>
                {% elsif media.media_type == 'model' %}
                  <span class="product-gallery__thumbnail-badge">3D</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>

          <div class="product-gallery__horizontal-main">
            {% for media in product_context.media %}
              <div
                class="product-gallery__horizontal-media {% unless media.id == current_media.id or forloop.first and current_media == blank %}product-gallery__hidden{% endunless %}"
                data-product-gallery-main-media
                data-media-id="{{ media.id }}"
              >
                <div class="product-gallery__media-frame">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{ media | image_url: width: 1800 | image_tag: loading: forloop.first | default: 'eager', widths: '400, 600, 800, 1000, 1400, 1800', alt: media.alt | default: product_context.title }}
                    {% when 'video' %}
                      {{ media | video_tag: image_size: '1200x', controls: true, muted: block.settings.mute_videos, playsinline: true }}
                      <span class="product-gallery__media-type">Video</span>
                    {% when 'external_video' %}
                      {{ media | external_video_tag }}
                      <span class="product-gallery__media-type">Video</span>
                    {% when 'model' %}
                      {{ media | model_viewer_tag }}
                      <span class="product-gallery__media-type">3D</span>
                  {% endcase %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <script type="application/json" data-product-gallery-variants>
      {{ product_context.variants | json }}
    </script>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productGalleryReady === 'true') return;

        root.dataset.productGalleryReady = 'true';

        const mode = root.dataset.galleryMode;
        const track = root.querySelector('[data-product-gallery-track]');
        const slides = Array.from(root.querySelectorAll('[data-product-gallery-slide]'));
        const thumbnails = Array.from(root.querySelectorAll('[data-product-gallery-thumbnail]'));
        const dots = Array.from(root.querySelectorAll('[data-product-gallery-dot]'));
        const mainMedia = Array.from(root.querySelectorAll('[data-product-gallery-main-media]'));
        const previousButton = root.querySelector('[data-product-gallery-prev]');
        const nextButton = root.querySelector('[data-product-gallery-next]');
        const variantsJson = root.querySelector('[data-product-gallery-variants]');

        let variants = [];
        let activeIndex = Math.max(slides.findIndex((slide) => slide.getAttribute('aria-hidden') === 'false'), 0);
        let autoplayTimer = null;

        try {
          variants = JSON.parse(variantsJson ? variantsJson.textContent || '[]' : '[]');
        } catch (error) {
          variants = [];
        }

        const stopMedia = () => {
          root.querySelectorAll('video').forEach((video) => {
            if (!video.paused) video.pause();
          });
        };

        const setActive = (index) => {
          const total = mode === 'slider' ? slides.length : mainMedia.length;

          if (!total) return;

          activeIndex = (index + total) % total;

          if (track) {
            track.style.transform = `translateX(-${activeIndex * 100}%)`;
          }

          slides.forEach((slide, slideIndex) => {
            slide.setAttribute('aria-hidden', slideIndex === activeIndex ? 'false' : 'true');
          });

          mainMedia.forEach((media, mediaIndex) => {
            media.classList.toggle('product-gallery__hidden', mediaIndex !== activeIndex);
          });

          thumbnails.forEach((thumbnail, thumbnailIndex) => {
            const active = thumbnailIndex === activeIndex;
            thumbnail.classList.toggle('is-active', active);
            thumbnail.setAttribute('aria-current', active ? 'true' : 'false');
          });

          dots.forEach((dot, dotIndex) => {
            dot.classList.toggle('is-active', dotIndex === activeIndex);
          });

          stopMedia();
        };

        const startAutoplay = () => {
          if (root.dataset.autoplay !== 'true' || mode !== 'slider' || slides.length < 2) return;

          const speed = Math.max(Number(root.dataset.autoplaySpeed || 5000), 2000);

          stopAutoplay();

          autoplayTimer = window.setInterval(() => {
            setActive(activeIndex + 1);
          }, speed);
        };

        const stopAutoplay = () => {
          if (autoplayTimer) {
            window.clearInterval(autoplayTimer);
            autoplayTimer = null;
          }
        };

        thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            setActive(Number(thumbnail.dataset.index || 0));
          });
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            setActive(Number(dot.dataset.index || 0));
          });
        });

        if (previousButton) {
          previousButton.addEventListener('click', () => setActive(activeIndex - 1));
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => setActive(activeIndex + 1));
        }

        root.addEventListener('mouseenter', stopAutoplay);
        root.addEventListener('mouseleave', startAutoplay);
        root.addEventListener('focusin', stopAutoplay);
        root.addEventListener('focusout', startAutoplay);

        root.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            setActive(activeIndex - 1);
          }

          if (event.key === 'ArrowRight') {
            setActive(activeIndex + 1);
          }
        });

        document.addEventListener('variant:change', (event) => {
          const detail = event.detail || {};
          const variant = detail.variant || variants.find((item) => String(item.id) === String(detail.variantId || detail.variant_id || detail.id));

          if (!variant || !variant.featured_media) return;

          const mediaId = String(variant.featured_media.id);
          const targetIndex = thumbnails.findIndex((thumbnail) => String(thumbnail.dataset.mediaId) === mediaId);

          if (targetIndex >= 0) {
            root.dataset.variantId = String(variant.id);
            setActive(targetIndex);
          }
        });

        document.addEventListener('qtm:variant:change', (event) => {
          const detail = event.detail || {};
          const variant = detail.variant || variants.find((item) => String(item.id) === String(detail.variantId || detail.variant_id || detail.id));

          if (!variant || !variant.featured_media) return;

          const mediaId = String(variant.featured_media.id);
          const targetIndex = thumbnails.findIndex((thumbnail) => String(thumbnail.dataset.mediaId) === mediaId);

          if (targetIndex >= 0) {
            root.dataset.variantId = String(variant.id);
            setActive(targetIndex);
          }
        });

        setActive(activeIndex);
        startAutoplay();
      })();
    </script>
  </div>
{% endif %}

