{%- liquid
  assign alert_type = block.settings.alert_type | default: 'info'
  assign alert_heading = block.settings.heading
  assign alert_message = block.settings.message
  assign button_label = block.settings.button_label
  assign button_url = block.settings.button_url
  assign button_aria_label = block.settings.button_aria_label | default: button_label
  assign show_button = false

  if button_label != blank
    assign show_button = true
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'alert' %}

<div
  class="
    qtm-alert
    qtm-alert--{{ alert_type }}
    qtm-alert--{{ block.settings.alert_layout }}
  "
  role="{% if alert_type == 'error' or alert_type == 'warning' %}alert{% else %}status{% endif %}"
  style="
    --qtm-alert-max-width: {{ block.settings.max_width }}px;
    --qtm-alert-padding: {{ block.settings.alert_padding }}px;
    --qtm-alert-gap: {{ block.settings.alert_gap }}px;
    --qtm-alert-background: {{ block.settings.alert_background }};
    --qtm-alert-border-color: {{ block.settings.alert_border_color }};
    --qtm-alert-border-width: {{ block.settings.alert_border_width }}px;
    --qtm-alert-radius: {{ block.settings.alert_radius }}px;
    --qtm-alert-icon-color: {{ block.settings.icon_color }};
    --qtm-alert-heading-color: {{ block.settings.heading_color }};
    --qtm-alert-text-color: {{ block.settings.text_color }};
    --qtm-alert-button-text-color: {{ block.settings.button_text_color }};
    --qtm-alert-button-background: {{ block.settings.button_background }};
    --qtm-alert-button-border-color: {{ block.settings.button_border_color }};
    --qtm-alert-button-hover-text-color: {{ block.settings.button_hover_text_color }};
    --qtm-alert-button-hover-background: {{ block.settings.button_hover_background }};
    --qtm-alert-button-hover-border-color: {{ block.settings.button_hover_border_color }};
    --qtm-alert-button-radius: {{ block.settings.button_radius }}px;
  "
>
  {% if block.settings.show_icon %}
    <span class="qtm-alert__icon" aria-hidden="true">
      {% if block.settings.icon_text != blank %}
        {{ block.settings.icon_text | escape }}
      {% elsif alert_type == 'success' %}
        ✓
      {% elsif alert_type == 'warning' %}
        !
      {% elsif alert_type == 'error' %}
        ×
      {% else %}
        i
      {% endif %}
    </span>
  {% endif %}

  <div class="qtm-alert__content">
    {% if alert_heading != blank %}
      <div class="qtm-alert__heading">
        {{ alert_heading | escape }}
      </div>
    {% endif %}

    {% if alert_message != blank %}
      <div class="qtm-alert__message">
        {{ alert_message }}
      </div>
    {% endif %}
  </div>

  {% if show_button %}
    {%- liquid
      assign button_tag = 'button'

      if button_url != blank
        assign button_tag = 'a'
      endif
    -%}

    <{{ button_tag }}
      class="qtm-alert__button"
      {% if button_url != blank %}
        href="{{ button_url }}"
        {% if block.settings.button_open_new_tab %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      {% else %}
        type="button"
      {% endif %}
      aria-label="{{ button_aria_label | escape }}"
    >
      {{ button_label | escape }}
    </{{ button_tag }}>
  {% endif %}
</div>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Alert / Notice",
  "settings": [
    {
      "type": "header",
      "content": "Notice content"
    },
    {
      "type": "select",
      "id": "alert_type",
      "label": "Type",
      "default": "info",
      "options": [
        {
          "value": "info",
          "label": "Info"
        },
        {
          "value": "success",
          "label": "Success"
        },
        {
          "value": "warning",
          "label": "Warning"
        },
        {
          "value": "error",
          "label": "Error"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Helpful notice"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Use this block for shipping notices, return information, announcements, or important customer updates.</p>"
    },
    {
      "type": "select",
      "id": "alert_layout",
      "label": "Layout",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "text",
      "id": "icon_text",
      "label": "Custom icon text",
      "info": "Optional. Leave empty to use the automatic icon based on notice type."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 320,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 880
    },
    {
      "type": "range",
      "id": "alert_padding",
      "label": "Alert padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "alert_gap",
      "label": "Alert gap",
      "min": 4,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "alert_radius",
      "label": "Alert radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "alert_border_width",
      "label": "Alert border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Notice colors"
    },
    {
      "type": "color",
      "id": "alert_background",
      "label": "Background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "alert_border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Optional button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "button_aria_label",
      "label": "Button accessibility label"
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open button in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
