{% liquid
  assign main_menu = linklists[settings.desktop_menu]

  assign header_layout = section.settings.header_layout | default: 'campaign'
  assign header_width = section.settings.header_width | default: 'wide'
  assign sticky_mode = section.settings.sticky_mode | default: 'sticky_shadow'
  assign navigation_mode = section.settings.navigation_mode | default: 'minimal'

  assign search_display = section.settings.search_display | default: 'search_button'
  assign search_button_action = section.settings.search_button_action | default: 'popup'

  assign has_announcement_blocks = false
  for block in section.blocks
    if block.type == 'announcement'
      assign has_announcement_blocks = true
      break
    endif
  endfor

  assign has_nav_blocks = false
  for block in section.blocks
    if block.type == 'nav_link'
      assign has_nav_blocks = true
      break
    endif
  endfor

  assign show_desktop_nav = true
  if navigation_mode == 'hidden'
    assign show_desktop_nav = false
  elsif navigation_mode == 'minimal' and has_nav_blocks == false
    assign show_desktop_nav = false
  endif

  assign sticky_enabled = false
  assign sticky_shadow_enabled = false
  assign hide_on_scroll_enabled = false

  if sticky_mode == 'sticky' or sticky_mode == 'sticky_shadow' or sticky_mode == 'hide_on_scroll'
    assign sticky_enabled = true
  endif

  if sticky_mode == 'sticky_shadow'
    assign sticky_shadow_enabled = true
  endif

  if sticky_mode == 'hide_on_scroll'
    assign hide_on_scroll_enabled = true
  endif
%}

{{ 'header-four.css' | asset_url | stylesheet_tag }}

<div
  id="HeaderFour-{{ section.id }}"
  class="
    qtmHeaderFour
    qtmHeaderFour--layout-{{ header_layout }}
    qtmHeaderFour--width-{{ header_width }}
    qtmHeaderFour--nav-{{ navigation_mode }}
    qtmHeaderFour--sticky-{{ sticky_mode }}
    {% if sticky_enabled %}qtmHeaderFour--sticky{% endif %}
    {% if sticky_shadow_enabled %}qtmHeaderFour--stickyShadow{% endif %}
    {% if section.settings.sticky_mobile_cta %}qtmHeaderFour--stickyMobileCta{% endif %}
  "
  style="
    --qtm-h4-bg: {{ section.settings.header_bg }};
    --qtm-h4-text: {{ section.settings.header_text }};
    --qtm-h4-border: {{ section.settings.header_border }};
    --qtm-h4-announcement-bg: {{ section.settings.announcement_bg }};
    --qtm-h4-announcement-text: {{ section.settings.announcement_text_color }};
    --qtm-h4-cta-bg: {{ section.settings.cta_bg }};
    --qtm-h4-cta-text: {{ section.settings.cta_text }};
    --qtm-h4-progress-bg: {{ section.settings.progress_bg }};
    --qtm-h4-progress-fill: {{ section.settings.progress_fill }};
    --qtm-h4-countdown-bg: {{ section.settings.countdown_bg }};
    --qtm-h4-countdown-text: {{ section.settings.countdown_text }};
    --qtm-h4-menu-font-size: {{ section.settings.menu_font_size }}px;
    --qtm-h4-announcement-font-size: {{ section.settings.announcement_font_size }}px;
    --qtm-h4-countdown-font-size: {{ section.settings.countdown_font_size }}px;
    --qtm-h4-cta-font-size: {{ section.settings.cta_font_size }}px;
    --qtm-h4-padding-y: {{ section.settings.header_padding_y }}px;
    --qtm-h4-padding-x: {{ section.settings.header_padding_x }}px;
    --qtm-h4-menu-gap: {{ section.settings.menu_gap }}px;
    --qtm-h4-cta-spacing: {{ section.settings.cta_spacing }}px;
    --qtm-h4-button-radius: {{ section.settings.button_radius }}px;
    --qtm-h4-countdown-radius: {{ section.settings.countdown_radius }}px;
    --qtm-h4-progress-radius: {{ section.settings.progress_radius }}px;
    --qtm-h4-logo-desktop: {{ section.settings.logo_height_desktop }}px;
    --qtm-h4-logo-mobile: {{ section.settings.logo_height_mobile }}px;
  "
  data-qtm-header-four
  data-sticky-mode="{{ sticky_mode }}"
  data-announcement-auto-rotate="{% if section.settings.announcement_auto_rotate %}true{% else %}false{% endif %}"
>
  {% if section.settings.announcement_enable %}
    <div class="qtmHeaderFour__announcement qtmHeaderFour__announcement--{{ section.settings.announcement_alignment }}" data-qtm-h4-announcements>
      <div class="qtmHeaderFour__announcementInner">
        {% if section.settings.announcement_auto_rotate and has_announcement_blocks %}
          {% for block in section.blocks %}
            {% if block.type == 'announcement' %}
              <p
                class="qtmHeaderFour__announcementText{% unless forloop.first %} is-hidden{% endunless %}"
                data-qtm-h4-announcement-slide
                {{ block.shopify_attributes }}
              >
                <span>{{ block.settings.message }}</span>

                {% if block.settings.link_label != blank and block.settings.link_url != blank %}
                  <a class="qtmHeaderFour__announcementLink" href="{{ block.settings.link_url }}">
                    {{ block.settings.link_label }}
                  </a>
                {% endif %}
              </p>
            {% endif %}
          {% endfor %}
        {% elsif section.settings.announcement_text != blank %}
          <p class="qtmHeaderFour__announcementText" data-qtm-h4-announcement-slide>
            <span>{{ section.settings.announcement_text }}</span>

            {% if section.settings.announcement_link_label != blank and section.settings.announcement_link_url != blank %}
              <a class="qtmHeaderFour__announcementLink" href="{{ section.settings.announcement_link_url }}">
                {{ section.settings.announcement_link_label }}
              </a>
            {% endif %}
          </p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <header class="qtmHeaderFour__header" aria-label="Campaign header">
    <div class="qtmHeaderFour__inner">
      <div class="qtmHeaderFour__left">
        <button
          type="button"
          class="qtmHeaderFour__menuButton"
          aria-label="Open menu"
          aria-controls="HeaderFourMobileMenu-{{ section.id }}"
          aria-expanded="false"
          data-qtm-h4-mobile-open
        >
          <span class="qtmHeaderFour__menuIcon" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="qtmHeaderFour__menuText">Menu</span>
        </button>

        <a class="qtmHeaderFour__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          <span class="qtmHeaderFour__logoWrap">
            {% if settings.logo_primary != blank %}
              <img
                class="qtmHeaderFour__logo"
                src="{{ settings.logo_primary | image_url: width: 620 }}"
                alt="{{ shop.name | escape }}"
                loading="eager"
              >
            {% elsif settings.logo_mobile != blank %}
              <img
                class="qtmHeaderFour__logo"
                src="{{ settings.logo_mobile | image_url: width: 620 }}"
                alt="{{ shop.name | escape }}"
                loading="eager"
              >
            {% else %}
              <span class="qtmHeaderFour__brandText">{{ shop.name }}</span>
            {% endif %}
          </span>
        </a>
      </div>

      {% if show_desktop_nav %}
        <div class="qtmHeaderFour__navWrap">
          <nav class="qtmHeaderFour__nav" aria-label="Campaign navigation">
            {% if navigation_mode == 'minimal' and has_nav_blocks %}
              {% for block in section.blocks %}
                {% if block.type == 'nav_link' %}
                  <a
                    class="qtmHeaderFour__navLink"
                    href="{{ block.settings.url }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label }}
                  </a>
                {% endif %}
              {% endfor %}
            {% elsif navigation_mode == 'full' and main_menu != blank %}
              {% for link in main_menu.links %}
                <a
                  class="qtmHeaderFour__navLink{% if link.active %} qtmHeaderFour__navLink--active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.active %}aria-current="page"{% endif %}
                >
                  {{ link.title }}
                </a>
              {% endfor %}
            {% endif %}
          </nav>
        </div>
      {% endif %}

      <div class="qtmHeaderFour__campaign">
        {% if header_layout == 'countdown' and section.settings.show_countdown %}
          {% render 'header-conversion-countdown', section_settings: section.settings %}
        {% elsif header_layout == 'cta_focus' and section.settings.offer_message != blank %}
          <div class="qtmHeaderFour__offerMessage">
            {{ section.settings.offer_message }}
          </div>
        {% elsif header_layout == 'campaign' and section.settings.offer_message != blank %}
          <div class="qtmHeaderFour__offerMessage">
            {{ section.settings.offer_message }}
          </div>
        {% endif %}
      </div>

      <div class="qtmHeaderFour__actions">
        {% if search_display == 'search_button' %}
          {% if search_button_action == 'popup' and settings.enable_search_popup %}
            <button
              type="button"
              class="qtmHeaderFour__iconAction qtmHeaderFour__searchAction"
              data-search-popup-open
              aria-label="Open search"
              aria-haspopup="dialog"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          {% else %}
            <a
              href="{{ routes.search_url }}"
              class="qtmHeaderFour__iconAction qtmHeaderFour__searchAction"
              aria-label="Go to search page"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </a>
          {% endif %}
        {% endif %}

        {% if section.settings.show_account %}
          <a
            class="qtmHeaderFour__iconAction qtmHeaderFour__accountAction"
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            aria-label="{% if customer %}Account{% else %}Sign in{% endif %}"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.8"/>
              <path d="M5 20C5.75 16.5 8.25 14.5 12 14.5C15.75 14.5 18.25 16.5 19 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_primary_cta %}
          {% render 'header-conversion-cta', section_settings: section.settings, class_name: 'qtmHeaderFour__desktopCta' %}
        {% endif %}

        {% if section.settings.show_cart %}
          <button
            type="button"
            class="qtmHeaderFour__iconAction qtmHeaderFour__cartAction"
            data-cart-drawer-open
            aria-label="Open cart"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.5 7.5H19.5L18.25 17H7.75L6.5 7.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M9 7.5C9 4.95 10.15 3.5 12 3.5C13.85 3.5 15 4.95 15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span class="qtmHeaderFour__cartCount" data-cart-count>{{ cart.item_count }}</span>
          </button>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_countdown and header_layout != 'countdown' %}
      <div class="qtmHeaderFour__countdownRow">
        {% render 'header-conversion-countdown', section_settings: section.settings %}
      </div>
    {% endif %}

    {% if section.settings.show_progress_bar %}
      {% render 'header-conversion-progress', section_settings: section.settings %}
    {% endif %}
  </header>

  <div
    id="HeaderFourMobileMenu-{{ section.id }}"
    class="qtmHeaderFour__mobile"
    hidden
    aria-hidden="true"
    data-qtm-h4-mobile-panel
  >
    <div class="qtmHeaderFour__mobileOverlay" data-qtm-h4-mobile-close></div>

    <div class="qtmHeaderFour__mobileDialog" role="dialog" aria-modal="true" aria-label="Campaign mobile menu">
      <div class="qtmHeaderFour__mobileTop">
        <a class="qtmHeaderFour__mobileBrand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if settings.logo_primary != blank %}
            <img
              class="qtmHeaderFour__mobileLogo"
              src="{{ settings.logo_primary | image_url: width: 460 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% elsif settings.logo_mobile != blank %}
            <img
              class="qtmHeaderFour__mobileLogo"
              src="{{ settings.logo_mobile | image_url: width: 460 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% else %}
            <span class="qtmHeaderFour__mobileBrandText">{{ shop.name }}</span>
          {% endif %}
        </a>

        <button
          type="button"
          class="qtmHeaderFour__mobileClose"
          aria-label="Close menu"
          data-qtm-h4-mobile-close
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      {% if section.settings.offer_message != blank %}
        <div class="qtmHeaderFour__mobileOffer">
          {{ section.settings.offer_message }}
        </div>
      {% endif %}

      {% if section.settings.show_countdown %}
        {% render 'header-conversion-countdown', section_settings: section.settings %}
      {% endif %}

      {% if navigation_mode != 'hidden' %}
        <nav class="qtmHeaderFour__mobileNav" aria-label="Mobile campaign navigation">
          {% if navigation_mode == 'minimal' and has_nav_blocks %}
            {% for block in section.blocks %}
              {% if block.type == 'nav_link' %}
                <a class="qtmHeaderFour__mobileNavLink" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
                  {{ block.settings.label }}
                </a>
              {% endif %}
            {% endfor %}
          {% elsif navigation_mode == 'full' and main_menu != blank %}
            {% for link in main_menu.links %}
              <a
                class="qtmHeaderFour__mobileNavLink{% if link.active %} qtmHeaderFour__mobileNavLink--active{% endif %}"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            {% endfor %}
          {% endif %}
        </nav>
      {% endif %}

      <div class="qtmHeaderFour__mobileActions">
        {% if section.settings.show_primary_cta %}
          {% render 'header-conversion-cta', section_settings: section.settings, class_name: 'qtmHeaderFour__mobileCta' %}
        {% endif %}

        <div class="qtmHeaderFour__mobileUtilityActions">
          {% if search_display == 'search_button' %}
            {% if search_button_action == 'popup' and settings.enable_search_popup %}
              <button type="button" class="qtmHeaderFour__mobileUtility" data-search-popup-open aria-label="Open search">
                Search
              </button>
            {% else %}
              <a class="qtmHeaderFour__mobileUtility" href="{{ routes.search_url }}">
                Search
              </a>
            {% endif %}
          {% endif %}

          {% if section.settings.show_account %}
            <a class="qtmHeaderFour__mobileUtility" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              {% if customer %}Account{% else %}Sign in{% endif %}
            </a>
          {% endif %}

          {% if section.settings.show_cart %}
            <button type="button" class="qtmHeaderFour__mobileUtility" data-cart-drawer-open>
              Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.sticky_mobile_cta and section.settings.show_primary_cta %}
    <div class="qtmHeaderFour__stickyMobileCta" data-qtm-h4-sticky-mobile-cta>
      {% render 'header-conversion-cta', section_settings: section.settings, class_name: 'qtmHeaderFour__stickyCta' %}
    </div>
  {% endif %}
</div>

<script src="{{ 'header-four.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header Four",
  "class": "qtm-header-four-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "default": "campaign",
      "options": [
        { "value": "campaign", "label": "Campaign" },
        { "value": "countdown", "label": "Countdown" },
        { "value": "cta_focus", "label": "CTA focus" },
        { "value": "minimal", "label": "Minimal" }
      ]
    },
    {
      "type": "select",
      "id": "header_width",
      "label": "Header width",
      "default": "wide",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky mode",
      "default": "sticky_shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sticky", "label": "Sticky" },
        { "value": "sticky_shadow", "label": "Sticky with shadow" },
        { "value": "hide_on_scroll", "label": "Hide on scroll down" }
      ]
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile_cta",
      "label": "Show sticky mobile CTA",
      "default": true
    },
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "checkbox",
      "id": "announcement_enable",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Limited-time offer: save today while supplies last"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement link label"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link URL"
    },
    {
      "type": "select",
      "id": "announcement_alignment",
      "label": "Announcement alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "announcement_auto_rotate",
      "label": "Auto-rotate announcement blocks",
      "default": false
    },
    {
      "type": "header",
      "content": "Offer"
    },
    {
      "type": "text",
      "id": "offer_message",
      "label": "Offer message",
      "default": "Black Friday pricing is live"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Sale Ends In"
    },
    {
      "type": "text",
      "id": "countdown_end_date",
      "label": "Countdown end date",
      "default": "2026-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "countdown_expired_message",
      "label": "Expired message",
      "default": "This offer has ended"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show conversion progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "progress_type",
      "label": "Progress type",
      "default": "free_shipping",
      "options": [
        { "value": "free_shipping", "label": "Free shipping" },
        { "value": "free_gift", "label": "Free gift" },
        { "value": "discount", "label": "Discount" }
      ]
    },
    {
      "type": "number",
      "id": "progress_threshold",
      "label": "Progress threshold",
      "default": 75
    },
    {
      "type": "text",
      "id": "progress_message",
      "label": "Progress message",
      "default": "Spend [amount] more for free shipping"
    },
    {
      "type": "text",
      "id": "progress_complete_message",
      "label": "Progress complete message",
      "default": "You unlocked free shipping"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "checkbox",
      "id": "show_primary_cta",
      "label": "Show primary CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Sale"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" }
      ]
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "select",
      "id": "navigation_mode",
      "label": "Navigation mode",
      "default": "minimal",
      "options": [
        { "value": "full", "label": "Full menu" },
        { "value": "minimal", "label": "Minimal links" },
        { "value": "hidden", "label": "Hidden" }
      ]
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "select",
      "id": "search_display",
      "label": "Search display",
      "default": "search_button",
      "options": [
        { "value": "search_button", "label": "Search button" },
        { "value": "none", "label": "No search" }
      ]
    },
    {
      "type": "select",
      "id": "search_button_action",
      "label": "Search action",
      "default": "popup",
      "options": [
        { "value": "popup", "label": "Open popup" },
        { "value": "page", "label": "Go to search page" }
      ]
    },
    {
      "type": "header",
      "content": "Account and cart"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Desktop logo height",
      "min": 20,
      "max": 90,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Mobile logo height",
      "min": 18,
      "max": 64,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Header border",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "CTA background",
      "default": "#111111"
    },
