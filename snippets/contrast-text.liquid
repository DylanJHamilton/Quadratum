{%- liquid
  assign surface = background | default: bg | default: '#111827'
  assign candidate = preferred | default: '#ffffff'
  assign contrast = surface | color_contrast: candidate
  if contrast >= 4.5
    echo candidate
  else
    assign white_contrast = surface | color_contrast: '#ffffff'
    assign black_contrast = surface | color_contrast: '#000000'
    if white_contrast > black_contrast
      echo '#ffffff'
    else
      echo '#000000'
    endif
  endif
-%}
