  ],
  "presets": [
    {
      "name": "Solid badge",
      "settings": {
        "badge_text": "New",
        "badge_style": "solid",
        "badge_size": "medium",
        "uppercase": true,
        "badge_radius": 80,
        "badge_border_width": 1,
        "text_color": "#ffffff",
        "badge_background": "#111111",
        "badge_border_color": "#111111",
        "hover_text_color": "#ffffff",
        "hover_background": "#333333",
        "hover_border_color": "#333333",
        "font_family": "body",
        "font_weight": "700",
        "letter_spacing": 0.5,
        "content_width": "auto",
        "alignment": "left",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 16,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "none",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    },
    {
      "name": "Outline badge",
      "settings": {
        "badge_text": "Best seller",
        "badge_style": "outline",
        "badge_size": "medium",
        "uppercase": true,
        "badge_radius": 80,
        "badge_border_width": 1,
        "text_color": "#111111",
        "badge_background": "rgba(0,0,0,0)",
        "badge_border_color": "#111111",
        "hover_text_color": "#ffffff",
        "hover_background": "#111111",
        "hover_border_color": "#111111",
        "font_family": "body",
        "font_weight": "700",
        "letter_spacing": 0.5,
        "content_width": "auto",
        "alignment": "center",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 16,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "fade-up",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    },
    {
      "name": "Sale pill",
      "settings": {
        "badge_text": "Limited time sale",
        "icon_left": "●",
        "badge_style": "pill",
        "badge_size": "large",
        "uppercase": false,
        "badge_radius": 80,
        "badge_border_width": 1,
        "text_color": "#ffffff",
        "badge_background": "#111111",
        "badge_border_color": "#111111",
        "hover_text_color": "#ffffff",
        "hover_background": "#333333",
        "hover_border_color": "#333333",
        "font_family": "body",
        "font_weight": "700",
        "letter_spacing": 0,
        "content_width": "auto",
        "alignment": "left",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
