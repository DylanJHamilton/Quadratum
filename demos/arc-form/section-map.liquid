<nav aria-label="Explore this demo" class="arc-demo-links"><a href="/pages/workday-system?view=workday-system">The Workday System</a><a href="/pages/features?view=features">Theme capabilities</a><a href="/pages/block-library?view=block-library">Block examples</a><a href="/pages/wishlist?view=wishlist">Your shortlist</a></nav>
<style>.arc-demo-links{display:grid;gap:14px}.arc-demo-links a{color:inherit;text-underline-offset:4px}.arc-map-toggle{min-height:44px;margin-top:20px;padding:10px 18px;border:1px solid currentColor;background:transparent;color:inherit;border-radius:12px}.arc-map-active .shopify-section{outline:2px dashed #8e8e83;outline-offset:-3px}.arc-map-label{position:relative;z-index:10;display:block;width:fit-content;padding:6px 10px;background:#111;color:#fff;font:12px/1.5 monospace;letter-spacing:0}.arc-demo-links a:focus-visible,.arc-map-toggle:focus-visible{outline:2px solid currentColor;outline-offset:4px}</style>
{% unless request.design_mode %}<button type="button" class="arc-map-toggle" aria-pressed="false">Section map</button><script>(()=>{const button=document.currentScript.previousElementSibling;let active=false;const toggle=()=>{active=!active;button.setAttribute('aria-pressed',String(active));document.documentElement.classList.toggle('arc-map-active',active);document.querySelectorAll('.arc-map-label').forEach(el=>el.remove());if(active)document.querySelectorAll('.shopify-section').forEach((section,i)=>{const label=document.createElement('span');label.className='arc-map-label';label.textContent=String(i+1).padStart(2,'0')+' / '+(section.querySelector('h1,h2,h3')?.textContent.trim()||section.querySelector('[aria-label]')?.getAttribute('aria-label')||'Global section');section.prepend(label);});};button.addEventListener('click',toggle);if(new URLSearchParams(location.search).get('section-map')==='1')toggle();})();</script>{% endunless %}
