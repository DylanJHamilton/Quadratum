{%- capture search_types -%}{%- render 'search-source-types' -%}{%- endcapture -%}
{%- liquid
  assign form_context = form_context | default: 'site'
  assign input_id = input_id | default: 'QtmStaticSearchInput'
  assign placeholder = placeholder | default: settings.search_placeholder | default: 'Search products, articles, and pages'
  assign submit_label = submit_label | default: settings.search_submit_label | default: 'Search'
  assign form_action = form_action | default: routes.search_url
  assign query_value = query_value | default: search.terms
  assign extra_class = extra_class | default: ''
  assign show_button = show_button
  if show_button == nil
    assign show_button = true
  endif
-%}

<div class="qtm-search-form qtm-search-form--static {{ extra_class | escape }}" data-qtm-search-form="static">
  <form
    class="qtm-search-form__form"
    action="{{ form_action | escape }}"
    method="get"
    role="search"
    data-search-context="{{ form_context | escape }}"
  >
    {% if search_types != blank %}<input type="hidden" name="type" value="{{ search_types | escape }}">{% endif %}
    <label class="visually-hidden" for="{{ input_id | escape }}">Search store</label>

    <div class="qtm-search-form__field">
      <input
        id="{{ input_id | escape }}"
        class="qtm-search-form__input"
        type="search"
        {% if search_types != blank %}name="q"{% endif %}
        value="{{ query_value | escape }}"
        placeholder="{{ placeholder | escape }}"
        aria-label="Search store"
        autocomplete="off"
        {% if search_types == blank %}disabled{% endif %}
      >
    </div>

    {%- if show_button -%}
      <div class="qtm-search-form__actions">
        <button class="qtm-search-form__submit button" type="submit"{% if search_types == blank %} disabled{% endif %}>
          {{ submit_label | escape }}
        </button>
      </div>
    {%- elsif search_types == blank -%}
      <button type="submit" hidden disabled></button>
    {%- endif -%}
  </form>
  {% if search_types == blank %}<p class="qtm-search-form__notice">Search is currently unavailable.</p>{% endif %}
</div>