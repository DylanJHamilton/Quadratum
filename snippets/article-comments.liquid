{%- if blog.comments_enabled? -%}
  {{ 'article-comments.css' | asset_url | stylesheet_tag }}
  {%- assign comments_id = 'ArticleComments-' | append: section.id -%}
  <section class="q-article-comments" id="{{ comments_id }}" aria-labelledby="{{ comments_id }}-heading">
    <h2 id="{{ comments_id }}-heading">{{ 'blogs.comments.heading' | t }}</h2>
    {%- paginate article.comments by 10 -%}
      {%- if article.comments_count > 0 -%}
        <ol class="q-article-comments__list">
          {%- for article_comment in article.comments -%}
            <li id="Comment-{{ article_comment.id }}">
              <p><strong>{{ article_comment.author | escape }}</strong> <time datetime="{{ article_comment.created_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">{{ article_comment.created_at | date: format: 'abbreviated_date' }}</time></p>
              <div class="rte">{{ article_comment.content }}</div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="q-article-comments__pagination" aria-label="{{ 'blogs.comments.pagination' | t | escape }}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url | escape }}#{{ comments_id }}" rel="prev">{{ 'blogs.comments.previous' | t }}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {% assign part_number = part.title | plus: 0 %}{% if part.is_link %}<a href="{{ part.url | escape }}#{{ comments_id }}">{{ part.title }}</a>{% else %}<span {% if part_number == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url | escape }}#{{ comments_id }}" rel="next">{{ 'blogs.comments.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
    {%- assign comment_form_id = comments_id | append: '-form' -%}
    {% form 'new_comment', article, id: comment_form_id, class: 'q-article-comments__form' %}
      <h3>{{ 'blogs.comments.leave_comment' | t }}</h3>
      {% if form.posted_successfully? %}
        <p role="status">{% if blog.moderated? %}{{ 'blogs.comments.pending' | t }}{% else %}{{ 'blogs.comments.success' | t }}{% endif %}</p>
      {% endif %}
      {% if form.errors %}<div role="alert" id="{{ comment_form_id }}-errors">{{ form.errors | default_errors }}</div>{% endif %}
      <div><label for="{{ comment_form_id }}-author">{{ 'blogs.comments.name' | t }}</label><input id="{{ comment_form_id }}-author" name="comment[author]" type="text" autocomplete="name" value="{{ form.author | escape }}" required {% if form.errors contains 'author' %}aria-invalid="true" aria-describedby="{{ comment_form_id }}-errors"{% endif %}></div>
      <div><label for="{{ comment_form_id }}-email">{{ 'blogs.comments.email' | t }}</label><input id="{{ comment_form_id }}-email" name="comment[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ comment_form_id }}-errors"{% endif %}></div>
      <div><label for="{{ comment_form_id }}-body">{{ 'blogs.comments.message' | t }}</label><textarea id="{{ comment_form_id }}-body" name="comment[body]" rows="6" required {% if form.errors contains 'body' %}aria-invalid="true" aria-describedby="{{ comment_form_id }}-errors"{% endif %}>{{ form.body | escape }}</textarea></div>
      {% if blog.moderated? %}<p>{{ 'blogs.comments.moderation' | t }}</p>{% endif %}
      <button type="submit" class="qtm-button">{{ 'blogs.comments.submit' | t }}</button>
    {% endform %}
  </section>
{%- endif -%}
