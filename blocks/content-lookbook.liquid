{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-lookbook
    qtm-lookbook-{{ block_id }}
    qtm-lookbook--width-{{ block_width }}
    qtm-lookbook--align-{{ block_alignment }}
    qtm-lookbook--layout-{{ block.settings.layout_style }}
    qtm-lookbook--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-lookbook--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-lookbook--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-lookbook--hide-mobile{% endunless %}
  "
  style="
    --qtm-lookbook-margin-top: {{ block.settings.margin_top }}px;
    --qtm-lookbook-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-lookbook-padding: {{ block.settings.padding }}px;
    --qtm-lookbook-gap: {{ block.settings.gap }}px;
    --qtm-lookbook-heading-color: {{ block.settings.heading_color }};
    --qtm-lookbook-text-color: {{ block.settings.text_color }};
    --qtm-lookbook-background-color: {{ block.settings.background_color }};
    --qtm-lookbook-border-color: {{ block.settings.border_color }};
    --qtm-lookbook-link-color: {{ block.settings.link_color }};
    --qtm-lookbook-card-background: {{ block.settings.card_background_color }};
    --qtm-lookbook-overlay-color: {{ block.settings.overlay_color }};
    --qtm-lookbook-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --qtm-lookbook-border-width: {{ block.settings.border_width }}px;
    --qtm-lookbook-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-lookbook__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank or block.settings.cta_text != blank %}
      <div class="qtm-lookbook__header">
        <div class="qtm-lookbook__header-copy">
          {% if block.settings.eyebrow != blank %}
            <p class="qtm-lookbook__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="qtm-lookbook__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="qtm-lookbook__text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
          <a class="qtm-lookbook__header-link" href="{{ block.settings.cta_url }}">
            {{ block.settings.cta_text | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-lookbook__grid">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image_heading_key = 'image_' | append: i | append: '_heading'
          assign image_text_key = 'image_' | append: i | append: '_text'
          assign image_link_key = 'image_' | append: i | append: '_link'
          assign image_link_text_key = 'image_' | append: i | append: '_link_text'
          assign product_key = 'product_' | append: i
          assign show_key = 'show_item_' | append: i

          assign item_image = block.settings[image_key]
          assign item_heading = block.settings[image_heading_key]
          assign item_text = block.settings[image_text_key]
          assign item_link = block.settings[image_link_key]
          assign item_link_text = block.settings[image_link_text_key]
          assign item_product = block.settings[product_key]
          assign show_item = block.settings[show_key]
        %}

        {% if show_item %}
          <article class="qtm-lookbook__item qtm-lookbook__item--{{ i }}">
            <div class="qtm-lookbook__media">
              {% if item_image != blank %}
                {{
                  item_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'qtm-lookbook__image',
                    loading: 'lazy',
                    widths: '375, 550, 750, 950, 1200, 1500, 1800',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: item_image.alt
                }}
              {% else %}
                <div class="qtm-lookbook__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'qtm-lookbook__placeholder-svg' }}
                </div>
              {% endif %}

              {% if block.settings.enable_overlay %}
                <div class="qtm-lookbook__overlay" aria-hidden="true"></div>
              {% endif %}

              {% if item_heading != blank or item_text != blank or item_link != blank %}
                <div class="qtm-lookbook__caption qtm-lookbook__caption--{{ block.settings.caption_position }}">
                  {% if item_heading != blank %}
                    <h3 class="qtm-lookbook__caption-heading">
                      {{ item_heading | escape }}
                    </h3>
                  {% endif %}

                  {% if item_text != blank %}
                    <div class="qtm-lookbook__caption-text">
                      {{ item_text }}
                    </div>
                  {% endif %}

                  {% if item_link != blank and item_link_text != blank %}
                    <a class="qtm-lookbook__caption-link" href="{{ item_link }}">
                      {{ item_link_text | escape }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% if item_product != blank and block.settings.show_product_cards %}
              <a class="qtm-lookbook__product-card" href="{{ item_product.url }}">
                {% if item_product.featured_image != blank %}
                  {{
                    item_product.featured_image
                    | image_url: width: 260
                    | image_tag:
                      class: 'qtm-lookbook__product-image',
                      loading: 'lazy',
                      widths: '120, 180, 260',
                      sizes: '84px',
                      alt: item_product.featured_image.alt
                  }}
                {% endif %}

                <span class="qtm-lookbook__product-content">
                  <span class="qtm-lookbook__product-kicker">
                    {{ block.settings.product_card_label | escape }}
                  </span>

                  <span class="qtm-lookbook__product-title">
                    {{ item_product.title | escape }}
                  </span>

                  {% if block.settings.show_product_price %}
                    <span class="qtm-lookbook__product-price">
                      {{ item_product.price | money }}
                    </span>
                  {% endif %}
                </span>
              </a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .qtm-lookbook-{{ block_id }} {
    margin-top: var(--qtm-lookbook-margin-top);
    margin-bottom: var(--qtm-lookbook-margin-bottom);
    padding: var(--qtm-lookbook-padding);
    color: var(--qtm-lookbook-text-color);
    background: var(--qtm-lookbook-background-color);
    border: var(--qtm-lookbook-border-width) solid var(--qtm-lookbook-border-color);
    border-radius: var(--qtm-lookbook-border-radius);
  }

  .qtm-lookbook-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--width-auto {
    width: auto;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--width-small {
    max-width: 720px;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--width-medium {
    max-width: 960px;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--width-large {
    max-width: 1240px;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__inner {
    display: grid;
    gap: var(--qtm-lookbook-gap);
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__header-copy {
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-center .qtm-lookbook__header-copy {
    margin-inline: auto;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-right .qtm-lookbook__header-copy {
    margin-left: auto;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__eyebrow {
    margin: 0;
    color: var(--qtm-lookbook-link-color);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__heading {
    margin: 0;
    color: var(--qtm-lookbook-heading-color);
    line-height: 1.04;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__text {
    color: var(--qtm-lookbook-text-color);
    line-height: 1.7;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__text p {
    margin-top: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__header-link,
  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    color: var(--qtm-lookbook-link-color);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 180ms ease;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__header-link:hover,
  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-link:hover {
    opacity: 0.72;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__header-link:focus-visible,
  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-link:focus-visible,
  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-card:focus-visible {
    outline: 3px solid var(--qtm-lookbook-link-color);
    outline-offset: 4px;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__grid {
    display: grid;
    gap: var(--qtm-lookbook-gap);
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__grid {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-areas:
      "item1 item2"
      "item1 item3"
      "item4 item4";
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-grid .qtm-lookbook__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__grid {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: stretch;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--1 {
    grid-area: item1;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--2 {
    grid-area: item2;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--3 {
    grid-area: item3;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--4 {
    grid-area: item4;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__item--1 {
    grid-column: span 7;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__item--2 {
    grid-column: span 5;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__item--3 {
    grid-column: span 5;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__item--4 {
    grid-column: span 7;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__item {
    position: relative;
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    border-radius: calc(var(--qtm-lookbook-border-radius) * 0.85);
    background: color-mix(in srgb, var(--qtm-lookbook-text-color), transparent 94%);
    isolation: isolate;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__image,
  .qtm-lookbook-{{ block_id }} .qtm-lookbook__placeholder,
  .qtm-lookbook-{{ block_id }} .qtm-lookbook__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.image_min_height }}px;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__image {
    object-fit: cover;
    transition: transform 520ms ease;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__item:hover .qtm-lookbook__image {
    transform: scale(1.035);
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--1 .qtm-lookbook__image,
  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--1 .qtm-lookbook__placeholder {
    min-height: calc({{ block.settings.image_min_height }}px * 2 + var(--qtm-lookbook-gap));
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__placeholder {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--qtm-lookbook-text-color), transparent 94%);
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__placeholder-svg {
    opacity: 0.28;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--qtm-lookbook-overlay-color);
    opacity: var(--qtm-lookbook-overlay-opacity);
    pointer-events: none;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 0.55rem;
    max-width: min(82%, 28rem);
    padding: 1.25rem;
    color: #ffffff;
    text-align: left;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption--bottom-left {
    left: 0;
    bottom: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption--bottom-center {
    left: 50%;
    bottom: 0;
    text-align: center;
    transform: translateX(-50%);
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption--center {
    left: 50%;
    top: 50%;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-heading {
    margin: 0;
    color: inherit;
    font-size: clamp(1.1rem, 1.6vw, 1.75rem);
    line-height: 1.08;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-text {
    color: inherit;
    line-height: 1.55;
    opacity: 0.9;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-text p {
    margin-top: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-text p:last-child {
    margin-bottom: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption-link {
    color: inherit;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-grid .qtm-lookbook__product-card,
  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__product-card,
  .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__product-card {
    justify-self: start;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-center .qtm-lookbook__product-card {
    justify-self: center;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--align-right .qtm-lookbook__product-card {
    justify-self: end;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-card {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    width: min(100%, 24rem);
    padding: 0.75rem;
    color: var(--qtm-lookbook-text-color);
    background: var(--qtm-lookbook-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-lookbook-text-color), transparent 88%);
    border-radius: calc(var(--qtm-lookbook-border-radius) * 0.55);
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.06);
    text-align: left;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 1.1rem 2.6rem rgba(0, 0, 0, 0.1);
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-image {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: calc(var(--qtm-lookbook-border-radius) * 0.35);
    object-fit: cover;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-content {
    display: grid;
    gap: 0.22rem;
    min-width: 0;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-kicker {
    color: var(--qtm-lookbook-link-color);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-title {
    color: var(--qtm-lookbook-heading-color);
    font-weight: 750;
    line-height: 1.25;
  }

  .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-price {
    color: var(--qtm-lookbook-text-color);
    font-size: 0.9rem;
    opacity: 0.76;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--animation-fade {
    animation: qtm-lookbook-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--animation-fade-up {
    animation: qtm-lookbook-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--animation-fade-down {
    animation: qtm-lookbook-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--animation-fade-left {
    animation: qtm-lookbook-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--animation-fade-right {
    animation: qtm-lookbook-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-lookbook-{{ block_id }}.qtm-lookbook--animation-zoom {
    animation: qtm-lookbook-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-lookbook-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-lookbook-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-lookbook-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-lookbook-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-lookbook-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-lookbook-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--hide-tablet {
      display: none !important;
    }

    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__grid,
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-grid .qtm-lookbook__grid,
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: none;
    }

    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item,
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__item {
      grid-area: auto;
      grid-column: auto;
    }

    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--1 .qtm-lookbook__image,
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__item--1 .qtm-lookbook__placeholder {
      min-height: {{ block.settings.image_min_height }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-lookbook-{{ block_id }} {
      padding: min(var(--qtm-lookbook-padding), 24px);
    }

    .qtm-lookbook-{{ block_id }}.qtm-lookbook--hide-mobile {
      display: none !important;
    }

    .qtm-lookbook-{{ block_id }} .qtm-lookbook__header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-editorial .qtm-lookbook__grid,
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-grid .qtm-lookbook__grid,
    .qtm-lookbook-{{ block_id }}.qtm-lookbook--layout-collage .qtm-lookbook__grid {
      grid-template-columns: 1fr;
    }

    .qtm-lookbook-{{ block_id }} .qtm-lookbook__image,
    .qtm-lookbook-{{ block_id }} .qtm-lookbook__placeholder,
    .qtm-lookbook-{{ block_id }} .qtm-lookbook__placeholder-svg {
      min-height: {{ block.settings.mobile_image_min_height }}px;
    }

    .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption {
      position: absolute;
      inset: auto 0 0 0;
      max-width: none;
      padding: 1rem;
      transform: none;
      text-align: left;
    }

    .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption--bottom-center,
    .qtm-lookbook-{{ block_id }} .qtm-lookbook__caption--center {
      left: 0;
      top: auto;
      bottom: 0;
      transform: none;
      text-align: left;
    }

    .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-card {
      width: 100%;
      grid-template-columns: 4rem minmax(0, 1fr);
    }

    .qtm-lookbook-{{ block_id }} .qtm-lookbook__product-image {
      width: 4rem;
      height: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-lookbook-{{ block_id }},
    .qtm-lookbook-{{ block_id }} *,
    .qtm-lookbook-{{ block_id }} *::before,
    .qtm-lookbook-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

