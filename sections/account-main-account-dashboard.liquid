{% comment %}
  Quadratum Account System
  File 2 of 5 — Account Dashboard Only

  Handles:
  - Welcome message
  - Customer summary
  - Recent orders preview
  - Account navigation cards
  - Optional support/help panel
  - Logout link

  Does NOT handle:
  - Full order history
  - Order detail
  - Order tracking logic
  - Address management forms
{% endcomment %}

{{ 'account-main-account-dashboard.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout_style = section.settings.layout_style

  assign customer_display_name = customer.email
  if customer.first_name != blank
    assign customer_display_name = customer.first_name
  endif

  assign shopping_url = section.settings.shopping_url
  if shopping_url == blank
    assign shopping_url = routes.all_products_collection_url
  endif

  assign tracking_url = section.settings.tracking_url
  if tracking_url == blank
    assign tracking_url = '/pages/order-tracking'
  endif
-%}

<section
  id="QtmAccountMainDashboard-{{ section.id }}"
  class="
    account-main-account-dashboard
    account-main-account-dashboard--{{ layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-subheading-size: {{ section.settings.subheading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-gap: {{ section.settings.card_gap }}px;
    --qtm-account-button-radius: {{ section.settings.button_radius }}px;
    --qtm-account-button-padding: {{ section.settings.button_padding }}px;
    --qtm-account-link-color: {{ section.settings.link_color }};
  "
>
  <div class="account-main-account-dashboard__shell">
    {% if customer %}
      <header class="account-main-account-dashboard__header">
        <div>
          <h1 class="account-main-account-dashboard__heading">
            {{ section.settings.heading }}
          </h1>

          {% if section.settings.subheading != blank %}
            <p class="account-main-account-dashboard__subheading">
              {% if section.settings.show_customer_name %}
                Welcome back, {{ customer_display_name }}.
              {% else %}
                {{ section.settings.subheading }}
              {% endif %}
            </p>
          {% endif %}
        </div>
      </header>

      <div class="account-main-account-dashboard__layout">
        {% if section.settings.show_nav_cards %}
          <aside class="account-main-account-dashboard__sidebar">
            <nav
              class="account-main-account-dashboard__nav"
              aria-label="Account navigation"
            >
              <a
                href="{{ routes.account_url }}"
                class="account-main-account-dashboard__nav-card"
              >
                <span class="account-main-account-dashboard__nav-title">
                  {{ section.settings.orders_label }}
                </span>
                <span class="account-main-account-dashboard__nav-text">
                  View your recent orders.
                </span>
              </a>

              <a
                href="{{ routes.account_addresses_url }}"
                class="account-main-account-dashboard__nav-card"
              >
                <span class="account-main-account-dashboard__nav-title">
                  {{ section.settings.addresses_label }}
                </span>
                <span class="account-main-account-dashboard__nav-text">
                  Manage your saved addresses.
                </span>
              </a>

              <a
                href="{{ tracking_url }}"
                class="account-main-account-dashboard__nav-card"
              >
                <span class="account-main-account-dashboard__nav-title">
                  {{ section.settings.tracking_label }}
                </span>
                <span class="account-main-account-dashboard__nav-text">
                  Track a shipment or delivery.
                </span>
              </a>

              <a
                href="{{ shopping_url }}"
                class="account-main-account-dashboard__nav-card"
              >
                <span class="account-main-account-dashboard__nav-title">
                  {{ section.settings.shopping_label }}
                </span>
                <span class="account-main-account-dashboard__nav-text">
                  Return to the storefront.
                </span>
              </a>

              <a
                href="{{ routes.account_logout_url }}"
                class="account-main-account-dashboard__nav-card account-main-account-dashboard__nav-card--logout"
              >
                <span class="account-main-account-dashboard__nav-title">
                  {{ section.settings.logout_label }}
                </span>
                <span class="account-main-account-dashboard__nav-text">
                  Securely sign out of your account.
                </span>
              </a>
            </nav>
          </aside>
        {% endif %}

        <div class="account-main-account-dashboard__main">
          {% if section.settings.show_customer_summary %}
            <div class="account-main-account-dashboard__panel account-main-account-dashboard__summary">
              <div class="account-main-account-dashboard__panel-header">
                <h2 class="account-main-account-dashboard__panel-title">
                  Customer Summary
                </h2>
              </div>

              <div class="account-main-account-dashboard__summary-grid">
                <div class="account-main-account-dashboard__summary-item">
                  <span class="account-main-account-dashboard__summary-label">
                    Name
                  </span>
                  <span class="account-main-account-dashboard__summary-value">
                    {% if customer.name != blank %}
                      {{ customer.name }}
                    {% else %}
                      {{ customer_display_name }}
                    {% endif %}
                  </span>
                </div>

                {% if section.settings.show_email %}
                  <div class="account-main-account-dashboard__summary-item">
                    <span class="account-main-account-dashboard__summary-label">
                      Email
                    </span>
                    <span class="account-main-account-dashboard__summary-value">
                      {{ customer.email }}
                    </span>
                  </div>
                {% endif %}

                <div class="account-main-account-dashboard__summary-item">
                  <span class="account-main-account-dashboard__summary-label">
                    Orders
                  </span>
                  <span class="account-main-account-dashboard__summary-value">
                    {{ customer.orders_count | default: 0 }}
                  </span>
                </div>

                {% if section.settings.show_default_address %}
                  <div class="account-main-account-dashboard__summary-item account-main-account-dashboard__summary-item--wide">
                    <span class="account-main-account-dashboard__summary-label">
                      Default Address
                    </span>

                    <span class="account-main-account-dashboard__summary-value">
                      {% if customer.default_address != blank %}
                        {{ customer.default_address | format_address }}
                      {% else %}
                        No default address saved.
                      {% endif %}
                    </span>
                  </div>
                {% endif %}
              </div>

              <div class="account-main-account-dashboard__summary-actions">
                <a href="{{ routes.account_addresses_url }}">
                  Manage addresses
                </a>
              </div>
            </div>
          {% endif %}

          {% if section.settings.show_recent_orders %}
            <div class="account-main-account-dashboard__panel account-main-account-dashboard__orders">
              <div class="account-main-account-dashboard__panel-header account-main-account-dashboard__panel-header--split">
                <h2 class="account-main-account-dashboard__panel-title">
                  Recent Orders
                </h2>

                <a
                  href="{{ routes.account_url }}"
                  class="account-main-account-dashboard__panel-link"
                >
                  View account
                </a>
              </div>

              {% paginate customer.orders by section.settings.recent_orders_limit %}
                {% if customer.orders.size > 0 %}
                  <div class="account-main-account-dashboard__table-wrap">
                    <table class="account-main-account-dashboard__orders-table">
                      <caption class="visually-hidden">
                        Recent customer orders
                      </caption>

                      <thead>
                        <tr>
                          <th scope="col">Order</th>
                          <th scope="col">Date</th>
                          <th scope="col">Payment</th>
                          <th scope="col">Fulfillment</th>
                          <th scope="col">Total</th>
                        </tr>
                      </thead>

                      <tbody>
                        {% for order in customer.orders %}
                          <tr>
                            <td data-label="Order">
                              <a href="{{ order.customer_url }}">
                                {{ order.name }}
                              </a>
                            </td>

                            <td data-label="Date">
                              {{ order.created_at | date: format: 'abbreviated_date' }}
                            </td>

                            <td data-label="Payment">
                              {{ order.financial_status_label }}
                            </td>

                            <td data-label="Fulfillment">
                              {{ order.fulfillment_status_label }}
                            </td>

                            <td data-label="Total">
                              {{ order.total_price | money }}
                            </td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                {% else %}
                  <div class="account-main-account-dashboard__empty">
                    <p>You have not placed any orders yet.</p>

                    <a
                      href="{{ shopping_url }}"
                      class="account-main-account-dashboard__button account-main-account-dashboard__button--{{ section.settings.button_style }}"
                    >
                      {{ section.settings.shopping_label }}
                    </a>
                  </div>
                {% endif %}
              {% endpaginate %}
            </div>
          {% endif %}

          {% if section.settings.show_support_panel %}
            <div class="account-main-account-dashboard__panel account-main-account-dashboard__support">
              {% if section.settings.support_heading != blank %}
                <h2 class="account-main-account-dashboard__panel-title">
                  {{ section.settings.support_heading }}
                </h2>
              {% endif %}

              {% if section.settings.support_text != blank %}
                <div class="account-main-account-dashboard__support-text rte">
                  {{ section.settings.support_text }}
                </div>
              {% endif %}

              {% if section.settings.support_button_label != blank and section.settings.support_button_url != blank %}
                <a
                  href="{{ section.settings.support_button_url }}"
                  class="account-main-account-dashboard__button account-main-account-dashboard__button--{{ section.settings.button_style }}"
                >
                  {{ section.settings.support_button_label }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="account-main-account-dashboard__guest">
        <h1 class="account-main-account-dashboard__heading">
          {{ section.settings.heading }}
        </h1>

        <p class="account-main-account-dashboard__subheading">
          Please sign in to view your account.
        </p>

        <a
          href="{{ routes.account_login_url }}"
          class="account-main-account-dashboard__button account-main-account-dashboard__button--{{ section.settings.button_style }}"
        >
          Sign in
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Account Main Dashboard",
  "tag": "section",
  "class": "qtm-account-main-dashboard",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "classic",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Account"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Manage your orders, addresses, and account details."
    },
    {
      "type": "checkbox",
      "id": "show_customer_name",
      "label": "Show customer name in welcome message",
      "default": true
    },
    {
      "type": "header",
      "content": "Customer summary"
    },
    {
      "type": "checkbox",
      "id": "show_customer_summary",
      "label": "Show customer summary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_default_address",
      "label": "Show default address",
      "default": true
    },
    {
      "type": "header",
      "content": "Account navigation cards"
    },
    {
      "type": "checkbox",
      "id": "show_nav_cards",
      "label": "Show navigation cards",
      "default": true
    },
    {
      "type": "text",
      "id": "orders_label",
      "label": "Orders label",
      "default": "Orders"
    },
    {
      "type": "text",
      "id": "addresses_label",
      "label": "Addresses label",
      "default": "Addresses"
    },
    {
      "type": "text",
      "id": "tracking_label",
      "label": "Order tracking label",
      "default": "Order Tracking"
    },
    {
      "type": "url",
      "id": "tracking_url",
      "label": "Order tracking URL"
    },
    {
      "type": "text",
      "id": "shopping_label",
      "label": "Continue shopping label",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "shopping_url",
      "label": "Continue shopping URL"
    },
    {
      "type": "text",
      "id": "logout_label",
      "label": "Logout label",
      "default": "Logout"
    },
    {
      "type": "header",
      "content": "Recent orders"
    },
    {
      "type": "checkbox",
      "id": "show_recent_orders",
      "label": "Show recent orders",
      "default": true
    },
    {
      "type": "range",
      "id": "recent_orders_limit",
      "label": "Recent orders limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Support panel"
    },
    {
      "type": "checkbox",
      "id": "show_support_panel",
      "label": "Show support panel",
      "default": true
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support heading",
      "default": "Need help?"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text",
      "default": "<p>Have a question about your order or account? Our team is here to help.</p>"
    },
    {
      "type": "text",
      "id": "support_button_label",
      "label": "Support button label",
      "default": "Contact Support"
    },
    {
      "type": "url",
      "id": "support_button_url",
      "label": "Support button URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Cards and panels"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Buttons and links"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111827"
    }
  ],
  "presets": [
    {
      "name": "Account Main Dashboard"
    }
  ]
}
{% endschema %}