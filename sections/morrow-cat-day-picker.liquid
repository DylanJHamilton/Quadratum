<section class="mc-day-picker" aria-labelledby="MorrowDayTitle-{{ section.id }}">
  <div class="mc-day-picker__image">
    {%- assign cat_asset = section.settings.image_asset | default: 'mc-cat-closeup.webp' -%}
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image_alt, loading: 'lazy', widths: '480, 720, 960, 1200' }}
    {% else %}
      <img src="{{ cat_asset | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1200" height="1200" loading="lazy">
    {% endif %}
    <span>{{ section.settings.image_caption | escape }}</span>
  </div>
  <div class="mc-day-picker__copy">
    <p class="mc-eyebrow">{{ section.settings.kicker | escape }}</p>
    <h2 id="MorrowDayTitle-{{ section.id }}">{{ section.settings.heading | escape }}<br><em>{{ section.settings.heading_accent | escape }}</em></h2>
    <div class="mc-day-picker__body">{{ section.settings.body }}</div>
    <div class="mc-day-picker__options" role="group" aria-label="Choose a cat day to browse">
      <button type="button" data-mc-quiz="Play">{{ section.settings.play_label | escape }} <span aria-hidden="true">↗</span></button>
      <button type="button" data-mc-quiz="Rest">{{ section.settings.rest_label | escape }} <span aria-hidden="true">↗</span></button>
      <button type="button" data-mc-quiz="Feeding">{{ section.settings.feeding_label | escape }} <span aria-hidden="true">↗</span></button>
      <button type="button" data-mc-quiz="Care">{{ section.settings.care_label | escape }} <span aria-hidden="true">↗</span></button>
    </div>
    <p class="mc-day-picker__result" data-mc-quiz-result aria-live="polite">{{ section.settings.disclaimer | escape }}</p>
  </div>
</section>
{% schema %}
{
  "name":"Morrow Cat Day Picker",
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"A two-minute daydream"},
    {"type":"text","id":"heading","label":"Heading","default":"What kind of"},
    {"type":"text","id":"heading_accent","label":"Accent line","default":"cat day is it?"},
    {"type":"richtext","id":"body","label":"Description","default":"<p>Tell us what has their attention today. We’ll point you toward a corner of the Morrow collection to explore.</p>"},
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"text","id":"image_asset","label":"Theme asset filename","default":"mc-cat-closeup.webp"},
    {"type":"text","id":"image_alt","label":"Image description","default":"A tortoiseshell cat with bright, curious eyes."},
    {"type":"text","id":"image_caption","label":"Image caption","default":"Curious by nature / 01"},
    {"type":"text","id":"play_label","label":"Play option","default":"The zoomies are imminent"},
    {"type":"text","id":"rest_label","label":"Rest option","default":"Sunbeam. Blanket. Repeat."},
    {"type":"text","id":"feeding_label","label":"Feeding option","default":"It’s dinner o’clock (again)"},
    {"type":"text","id":"care_label","label":"Care option","default":"A little everyday reset"},
    {"type":"text","id":"disclaimer","label":"Quiz note","default":"Just for fun: a starting point, never a suitability recommendation."}
  ],
  "presets":[{"name":"Morrow Cat Day Picker"}]
}
{% endschema %}

