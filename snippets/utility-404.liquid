{%- liquid
  assign utility_404_link = settings.notfound_cta_link | default: routes.root_url
  if utility_404_link == '/'
    assign utility_404_link = routes.root_url
  endif
-%}
{%- capture utility_safe -%}{%- render 'account-safe-link', url: utility_404_link -%}{%- endcapture -%}
{%- assign utility_404_link = utility_safe | strip | default: routes.root_url -%}
<section id="Utility404-{{ section.id | escape }}" class="section-pad" style="text-align:center;overflow-wrap:anywhere;background:var(--c-surface);color:var(--c-text)">
  <div class="container">
    <h1 class="h2" style="margin-bottom:var(--space-sm)">{{ settings.notfound_heading | default: 'Page not found' | escape }}</h1>
    <p style="margin:0 auto var(--space-md);max-width:65ch">{{ settings.notfound_body | escape | newline_to_br }}</p>
    <a href="{{ utility_404_link | escape }}" class="btn btn--{{ settings.button_variant_default | default: 'solid' | escape }} btn--md">
      {{ settings.notfound_cta_label | default: 'Back to home' | escape }}
    </a>
  </div>
</section>
