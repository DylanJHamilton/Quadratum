{{ 'editorial-story.css' | asset_url | stylesheet_tag }}
<section class="q-editorial q-editorial--{{ section.settings.layout }}" style="--qe-bg:{{ section.settings.background }};--qe-ink:{{ section.settings.foreground }}" aria-labelledby="Editorial-{{ section.id }}">
  {% if section.settings.image != blank %}
    <div class="q-editorial__media">
      {% if section.settings.layout == 'hero' %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1400, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
      {% else %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 50vw, 100vw', loading: 'lazy' }}
      {% endif %}
    </div>
  {% endif %}
  <div class="q-editorial__copy">
    {% if section.settings.eyebrow != blank %}<p class="q-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <{{ section.settings.heading_tag }} id="Editorial-{{ section.id }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
    {% if section.settings.body != blank %}<div class="q-editorial__body rte">{{ section.settings.body }}</div>{% endif %}
    <div class="q-editorial__actions">
      {% if section.settings.link != blank and section.settings.label != blank %}<a class="q-editorial__button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}
      {% if section.settings.link_two != blank and section.settings.label_two != blank %}<a class="q-editorial__link" href="{{ section.settings.link_two }}">{{ section.settings.label_two | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  </div>
  {% if section.blocks.size > 0 %}<div class="q-editorial__cards">
    {% for block in section.blocks %}<article class="q-editorial__card" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360, 600, 1000', sizes: '(min-width: 800px) 33vw, 100vw', loading: 'lazy' }}{% endif %}
      <div><p class="q-editorial__eyebrow">{{ block.settings.eyebrow | escape }}</p><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="q-editorial__link" href="{{ block.settings.link }}">{{ block.settings.label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div>
    </article>{% endfor %}
  </div>{% endif %}
</section>
{% schema %}
{
 "name":"Editorial story",
 "settings":[
 {"type":"select","id":"layout","label":"Layout","default":"split","options":[{"value":"hero","label":"Immersive hero"},{"value":"split","label":"Image and story"},{"value":"text","label":"Editorial text"}]},
 {"type":"image_picker","id":"image","label":"Image"},
 {"type":"text","id":"eyebrow","label":"Eyebrow"},
 {"type":"text","id":"heading","label":"Heading","default":"A point of view."},
 {"type":"select","id":"heading_tag","label":"Heading level","default":"h2","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"}]},
 {"type":"richtext","id":"body","label":"Story"},
 {"type":"text","id":"label","label":"Button label"},{"type":"url","id":"link","label":"Button link"},
 {"type":"text","id":"label_two","label":"Secondary label"},{"type":"url","id":"link_two","label":"Secondary link"},
 {"type":"color","id":"background","label":"Background","default":"#f5f5f1"},{"type":"color","id":"foreground","label":"Text","default":"#181818"}
 ],
 "blocks":[{"type":"story","name":"Story card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Description"},{"type":"text","id":"label","label":"Link label","default":"Discover"},{"type":"url","id":"link","label":"Link"}]}],
 "max_blocks":6,"presets":[{"name":"Editorial story"}]
}
{% endschema %}
