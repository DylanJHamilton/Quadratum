            "field_type": "email",
            "name_attr": "email",
            "label": "Email",
            "required": true,
            "width": "half"
          }
        },
        "van_3": {
          "type": "field",
          "settings": {
            "field_type": "select",
            "name_attr": "topic",
            "label": "Topic",
            "required": true,
            "width": "half",
            "options": "A specific design\nSizing\nCare\nOrdering\nThis demonstration store\nSomething else"
          }
        },
        "van_4": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "design",
            "label": "Design name or SKU",
            "required": false,
            "width": "half",
            "help_text": "Optional. For example, VAN-001-01-04."
          }
        },
        "van_5": {
          "type": "field",
          "settings": {
            "field_type": "textarea",
            "name_attr": "body",
            "label": "Your question",
            "required": true,
            "width": "full"
          }
        }
      },
