    "main": {
      "type": "main-product-classic",
      "blocks": {
        "description_1": {
          "type": "description",
          "settings": {
            "heading": "About this book"
          }
        },
        "meta_data_2": {
          "type": "meta_data",
          "settings": {
            "heading": "From the shelf note",
            "label_1": "Who might enjoy it",
            "namespace_1": "folio",
            "key_1": "reader_note",
            "label_2": "A question to take with you",
            "namespace_2": "folio",
            "key_2": "discussion_question",
            "label_3": "Creator",
            "namespace_3": "folio",
            "key_3": "creator"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Edition details",
            "answer": "<p>Formats are listed above the add-to-cart button. The front-cover artwork is shared across formats. Creators are fictional placeholders and demo prices are illustrative.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Shipping and returns",
            "answer": "<p>Flat-rate shipping shown at checkout. Free shop pickup, ready the same day. Thirty-day returns with the receipt or order email.</p>"
          }
        }
      },
      "block_order": [
        "description_1",
        "meta_data_2",
        "faq_item_3",
        "faq_item_4"
      ],
      "settings": {
        "desktop_layout_direction": "normal",
        "max_width": "lg",
        "pad_y": "md",
        "pad_x": "md",
