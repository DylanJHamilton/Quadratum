{% comment %}Optional drawer reward thresholds; fulfillment is configured in Shopify.{% endcomment %}
{% liquid
  assign highest = 0
  for i in (1..3)
    assign amount_key = 'cart_drawer_tier_' | append: i | append: '_amount'
    assign threshold = settings[amount_key] | times: 100
    if threshold > highest
      assign highest = threshold
    endif
  endfor
%}
{% if highest > 0 %}
<div class="qtm-cart-rewards" data-cart-rewards>
  <h3 class="qtm-cart-rewards__title">Cart goals</h3>
  <progress max="{{ highest }}" value="{{ cart.total_price | at_most: highest }}" aria-label="Progress toward cart goals"></progress>
  <div class="qtm-cart-rewards__tiers">
    {% for i in (1..3) %}
      {% liquid
        assign amount_key = 'cart_drawer_tier_' | append: i | append: '_amount'
        assign label_key = 'cart_drawer_tier_' | append: i | append: '_label'
        assign threshold = settings[amount_key] | times: 100
      %}
      {% if threshold > 0 %}
      <div class="qtm-cart-rewards__tier qtm-cart-rewards__tier--{% if cart.total_price >= threshold %}unlocked{% else %}locked{% endif %}">
        <strong>{{ settings[label_key] | default: 'Cart goal' | escape }}</strong>
        <span>{% if cart.total_price >= threshold %}Threshold reached{% else %}{{ threshold | minus: cart.total_price | money }} to go{% endif %}</span>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  <small>Reward eligibility is calculated at checkout.</small>
</div>
{% endif %}
