{%- liquid
  assign block_id = 'content-product-grid-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign source = block.settings.product_source | default: 'collection'
  assign selected_collection = block.settings.collection
  assign product_limit = block.settings.product_limit | default: 8
  assign grid_layout = block.settings.grid_layout | default: 'cards'
  assign columns_desktop = block.settings.columns_desktop | default: 4
  assign columns_tablet = block.settings.columns_tablet | default: 3
  assign columns_mobile = block.settings.columns_mobile | default: 2

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-product-grid
    content-product-grid--{{ grid_layout }}
    content-product-grid--width-{{ width }}
    content-product-grid--align-{{ alignment }}
    {% unless show_on_desktop %} content-product-grid--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-product-grid--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-product-grid--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-product-grid--animate content-product-grid--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-product-grid-margin-top: {{ block.settings.margin_top }}px;
    --content-product-grid-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-product-grid-padding: {{ block.settings.padding }}px;
    --content-product-grid-gap: {{ block.settings.grid_gap }}px;
    --content-product-grid-card-padding: {{ block.settings.card_padding }}px;
    --content-product-grid-card-radius: {{ block.settings.card_radius }}px;
    --content-product-grid-border-width: {{ block.settings.border_width }}px;
    --content-product-grid-columns-desktop: {{ columns_desktop }};
    --content-product-grid-columns-tablet: {{ columns_tablet }};
    --content-product-grid-columns-mobile: {{ columns_mobile }};
    --content-product-grid-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-product-grid-heading-color: {{ block.settings.heading_color }};
    --content-product-grid-text-color: {{ block.settings.text_color }};
    --content-product-grid-price-color: {{ block.settings.price_color }};
    --content-product-grid-sale-color: {{ block.settings.sale_color }};
    --content-product-grid-background: {{ block.settings.background_color }};
    --content-product-grid-card-background: {{ block.settings.card_background_color }};
    --content-product-grid-border-color: {{ block.settings.border_color }};
    --content-product-grid-button-background: {{ block.settings.button_background_color }};
    --content-product-grid-button-text: {{ block.settings.button_text_color }};
    --content-product-grid-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-product-grid
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-product-grid-margin-top);
      margin-bottom: var(--content-product-grid-margin-bottom);
      padding: var(--content-product-grid-padding);
      color: var(--content-product-grid-text-color);
      background: var(--content-product-grid-background);
    }

    #{{ block_id }}.content-product-grid--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-product-grid--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.content-product-grid--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.content-product-grid--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.content-product-grid--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-product-grid--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-product-grid--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-product-grid--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-product-grid__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-product-grid__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }}.content-product-grid--align-center .content-product-grid__header {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-product-grid--align-right .content-product-grid__header {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-product-grid__eyebrow {
      margin: 0;
      color: var(--content-product-grid-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-product-grid__heading {
      margin: 0;
      color: var(--content-product-grid-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-product-grid__description {
      margin: 0;
      color: var(--content-product-grid-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-product-grid__items {
      display: grid;
      grid-template-columns: repeat(var(--content-product-grid-columns-desktop), minmax(0, 1fr));
      gap: var(--content-product-grid-gap);
      min-width: 0;
    }

    #{{ block_id }} .content-product-grid__card {
      position: relative;
      display: grid;
      gap: 12px;
      min-width: 0;
      color: var(--content-product-grid-text-color);
      text-decoration: none;
    }

    #{{ block_id }}.content-product-grid--cards .content-product-grid__card,
    #{{ block_id }}.content-product-grid--grid .content-product-grid__card {
      padding: var(--content-product-grid-card-padding);
      background: var(--content-product-grid-card-background);
      border: var(--content-product-grid-border-width) solid var(--content-product-grid-border-color);
      border-radius: var(--content-product-grid-card-radius);
      overflow: hidden;
    }

    #{{ block_id }}.content-product-grid--minimal .content-product-grid__card {
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    #{{ block_id }} .content-product-grid__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--content-product-grid-card-radius) - 8px), 0px);
      aspect-ratio: var(--content-product-grid-image-ratio);
    }

    #{{ block_id }}.content-product-grid--minimal .content-product-grid__media {
      border-radius: var(--content-product-grid-card-radius);
    }

    #{{ block_id }} .content-product-grid__media img,
    #{{ block_id }} .content-product-grid__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .content-product-grid__card:hover .content-product-grid__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .content-product-grid__placeholder {
      background:
        linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .content-product-grid__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--content-product-grid-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .content-product-grid__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }} .content-product-grid__vendor {
      color: var(--content-product-grid-text-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.68;
    }

    #{{ block_id }} .content-product-grid__title {
      margin: 0;
      color: var(--content-product-grid-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .content-product-grid__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--content-product-grid-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.content-product-grid--align-center .content-product-grid__price-row {
      justify-content: center;
    }

    #{{ block_id }}.content-product-grid--align-right .content-product-grid__price-row {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-product-grid__price {
      color: var(--content-product-grid-price-color);
      font-weight: 700;
    }

    #{{ block_id }} .content-product-grid__compare {
      color: var(--content-product-grid-text-color);
      text-decoration: line-through;
      opacity: 0.55;
    }

    #{{ block_id }} .content-product-grid__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-product-grid-button-text);
      background: var(--content-product-grid-button-background);
      border: 1px solid var(--content-product-grid-button-background);
      border-radius: max(calc(var(--content-product-grid-card-radius) - 10px), 6px);
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.content-product-grid--align-center .content-product-grid__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-product-grid--align-right .content-product-grid__button {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-product-grid__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-grid__card:focus-visible,
    #{{ block_id }} .content-product-grid__button:focus-visible {
      outline: 2px solid var(--content-product-grid-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-grid__empty {
      padding: 18px;
      color: var(--content-product-grid-text-color);
      background: var(--content-product-grid-card-background);
      border: var(--content-product-grid-border-width) solid var(--content-product-grid-border-color);
      border-radius: var(--content-product-grid-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-product-grid--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-product-grid--animate-fade {
      animation-name: contentProductGridFade;
    }

    #{{ block_id }}.content-product-grid--animate-fade_up {
      animation-name: contentProductGridFadeUp;
    }

    #{{ block_id }}.content-product-grid--animate-zoom {
      animation-name: contentProductGridZoom;
    }

    @keyframes contentProductGridFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentProductGridFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentProductGridZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-product-grid--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-product-grid--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-product-grid__items {
        grid-template-columns: repeat(var(--content-product-grid-columns-tablet), minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-product-grid--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-product-grid__items {
        grid-template-columns: repeat(var(--content-product-grid-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }} .content-product-grid__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-product-grid--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-product-grid__media img,
      #{{ block_id }} .content-product-grid__button {
        transition: none;
      }

      #{{ block_id }} .content-product-grid__card:hover .content-product-grid__media img,
      #{{ block_id }} .content-product-grid__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-product-grid__inner">
    {% if block.settings.show_header %}
      <div class="content-product-grid__header">
        {% if block.settings.eyebrow != blank %}
          <p class="content-product-grid__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="content-product-grid__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="content-product-grid__description">
            {{ block.settings.description | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {%- liquid
      assign rendered_products = 0
    -%}

    <div class="content-product-grid__items">
      {% if source == 'manual' %}
        {% for grid_product in block.settings.products limit: product_limit %}
          {%- liquid
            assign rendered_products = rendered_products | plus: 1
            assign grid_variant = grid_product.selected_or_first_available_variant
            assign is_on_sale = false

            if grid_variant.compare_at_price > grid_variant.price
              assign is_on_sale = true
            endif
          -%}

          <article class="content-product-grid__card">
            <a class="content-product-grid__media" href="{{ grid_product.url }}" aria-label="{{ grid_product.title | escape }}">
              {% if grid_product.featured_image %}
                {% if forloop.first %}
                  {{ grid_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: grid_product.featured_image.alt | default: grid_product.title }}
                {% else %}
                  {{ grid_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: grid_product.featured_image.alt | default: grid_product.title }}
                {% endif %}
              {% else %}
                <span class="content-product-grid__placeholder" aria-hidden="true"></span>
              {% endif %}

              {% if block.settings.show_sale_badge and is_on_sale %}
                <span class="content-product-grid__badge">
                  {{ block.settings.sale_badge_text | escape }}
                </span>
              {% endif %}
            </a>

            <div class="content-product-grid__content">
              {% if block.settings.show_vendor and grid_product.vendor != blank %}
                <div class="content-product-grid__vendor">
                  {{ grid_product.vendor | escape }}
                </div>
              {% endif %}

              <h3 class="content-product-grid__title">
                <a href="{{ grid_product.url }}" class="content-product-grid__card-link">
                  {{ grid_product.title | escape }}
                </a>
              </h3>

              {% if block.settings.show_price %}
                <div class="content-product-grid__price-row">
                  <span class="content-product-grid__price">
                    {{ grid_variant.price | money }}
                  </span>

                  {% if is_on_sale %}
                    <span class="content-product-grid__compare">
                      {{ grid_variant.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.show_button %}
                <a class="content-product-grid__button" href="{{ grid_product.url }}">
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}

      {% elsif selected_collection != blank %}
        {% for grid_product in selected_collection.products limit: product_limit %}
          {%- liquid
            assign rendered_products = rendered_products | plus: 1
            assign grid_variant = grid_product.selected_or_first_available_variant
            assign is_on_sale = false

            if grid_variant.compare_at_price > grid_variant.price
              assign is_on_sale = true
            endif
          -%}

          <article class="content-product-grid__card">
            <a class="content-product-grid__media" href="{{ grid_product.url }}" aria-label="{{ grid_product.title | escape }}">
              {% if grid_product.featured_image %}
                {% if forloop.first %}
                  {{ grid_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '320, 480, 640, 800, 900', alt: grid_product.featured_image.alt | default: grid_product.title }}
                {% else %}
                  {{ grid_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: grid_product.featured_image.alt | default: grid_product.title }}
                {% endif %}
              {% else %}
                <span class="content-product-grid__placeholder" aria-hidden="true"></span>
              {% endif %}

              {% if block.settings.show_sale_badge and is_on_sale %}
                <span class="content-product-grid__badge">
                  {{ block.settings.sale_badge_text | escape }}
                </span>
              {% endif %}
            </a>

            <div class="content-product-grid__content">
              {% if block.settings.show_vendor and grid_product.vendor != blank %}
                <div class="content-product-grid__vendor">
                  {{ grid_product.vendor | escape }}
                </div>
              {% endif %}

              <h3 class="content-product-grid__title">
                <a href="{{ grid_product.url }}" class="content-product-grid__card-link">
                  {{ grid_product.title | escape }}
                </a>
              </h3>

              {% if block.settings.show_price %}
                <div class="content-product-grid__price-row">
                  <span class="content-product-grid__price">
                    {{ grid_variant.price | money }}
                  </span>

                  {% if is_on_sale %}
                    <span class="content-product-grid__compare">
                      {{ grid_variant.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.show_button %}
                <a class="content-product-grid__button" href="{{ grid_product.url }}">
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_products == 0 and block.settings.show_empty_state %}
      <div class="content-product-grid__empty">
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Content product grid",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "Featured collection"
        },
        {
          "value": "manual",
          "label": "Manual products"
        }
      ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Manual products",
      "limit": 24
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Product limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },

    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Showcase products customers should discover first."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "grid_layout",
      "label": "Layout",
      "default": "cards",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View product"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Product title size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
