{%- liquid
  assign code = request.locale.iso_code | downcase
  assign root = code | split: '-' | first
  assign rtl_roots = ',ar,arc,ckb,dv,fa,he,ps,sd,ur,yi,'
  assign token = ',' | append: root | append: ','
  assign direction = 'ltr'
  if settings.rtl_enable
    if code contains '-arab' or code contains '-hebr' or rtl_roots contains token
      assign direction = 'rtl'
    endif
    if code contains '-latn'
      assign direction = 'ltr'
    endif
  endif
  echo direction
-%}
