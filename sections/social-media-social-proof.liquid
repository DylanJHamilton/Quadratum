    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Layout variant",
      "default": "row",
      "options": [
        {
          "value": "row",
          "label": "Row"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "select",
      "id": "justify",
      "label": "Item justification",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-between",
          "label": "Space between"
        },
        {
          "value": "space-around",
          "label": "Space around"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "pill",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
