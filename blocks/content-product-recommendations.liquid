{%- liquid
  assign block_id = 'content-product-recommendations-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign source = block.settings.product_source | default: 'recommendations'
  assign selected_collection = block.settings.collection
  assign recommendation_limit = block.settings.product_limit | default: 4
  assign recommendation_layout = block.settings.recommendation_layout | default: 'grid'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile


  assign card_products = selected_collection.products
  if source == 'manual'
    assign card_products = block.settings.products
  endif
  assign rendered_products = 0

  assign product_limit = recommendation_limit
  assign performed_for_block = false
  assign native_recommendations = false
  assign can_request_recommendations = false
  if source == 'recommendations'
    assign card_products = blank
    assign native_limit = recommendation_limit | at_most: 10
    if recommendations.performed and recommendations.intent == 'related'
      assign performed_for_block = true
      assign card_products = recommendations.products
      assign product_limit = native_limit
      if recommendations.products_count > 0
        assign native_recommendations = true
      endif
    elsif product_context != blank and section.id != blank and routes.product_recommendations_url != blank
      assign can_request_recommendations = true
    endif
    assign recommendation_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product_context.id | append: '&limit=' | append: native_limit | append: '&intent=related'
  endif
-%}

{%- capture product_cards -%}
  {%- for card_product in card_products limit: product_limit -%}
    {%- if card_product != blank and card_product.url != blank -%}
      {%- render 'qtm-block-product-card', card_product: card_product, block: block, prefix: 'content-product-recommendations', price_scope: 'product', media_policy: 'omit-missing' -%}
      {%- assign rendered_products = rendered_products | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  id="{{ block_id }}"
  class="
    content-product-recommendations
    content-product-recommendations--{{ recommendation_layout }}
    content-product-recommendations--width-{{ width }}
    content-product-recommendations--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} content-product-recommendations--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} content-product-recommendations--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} content-product-recommendations--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} content-product-recommendations--animate content-product-recommendations--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-product-recommendations-margin-top: {{ block.settings.margin_top }}px;
    --content-product-recommendations-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-product-recommendations-padding: {{ block.settings.padding }}px;
    --content-product-recommendations-gap: {{ block.settings.grid_gap }}px;
    --content-product-recommendations-card-padding: {{ block.settings.card_padding }}px;
    --content-product-recommendations-card-radius: {{ block.settings.card_radius }}px;
    --content-product-recommendations-border-width: {{ block.settings.border_width }}px;
    --content-product-recommendations-columns-desktop: {{ block.settings.columns_desktop }};
    --content-product-recommendations-columns-tablet: {{ block.settings.columns_tablet }};
    --content-product-recommendations-columns-mobile: {{ block.settings.columns_mobile }};
    --content-product-recommendations-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-product-recommendations-heading-color: {{ block.settings.heading_color }};
    --content-product-recommendations-text-color: {{ block.settings.text_color }};
    --content-product-recommendations-price-color: {{ block.settings.price_color }};
    --content-product-recommendations-sale-color: {{ block.settings.sale_color }};
    --content-product-recommendations-background: {{ block.settings.background_color }};
    --content-product-recommendations-card-background: {{ block.settings.card_background_color }};
    --content-product-recommendations-border-color: {{ block.settings.border_color }};
    --content-product-recommendations-button-background: {{ block.settings.button_background_color }};
    --content-product-recommendations-button-text: {{ block.settings.button_text_color }};
    --content-product-recommendations-arrow-background: {{ block.settings.arrow_background_color }};
    --content-product-recommendations-arrow-text: {{ block.settings.arrow_text_color }};
    --content-product-recommendations-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  {% if rendered_products == 0 and request.design_mode == false %}hidden{% endif %}
  data-content-product-recommendations
  data-qtm-product-cards data-carousel="{% if recommendation_layout == 'carousel' %}true{% else %}false{% endif %}"
  data-dynamic-recommendations="{{ can_request_recommendations }}" data-recommendations-intent="related"
  data-recommendations-performed="{{ performed_for_block }}" data-native-recommendations="{{ native_recommendations }}"
  {% if can_request_recommendations %}data-recommendations-url="{{ recommendation_url | escape }}"{% endif %}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-product-recommendations-margin-top);
      margin-bottom: var(--content-product-recommendations-margin-bottom);
      padding: min(var(--content-product-recommendations-padding), 8%);
      color: var(--content-product-recommendations-text-color);
      background: var(--content-product-recommendations-background);
    }

    #{{ block_id }}.content-product-recommendations--width-auto {
      max-width: 100%;
    }

    #{{ block_id }}.content-product-recommendations--width-small {
      max-width: min(100%, 900px);
    }

    #{{ block_id }}.content-product-recommendations--width-medium {
      max-width: min(100%, 1100px);
    }

    #{{ block_id }}.content-product-recommendations--width-large {
      max-width: min(100%, 1320px);
    }

    #{{ block_id }}.content-product-recommendations--width-full {
      max-width: 100%;
    }

    #{{ block_id }}.content-product-recommendations--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-product-recommendations--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-product-recommendations--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-product-recommendations__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-product-recommendations__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.content-product-recommendations--align-center .content-product-recommendations__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-product-recommendations__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .content-product-recommendations__eyebrow {
      margin: 0;
      color: var(--content-product-recommendations-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-product-recommendations__heading {
      margin: 0;
      color: var(--content-product-recommendations-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-product-recommendations__description {
      margin: 0;
      color: var(--content-product-recommendations-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-product-recommendations__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .content-product-recommendations__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--content-product-recommendations-arrow-text);
      background: var(--content-product-recommendations-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-product-recommendations__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-recommendations__arrow:focus-visible {
      outline: 2px solid var(--content-product-recommendations-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-recommendations__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .content-product-recommendations__items {
      display: grid;
      grid-template-columns: repeat(var(--content-product-recommendations-columns-desktop), minmax(0, 1fr));
      gap: var(--content-product-recommendations-gap);
      min-width: 0;
    }

    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__items {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__items::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item {
      flex: 0 0 calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-desktop) - 1))) / var(--content-product-recommendations-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }} .content-product-recommendations__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--content-product-recommendations-text-color);
      text-decoration: none;
    }

    #{{ block_id }}.content-product-recommendations--grid .content-product-recommendations__card,
    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__card,
    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__card {
      padding: min(var(--content-product-recommendations-card-padding), 8%);
      background: var(--content-product-recommendations-card-background);
      border: var(--content-product-recommendations-border-width) solid var(--content-product-recommendations-border-color);
      border-radius: var(--content-product-recommendations-card-radius);
      overflow: hidden;
    }

    #{{ block_id }} .content-product-recommendations__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--content-product-recommendations-card-radius) - 8px), 0px);
      aspect-ratio: var(--content-product-recommendations-image-ratio);
    }

    #{{ block_id }} .content-product-recommendations__media img,
    #{{ block_id }} .content-product-recommendations__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .content-product-recommendations__card:hover .content-product-recommendations__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .content-product-recommendations__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .content-product-recommendations__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--content-product-recommendations-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .content-product-recommendations__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-product-recommendations__vendor {
      color: var(--content-product-recommendations-text-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.68;
    }

    #{{ block_id }} .content-product-recommendations__title {
      margin: 0;
      color: var(--content-product-recommendations-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .content-product-recommendations__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .content-product-recommendations__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .content-product-recommendations__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--content-product-recommendations-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__price-row {
      justify-content: center;
    }

    #{{ block_id }} .content-product-recommendations__price {
      color: var(--content-product-recommendations-price-color);
      font-weight: 700;
    }

    #{{ block_id }} .content-product-recommendations__compare {
      color: var(--content-product-recommendations-text-color);
      text-decoration: line-through;
      opacity: 0.55;
    }

    #{{ block_id }} .content-product-recommendations__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-product-recommendations-button-text);
      background: var(--content-product-recommendations-button-background);
      border: 1px solid var(--content-product-recommendations-button-background);
      border-radius: max(calc(var(--content-product-recommendations-card-radius) - 10px), 6px);
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.content-product-recommendations--cards .content-product-recommendations__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }} .content-product-recommendations__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-product-recommendations__media:focus-visible,
    #{{ block_id }} .content-product-recommendations__title a:focus-visible,
    #{{ block_id }} .content-product-recommendations__button:focus-visible {
      outline: 2px solid var(--content-product-recommendations-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-product-recommendations__empty {
      padding: 18px;
      color: var(--content-product-recommendations-text-color);
      background: var(--content-product-recommendations-card-background);
      border: var(--content-product-recommendations-border-width) solid var(--content-product-recommendations-border-color);
      border-radius: var(--content-product-recommendations-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-product-recommendations--is-loading .content-product-recommendations__items {
      opacity: 0.45;
      pointer-events: none;
    }

    #{{ block_id }}.content-product-recommendations--animate {
      opacity: 1;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-product-recommendations--animate-fade {
      animation-name: contentProductRecommendationsFade;
    }

    #{{ block_id }}.content-product-recommendations--animate-fade_up {
      animation-name: contentProductRecommendationsFadeUp;
    }

    #{{ block_id }}.content-product-recommendations--animate-zoom {
      animation-name: contentProductRecommendationsZoom;
    }

    @keyframes contentProductRecommendationsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentProductRecommendationsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentProductRecommendationsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-product-recommendations--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-product-recommendations--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-product-recommendations__items {
        grid-template-columns: repeat(var(--content-product-recommendations-columns-tablet), minmax(0, 1fr));
      }

      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item {
        flex-basis: calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-tablet) - 1))) / var(--content-product-recommendations-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-product-recommendations--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-product-recommendations__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .content-product-recommendations__items {
        grid-template-columns: repeat(var(--content-product-recommendations-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item {
        flex-basis: calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-mobile) - 1))) / var(--content-product-recommendations-columns-mobile));
      }

      #{{ block_id }} .content-product-recommendations__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .content-product-recommendations__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-product-recommendations--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__items {
        scroll-behavior: auto;
      }

      #{{ block_id }} .content-product-recommendations__media img,
      #{{ block_id }} .content-product-recommendations__button,
      #{{ block_id }} .content-product-recommendations__arrow {
        transition: none;
      }

      #{{ block_id }} .content-product-recommendations__card:hover .content-product-recommendations__media img,
      #{{ block_id }} .content-product-recommendations__button:hover,
      #{{ block_id }} .content-product-recommendations__arrow:hover {
        transform: none;
      }
    }

    #{{ block_id }} { min-width: 0; max-width: 100%; overflow-wrap: anywhere; container-type: inline-size; }
    #{{ block_id }}, #{{ block_id }} * { box-sizing: border-box; }
    #{{ block_id }}[hidden], #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} a, #{{ block_id }} button, #{{ block_id }} img { max-width: 100%; }
    #{{ block_id }} .content-product-recommendations__item, #{{ block_id }} .content-product-recommendations__header { min-width: 0; }
    #{{ block_id }} .content-product-recommendations__card { height: 100%; }
    #{{ block_id }} .content-product-recommendations__button { min-width: 0; white-space: normal; overflow-wrap: anywhere; }
    #{{ block_id }} .content-product-recommendations__title a { color: inherit; text-decoration: none; }
    #{{ block_id }} .content-product-recommendations__badge { max-width: calc(100% - 20px); }
    #{{ block_id }} .content-product-recommendations__badge--inline { position: static; width: fit-content; max-width: 100%; }
    #{{ block_id }} :focus-visible { outline: 2px solid var(--content-product-recommendations-focus-color); outline-offset: -3px; }

    @container (max-width: 600px) {
      #{{ block_id }} .content-product-recommendations__items { grid-template-columns: repeat(var(--content-product-recommendations-columns-mobile), minmax(0, 1fr)); }
      #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item { flex-basis: calc((100% - (var(--content-product-recommendations-gap) * (var(--content-product-recommendations-columns-mobile) - 1))) / var(--content-product-recommendations-columns-mobile)); }
      #{{ block_id }} .content-product-recommendations__heading { font-size: {{ block.settings.heading_size_mobile }}px; }
    }
    #{{ block_id }}:dir(rtl) .content-product-recommendations__arrow span { transform: scaleX(-1); }
    #{{ block_id }} .content-product-recommendations__controls { flex-wrap: wrap; }
    #{{ block_id }}.content-product-recommendations--carousel .content-product-recommendations__item { min-width: min(100%, 160px); }
  </style>
<div class="content-product-recommendations__inner">
    {% if block.settings.show_header %}
      {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.description != blank %}
      <div class="content-product-recommendations__header-row"><div class="content-product-recommendations__header">
        {% if block.settings.eyebrow != blank %}<p class="content-product-recommendations__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2 class="content-product-recommendations__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<p class="content-product-recommendations__description">{{ block.settings.description | escape }}</p>{% endif %}
      </div></div>{% endif %}
    {% endif %}

    {% if recommendation_layout == 'carousel' and block.settings.show_arrows %}<div class="content-product-recommendations__controls" data-card-controls hidden>
      <button type="button" class="content-product-recommendations__arrow" data-card-prev aria-controls="{{ block_id }}-items" aria-label="{{ block.settings.previous_label | default: 'Previous products' | escape }}"><span aria-hidden="true">‹</span></button>
      <button type="button" class="content-product-recommendations__arrow" data-card-next aria-controls="{{ block_id }}-items" aria-label="{{ block.settings.next_label | default: 'Next products' | escape }}"><span aria-hidden="true">›</span></button>
    </div>{% endif %}
    <div id="{{ block_id }}-items" class="content-product-recommendations__items" data-card-items role="region" aria-label="{{ block.settings.recommendations_label | default: 'Related products' | escape }}" {% if recommendation_layout == 'carousel' %}tabindex="0"{% endif %}>{{ product_cards }}</div>

    {% if rendered_products == 0 and request.design_mode and block.settings.show_empty_state %}<div class="content-product-recommendations__empty" role="note" data-card-empty>{{ block.settings.empty_text | default: 'Select products or a collection for this block.' | escape }}</div>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Content recommendations",
  "settings": [
