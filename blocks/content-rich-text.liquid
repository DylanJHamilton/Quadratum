{%- liquid
  assign rich_text = block.settings.rich_text
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'rich-text' %}

<div
  class="qtm-rich-text qtm-rich-text--{{ block.settings.text_style }}"
  style="
    --qtm-rich-text-color: {{ block.settings.text_color }};
    --qtm-rich-text-link-color: {{ block.settings.link_color }};
    --qtm-rich-text-link-hover-color: {{ block.settings.link_hover_color }};
    --qtm-rich-text-max-width: {{ block.settings.max_width }}px;
    --qtm-rich-text-font-family: {% if block.settings.font_family == 'heading' %}var(--font-heading-family){% elsif block.settings.font_family == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
    --qtm-rich-text-font-weight: {{ block.settings.font_weight }};
    --qtm-rich-text-letter-spacing: {{ block.settings.letter_spacing }}px;
    --qtm-rich-text-custom-font-size: {{ block.settings.custom_font_size }}px;
    --qtm-rich-text-custom-line-height: {{ block.settings.custom_line_height | divided_by: 100.0 }};
    --qtm-rich-text-paragraph-spacing: {{ block.settings.paragraph_spacing }}em;
    --qtm-rich-text-list-spacing: {{ block.settings.list_spacing }}em;
  "
>
  {% if rich_text != blank %}
    {{ rich_text }}
  {% else %}
    <p>Add your rich text content here.</p>
  {% endif %}
</div>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "rich_text",
      "label": "Text",
      "default": "<p>Add paragraph text, descriptions, article content, product storytelling, or landing page copy.</p>"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Typography style",
      "default": "body",
      "options": [
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 280,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "default": "body",
      "options": [
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "inherit",
          "label": "Inherit"
        }
      ]
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 6,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "custom_font_size",
      "label": "Custom font size",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "custom_line_height",
      "label": "Custom line height",
      "min": 100,
      "max": 220,
      "step": 5,
      "unit": "%",
      "default": 165
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "em",
      "default": 1
    },
    {
      "type": "range",
      "id": "list_spacing",
      "label": "List spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "em",
      "default": 1
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade-up",
          "label": "Fade up"
        },
        {
          "value": "fade-down",
          "label": "Fade down"
        },
        {
          "value": "fade-left",
          "label": "Fade left"
        },
        {
          "value": "fade-right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}