{%- liquid
  assign block_id = 'product-shipping-returns-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'cards'
  assign item_count = block.settings.item_count | default: 3

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-shipping-returns
    product-shipping-returns--{{ layout_style }}
    product-shipping-returns--width-{{ block_width }}
    product-shipping-returns--align-{{ alignment }}
    {% unless show_on_desktop %} product-shipping-returns--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-shipping-returns--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-shipping-returns--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-shipping-returns--animate product-shipping-returns--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-shipping-returns-margin-top: {{ block.settings.margin_top }}px;
    --product-shipping-returns-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-shipping-returns-padding: {{ block.settings.padding }}px;
    --product-shipping-returns-gap: {{ block.settings.gap }}px;
    --product-shipping-returns-card-padding: {{ block.settings.card_padding }}px;
    --product-shipping-returns-border-width: {{ block.settings.border_width }}px;
    --product-shipping-returns-border-radius: {{ block.settings.border_radius }}px;
    --product-shipping-returns-heading-color: {{ block.settings.heading_color }};
    --product-shipping-returns-text-color: {{ block.settings.text_color }};
    --product-shipping-returns-background-color: {{ block.settings.background_color }};
    --product-shipping-returns-card-background-color: {{ block.settings.card_background_color }};
    --product-shipping-returns-border-color: {{ block.settings.border_color }};
    --product-shipping-returns-link-color: {{ block.settings.link_color }};
    --product-shipping-returns-icon-color: {{ block.settings.icon_color }};
    --product-shipping-returns-icon-background: {{ block.settings.icon_background_color }};
    --product-shipping-returns-icon-size: {{ block.settings.icon_size }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-shipping-returns-margin-top);
      margin-bottom: var(--product-shipping-returns-margin-bottom);
      padding: var(--product-shipping-returns-padding);
      color: var(--product-shipping-returns-text-color);
      background: var(--product-shipping-returns-background-color);
    }

    #{{ block_id }}.product-shipping-returns--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-shipping-returns--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-shipping-returns--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-shipping-returns--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-shipping-returns--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-shipping-returns--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-shipping-returns--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-shipping-returns--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-shipping-returns__inner {
      display: grid;
      gap: var(--product-shipping-returns-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .product-shipping-returns__header {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-shipping-returns__heading {
      margin: 0;
      color: var(--product-shipping-returns-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-shipping-returns__intro {
      color: var(--product-shipping-returns-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-shipping-returns__intro p {
      margin-top: 0;
    }

    #{{ block_id }} .product-shipping-returns__intro p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-shipping-returns__items {
      display: grid;
      gap: var(--product-shipping-returns-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }}.product-shipping-returns--cards .product-shipping-returns__items {
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
    }

    #{{ block_id }}.product-shipping-returns--minimal .product-shipping-returns__items,
    #{{ block_id }}.product-shipping-returns--accordion .product-shipping-returns__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .product-shipping-returns__item {
      min-width: 0;
      color: var(--product-shipping-returns-text-color);
      background: var(--product-shipping-returns-card-background-color);
      border: var(--product-shipping-returns-border-width) solid var(--product-shipping-returns-border-color);
      border-radius: var(--product-shipping-returns-border-radius);
    }

    #{{ block_id }}.product-shipping-returns--cards .product-shipping-returns__item {
      display: grid;
      gap: 14px;
      align-content: start;
      padding: var(--product-shipping-returns-card-padding);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.product-shipping-returns--minimal .product-shipping-returns__item {
      display: grid;
      gap: 12px;
      padding: 0 0 var(--product-shipping-returns-card-padding);
      background: transparent;
      border-left: 0;
      border-right: 0;
      border-top: 0;
      border-radius: 0;
    }

    #{{ block_id }}.product-shipping-returns--minimal .product-shipping-returns__item:last-child {
      border-bottom: 0;
    }

    #{{ block_id }}.product-shipping-returns--accordion .product-shipping-returns__item {
      overflow: hidden;
    }

    #{{ block_id }} .product-shipping-returns__summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      width: 100%;
      min-width: 0;
      cursor: pointer;
      padding: var(--product-shipping-returns-card-padding);
      color: var(--product-shipping-returns-heading-color);
    }

    #{{ block_id }} .product-shipping-returns__summary::-webkit-details-marker {
      display: none;
    }

    #{{ block_id }} .product-shipping-returns__summary:focus-visible {
      outline: 2px solid var(--product-shipping-returns-link-color);
      outline-offset: -4px;
    }

    #{{ block_id }} .product-shipping-returns__summary-content {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    #{{ block_id }} .product-shipping-returns__chevron {
      flex: 0 0 auto;
      transition: transform 180ms ease;
    }

    #{{ block_id }} details[open] .product-shipping-returns__chevron {
      transform: rotate(180deg);
    }

    #{{ block_id }} .product-shipping-returns__accordion-body {
      display: grid;
      gap: 12px;
      padding: 0 var(--product-shipping-returns-card-padding) var(--product-shipping-returns-card-padding);
    }

    #{{ block_id }} .product-shipping-returns__visual {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--product-shipping-returns-icon-size);
      height: var(--product-shipping-returns-icon-size);
      flex: 0 0 var(--product-shipping-returns-icon-size);
      color: var(--product-shipping-returns-icon-color);
      background: var(--product-shipping-returns-icon-background);
      border-radius: 999px;
      line-height: 1;
    }

    #{{ block_id }} .product-shipping-returns__icon {
      font-size: calc(var(--product-shipping-returns-icon-size) * 0.45);
      line-height: 1;
    }

    #{{ block_id }} .product-shipping-returns__item-heading {
      margin: 0;
      color: var(--product-shipping-returns-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .product-shipping-returns__text {
      color: var(--product-shipping-returns-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-shipping-returns__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-shipping-returns__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-shipping-returns__link {
      display: inline-flex;
      width: fit-content;
      color: var(--product-shipping-returns-link-color);
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
      line-height: 1.2;
      transition: opacity 180ms ease;
    }

    #{{ block_id }} .product-shipping-returns__link:hover {
      opacity: 0.72;
    }

    #{{ block_id }} .product-shipping-returns__link:focus-visible {
      outline: 2px solid var(--product-shipping-returns-link-color);
      outline-offset: 3px;
      border-radius: 4px;
    }

    #{{ block_id }}.product-shipping-returns--align-center .product-shipping-returns__item,
    #{{ block_id }}.product-shipping-returns--align-center .product-shipping-returns__summary-content {
      justify-items: center;
      justify-content: center;
    }

    #{{ block_id }}.product-shipping-returns--align-center .product-shipping-returns__link {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-shipping-returns--align-right .product-shipping-returns__item,
    #{{ block_id }}.product-shipping-returns--align-right .product-shipping-returns__summary-content {
      justify-items: end;
      justify-content: flex-end;
    }

    #{{ block_id }}.product-shipping-returns--align-right .product-shipping-returns__link {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.product-shipping-returns--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-shipping-returns--animate-fade {
      animation-name: productShippingReturnsFade;
    }

    #{{ block_id }}.product-shipping-returns--animate-fade_up {
      animation-name: productShippingReturnsFadeUp;
    }

    #{{ block_id }}.product-shipping-returns--animate-fade_down {
      animation-name: productShippingReturnsFadeDown;
    }

    #{{ block_id }}.product-shipping-returns--animate-fade_left {
      animation-name: productShippingReturnsFadeLeft;
    }

    #{{ block_id }}.product-shipping-returns--animate-fade_right {
      animation-name: productShippingReturnsFadeRight;
    }

    #{{ block_id }}.product-shipping-returns--animate-zoom {
      animation-name: productShippingReturnsZoom;
    }

    @keyframes productShippingReturnsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productShippingReturnsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productShippingReturnsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productShippingReturnsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productShippingReturnsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productShippingReturnsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-shipping-returns--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-shipping-returns--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-shipping-returns--cards .product-shipping-returns__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-shipping-returns--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-shipping-returns--cards .product-shipping-returns__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-shipping-returns--cards .product-shipping-returns__item,
      #{{ block_id }} .product-shipping-returns__summary,
      #{{ block_id }} .product-shipping-returns__accordion-body {
        padding: min(var(--product-shipping-returns-card-padding), 22px);
      }

      #{{ block_id }} .product-shipping-returns__accordion-body {
        padding-top: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-shipping-returns--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-shipping-returns__chevron,
      #{{ block_id }} .product-shipping-returns__link {
        transition: none;
      }
    }
  </style>

  <div class="product-shipping-returns__inner">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="product-shipping-returns__header">
        {% if block.settings.heading != blank %}
          <h3 class="product-shipping-returns__heading">
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="product-shipping-returns__intro">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-shipping-returns__items">
      {%- for index in (1..6) -%}
        {%- if index <= item_count -%}
          {%- liquid
            assign icon_key = 'item_' | append: index | append: '_icon'
            assign heading_key = 'item_' | append: index | append: '_heading'
            assign text_key = 'item_' | append: index | append: '_text'
            assign link_label_key = 'item_' | append: index | append: '_link_label'
            assign link_url_key = 'item_' | append: index | append: '_link_url'
            assign open_key = 'item_' | append: index | append: '_open_by_default'

            assign item_icon = block.settings[icon_key]
            assign item_heading = block.settings[heading_key]
            assign item_text = block.settings[text_key]
            assign item_link_label = block.settings[link_label_key]
            assign item_link_url = block.settings[link_url_key]
            assign item_open = block.settings[open_key]
          -%}

          {% if item_heading != blank or item_text != blank %}
            {% if layout_style == 'accordion' %}
              <details class="product-shipping-returns__item" {% if item_open %}open{% endif %}>
                <summary class="product-shipping-returns__summary">
                  <span class="product-shipping-returns__summary-content">
                    {% if item_icon != blank %}
                      <span class="product-shipping-returns__visual" aria-hidden="true">
                        <span class="product-shipping-returns__icon">{{ item_icon }}</span>
                      </span>
                    {% endif %}

                    {% if item_heading != blank %}
                      <span class="product-shipping-returns__item-heading">
                        {{ item_heading | escape }}
                      </span>
                    {% endif %}
                  </span>

                  <span class="product-shipping-returns__chevron" aria-hidden="true">⌄</span>
                </summary>

                <div class="product-shipping-returns__accordion-body">
                  {% if item_text != blank %}
                    <div class="product-shipping-returns__text">
                      {{ item_text }}
                    </div>
                  {% endif %}

                  {% if item_link_label != blank and item_link_url != blank %}
                    <a class="product-shipping-returns__link" href="{{ item_link_url }}">
                      {{ item_link_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </details>
            {% else %}
              <article class="product-shipping-returns__item">
                {% if item_icon != blank %}
                  <span class="product-shipping-returns__visual" aria-hidden="true">
                    <span class="product-shipping-returns__icon">{{ item_icon }}</span>
                  </span>
                {% endif %}

                {% if item_heading != blank %}
                  <h4 class="product-shipping-returns__item-heading">
                    {{ item_heading | escape }}
                  </h4>
                {% endif %}

                {% if item_text != blank %}
                  <div class="product-shipping-returns__text">
                    {{ item_text }}
                  </div>
                {% endif %}

                {% if item_link_label != blank and item_link_url != blank %}
                  <a class="product-shipping-returns__link" href="{{ item_link_url }}">
                    {{ item_link_label | escape }}
                  </a>
                {% endif %}
              </article>
            {% endif %}
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product shipping returns",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping and returns"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Give shoppers clear delivery, return, and support information before they add to cart.</p>"
    },
    {
      "type": "range",
      "id": "item_count",
      "label": "Number of items",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "accordion",
          "label": "Accordion"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns for cards",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 52
    },

    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "text",
      "id": "item_1_icon",
      "label": "Icon",
      "default": "↗"
    },
    {
      "type": "text",
      "id": "item_1_heading",
      "label": "Heading",
      "default": "Shipping information"
    },
    {
      "type": "richtext",
      "id": "item_1_text",
      "label": "Text",
      "default": "<p>Orders are processed with clear delivery expectations so customers know what to expect before checkout.</p>"
    },
    {
      "type": "text",
      "id": "item_1_link_label",
      "label": "Link label",
      "default": "View shipping policy"
    },
    {
      "type": "url",
      "id": "item_1_link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "item_1_open_by_default",
      "label": "Open by default",
      "default": true
    },

    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "text",
      "id": "item_2_icon",
      "label": "Icon",
      "default": "↺"
    },
    {
      "type": "text",
      "id": "item_2_heading",
      "label": "Heading",
      "default": "Returns policy"
    },
    {
      "type": "richtext",
      "id": "item_2_text",
      "label": "Text",
      "default": "<p>Use this area to explain returns, exchanges, eligibility, and what customers should do if they need support.</p>"
    },
    {
      "type": "text",
      "id": "item_2_link_label",
      "label": "Link label",
      "default": "View returns policy"
    },
    {
      "type": "url",
      "id": "item_2_link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "item_2_open_by_default",
      "label": "Open by default",
      "default": false
    },

    {
      "type": "header",
      "content": "Item 3"
    },
    {
      "type": "text",
      "id": "item_3_icon",
      "label": "Icon",
      "default": "✓"
    },
    {
      "type": "text",
      "id": "item_3_heading",
      "label": "Heading",
      "default": "Delivery promise"
    },
    {
      "type": "richtext",
      "id": "item_3_text",
      "label": "Text",
      "default": "<p>Reassure shoppers with delivery transparency, order support, and a simple promise around fulfillment.</p>"
    },
    {
      "type": "text",
      "id": "item_3_link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "item_3_link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "item_3_open_by_default",
      "label": "Open by default",
      "default": false
    },

    {
      "type": "header",
      "content": "Item 4"
    },
    {
      "type": "text",
      "id": "item_4_icon",
      "label": "Icon"
