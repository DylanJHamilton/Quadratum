[
  {
    "file": "blocks/product-gallery.liquid",
    "individual_findings": "Individually reviewed all settings and three complete presets. Preserves Slider/Gallery/Masonry/Horizontal thumbnails and native image/video/external/model media while replacing hidden-before-JS slides with native horizontal scrolling and visible static pane fallback. Shared media rendering removes four copied Liquid branches. Selected actual variant/media is authoritative even outside enumerated variant/media lists; compact escaped ID/media data replaces full raw product variants JSON. Thumbnails left/right/bottom and visibility now apply to both relevant layouts, Buttons/Dots retain real controls with named targets/larger dot hit areas, masonry video/model frames remain bounded, native wrapper owns editor attrs, design visibility/motion bypass and honest empty guidance repaired. Autoplay includes configurable pause/resume labels.",
    "settings": [
      {
        "schema": {
          "type": "select",
          "id": "gallery_mode",
          "label": "Gallery mode",
          "default": "slider",
          "options": [
            {
              "value": "slider",
              "label": "Slider"
            },
            {
              "value": "gallery",
              "label": "Gallery"
            },
            {
              "value": "masonry",
              "label": "Masonry"
            },
            {
              "value": "horizontal_thumbs",
              "label": "Horizontal thumbnails"
            }
          ]
        },
        "source_consumers": [
          "assign gallery_mode = block.settings.gallery_mode | default: 'slider'"
        ]
      },
      {
        "schema": {
          "type": "select",
          "id": "image_fit",
          "label": "Media fit",
          "default": "cover",
          "options": [
            {
              "value": "cover",
              "label": "Cover"
            },
            {
              "value": "contain",
              "label": "Contain"
            }
          ]
        },
        "source_consumers": [
          "object-fit: {{ block.settings.image_fit }};"
        ]
      },
      {
        "schema": {
          "type": "range",
          "id": "main_media_ratio",
          "label": "Main media ratio",
          "min": 60,
          "max": 180,
          "step": 5,
          "unit": "%",
          "default": 125,
          "info": "Width divided by height as a percentage; 125 produces a 1.25:1 frame."
        },
        "source_consumers": [
          "--product-gallery-main-ratio: {{ block.settings.main_media_ratio | divided_by: 100.0 }};"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "mute_videos",
          "label": "Mute videos by default",
          "default": true
        },
        "source_consumers": [
          "<div class=\"product-gallery__media-frame\">{% render 'qtm-block-product-media', media: media, product: product_context, image_loading: image_loading, muted: block.settings.mute_videos %}</div>"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows",
          "default": true
        },
        "source_consumers": [
          "{% if block.settings.show_arrows and media_count > 1 %}"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_dots",
          "label": "Show dots",
          "default": true
        },
        "source_consumers": [
          "{% if block.settings.show_dots and media_count > 1 %}<div hidden data-gallery-nav class=\"product-gallery__dots\" role=\"group\" aria-label=\"{{ block.settings.dots_label | default: 'Product media slides' | escape }}\">{% for i in (0..last_media_index) %}<button type=\"button\" class=\"product-gallery__dot\" data-product-gallery-dot data-index=\"{{ i }}\" aria-controls=\"{{ block_id }}-viewport\" aria-label=\"{{ block.settings.go_to_slide_label | default: 'View media' | escape }} {{ i | plus: 1 }}\"></button>{% endfor %}</div>{% endif %}"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "show_thumbnails",
          "label": "Show thumbnails",
          "default": true
        },
        "source_consumers": [
          "{% if block.settings.show_thumbnails and media_count > 1 %}"
        ]
      },
      {
        "schema": {
          "type": "checkbox",
          "id": "enable_autoplay",
          "label": "Enable autoplay",
          "default": false,
          "info": "Slider only. Includes a pause control; paused in the editor, hidden pages and reduced-motion mode."
        },
        "source_consumers": [
          "data-autoplay=\"{{ block.settings.enable_autoplay }}\"",
          "{% if block.settings.enable_autoplay and media_count > 1 %}<button hidden type=\"button\" class=\"product-gallery__pause\" data-gallery-pause>{{ block.settings.pause_label | default: 'Pause slideshow' | escape }}</button>{% endif %}"
