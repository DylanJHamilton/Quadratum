{%- liquid
  assign block_id = 'content-featured-collection-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign featured_collection = block.settings.collection
  assign featured_layout = block.settings.featured_layout | default: 'standard'
  assign media_position = block.settings.media_position | default: 'left'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  if featured_collection != blank
    assign collection_image = featured_collection.image | default: featured_collection.featured_image
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    content-featured-collection
    content-featured-collection--{{ featured_layout }}
    content-featured-collection--media-{{ media_position }}
    content-featured-collection--width-{{ width }}
    content-featured-collection--align-{{ alignment }}
    {% unless show_on_desktop %} content-featured-collection--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-featured-collection--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-featured-collection--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-featured-collection--animate content-featured-collection--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-featured-collection-margin-top: {{ block.settings.margin_top }}px;
    --content-featured-collection-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-featured-collection-padding: {{ block.settings.padding }}px;
    --content-featured-collection-gap: {{ block.settings.layout_gap }}px;
    --content-featured-collection-content-gap: {{ block.settings.content_gap }}px;
    --content-featured-collection-card-padding: {{ block.settings.card_padding }}px;
    --content-featured-collection-radius: {{ block.settings.card_radius }}px;
    --content-featured-collection-media-radius: {{ block.settings.media_radius }}px;
    --content-featured-collection-border-width: {{ block.settings.border_width }}px;
    --content-featured-collection-media-ratio: {{ block.settings.media_ratio | divided_by: 100.0 }};
    --content-featured-collection-heading-color: {{ block.settings.heading_color }};
    --content-featured-collection-text-color: {{ block.settings.text_color }};
    --content-featured-collection-background: {{ block.settings.background_color }};
    --content-featured-collection-card-background: {{ block.settings.card_background_color }};
    --content-featured-collection-border-color: {{ block.settings.border_color }};
    --content-featured-collection-button-background: {{ block.settings.button_background_color }};
    --content-featured-collection-button-text: {{ block.settings.button_text_color }};
    --content-featured-collection-secondary-button-background: {{ block.settings.secondary_button_background_color }};
    --content-featured-collection-secondary-button-text: {{ block.settings.secondary_button_text_color }};
    --content-featured-collection-overlay-color: {{ block.settings.overlay_color }};
    --content-featured-collection-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --content-featured-collection-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-featured-collection
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-featured-collection-margin-top);
      margin-bottom: var(--content-featured-collection-margin-bottom);
      padding: var(--content-featured-collection-padding);
      color: var(--content-featured-collection-text-color);
      background: var(--content-featured-collection-background);
    }

    #{{ block_id }}.content-featured-collection--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-featured-collection--width-small {
      max-width: 920px;
    }

    #{{ block_id }}.content-featured-collection--width-medium {
      max-width: 1120px;
    }

    #{{ block_id }}.content-featured-collection--width-large {
      max-width: 1360px;
    }

    #{{ block_id }}.content-featured-collection--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-featured-collection--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-featured-collection--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-featured-collection--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-featured-collection__shell {
      display: grid;
      min-width: 0;
      overflow: hidden;
      color: var(--content-featured-collection-text-color);
      background: var(--content-featured-collection-card-background);
      border: var(--content-featured-collection-border-width) solid var(--content-featured-collection-border-color);
      border-radius: var(--content-featured-collection-radius);
    }

    #{{ block_id }}.content-featured-collection--standard .content-featured-collection__shell,
    #{{ block_id }}.content-featured-collection--seasonal .content-featured-collection__shell {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--content-featured-collection-gap);
      align-items: center;
      padding: var(--content-featured-collection-card-padding);
    }

    #{{ block_id }}.content-featured-collection--promotional .content-featured-collection__shell {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: var(--content-featured-collection-gap);
      align-items: center;
      padding: var(--content-featured-collection-card-padding);
    }

    #{{ block_id }}.content-featured-collection--media-right .content-featured-collection__media-column {
      order: 2;
    }

    #{{ block_id }}.content-featured-collection--media-right .content-featured-collection__content {
      order: 1;
    }

    #{{ block_id }} .content-featured-collection__media-column {
      display: grid;
      min-width: 0;
    }

    #{{ block_id }} .content-featured-collection__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      isolation: isolate;
      background: #f6f6f6;
      border-radius: var(--content-featured-collection-media-radius);
      aspect-ratio: var(--content-featured-collection-media-ratio);
      text-decoration: none;
    }

    #{{ block_id }} .content-featured-collection__media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--content-featured-collection-overlay-color);
      opacity: var(--content-featured-collection-overlay-opacity);
      pointer-events: none;
    }

    #{{ block_id }} .content-featured-collection__media img,
    #{{ block_id }} .content-featured-collection__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 360ms ease;
    }

    #{{ block_id }} .content-featured-collection__media:hover img {
      transform: scale(1.035);
    }

    #{{ block_id }} .content-featured-collection__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .content-featured-collection__media-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 7px 12px;
      color: #ffffff;
      background: rgba(0, 0, 0, 0.72);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
      backdrop-filter: blur(12px);
    }

    #{{ block_id }} .content-featured-collection__content {
      display: grid;
      gap: var(--content-featured-collection-content-gap);
      min-width: 0;
      max-width: 720px;
    }

    #{{ block_id }}.content-featured-collection--align-center .content-featured-collection__content {
      justify-items: center;
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-featured-collection--align-right .content-featured-collection__content {
      justify-items: end;
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-featured-collection__eyebrow {
      margin: 0;
      color: var(--content-featured-collection-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-featured-collection__title {
      margin: 0;
      color: var(--content-featured-collection-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.05;
    }

    #{{ block_id }} .content-featured-collection__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .content-featured-collection__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.14em;
    }

    #{{ block_id }} .content-featured-collection__description {
      margin: 0;
      color: var(--content-featured-collection-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.6;
      opacity: 0.88;
    }

    #{{ block_id }} .content-featured-collection__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      color: var(--content-featured-collection-text-color);
      font-size: 0.94em;
      line-height: 1.35;
      opacity: 0.76;
    }

    #{{ block_id }}.content-featured-collection--align-center .content-featured-collection__meta {
      justify-content: center;
    }

    #{{ block_id }}.content-featured-collection--align-right .content-featured-collection__meta {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-featured-collection__products {
      display: grid;
      gap: 10px;
      width: 100%;
      max-width: {{ block.settings.product_preview_width }}px;
    }

    #{{ block_id }} .content-featured-collection__product {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr);
      gap: 10px;
      align-items: center;
      color: var(--content-featured-collection-text-color);
      text-decoration: none;
    }

    #{{ block_id }} .content-featured-collection__product-image {
      width: 54px;
      height: 54px;
      overflow: hidden;
      background: #f6f6f6;
      border: 1px solid var(--content-featured-collection-border-color);
      border-radius: 10px;
    }

    #{{ block_id }} .content-featured-collection__product-image img,
    #{{ block_id }} .content-featured-collection__product-placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #{{ block_id }} .content-featured-collection__product-placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .content-featured-collection__product-title {
      display: block;
      color: var(--content-featured-collection-heading-color);
      line-height: 1.25;
      font-size: 0.94em;
    }

    #{{ block_id }} .content-featured-collection__product-price {
      display: block;
      margin-top: 3px;
      color: var(--content-featured-collection-text-color);
      line-height: 1.2;
      font-size: 0.88em;
      opacity: 0.72;
    }

    #{{ block_id }} .content-featured-collection__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #{{ block_id }}.content-featured-collection--align-center .content-featured-collection__buttons {
      justify-content: center;
    }

    #{{ block_id }}.content-featured-collection--align-right .content-featured-collection__buttons {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-featured-collection__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: {{ block.settings.button_height }}px;
      padding: 12px 18px;
      color: var(--content-featured-collection-button-text);
      background: var(--content-featured-collection-button-background);
      border: 1px solid var(--content-featured-collection-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 700;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-featured-collection__button--secondary {
      color: var(--content-featured-collection-secondary-button-text);
      background: var(--content-featured-collection-secondary-button-background);
      border-color: var(--content-featured-collection-border-color);
    }

    #{{ block_id }} .content-featured-collection__button:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-featured-collection__media:focus-visible,
    #{{ block_id }} .content-featured-collection__title a:focus-visible,
    #{{ block_id }} .content-featured-collection__product:focus-visible,
    #{{ block_id }} .content-featured-collection__button:focus-visible {
      outline: 2px solid var(--content-featured-collection-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-featured-collection__empty {
      padding: 18px;
      color: var(--content-featured-collection-text-color);
      background: var(--content-featured-collection-card-background);
      border: var(--content-featured-collection-border-width) solid var(--content-featured-collection-border-color);
      border-radius: var(--content-featured-collection-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-featured-collection--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-featured-collection--animate-fade {
      animation-name: contentFeaturedCollectionFade;
    }

    #{{ block_id }}.content-featured-collection--animate-fade_up {
      animation-name: contentFeaturedCollectionFadeUp;
    }

    #{{ block_id }}.content-featured-collection--animate-zoom {
      animation-name: contentFeaturedCollectionZoom;
    }

    @keyframes contentFeaturedCollectionFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentFeaturedCollectionFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentFeaturedCollectionZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-featured-collection--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-featured-collection--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-featured-collection--standard .content-featured-collection__shell,
      #{{ block_id }}.content-featured-collection--seasonal .content-featured-collection__shell,
      #{{ block_id }}.content-featured-collection--promotional .content-featured-collection__shell {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-featured-collection--media-right .content-featured-collection__media-column,
      #{{ block_id }}.content-featured-collection--media-right .content-featured-collection__content {
        order: initial;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-featured-collection--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-featured-collection--standard .content-featured-collection__shell,
      #{{ block_id }}.content-featured-collection--seasonal .content-featured-collection__shell,
      #{{ block_id }}.content-featured-collection--promotional .content-featured-collection__shell {
        grid-template-columns: minmax(0, 1fr);
        padding: max(calc(var(--content-featured-collection-card-padding) - 8px), 0px);
      }

      #{{ block_id }}.content-featured-collection--media-right .content-featured-collection__media-column,
      #{{ block_id }}.content-featured-collection--media-right .content-featured-collection__content {
        order: initial;
      }

      #{{ block_id }} .content-featured-collection__title {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .content-featured-collection__buttons {
        display: grid;
      }

      #{{ block_id }} .content-featured-collection__button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-featured-collection--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-featured-collection__media img,
      #{{ block_id }} .content-featured-collection__button {
        transition: none;
      }

      #{{ block_id }} .content-featured-collection__media:hover img,
      #{{ block_id }} .content-featured-collection__button:hover {
        transform: none;
      }
    }
  </style>

  {% if featured_collection != blank %}
    <div class="content-featured-collection__shell">
      <div class="content-featured-collection__media-column">
        <a class="content-featured-collection__media" href="{{ featured_collection.url }}" aria-label="{{ featured_collection.title | escape }}">
          {% if collection_image %}
            {{ collection_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '500, 750, 1000, 1300, 1600, 1800', alt: collection_image.alt | default: featured_collection.title }}
          {% else %}
            <span class="content-featured-collection__placeholder" aria-hidden="true"></span>
          {% endif %}

          {% if block.settings.show_media_badge %}
            <span class="content-featured-collection__media-badge">
              {{ block.settings.media_badge_text | escape }}
            </span>
          {% endif %}
        </a>
      </div>

      <div class="content-featured-collection__content">
        {% if block.settings.eyebrow != blank %}
          <p class="content-featured-collection__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h2 class="content-featured-collection__title">
          <a href="{{ featured_collection.url }}">
            {% if block.settings.custom_heading != blank %}
              {{ block.settings.custom_heading | escape }}
            {% else %}
              {{ featured_collection.title | escape }}
            {% endif %}
          </a>
        </h2>

        {% if block.settings.show_description %}
          <div class="content-featured-collection__description">
            {% if block.settings.description_source == 'custom' %}
              {{ block.settings.custom_description | escape }}
            {% elsif featured_collection.description != blank %}
              {{ featured_collection.description | strip_html | truncatewords: block.settings.description_words }}
            {% else %}
              {{ block.settings.fallback_description | escape }}
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_product_count %}
          <div class="content-featured-collection__meta">
            <span>
              {{ featured_collection.products_count }} {{ block.settings.product_count_label | escape }}
            </span>
          </div>
        {% endif %}

        {% if block.settings.show_product_preview and featured_collection.products_count > 0 %}
          <div class="content-featured-collection__products" aria-label="{{ block.settings.product_preview_label | escape }}">
            {% for preview_product in featured_collection.products limit: block.settings.product_preview_limit %}
              {%- liquid
                assign preview_variant = preview_product.selected_or_first_available_variant
              -%}

              <a class="content-featured-collection__product" href="{{ preview_product.url }}">
                <span class="content-featured-collection__product-image">
                  {% if preview_product.featured_image %}
                    {{ preview_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', alt: preview_product.featured_image.alt | default: preview_product.title }}
                  {% else %}
                    <span class="content-featured-collection__product-placeholder" aria-hidden="true"></span>
                  {% endif %}
                </span>

                <span>
                  <span class="content-featured-collection__product-title">
                    {{ preview_product.title | escape }}
                  </span>

                  {% if block.settings.show_preview_prices %}
                    <span class="content-featured-collection__product-price">
                      {{ preview_variant.price | money }}
                    </span>
                  {% endif %}
                </span>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        <div class="content-featured-collection__buttons">
          {% if block.settings.show_primary_button %}
            <a class="content-featured-collection__button" href="{{ featured_collection.url }}">
              {{ block.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if block.settings.show_secondary_button %}
            <a class="content-featured-collection__button content-featured-collection__button--secondary" href="{{ featured_collection.url }}">
              {{ block.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% elsif block.settings.show_empty_state %}
    <div class="content-featured-collection__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "featured_layout",
      "label": "Featured layout",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "seasonal",
          "label": "Seasonal"
        },
        {
          "value": "promotional",
          "label": "Promotional"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured collection"
    },
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Custom heading"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "select",
      "id": "description_source",
      "label": "Description source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "Collection description"
        },
        {
          "value": "custom",
          "label": "Custom description"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_description",
      "label": "Custom description",
      "default": "Promote a featured collection with strong merchandising copy and a clear shopping path."
    },
    {
      "type": "text",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "Explore this curated collection and discover products selected for this shopping moment."
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Collection description words",
      "min": 8,
      "max": 80,
      "step": 4,
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "text",
      "id": "product_count_label",
      "label": "Product count label",
      "default": "products"
    },

    {
      "type": "header",
      "content": "Media"
    },
    {
