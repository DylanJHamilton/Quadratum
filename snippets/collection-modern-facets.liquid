{%- if filters.size > 0 -%}
  {%- if placement == 'drawer' -%}
    <div class="qcm__drawer" data-qcm-drawer hidden aria-hidden="true">
      <div class="qcm__drawerBackdrop" data-qcm-close-filters></div>
      <div class="qcm__drawerPanel" role="dialog" aria-modal="true" aria-label="Filters" tabindex="-1">
        <button class="qcm__btn" type="button" data-qcm-close-filters>Close filters</button>
        {% render 'collection-modern-facets', section: section, s: s, filters: filters, results_url: results_url, is_search_context: is_search_context, terms_q: terms_q, sort_by: sort_by, placement: 'sidebar' %}
      </div>
    </div>
  {%- else -%}
    <div class="qcm__facets qcmFacet" data-qcm-facets>
      <form method="get" action="{{ results_url | escape }}" data-qcm-facets-form>
        {% render 'collection-query-fields', is_search_context: is_search_context, terms_q: terms_q, keep_sort: true, sort_by: sort_by %}
        {%- for f in filters -%}
          <details class="qcm__facet" {% if f.active_values.size > 0 or f.min_value.value != blank or f.max_value.value != blank %}open{% endif %}>
            <summary>{{ f.label | escape }}</summary>
            <div class="qcm__facetBody">
              {%- if f.type == 'price_range' -%}
                <div class="qcmFacet__price">
                  <label>Min <input type="number" inputmode="decimal" min="0" step="any" max="{{ f.range_max | divided_by: 100.0 }}" name="{{ f.min_value.param_name | escape }}" {% if f.min_value.value != blank %}value="{{ f.min_value.value | divided_by: 100.0 }}"{% endif %}></label>
                  <label>Max <input type="number" inputmode="decimal" min="0" step="any" max="{{ f.range_max | divided_by: 100.0 }}" name="{{ f.max_value.param_name | escape }}" {% if f.max_value.value != blank %}value="{{ f.max_value.value | divided_by: 100.0 }}"{% endif %}></label>
                </div>
              {%- else -%}
                <div class="qcmFacet__list">
                  {%- for v in f.values -%}
                    <label class="qcm__facetLabel qcmFacet__row"><input type="checkbox" name="{{ v.param_name | escape }}" value="{{ v.value | escape }}" {% if v.active %}checked{% endif %} {% if v.count == 0 and v.active == false %}disabled{% endif %}><span>{{ v.label | escape }} ({{ v.count }})</span></label>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </details>
        {%- endfor -%}
        <div class="qcmFacet__actions"><button class="qcm__btn" type="submit">Apply filters</button></div>
      </form>
    </div>
  {%- endif -%}
{%- endif -%}
