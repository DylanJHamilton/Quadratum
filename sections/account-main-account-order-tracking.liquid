{% comment %}
  Quadratum Account System
  Order Tracking

  Handles:
  - Customer-facing tracking lookup UI
  - Order number / email / optional tracking number fields
  - Order-information guidance
  - Explanatory shipment stages (never live status)
  - Support CTA
  - Back to account/orders links
  - Merchant-configured redirect; no carrier/API integration

  Does NOT handle:
  - FedEx API
  - UPS API
  - USPS API
  - Private API keys
  - Carrier API calls
{% endcomment %}

{{ 'account-main-account-order-tracking.css' | asset_url | stylesheet_tag }}
<script src="{{ 'account-main-order-tracking.js' | asset_url }}" defer="defer"></script>

{%- capture account_card_fg -%}{%- render 'contrast-text', bg: section.settings.card_background, preferred: settings.text_base -%}{%- endcapture -%}
{%- liquid
  assign layout_style = section.settings.layout_style

  assign orders_url = section.settings.orders_page_url
  if orders_url == blank
    assign orders_url = routes.account_url
    if template.directory == 'customers'
      assign orders_url = routes.account_url | append: '?view=orders'
    endif
  endif
-%}

<section
  id="QtmAccountMainOrderTracking-{{ section.id }}"
  class="
    qtmAccountTracking
    qtmAccountTracking--{{ layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-card-fg: {{ account_card_fg | strip }};
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-timeline-active: {{ section.settings.timeline_active_color }};
    --qtm-account-timeline-inactive: {{ section.settings.timeline_inactive_color }};
  "
  data-qtm-order-tracking data-provider-url="{{ section.settings.provider_url | escape }}"
>
  <div class="qtmAccountTracking__shell">
    <header class="qtmAccountTracking__header">
      <div>
        <h1 class="qtmAccountTracking__heading">
          {{ section.settings.heading | escape }}
        </h1>

        {% if section.settings.subheading != blank %}
          <p class="qtmAccountTracking__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {% endif %}
      </div>
    </header>

    {% if customer %}
    {% render 'account-main-account-nav', section: section,
      active: 'tracking',
      show_tracking: true,
      tracking_url: request.path,
      orders_url: orders_url,
      layout: 'horizontal'
    %}
    {% else %}
      <p><a href="{{ routes.account_login_url | escape }}">Sign in to view your orders</a></p>
    {% endif %}

    <div class="qtmAccountTracking__layout">
      <div class="qtmAccountTracking__lookupCard">
        <p data-qtm-tracking-unavailable>For tracking details, use your order confirmation or contact the store.</p>
        {% if request.design_mode and section.settings.provider_url == blank %}<p>Configure a provider URL to enable the redirect form. No carrier lookup is implemented by the theme.</p>{% endif %}
        <form
          class="qtmAccountTracking__form"
          data-qtm-tracking-form
          hidden
        >
          <div class="qtmAccountTracking__formHeader">
            <h2 class="qtmAccountTracking__cardTitle">
              Look up your order
            </h2>

            <p class="qtmAccountTracking__formText">
              Continue to the store’s configured tracking service. That service provides tracking results.
            </p>
          </div>

          <div class="qtmAccountTracking__field">
            <label for="QtmTrackingOrderNumber-{{ section.id }}">
              Order number
            </label>
            <input
              id="QtmTrackingOrderNumber-{{ section.id }}"
              type="text"
              name="order_number"
              autocomplete="off"
              placeholder="#1001"
              aria-describedby="TrackingMessage-{{ section.id }}" data-qtm-tracking-order-number
              required
            >
          </div>

          <div class="qtmAccountTracking__field">
            <label for="QtmTrackingEmail-{{ section.id }}">
              Email address
            </label>
            <input
              id="QtmTrackingEmail-{{ section.id }}"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@example.com"
              aria-describedby="TrackingMessage-{{ section.id }}" data-qtm-tracking-email
              required
            >
          </div>

          {% if section.settings.show_tracking_number_field %}
            <div class="qtmAccountTracking__field">
              <label for="QtmTrackingNumber-{{ section.id }}">
                Tracking number
              </label>
              <input
                id="QtmTrackingNumber-{{ section.id }}"
                type="text"
                name="tracking_number"
                autocomplete="off"
                placeholder="Optional"
                data-qtm-tracking-number
              >
            </div>
          {% endif %}

          <div
            class="qtmAccountTracking__message"
            id="TrackingMessage-{{ section.id }}" data-qtm-tracking-message
            role="alert" tabindex="-1"
            hidden
          ></div>

          <button
            type="submit"
            class="qtmAccountTracking__button qtmAccountTracking__button--{{ section.settings.button_style }}"
            data-qtm-tracking-submit
          >
            Continue to tracking
          </button>
        </form>
      </div>

      <div
        class="qtmAccountTracking__results"
        data-qtm-tracking-results
        >
        <section class="qtmAccountTracking__statusCard">
          <h2 class="qtmAccountTracking__cardTitle">Your order information</h2>
          <p>Use your order confirmation link or open your account for available fulfillment details. This page does not retrieve carrier status.</p>
          <div class="qtmAccountTracking__links">
            {% if section.settings.back_to_account_label != blank %}<a href="{{ routes.account_url | escape }}">{{ section.settings.back_to_account_label | escape }}</a>{% endif %}
            {% if section.settings.back_to_orders_label != blank %}<a href="{{ orders_url | escape }}">{{ section.settings.back_to_orders_label | escape }}</a>{% endif %}
          </div>
          {% if section.settings.show_timeline %}
            <p>Typical shipment stages — not the status of an order:</p>
            <ol class="qtmAccountTracking__timeline" aria-label="Typical shipment stages">
              <li class="qtmAccountTracking__step"><span class="qtmAccountTracking__stepMarker" aria-hidden="true"></span>Order received</li>
              <li class="qtmAccountTracking__step"><span class="qtmAccountTracking__stepMarker" aria-hidden="true"></span>Processing</li>
              <li class="qtmAccountTracking__step"><span class="qtmAccountTracking__stepMarker" aria-hidden="true"></span>Shipped</li>
              <li class="qtmAccountTracking__step"><span class="qtmAccountTracking__stepMarker" aria-hidden="true"></span>Delivered</li>
            </ol>
          {% endif %}
        </section>

        {% if section.settings.show_support_cta %}
          <section class="qtmAccountTracking__supportCard" {% if section.settings.support_heading != blank %}aria-labelledby="QtmTrackingSupportHeading-{{ section.id }}"{% else %}aria-label="Order support"{% endif %}>
            {% if section.settings.support_heading != blank %}
              <h2 id="QtmTrackingSupportHeading-{{ section.id }}" class="qtmAccountTracking__cardTitle">
                {{ section.settings.support_heading | escape }}
              </h2>
            {% endif %}

            {% if section.settings.support_text != blank %}
              <div class="qtmAccountTracking__supportText rte">
                {{ section.settings.support_text }}
              </div>
            {% endif %}

            {% if section.settings.support_button_label != blank and section.settings.support_button_url != blank %}
              <a
                href="{{ section.settings.support_button_url | escape }}"
                class="qtmAccountTracking__button qtmAccountTracking__button--{{ section.settings.button_style }}"
              >
                {{ section.settings.support_button_label | escape }}
              </a>
            {% endif %}
          </section>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account Order Tracking",
  "tag": "section",
  "class": "qtm-account-main-order-tracking",
  "settings": [
    {
      "type": "paragraph",
      "content": "Legacy customer-account theme surface. Shopify owns authentication, account data and native form processing; current customer accounts are managed outside the theme. Tracking links require merchant configuration or native fulfillment data."
    },
    {
      "type": "text",
      "id": "provider_url",
      "label": "Tracking provider URL",
      "info": "HTTPS URL or store-relative path. No credentials or placeholders in the host. Optional {order}, {email}, {tracking} placeholders are encoded. Otherwise values are sent as order, email and tracking query parameters. Configure only a provider that accepts this contract. Blank disables the form."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order Tracking"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find available order and shipment information."
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "split",
          "label": "Split"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_tracking_number_field",
      "label": "Show tracking number field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "label": "Show explanatory shipment stages",
      "default": true,
      "info": "Static guidance only; never live order status."
    },
    {
      "type": "header",
      "content": "Support CTA"
    },
    {
      "type": "checkbox",
      "id": "show_support_cta",
      "label": "Show support CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support heading",
      "default": "Need help with your order?"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text",
      "default": "<p>If your tracking information has not updated yet, contact support and our team can help review your order.</p>"
    },
    {
      "type": "text",
      "id": "support_button_label",
      "label": "Support button label",
      "default": "Contact Support"
    },
    {
      "type": "url",
      "id": "support_button_url",
      "label": "Support button URL"
    },
    {
      "type": "header",
      "content": "Account links"
    },
    {
      "type": "text",
      "id": "back_to_account_label",
      "label": "Back to account label",
      "default": "Back to account"
    },
    {
      "type": "text",
      "id": "back_to_orders_label",
      "label": "Back to orders label",
      "default": "Back to orders"
    },
    {
      "type": "url",
      "id": "orders_page_url",
      "label": "Orders page URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Timeline"
    },
    {
      "type": "color",
      "id": "timeline_active_color",
      "label": "Stage marker color",
      "default": "#14532d",
      "info": "Decorative stage markers; does not indicate a live status."
    },
    {
      "type": "color",
      "id": "timeline_inactive_color",
      "label": "Stage connector color",
      "default": "#d1d5db"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Account Main Order Tracking"
    }
  ]
}
{% endschema %}
