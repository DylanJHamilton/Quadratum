{%- liquid
  assign qtm_block_type = block_type | default: block.type
  assign qtm_content_width = block.settings.content_width | default: 'auto'
  assign qtm_alignment = block.settings.alignment | default: 'left'
  assign qtm_desktop_width = block.settings.desktop_width | default: '100'
  assign qtm_mobile_width = block.settings.mobile_width | default: '100'
  assign qtm_animation = block.settings.animation | default: 'none'

  assign qtm_show_desktop = block.settings.show_desktop
  assign qtm_show_tablet = block.settings.show_tablet
  assign qtm_show_mobile = block.settings.show_mobile

  assign qtm_background_color = block.settings.background_color | default: 'rgba(0,0,0,0)'
  assign qtm_background_gradient = block.settings.background_gradient
  assign qtm_border_color = block.settings.border_color | default: 'rgba(0,0,0,0)'
-%}

<div
  id="qtm-content-block-{{ block.id }}"
  class="
    qtm-content-block
    qtm-content-block--{{ qtm_block_type }}
    qtm-content-width--{{ qtm_content_width }}
    qtm-content-align--{{ qtm_alignment }}
    qtm-desktop-width--{{ qtm_desktop_width }}
    qtm-mobile-width--{{ qtm_mobile_width }}
    {% unless qtm_show_desktop %} qtm-hide-desktop{% endunless %}
    {% unless qtm_show_tablet %} qtm-hide-tablet{% endunless %}
    {% unless qtm_show_mobile %} qtm-hide-mobile{% endunless %}
    {% if qtm_animation != 'none' %} qtm-animate qtm-animate--{{ qtm_animation }}{% endif %}
  "
  style="
    --qtm-block-margin-top: {{ block.settings.margin_top | default: 0 }}px;
    --qtm-block-margin-bottom: {{ block.settings.margin_bottom | default: 24 }}px;
    --qtm-block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --qtm-block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --qtm-block-padding-left: {{ block.settings.padding_left | default: 0 }}px;
    --qtm-block-padding-right: {{ block.settings.padding_right | default: 0 }}px;
    --qtm-block-background-color: {{ qtm_background_color }};
    {% if qtm_background_gradient != blank %}
      --qtm-block-background: {{ qtm_background_gradient }};
    {% else %}
      --qtm-block-background: {{ qtm_background_color }};
    {% endif %}
    --qtm-block-border-width: {{ block.settings.border_width | default: 0 }}px;
    --qtm-block-border-color: {{ qtm_border_color }};
    --qtm-block-border-radius: {{ block.settings.border_radius | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-content-block__inner">