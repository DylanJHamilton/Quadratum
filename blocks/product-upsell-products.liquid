{%- liquid
  assign block_id = 'product-upsell-products-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign upsell_product = block.settings.upsell_product
  assign layout_style = block.settings.layout_style | default: 'feature_card'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign upsell_variant = upsell_product.selected_or_first_available_variant
  assign image_alt = ''

  if upsell_product != blank
    assign image_alt = upsell_product.title

    if upsell_product.featured_image.alt != blank
      assign image_alt = upsell_product.featured_image.alt
    endif
  endif

  assign current_price = 0
  assign upsell_price = 0
  assign price_difference = 0

  if current_variant != blank
    assign current_price = current_variant.price
  endif

  if upsell_variant != blank
    assign upsell_price = upsell_variant.price
  endif

  if upsell_price > current_price
    assign price_difference = upsell_price | minus: current_price
  endif

  assign has_upsell = false

  if upsell_product != blank
    if product_context == blank
      assign has_upsell = true
    elsif upsell_product.id != product_context.id
      assign has_upsell = true
    endif
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    product-upsell-products
    product-upsell-products--{{ layout_style }}
    product-upsell-products--width-{{ width }}
    product-upsell-products--align-{{ alignment }}
    {% unless show_on_desktop %} product-upsell-products--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-upsell-products--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-upsell-products--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-upsell-products--animate product-upsell-products--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-upsell-margin-top: {{ block.settings.margin_top }}px;
    --product-upsell-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-upsell-padding: {{ block.settings.padding }}px;
    --product-upsell-card-padding: {{ block.settings.card_padding }}px;
    --product-upsell-gap: {{ block.settings.layout_gap }}px;
    --product-upsell-content-gap: {{ block.settings.content_gap }}px;
    --product-upsell-radius: {{ block.settings.card_radius }}px;
    --product-upsell-image-radius: {{ block.settings.image_radius }}px;
    --product-upsell-border-width: {{ block.settings.border_width }}px;
    --product-upsell-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --product-upsell-compact-image-size: {{ block.settings.compact_image_size }}px;
    --product-upsell-compact-image-size-mobile: {{ block.settings.compact_image_size_mobile }}px;
    --product-upsell-heading-color: {{ block.settings.heading_color }};
    --product-upsell-text-color: {{ block.settings.text_color }};
    --product-upsell-muted-color: {{ block.settings.muted_color }};
    --product-upsell-price-color: {{ block.settings.price_color }};
    --product-upsell-sale-color: {{ block.settings.sale_color }};
    --product-upsell-background: {{ block.settings.background_color }};
    --product-upsell-card-background: {{ block.settings.card_background_color }};
    --product-upsell-border-color: {{ block.settings.border_color }};
    --product-upsell-button-background: {{ block.settings.button_background_color }};
    --product-upsell-button-text: {{ block.settings.button_text_color }};
    --product-upsell-secondary-button-background: {{ block.settings.secondary_button_background_color }};
    --product-upsell-secondary-button-text: {{ block.settings.secondary_button_text_color }};
    --product-upsell-badge-background: {{ block.settings.badge_background_color }};
    --product-upsell-badge-text: {{ block.settings.badge_text_color }};
    --product-upsell-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-upsell-products
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-upsell-margin-top);
      margin-bottom: var(--product-upsell-margin-bottom);
      padding: var(--product-upsell-padding);
      color: var(--product-upsell-text-color);
      background: var(--product-upsell-background);
    }

    #{{ block_id }}.product-upsell-products--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-upsell-products--width-small {
      max-width: 760px;
    }

    #{{ block_id }}.product-upsell-products--width-medium {
      max-width: 980px;
    }

    #{{ block_id }}.product-upsell-products--width-large {
      max-width: 1240px;
    }

    #{{ block_id }}.product-upsell-products--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-upsell-products--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-upsell-products--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-upsell-products--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-upsell-products__card {
      position: relative;
      display: grid;
      gap: var(--product-upsell-gap);
      min-width: 0;
      padding: var(--product-upsell-card-padding);
      color: var(--product-upsell-text-color);
      background: var(--product-upsell-card-background);
      border: var(--product-upsell-border-width) solid var(--product-upsell-border-color);
      border-radius: var(--product-upsell-radius);
      overflow: hidden;
      isolation: isolate;
    }

    #{{ block_id }}.product-upsell-products--feature_card .product-upsell-products__card {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      align-items: center;
      box-shadow: 0 18px 46px rgba(0, 0, 0, 0.07);
    }

    #{{ block_id }}.product-upsell-products--split .product-upsell-products__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      padding: 0;
    }

    #{{ block_id }}.product-upsell-products--compact .product-upsell-products__card {
      grid-template-columns: var(--product-upsell-compact-image-size) minmax(0, 1fr);
      align-items: center;
    }

    #{{ block_id }} .product-upsell-products__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: var(--product-upsell-image-radius);
      aspect-ratio: var(--product-upsell-image-ratio);
      text-decoration: none;
    }

    #{{ block_id }}.product-upsell-products--split .product-upsell-products__media {
      height: 100%;
      min-height: {{ block.settings.split_min_height }}px;
      border-radius: 0;
      aspect-ratio: auto;
    }

    #{{ block_id }}.product-upsell-products--compact .product-upsell-products__media {
      width: var(--product-upsell-compact-image-size);
      height: var(--product-upsell-compact-image-size);
      aspect-ratio: auto;
    }

    #{{ block_id }} .product-upsell-products__media img,
    #{{ block_id }} .product-upsell-products__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .product-upsell-products__media:hover img {
      transform: scale(1.035);
    }

    #{{ block_id }} .product-upsell-products__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .product-upsell-products__content {
      display: grid;
      gap: var(--product-upsell-content-gap);
      min-width: 0;
      align-content: center;
    }

    #{{ block_id }}.product-upsell-products--split .product-upsell-products__content {
      padding: var(--product-upsell-card-padding);
    }

    #{{ block_id }}.product-upsell-products--align-center .product-upsell-products__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }}.product-upsell-products--align-right .product-upsell-products__content {
      justify-items: end;
      text-align: right;
    }

    #{{ block_id }}.product-upsell-products--compact .product-upsell-products__content {
      justify-items: start;
      text-align: left;
    }

    #{{ block_id }} .product-upsell-products__badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      padding: 6px 10px;
      color: var(--product-upsell-badge-text);
      background: var(--product-upsell-badge-background);
      border-radius: 999px;
      font-size: {{ block.settings.badge_size }}px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    #{{ block_id }} .product-upsell-products__eyebrow {
      margin: 0;
      color: var(--product-upsell-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-upsell-products__heading {
      margin: 0;
      color: var(--product-upsell-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.08;
    }

    #{{ block_id }} .product-upsell-products__heading a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-upsell-products__heading a:hover {
      text-decoration: underline;
      text-underline-offset: 0.14em;
    }

    #{{ block_id }} .product-upsell-products__comparison {
      margin: 0;
      color: var(--product-upsell-text-color);
      font-size: {{ block.settings.comparison_size }}px;
      line-height: 1.55;
      opacity: 0.9;
    }

    #{{ block_id }} .product-upsell-products__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px;
      color: var(--product-upsell-text-color);
      line-height: 1.25;
    }

    #{{ block_id }}.product-upsell-products--align-center .product-upsell-products__meta {
      justify-content: center;
    }

    #{{ block_id }}.product-upsell-products--align-right .product-upsell-products__meta {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-upsell-products--compact .product-upsell-products__meta {
      justify-content: flex-start;
    }

    #{{ block_id }} .product-upsell-products__price {
      color: var(--product-upsell-price-color);
      font-size: {{ block.settings.price_size }}px;
      font-weight: 900;
    }

    #{{ block_id }} .product-upsell-products__compare {
      color: var(--product-upsell-muted-color);
      text-decoration: line-through;
      opacity: 0.72;
    }

    #{{ block_id }} .product-upsell-products__difference {
      display: inline-flex;
      width: fit-content;
      padding: 5px 8px;
      color: var(--product-upsell-sale-color);
      background: color-mix(in srgb, var(--product-upsell-sale-color), transparent 90%);
      border-radius: 999px;
      font-size: 0.88em;
      line-height: 1.2;
      font-weight: 800;
    }

    #{{ block_id }} .product-upsell-products__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #{{ block_id }}.product-upsell-products--align-center .product-upsell-products__buttons {
      justify-content: center;
    }

    #{{ block_id }}.product-upsell-products--align-right .product-upsell-products__buttons {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-upsell-products--compact .product-upsell-products__buttons {
      justify-content: flex-start;
    }

    #{{ block_id }} .product-upsell-products__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: {{ block.settings.button_height }}px;
      padding: 12px 18px;
      color: var(--product-upsell-button-text);
      background: var(--product-upsell-button-background);
      border: 1px solid var(--product-upsell-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 800;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-upsell-products__button--secondary {
      color: var(--product-upsell-secondary-button-text);
      background: var(--product-upsell-secondary-button-background);
      border-color: var(--product-upsell-border-color);
    }

    #{{ block_id }} .product-upsell-products__button:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-upsell-products__media:focus-visible,
    #{{ block_id }} .product-upsell-products__heading a:focus-visible,
    #{{ block_id }} .product-upsell-products__button:focus-visible {
      outline: 2px solid var(--product-upsell-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-upsell-products__empty {
      padding: 18px;
      color: var(--product-upsell-text-color);
      background: var(--product-upsell-card-background);
      border: var(--product-upsell-border-width) solid var(--product-upsell-border-color);
      border-radius: var(--product-upsell-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-upsell-products--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-upsell-products--animate-fade {
      animation-name: productUpsellProductsFade;
    }

    #{{ block_id }}.product-upsell-products--animate-fade_up {
      animation-name: productUpsellProductsFadeUp;
    }

    #{{ block_id }}.product-upsell-products--animate-zoom {
      animation-name: productUpsellProductsZoom;
    }

    @keyframes productUpsellProductsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productUpsellProductsFadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productUpsellProductsZoom {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-upsell-products--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-upsell-products--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-upsell-products--feature_card .product-upsell-products__card,
      #{{ block_id }}.product-upsell-products--split .product-upsell-products__card {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-upsell-products--split .product-upsell-products__media {
        min-height: {{ block.settings.split_min_height_tablet }}px;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-upsell-products--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-upsell-products--feature_card .product-upsell-products__card,
      #{{ block_id }}.product-upsell-products--split .product-upsell-products__card {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-upsell-products--compact .product-upsell-products__card {
        grid-template-columns: var(--product-upsell-compact-image-size-mobile) minmax(0, 1fr);
      }

      #{{ block_id }}.product-upsell-products--compact .product-upsell-products__media {
        width: var(--product-upsell-compact-image-size-mobile);
        height: var(--product-upsell-compact-image-size-mobile);
      }

      #{{ block_id }}.product-upsell-products--split .product-upsell-products__media {
        min-height: {{ block.settings.split_min_height_mobile }}px;
      }

      #{{ block_id }} .product-upsell-products__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-upsell-products__buttons {
        display: grid;
        width: 100%;
      }

      #{{ block_id }} .product-upsell-products__button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-upsell-products--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-upsell-products__media img,
      #{{ block_id }} .product-upsell-products__button {
        transition: none;
      }

      #{{ block_id }} .product-upsell-products__media:hover img,
      #{{ block_id }} .product-upsell-products__button:hover {
        transform: none;
      }
    }
  </style>

  {% if has_upsell %}
    <article class="product-upsell-products__card">
      <a class="product-upsell-products__media" href="{{ upsell_product.url }}" aria-label="{{ upsell_product.title | escape }}">
        {% if upsell_product.featured_image %}
          {{ upsell_product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '280, 420, 560, 720, 900, 1200, 1400', alt: image_alt }}
        {% else %}
          <span class="product-upsell-products__placeholder" aria-hidden="true"></span>
        {% endif %}
      </a>

      <div class="product-upsell-products__content">
        {% if block.settings.highlight_badge != blank %}
          <span class="product-upsell-products__badge">
            {{ block.settings.highlight_badge | escape }}
          </span>
        {% endif %}

        {% if block.settings.eyebrow != blank %}
          <p class="product-upsell-products__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h2 class="product-upsell-products__heading">
          <a href="{{ upsell_product.url }}">
            {% if block.settings.heading != blank %}
              {{ block.settings.heading | escape }}
            {% else %}
              {{ upsell_product.title | escape }}
            {% endif %}
          </a>
        </h2>

        {% if block.settings.comparison_text != blank %}
          <p class="product-upsell-products__comparison">
            {{ block.settings.comparison_text | escape }}
          </p>
        {% endif %}

        {% if block.settings.show_price %}
          <div class="product-upsell-products__meta">
            <span class="product-upsell-products__price">
              {{ upsell_variant.price | money }}
            </span>

            {% if upsell_variant.compare_at_price > upsell_variant.price %}
              <span class="product-upsell-products__compare">
                {{ upsell_variant.compare_at_price | money }}
              </span>
            {% endif %}

            {% if block.settings.show_price_difference and price_difference > 0 %}
              <span class="product-upsell-products__difference">
                {{ block.settings.price_difference_prefix | escape }} {{ price_difference | money }}
              </span>
            {% endif %}
          </div>
        {% endif %}

        <div class="product-upsell-products__buttons">
          {% if block.settings.show_primary_button %}
            <a class="product-upsell-products__button" href="{{ upsell_product.url }}">
              {{ block.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if block.settings.show_secondary_button %}
            <a class="product-upsell-products__button product-upsell-products__button--secondary" href="{{ upsell_product.url }}">
              {{ block.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </article>
  {% elsif block.settings.show_empty_state %}
    <div class="product-upsell-products__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product upsell",
  "settings": [
    {
      "type": "header",
      "content": "Upsell product"
    },
    {
      "type": "product",
      "id": "upsell_product",
      "label": "Featured upsell product"
    },

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "highlight_badge",
      "label": "Highlight badge",
      "default": "Upgrade"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium option"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Custom heading",
      "default": "Upgrade your pick"
    },
    {
      "type": "text",
      "id": "comparison_text",
      "label": "Comparison text",
      "default": "Get more features, better performance, or a higher-value option with this recommended upgrade."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_difference",
      "label": "Show price difference",
      "default": true
    },
    {
      "type": "text",
      "id": "price_difference_prefix",
      "label": "Price difference prefix",
      "default": "Only"
    },

    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_primary_button",
      "label": "Show primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "View upgrade"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_button",
      "label": "Show secondary button",
      "default": false
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Compare option"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "feature_card",
      "options": [
        {
          "value": "feature_card",
          "label": "Feature card"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ]
    },

    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image ratio",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 115
    },
    {
      "type": "range",
      "id": "compact_image_size",
      "label": "Compact image size",
      "min": 64,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "compact_image_size_mobile",
      "label": "Compact image size mobile",
      "min": 56,
      "max": 144,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
