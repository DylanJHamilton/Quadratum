{% comment %}
  Quadratum • Sub Page Banner — Breadcrumb
  Modes:
    - "media": compact sub-page banner with optional background + gradient.
    - "plain": static section (no background image), just breadcrumb + title + optional CTAs.

  A11y: nav[aria-label="Breadcrumb"], aria-current on last crumb, JSON-LD.
  Perf: single image, lazy. CTAs optional (max 2). No JS.

  Centering:
    - Breadcrumb aligns via --crumb-justify.
    - Whole block centers via auto margins on .q-inner (both modes).

  All schema defaults are non-empty to avoid upload errors.
{% endcomment %}

{% liquid
  assign s = section.settings
  assign t = settings
  assign page_kind = request.page_type | default: template.name | default: template
  assign context_title = page_title
  case page_kind
    when 'product'
      assign context_title = product.title
    when 'collection'
      assign context_title = collection.title
    when 'article'
      assign context_title = article.title
    when 'blog'
      assign context_title = blog.title
    when 'page'
      assign context_title = page.title
    when 'cart'
      assign context_title = 'cart.general.title' | t
    when 'search'
      assign context_title = 'general.search.title' | t
  endcase

  # Anchor (non-empty)
  assign anchor_raw = s.anchor_id | default: 'auto'
  assign anchor_id = anchor_raw
  if anchor_raw == 'auto'
    assign anchor_id = section.id
  endif

  # Layout
  assign layout_style = s.layout_style | default: 'media'
  assign is_plain = false
  if layout_style == 'plain'
    assign is_plain = true
  endif

  # Sizing
  assign min_h_vh = s.min_height_vh | default: 40
  assign min_h_mobile_vh = s.min_height_vh_mobile | default: 36

  # Plain paddings
  assign pad_y_d = s.plain_pad_y_desktop | default: 48
  assign pad_y_m = s.plain_pad_y_mobile  | default: 32

  # Content width
  assign max_w_token = s.content_max_w | default: 'max-w-3xl'
  assign max_w_px = '768px'
%}
{% case max_w_token %}
  {% when 'max-w-2xl' %}{% assign max_w_px = '672px' %}
  {% when 'max-w-3xl' %}{% assign max_w_px = '768px' %}
  {% when 'max-w-4xl' %}{% assign max_w_px = '896px' %}
  {% when 'max-w-5xl' %}{% assign max_w_px = '1024px' %}
  {% when 'max-w-6xl' %}{% assign max_w_px = '1200px' %}
{% endcase %}

{% liquid
  # Alignment
  assign text_align_value = s.text_alignment | default: 'left'
  assign cta_justify_css = 'flex-start'
  if text_align_value == 'center'
    assign cta_justify_css = 'center'
  elsif text_align_value == 'right'
    assign cta_justify_css = 'flex-end'
  endif

  # Typography
  assign heading_level = s.heading_level | default: 'h2'
  assign heading_fs = '1.875rem'
  if s.heading_size == '2xl'
    assign heading_fs = '1.5rem'
  elsif s.heading_size == '3xl'
    assign heading_fs = '1.875rem'
  elsif s.heading_size == '4xl'
    assign heading_fs = '2.25rem'
  else
    if heading_level == 'h1'
      assign heading_fs = t.type_h1_size | default: 240
    else
      assign heading_fs = t.type_h2_size | default: 200
    endif
    assign heading_fs = heading_fs | divided_by: 100.0 | append: 'rem'
  endif

  assign sub_fs = '1rem'
  if s.subheading_size == 'lg'
    assign sub_fs = '1.125rem'
  elsif s.subheading_size == 'xl'
    assign sub_fs = '1.25rem'
  endif

  assign head_ls = t.headings_letterspacing | default: 0
  assign head_ls_em = head_ls | divided_by: 1000.0 | append: 'em'

  # Colors
  assign col_heading = s.heading_color | default: t.text_base
  assign col_sub     = s.subheading_color | default: t.text_muted
  assign col_crumb   = s.crumb_color | default: t.text_muted
  assign col_crumb_active = s.crumb_active_color | default: t.text_base

  # Media filter (simple mode softens)
  assign media_filter = 'saturate(1.04) contrast(1.02)'
  if s.simple_mode
    assign media_filter = 'none'
  endif
%}

<section id="{{ anchor_id | escape }}" data-breadcrumb-banner="{{ section.id }}"
  class="q-sub-banner-breadcrumb{% if is_plain %} is-plain{% elsif s.enable_overlap %} q-overlap{% endif %}"
  role="region"
  aria-label="{{ s.region_label | default: 'Breadcrumb banner' | escape }}"
  style="
    --q-min-h: {{ min_h_vh }}vh;
    --q-min-h-m: {{ min_h_mobile_vh }}vh;
    --q-safe-offset: {{ s.safe_offset_px | default: 0 }}px;

    --pad-y-d: {{ pad_y_d }}px;
    --pad-y-m: {{ pad_y_m }}px;

    --cta-justify: {{ cta_justify_css }};
    --crumb-justify: {% if text_align_value == 'center' %}center{% elsif text_align_value == 'right' %}flex-end{% else %}flex-start{% endif %};

    --d-heading: {{ col_heading }};
    --d-sub: {{ col_sub }};
    --crumb: {{ col_crumb }};
    --crumb-active: {{ col_crumb_active }};

    --sec-bg: {{ s.section_bg_color }};
    --sec-bg-o: {{ s.section_bg_opacity | default: 0 | divided_by: 100.0 }};
  "
>
  <div class="q-wrap">
    {% unless is_plain %}
      <!-- Media (inert) -->
      <div class="q-media" aria-hidden="true">
        {% if s.image != blank %}
          {%- liquid
            assign qtm_image_alt = s.image_alt | default: 'Breadcrumb banner image'
          -%}
          {{ s.image
            | image_url: width: 2560
            | image_tag:
            widths: '960,1280,1536,1920,2560',
            sizes: '100vw',
            loading: 'lazy',
            fetchpriority: 'low',
            class: 'q-media-el', alt: qtm_image_alt }}
        {% endif %}

        {% if s.overlay_mode == 'solid' %}
          <span class="q-overlay"
            style="--ov: {{ s.overlay_color | default: '#000000' }}; --ov-o: {{ s.overlay_opacity | default: 0 | divided_by: 100.0 }};"></span>
        {% elsif s.overlay_mode == 'gradient' %}
          <span class="q-gradient"
            style="
              --g-a: {{ s.grad_angle | default: 135 }}deg;
              --g-s: {{ s.grad_start | default: '#000000' }};
              --g-so: {{ s.grad_start_opacity | default: 0 | divided_by: 100.0 }};
              --g-e: {{ s.grad_end | default: '#000000' }};
              --g-eo: {{ s.grad_end_opacity | default: 0 | divided_by: 100.0 }};
            "></span>
        {% endif %}
      </div>
    {% endunless %}

    <!-- Content -->
    <div class="q-content" style="text-align: {{ text_align_value }};">
      <div class="q-inner" style="max-width: {{ max_w_px }};">
        {% if s.show_breadcrumb %}
          <nav class="q-breadcrumb" aria-label="Breadcrumb">
            <ol class="q-crumbs" itemscope itemtype="https://schema.org/BreadcrumbList">
              {% assign position = 1 %}
              <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href="{{ routes.root_url }}" itemprop="item" class="q-crumb-link"><span itemprop="name">{{ s.home_label | default: 'Home' | escape }}</span></a>
                <meta itemprop="position" content="{{ position }}">{% assign position = position | plus: 1 %}
              </li>

              {%- comment -%} Page-context crumbs {%- endcomment -%}
              {% if page_kind == 'product' %}
                {% if collection %}
                  <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="{{ collection.url }}" itemprop="item" class="q-crumb-link"><span itemprop="name">{{ collection.title | escape }}</span></a>
                    <meta itemprop="position" content="{{ position }}">{% assign position = position | plus: 1 %}
                  </li>
                {% endif %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ product.title | escape }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% elsif page_kind == 'collection' %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ collection.title | escape }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% elsif page_kind == 'article' %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <a href="{{ blog.url }}" itemprop="item" class="q-crumb-link"><span itemprop="name">{{ blog.title | escape }}</span></a>
                  <meta itemprop="position" content="{{ position }}">{% assign position = position | plus: 1 %}
                </li>
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ article.title | escape }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% elsif page_kind == 'blog' %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ blog.title | escape }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% elsif page_kind == 'page' %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ page.title | escape }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% elsif page_kind == 'cart' %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ 'cart.general.title' | t }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% elsif page_kind == 'search' %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ 'general.search.title' | t }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>

              {% else %}
                <li data-separator="{{ s.separator | default: '/' | escape }}" class="q-crumb q-crumb--current" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                  <span class="q-crumb-current" itemprop="name">{{ context_title | default: page_kind | capitalize | escape }}</span>
                  <meta itemprop="position" content="{{ position }}">
                </li>
              {% endif %}
            </ol>
          </nav>
        {% endif %}

        {% if s.show_heading %}
          {% case heading_level %}
            {% when 'h1' %}
              <h1 class="q-heading"
                style="margin:6px 0 8px 0; font-size: {{ heading_fs }}; line-height:1.2; font-weight:700; letter-spacing: {{ head_ls_em }}; color: var(--d-heading); {% if t.headings_uppercase and s.heading_uppercase %}text-transform:uppercase;{% endif %}">{{ s.heading | default: context_title | escape }}</h1>
            {% else %}
              <h2 class="q-heading"
                style="margin:6px 0 8px 0; font-size: {{ heading_fs }}; line-height:1.2; font-weight:700; letter-spacing: {{ head_ls_em }}; color: var(--d-heading); {% if t.headings_uppercase and s.heading_uppercase %}text-transform:uppercase;{% endif %}">{{ s.heading | default: context_title | escape }}</h2>
          {% endcase %}
        {% endif %}

        {% if s.subheading != blank %}
          <p class="q-sub" style="margin:0 0 10px 0; font-size: {{ sub_fs }}; line-height:1.6; color: var(--d-sub);">{{ s.subheading }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="q-btns">
            {% for block in section.blocks %}
              {% if block.type == 'button' and block.settings.label != blank and block.settings.link != blank %}
                {% assign b = block.settings %}
                {% liquid
                  assign variant = b.button_mode | default: t.button_variant_default | default: 'solid'
                  assign btn_text = t.text_on_color
                  assign btn_bg = t.color_primary
                  assign btn_border = t.color_primary
                  if variant == 'outline'
                    assign btn_text = t.color_primary
                    assign btn_bg = 'transparent'
                    assign btn_border = t.color_primary
                  elsif variant == 'ghost'
                    assign btn_text = t.color_primary
                    assign btn_bg = 'transparent'
                    assign btn_border = 'transparent'
                  endif
                  assign bw = b.border_width | default: t.button_border_width | default: 1
                  assign radius_px = b.radius | default: t.button_radius | default: 12
                  if b.use_theme_colors == false
                    if b.text_color != blank
                      assign btn_text = b.text_color
                    endif
                    if b.bg_color != blank
                      assign btn_bg = b.bg_color
                    endif
                    if b.border_color != blank
                      assign btn_border = b.border_color
                    endif
                  endif
                  assign btn_size = b.size | default: 'md'
                  assign pad_y = 12
                  assign pad_x = 20
                  if btn_size == 'sm'
                    assign pad_y = 10
                    assign pad_x = 16
                  elsif btn_size == 'lg'
                    assign pad_y = 14
                    assign pad_x = 24
                  endif
                %}
                <a href="{{ b.link | escape }}"
                  {% if b.new_tab %}target="_blank" rel="noopener"{% endif %}
                  aria-label="{{ b.aria_label | default: b.label | escape }}"
                  class="q-btn"
                  style="
                    --btn-text: {{ btn_text }};
                    --btn-bg: {{ btn_bg }};
                    --btn-border: {{ btn_border }};
                    --btn-bw: {{ bw }}px;
                    --btn-radius: {{ radius_px }}px;
                    --btn-px: {{ pad_x }}px; --btn-py: {{ pad_y }}px;
                  "
                  {{ block.shopify_attributes }}>
                  {% if b.icon != blank and b.icon != 'none' %}<span aria-hidden="true">{{ b.icon }}</span>{% endif %}
                  <span>{% if t.buttons_uppercase %}{{ b.label | upcase }}{% else %}{{ b.label }}{% endif %}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if s.show_breadcrumb %}
  {% capture json_less_than %}\u003c{% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ s.home_label | default: 'Home' | json | replace: '<', json_less_than }}, "item": {{ routes.root_url | json | replace: '<', json_less_than }} }
        {% if page_kind == 'product' %}
          {% assign pos = 2 %}
          {% if collection %}
            ,{ "@type": "ListItem", "position": {{ pos }}, "name": {{ collection.title | json | replace: '<', json_less_than }}, "item": {{ collection.url | json | replace: '<', json_less_than }} }
            {% assign pos = pos | plus: 1 %}
          {% endif %}
          ,{ "@type": "ListItem", "position": {{ pos }}, "name": {{ product.title | json | replace: '<', json_less_than }} }
        {% elsif page_kind == 'collection' %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json | replace: '<', json_less_than }} }
        {% elsif page_kind == 'article' %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json | replace: '<', json_less_than }}, "item": {{ blog.url | json | replace: '<', json_less_than }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json | replace: '<', json_less_than }} }
        {% elsif page_kind == 'blog' %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json | replace: '<', json_less_than }} }
        {% elsif page_kind == 'page' %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json | replace: '<', json_less_than }} }
        {% elsif page_kind == 'cart' %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ 'cart.general.title' | t | json | replace: '<', json_less_than }} }
        {% elsif page_kind == 'search' %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ 'general.search.title' | t | json | replace: '<', json_less_than }} }
        {% else %}
          ,{ "@type": "ListItem", "position": 2, "name": {{ context_title | default: page_kind | capitalize | json | replace: '<', json_less_than }} }
        {% endif %}
      ]
    }
  </script>
  {% endif %}
</section>

<style>
  [data-breadcrumb-banner="{{ section.id }}"] * { box-sizing: border-box; }

  /* Section background (applies in both modes) */
  [data-breadcrumb-banner="{{ section.id }}"] .q-wrap{
    background: color-mix(in srgb, var(--sec-bg, #ffffff) calc(var(--sec-bg-o, 0) * 100%), transparent);
  }

  /* MEDIA MODE (background image) */
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-wrap{
    position: relative;
    min-height: var(--q-min-h, 40vh);
  }
  @media (max-width:767.98px){
    [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-wrap{ min-height: var(--q-min-h-m, 36vh); }
  }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-media{ position:absolute; inset:0; pointer-events:none; overflow:hidden; }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-media-el{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;
    filter: {{ media_filter }};
  }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-overlay,
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-gradient{ position:absolute; inset:0; pointer-events:none; }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-overlay{ background-color: var(--ov, #000); opacity: var(--ov-o, 0); }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-gradient{
    background-image:
      linear-gradient(var(--g-a, 135deg),
        color-mix(in srgb, var(--g-s, #000) calc(var(--g-so, 0) * 100%), transparent) 0%,
        color-mix(in srgb, var(--g-e, #000) calc(var(--g-eo, 0) * 100%), transparent) 100%);
  }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-content{
    position:relative; z-index:1; width:100%;
    min-height: inherit;
    display:grid; place-items:center;
    padding-left: 20px; padding-right: 20px;
  }
  [data-breadcrumb-banner="{{ section.id }}"]:not(.is-plain) .q-inner{
    width:100%; max-width: {{ max_w_px }};
    margin-left:auto; margin-right:auto; /* center the block */
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 12px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: clamp(14px, 4.5vw, 28px);
    box-shadow: 0 10px 26px rgba(0,0,0,.09);
    text-align: inherit;
  }

  /* PLAIN MODE (no image) */
  [data-breadcrumb-banner="{{ section.id }}"].is-plain .q-wrap{
    position: relative;
    min-height: auto;
    padding-top: var(--pad-y-d, 48px);
    padding-bottom: var(--pad-y-d, 48px);
  }
  @media (max-width:767.98px){
    [data-breadcrumb-banner="{{ section.id }}"].is-plain .q-wrap{
      padding-top: var(--pad-y-m, 32px);
      padding-bottom: var(--pad-y-m, 32px);
    }
  }
  [data-breadcrumb-banner="{{ section.id }}"].is-plain .q-content{
    position: relative; z-index: 1; width: 100%;
    display: block; padding-left: 20px; padding-right: 20px;
  }
  [data-breadcrumb-banner="{{ section.id }}"].is-plain .q-inner{
    width: 100%; max-width: {{ max_w_px }};
    margin-left:auto; margin-right:auto; /* center the block */
    background: transparent; border: none; box-shadow: none;
    backdrop-filter: none; -webkit-backdrop-filter: none;
    padding: 0; text-align: inherit;
  }

  /* Shared */
  [data-breadcrumb-banner="{{ section.id }}"] .q-breadcrumb{ display:flex; width:100%; } /* enable centering container */
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumbs{
    width:100%; min-width:0;
    margin-top:0; margin-bottom:0; padding:0; list-style:none;
    display:flex; flex-wrap:wrap; gap:6px; align-items:center;
    justify-content: var(--crumb-justify, center); /* left/center/right via setting */
    color: var(--crumb);
    font-size: 0.875rem; line-height: 1.2;
  }
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb{ display:flex; align-items:center; gap:6px; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb + .q-crumb::before{
    content: attr(data-separator);
    opacity:.6;
  }
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb-link{ color: var(--crumb); text-decoration:none; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb-link:hover{ text-decoration: underline; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb-current{ color: var(--crumb-active); }

  [data-breadcrumb-banner="{{ section.id }}"] .q-heading { color: var(--d-heading); }
  [data-breadcrumb-banner="{{ section.id }}"] .q-sub     { color: var(--d-sub); }

  [data-breadcrumb-banner="{{ section.id }}"] .q-btns{ display:flex; flex-wrap:wrap; gap:12px; margin-top:8px; justify-content: var(--cta-justify, flex-start); }
  [data-breadcrumb-banner="{{ section.id }}"] .q-btn{
    display:inline-flex; align-items:center; gap:8px; font-weight:600; text-decoration:none;
    color: var(--btn-text) !important; background-color: var(--btn-bg) !important;
    border: var(--btn-bw, 1px) solid var(--btn-border) !important;
    border-radius: var(--btn-radius, 12px);
    padding-left: var(--btn-px); padding-right: var(--btn-px);
    padding-top: var(--btn-py); padding-bottom: var(--btn-py);
    transition: transform .15s ease, opacity .15s ease;
  }
  [data-breadcrumb-banner="{{ section.id }}"] .q-btn:focus-visible{ outline:2px solid rgba(0,0,0,.35); outline-offset:2px; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-btn:hover{ transform: translateY(-1px); opacity: {{ t.button_hover_opacity | default: 92 }}%; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-btn:active{ transform: scale({{ t.button_active_scale | default: 98 | divided_by: 100.0 }}); }
  [data-breadcrumb-banner="{{ section.id }}"].q-overlap { margin-top: calc(var(--q-safe-offset) * -1); padding-top: var(--q-safe-offset); }
  [data-breadcrumb-banner="{{ section.id }}"] .q-inner,
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb { min-width:0; overflow-wrap:anywhere; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-btn { min-height:44px; max-width:100%; }
  [data-breadcrumb-banner="{{ section.id }}"] .q-crumb-link:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  @media (prefers-reduced-motion: reduce) {
    [data-breadcrumb-banner="{{ section.id }}"] .q-btn { transition:none; transform:none; }
  }
</style>

