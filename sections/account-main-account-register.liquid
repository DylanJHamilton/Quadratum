{% comment %}
  Quadratum Account System
  File 6 of 10 — Customer Register Only

  Handles:
  - Create account form
  - First name / last name
  - Email
  - Password
  - Optional benefits/content panel
  - Link back to login

  Does NOT handle:
  - Login
  - Recover password
  - Dashboard
  - Orders
  - Addresses
{% endcomment %}

{{ 'account-main-account-register.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_password_toggle %}
  <script src="{{ 'account-main-account-register.js' | asset_url }}" defer="defer"></script>
{% endif %}

<section
  id="QtmAccountMainRegister-{{ section.id }}"
  class="
    qtmAccountRegister
    qtmAccountRegister--{{ section.settings.layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-subheading-size: {{ section.settings.subheading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-gap: {{ section.settings.field_spacing }}px;
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-field-radius: {{ section.settings.field_radius }}px;
    --qtm-account-field-padding: {{ section.settings.field_padding }}px;
    --qtm-account-button-radius: {{ section.settings.button_radius }}px;
    --qtm-account-button-padding: {{ section.settings.button_padding }}px;
  "
  data-qtm-account-register
>
  <div class="qtmAccountRegister__shell">
    <div class="qtmAccountRegister__layout">
      <div class="qtmAccountRegister__formColumn">
        <div class="qtmAccountRegister__card">
          <header class="qtmAccountRegister__header">
            <h1 class="qtmAccountRegister__heading">
              {{ section.settings.heading }}
            </h1>

            {% if section.settings.subheading != blank %}
              <p class="qtmAccountRegister__subheading">
                {{ section.settings.subheading }}
              </p>
            {% endif %}
          </header>

          {% form 'create_customer', class: 'qtmAccountRegister__form', novalidate: 'novalidate' %}
            {% if form.errors %}
              <div
                class="qtmAccountRegister__errors"
                role="alert"
                aria-live="assertive"
                tabindex="-1"
              >
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="qtmAccountRegister__nameGrid">
              <div class="qtmAccountRegister__field">
                <label for="QtmAccountRegisterFirstName-{{ section.id }}">
                  First name <span aria-hidden="true">*</span>
                </label>

                <input
                  id="QtmAccountRegisterFirstName-{{ section.id }}"
                  type="text"
                  name="customer[first_name]"
                  autocomplete="given-name"
                  value="{% if form.first_name %}{{ form.first_name }}{% endif %}"
                  required
                >
              </div>

              <div class="qtmAccountRegister__field">
                <label for="QtmAccountRegisterLastName-{{ section.id }}">
                  Last name <span aria-hidden="true">*</span>
                </label>

                <input
                  id="QtmAccountRegisterLastName-{{ section.id }}"
                  type="text"
                  name="customer[last_name]"
                  autocomplete="family-name"
                  value="{% if form.last_name %}{{ form.last_name }}{% endif %}"
                  required
                >
              </div>
            </div>

            <div class="qtmAccountRegister__field">
              <label for="QtmAccountRegisterEmail-{{ section.id }}">
                Email <span aria-hidden="true">*</span>
              </label>

              <input
                id="QtmAccountRegisterEmail-{{ section.id }}"
                type="email"
                name="customer[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% endif %}"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
                required
              >
            </div>

            <div class="qtmAccountRegister__field">
              <label for="QtmAccountRegisterPassword-{{ section.id }}">
                Password <span aria-hidden="true">*</span>
              </label>

              <div class="qtmAccountRegister__passwordField">
                <input
                  id="QtmAccountRegisterPassword-{{ section.id }}"
                  type="password"
                  name="customer[password]"
                  autocomplete="new-password"
                  {% if form.errors contains 'password' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                  data-qtm-account-register-password-input
                >

                {% if section.settings.show_password_toggle %}
                  <button
                    type="button"
                    class="qtmAccountRegister__passwordToggle"
                    aria-label="Show password"
                    data-qtm-account-register-password-toggle
                    data-show-label="Show password"
                    data-hide-label="Hide password"
                  >
                    <span data-qtm-account-register-password-toggle-text>
                      Show
                    </span>
                  </button>
                {% endif %}
              </div>
            </div>

            <button
              type="submit"
              class="qtmAccountRegister__button qtmAccountRegister__button--{{ section.settings.button_style }}"
            >
              {{ section.settings.submit_label }}
            </button>
          {% endform %}

          {% if section.settings.show_login_prompt %}
            <div class="qtmAccountRegister__loginPrompt">
              {% if section.settings.login_prompt_text != blank %}
                <p>{{ section.settings.login_prompt_text }}</p>
              {% endif %}

              <a href="{{ routes.account_login_url }}">
                {{ section.settings.login_link_label }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>

      {% if section.settings.benefits_heading != blank or section.settings.benefits_text != blank or section.blocks.size > 0 %}
        <aside class="qtmAccountRegister__benefitsColumn" aria-label="Account benefits">
          <div class="qtmAccountRegister__benefitsCard">
            {% if section.settings.benefits_heading != blank %}
              <h2 class="qtmAccountRegister__benefitsHeading">
                {{ section.settings.benefits_heading }}
              </h2>
            {% endif %}

            {% if section.settings.benefits_text != blank %}
              <div class="qtmAccountRegister__benefitsText rte">
                {{ section.settings.benefits_text }}
              </div>
            {% endif %}

            {% if section.blocks.size > 0 %}
              <div class="qtmAccountRegister__benefitsList">
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when 'benefit' %}
                      <div class="qtmAccountRegister__benefit" {{ block.shopify_attributes }}>
                        {% if block.settings.icon != blank %}
                          <div class="qtmAccountRegister__benefitIcon" aria-hidden="true">
                            {{ block.settings.icon }}
                          </div>
                        {% endif %}

                        <div class="qtmAccountRegister__benefitContent">
                          {% if block.settings.title != blank %}
                            <h3 class="qtmAccountRegister__benefitTitle">
                              {{ block.settings.title }}
                            </h3>
                          {% endif %}

                          {% if block.settings.text != blank %}
                            <p class="qtmAccountRegister__benefitText">
                              {{ block.settings.text }}
                            </p>
                          {% endif %}
                        </div>
                      </div>
                  {% endcase %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account Main Register",
  "tag": "section",
  "class": "qtm-account-main-register",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create Account"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Create an account for faster checkout, order tracking, and saved details."
    },
    {
      "type": "header",
      "content": "Benefits content"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Why create an account?"
    },
    {
      "type": "richtext",
      "id": "benefits_text",
      "label": "Benefits text",
      "default": "<p>Save your details, track orders, and make future purchases easier.</p>"
    },
    {
      "type": "header",
      "content": "Login prompt"
    },
    {
      "type": "checkbox",
      "id": "show_login_prompt",
      "label": "Show login prompt",
      "default": true
    },
    {
      "type": "text",
      "id": "login_prompt_text",
      "label": "Login prompt text",
      "default": "Already have an account?"
    },
    {
      "type": "text",
      "id": "login_link_label",
      "label": "Login link label",
      "default": "Sign in"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Create Account"
    },
    {
      "type": "checkbox",
      "id": "show_password_toggle",
      "label": "Show password toggle",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Fields"
    },
    {
      "type": "range",
      "id": "field_radius",
      "label": "Field radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "field_padding",
      "label": "Field padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "field_spacing",
      "label": "Field spacing",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Faster checkout"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Save your information and check out faster next time."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Account Main Register",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Faster checkout",
            "text": "Save your details for a smoother shopping experience."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Order tracking",
            "text": "Keep an eye on your recent orders from your account."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Saved addresses",
            "text": "Manage shipping details for future purchases."
          }
        }
      ]
    }
  ]
}
{% endschema %}