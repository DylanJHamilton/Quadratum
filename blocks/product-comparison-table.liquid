{%- liquid
  assign block_id = 'product-comparison-table-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'standard'
  assign column_count = block.settings.column_count | default: 3
  assign row_count = block.settings.row_count | default: 6
  assign highlight_column = block.settings.highlight_column | default: '2'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-comparison-table
    product-comparison-table--{{ layout_style }}
    product-comparison-table--width-{{ block_width }}
    product-comparison-table--align-{{ alignment }}
    product-comparison-table--highlight-{{ highlight_column }}
    {% unless show_on_desktop %} product-comparison-table--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-comparison-table--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-comparison-table--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-comparison-table--animate product-comparison-table--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-comparison-table-margin-top: {{ block.settings.margin_top }}px;
    --product-comparison-table-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-comparison-table-padding: {{ block.settings.padding }}px;
    --product-comparison-table-gap: {{ block.settings.gap }}px;
    --product-comparison-table-cell-padding: {{ block.settings.cell_padding }}px;
    --product-comparison-table-border-width: {{ block.settings.border_width }}px;
    --product-comparison-table-border-radius: {{ block.settings.border_radius }}px;
    --product-comparison-table-heading-color: {{ block.settings.heading_color }};
    --product-comparison-table-text-color: {{ block.settings.text_color }};
    --product-comparison-table-background-color: {{ block.settings.background_color }};
    --product-comparison-table-card-background-color: {{ block.settings.card_background_color }};
    --product-comparison-table-border-color: {{ block.settings.border_color }};
    --product-comparison-table-link-color: {{ block.settings.link_color }};
    --product-comparison-table-highlight-background: {{ block.settings.highlight_background_color }};
    --product-comparison-table-highlight-text: {{ block.settings.highlight_text_color }};
    --product-comparison-table-badge-background: {{ block.settings.badge_background_color }};
    --product-comparison-table-badge-text: {{ block.settings.badge_text_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-comparison-table-margin-top);
      margin-bottom: var(--product-comparison-table-margin-bottom);
      padding: var(--product-comparison-table-padding);
      color: var(--product-comparison-table-text-color);
      background: var(--product-comparison-table-background-color);
    }

    #{{ block_id }}.product-comparison-table--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-comparison-table--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-comparison-table--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-comparison-table--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-comparison-table--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-comparison-table--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-comparison-table--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-comparison-table--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-comparison-table__inner {
      display: grid;
      gap: var(--product-comparison-table-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .product-comparison-table__header {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-comparison-table__heading {
      margin: 0;
      color: var(--product-comparison-table-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-comparison-table__text {
      color: var(--product-comparison-table-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-comparison-table__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-comparison-table__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-comparison-table__table-wrap {
      width: 100%;
      min-width: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      border-radius: var(--product-comparison-table-border-radius);
      background: var(--product-comparison-table-card-background-color);
    }

    #{{ block_id }} .product-comparison-table__table {
      width: 100%;
      min-width: 680px;
      border-collapse: collapse;
      table-layout: fixed;
    }

    #{{ block_id }} .product-comparison-table__table th,
    #{{ block_id }} .product-comparison-table__table td {
      padding: var(--product-comparison-table-cell-padding);
      color: var(--product-comparison-table-text-color);
      border-bottom: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      border-right: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      vertical-align: middle;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    #{{ block_id }} .product-comparison-table__table th:last-child,
    #{{ block_id }} .product-comparison-table__table td:last-child {
      border-right: 0;
    }

    #{{ block_id }} .product-comparison-table__table tr:last-child td {
      border-bottom: 0;
    }

    #{{ block_id }} .product-comparison-table__table th {
      color: var(--product-comparison-table-heading-color);
      background: rgba(0, 0, 0, 0.025);
      text-align: inherit;
    }

    #{{ block_id }} .product-comparison-table__feature-heading,
    #{{ block_id }} .product-comparison-table__feature-label {
      color: var(--product-comparison-table-heading-color);
    }

    #{{ block_id }} .product-comparison-table__column-title {
      display: grid;
      gap: 6px;
      color: var(--product-comparison-table-heading-color);
    }

    #{{ block_id }} .product-comparison-table__badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      border-radius: 999px;
      color: var(--product-comparison-table-badge-text);
      background: var(--product-comparison-table-badge-background);
      line-height: 1.2;
      font-size: 0.78em;
    }

    #{{ block_id }}.product-comparison-table--align-center .product-comparison-table__badge {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-comparison-table--align-right .product-comparison-table__badge {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-comparison-table__value {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--product-comparison-table-text-color);
    }

    #{{ block_id }} .product-comparison-table__value a {
      color: var(--product-comparison-table-link-color);
      text-underline-offset: 0.2em;
    }

    #{{ block_id }} .product-comparison-table__check {
      color: var(--product-comparison-table-link-color);
      line-height: 1;
    }

    #{{ block_id }}.product-comparison-table--highlight-1 .product-comparison-table__table th:nth-child(2),
    #{{ block_id }}.product-comparison-table--highlight-1 .product-comparison-table__table td:nth-child(2),
    #{{ block_id }}.product-comparison-table--highlight-2 .product-comparison-table__table th:nth-child(3),
    #{{ block_id }}.product-comparison-table--highlight-2 .product-comparison-table__table td:nth-child(3),
    #{{ block_id }}.product-comparison-table--highlight-3 .product-comparison-table__table th:nth-child(4),
    #{{ block_id }}.product-comparison-table--highlight-3 .product-comparison-table__table td:nth-child(4),
    #{{ block_id }}.product-comparison-table--highlight-4 .product-comparison-table__table th:nth-child(5),
    #{{ block_id }}.product-comparison-table--highlight-4 .product-comparison-table__table td:nth-child(5) {
      color: var(--product-comparison-table-highlight-text);
      background: var(--product-comparison-table-highlight-background);
    }

    #{{ block_id }}.product-comparison-table--cards .product-comparison-table__table-wrap {
      border: 0;
      background: transparent;
      overflow: visible;
    }

    #{{ block_id }}.product-comparison-table--cards .product-comparison-table__table {
      border-collapse: separate;
      border-spacing: var(--product-comparison-table-gap) 0;
    }

    #{{ block_id }}.product-comparison-table--cards .product-comparison-table__table th,
    #{{ block_id }}.product-comparison-table--cards .product-comparison-table__table td {
      border-right: 0;
      background: var(--product-comparison-table-card-background-color);
      border-left: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      border-right: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
    }

    #{{ block_id }}.product-comparison-table--cards .product-comparison-table__table th {
      border-top: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      border-radius: var(--product-comparison-table-border-radius) var(--product-comparison-table-border-radius) 0 0;
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }}.product-comparison-table--cards .product-comparison-table__table tr:last-child td {
      border-bottom: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      border-radius: 0 0 var(--product-comparison-table-border-radius) var(--product-comparison-table-border-radius);
    }

    #{{ block_id }}.product-comparison-table--responsive_stack .product-comparison-table__cards {
      display: none;
    }

    #{{ block_id }} .product-comparison-table__cards {
      display: none;
    }

    #{{ block_id }} .product-comparison-table__card-list {
      display: grid;
      gap: var(--product-comparison-table-gap);
    }

    #{{ block_id }} .product-comparison-table__card {
      display: grid;
      gap: 0;
      overflow: hidden;
      background: var(--product-comparison-table-card-background-color);
      border: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
      border-radius: var(--product-comparison-table-border-radius);
    }

    #{{ block_id }} .product-comparison-table__card-header {
      display: grid;
      gap: 6px;
      padding: var(--product-comparison-table-cell-padding);
      color: var(--product-comparison-table-heading-color);
      background: rgba(0, 0, 0, 0.025);
      border-bottom: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
    }

    #{{ block_id }} .product-comparison-table__card-row {
      display: grid;
      gap: 6px;
      padding: var(--product-comparison-table-cell-padding);
      border-bottom: var(--product-comparison-table-border-width) solid var(--product-comparison-table-border-color);
    }

    #{{ block_id }} .product-comparison-table__card-row:last-child {
      border-bottom: 0;
    }

    #{{ block_id }} .product-comparison-table__card-label {
      color: var(--product-comparison-table-heading-color);
      line-height: 1.25;
    }

    #{{ block_id }} .product-comparison-table__card-value {
      color: var(--product-comparison-table-text-color);
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    #{{ block_id }}.product-comparison-table--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-comparison-table--animate-fade {
      animation-name: productComparisonTableFade;
    }

    #{{ block_id }}.product-comparison-table--animate-fade_up {
      animation-name: productComparisonTableFadeUp;
    }

    #{{ block_id }}.product-comparison-table--animate-fade_down {
      animation-name: productComparisonTableFadeDown;
    }

    #{{ block_id }}.product-comparison-table--animate-fade_left {
      animation-name: productComparisonTableFadeLeft;
    }

    #{{ block_id }}.product-comparison-table--animate-fade_right {
      animation-name: productComparisonTableFadeRight;
    }

    #{{ block_id }}.product-comparison-table--animate-zoom {
      animation-name: productComparisonTableZoom;
    }

    @keyframes productComparisonTableFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productComparisonTableFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productComparisonTableFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productComparisonTableFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productComparisonTableFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productComparisonTableZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-comparison-table--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-comparison-table--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-comparison-table--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-comparison-table--responsive_stack .product-comparison-table__table-wrap {
        display: none;
      }

      #{{ block_id }}.product-comparison-table--responsive_stack .product-comparison-table__cards {
        display: block;
      }

      #{{ block_id }} .product-comparison-table__table {
        min-width: 640px;
      }

      #{{ block_id }} .product-comparison-table__table th,
      #{{ block_id }} .product-comparison-table__table td,
      #{{ block_id }} .product-comparison-table__card-header,
      #{{ block_id }} .product-comparison-table__card-row {
        padding: min(var(--product-comparison-table-cell-padding), 18px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-comparison-table--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-comparison-table__inner">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="product-comparison-table__header">
        {% if block.settings.heading != blank %}
          <h3 class="product-comparison-table__heading">
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="product-comparison-table__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-comparison-table__table-wrap">
      <table class="product-comparison-table__table">
        <caption class="visually-hidden">
          {{ block.settings.heading | default: 'Product comparison' | escape }}
        </caption>

        <thead>
          <tr>
            <th scope="col" class="product-comparison-table__feature-heading">
              {{ block.settings.feature_heading | escape }}
            </th>

            {%- for column_index in (1..4) -%}
              {%- if column_index <= column_count -%}
                {%- liquid
                  assign title_key = 'column_' | append: column_index | append: '_title'
                  assign badge_key = 'column_' | append: column_index | append: '_badge'
                  assign column_title = block.settings[title_key]
                  assign column_badge = block.settings[badge_key]
                -%}

                <th scope="col">
                  <span class="product-comparison-table__column-title">
                    {% if column_badge != blank %}
                      <span class="product-comparison-table__badge">
                        {{ column_badge | escape }}
                      </span>
                    {% endif %}

                    <span>{{ column_title | escape }}</span>
                  </span>
                </th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        </thead>

        <tbody>
          {%- for row_index in (1..8) -%}
            {%- if row_index <= row_count -%}
              {%- liquid
                assign label_key = 'row_' | append: row_index | append: '_label'
                assign row_label = block.settings[label_key]
              -%}

              {% if row_label != blank %}
                <tr>
                  <td class="product-comparison-table__feature-label">
                    {{ row_label | escape }}
                  </td>

                  {%- for column_index in (1..4) -%}
                    {%- if column_index <= column_count -%}
                      {%- liquid
                        assign value_key = 'row_' | append: row_index | append: '_column_' | append: column_index
                        assign row_value = block.settings[value_key]
                      -%}

                      <td>
                        {% if row_value == 'yes' %}
                          <span class="product-comparison-table__value">
                            <span class="product-comparison-table__check" aria-hidden="true">✓</span>
                            <span class="visually-hidden">Included</span>
                          </span>
                        {% elsif row_value == 'no' %}
                          <span class="product-comparison-table__value" aria-label="Not included">—</span>
                        {% else %}
                          <span class="product-comparison-table__value">{{ row_value | escape }}</span>
                        {% endif %}
                      </td>
                    {%- endif -%}
                  {%- endfor -%}
                </tr>
              {% endif %}
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div class="product-comparison-table__cards" aria-label="{{ block.settings.heading | default: 'Product comparison' | escape }}">
      <div class="product-comparison-table__card-list">
        {%- for column_index in (1..4) -%}
          {%- if column_index <= column_count -%}
            {%- liquid
              assign title_key = 'column_' | append: column_index | append: '_title'
              assign badge_key = 'column_' | append: column_index | append: '_badge'
              assign column_title = block.settings[title_key]
              assign column_badge = block.settings[badge_key]
            -%}

            <article class="product-comparison-table__card">
              <div class="product-comparison-table__card-header">
                {% if column_badge != blank %}
                  <span class="product-comparison-table__badge">
                    {{ column_badge | escape }}
                  </span>
                {% endif %}

                <strong>{{ column_title | escape }}</strong>
              </div>

              {%- for row_index in (1..8) -%}
                {%- if row_index <= row_count -%}
                  {%- liquid
                    assign label_key = 'row_' | append: row_index | append: '_label'
                    assign value_key = 'row_' | append: row_index | append: '_column_' | append: column_index

                    assign row_label = block.settings[label_key]
                    assign row_value = block.settings[value_key]
                  -%}

                  {% if row_label != blank %}
                    <div class="product-comparison-table__card-row">
                      <span class="product-comparison-table__card-label">
                        {{ row_label | escape }}
                      </span>

                      <span class="product-comparison-table__card-value">
                        {% if row_value == 'yes' %}
                          <span class="product-comparison-table__check" aria-hidden="true">✓</span>
                          <span class="visually-hidden">Included</span>
                        {% elsif row_value == 'no' %}
                          <span aria-label="Not included">—</span>
                        {% else %}
                          {{ row_value | escape }}
                        {% endif %}
                      </span>
                    </div>
                  {% endif %}
                {%- endif -%}
              {%- endfor -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product comparison table",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare your options"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Help shoppers compare features, packages, or product models and choose the right option faster.</p>"
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Feature column heading",
      "default": "Feature"
    },
    {
      "type": "range",
      "id": "column_count",
      "label": "Number of columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "row_count",
      "label": "Number of rows",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "highlight_column",
      "label": "Highlight column",
      "default": "2",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "1",
          "label": "Column 1"
        },
        {
          "value": "2",
          "label": "Column 2"
        },
        {
          "value": "3",
          "label": "Column 3"
        },
        {
          "value": "4",
          "label": "Column 4"
        }
      ]
    },

    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "text",
      "id": "column_1_title",
      "label": "Column 1 title",
      "default": "Basic"
    },
    {
      "type": "text",
      "id": "column_1_badge",
      "label": "Column 1 badge"
    },
    {
      "type": "text",
      "id": "column_2_title",
      "label": "Column 2 title",
      "default": "Plus"
    },
    {
      "type": "text",
      "id": "column_2_badge",
      "label": "Column 2 badge",
      "default": "Popular"
    },
    {
      "type": "text",
      "id": "column_3_title",
      "label": "Column 3 title",
      "default": "Premium"
    },
    {
      "type": "text",
      "id": "column_3_badge",
      "label": "Column 3 badge"
    },
    {
      "type": "text",
      "id": "column_4_title",
      "label": "Column 4 title",
      "default": "Pro"
    },
    {
      "type": "text",
      "id": "column_4_badge",
      "label": "Column 4 badge"
    },

    {
      "type": "header",
      "content": "Rows"
    },
    {
      "type": "text",
      "id": "row_1_label",
      "label": "Row 1 label",
      "default": "Best for"
    },
    {
      "type": "text",
      "id": "row_1_column_1",
      "label": "Row 1 column 1",
      "default": "Starter use"
    },
    {
      "type": "text",
      "id": "row_1_column_2",
      "label": "Row 1 column 2",
      "default": "Everyday use"
    },
    {
      "type": "text",
      "id": "row_1_column_3",
      "label": "Row 1 column 3",
      "default": "Advanced use"
