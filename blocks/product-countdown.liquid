{%- liquid
  assign block_id = 'product-countdown-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'cards'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{%- capture qtm_epoch -%}{%- render 'qtm-block-deadline', target_date: block.settings.target_date, target_time: block.settings.target_time, offset: block.settings.timezone_offset -%}{%- endcapture -%}
{%- assign qtm_epoch = qtm_epoch | strip -%}
{%- if qtm_epoch != blank -%}
<div
  id="{{ block_id }}"
  class="
    product-countdown
    product-countdown--{{ layout_style }}
    product-countdown--width-{{ block_width }}
    product-countdown--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} product-countdown--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} product-countdown--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} product-countdown--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-countdown--animate product-countdown--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-countdown-margin-top: {{ block.settings.margin_top }}px;
    --product-countdown-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-countdown-padding: {{ block.settings.padding }}px;
    --product-countdown-gap: {{ block.settings.gap }}px;
    --product-countdown-card-padding: {{ block.settings.card_padding }}px;
    --product-countdown-border-width: {{ block.settings.border_width }}px;
    --product-countdown-border-radius: {{ block.settings.border_radius }}px;
    --product-countdown-heading-color: {{ block.settings.heading_color }};
    --product-countdown-text-color: {{ block.settings.text_color }};
    --product-countdown-background-color: {{ block.settings.background_color }};
    --product-countdown-card-background-color: {{ block.settings.card_background_color }};
    --product-countdown-border-color: {{ block.settings.border_color }};
    --product-countdown-link-color: {{ block.settings.link_color }};
    --product-countdown-number-background: {{ block.settings.number_background_color }};
    --product-countdown-number-text: {{ block.settings.number_text_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-countdown
  data-q-campaign data-mode="countdown" data-target-epoch="{{ qtm_epoch }}" data-show-seconds="true" data-expired-behavior="show_message" data-expired-fallback="Countdown complete."
  data-design-mode="{{ request.design_mode }}"
  data-target-date="{{ block.settings.target_date | strip | escape }}"
  data-target-time="{{ block.settings.target_time | strip | escape }}"
  data-timezone-offset="{{ block.settings.timezone_offset | strip | escape }}"
  data-expired-message="{{ block.settings.expired_message | escape }}"
>
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--product-countdown-margin-top);
      margin-bottom: var(--product-countdown-margin-bottom);
      padding: var(--product-countdown-padding);
      color: var(--product-countdown-text-color);
      background: var(--product-countdown-background-color);
    }

    #{{ block_id }}.product-countdown--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-countdown--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-countdown--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-countdown--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-countdown--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-countdown--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-countdown--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-countdown--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-countdown__inner {
      display: grid;
      gap: var(--product-countdown-gap);
      width: 100%;
      min-width: 0;
      color: var(--product-countdown-text-color);
    }

    #{{ block_id }}.product-countdown--cards .product-countdown__inner,
    #{{ block_id }}.product-countdown--banner .product-countdown__inner {
      padding: var(--product-countdown-card-padding);
      background: var(--product-countdown-card-background-color);
      border: var(--product-countdown-border-width) solid var(--product-countdown-border-color);
      border-radius: var(--product-countdown-border-radius);
    }

    #{{ block_id }}.product-countdown--banner .product-countdown__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    #{{ block_id }}.product-countdown--minimal .product-countdown__inner {
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    #{{ block_id }} .product-countdown__content {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-countdown__eyebrow {
      margin: 0;
      color: var(--product-countdown-link-color);
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.78em;
    }

    #{{ block_id }} .product-countdown__heading {
      margin: 0;
      color: var(--product-countdown-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-countdown__text {
      color: var(--product-countdown-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-countdown__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-countdown__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-countdown__timer {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      min-width: 0;
    }

    #{{ block_id }}.product-countdown--align-center .product-countdown__timer {
      justify-content: center;
    }

    #{{ block_id }}.product-countdown--align-right .product-countdown__timer {
      justify-content: end;
    }

    #{{ block_id }} .product-countdown__unit {
      display: grid;
      gap: 4px;
      min-width: 0;
      padding: 12px 10px;
      text-align: center;
      color: var(--product-countdown-number-text);
      background: var(--product-countdown-number-background);
      border: var(--product-countdown-border-width) solid var(--product-countdown-border-color);
      border-radius: max(calc(var(--product-countdown-border-radius) - 6px), 0px);
    }

    #{{ block_id }} .product-countdown__number {
      display: block;
      color: var(--product-countdown-number-text);
      line-height: 1;
      font-size: clamp(1.35rem, 4vw, 2.25rem);
      font-variant-numeric: tabular-nums;
    }

    #{{ block_id }} .product-countdown__label {
      display: block;
      color: var(--product-countdown-number-text);
      line-height: 1.2;
      opacity: 0.78;
      font-size: 0.78em;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    #{{ block_id }} .product-countdown__expired {
      display: none;
      color: var(--product-countdown-heading-color);
      line-height: 1.45;
    }



    #{{ block_id }}.product-countdown--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-countdown--animate-fade {
      animation-name: productCountdownFade;
    }

    #{{ block_id }}.product-countdown--animate-fade_up {
      animation-name: productCountdownFadeUp;
    }

    #{{ block_id }}.product-countdown--animate-fade_down {
      animation-name: productCountdownFadeDown;
    }

    #{{ block_id }}.product-countdown--animate-fade_left {
      animation-name: productCountdownFadeLeft;
    }

    #{{ block_id }}.product-countdown--animate-fade_right {
      animation-name: productCountdownFadeRight;
    }

    #{{ block_id }}.product-countdown--animate-zoom {
      animation-name: productCountdownZoom;
    }

    @keyframes productCountdownFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productCountdownFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productCountdownFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productCountdownFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productCountdownFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productCountdownZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-countdown--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-countdown--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-countdown--banner .product-countdown__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-countdown__timer {
        max-width: 520px;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-countdown--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-countdown--cards .product-countdown__inner,
      #{{ block_id }}.product-countdown--banner .product-countdown__inner {
        padding: min(var(--product-countdown-card-padding), 22px);
      }

      #{{ block_id }}.product-countdown--banner .product-countdown__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-countdown__timer {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }} .product-countdown__unit {
        padding: 12px 8px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-countdown--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; min-width: 0; }
    #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} a { color: var(--product-countdown-link-color, currentColor); }
    #{{ block_id }} :is(a, button, input):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    @media (min-width: 990px) { .shopify-block:has(> #{{ block_id }}.product-countdown--hide-desktop) { display: none !important; } }
    @media (min-width: 750px) and (max-width: 989px) { .shopify-block:has(> #{{ block_id }}.product-countdown--hide-tablet) { display: none !important; } }
    @media (max-width: 749px) { .shopify-block:has(> #{{ block_id }}.product-countdown--hide-mobile) { display: none !important; } }
    #{{ block_id }} .product-countdown__expired:not([hidden]) { display: block; }
    #{{ block_id }} [data-q-static] { margin: 0; }
  </style>

  <div class="product-countdown__inner">
    <div class="product-countdown__content">
      {% if block.settings.eyebrow != blank %}
        <p class="product-countdown__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h3 class="product-countdown__heading">
          {{ block.settings.heading | escape }}
        </h3>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="product-countdown__text">
          {{ block.settings.text }}
        </div>
      {% endif %}

      <div class="product-countdown__expired" data-product-countdown-expired data-q-expired-message hidden>
        {{ block.settings.expired_message | escape }}
      </div>
    </div>

    <p data-q-static><time datetime="{{ block.settings.target_date | strip | escape }}T{{ block.settings.target_time | strip | escape }}{{ block.settings.timezone_offset | strip | escape }}">{{ block.settings.target_date | strip | escape }} {{ block.settings.target_time | strip | escape }} UTC{{ block.settings.timezone_offset | strip | escape }}</time></p>
    <div
      class="product-countdown__timer q-countdown__grid" hidden
      data-product-countdown-timer
      role="timer"
      aria-live="off"
      aria-label="{{ block.settings.timer_aria_label | default: 'Countdown' | escape }}"
    >
      <div class="product-countdown__unit" data-q-unit="days">
        <span class="product-countdown__number" data-q-num data-product-countdown-days>00</span>
        <span class="product-countdown__label">{{ block.settings.days_label | escape }}</span>
      </div>

      <div class="product-countdown__unit" data-q-unit="hours">
        <span class="product-countdown__number" data-q-num data-product-countdown-hours>00</span>
        <span class="product-countdown__label">{{ block.settings.hours_label | escape }}</span>
      </div>

      <div class="product-countdown__unit" data-q-unit="minutes">
        <span class="product-countdown__number" data-q-num data-product-countdown-minutes>00</span>
        <span class="product-countdown__label">{{ block.settings.minutes_label | escape }}</span>
      </div>

      <div class="product-countdown__unit" data-q-unit="seconds">
        <span class="product-countdown__number" data-q-num data-product-countdown-seconds>00</span>
        <span class="product-countdown__label">{{ block.settings.seconds_label | escape }}</span>
      </div>
    </div>
  </div>

</div>


{% elsif request.design_mode %}<p>Configure a valid date, time and UTC offset for this countdown.</p>{% endif %}
{% schema %}
{
  "name": "Product countdown",
  "settings": [
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "paragraph",
      "content": "Displays a merchant-configured deadline only; it does not create or end a Shopify discount. UTC offset is fixed and does not change for daylight saving time."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Countdown"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target date",
      "info": "Use YYYY-MM-DD format."
    },
    {
      "type": "text",
      "id": "target_time",
      "label": "Target time",
      "info": "Use 24-hour HH:MM or HH:MM:SS format.",
      "default": "23:59:59"
    },
    {
      "type": "select",
      "id": "timezone_offset",
      "label": "Timezone offset",
      "default": "+00:00",
      "options": [
        {
          "value": "-12:00",
          "label": "UTC-12:00"
        },
        {
          "value": "-11:00",
          "label": "UTC-11:00"
        },
        {
          "value": "-10:00",
          "label": "UTC-10:00"
        },
        {
          "value": "-09:00",
          "label": "UTC-09:00"
        },
        {
          "value": "-08:00",
          "label": "UTC-08:00"
        },
        {
          "value": "-07:00",
          "label": "UTC-07:00"
        },
        {
          "value": "-06:00",
          "label": "UTC-06:00"
        },
        {
          "value": "-05:00",
          "label": "UTC-05:00"
        },
        {
          "value": "-04:00",
          "label": "UTC-04:00"
        },
        {
          "value": "-03:00",
          "label": "UTC-03:00"
        },
        {
          "value": "-02:00",
          "label": "UTC-02:00"
        },
        {
          "value": "-01:00",
          "label": "UTC-01:00"
        },
        {
          "value": "+00:00",
          "label": "UTC+00:00"
        },
        {
          "value": "+01:00",
          "label": "UTC+01:00"
        },
        {
          "value": "+02:00",
          "label": "UTC+02:00"
        },
        {
          "value": "+03:00",
          "label": "UTC+03:00"
        },
        {
          "value": "+04:00",
          "label": "UTC+04:00"
        },
        {
          "value": "+05:00",
          "label": "UTC+05:00"
        },
        {
          "value": "+06:00",
          "label": "UTC+06:00"
        },
        {
          "value": "+07:00",
          "label": "UTC+07:00"
        },
        {
          "value": "+08:00",
          "label": "UTC+08:00"
        },
        {
          "value": "+09:00",
          "label": "UTC+09:00"
        },
        {
          "value": "+10:00",
          "label": "UTC+10:00"
        },
        {
          "value": "+11:00",
          "label": "UTC+11:00"
        },
        {
          "value": "+12:00",
          "label": "UTC+12:00"
        }
      ]
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "Countdown complete."
    },
    {
      "type": "text",
      "id": "timer_aria_label",
      "label": "Timer accessibility label",
      "default": "Countdown timer"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Minutes label",
      "default": "Min"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Seconds label",
      "default": "Sec"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "banner",
          "label": "Banner"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
