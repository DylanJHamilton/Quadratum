{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-ugc-showcase
    qtm-ugc-showcase-{{ block_id }}
    qtm-ugc-showcase--width-{{ block_width }}
    qtm-ugc-showcase--align-{{ block_alignment }}
    qtm-ugc-showcase--layout-{{ block.settings.layout_style }}
    qtm-ugc-showcase--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-ugc-showcase--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-ugc-showcase--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-ugc-showcase--hide-mobile{% endunless %}
  "
  style="
    --qtm-ugc-margin-top: {{ block.settings.margin_top }}px;
    --qtm-ugc-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-ugc-padding: {{ block.settings.padding }}px;
    --qtm-ugc-gap: {{ block.settings.gap }}px;
    --qtm-ugc-heading-color: {{ block.settings.heading_color }};
    --qtm-ugc-text-color: {{ block.settings.text_color }};
    --qtm-ugc-background-color: {{ block.settings.background_color }};
    --qtm-ugc-border-color: {{ block.settings.border_color }};
    --qtm-ugc-link-color: {{ block.settings.link_color }};
    --qtm-ugc-card-background: {{ block.settings.card_background_color }};
    --qtm-ugc-star-color: {{ block.settings.star_color }};
    --qtm-ugc-overlay-color: {{ block.settings.overlay_color }};
    --qtm-ugc-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --qtm-ugc-border-width: {{ block.settings.border_width }}px;
    --qtm-ugc-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-ugc-showcase__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank or block.settings.cta_text != blank %}
      <div class="qtm-ugc-showcase__header">
        <div class="qtm-ugc-showcase__header-copy">
          {% if block.settings.eyebrow != blank %}
            <p class="qtm-ugc-showcase__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="qtm-ugc-showcase__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="qtm-ugc-showcase__text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
          <a class="qtm-ugc-showcase__header-link" href="{{ block.settings.cta_url }}">
            {{ block.settings.cta_text | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-ugc-showcase__items" role="list">
      {% for i in (1..6) %}
        {% liquid
          assign show_key = 'show_item_' | append: i
          assign media_type_key = 'item_' | append: i | append: '_media_type'
          assign image_key = 'item_' | append: i | append: '_image'
          assign video_key = 'item_' | append: i | append: '_video'
          assign external_video_url_key = 'item_' | append: i | append: '_external_video_url'
          assign review_key = 'item_' | append: i | append: '_review'
          assign customer_key = 'item_' | append: i | append: '_customer'
          assign handle_key = 'item_' | append: i | append: '_handle'
          assign rating_key = 'item_' | append: i | append: '_rating'
          assign product_key = 'item_' | append: i | append: '_product'
          assign link_key = 'item_' | append: i | append: '_link'
          assign link_text_key = 'item_' | append: i | append: '_link_text'

          assign show_item = block.settings[show_key]
          assign media_type = block.settings[media_type_key]
          assign item_image = block.settings[image_key]
          assign item_video = block.settings[video_key]
          assign external_video_url = block.settings[external_video_url_key]
          assign review = block.settings[review_key]
          assign customer = block.settings[customer_key]
          assign handle = block.settings[handle_key]
          assign rating = block.settings[rating_key] | plus: 0
          assign product = block.settings[product_key]
          assign item_link = block.settings[link_key]
          assign item_link_text = block.settings[link_text_key]

          assign final_link = item_link
          if final_link == blank and product != blank
            assign final_link = product.url
          endif

          if item_link_text == blank and product != blank
            assign item_link_text = 'Shop product'
          elsif item_link_text == blank
            assign item_link_text = 'View more'
          endif
        %}

        {% if show_item %}
          <article class="qtm-ugc-showcase__card qtm-ugc-showcase__card--{{ i }}" role="listitem">
            <div class="qtm-ugc-showcase__media">
              {% if media_type == 'video' and item_video != blank %}
                {{
                  item_video
                  | video_tag:
                    class: 'qtm-ugc-showcase__video',
                    image_size: '900x',
                    autoplay: block.settings.autoplay_videos,
                    loop: true,
                    muted: true,
                    controls: block.settings.show_video_controls
                }}
              {% elsif media_type == 'external_video' and external_video_url != blank %}
                <a class="qtm-ugc-showcase__external-video" href="{{ external_video_url }}" target="_blank" rel="noopener">
                  {% if item_image != blank %}
                    {{
                      item_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'qtm-ugc-showcase__image',
                        loading: 'lazy',
                        widths: '375, 550, 750, 950, 1200',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        alt: item_image.alt
                    }}
                  {% else %}
                    <div class="qtm-ugc-showcase__placeholder">
                      {{ 'image' | placeholder_svg_tag: 'qtm-ugc-showcase__placeholder-svg' }}
                    </div>
                  {% endif %}

                  <span class="qtm-ugc-showcase__play-badge" aria-hidden="true">
                    ▶
                  </span>

                  <span class="visually-hidden">
                    Open customer video
                  </span>
                </a>
              {% elsif item_image != blank %}
                {{
                  item_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'qtm-ugc-showcase__image',
                    loading: 'lazy',
                    widths: '375, 550, 750, 950, 1200',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: item_image.alt
                }}
              {% else %}
                <div class="qtm-ugc-showcase__placeholder">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'qtm-ugc-showcase__placeholder-svg' }}
                </div>
              {% endif %}

              {% if block.settings.enable_overlay %}
                <div class="qtm-ugc-showcase__overlay" aria-hidden="true"></div>
              {% endif %}

              {% if media_type == 'video' and item_video != blank and block.settings.show_video_label %}
                <span class="qtm-ugc-showcase__media-label">
                  Video
                </span>
              {% endif %}
            </div>

            <div class="qtm-ugc-showcase__content">
              {% if block.settings.show_ratings and rating > 0 %}
                <div class="qtm-ugc-showcase__rating" aria-label="{{ rating }} out of 5 stars">
                  {% for star in (1..5) %}
                    <span class="{% if star <= rating %}is-filled{% endif %}" aria-hidden="true">★</span>
                  {% endfor %}
                </div>
              {% endif %}

              {% if review != blank %}
                <div class="qtm-ugc-showcase__review">
                  {{ review }}
                </div>
              {% endif %}

              {% if customer != blank or handle != blank %}
                <div class="qtm-ugc-showcase__attribution">
                  {% if customer != blank %}
                    <strong>{{ customer | escape }}</strong>
                  {% endif %}

                  {% if handle != blank %}
                    <span>{{ handle | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}

              {% if product != blank and block.settings.show_product_reference %}
                <a class="qtm-ugc-showcase__product" href="{{ product.url }}">
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 180
                      | image_tag:
                        class: 'qtm-ugc-showcase__product-image',
                        loading: 'lazy',
                        widths: '90, 140, 180',
                        sizes: '54px',
                        alt: product.featured_image.alt
                    }}
                  {% endif %}

                  <span class="qtm-ugc-showcase__product-content">
                    <span class="qtm-ugc-showcase__product-label">
                      {{ block.settings.product_label | escape }}
                    </span>
                    <span class="qtm-ugc-showcase__product-title">
                      {{ product.title | escape }}
                    </span>
                  </span>
                </a>
              {% endif %}

              {% if final_link != blank and block.settings.show_item_links %}
                <a class="qtm-ugc-showcase__item-link" href="{{ final_link }}">
                  {{ item_link_text | escape }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .qtm-ugc-showcase-{{ block_id }} {
    margin-top: var(--qtm-ugc-margin-top);
    margin-bottom: var(--qtm-ugc-margin-bottom);
    padding: var(--qtm-ugc-padding);
    color: var(--qtm-ugc-text-color);
    background: var(--qtm-ugc-background-color);
    border: var(--qtm-ugc-border-width) solid var(--qtm-ugc-border-color);
    border-radius: var(--qtm-ugc-border-radius);
  }

  .qtm-ugc-showcase-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--width-auto {
    width: auto;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--width-small {
    max-width: 720px;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--width-medium {
    max-width: 980px;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--width-large {
    max-width: 1240px;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__inner {
    display: grid;
    gap: var(--qtm-ugc-gap);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__header-copy {
    display: grid;
    gap: 0.75rem;
    max-width: 780px;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--align-center .qtm-ugc-showcase__header-copy {
    margin-inline: auto;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--align-right .qtm-ugc-showcase__header-copy {
    margin-left: auto;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__eyebrow {
    margin: 0;
    color: var(--qtm-ugc-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__heading {
    margin: 0;
    color: var(--qtm-ugc-heading-color);
    line-height: 1.05;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__text {
    color: var(--qtm-ugc-text-color);
    line-height: 1.7;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__text p,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__review p {
    margin-top: 0;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__text p:last-child,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__review p:last-child {
    margin-bottom: 0;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__header-link,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__item-link {
    display: inline-flex;
    width: fit-content;
    color: var(--qtm-ugc-link-color);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 180ms ease;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__header-link:hover,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__item-link:hover {
    opacity: 0.72;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__header-link:focus-visible,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__item-link:focus-visible,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__product:focus-visible,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__external-video:focus-visible {
    outline: 3px solid var(--qtm-ugc-link-color);
    outline-offset: 4px;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__items {
    display: grid;
    gap: var(--qtm-ugc-gap);
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-grid .qtm-ugc-showcase__items {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-masonry .qtm-ugc-showcase__items {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-row .qtm-ugc-showcase__items {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.35rem;
    scrollbar-width: thin;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-row .qtm-ugc-showcase__card {
    flex: 0 0 min(82vw, 360px);
    scroll-snap-align: start;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__card {
    display: grid;
    overflow: hidden;
    color: var(--qtm-ugc-text-color);
    background: var(--qtm-ugc-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-ugc-border-color), transparent 10%);
    border-radius: calc(var(--qtm-ugc-border-radius) * 0.8);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
    text-align: left;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-masonry .qtm-ugc-showcase__card:nth-child(2n) .qtm-ugc-showcase__image,
  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-masonry .qtm-ugc-showcase__card:nth-child(2n) .qtm-ugc-showcase__video,
  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--layout-masonry .qtm-ugc-showcase__card:nth-child(2n) .qtm-ugc-showcase__placeholder {
    min-height: calc({{ block.settings.media_height }}px + 70px);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: color-mix(in srgb, var(--qtm-ugc-text-color), transparent 94%);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__image,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__video,
  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__placeholder {
    display: block;
    width: 100%;
    min-height: {{ block.settings.media_height }}px;
    aspect-ratio: {{ block.settings.media_aspect_ratio }};
    object-fit: cover;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__image {
    height: 100%;
    transition: transform 520ms ease;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__card:hover .qtm-ugc-showcase__image {
    transform: scale(1.035);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__placeholder {
    display: grid;
    place-items: center;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.24;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__external-video {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__play-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: #111111;
    background: #ffffff;
    border-radius: 999px;
    font-size: 1rem;
    line-height: 1;
    transform: translate(-50%, -50%);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.18);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--qtm-ugc-overlay-color);
    opacity: var(--qtm-ugc-overlay-opacity);
    pointer-events: none;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__media-label {
    position: absolute;
    left: 0.8rem;
    top: 0.8rem;
    z-index: 2;
    display: inline-flex;
    padding: 0.35rem 0.55rem;
    color: #111111;
    background: #ffffff;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__content {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__rating {
    display: inline-flex;
    gap: 0.12rem;
    color: color-mix(in srgb, var(--qtm-ugc-star-color), transparent 75%);
    font-size: 0.95rem;
    line-height: 1;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__rating .is-filled {
    color: var(--qtm-ugc-star-color);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__review {
    color: var(--qtm-ugc-text-color);
    line-height: 1.6;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__attribution {
    display: grid;
    gap: 0.15rem;
    color: var(--qtm-ugc-text-color);
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__attribution strong {
    color: var(--qtm-ugc-heading-color);
    line-height: 1.25;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__attribution span {
    font-size: 0.88rem;
    opacity: 0.72;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__product {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    padding: 0.65rem;
    color: var(--qtm-ugc-text-color);
    background: color-mix(in srgb, var(--qtm-ugc-card-background), var(--qtm-ugc-text-color) 4%);
    border: 1px solid color-mix(in srgb, var(--qtm-ugc-border-color), transparent 18%);
    border-radius: calc(var(--qtm-ugc-border-radius) * 0.42);
    text-decoration: none;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__product-image {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: calc(var(--qtm-ugc-border-radius) * 0.28);
    object-fit: cover;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__product-content {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__product-label {
    color: var(--qtm-ugc-link-color);
    font-size: 0.66rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .qtm-ugc-showcase-{{ block_id }} .qtm-ugc-showcase__product-title {
    overflow: hidden;
    color: var(--qtm-ugc-heading-color);
    font-weight: 750;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--animation-fade {
    animation: qtm-ugc-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--animation-fade-up {
    animation: qtm-ugc-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--animation-fade-down {
    animation: qtm-ugc-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--animation-fade-left {
    animation: qtm-ugc-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--animation-fade-right {
    animation: qtm-ugc-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-ugc-showcase-{{ block_id }}.qtm-ugc-showcase--animation-zoom {
    animation: qtm-ugc-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-ugc-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-ugc-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
