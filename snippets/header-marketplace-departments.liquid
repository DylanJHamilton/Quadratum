{% liquid
  assign button_label = section_settings.department_button_label | default: 'All Departments'
  assign display_mode = section_settings.department_display | default: 'flyout'
%}

<div class="qtmHeaderFive__departments qtmHeaderFive__departments--{{ display_mode }}">
  <button
    type="button"
    class="qtmHeaderFive__departmentsButton"
    aria-expanded="false"
    aria-controls="HeaderFiveDepartments-{{ section_id }}"
    data-qtm-h5-departments-toggle
  >
    <span class="qtmHeaderFive__departmentsIcon" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span>{{ button_label }}</span>
  </button>

  <div
    id="HeaderFiveDepartments-{{ section_id }}"
    class="qtmHeaderFive__departmentsPanel"
    hidden
    data-qtm-h5-departments-panel
  >
    <div class="qtmHeaderFive__departmentsInner">
      <div class="qtmHeaderFive__departmentsMenu">
        {% if menu != blank %}
          {% for link in menu.links %}
            <div class="qtmHeaderFive__departmentItem">
              <a
                class="qtmHeaderFive__departmentLink{% if link.active or link.child_active %} qtmHeaderFive__departmentLink--active{% endif %}"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                <span>{{ link.title }}</span>
                {% if link.links != blank %}
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% endif %}
              </a>

              {% if link.links != blank %}
                <div class="qtmHeaderFive__departmentChildren">
                  {% for child_link in link.links %}
                    <a
                      class="qtmHeaderFive__departmentChild{% if child_link.active %} qtmHeaderFive__departmentChild--active{% endif %}"
                      href="{{ child_link.url }}"
                      {% if child_link.active %}aria-current="page"{% endif %}
                    >
                      {{ child_link.title }}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>

      {% for block in blocks %}
        {% if block.type == 'promo_block' %}
          <div class="qtmHeaderFive__departmentPromo" {{ block.shopify_attributes }}>
            {% if block.settings.eyebrow != blank %}
              <span class="qtmHeaderFive__departmentPromoEyebrow">{{ block.settings.eyebrow }}</span>
            {% endif %}

            {% if block.settings.heading != blank %}
              <strong class="qtmHeaderFive__departmentPromoHeading">{{ block.settings.heading }}</strong>
            {% endif %}

            {% if block.settings.link_label != blank and block.settings.link_url != blank %}
              <a class="qtmHeaderFive__departmentPromoLink" href="{{ block.settings.link_url }}">
                {{ block.settings.link_label }}
              </a>
            {% endif %}
          </div>
          {% break %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>