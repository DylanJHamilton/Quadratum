{%- liquid
  assign block_id = 'content-featured-product-' | append: block.id

  assign product_context = product
  assign selected_product = block.settings.product

  if block.settings.product_source == 'current' and product_context != blank
    assign featured_product = product_context
  elsif selected_product != blank
    assign featured_product = selected_product
  elsif product_context != blank
    assign featured_product = product_context
  else
    assign featured_product = blank
  endif

  if featured_product != blank
    assign current_variant = featured_product.selected_or_first_available_variant
    assign featured_media = current_variant.featured_media | default: featured_product.featured_media
    assign is_on_sale = false

    if current_variant.compare_at_price > current_variant.price
      assign is_on_sale = true
    endif
  endif

  assign featured_layout = block.settings.featured_layout | default: 'standard'
  assign media_position = block.settings.media_position | default: 'left'
  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-featured-product
    content-featured-product--{{ featured_layout }}
    content-featured-product--media-{{ media_position }}
    content-featured-product--width-{{ width }}
    content-featured-product--align-{{ alignment }}
    {% unless show_on_desktop %} content-featured-product--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-featured-product--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-featured-product--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-featured-product--animate content-featured-product--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-featured-product-margin-top: {{ block.settings.margin_top }}px;
    --content-featured-product-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-featured-product-padding: {{ block.settings.padding }}px;
    --content-featured-product-gap: {{ block.settings.layout_gap }}px;
    --content-featured-product-content-gap: {{ block.settings.content_gap }}px;
    --content-featured-product-card-padding: {{ block.settings.card_padding }}px;
    --content-featured-product-radius: {{ block.settings.card_radius }}px;
    --content-featured-product-media-radius: {{ block.settings.media_radius }}px;
    --content-featured-product-border-width: {{ block.settings.border_width }}px;
    --content-featured-product-media-ratio: {{ block.settings.media_ratio | divided_by: 100.0 }};
    --content-featured-product-heading-color: {{ block.settings.heading_color }};
    --content-featured-product-text-color: {{ block.settings.text_color }};
    --content-featured-product-price-color: {{ block.settings.price_color }};
    --content-featured-product-sale-color: {{ block.settings.sale_color }};
    --content-featured-product-background: {{ block.settings.background_color }};
    --content-featured-product-card-background: {{ block.settings.card_background_color }};
    --content-featured-product-border-color: {{ block.settings.border_color }};
    --content-featured-product-button-background: {{ block.settings.button_background_color }};
    --content-featured-product-button-text: {{ block.settings.button_text_color }};
    --content-featured-product-secondary-button-background: {{ block.settings.secondary_button_background_color }};
    --content-featured-product-secondary-button-text: {{ block.settings.secondary_button_text_color }};
    --content-featured-product-focus-color: {{ block.settings.focus_color }};
  "
  {% if featured_product != blank %}
    data-product-id="{{ featured_product.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-featured-product
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-featured-product-margin-top);
      margin-bottom: var(--content-featured-product-margin-bottom);
      padding: var(--content-featured-product-padding);
      color: var(--content-featured-product-text-color);
      background: var(--content-featured-product-background);
    }

    #{{ block_id }}.content-featured-product--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-featured-product--width-small {
      max-width: 920px;
    }

    #{{ block_id }}.content-featured-product--width-medium {
      max-width: 1120px;
    }

    #{{ block_id }}.content-featured-product--width-large {
      max-width: 1360px;
    }

    #{{ block_id }}.content-featured-product--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-featured-product--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-featured-product--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-featured-product--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-featured-product__shell {
      display: grid;
      min-width: 0;
      color: var(--content-featured-product-text-color);
    }

    #{{ block_id }}.content-featured-product--standard .content-featured-product__shell,
    #{{ block_id }}.content-featured-product--promotion .content-featured-product__shell {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--content-featured-product-gap);
      align-items: center;
      padding: var(--content-featured-product-card-padding);
      background: var(--content-featured-product-card-background);
      border: var(--content-featured-product-border-width) solid var(--content-featured-product-border-color);
      border-radius: var(--content-featured-product-radius);
      overflow: hidden;
    }

    #{{ block_id }}.content-featured-product--hero .content-featured-product__shell {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: var(--content-featured-product-gap);
      align-items: center;
      padding: var(--content-featured-product-card-padding);
      background: var(--content-featured-product-card-background);
      border: var(--content-featured-product-border-width) solid var(--content-featured-product-border-color);
      border-radius: var(--content-featured-product-radius);
      overflow: hidden;
    }

    #{{ block_id }}.content-featured-product--media-right .content-featured-product__media-column {
      order: 2;
    }

    #{{ block_id }}.content-featured-product--media-right .content-featured-product__content {
      order: 1;
    }

    #{{ block_id }} .content-featured-product__media-column {
      display: grid;
      gap: 12px;
      min-width: 0;
    }

    #{{ block_id }} .content-featured-product__media-frame {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: var(--content-featured-product-media-radius);
      aspect-ratio: var(--content-featured-product-media-ratio);
    }

    #{{ block_id }} .content-featured-product__media-frame img,
    #{{ block_id }} .content-featured-product__media-frame video,
    #{{ block_id }} .content-featured-product__media-frame iframe,
    #{{ block_id }} .content-featured-product__media-frame model-viewer,
    #{{ block_id }} .content-featured-product__placeholder {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: {{ block.settings.image_fit }};
    }

    #{{ block_id }} .content-featured-product__media-frame iframe,
    #{{ block_id }} .content-featured-product__media-frame model-viewer {
      border: 0;
    }

    #{{ block_id }} .content-featured-product__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .content-featured-product__media {
      display: none;
      width: 100%;
      height: 100%;
    }

    #{{ block_id }} .content-featured-product__media.is-active {
      display: block;
    }

    #{{ block_id }} .content-featured-product__badge {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 11px;
      color: #ffffff;
      background: var(--content-featured-product-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .content-featured-product__thumbnails {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    #{{ block_id }} .content-featured-product__thumbnail {
      appearance: none;
      position: relative;
      flex: 0 0 {{ block.settings.thumbnail_size }}px;
      width: {{ block.settings.thumbnail_size }}px;
      height: {{ block.settings.thumbnail_size }}px;
      padding: 0;
      overflow: hidden;
      background: #f6f6f6;
      border: 1px solid var(--content-featured-product-border-color);
      border-radius: {{ block.settings.thumbnail_radius }}px;
      cursor: pointer;
    }

    #{{ block_id }} .content-featured-product__thumbnail.is-active {
      border-color: var(--content-featured-product-focus-color);
      box-shadow: 0 0 0 1px var(--content-featured-product-focus-color);
    }

    #{{ block_id }} .content-featured-product__thumbnail:focus-visible {
      outline: 2px solid var(--content-featured-product-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-featured-product__thumbnail img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #{{ block_id }} .content-featured-product__content {
      display: grid;
      gap: var(--content-featured-product-content-gap);
      min-width: 0;
      max-width: 720px;
    }

    #{{ block_id }}.content-featured-product--align-center .content-featured-product__content {
      justify-items: center;
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-featured-product--align-right .content-featured-product__content {
      justify-items: end;
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-featured-product__eyebrow {
      margin: 0;
      color: var(--content-featured-product-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-featured-product__title {
      margin: 0;
      color: var(--content-featured-product-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.05;
    }

    #{{ block_id }} .content-featured-product__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .content-featured-product__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.14em;
    }

    #{{ block_id }} .content-featured-product__vendor {
      color: var(--content-featured-product-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.68;
    }

    #{{ block_id }} .content-featured-product__description {
      margin: 0;
      color: var(--content-featured-product-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.6;
      opacity: 0.88;
    }

    #{{ block_id }} .content-featured-product__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 9px;
      color: var(--content-featured-product-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.content-featured-product--align-center .content-featured-product__price-row {
      justify-content: center;
    }

    #{{ block_id }}.content-featured-product--align-right .content-featured-product__price-row {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-featured-product__price {
      color: var(--content-featured-product-price-color);
      font-size: {{ block.settings.price_size }}px;
      font-weight: 800;
    }

    #{{ block_id }} .content-featured-product__compare {
      color: var(--content-featured-product-text-color);
      font-size: calc({{ block.settings.price_size }}px * 0.82);
      text-decoration: line-through;
      opacity: 0.55;
    }

    #{{ block_id }} .content-featured-product__form {
      display: grid;
      gap: 12px;
      width: 100%;
      max-width: {{ block.settings.form_width }}px;
      margin: 0;
    }

    #{{ block_id }}.content-featured-product--align-center .content-featured-product__form {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-featured-product--align-right .content-featured-product__form {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-featured-product__quantity {
      display: inline-grid;
      gap: 6px;
      text-align: left;
    }

    #{{ block_id }} .content-featured-product__quantity-label {
      color: var(--content-featured-product-text-color);
      font-size: 0.84em;
      line-height: 1.2;
      opacity: 0.76;
    }

    #{{ block_id }} .content-featured-product__quantity-input {
      width: 96px;
      min-height: 42px;
      padding: 8px 10px;
      color: var(--content-featured-product-text-color);
      background: #ffffff;
      border: 1px solid var(--content-featured-product-border-color);
      border-radius: 10px;
      font: inherit;
    }

    #{{ block_id }} .content-featured-product__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #{{ block_id }}.content-featured-product--align-center .content-featured-product__buttons {
      justify-content: center;
    }

    #{{ block_id }}.content-featured-product--align-right .content-featured-product__buttons {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-featured-product__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: {{ block.settings.button_height }}px;
      padding: 12px 18px;
      color: var(--content-featured-product-button-text);
      background: var(--content-featured-product-button-background);
      border: 1px solid var(--content-featured-product-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      cursor: pointer;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 700;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-featured-product__button--secondary {
      color: var(--content-featured-product-secondary-button-text);
      background: var(--content-featured-product-secondary-button-background);
      border-color: var(--content-featured-product-border-color);
    }

    #{{ block_id }} .content-featured-product__button:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-featured-product__button[disabled] {
      cursor: not-allowed;
      opacity: 0.48;
      transform: none;
    }

    #{{ block_id }} .content-featured-product__title a:focus-visible,
    #{{ block_id }} .content-featured-product__button:focus-visible,
    #{{ block_id }} .content-featured-product__quantity-input:focus-visible {
      outline: 2px solid var(--content-featured-product-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-featured-product__empty {
      padding: 18px;
      color: var(--content-featured-product-text-color);
      background: var(--content-featured-product-card-background);
      border: var(--content-featured-product-border-width) solid var(--content-featured-product-border-color);
      border-radius: var(--content-featured-product-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-featured-product--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-featured-product--animate-fade {
      animation-name: contentFeaturedProductFade;
    }

    #{{ block_id }}.content-featured-product--animate-fade_up {
      animation-name: contentFeaturedProductFadeUp;
    }

    #{{ block_id }}.content-featured-product--animate-zoom {
      animation-name: contentFeaturedProductZoom;
    }

    @keyframes contentFeaturedProductFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentFeaturedProductFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentFeaturedProductZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-featured-product--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-featured-product--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-featured-product--standard .content-featured-product__shell,
      #{{ block_id }}.content-featured-product--hero .content-featured-product__shell,
      #{{ block_id }}.content-featured-product--promotion .content-featured-product__shell {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-featured-product--media-right .content-featured-product__media-column,
      #{{ block_id }}.content-featured-product--media-right .content-featured-product__content {
        order: initial;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-featured-product--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-featured-product--standard .content-featured-product__shell,
      #{{ block_id }}.content-featured-product--hero .content-featured-product__shell,
      #{{ block_id }}.content-featured-product--promotion .content-featured-product__shell {
        grid-template-columns: minmax(0, 1fr);
        padding: max(calc(var(--content-featured-product-card-padding) - 8px), 0px);
      }

      #{{ block_id }}.content-featured-product--media-right .content-featured-product__media-column,
      #{{ block_id }}.content-featured-product--media-right .content-featured-product__content {
        order: initial;
      }

      #{{ block_id }} .content-featured-product__title {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .content-featured-product__buttons {
        display: grid;
      }

      #{{ block_id }} .content-featured-product__button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-featured-product--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-featured-product__button {
        transition: none;
      }

      #{{ block_id }} .content-featured-product__button:hover {
        transform: none;
      }
    }
  </style>

  {% if featured_product != blank %}
    <div class="content-featured-product__shell">
      <div class="content-featured-product__media-column">
        <div class="content-featured-product__media-frame" data-content-featured-product-media-frame>
          {% if featured_product.media.size > 0 %}
            {% for media in featured_product.media limit: block.settings.gallery_limit %}
              <div
                class="content-featured-product__media {% if media.id == featured_media.id or forloop.first and featured_media == blank %}is-active{% endif %}"
                data-content-featured-product-media
                data-media-id="{{ media.id }}"
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {% if forloop.first %}
                      {{ media | image_url: width: 1600 | image_tag: loading: 'eager', widths: '400, 600, 800, 1000, 1200, 1600', alt: media.alt | default: featured_product.title }}
                    {% else %}
                      {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1600', alt: media.alt | default: featured_product.title }}
                    {% endif %}
                  {% when 'video' %}
                    {{ media | video_tag: image_size: '1200x', controls: true, muted: true, playsinline: true }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag }}
                {% endcase %}
              </div>
            {% endfor %}
          {% elsif featured_product.featured_image %}
            {{ featured_product.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '400, 600, 800, 1000, 1200, 1600', alt: featured_product.featured_image.alt | default: featured_product.title }}
          {% else %}
            <span class="content-featured-product__placeholder" aria-hidden="true"></span>
          {% endif %}

          {% if block.settings.show_sale_badge and is_on_sale %}
            <span class="content-featured-product__badge">
              {{ block.settings.sale_badge_text | escape }}
            </span>
          {% endif %}
        </div>

        {% if block.settings.show_gallery and featured_product.media.size > 1 %}
          <div class="content-featured-product__thumbnails" aria-label="{{ block.settings.gallery_label | escape }}">
            {% for media in featured_product.media limit: block.settings.gallery_limit %}
              <button
                type="button"
                class="content-featured-product__thumbnail {% if media.id == featured_media.id or forloop.first and featured_media == blank %}is-active{% endif %}"
                data-content-featured-product-thumbnail
                data-media-id="{{ media.id }}"
                aria-label="{{ block.settings.view_media_label | escape }} {{ forloop.index }}"
              >
                {% if media.preview_image %}
                  {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: media.alt | default: featured_product.title }}
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="content-featured-product__content">
        {% if block.settings.eyebrow != blank %}
          <p class="content-featured-product__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.show_vendor and featured_product.vendor != blank %}
          <div class="content-featured-product__vendor">
            {{ featured_product.vendor | escape }}
          </div>
        {% endif %}

        <h2 class="content-featured-product__title">
          <a href="{{ featured_product.url }}">
            {{ featured_product.title | escape }}
          </a>
        </h2>

        {% if block.settings.show_price %}
          <div class="content-featured-product__price-row">
            <span class="content-featured-product__price">
              {{ current_variant.price | money }}
            </span>

            {% if is_on_sale %}
              <span class="content-featured-product__compare">
                {{ current_variant.compare_at_price | money }}
              </span>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_description %}
          <div class="content-featured-product__description">
            {% if block.settings.description_source == 'custom' %}
              {{ block.settings.custom_description | escape }}
            {% else %}
              {{ featured_product.description | strip_html | truncatewords: block.settings.description_words }}
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_atc %}
          {% form 'product', featured_product, class: 'content-featured-product__form', data-product-form: '', data-ajax-cart-form: '', data-cart-add-form: '' %}
            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              data-content-featured-product-variant-input
            >

            {% if block.settings.show_quantity %}
              <label class="content-featured-product__quantity">
                <span class="content-featured-product__quantity-label">
                  {{ block.settings.quantity_label | escape }}
                </span>
                <input
                  class="content-featured-product__quantity-input"
                  type="number"
                  name="quantity"
                  min="1"
                  value="1"
                  inputmode="numeric"
                >
              </label>
            {% else %}
              <input type="hidden" name="quantity" value="1">
            {% endif %}

            <div class="content-featured-product__buttons">
              <button
                type="submit"
                class="content-featured-product__button"
                data-add-to-cart
                data-ajax-cart-submit
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {% if current_variant.available %}
                  {{ block.settings.atc_label | escape }}
                {% else %}
                  {{ block.settings.sold_out_label | escape }}
                {% endif %}
              </button>

              {% if block.settings.show_secondary_button %}
                <a class="content-featured-product__button content-featured-product__button--secondary" href="{{ featured_product.url }}">
                  {{ block.settings.secondary_button_label | escape }}
                </a>
              {% endif %}
            </div>
          {% endform %}
        {% else %}
          {% if block.settings.show_secondary_button %}
            <div class="content-featured-product__buttons">
              <a class="content-featured-product__button content-featured-product__button--secondary" href="{{ featured_product.url }}">
                {{ block.settings.secondary_button_label | escape }}
              </a>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <script type="application/json" data-content-featured-product-variants>
      {{ featured_product.variants | json }}
    </script>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.contentFeaturedProductReady === 'true') return;

        root.dataset.contentFeaturedProductReady = 'true';

        const mediaItems = Array.from(root.querySelectorAll('[data-content-featured-product-media]'));
        const thumbnails = Array.from(root.querySelectorAll('[data-content-featured-product-thumbnail]'));
        const variantInput = root.querySelector('[data-content-featured-product-variant-input]');
        const variantsJson = root.querySelector('[data-content-featured-product-variants]');

        let variants = [];

        try {
          variants = JSON.parse(variantsJson ? variantsJson.textContent || '[]' : '[]');
        } catch (error) {
          variants = [];
        }

        const setActiveMedia = (mediaId) => {
          if (!mediaId) return;

          mediaItems.forEach((item) => {
            item.classList.toggle('is-active', String(item.dataset.mediaId) === String(mediaId));
          });

          thumbnails.forEach((thumbnail) => {
            const active = String(thumbnail.dataset.mediaId) === String(mediaId);
            thumbnail.classList.toggle('is-active', active);
            thumbnail.setAttribute('aria-current', active ? 'true' : 'false');
          });

          root.querySelectorAll('video').forEach((video) => {
            if (!video.paused) video.pause();
          });
        };

        thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            setActiveMedia(thumbnail.dataset.mediaId);
          });
        });

        document.addEventListener('variant:change', (event) => {
          const detail = event.detail || {};
          const variant = detail.variant || variants.find((item) => String(item.id) === String(detail.variantId || detail.variant_id || detail.id));

          if (!variant) return;

          if (variantInput) {
            variantInput.value = variant.id;
          }

          root.dataset.variantId = String(variant.id);

          if (variant.featured_media && variant.featured_media.id) {
            setActiveMedia(variant.featured_media.id);
          }
        });

        document.addEventListener('qtm:variant:change', (event) => {
          const detail = event.detail || {};
          const variant = detail.variant || variants.find((item) => String(item.id) === String(detail.variantId || detail.variant_id || detail.id));

          if (!variant) return;

          if (variantInput) {
            variantInput.value = variant.id;
          }

          root.dataset.variantId = String(variant.id);

          if (variant.featured_media && variant.featured_media.id) {
            setActiveMedia(variant.featured_media.id);
          }
        });
      })();
    </script>
  {% elsif block.settings.show_empty_state %}
    <div class="content-featured-product__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

