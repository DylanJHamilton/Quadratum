{%- liquid
  assign font_display = settings.font_loading | default: 'swap'
  unless font_display == 'fallback'
    assign font_display = 'swap'
  endunless
-%}
<style data-quadratum-fonts>
  {%- if settings.font_heading != blank -%}
    {{ settings.font_heading | font_face: font_display: font_display }}
  {%- endif -%}
  {%- if settings.font_body != blank and settings.font_body != settings.font_heading -%}
    {{ settings.font_body | font_face: font_display: font_display }}
  {%- endif -%}
</style>
