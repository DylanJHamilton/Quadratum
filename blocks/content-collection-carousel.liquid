{%- liquid
  assign block_id = 'content-collection-carousel-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign collection_source = block.settings.collection_source | default: 'manual'
  assign selected_collection = block.settings.collection
  assign carousel_layout = block.settings.carousel_layout | default: 'carousel'
  assign collection_limit = block.settings.collection_limit | default: 8

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{%- assign rendered_collections = 0 -%}
{%- capture collection_cards -%}
  {%- if collection_source == 'featured' and selected_collection != blank -%}
    {%- assign rendered_collections = 1 -%}
    <div class="content-collection-carousel__slide q-carousel__slide">{%- render 'qtm-block-collection-card', card_collection: selected_collection, block: block, prefix: 'content-collection-carousel' -%}</div>
  {%- else -%}
    {%- for card_collection in block.settings.collections limit: collection_limit -%}
      {%- if card_collection != blank and card_collection.url != blank -%}
        {%- assign rendered_collections = rendered_collections | plus: 1 -%}
        <div class="content-collection-carousel__slide q-carousel__slide">{%- render 'qtm-block-collection-card', card_collection: card_collection, block: block, prefix: 'content-collection-carousel' -%}</div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  id="{{ block_id }}"
  class="
    content-collection-carousel
    content-collection-carousel--{{ carousel_layout }}
    content-collection-carousel--width-{{ width }}
    content-collection-carousel--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} content-collection-carousel--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} content-collection-carousel--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} content-collection-carousel--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} content-collection-carousel--animate content-collection-carousel--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-collection-carousel-margin-top: {{ block.settings.margin_top }}px;
    --content-collection-carousel-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-collection-carousel-padding: {{ block.settings.padding }}px;
    --content-collection-carousel-gap: {{ block.settings.slide_gap }}px;
    --content-collection-carousel-card-padding: {{ block.settings.card_padding }}px;
    --content-collection-carousel-card-radius: {{ block.settings.card_radius }}px;
    --content-collection-carousel-border-width: {{ block.settings.border_width }}px;
    --content-collection-carousel-columns-desktop: {{ block.settings.columns_desktop }};
    --content-collection-carousel-columns-tablet: {{ block.settings.columns_tablet }};
    --content-collection-carousel-columns-mobile: {{ block.settings.columns_mobile }};
    --content-collection-carousel-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-collection-carousel-heading-color: {{ block.settings.heading_color }};
    --content-collection-carousel-text-color: {{ block.settings.text_color }};
    --content-collection-carousel-background: {{ block.settings.background_color }};
    --content-collection-carousel-card-background: {{ block.settings.card_background_color }};
    --content-collection-carousel-border-color: {{ block.settings.border_color }};
    --content-collection-carousel-button-background: {{ block.settings.button_background_color }};
    --content-collection-carousel-button-text: {{ block.settings.button_text_color }};
    --content-collection-carousel-arrow-background: {{ block.settings.arrow_background_color }};
    --content-collection-carousel-arrow-text: {{ block.settings.arrow_text_color }};
    --content-collection-carousel-dot-color: {{ block.settings.dot_color }};
    --content-collection-carousel-dot-active: {{ block.settings.dot_active_color }};
    --content-collection-carousel-overlay-color: {{ block.settings.overlay_color }};
    --content-collection-carousel-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --content-collection-carousel-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  {% if rendered_collections == 0 and request.design_mode == false %}hidden{% endif %}
  data-content-collection-carousel
  data-q-carousel-engine="shared" data-qtm-block-carousel data-design-mode="{{ request.design_mode }}"
  data-loop="true" data-show-arrows="{{ block.settings.show_arrows }}" data-pause-hover="true" data-pause-focus="true"
  data-go-to-label="{{ block.settings.go_to_slide_label | default: 'Go to collection page' | escape }}"
  data-pause-label="{{ block.settings.pause_label | escape }}" data-resume-label="{{ block.settings.resume_label | escape }}" data-reduced-motion-label="{{ block.settings.reduced_motion_label | escape }}"
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-collection-carousel-margin-top);
      margin-bottom: var(--content-collection-carousel-margin-bottom);
      padding: min(var(--content-collection-carousel-padding), 8%);
      color: var(--content-collection-carousel-text-color);
      background: var(--content-collection-carousel-background);
    }

    #{{ block_id }}.content-collection-carousel--width-auto {
      max-width: 100%;
    }

    #{{ block_id }}.content-collection-carousel--width-small {
      max-width: min(100%, 900px);
    }

    #{{ block_id }}.content-collection-carousel--width-medium {
      max-width: min(100%, 1100px);
    }

    #{{ block_id }}.content-collection-carousel--width-large {
      max-width: min(100%, 1320px);
    }

    #{{ block_id }}.content-collection-carousel--width-full {
      max-width: 100%;
    }

    #{{ block_id }}.content-collection-carousel--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-collection-carousel--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-collection-carousel--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-collection-carousel__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-collection-carousel__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.content-collection-carousel--centered .content-collection-carousel__header-row,
    #{{ block_id }}.content-collection-carousel--align-center .content-collection-carousel__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-collection-carousel__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .content-collection-carousel__eyebrow {
      margin: 0;
      color: var(--content-collection-carousel-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-collection-carousel__heading {
      margin: 0;
      color: var(--content-collection-carousel-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-collection-carousel__description {
      margin: 0;
      color: var(--content-collection-carousel-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-collection-carousel__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .content-collection-carousel__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--content-collection-carousel-arrow-text);
      background: var(--content-collection-carousel-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-collection-carousel__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-collection-carousel__arrow:focus-visible {
      outline: 2px solid var(--content-collection-carousel-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-collection-carousel__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .content-collection-carousel__viewport {
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
    }

    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__viewport {
      overflow-x: auto;
    }

    #{{ block_id }} .content-collection-carousel__track {
      display: flex;
      gap: var(--content-collection-carousel-gap);
      overflow: visible;
      padding-bottom: 2px;
    }

    #{{ block_id }} .content-collection-carousel__track::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }} .content-collection-carousel__slide {
      flex: 0 0 calc((100% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-desktop) - 1))) / var(--content-collection-carousel-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }}.content-collection-carousel--centered .content-collection-carousel__slide {
      scroll-snap-align: center;
    }

    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__slide {
      flex-basis: calc((92% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-desktop) - 1))) / var(--content-collection-carousel-columns-desktop));
    }

    #{{ block_id }} .content-collection-carousel__card {
      position: relative;
      display: grid;
      height: 100%;
      min-width: 0;
      color: var(--content-collection-carousel-text-color);
      text-decoration: none;
      overflow: hidden;
      isolation: isolate;
      padding: min(var(--content-collection-carousel-card-padding), 8%);
      background: var(--content-collection-carousel-card-background);
      border: var(--content-collection-carousel-border-width) solid var(--content-collection-carousel-border-color);
      border-radius: var(--content-collection-carousel-card-radius);
    }

    #{{ block_id }} .content-collection-carousel__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--content-collection-carousel-card-radius) - 8px), 0px);
      aspect-ratio: var(--content-collection-carousel-image-ratio);
    }

    #{{ block_id }} .content-collection-carousel__media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--content-collection-carousel-overlay-color);
      opacity: var(--content-collection-carousel-overlay-opacity);
      pointer-events: none;
    }

    #{{ block_id }} .content-collection-carousel__media img,
    #{{ block_id }} .content-collection-carousel__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 320ms ease;
    }

    #{{ block_id }} .content-collection-carousel__card:hover .content-collection-carousel__media img {
      transform: scale(1.04);
    }

    #{{ block_id }} .content-collection-carousel__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .content-collection-carousel__content {
      display: grid;
      gap: 7px;
      min-width: 0;
      padding-top: 12px;
    }

    #{{ block_id }}.content-collection-carousel--carousel .content-collection-carousel__content,
    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__content {
      position: relative;
      grid-area: 1 / 1;
      align-self: end;
      margin: min(18px, 5%);
      z-index: 2;
      padding: 0;
      color: {{ block.settings.overlay_text_color }};
    }

    #{{ block_id }}.content-collection-carousel--centered .content-collection-carousel__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .content-collection-carousel__title {
      margin: 0;
      color: var(--content-collection-carousel-heading-color);
      font-size: {{ block.settings.collection_title_size }}px;
      line-height: 1.2;
    }

    #{{ block_id }}.content-collection-carousel--carousel .content-collection-carousel__title,
    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__title {
      color: {{ block.settings.overlay_text_color }};
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.24);
    }

    #{{ block_id }} .content-collection-carousel__meta {
      color: var(--content-collection-carousel-text-color);
      line-height: 1.35;
      font-size: 0.92em;
      opacity: 0.78;
    }

    #{{ block_id }}.content-collection-carousel--carousel .content-collection-carousel__meta,
    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__meta {
      color: {{ block.settings.overlay_text_color }};
      opacity: 0.9;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.24);
    }

    #{{ block_id }} .content-collection-carousel__copy {
      margin: 0;
      color: var(--content-collection-carousel-text-color);
      line-height: 1.5;
      font-size: 0.95em;
      opacity: 0.84;
    }

    #{{ block_id }}.content-collection-carousel--carousel .content-collection-carousel__copy,
    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__copy {
      color: {{ block.settings.overlay_text_color }};
      opacity: 0.92;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.24);
    }

    #{{ block_id }} .content-collection-carousel__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 40px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-collection-carousel-button-text);
      background: var(--content-collection-carousel-button-background);
      border: 1px solid var(--content-collection-carousel-button-background);
      border-radius: max(calc(var(--content-collection-carousel-card-radius) - 10px), 6px);
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-collection-carousel__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-collection-carousel__card:focus-visible,
    #{{ block_id }} .content-collection-carousel__button:focus-visible,
    #{{ block_id }} .content-collection-carousel__dot:focus-visible {
      outline: 2px solid var(--content-collection-carousel-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-collection-carousel__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 4px;
    }

    #{{ block_id }} .content-collection-carousel__dot {
      appearance: none;
      width: 9px;
      height: 9px;
      padding: 0;
      background: var(--content-collection-carousel-dot-color);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      opacity: 0.48;
    }

    #{{ block_id }} .content-collection-carousel__dot.is-active {
      background: var(--content-collection-carousel-dot-active);
      opacity: 1;
    }

    #{{ block_id }} .content-collection-carousel__empty {
      padding: 18px;
      color: var(--content-collection-carousel-text-color);
      background: var(--content-collection-carousel-card-background);
      border: var(--content-collection-carousel-border-width) solid var(--content-collection-carousel-border-color);
      border-radius: var(--content-collection-carousel-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-collection-carousel--animate {
      opacity: 1;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-collection-carousel--animate-fade {
      animation-name: contentCollectionCarouselFade;
    }

    #{{ block_id }}.content-collection-carousel--animate-fade_up {
      animation-name: contentCollectionCarouselFadeUp;
    }

    #{{ block_id }}.content-collection-carousel--animate-zoom {
      animation-name: contentCollectionCarouselZoom;
    }

    @keyframes contentCollectionCarouselFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentCollectionCarouselFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentCollectionCarouselZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-collection-carousel--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-collection-carousel--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-collection-carousel__slide {
        flex-basis: calc((100% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-tablet) - 1))) / var(--content-collection-carousel-columns-tablet));
      }

      #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__slide {
        flex-basis: calc((92% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-tablet) - 1))) / var(--content-collection-carousel-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-collection-carousel--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-collection-carousel__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .content-collection-carousel__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }

      #{{ block_id }} .content-collection-carousel__slide {
        flex-basis: calc((100% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-mobile) - 1))) / var(--content-collection-carousel-columns-mobile));
      }

      #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__slide {
        flex-basis: calc((92% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-mobile) - 1))) / var(--content-collection-carousel-columns-mobile));
      }

      #{{ block_id }} .content-collection-carousel__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }}.content-collection-carousel--carousel .content-collection-carousel__content,
      #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__content {
        margin: min(12px, 5%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-collection-carousel--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-collection-carousel__track {
        scroll-behavior: auto;
      }

      #{{ block_id }} .content-collection-carousel__media img,
      #{{ block_id }} .content-collection-carousel__button,
      #{{ block_id }} .content-collection-carousel__arrow {
        transition: none;
      }

      #{{ block_id }} .content-collection-carousel__card:hover .content-collection-carousel__media img,
      #{{ block_id }} .content-collection-carousel__button:hover,
      #{{ block_id }} .content-collection-carousel__arrow:hover {
        transform: none;
      }
    }

    #{{ block_id }} { min-width: 0; max-width: 100%; overflow-wrap: anywhere; container-type: inline-size; }
    #{{ block_id }}, #{{ block_id }} * { box-sizing: border-box; }
    #{{ block_id }}[hidden], #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} a, #{{ block_id }} button { max-width: 100%; overflow-wrap: anywhere; }
    #{{ block_id }} :focus-visible { outline: 2px solid var(--content-collection-carousel-focus-color); outline-offset: 3px; }
    #{{ block_id }} img { max-width: 100%; }
    #{{ block_id }} .content-collection-carousel__button { white-space: normal; min-width: 0; }

    #{{ block_id }} .content-collection-carousel__card--no-image .content-collection-carousel__title { color: var(--content-collection-carousel-heading-color); text-shadow: none; }
    #{{ block_id }} .content-collection-carousel__card--no-image .content-collection-carousel__meta,
    #{{ block_id }} .content-collection-carousel__card--no-image .content-collection-carousel__copy { color: var(--content-collection-carousel-text-color); text-shadow: none; }
    #{{ block_id }} .content-collection-carousel__card--no-image { grid-template-columns: minmax(0, 1fr); }

    #{{ block_id }} .content-collection-carousel__viewport, #{{ block_id }} .content-collection-carousel__track { min-width: 0; }
    #{{ block_id }} .content-collection-carousel__header { min-width: 0; }
    #{{ block_id }} .content-collection-carousel__controls { flex-wrap: wrap; }
    #{{ block_id }}.content-collection-carousel--align-center .content-collection-carousel__controls,
    #{{ block_id }}.content-collection-carousel--centered .content-collection-carousel__controls { justify-content: center; }
    #{{ block_id }}:dir(rtl) .content-collection-carousel__arrow span { transform: scaleX(-1); }
    #{{ block_id }} .content-collection-carousel__media { min-width: 0; }
    #{{ block_id }}.content-collection-carousel--carousel .content-collection-carousel__media,
    #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__media { grid-area: 1 / 1; height: 100%; }
    #{{ block_id }} .content-collection-carousel__dots { flex-wrap: wrap; }
    #{{ block_id }} .q-carousel__dot { width: 24px; height: 24px; border: 6px solid transparent; background-clip: padding-box; border-radius: 50%; background-color: var(--content-collection-carousel-dot-color); padding: 0; cursor: pointer; }
    #{{ block_id }} .q-carousel__dot[aria-current="true"] { background-color: var(--content-collection-carousel-dot-active); }
    #{{ block_id }} .content-collection-carousel__pause { color: var(--content-collection-carousel-arrow-text); background: var(--content-collection-carousel-arrow-background); padding: 8px 12px; min-height: 44px; border-radius: 4px; white-space: normal; }
    #{{ block_id }} .content-collection-carousel__slide { min-width: min(100%, 160px); }
    #{{ block_id }} .content-collection-carousel__card:focus-visible { outline-offset: -3px; }
    @media (prefers-reduced-motion: reduce) { #{{ block_id }} .content-collection-carousel__viewport { scroll-behavior: auto; } }
    @container (max-width: 600px) {
      #{{ block_id }} .content-collection-carousel__slide { flex-basis: calc((100% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-mobile) - 1))) / var(--content-collection-carousel-columns-mobile)); }
      #{{ block_id }}.content-collection-carousel--peek .content-collection-carousel__slide { flex-basis: calc((92% - (var(--content-collection-carousel-gap) * (var(--content-collection-carousel-columns-mobile) - 1))) / var(--content-collection-carousel-columns-mobile)); }
      #{{ block_id }} .content-collection-carousel__heading { font-size: {{ block.settings.heading_size_mobile }}px; }
    }
  </style>
<div class="content-collection-carousel__inner">
    {% if block.settings.show_header %}
      {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.description != blank %}
      <div class="content-collection-carousel__header-row"><div class="content-collection-carousel__header">
        {% if block.settings.eyebrow != blank %}<p class="content-collection-carousel__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2 class="content-collection-carousel__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<p class="content-collection-carousel__description">{{ block.settings.description | escape }}</p>{% endif %}
      </div></div>
      {% endif %}
    {% endif %}

    {% if rendered_collections > 0 %}
      {% if block.settings.show_arrows %}<div class="content-collection-carousel__controls">
        <button type="button" class="content-collection-carousel__arrow" data-q-carousel-prev hidden aria-controls="{{ block_id }}-viewport" aria-label="{{ block.settings.previous_label | default: 'Previous collections' | escape }}"><span aria-hidden="true">‹</span></button>
        <button type="button" class="content-collection-carousel__arrow" data-q-carousel-next hidden aria-controls="{{ block_id }}-viewport" aria-label="{{ block.settings.next_label | default: 'Next collections' | escape }}"><span aria-hidden="true">›</span></button>
      </div>{% endif %}
      <div id="{{ block_id }}-viewport" class="content-collection-carousel__viewport q-carousel__viewport" tabindex="0" role="region" aria-label="{{ block.settings.carousel_label | default: 'Collection carousel' | escape }}">
        <div class="content-collection-carousel__track q-carousel__track">{{ collection_cards }}</div>
      </div>
      {% if block.settings.show_dots %}<div class="content-collection-carousel__dots" data-q-carousel-dots hidden role="group" aria-label="{{ block.settings.dots_label | default: 'Collection pages' | escape }}"></div>{% endif %}
      {% if block.settings.enable_autoplay %}<button type="button" class="content-collection-carousel__pause" data-q-carousel-pause hidden aria-pressed="false">{{ block.settings.pause_label | default: 'Pause rotation' | escape }}</button>{% endif %}
    {% endif %}

    {% if rendered_collections == 0 and request.design_mode and block.settings.show_empty_state %}
      <div class="content-collection-carousel__empty" role="note">{{ block.settings.empty_text | default: 'Select collections for this block.' | escape }}</div>
    {% endif %}
  </div>
</div>

