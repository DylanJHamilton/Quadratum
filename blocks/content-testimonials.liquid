{%- liquid
  assign block_id = 'content-testimonials-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'cards'
  assign desktop_columns = block.settings.desktop_columns | default: '3'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign testimonial_count = block.settings.testimonial_count | default: 3

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-testimonials
    content-testimonials--{{ layout_style }}
    content-testimonials--width-{{ block_width }}
    content-testimonials--align-{{ text_alignment }}
    content-testimonials--desktop-{{ desktop_columns }}
    content-testimonials--mobile-{{ mobile_columns }}
    {% unless show_on_desktop %} content-testimonials--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-testimonials--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-testimonials--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-testimonials--animate content-testimonials--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-testimonials-margin-top: {{ block.settings.margin_top }}px;
    --content-testimonials-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-testimonials-padding: {{ block.settings.padding }}px;
    --content-testimonials-gap: {{ block.settings.gap }}px;
    --content-testimonials-card-padding: {{ block.settings.card_padding }}px;
    --content-testimonials-border-width: {{ block.settings.border_width }}px;
    --content-testimonials-border-radius: {{ block.settings.border_radius }}px;
    --content-testimonials-heading-color: {{ block.settings.heading_color }};
    --content-testimonials-text-color: {{ block.settings.text_color }};
    --content-testimonials-background-color: {{ block.settings.background_color }};
    --content-testimonials-card-background-color: {{ block.settings.card_background_color }};
    --content-testimonials-border-color: {{ block.settings.border_color }};
    --content-testimonials-link-color: {{ block.settings.link_color }};
    --content-testimonials-rating-color: {{ block.settings.rating_color }};
    --content-testimonials-image-size: {{ block.settings.image_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-testimonials-margin-top);
      margin-bottom: var(--content-testimonials-margin-bottom);
      padding: var(--content-testimonials-padding);
      color: var(--content-testimonials-text-color);
      background: var(--content-testimonials-background-color);
    }

    #{{ block_id }}.content-testimonials--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-testimonials--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-testimonials--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-testimonials--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-testimonials--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-testimonials--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-testimonials--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-testimonials--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-testimonials__grid {
      display: grid;
      width: 100%;
      gap: var(--content-testimonials-gap);
    }

    #{{ block_id }}.content-testimonials--desktop-1 .content-testimonials__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.content-testimonials--desktop-2 .content-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.content-testimonials--desktop-3 .content-testimonials__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.content-testimonials--desktop-4 .content-testimonials__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .content-testimonials__item {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
      color: var(--content-testimonials-text-color);
      background: var(--content-testimonials-card-background-color);
      border: var(--content-testimonials-border-width) solid var(--content-testimonials-border-color);
      border-radius: var(--content-testimonials-border-radius);
      padding: var(--content-testimonials-card-padding);
    }

    #{{ block_id }}.content-testimonials--cards .content-testimonials__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.content-testimonials--minimal .content-testimonials__item {
      background: transparent;
      border-color: transparent;
      border-radius: 0;
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }}.content-testimonials--featured .content-testimonials__item:first-child {
      grid-column: span 2;
    }

    #{{ block_id }}.content-testimonials--featured .content-testimonials__item:first-child .content-testimonials__quote {
      font-size: 1.18em;
    }

    #{{ block_id }} .content-testimonials__rating {
      display: flex;
      gap: 2px;
      color: var(--content-testimonials-rating-color);
      line-height: 1;
      letter-spacing: 0.02em;
    }

    #{{ block_id }}.content-testimonials--align-center .content-testimonials__rating {
      justify-content: center;
    }

    #{{ block_id }}.content-testimonials--align-right .content-testimonials__rating {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-testimonials__quote {
      margin: 0;
      color: var(--content-testimonials-heading-color);
      line-height: 1.6;
    }

    #{{ block_id }} .content-testimonials__author {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
      min-width: 0;
    }

    #{{ block_id }}.content-testimonials--align-center .content-testimonials__author {
      justify-content: center;
      flex-direction: column;
    }

    #{{ block_id }}.content-testimonials--align-right .content-testimonials__author {
      justify-content: flex-end;
      text-align: right;
    }

    #{{ block_id }} .content-testimonials__image {
      width: var(--content-testimonials-image-size);
      height: var(--content-testimonials-image-size);
      flex: 0 0 var(--content-testimonials-image-size);
      border-radius: 999px;
      object-fit: cover;
      display: block;
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .content-testimonials__author-content {
      display: grid;
      gap: 2px;
      min-width: 0;
    }

    #{{ block_id }} .content-testimonials__name {
      color: var(--content-testimonials-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .content-testimonials__meta {
      color: var(--content-testimonials-text-color);
      line-height: 1.4;
      opacity: 0.82;
    }

    #{{ block_id }} .content-testimonials__link {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      gap: 8px;
      color: var(--content-testimonials-link-color);
      text-decoration: none;
      line-height: 1.2;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
      transition: opacity 180ms ease;
    }

    #{{ block_id }} .content-testimonials__link:hover {
      opacity: 0.72;
    }

    #{{ block_id }}.content-testimonials--align-center .content-testimonials__link {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-testimonials--align-right .content-testimonials__link {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.content-testimonials--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-testimonials--animate-fade {
      animation-name: contentTestimonialsFade;
    }

    #{{ block_id }}.content-testimonials--animate-fade_up {
      animation-name: contentTestimonialsFadeUp;
    }

    #{{ block_id }}.content-testimonials--animate-fade_down {
      animation-name: contentTestimonialsFadeDown;
    }

    #{{ block_id }}.content-testimonials--animate-fade_left {
      animation-name: contentTestimonialsFadeLeft;
    }

    #{{ block_id }}.content-testimonials--animate-fade_right {
      animation-name: contentTestimonialsFadeRight;
    }

    #{{ block_id }}.content-testimonials--animate-zoom {
      animation-name: contentTestimonialsZoom;
    }

    @keyframes contentTestimonialsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentTestimonialsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTestimonialsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTestimonialsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTestimonialsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTestimonialsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-testimonials--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-testimonials--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-testimonials--desktop-3 .content-testimonials__grid,
      #{{ block_id }}.content-testimonials--desktop-4 .content-testimonials__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.content-testimonials--featured .content-testimonials__item:first-child {
        grid-column: span 2;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-testimonials--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-testimonials--mobile-1 .content-testimonials__grid {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-testimonials--mobile-2 .content-testimonials__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.content-testimonials--featured .content-testimonials__item:first-child {
        grid-column: auto;
      }

      #{{ block_id }} .content-testimonials__item {
        padding: min(var(--content-testimonials-card-padding), 24px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-testimonials--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-testimonials__link {
        transition: none;
      }
    }
  </style>

  <div class="content-testimonials__grid">
    {%- for index in (1..8) -%}
      {%- if index <= testimonial_count -%}
        {%- liquid
          assign quote_key = 'testimonial_' | append: index | append: '_quote'
          assign name_key = 'testimonial_' | append: index | append: '_name'
          assign role_key = 'testimonial_' | append: index | append: '_role'
          assign company_key = 'testimonial_' | append: index | append: '_company'
          assign rating_key = 'testimonial_' | append: index | append: '_rating'
          assign image_key = 'testimonial_' | append: index | append: '_image'
          assign image_alt_key = 'testimonial_' | append: index | append: '_image_alt'
          assign link_label_key = 'testimonial_' | append: index | append: '_link_label'
          assign link_url_key = 'testimonial_' | append: index | append: '_link_url'

          assign quote = block.settings[quote_key]
          assign name = block.settings[name_key]
          assign role = block.settings[role_key]
          assign company = block.settings[company_key]
          assign rating = block.settings[rating_key]
          assign image = block.settings[image_key]
          assign image_alt = block.settings[image_alt_key]
          assign link_label = block.settings[link_label_key]
          assign link_url = block.settings[link_url_key]
        -%}

        {% if quote != blank or name != blank %}
          <article class="content-testimonials__item">
            {% if rating != 'none' %}
              <div class="content-testimonials__rating" aria-label="{{ rating | escape }} out of 5 stars">
                {%- case rating -%}
                  {%- when '1' -%}★
                  {%- when '2' -%}★★
                  {%- when '3' -%}★★★
                  {%- when '4' -%}★★★★
                  {%- when '5' -%}★★★★★
                {%- endcase -%}
              </div>
            {% endif %}

            {% if quote != blank %}
              <blockquote class="content-testimonials__quote">
                “{{ quote | escape }}”
              </blockquote>
            {% endif %}

            <div class="content-testimonials__author">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 220
                  | image_tag:
                    class: 'content-testimonials__image',
                    loading: 'lazy',
                    alt: image_alt
                }}
              {% endif %}

              <div class="content-testimonials__author-content">
                {% if name != blank %}
                  <strong class="content-testimonials__name">{{ name | escape }}</strong>
                {% endif %}

                {% if role != blank or company != blank %}
                  <span class="content-testimonials__meta">
                    {% if role != blank %}{{ role | escape }}{% endif %}
                    {% if role != blank and company != blank %}, {% endif %}
                    {% if company != blank %}{{ company | escape }}{% endif %}
                  </span>
                {% endif %}
              </div>
            </div>

            {% if link_label != blank and link_url != blank %}
              <a class="content-testimonials__link" href="{{ link_url }}">
                {{ link_label | escape }}
              </a>
            {% endif %}
          </article>
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Content testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "featured",
          "label": "Featured"
        }
      ]
    },
    {
      "type": "range",
      "id": "testimonial_count",
      "label": "Number of testimonials",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },

    {
      "type": "header",
      "content": "Testimonial 1"
    },
    {
      "type": "textarea",
      "id": "testimonial_1_quote",
      "label": "Quote",
      "default": "This made the buying experience clearer, faster, and much easier to trust."
    },
    {
      "type": "text",
      "id": "testimonial_1_name",
      "label": "Name",
      "default": "Alex Morgan"
    },
    {
      "type": "text",
      "id": "testimonial_1_role",
      "label": "Role",
      "default": "Customer"
    },
    {
      "type": "text",
      "id": "testimonial_1_company",
      "label": "Company",
      "default": "Verified Buyer"
    },
    {
      "type": "select",
      "id": "testimonial_1_rating",
      "label": "Rating",
      "default": "5",
      "options": [
        {
          "value": "none",
          "label": "No rating"
        },
        {
          "value": "1",
          "label": "1 star"
        },
        {
          "value": "2",
          "label": "2 stars"
        },
        {
          "value": "3",
