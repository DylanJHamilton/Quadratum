{%- liquid
  assign p = product
  assign s = section.settings
  assign v = current_variant
  assign ui_style = s.variant_ui_style | default: 'default'
  assign label_mode = s.variant_label_mode | default: 'show_selected_value'
  assign targets = s.variant_ui_target_options | default: 'Color' | downcase | split: ','
  assign mf_ns = s.variant_swatch_metafield_namespace | default: 'custom'
  assign mf_key = s.variant_swatch_metafield_key | default: 'swatch'
-%}
{% if p != blank and ui_style != 'default' %}
<div class="q-variant-ui" hidden data-product-variant-ui data-product-select-id="q-variant-{{ section.id | escape }}" data-product-style="{{ ui_style | escape }}">
  {% if s.variant_size_guide_enable and s.variant_size_guide_url != blank %}<div class="q-variant-ui__sizeguide"><a class="q-variant-ui__sizeguide-link" href="{{ s.variant_size_guide_url | escape }}" target="_blank" rel="noopener">Size guide</a></div>{% endif %}
  {% for opt in p.options_with_values %}
    {%- liquid
      assign opt_index = forloop.index0
      assign option_key = 'option' | append: forloop.index
      assign selected_value = v.options[opt_index] | default: v[option_key]
      assign option_name = opt.name | downcase
      assign is_target = false
      for target in targets
        assign target_name = target | strip
        if target_name == option_name
          assign is_target = true
        endif
      endfor
    -%}
    <div class="q-variant-ui__group" data-product-option-index="{{ forloop.index }}" aria-label="{{ opt.name | escape }}">
      {% unless label_mode == 'hide' %}<div class="q-variant-ui__label"><span class="q-variant-ui__label-name">{{ opt.name | escape }}</span><span class="q-variant-ui__label-value" data-product-selected-value>{{ selected_value | escape }}</span></div>{% endunless %}
      {% if ui_style == 'dropdown' %}
        <select data-product-option-select aria-label="{{ opt.name | escape }}">
          {% for val in opt.values %}<option value="{{ val | escape }}" {% if val == selected_value %}selected{% endif %}>{{ val | escape }}</option>{% endfor %}
        </select>
      {% else %}
        <div class="q-variant-ui__controls" role="radiogroup" aria-label="{{ opt.name | escape }}" data-product-controls>
          {% for val in opt.values %}
            <label class="q-variant-ui__item" data-product-option-value="{{ val | escape }}">
              <input type="radio" name="variant-option-{{ section.id | escape }}-{{ opt_index }}" value="{{ val | escape }}" {% if val == selected_value %}checked{% endif %}>
              {% if ui_style == 'swatches' and is_target %}
                {%- liquid
                  assign swatch_image = blank
                  assign swatch_color = blank
                  for candidate in p.variants
                    assign candidate_value = candidate.options[opt_index] | default: candidate[option_key]
                    if candidate_value == val
                      if s.variant_swatch_source == 'metafield'
                        assign swatch = candidate.metafields[mf_ns][mf_key]
                        if swatch.type == 'color'
                          assign swatch_color = swatch.value
                        elsif swatch.type == 'file_reference' and swatch.value.media_type == 'image'
                          assign swatch_image = swatch.value.preview_image
                        endif
                      else
                        assign swatch_image = candidate.featured_image | default: candidate.featured_media.preview_image
                      endif
                      if swatch_image != blank or swatch_color != blank
                        break
                      endif
                    endif
                  endfor
                -%}
                {% if swatch_image != blank %}<img class="q-variant-ui__swatch" src="{{ swatch_image | image_url: width: 80 }}" width="40" height="40" alt="" loading="lazy">
                {% elsif swatch_color != blank %}<span class="q-variant-ui__swatch" style="background-color: {{ swatch_color | escape }}" aria-hidden="true"></span>{% endif %}
              {% endif %}
              <span class="q-variant-ui__text">{{ val | escape }}</span>
            </label>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
  {% capture json_less_than %}\u003c{% endcapture %}
  {% capture variants_json %}[{% for candidate in p.variants %}{"id":{{ candidate.id | json }},"options":[{% for opt in p.options_with_values %}{% assign option_key = 'option' | append: forloop.index %}{% assign option_value = candidate.options[forloop.index0] | default: candidate[option_key] %}{{ option_value | append: '' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}
  <script type="application/json" data-product-variants-json>{{ variants_json | replace: '<', json_less_than }}</script>
</div>
{% endif %}
