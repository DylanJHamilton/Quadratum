{%- comment -%}
  Snippet: header-two-account
  Reusable header account control for Quadratum headers.

  Accepts:
    display - 'icon' | 'text' | 'icon_text'

  Behavior:
    Logged out: disclosure with Sign In / Create Account
    Logged in:  disclosure with Account / Orders / Logout

  Uses native <details>/<summary> so it works without JS;
  header JS adds ESC + outside-click close.

  Usage:
    {% render 'header-two-account', display: section.settings.account_display %}
{%- endcomment -%}

{%- liquid
  assign account_display = display | default: 'icon'

  if customer
    assign account_label = 'Account'
  else
    assign account_label = 'Sign in'
  endif
-%}

<details class="qtm-hm-account" data-qtm-hm-account>
  <summary
    class="qtm-hm-icon-btn qtm-hm-account__summary{% if account_display != 'icon' %} qtm-hm-icon-btn--labeled{% endif %}"
    aria-label="{{ account_label }}"
    aria-haspopup="true"
  >
    {%- if account_display == 'icon' or account_display == 'icon_text' -%}
      <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M5 20C5.7 16.4 8.25 14.4 12 14.4C15.75 14.4 18.3 16.4 19 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    {%- endif -%}
    {%- if account_display == 'text' or account_display == 'icon_text' -%}
      <span class="qtm-hm-icon-btn__label">{{ account_label }}</span>
    {%- endif -%}
  </summary>

  <div class="qtm-hm-account__menu" role="menu">
    {%- if customer -%}
      <a class="qtm-hm-account__link" role="menuitem" href="{{ routes.account_url }}">Account</a>
      <a class="qtm-hm-account__link" role="menuitem" href="{{ routes.account_url }}#orders">Orders</a>
      <a class="qtm-hm-account__link qtm-hm-account__link--muted" role="menuitem" href="{{ routes.account_logout_url }}">Logout</a>
    {%- else -%}
      <a class="qtm-hm-account__link" role="menuitem" href="{{ routes.account_login_url }}">Sign In</a>
      <a class="qtm-hm-account__link" role="menuitem" href="{{ routes.account_register_url }}">Create Account</a>
    {%- endif -%}
  </div>
</details>