    "shipping-and-pickup": {
      "type": "interactive-content-helper-tabs-accordion",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "label": "How long does shipping take?",
            "icon": "",
            "anchor_id": "shipping-and-pickup",
            "content": "<p>Two to five working days within the country. We pack books flat in paper, never plastic, and send a dispatch email with tracking.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "How much does shipping cost?",
            "icon": "",
            "anchor_id": "how-much-does-shipping-cost",
            "content": "<p>A flat rate per order, shown at checkout before you pay. Orders over the threshold shown in the cart ship free.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Can I pick up in the shop?",
            "icon": "",
            "anchor_id": "can-i-pick-up-in-the-shop",
            "content": "<p>Choose shop pickup at checkout. Orders are ready the same day during opening hours and held for ten days.</p>"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3"
