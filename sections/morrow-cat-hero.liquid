{{ 'morrow-cat-store.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign desktop_asset = section.settings.desktop_asset | default: 'mc-bright-hero-desktop.webp'
  assign mobile_asset = section.settings.mobile_asset | default: 'mc-bright-hero-mobile.webp'
-%}
<section id="MorrowHero-{{ section.id }}" class="mc-hero" aria-labelledby="MorrowHeroTitle-{{ section.id }}">
  <picture class="mc-hero__art">
    {% if section.settings.mobile_image != blank %}
      <source media="(max-width: 700px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
    {% else %}
      <source media="(max-width: 700px)" srcset="{{ mobile_asset | asset_url }}">
    {% endif %}
    {% if section.settings.desktop_image != blank %}
      {{ section.settings.desktop_image | image_url: width: 2200 | image_tag: class: 'mc-hero__image', alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <img class="mc-hero__image" src="{{ desktop_asset | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="2200" height="1238" fetchpriority="high">
    {% endif %}
  </picture>
  <div class="mc-hero__copy">
    {% if section.settings.kicker != blank %}<p class="mc-eyebrow">{{ section.settings.kicker | escape }}</p>{% endif %}
    <h1 id="MorrowHeroTitle-{{ section.id }}">{{ section.settings.heading | escape }}<br><em>{{ section.settings.heading_accent | escape }}</em></h1>
    {% if section.settings.body != blank %}<div class="mc-hero__body">{{ section.settings.body }}</div>{% endif %}
    {% if section.settings.button_label != blank %}<a class="mc-button" href="{{ section.settings.button_link | default: '#morrow-cat-collections' }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
    <p class="mc-hero__notice">Fictional store concept. Products, images and prices are illustrative.</p>
  </div>
  {% if section.settings.sticker != blank %}<span class="mc-hero__sticker" aria-hidden="true">{{ section.settings.sticker | escape }}</span>{% endif %}
</section>
{% schema %}
{
  "name": "Morrow Cat Hero",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"A little more cat in every day"},
    {"type":"text","id":"heading","label":"Heading","default":"More cat."},
    {"type":"text","id":"heading_accent","label":"Accent line","default":"More character."},
    {"type":"richtext","id":"body","label":"Description","default":"<p>Big stretches. Little discoveries. A cheerful place to explore the many moods of cat life.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Find your kind of cat day"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"image_picker","id":"desktop_image","label":"Desktop hero image","info":"Optional. The supplied Morrow campaign image is used when empty."},
    {"type":"image_picker","id":"mobile_image","label":"Mobile hero image","info":"Optional. The supplied Morrow mobile composition is used when empty."},
    {"type":"text","id":"desktop_asset","label":"Theme asset filename — desktop","default":"mc-bright-hero-desktop.webp"},
    {"type":"text","id":"mobile_asset","label":"Theme asset filename — mobile","default":"mc-bright-hero-mobile.webp"},
    {"type":"text","id":"image_alt","label":"Image description","default":"Two cats explore a bright, colorful play space."},
    {"type":"text","id":"sticker","label":"Decorative sticker","default":"CAT LIFE / LITTLE KICK"}
  ],
  "presets": [{"name":"Morrow Cat Hero"}]
}
{% endschema %}

