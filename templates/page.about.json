      "blocks": {
        "arc_130": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/transit-pack-28-08-lifestyle.webp",
            "alt": "Person carrying a Transit Pack 28 on a concrete stair",
            "heading": "A studio for quieter objects.",
            "subheading": "ARC//FORM designs the things you carry and touch every working day, then removes everything that does not need to be there.",
            "cta_text": "Our principles",
            "cta_link": "#arc-principles",
            "cta2_text": "Shop the objects",
            "cta2_link": "shopify://collections/all-products",
