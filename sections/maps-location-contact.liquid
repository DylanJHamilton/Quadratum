  "tag": "section",
  "class": "section-maps-location-map-contact",
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure your real location, coverage and contact information. Native links open Google Maps; embeds load external content. The theme does not verify addresses, coverage, opening hours or service availability. Blank location fields do not select a sample place."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit us"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Find location details and ways to get in touch.</p>"
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "btn_directions_enable",
      "label": "Enable \u201cGet Directions\u201d",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_directions_label",
      "label": "Directions label",
      "default": "Get Directions"
    },
    {
      "type": "checkbox",
      "id": "btn_call_enable",
      "label": "Enable \u201cCall Us\u201d",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_call_label",
