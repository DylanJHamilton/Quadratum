{%- liquid
  assign block_id = 'product-cross-sell-products-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign product_source = block.settings.product_source | default: 'manual'
  assign selected_collection = block.settings.collection
  assign product_limit = block.settings.product_limit | default: 4
  assign layout_style = block.settings.layout_style | default: 'grid'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign rendered_products = 0
-%}

<div
  id="{{ block_id }}"
  class="
    product-cross-sell-products
    product-cross-sell-products--{{ layout_style }}
    product-cross-sell-products--width-{{ width }}
    product-cross-sell-products--align-{{ alignment }}
    {% unless show_on_desktop %} product-cross-sell-products--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-cross-sell-products--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-cross-sell-products--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-cross-sell-products--animate product-cross-sell-products--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-cross-sell-margin-top: {{ block.settings.margin_top }}px;
    --product-cross-sell-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-cross-sell-padding: {{ block.settings.padding }}px;
    --product-cross-sell-gap: {{ block.settings.grid_gap }}px;
    --product-cross-sell-card-padding: {{ block.settings.card_padding }}px;
    --product-cross-sell-radius: {{ block.settings.card_radius }}px;
    --product-cross-sell-border-width: {{ block.settings.border_width }}px;
    --product-cross-sell-columns-desktop: {{ block.settings.columns_desktop }};
    --product-cross-sell-columns-tablet: {{ block.settings.columns_tablet }};
    --product-cross-sell-columns-mobile: {{ block.settings.columns_mobile }};
    --product-cross-sell-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --product-cross-sell-heading-color: {{ block.settings.heading_color }};
    --product-cross-sell-text-color: {{ block.settings.text_color }};
    --product-cross-sell-muted-color: {{ block.settings.muted_color }};
    --product-cross-sell-price-color: {{ block.settings.price_color }};
    --product-cross-sell-sale-color: {{ block.settings.sale_color }};
    --product-cross-sell-background: {{ block.settings.background_color }};
    --product-cross-sell-card-background: {{ block.settings.card_background_color }};
    --product-cross-sell-border-color: {{ block.settings.border_color }};
    --product-cross-sell-button-background: {{ block.settings.button_background_color }};
    --product-cross-sell-button-text: {{ block.settings.button_text_color }};
    --product-cross-sell-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-cross-sell-products
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-cross-sell-margin-top);
      margin-bottom: var(--product-cross-sell-margin-bottom);
      padding: var(--product-cross-sell-padding);
      color: var(--product-cross-sell-text-color);
      background: var(--product-cross-sell-background);
    }

    #{{ block_id }}.product-cross-sell-products--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-cross-sell-products--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.product-cross-sell-products--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.product-cross-sell-products--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.product-cross-sell-products--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-cross-sell-products--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-cross-sell-products--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-cross-sell-products--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-cross-sell-products__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .product-cross-sell-products__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }}.product-cross-sell-products--align-center .product-cross-sell-products__header {
      margin-left: auto;
      margin-right: auto;
      justify-items: center;
    }

    #{{ block_id }}.product-cross-sell-products--align-right .product-cross-sell-products__header {
      margin-left: auto;
      margin-right: 0;
      justify-items: end;
    }

    #{{ block_id }} .product-cross-sell-products__eyebrow {
      margin: 0;
      color: var(--product-cross-sell-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-cross-sell-products__heading {
      margin: 0;
      color: var(--product-cross-sell-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .product-cross-sell-products__description {
      margin: 0;
      color: var(--product-cross-sell-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-cross-sell-products__items {
      display: grid;
      grid-template-columns: repeat(var(--product-cross-sell-columns-desktop), minmax(0, 1fr));
      gap: var(--product-cross-sell-gap);
      min-width: 0;
    }

    #{{ block_id }} .product-cross-sell-products__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--product-cross-sell-text-color);
      text-decoration: none;
      padding: var(--product-cross-sell-card-padding);
      background: var(--product-cross-sell-card-background);
      border: var(--product-cross-sell-border-width) solid var(--product-cross-sell-border-color);
      border-radius: var(--product-cross-sell-radius);
      overflow: hidden;
    }

    #{{ block_id }}.product-cross-sell-products--cards .product-cross-sell-products__card {
      box-shadow: 0 16px 38px rgba(0, 0, 0, 0.07);
    }

    #{{ block_id }}.product-cross-sell-products--compact .product-cross-sell-products__card {
      grid-template-columns: {{ block.settings.compact_image_size }}px minmax(0, 1fr);
      align-items: center;
      gap: 14px;
    }

    #{{ block_id }} .product-cross-sell-products__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--product-cross-sell-radius) - 8px), 8px);
      aspect-ratio: var(--product-cross-sell-image-ratio);
    }

    #{{ block_id }}.product-cross-sell-products--compact .product-cross-sell-products__media {
      width: {{ block.settings.compact_image_size }}px;
      height: {{ block.settings.compact_image_size }}px;
      aspect-ratio: auto;
    }

    #{{ block_id }} .product-cross-sell-products__media img,
    #{{ block_id }} .product-cross-sell-products__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 300ms ease;
    }

    #{{ block_id }} .product-cross-sell-products__card:hover .product-cross-sell-products__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .product-cross-sell-products__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .product-cross-sell-products__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--product-cross-sell-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .product-cross-sell-products__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.product-cross-sell-products--align-center .product-cross-sell-products__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }}.product-cross-sell-products--align-right .product-cross-sell-products__content {
      justify-items: end;
      text-align: right;
    }

    #{{ block_id }}.product-cross-sell-products--compact .product-cross-sell-products__content {
      justify-items: start;
      text-align: left;
    }

    #{{ block_id }} .product-cross-sell-products__vendor {
      color: var(--product-cross-sell-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-cross-sell-products__title {
      margin: 0;
      color: var(--product-cross-sell-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-cross-sell-products__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-cross-sell-products__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .product-cross-sell-products__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--product-cross-sell-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.product-cross-sell-products--align-center .product-cross-sell-products__price-row {
      justify-content: center;
    }

    #{{ block_id }}.product-cross-sell-products--align-right .product-cross-sell-products__price-row {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-cross-sell-products--compact .product-cross-sell-products__price-row {
      justify-content: flex-start;
    }

    #{{ block_id }} .product-cross-sell-products__price {
      color: var(--product-cross-sell-price-color);
      font-weight: 800;
    }

    #{{ block_id }} .product-cross-sell-products__compare {
      color: var(--product-cross-sell-muted-color);
      text-decoration: line-through;
      opacity: 0.72;
    }

    #{{ block_id }} .product-cross-sell-products__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: {{ block.settings.button_height }}px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--product-cross-sell-button-text);
      background: var(--product-cross-sell-button-background);
      border: 1px solid var(--product-cross-sell-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 700;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-cross-sell-products__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-cross-sell-products__media:focus-visible,
    #{{ block_id }} .product-cross-sell-products__title a:focus-visible,
    #{{ block_id }} .product-cross-sell-products__button:focus-visible {
      outline: 2px solid var(--product-cross-sell-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-cross-sell-products__empty {
      padding: 18px;
      color: var(--product-cross-sell-text-color);
      background: var(--product-cross-sell-card-background);
      border: var(--product-cross-sell-border-width) solid var(--product-cross-sell-border-color);
      border-radius: var(--product-cross-sell-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-cross-sell-products--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-cross-sell-products--animate-fade {
      animation-name: productCrossSellProductsFade;
    }

    #{{ block_id }}.product-cross-sell-products--animate-fade_up {
      animation-name: productCrossSellProductsFadeUp;
    }

    #{{ block_id }}.product-cross-sell-products--animate-zoom {
      animation-name: productCrossSellProductsZoom;
    }

    @keyframes productCrossSellProductsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productCrossSellProductsFadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productCrossSellProductsZoom {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-cross-sell-products--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-cross-sell-products--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .product-cross-sell-products__items {
        grid-template-columns: repeat(var(--product-cross-sell-columns-tablet), minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-cross-sell-products--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-cross-sell-products__items {
        grid-template-columns: repeat(var(--product-cross-sell-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }} .product-cross-sell-products__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }}.product-cross-sell-products--compact .product-cross-sell-products__card {
        grid-template-columns: {{ block.settings.compact_image_size_mobile }}px minmax(0, 1fr);
      }

      #{{ block_id }}.product-cross-sell-products--compact .product-cross-sell-products__media {
        width: {{ block.settings.compact_image_size_mobile }}px;
        height: {{ block.settings.compact_image_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-cross-sell-products--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-cross-sell-products__media img,
      #{{ block_id }} .product-cross-sell-products__button {
        transition: none;
      }

      #{{ block_id }} .product-cross-sell-products__card:hover .product-cross-sell-products__media img,
      #{{ block_id }} .product-cross-sell-products__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-cross-sell-products__inner">
    {% if block.settings.show_header %}
      <div class="product-cross-sell-products__header">
        {% if block.settings.eyebrow != blank %}
          <p class="product-cross-sell-products__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="product-cross-sell-products__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="product-cross-sell-products__description">
            {{ block.settings.description | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-cross-sell-products__items" aria-label="{{ block.settings.cross_sell_products_label | escape }}">
      {% if product_source == 'manual' %}
        {% for cross_sell_product in block.settings.products limit: product_limit %}
          {% if cross_sell_product != blank %}
            {% unless product_context != blank and cross_sell_product.id == product_context.id %}
              {%- liquid
                assign rendered_products = rendered_products | plus: 1
                assign cross_sell_variant = cross_sell_product.selected_or_first_available_variant
                assign is_on_sale = false
                assign image_alt = cross_sell_product.title

                if cross_sell_product.featured_image.alt != blank
                  assign image_alt = cross_sell_product.featured_image.alt
                endif

                if cross_sell_variant.compare_at_price > cross_sell_variant.price
                  assign is_on_sale = true
                endif
              -%}

              <article class="product-cross-sell-products__item">
                <div class="product-cross-sell-products__card">
                  <a class="product-cross-sell-products__media" href="{{ cross_sell_product.url }}" aria-label="{{ cross_sell_product.title | escape }}">
                    {% if cross_sell_product.featured_image %}
                      {% if rendered_products == 1 %}
                        {{ cross_sell_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% else %}
                        {{ cross_sell_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% endif %}
                    {% else %}
                      <span class="product-cross-sell-products__placeholder" aria-hidden="true"></span>
                    {% endif %}

                    {% if block.settings.show_sale_badge and is_on_sale %}
                      <span class="product-cross-sell-products__badge">
                        {{ block.settings.sale_badge_text | escape }}
                      </span>
                    {% endif %}
                  </a>

                  <div class="product-cross-sell-products__content">
                    {% if block.settings.show_vendor and cross_sell_product.vendor != blank %}
                      <div class="product-cross-sell-products__vendor">
                        {{ cross_sell_product.vendor | escape }}
                      </div>
                    {% endif %}

                    <h3 class="product-cross-sell-products__title">
                      <a href="{{ cross_sell_product.url }}">
                        {{ cross_sell_product.title | escape }}
                      </a>
                    </h3>

                    {% if block.settings.show_price %}
                      <div class="product-cross-sell-products__price-row">
                        <span class="product-cross-sell-products__price">
                          {{ cross_sell_variant.price | money }}
                        </span>

                        {% if is_on_sale %}
                          <span class="product-cross-sell-products__compare">
                            {{ cross_sell_variant.compare_at_price | money }}
                          </span>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if block.settings.show_button %}
                      <a class="product-cross-sell-products__button" href="{{ cross_sell_product.url }}">
                        {{ block.settings.button_label | escape }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% elsif selected_collection != blank %}
        {% for cross_sell_product in selected_collection.products %}
          {% if rendered_products < product_limit %}
            {% unless product_context != blank and cross_sell_product.id == product_context.id %}
              {%- liquid
                assign rendered_products = rendered_products | plus: 1
                assign cross_sell_variant = cross_sell_product.selected_or_first_available_variant
                assign is_on_sale = false
                assign image_alt = cross_sell_product.title

                if cross_sell_product.featured_image.alt != blank
                  assign image_alt = cross_sell_product.featured_image.alt
                endif

                if cross_sell_variant.compare_at_price > cross_sell_variant.price
                  assign is_on_sale = true
                endif
              -%}

              <article class="product-cross-sell-products__item">
                <div class="product-cross-sell-products__card">
                  <a class="product-cross-sell-products__media" href="{{ cross_sell_product.url }}" aria-label="{{ cross_sell_product.title | escape }}">
                    {% if cross_sell_product.featured_image %}
                      {% if rendered_products == 1 %}
                        {{ cross_sell_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% else %}
                        {{ cross_sell_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% endif %}
                    {% else %}
                      <span class="product-cross-sell-products__placeholder" aria-hidden="true"></span>
                    {% endif %}

                    {% if block.settings.show_sale_badge and is_on_sale %}
                      <span class="product-cross-sell-products__badge">
                        {{ block.settings.sale_badge_text | escape }}
                      </span>
                    {% endif %}
                  </a>

                  <div class="product-cross-sell-products__content">
                    {% if block.settings.show_vendor and cross_sell_product.vendor != blank %}
                      <div class="product-cross-sell-products__vendor">
                        {{ cross_sell_product.vendor | escape }}
                      </div>
                    {% endif %}

                    <h3 class="product-cross-sell-products__title">
                      <a href="{{ cross_sell_product.url }}">
                        {{ cross_sell_product.title | escape }}
                      </a>
                    </h3>

                    {% if block.settings.show_price %}
                      <div class="product-cross-sell-products__price-row">
                        <span class="product-cross-sell-products__price">
                          {{ cross_sell_variant.price | money }}
                        </span>

                        {% if is_on_sale %}
                          <span class="product-cross-sell-products__compare">
                            {{ cross_sell_variant.compare_at_price | money }}
                          </span>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if block.settings.show_button %}
                      <a class="product-cross-sell-products__button" href="{{ cross_sell_product.url }}">
                        {{ block.settings.button_label | escape }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_products == 0 and block.settings.show_empty_state %}
      <div class="product-cross-sell-products__empty">
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cross-sell products",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "Manual products"
        },
        {
          "value": "collection",
          "label": "Collection"
        }
      ]
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Manual products",
      "limit": 24
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection source"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Product limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 4
    },

    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Cross-sell adjacent products and alternative options to improve discovery."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
