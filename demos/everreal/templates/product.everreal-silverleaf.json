        "show_media": true,
        "media_type": "image",
        "image": "shopify://shop_images/everreal-silverleaf-elven-ranger-set-detail.webp",
        "media_caption": "The leaf clasp and bracers share the same silver detail.",
        "show_timeline": false,
        "padding_top": 96,
        "padding_bottom": 96,
        "bg_color": "#F5F0FB",
        "surface_color": "#FFFFFF",
        "text_color": "#514E6E",
        "heading_color": "#202039",
        "muted_text_color": "#514E6E",
        "border_color": "#E3DAF2",
        "media_bg_color": "#EDEAF1"
      },
      "blocks": {
        "er_1": {
          "type": "story_paragraph",
          "settings": {
            "content": "<p>The Silverleaf set builds the whole character in five pieces. The hooded cape sits over the shoulders and falls to the back, the olive tunic laces at the neck, and the belt and bracers share a plain silver leaf detail.</p>"
          }
        },
        "er_2": {
          "type": "story_paragraph",
          "settings": {
            "content": "<p>Weapons, boots and a wig are not included. Pair it with the Silver Wanderer Long Wig and tall brown boots from your own closet to finish the look.</p>"
          }
        },
        "er_3": {
          "type": "story_paragraph",
          "settings": {
            "content": "<p>Generated imagery. Materials and fit are not supplier verified, and we will say so on this page until they are.</p>"
          }
        },
        "er_4": {
          "type": "story_paragraph",
          "settings": {
            "content": "<p>Next: <a href=\"/products/silver-wanderer-long-wig\">add the matching wig</a>, or <a href=\"/blogs/everreal-guides/build-your-first-complete-look\">read the first-look guide</a> before you choose a size.</p>"
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4"
      ]
