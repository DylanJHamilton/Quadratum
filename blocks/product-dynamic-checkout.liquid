{% if product != blank %}
{%- liquid
  assign block_id = 'product-dynamic-checkout-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant
  assign form_id = block_id | append: '-form'
  assign quantity_min = current_variant.quantity_rule.min | default: 1
  assign selected_allocation = current_variant.selected_selling_plan_allocation
  if selected_allocation == blank and product_context.requires_selling_plan
    assign selected_allocation = current_variant.selling_plan_allocations.first
  endif
  assign purchase_available = current_variant.available
  if product_context.requires_selling_plan and selected_allocation == blank
    assign purchase_available = false
  endif

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign checkout_style = block.settings.checkout_style | default: 'standard'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-dynamic-checkout
    product-dynamic-checkout--{{ checkout_style }}
    product-dynamic-checkout--width-{{ width }}
    product-dynamic-checkout--align-{{ alignment }}
    {% unless purchase_available %} product-dynamic-checkout--unavailable{% endunless %}
    {% unless show_on_desktop or request.design_mode %} product-dynamic-checkout--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} product-dynamic-checkout--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} product-dynamic-checkout--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-dynamic-checkout--animate product-dynamic-checkout--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-dynamic-checkout-margin-top: {{ block.settings.margin_top }}px;
    --product-dynamic-checkout-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-dynamic-checkout-padding: {{ block.settings.padding }}px;
    --product-dynamic-checkout-gap: {{ block.settings.gap }}px;
    --product-dynamic-checkout-border-width: {{ block.settings.border_width }}px;
    --product-dynamic-checkout-border-radius: {{ block.settings.border_radius }}px;
    --product-dynamic-checkout-background-color: {{ block.settings.background_color }};
    --product-dynamic-checkout-border-color: {{ block.settings.border_color }};
    --product-dynamic-checkout-text-color: {{ block.settings.text_color }};
    --product-dynamic-checkout-note-color: {{ block.settings.note_color }};
    --product-dynamic-checkout-focus-color: {{ block.settings.focus_color }};
  "
  data-qtm-product-block-commerce="dynamic-checkout"
  data-product-url="{{ product_context.url | escape }}"
  data-requires-plan="{{ product_context.requires_selling_plan }}"
  data-initial-plan="{{ selected_allocation.selling_plan.id }}"
  data-add-label="{{ 'Add to cart' | escape }}"
  data-sold-label="{{ 'Sold out' | escape }}"
  data-unavailable-label="{{ block.settings.unavailable_text | default: 'Unavailable' | escape }}"
  data-available-label="{{ 'Available' | escape }}"
  data-cart-adding-message="{{ 'Adding to cart...' | escape }}"
  data-cart-added-message="{{ 'Added to cart.' | escape }}"
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-dynamic-checkout

>
  {% render 'qtm-product-block-data', product: product_context %}
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--product-dynamic-checkout-margin-top);
      margin-bottom: var(--product-dynamic-checkout-margin-bottom);
      padding: var(--product-dynamic-checkout-padding);
      color: var(--product-dynamic-checkout-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-dynamic-checkout--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-dynamic-checkout--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-dynamic-checkout--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-dynamic-checkout--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-dynamic-checkout--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-dynamic-checkout--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-dynamic-checkout--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-dynamic-checkout--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-dynamic-checkout__inner {
      display: grid;
      gap: var(--product-dynamic-checkout-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-dynamic-checkout--card .product-dynamic-checkout__inner,
    #{{ block_id }}.product-dynamic-checkout--conversion .product-dynamic-checkout__inner {
      padding: 16px;
      color: var(--product-dynamic-checkout-text-color);
      background: var(--product-dynamic-checkout-background-color);
      border: var(--product-dynamic-checkout-border-width) solid var(--product-dynamic-checkout-border-color);
      border-radius: var(--product-dynamic-checkout-border-radius);
    }

    #{{ block_id }} .product-dynamic-checkout__heading {
      margin: 0;
      color: var(--product-dynamic-checkout-text-color);
      line-height: 1.25;
      font-size: 0.96em;
    }

    #{{ block_id }} .product-dynamic-checkout__form {
      display: grid;
      gap: var(--product-dynamic-checkout-gap);
      margin: 0;
      min-width: 0;
    }

    #{{ block_id }} .product-dynamic-checkout__payment {
      min-height: {{ block.settings.button_height }}px;
      display: grid;
      align-content: center;
      min-width: 0;
    }

    #{{ block_id }} .product-dynamic-checkout__payment .shopify-payment-button {
      width: 100%;
    }

    #{{ block_id }} .product-dynamic-checkout__payment .shopify-payment-button__button {
      width: 100%;
      min-height: {{ block.settings.button_height }}px;
      border-radius: var(--product-dynamic-checkout-border-radius);
      overflow: hidden;
    }

    #{{ block_id }}.product-dynamic-checkout--compact .product-dynamic-checkout__payment .shopify-payment-button__button {
      min-height: {{ block.settings.button_height }}px;
    }

    #{{ block_id }}.product-dynamic-checkout--minimal .product-dynamic-checkout__payment .shopify-payment-button__button {
      min-height: {{ block.settings.button_height }}px;
      border-radius: max(calc(var(--product-dynamic-checkout-border-radius) - 6px), 0px);
    }

    #{{ block_id }} .product-dynamic-checkout__payment .shopify-payment-button__button:focus-visible,
    #{{ block_id }} .product-dynamic-checkout__payment button:focus-visible {
      outline: 2px solid var(--product-dynamic-checkout-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-dynamic-checkout__note {
      color: var(--product-dynamic-checkout-note-color);
      line-height: 1.4;
      font-size: 0.9em;
    }

    #{{ block_id }}.product-dynamic-checkout--align-center .product-dynamic-checkout__note,
    #{{ block_id }}.product-dynamic-checkout--align-center .product-dynamic-checkout__heading {
      text-align: center;
    }

    #{{ block_id }}.product-dynamic-checkout--align-right .product-dynamic-checkout__note,
    #{{ block_id }}.product-dynamic-checkout--align-right .product-dynamic-checkout__heading {
      text-align: right;
    }

    #{{ block_id }}.product-dynamic-checkout--unavailable .product-dynamic-checkout__payment {
      opacity: 0.48;
      pointer-events: none;
    }

    #{{ block_id }} .product-dynamic-checkout__unavailable {
      color: var(--product-dynamic-checkout-note-color);
      line-height: 1.35;
      font-size: 0.92em;
    }

    #{{ block_id }}.product-dynamic-checkout--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade {
      animation-name: productDynamicCheckoutFade;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_up {
      animation-name: productDynamicCheckoutFadeUp;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_down {
      animation-name: productDynamicCheckoutFadeDown;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_left {
      animation-name: productDynamicCheckoutFadeLeft;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-fade_right {
      animation-name: productDynamicCheckoutFadeRight;
    }

    #{{ block_id }}.product-dynamic-checkout--animate-zoom {
      animation-name: productDynamicCheckoutZoom;
    }

    @keyframes productDynamicCheckoutFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productDynamicCheckoutFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productDynamicCheckoutFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productDynamicCheckoutFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productDynamicCheckoutFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productDynamicCheckoutZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-dynamic-checkout--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-dynamic-checkout--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-dynamic-checkout--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-dynamic-checkout--card .product-dynamic-checkout__inner,
      #{{ block_id }}.product-dynamic-checkout--conversion .product-dynamic-checkout__inner {
        padding: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-dynamic-checkout--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} :is(button, select, input, a):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    #{{ block_id }} :is(button, select, input) { max-width: 100%; }
    #{{ block_id }}:focus-within { opacity: 1; transform: none; animation: none; }
    #{{ block_id }} [data-b8-fallback] { display: grid; gap: 6px; min-width: 0; }
    #{{ block_id }} [data-b8-fallback] select, #{{ block_id }} [name="selling_plan"] { width: 100%; min-width: 0; min-height: 44px; }
  {% unless block.settings.show_on_desktop or request.design_mode %}@media screen and (min-width: 990px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_tablet or request.design_mode %}@media screen and (min-width: 750px) and (max-width: 989px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_mobile or request.design_mode %}@media screen and (max-width: 749px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
      #{{ block_id }} shopify-accelerated-checkout { --shopify-accelerated-checkout-button-block-size: {{ block.settings.button_height | at_most: 55 }}px; --shopify-accelerated-checkout-button-border-radius: var(--product-dynamic-checkout-border-radius); }
    #{{ block_id }}.product-dynamic-checkout--minimal shopify-accelerated-checkout { --shopify-accelerated-checkout-button-border-radius: max(calc(var(--product-dynamic-checkout-border-radius) - 6px), 0px); }
    #{{ block_id }} .product-dynamic-checkout__payment:focus-within { outline: 2px solid var(--product-dynamic-checkout-focus-color); outline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) { #{{ block_id }} shopify-accelerated-checkout { --shopify-accelerated-checkout-skeleton-animation-duration: 0s; } }
  </style>

  <div class="product-dynamic-checkout__inner">
    {% if block.settings.heading != blank %}
      <h3 class="product-dynamic-checkout__heading">
        {{ block.settings.heading | escape }}
      </h3>
    {% endif %}

    {% form 'product', product_context, id: form_id, class: 'product-dynamic-checkout__form', data-product-dynamic-checkout-form: '' %}
      <div data-b8-fallback>
        <label for="{{ block_id }}-native-variant">{{ 'Variant' | escape }}</label>
        <select id="{{ block_id }}-native-variant" name="id" class="product-dynamic-checkout__variant" data-b8-variant-id>
          {% assign selected_listed = false %}{% for variant in product_context.variants %}{% if variant.id == current_variant.id %}{% assign selected_listed = true %}{% endif %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}
        {% unless selected_listed %}<option value="{{ current_variant.id }}" selected>{{ current_variant.title | escape }}{% unless current_variant.available %} — Sold out{% endunless %}</option>{% endunless %}
        </select>
      </div>

      <input
        type="hidden"
        name="quantity"
        value="{{ quantity_min }}"
        data-product-dynamic-checkout-quantity-input
      >

      {% render 'product-selling-plans', product: product_context, id: block_id %}
      <div {% unless purchase_available %}hidden{% endunless %} data-b8-payment class="product-dynamic-checkout__payment" data-product-dynamic-checkout-payment>
        {{ form | payment_button }}
      </div>
    {% endform %}

    {% if block.settings.show_note and block.settings.note != blank %}
      <div class="product-dynamic-checkout__note">
        {{ block.settings.note | escape }}
      </div>
    {% endif %}

    {% if block.settings.show_unavailable_text %}
      <div
        class="product-dynamic-checkout__unavailable"
        data-product-dynamic-checkout-unavailable
        {% if current_variant.available %}hidden{% endif %}
        role="status"
        aria-live="polite"
      >
        {{ block.settings.unavailable_text | escape }}
      </div>
    {% endif %}
  </div>
</div>

{% elsif request.design_mode %}<p>Select a product to configure this block.</p>{% endif %}

{% schema %}
{
  "name": "Product dynamic checkout",
  "settings": [
    {
      "type": "header",
      "content": "Dynamic checkout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note",
      "default": false
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "checkbox",
      "id": "show_unavailable_text",
      "label": "Show unavailable message",
      "default": true
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable message",
      "default": "This option is currently unavailable."
    },
    {
      "type": "select",
      "id": "checkout_style",
      "label": "Checkout style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "conversion",
          "label": "Conversion"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Checkout area height",
      "info": "Wallet buttons support up to 55px; larger values add space around the button.",
      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Note color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Dynamic Checkout",
      "settings": {
        "show_note": false,
        "show_unavailable_text": true,
        "unavailable_text": "This option is currently unavailable.",
        "checkout_style": "standard",
        "button_height": 52,
        "text_color": "#111111",
        "note_color": "#555555",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "focus_color": "#111111",
        "border_width": 1,
        "border_radius": 14,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 16,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Compact Dynamic Checkout",
      "settings": {
        "show_note": false,
        "show_unavailable_text": true,
        "unavailable_text": "This option is currently unavailable.",
        "checkout_style": "compact",
        "button_height": 44,
        "text_color": "#111111",
        "note_color": "#555555",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "focus_color": "#111111",
        "border_width": 1,
        "border_radius": 12,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Conversion Dynamic Checkout",
      "settings": {
        "heading": "Buy now",
        "show_note": true,
        "note": "Fast checkout options appear automatically when available.",
        "show_unavailable_text": true,
        "unavailable_text": "This option is currently unavailable.",
        "checkout_style": "conversion",
        "button_height": 56,
        "text_color": "#111111",
        "note_color": "#555555",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "focus_color": "#111111",
        "border_width": 1,
        "border_radius": 18,
        "width": "full",
        "alignment": "left",
        "gap": 10,
        "margin_top": 0,
        "margin_bottom": 20,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "fade_up"
      }
    }
  ]
}
{% endschema %}
