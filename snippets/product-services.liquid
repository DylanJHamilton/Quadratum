{%- comment -%}Render inside the native product form. Shopify owns eligibility and payment messaging.{%- endcomment -%}
{{ 'product-services.css' | asset_url | stylesheet_tag }}
<div class="q-product-services">
  {%- assign service_variant = product.selected_or_first_available_variant -%}
  <p data-purchase-unit {% unless service_variant.unit_price_measurement %}hidden{% endunless %}>{% if service_variant.unit_price_measurement %}{{ service_variant.unit_price | money }} / {% if service_variant.unit_price_measurement.reference_value != 1 %}{{ service_variant.unit_price_measurement.reference_value }}{% endif %}{{ service_variant.unit_price_measurement.reference_unit }}{% endif %}</p>
  {% if cart.taxes_included %}<p>{{ 'products.services.tax_included' | t }}</p>{% endif %}
  <div class="q-product-services__terms">{{ form | payment_terms }}</div>
  <q-pickup-availability data-root-url="{{ routes.root_url }}" data-variant-id="{{ service_variant.id }}" data-error="{{ 'products.services.pickup_error' | t | escape }}" data-retry="{{ 'products.services.retry' | t | escape }}">
    {% render 'pickup-locations', variant: service_variant %}
  </q-pickup-availability>
</div>
<script src="{{ 'product-services.js' | asset_url }}" defer></script>
