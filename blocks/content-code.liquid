{%- liquid
  assign code_mode = block.settings.code_mode | default: 'html'
  assign custom_code = block.settings.custom_code
  assign fallback_message = block.settings.fallback_message | default: 'Add custom code, Liquid, or embed content here.'
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'code' %}

<div
  class="
    qtm-code-block
    qtm-code-block--{{ code_mode }}
    {% if block.settings.contain_overflow %} qtm-code-block--contained{% endif %}
  "
  style="
    --qtm-code-max-width: {{ block.settings.max_width }}px;
    --qtm-code-padding: {{ block.settings.code_padding }}px;
    --qtm-code-background: {{ block.settings.code_background }};
    --qtm-code-border-width: {{ block.settings.code_border_width }}px;
    --qtm-code-border-color: {{ block.settings.code_border_color }};
    --qtm-code-radius: {{ block.settings.code_radius }}px;
    --qtm-code-text-color: {{ block.settings.code_text_color }};
  "
>
  {% if block.settings.show_warning %}
    <div class="qtm-code-block__warning">
      {{ block.settings.warning_text | escape }}
    </div>
  {% endif %}

  <div class="qtm-code-block__content">
    {% if custom_code != blank %}
      {% case code_mode %}
        {% when 'html' %}
          {{ custom_code }}

        {% when 'liquid' %}
          {{ custom_code }}

        {% when 'embed' %}
          {{ custom_code }}

        {% else %}
          {{ custom_code }}
      {% endcase %}
    {% else %}
      <div class="qtm-code-block__fallback">
        {{ fallback_message | escape }}
      </div>
    {% endif %}
  </div>
</div>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Code / Custom Liquid",
  "settings": [
    {
      "type": "header",
      "content": "Code"
    },
    {
      "type": "select",
      "id": "code_mode",
      "label": "Mode",
      "default": "html",
      "options": [
        {
          "value": "html",
          "label": "HTML"
        },
        {
          "value": "liquid",
          "label": "Liquid"
        },
        {
          "value": "embed",
          "label": "Embed"
        }
      ]
    },
    {
      "type": "liquid",
      "id": "custom_code",
      "label": "Custom code",
      "default": "<div>Custom content goes here.</div>"
    },
    {
      "type": "text",
      "id": "fallback_message",
      "label": "Fallback message",
      "default": "Add custom code, Liquid, or embed content here."
    },
    {
      "type": "checkbox",
      "id": "contain_overflow",
      "label": "Contain overflow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_warning",
      "label": "Show editor warning",
      "default": false
    },
    {
      "type": "text",
      "id": "warning_text",
      "label": "Warning text",
      "default": "Custom code can affect layout, performance, and theme behavior."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 320,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "code_padding",
      "label": "Code area padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "code_radius",
      "label": "Code area radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "code_border_width",
      "label": "Code area border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Code area colors"
    },
    {
      "type": "color",
      "id": "code_background",
      "label": "Code area background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "code_border_color",
      "label": "Code area border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "code_text_color",
      "label": "Code area text color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Block layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
