{%- if field != blank -%}
  {%- if field.list? -%}
    <ul>{%- for item in field.value -%}<li>{% if item.title != blank %}{{ item.title | escape }}{% elsif item.url != blank %}<a href="{{ item.url | escape }}">{{ item.alt | default: item.url | escape }}</a>{% elsif item.system.handle != blank %}{{ item.system.handle | escape }}{% elsif item.unit != blank %}{{ item.value | escape }} {{ item.unit | escape }}{% else %}{{ item | escape }}{% endif %}</li>{%- endfor -%}</ul>
  {%- elsif field.type == 'rich_text_field' -%}
    {{ field | metafield_tag }}
  {%- elsif field.type == 'file_reference' -%}
    {% if field.value.media_type == 'image' %}{{ field.value | image_url: width: 1600 | image_tag: loading: 'lazy', alt: field.value.alt }}{% elsif field.value.media_type == 'video' %}{{ field.value | video_tag: controls: true, autoplay: false, preload: 'metadata' }}{% elsif field.value.url != blank %}<a href="{{ field.value.url | escape }}">{{ field.value.alt | default: 'View file' | escape }}</a>{% endif %}
  {%- elsif field.type == 'json' -%}
    <pre>{{ field.value | json | escape }}</pre>
  {%- elsif field.value.url != blank -%}
    <a href="{{ field.value.url | escape }}">{{ field.value.title | default: field.value.url | escape }}</a>
  {%- else -%}
    {{ field | metafield_text | escape | newline_to_br }}
  {%- endif -%}
{%- endif -%}
