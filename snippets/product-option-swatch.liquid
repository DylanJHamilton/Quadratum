{%- if value.swatch.image -%}
  <span class="q-option-swatch" aria-hidden="true">{{ value.swatch.image | image_url: width: 48 | image_tag: width: 20, height: 20, alt: '', loading: 'lazy' }}</span>
{%- elsif value.swatch.color -%}
  <span class="q-option-swatch" aria-hidden="true" style="background-color: rgb({{ value.swatch.color.rgb }});"></span>
{%- endif -%}
