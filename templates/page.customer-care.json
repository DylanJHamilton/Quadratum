    "orders": {
      "type": "interactive-content-helper-tabs-accordion",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "label": "Can I change or cancel an order?",
            "icon": "",
            "anchor_id": "orders",
            "content": "<p>Yes, until it is packed. Reply to your order email or use the contact form with the order number and we will sort it out the same day.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "Where is my order?",
            "icon": "",
            "anchor_id": "where-is-my-order",
            "content": "<p>Shop pickup orders are ready the same day and we email when they are on the counter. Shipped orders include a tracking link in the dispatch email.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Can you order a title you do not stock?",
            "icon": "",
            "anchor_id": "can-you-order-a-title-you-do-not-stock",
            "content": "<p>Usually within a week. Send the title and author through the contact form and a bookseller will confirm price and timing before anything is charged.</p>"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3"
      ],
