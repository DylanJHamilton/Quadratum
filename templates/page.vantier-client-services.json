    "vantier_3": {
      "type": "interactive-content-helper-tabs-accordion",
      "settings": {
        "show_header": true,
        "heading": "Answers by topic.",
        "subheading": "<p>Four topics cover most questions about a demonstration store.</p>",
        "layout_mode": "tabs_horizontal",
        "style_preset": "faq",
        "accordion_default_open": "all_closed",
        "use_custom_colors": true,
        "bg": "#F4F0EA",
        "text": "#19191B",
        "muted": "#55595F",
        "accent": "#692A35",
        "border": "#DDD6CB"
      },
      "blocks": {
        "van_1": {
          "type": "item",
          "settings": {
            "label": "Sizing",
            "anchor_id": "sizing",
            "icon": "",
            "content": "<h3>Where are the size charts?</h3><p>Concept size labels only; measured garment charts and fit testing are pending supplier verification.</p><h3>How do I choose between two sizes?</h3><p>Until measured charts exist, the Fit Guide explains each label system and how each design is cut, for example \"close bodice with fluid skirt\".</p>"
          }
        },
        "van_2": {
          "type": "item",
          "settings": {
            "label": "Care",
            "anchor_id": "care",
            "icon": "",
            "content": "<h3>How should I care for a piece?</h3><p>Care instructions are pending verified material composition and supplier testing.</p><h3>What are the pieces made of?</h3><p>Each listing gives a proposed material description, such as \"fluid satin-look woven fabric\". Composition is not verified.</p>"
          }
        },
        "van_3": {
          "type": "item",
          "settings": {
            "label": "Ordering",
            "anchor_id": "ordering",
            "icon": "",
            "content": "<h3>Can I buy a design?</h3><p>Not here. VANTIER is a demonstration store. All designs are shown as sold out. Browse the supplied concepts and size labels; no products can be ordered.</p><h3>Do you ship or take returns?</h3><p>No shipping, returns or market terms are offered. A live store would publish them on this page.</p>"
          }
        },
        "van_4": {
          "type": "item",
          "settings": {
            "label": "Imagery",
            "anchor_id": "imagery",
            "icon": "",
            "content": "<h3>Are these real photographs?</h3><p>No. All product, model and campaign images are generated concept imagery for demonstration.</p><h3>Why do some products have only one view?</h3><p>Supporting views exist for selected pieces only. A second angle is never invented from the same picture.</p>"
          }
        }
      },
      "block_order": [
        "van_1",
        "van_2",
        "van_3",
        "van_4"
      ]
    },
    "vantier_4": {
      "type": "form-support-request",
      "settings": {
        "template_style": "split",
        "surface_style": "card",
        "split_media_side": "right",
        "split_image": "shopify://shop_images/vantier-van-039-trace-point-pump-support.webp",
        "kicker": "Ask a question",
        "heading": "Write to client services.",
        "subheading": "Fields marked with an asterisk are required.",
        "success_text": "Thank you. We will reply by email.",
        "destination": "shopify_contact",
        "hidden_tags": "client-services, vantier",
        "button_label": "Send question",
        "bg_color": "#FFFFFF",
        "form_bg": "#FFFFFF",
        "input_radius": 0,
        "input_border": "#857F78",
        "card_radius": 0,
        "anchor_id": "request"
      },
      "blocks": {
        "van_1": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "name",
