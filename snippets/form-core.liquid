{% comment %}Native complete fields; steps become interactive only after controller initialization.{% endcomment %}
{%- liquid
  assign s = settings
  assign native_form = true
  if s.destination == 'custom_endpoint'
    assign native_form = false
  endif
  assign primary_email_index = 0
  assign step_count = 0
  for block in blocks
    if block.type == 'field' and block.settings.field_type == 'email' and primary_email_index == 0
      assign primary_email_index = forloop.index
    endif
    if block.type == 'step' and s.template_style == 'steps'
      assign step_count = step_count | plus: 1
    endif
  endfor
  assign is_steps = false
  if s.template_style == 'steps'
    assign is_steps = true
  endif
-%}
<div class="q-fields" {% if is_steps %}data-steps="true"{% endif %}>
  {% for group in (0..step_count) %}
    {% capture group_fields %}
      {% if group == 0 and native_form and primary_email_index == 0 %}
        <div class="q-field" data-q-field data-required="true">
          <label class="q-label" for="qf-{{ id }}-required-email">Email *</label>
          <input class="q-input" id="qf-{{ id }}-required-email" type="email" name="contact[email]" autocomplete="email" required aria-describedby="qf-{{ id }}-required-email-err" value="{{ shopify_form.email | escape }}">
          <p class="q-error" id="qf-{{ id }}-required-email-err"></p>
        </div>
      {% endif %}
      {% assign block_group = 0 %}
      {% for block in blocks %}
        {% if block.type == 'step' and is_steps %}{% assign block_group = block_group | plus: 1 %}{% endif %}
        {% if block_group == group %}
          {% if block.type == 'step' %}
            <div class="q-step-heading" {{ block.shopify_attributes }}>
              {% if block.settings.step_title != blank %}<h3 class="q-label">{{ block.settings.step_title | escape }}</h3>{% endif %}
              {% if block.settings.step_desc != blank %}<p class="q-help">{{ block.settings.step_desc | escape }}</p>{% endif %}
            </div>
          {% elsif block.type == 'field' %}
            {% assign primary_email = false %}
            {% if forloop.index == primary_email_index %}{% assign primary_email = true %}{% endif %}
            {% render 'form-field', block: block, id: id, native_form: native_form, primary_email: primary_email, shopify_form: shopify_form %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endcapture %}
    {% assign group_content = group_fields | strip %}
    {% if group_content != blank %}
      {% if is_steps %}<div class="q-step" data-q-step>{{ group_fields }}</div>{% else %}{{ group_fields }}{% endif %}
    {% endif %}
  {% endfor %}
  {%- liquid
    assign button_variant = s.button_variant
    if button_variant == blank or button_variant == 'inherit'
      assign button_variant = theme_settings.button_variant_default | default: 'solid'
    endif
  -%}
  <div class="q-actions" data-q-submit>
    <button type="submit" class="q-btn q-btn--{{ button_variant | escape }}">{{ s.button_label | default: 'Submit' | escape }}</button>
  </div>
</div>
