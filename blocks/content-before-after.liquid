{%- liquid
  assign block_id = 'content-before-after-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'slider'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-before-after
    content-before-after--{{ layout_style }}
    content-before-after--width-{{ block_width }}
    content-before-after--align-{{ text_alignment }}
    {% unless show_on_desktop %} content-before-after--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-before-after--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-before-after--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-before-after--animate content-before-after--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-before-after-margin-top: {{ block.settings.margin_top }}px;
    --content-before-after-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-before-after-padding: {{ block.settings.padding }}px;
    --content-before-after-gap: {{ block.settings.gap }}px;
    --content-before-after-border-width: {{ block.settings.border_width }}px;
    --content-before-after-border-radius: {{ block.settings.border_radius }}px;
    --content-before-after-heading-color: {{ block.settings.heading_color }};
    --content-before-after-text-color: {{ block.settings.text_color }};
    --content-before-after-background-color: {{ block.settings.background_color }};
    --content-before-after-card-background-color: {{ block.settings.card_background_color }};
    --content-before-after-border-color: {{ block.settings.border_color }};
    --content-before-after-link-color: {{ block.settings.link_color }};
    --content-before-after-label-background: {{ block.settings.label_background_color }};
    --content-before-after-label-text: {{ block.settings.label_text_color }};
    --content-before-after-slider-position: {{ block.settings.slider_position }}%;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-before-after-margin-top);
      margin-bottom: var(--content-before-after-margin-bottom);
      padding: var(--content-before-after-padding);
      color: var(--content-before-after-text-color);
      background: var(--content-before-after-background-color);
    }

    #{{ block_id }}.content-before-after--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-before-after--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-before-after--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-before-after--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-before-after--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-before-after--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-before-after--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-before-after--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-before-after__inner {
      display: grid;
      gap: var(--content-before-after-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }}.content-before-after--story .content-before-after__inner {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      align-items: center;
    }

    #{{ block_id }} .content-before-after__content {
      display: grid;
      gap: 14px;
      min-width: 0;
    }

    #{{ block_id }} .content-before-after__heading {
      margin: 0;
      color: var(--content-before-after-heading-color);
      line-height: 1.12;
    }

    #{{ block_id }} .content-before-after__text {
      color: var(--content-before-after-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-before-after__text p {
      margin-top: 0;
    }

    #{{ block_id }} .content-before-after__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-before-after__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      padding: 11px 16px;
      color: var(--content-before-after-link-color);
      border: var(--content-before-after-border-width) solid currentColor;
      border-radius: var(--content-before-after-border-radius);
      text-decoration: none;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-before-after__button:hover {
      opacity: 0.78;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-before-after__button:focus-visible {
      outline: 2px solid var(--content-before-after-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }}.content-before-after--align-center .content-before-after__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-before-after--align-right .content-before-after__button {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-before-after__media {
      min-width: 0;
      width: 100%;
    }

    #{{ block_id }} .content-before-after__frame {
      position: relative;
      width: 100%;
      min-width: 0;
      overflow: hidden;
      background: var(--content-before-after-card-background-color);
      border: var(--content-before-after-border-width) solid var(--content-before-after-border-color);
      border-radius: var(--content-before-after-border-radius);
    }

    #{{ block_id }} .content-before-after__image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .content-before-after__placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 320px;
      padding: 32px;
      color: var(--content-before-after-text-color);
      background: var(--content-before-after-card-background-color);
      text-align: center;
      border: var(--content-before-after-border-width) solid var(--content-before-after-border-color);
      border-radius: var(--content-before-after-border-radius);
    }

    #{{ block_id }} .content-before-after__label {
      position: absolute;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      max-width: calc(100% - 24px);
      padding: 7px 11px;
      border-radius: 999px;
      color: var(--content-before-after-label-text);
      background: var(--content-before-after-label-background);
      line-height: 1.2;
      font-size: 0.82em;
      pointer-events: none;
    }

    #{{ block_id }} .content-before-after__label--before {
      top: 12px;
      left: 12px;
    }

    #{{ block_id }} .content-before-after__label--after {
      top: 12px;
      right: 12px;
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__slider-frame {
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: var(--content-before-after-border-radius);
      background: var(--content-before-after-card-background-color);
      border: var(--content-before-after-border-width) solid var(--content-before-after-border-color);
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__before-image,
    #{{ block_id }}.content-before-after--slider .content-before-after__after-image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__after-wrap {
      position: absolute;
      inset: 0;
      width: var(--content-before-after-slider-position);
      overflow: hidden;
      z-index: 2;
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__after-wrap .content-before-after__after-image {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__handle {
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--content-before-after-slider-position);
      z-index: 5;
      width: 2px;
      background: var(--content-before-after-label-background);
      transform: translateX(-50%);
      pointer-events: none;
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__handle::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 42px;
      height: 42px;
      border-radius: 999px;
      background: var(--content-before-after-label-background);
      border: var(--content-before-after-border-width) solid var(--content-before-after-border-color);
      transform: translate(-50%, -50%);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    }

    #{{ block_id }}.content-before-after--slider .content-before-after__handle::after {
      content: "↔";
      position: absolute;
      top: 50%;
      left: 50%;
      color: var(--content-before-after-label-text);
      line-height: 1;
      transform: translate(-50%, -50%);
    }

    #{{ block_id }} .content-before-after__range {
      position: absolute;
      inset: 0;
      z-index: 8;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: ew-resize;
    }

    #{{ block_id }} .content-before-after__range:focus-visible + .content-before-after__handle {
      outline: 2px solid var(--content-before-after-link-color);
      outline-offset: 4px;
    }

    #{{ block_id }}.content-before-after--side_by_side .content-before-after__comparison {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--content-before-after-gap);
    }

    #{{ block_id }}.content-before-after--stacked .content-before-after__comparison {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--content-before-after-gap);
    }

    #{{ block_id }}.content-before-after--story .content-before-after__comparison {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--content-before-after-gap);
    }

    #{{ block_id }}.content-before-after--side_by_side .content-before-after__frame,
    #{{ block_id }}.content-before-after--stacked .content-before-after__frame,
    #{{ block_id }}.content-before-after--story .content-before-after__frame {
      min-width: 0;
    }

    #{{ block_id }}.content-before-after--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-before-after--animate-fade {
      animation-name: contentBeforeAfterFade;
    }

    #{{ block_id }}.content-before-after--animate-fade_up {
      animation-name: contentBeforeAfterFadeUp;
    }

    #{{ block_id }}.content-before-after--animate-fade_down {
      animation-name: contentBeforeAfterFadeDown;
    }

    #{{ block_id }}.content-before-after--animate-fade_left {
      animation-name: contentBeforeAfterFadeLeft;
    }

    #{{ block_id }}.content-before-after--animate-fade_right {
      animation-name: contentBeforeAfterFadeRight;
    }

    #{{ block_id }}.content-before-after--animate-zoom {
      animation-name: contentBeforeAfterZoom;
    }

    @keyframes contentBeforeAfterFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentBeforeAfterFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentBeforeAfterFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentBeforeAfterFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentBeforeAfterFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentBeforeAfterZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-before-after--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-before-after--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-before-after--story .content-before-after__inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-before-after--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-before-after--story .content-before-after__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-before-after--side_by_side .content-before-after__comparison,
      #{{ block_id }}.content-before-after--story .content-before-after__comparison {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .content-before-after__placeholder {
        min-height: 240px;
      }

      #{{ block_id }} .content-before-after__image,
      #{{ block_id }}.content-before-after--slider .content-before-after__before-image,
      #{{ block_id }}.content-before-after--slider .content-before-after__after-image {
        aspect-ratio: 4 / 3;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-before-after--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-before-after__button {
        transition: none;
      }

      #{{ block_id }} .content-before-after__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-before-after__inner">
    {% if layout_style == 'story' %}
      <div class="content-before-after__content">
        {% if block.settings.heading != blank %}
          <h3 class="content-before-after__heading">
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="content-before-after__text">
            {{ block.settings.text }}
          </div>
        {% endif %}

        {% if block.settings.button_label != blank and block.settings.button_url != blank %}
          <a class="content-before-after__button" href="{{ block.settings.button_url }}">
            {{ block.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="content-before-after__media">
      {% if layout_style == 'slider' %}
        {% if block.settings.before_image != blank and block.settings.after_image != blank %}
          <div
            class="content-before-after__slider-frame"
            data-content-before-after-frame
          >
            {{
              block.settings.before_image
              | image_url: width: 1600
              | image_tag:
                class: 'content-before-after__before-image',
                loading: 'lazy',
                alt: block.settings.before_image_alt
            }}

            <div class="content-before-after__after-wrap" data-content-before-after-after-wrap>
              {{
                block.settings.after_image
                | image_url: width: 1600
                | image_tag:
                  class: 'content-before-after__after-image',
                  loading: 'lazy',
                  alt: block.settings.after_image_alt
              }}
            </div>

            {% if block.settings.before_label != blank %}
              <span class="content-before-after__label content-before-after__label--before">
                {{ block.settings.before_label | escape }}
              </span>
            {% endif %}

            {% if block.settings.after_label != blank %}
              <span class="content-before-after__label content-before-after__label--after">
                {{ block.settings.after_label | escape }}
              </span>
            {% endif %}

            <input
              class="content-before-after__range"
              type="range"
              min="0"
              max="100"
              step="1"
              value="{{ block.settings.slider_position }}"
              aria-label="{{ block.settings.slider_aria_label | escape }}"
              data-content-before-after-range
            >

            <span class="content-before-after__handle" data-content-before-after-handle aria-hidden="true"></span>
          </div>
        {% else %}
          <div class="content-before-after__placeholder">
            Add before and after images to use the comparison slider.
          </div>
        {% endif %}
      {% else %}
        <div class="content-before-after__comparison">
          <div class="content-before-after__frame">
            {% if block.settings.before_image != blank %}
              {{
                block.settings.before_image
                | image_url: width: 1200
                | image_tag:
                  class: 'content-before-after__image',
                  loading: 'lazy',
                  alt: block.settings.before_image_alt
              }}
            {% else %}
              <div class="content-before-after__placeholder">
                Add a before image.
              </div>
            {% endif %}

            {% if block.settings.before_label != blank %}
              <span class="content-before-after__label content-before-after__label--before">
                {{ block.settings.before_label | escape }}
              </span>
            {% endif %}
          </div>

          <div class="content-before-after__frame">
            {% if block.settings.after_image != blank %}
              {{
                block.settings.after_image
                | image_url: width: 1200
                | image_tag:
                  class: 'content-before-after__image',
                  loading: 'lazy',
                  alt: block.settings.after_image_alt
              }}
            {% else %}
              <div class="content-before-after__placeholder">
                Add an after image.
              </div>
            {% endif %}

            {% if block.settings.after_label != blank %}
              <span class="content-before-after__label content-before-after__label--after">
                {{ block.settings.after_label | escape }}
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {% unless layout_style == 'story' %}
      {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
        <div class="content-before-after__content">
          {% if block.settings.heading != blank %}
            <h3 class="content-before-after__heading">
              {{ block.settings.heading | escape }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="content-before-after__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank and block.settings.button_url != blank %}
            <a class="content-before-after__button" href="{{ block.settings.button_url }}">
              {{ block.settings.button_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endunless %}
  </div>

  {% if layout_style == 'slider' %}
    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.contentBeforeAfterReady === 'true') return;

        root.dataset.contentBeforeAfterReady = 'true';

        const range = root.querySelector('[data-content-before-after-range]');

        if (!range) return;

        const update = () => {
          root.style.setProperty('--content-before-after-slider-position', `${range.value}%`);
        };

        range.addEventListener('input', update);
        range.addEventListener('change', update);

        update();
      })();
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "Before after",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the transformation"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use before and after visuals to show product results, transformations, improvements, renovations, design changes, or progress over time.</p>"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_image_alt",
      "label": "Before image alt text"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_image_alt",
      "label": "After image alt text"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View details"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "slider_aria_label",
      "label": "Slider accessibility label",
      "default": "Adjust before and after image comparison"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "slider",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "side_by_side",
          "label": "Side by side"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "story",
          "label": "Story"
        }
      ]
    },
    {
      "type": "range",
      "id": "slider_position",
      "label": "Initial slider position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
