        "color_surface": "#FFFFFF",
        "color_border": "#E3DAF2"
      },
      "blocks": {
        "er_1": {
          "type": "card",
          "settings": {
            "title": "See every piece",
            "body": "<p>Every product page lists its contents and names anything you will need to add yourself.</p>",
            "icon": "lucide-list-checks",
            "cta_label": "How we list contents",
            "cta_url": "/pages/everreal-support#template--20314997162068__everreal_5-included",
            "badge": "",
            "subtitle": ""
          }
        },
        "er_2": {
          "type": "card",
          "settings": {
            "title": "Made for first-timers",
            "body": "<p>Plain language, complete sets and a person to ask. No insider knowledge required.</p>",
            "icon": "lucide-users",
            "cta_label": "Read the first-look guide",
            "cta_url": "/blogs/everreal-guides/build-your-first-complete-look",
            "badge": "",
            "subtitle": ""
          }
        },
        "er_3": {
          "type": "card",
          "settings": {
            "title": "Complete, not partial",
            "body": "<p>Wigs and accessory kits are matched to the costumes they finish, so a look comes together.</p>",
            "icon": "lucide-sparkles",
            "cta_label": "Shop wigs and kits",
            "cta_url": "/collections/everreal-wigs-makeup",
            "badge": "",
            "subtitle": ""
          }
        },
        "er_4": {
          "type": "card",
          "settings": {
            "title": "Honest by default",
            "body": "<p>No invented reviews, ratings or certification claims. Demo details are labeled as demo details.</p>",
            "icon": "lucide-shield-check",
            "cta_label": "Read our support answers",
            "cta_url": "/pages/everreal-support",
            "badge": "",
            "subtitle": ""
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4"
      ]
