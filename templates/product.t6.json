                    "label": "Quantity",
                    "selector_style": "standard",
                    "control_width": 160,
                    "control_height": 48,
                    "heading_color": "#182E2A",
                    "text_color": "#182E2A",
                    "background_color": "#FFFFFF",
                    "border_color": "#182E2A",
                    "active_color": "#182E2A",
                    "border_width": 1,
                    "border_radius": 4,
                    "margin_bottom": 20
                  }
                },
