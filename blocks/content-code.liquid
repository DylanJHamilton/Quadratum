        "code_padding": 20,
        "code_radius": 12,
        "code_border_width": 1,
        "code_background": "#f7f7f7",
        "code_border_color": "#e5e5e5",
        "code_text_color": "#111111",
        "content_width": "auto",
        "alignment": "left",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
