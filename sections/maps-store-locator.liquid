{% comment %}Native location list with optional provider map; one shared engine and scoped assets.{% endcomment %}
{% assign s = section.settings %}
{% assign accent = settings.color_primary %}{% if s.use_custom_colors %}{% assign accent = s.custom_accent %}{% endif %}
{% capture on_accent %}{% render 'contrast-text', bg: accent, preferred: settings.text_on_color %}{% endcapture %}
{% capture locations %}
  {% for block in section.blocks %}
    {% assign b = block.settings %}
    {% if b.name != blank or b.address != blank or b.phone != blank or b.email != blank %}
      {% capture pair %}{% render 'maps-coordinates', lat: b.lat, lng: b.lng %}{% endcapture %}
      {% assign destination = '' %}{% assign query = b.address | strip | url_encode %}
      {% if b.address != blank %}{% assign destination = 'https://www.google.com/maps/search/?api=1&query=' | append: query %}
      {% elsif pair != blank %}{% assign query = pair | url_encode %}{% assign destination = 'https://www.google.com/maps/search/?api=1&query=' | append: query %}{% endif %}
      <article class="q-map-card" data-location-card data-location-id="{{ block.id }}" data-location-name="{{ b.name | escape }}" data-location-tags="{{ b.tags | escape }}" data-location-coordinates="{{ pair | strip }}" tabindex="-1" {{ block.shopify_attributes }}>
        {% if b.name != blank %}<h3 class="q-map-card__title">{{ b.name | escape }}</h3>{% endif %}
        {% if b.address != blank %}<p>{{ b.address | escape | newline_to_br }}</p>{% endif %}
        {% if b.hours != blank %}<p>{{ b.hours | escape | newline_to_br }}</p>{% endif %}
        <div class="q-map-card__contact">
          {% if b.phone != blank %}<a href="tel:{{ b.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}">{{ b.phone | escape }}</a>{% endif %}
          {% if b.email != blank %}<a href="mailto:{{ b.email | escape }}">{{ b.email | escape }}</a>{% endif %}
        </div>
        {% if b.tags != blank %}<p class="q-map-card__tags">{{ b.tags | escape }}</p>{% endif %}
        <div class="q-map-card__actions">
          {% if b.url != blank and s.card_primary_label != blank %}<a class="q-map-button q-map-button--primary" href="{{ b.url | escape }}">{{ s.card_primary_label | escape }}</a>{% endif %}
          {% if destination != blank and s.card_directions_label != blank %}<a class="q-map-button" href="{{ destination | escape }}" target="_blank" rel="noopener">{{ s.card_directions_label | escape }}</a>{% endif %}
          {% if pair != blank %}<button type="button" class="q-map-button" data-focus-map hidden>Show on map<span class="q-map-sr">: {{ b.name | default: b.address | escape }}</span></button>{% endif %}
        </div>
      </article>
    {% elsif request.design_mode %}
      <div class="q-map-locator__empty" {{ block.shopify_attributes }}>Add this location’s name, address and optional coordinates/contact details.</div>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign locations = locations | strip %}
{% if locations != blank or request.design_mode %}
<section id="q-maps-store-locator-{{ section.id }}" class="q-map-locator" data-section-id="{{ section.id }}" data-layout="{{ s.layout_direction }}" data-list-only="true" style="
 --q-map-bg:{% if s.use_custom_colors %}{{ s.custom_bg }}{% else %}var(--c-bg,#fff){% endif %};
 --q-map-surface:{% if s.use_custom_colors %}{{ s.custom_surface }}{% else %}var(--c-surface,#f6f7f8){% endif %};
 --q-map-text:{% if s.use_custom_colors %}{{ s.custom_text }}{% else %}var(--c-text,#111){% endif %};
 --q-map-muted:{% if s.use_custom_colors %}{{ s.custom_muted }}{% else %}var(--c-muted,#666){% endif %};
 --q-map-accent:{{ accent }};--q-map-on-accent:{{ on_accent | strip }};
 --q-map-border:{% if s.use_custom_colors %}{{ s.custom_border }}{% else %}var(--c-border,#ddd){% endif %};
 --q-map-radius:{{ s.radius }}px;--q-map-shadow:{{ s.shadow_strength }};--q-map-gap:{{ s.gap }}px;
 --q-map-pad-y:{{ s.pad_y }}px;--q-map-pad-x:{{ s.pad_x }}px;--q-map-max:{{ s.max_width }}px;--q-map-height:{{ s.map_height }}px;">
 <div class="q-map-locator__container">
  <header class="q-map-locator__header">
   {% if s.kicker != blank %}<p>{{ s.kicker | escape }}</p>{% endif %}
   {% if s.heading != blank %}<h2>{{ s.heading | escape }}</h2>{% endif %}
   {% if s.subheading != blank %}<div class="rte">{{ s.subheading }}</div>{% endif %}
  </header>
  <div class="q-map-locator__grid">
   <div class="q-map-locator__pane--map" data-map-pane hidden>
    <div class="q-map-locator__mapframe"><div class="q-map-locator__map" data-map aria-label="{{ s.map_aria_label | default: 'Location map' | escape }}" role="region"></div></div>
   </div>
   <div class="q-map-locator__pane--list">
    <div class="q-map-locator__controls" data-map-controls hidden>
     {% if s.enable_search %}<label for="MapSearch-{{ section.id }}">{{ s.search_label | default: 'Search locations' | escape }}</label><input id="MapSearch-{{ section.id }}" class="q-map-locator__search" type="search" placeholder="{{ s.search_placeholder | escape }}" data-map-search>{% endif %}
     {% if s.enable_filters %}<div class="q-map-locator__filters" data-filter-chips data-all-label="{{ s.filter_all_label | default: 'All' | escape }}"></div>{% endif %}
    </div>
    <div class="q-map-locator__list" data-location-list>{{ locations }}</div>
    <p data-map-count role="status" hidden></p><p class="q-map-locator__empty" data-map-empty hidden>No locations match your search.</p>
   </div>
  </div>
  {% if request.design_mode and s.enable_map and s.dev_preview_map %}<div class="q-map-preview" data-map-preview hidden><p>Editor pin layout preview — not a geographic map.</p></div>{% endif %}
  {% if request.design_mode and s.enable_map %}<p>Live maps require Google Maps enabled in theme settings, a configured public API key and valid location coordinates. Provider loading, billing and key restrictions remain merchant responsibilities.</p>{% endif %}
  {% render 'maps-locator-engine', section: section %}
 </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Maps - Store Locator",
  "settings": [
    {
      "type": "paragraph",
      "content": "Location cards, contact links and directions work without JavaScript. Search matches the configured text; it does not geocode a ZIP or calculate distance. Google Maps requires an enabled, restricted public API key and provider billing/configuration. A failed or unavailable API keeps the native location list."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Locations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a Location Near You"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Browse our locations and get directions in seconds.</p>"
    },
    {
      "type": "header",
      "content": "Map + List Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_map",
      "label": "Enable map (requires Theme Settings \u2192 Google Maps)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dev_preview_map",
      "label": "Show editor location preview",
      "default": false,
      "info": "Editor only: relative pin layout, not a real map or geographic service."
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "default": "map_left",
      "options": [
        {
          "value": "map_left",
          "label": "Map left / List right"
        },
        {
          "value": "list_left",
          "label": "List left / Map right"
        }
      ]
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height (px)",
      "min": 320,
      "max": 760,
      "step": 20,
      "default": 520
    },
    {
      "type": "text",
      "id": "map_aria_label",
      "label": "Map ARIA label",
      "default": "Store locator map"
    },
    {
      "type": "header",
      "content": "Search + Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search field label",
      "default": "Search locations"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by city, ZIP, or keyword\u2026"
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Enable tag filters",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "All filter label",
      "default": "All"
    },
    {
      "type": "header",
      "content": "Map Defaults"
    },
    {
      "type": "text",
      "id": "default_lat",
      "label": "Default center latitude"
    },
    {
      "type": "text",
      "id": "default_lng",
      "label": "Default center longitude"
    },
    {
      "type": "range",
      "id": "default_zoom",
      "label": "Default zoom",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Card + Pin Labels"
    },
    {
      "type": "text",
      "id": "card_primary_label",
      "label": "Card primary button label",
      "default": "View Location"
    },
    {
      "type": "text",
      "id": "card_directions_label",
      "label": "Card directions label",
      "default": "Directions"
    },
    {
      "type": "text",
      "id": "pin_primary_label",
      "label": "Pin link label",
      "default": "Open details"
    },
    {
      "type": "header",
      "content": "Design + Spacing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 900,
      "max": 1700,
      "step": 20,
      "default": 1200
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Section padding Y (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_x",
      "label": "Section padding X (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap (px)",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Surface radius (px)",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "shadow_strength",
      "label": "Shadow strength",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "header",
      "content": "Custom Colors"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "label": "Use custom colors",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "custom_surface",
      "label": "Surface",
      "default": "#f6f7f8"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "custom_muted",
      "label": "Muted text",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Accent",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Border",
      "default": "#e5e7eb"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Location name"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "lat",
          "label": "Latitude"
        },
        {
          "type": "text",
          "id": "lng",
          "label": "Longitude"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (comma-separated)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Location page URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maps - Store Locator",
      "category": "Maps",
      "blocks": [
        {
          "type": "location"
        }
      ]
    }
  ]
}
{% endschema %}
