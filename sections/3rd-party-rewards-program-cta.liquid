{% comment %}
  Quadratum — 3rd Party: Referral / Rewards Program CTA
  File: sections/3rd-party-rewards-program-cta.liquid

  - Frontend CTA only (no app logic)
  - Fully styleable via section settings + theme token fallbacks
  - Preset category must be: 3rd Party Integrations
{% endcomment %}

{%- assign s = section.settings -%}

{%- if s.enable_section -%}

  {%- assign pad_y = s.padding_y | default: 56 | divided_by: 10.0 -%}
  {%- assign pad_x = s.padding_x | default: 24 | divided_by: 10.0 -%}

  {%- assign radius = s.card_radius | default: 16 -%}

  {%- assign cols = s.benefit_columns_desktop | default: '2' -%}

  {%- assign heading_fs = 'clamp(1.35rem, 2.2vw, 2.0rem)' -%}
  {%- case s.heading_size -%}
    {%- when 'sm' -%}{%- assign heading_fs = 'clamp(1.2rem, 1.8vw, 1.6rem)' -%}
    {%- when 'lg' -%}{%- assign heading_fs = 'clamp(1.6rem, 2.7vw, 2.4rem)' -%}
    {%- else -%}{%- assign heading_fs = 'clamp(1.35rem, 2.2vw, 2.0rem)' -%}
  {%- endcase -%}

  {%- assign shadow_css = '0 10px 30px rgba(0,0,0,.08)' -%}
  {%- case s.card_shadow -%}
    {%- when 'none' -%}{%- assign shadow_css = 'none' -%}
    {%- when 'sm' -%}{%- assign shadow_css = '0 2px 10px rgba(0,0,0,.06)' -%}
    {%- when 'lg' -%}{%- assign shadow_css = '0 18px 55px rgba(0,0,0,.12)' -%}
    {%- else -%}{%- assign shadow_css = '0 10px 30px rgba(0,0,0,.08)' -%}
  {%- endcase -%}

  {%- assign v_bg        = 'var(--q-section-bg, var(--c-bg, #ffffff))' -%}
  {%- assign v_card_bg   = 'var(--q-section-card-bg, var(--c-bg, #ffffff))' -%}
  {%- assign v_text      = 'var(--q-section-fg, var(--c-text, #111111))' -%}
  {%- assign v_muted     = 'var(--q-section-muted, var(--c-muted, #6b7280))' -%}
  {%- assign v_accent    = 'var(--c-primary, #2563eb)' -%}
  {%- assign v_border    = 'color-mix(in srgb, var(--q-ref-text) 20%, transparent)' -%}
  {%- assign v_highlight = 'color-mix(in srgb, var(--q-ref-accent) 8%, var(--q-ref-bg))' -%}

  {%- if s.use_custom_colors -%}
    {%- assign v_bg        = s.custom_bg_color -%}
    {%- assign v_card_bg   = s.custom_card_bg_color -%}
    {%- assign v_text      = s.custom_text_color -%}
    {%- assign v_muted     = s.custom_muted_text_color -%}
    {%- assign v_accent    = s.custom_accent_color -%}
    {%- assign v_border    = s.custom_border_color -%}
    {%- assign v_highlight = s.custom_highlight_bg_color -%}
  {%- endif -%}

  {%- assign accent_text = 'var(--c-oncolor, #ffffff)' -%}
  {%- if s.use_custom_colors -%}
    {%- capture accent_text -%}{%- render 'contrast-text', background: s.custom_accent_color, preferred: settings.text_on_color -%}{%- endcapture -%}
  {%- endif -%}

  {%- assign has_primary = false -%}
  {%- if s.primary_button_label != blank and s.primary_button_url != blank -%}
    {%- assign has_primary = true -%}
  {%- endif -%}

  {%- assign has_secondary = false -%}
  {%- if s.secondary_button_label != blank and s.secondary_button_url != blank -%}
    {%- assign has_secondary = true -%}
  {%- endif -%}

  {%- assign has_actions = false -%}
  {%- if has_primary or has_secondary -%}
    {%- assign has_actions = true -%}
  {%- endif -%}

  {%- liquid
    assign benefit_blocks = section.blocks | where: 'type', 'benefit'
    assign has_benefits = false
    for block in benefit_blocks
      if block.settings.title != blank or block.settings.body != blank
        assign has_benefits = true
      endif
    endfor
    assign has_content = false
    if s.kicker != blank or s.heading != blank or s.body != blank or s.reward_highlight != blank or has_actions or has_benefits
      assign has_content = true
    endif
    if s.show_badge and s.badge_text != blank
      assign has_content = true
    endif
  -%}
  {%- if has_content -%}
<section
  id="rewards-cta-{{ section.id }}"
  class="q-section q-section--referral-cta q-section--bg-{{ s.background_style }} q-referral-cta q-referral-cta--{{ s.layout_style }} q-referral-cta--program-{{ s.program_type }}{% if has_actions %} has-actions{% endif %}"
  aria-label="{{ s.aria_label | default: s.heading | default: 'Rewards program' | escape }}"
  style="
    --q-ref-pad-y: {{ pad_y }}rem;
    --q-ref-pad-x: {{ pad_x }}rem;
    --q-ref-radius: {{ radius }}px;
    --q-ref-heading-fs: {{ heading_fs }};
    --q-ref-shadow: {{ shadow_css }};
    --q-ref-cols: {{ cols }};
    --q-ref-bg: {{ v_bg }};
    --q-ref-card-bg: {{ v_card_bg }};
    --q-ref-text: {{ v_text }};
    --q-ref-muted: {{ v_muted }};
    --q-ref-accent: {{ v_accent }};
    --q-ref-accent-text: {{ accent_text | strip }};
    --q-ref-border: {{ v_border }};
    --q-ref-highlight: {{ v_highlight }};
  "
>
  <div class="q-section__inner q-section__inner--{{ s.max_width }} q-referral-cta__inner q-align-{{ s.align }}">

    {%- assign wrap_card = false -%}
    {%- if s.layout_style == 'card' -%}{%- assign wrap_card = true -%}{%- endif -%}

    {%- if wrap_card -%}
      <div class="q-referral-cta__card{% if s.show_border %} is-bordered{% endif %}">
    {%- endif -%}

      <div class="q-referral-cta__grid{% if s.layout_style == 'hero' %} is-hero{% endif %}">
        <div class="q-referral-cta__content">

          {%- if s.show_badge and s.badge_text != blank -%}
            <div class="q-referral-cta__badge">
              <span class="q-referral-cta__badge-pill">{{ s.badge_text | escape }}</span>
            </div>
          {%- endif -%}

          {%- if s.kicker != blank -%}
            <p class="q-referral-cta__kicker">{{ s.kicker | escape }}</p>
          {%- endif -%}

          {%- if s.heading != blank -%}
            <h2 class="q-referral-cta__heading">{{ s.heading | escape }}</h2>
          {%- endif -%}

          {%- if s.body != blank -%}
            <div class="q-referral-cta__body">
              {{ s.body }}
            </div>
          {%- endif -%}

          {%- if s.reward_highlight != blank -%}
            <p class="q-referral-cta__highlight">{{ s.reward_highlight | escape }}</p>
          {%- endif -%}

          {%- if has_benefits -%}
            <div class="q-referral-cta__benefits" role="list">
              {%- for block in benefit_blocks -%}
                {%- assign b = block.settings -%}
                {%- if b.title != blank or b.body != blank -%}
                <div class="q-referral-cta__benefit" role="listitem" {{ block.shopify_attributes }}>
                  <div class="q-referral-cta__benefit-icon" aria-hidden="true">
                    {%- liquid
                      assign benefit_icon = b.icon_hint | downcase | strip
                      unless benefit_icon == 'gift' or benefit_icon == 'sparkles' or benefit_icon == 'heart' or benefit_icon == 'check'
                        assign benefit_icon = 'star'
                      endunless
                    -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="{{ 'icons.svg' | asset_url }}#lucide-{{ benefit_icon }}"></use></svg>
                  </div>
                  <div class="q-referral-cta__benefit-copy">
                    {%- if b.title != blank -%}
                      <h3 class="q-referral-cta__benefit-title">{{ b.title | escape }}</h3>
                    {%- endif -%}
                    {%- if b.body != blank -%}
                      <p class="q-referral-cta__benefit-body">{{ b.body | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>

        {%- if has_actions -%}
          <div class="q-referral-cta__actions">
            {%- if has_primary -%}
              <a
                href="{{ s.primary_button_url | escape }}"
                class="q-btn q-btn--primary q-referral-cta__btn q-referral-cta__btn--primary"
                {% if s.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <span>{{ s.primary_button_label | escape }}</span>
              </a>
            {%- endif -%}

            {%- if has_secondary -%}
              <a
                href="{{ s.secondary_button_url | escape }}"
                class="q-btn q-btn--secondary q-btn--ghost q-referral-cta__btn q-referral-cta__btn--secondary"
                {% if s.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <span>{{ s.secondary_button_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

    {%- if wrap_card -%}
      </div>
    {%- endif -%}

  </div>

  <style>
    /* ===== Scoped styles (Quadratum-grade defaults) ===== */
    #rewards-cta-{{ section.id }}{
      padding: var(--q-ref-pad-y) min(var(--q-ref-pad-x), 8vw);
      background: var(--q-ref-bg);
      box-sizing: border-box;
      color: var(--q-ref-text);
    }

    /* Alignment helpers */
    #rewards-cta-{{ section.id }} .q-align-left{ text-align:start; }
    #rewards-cta-{{ section.id }} .q-align-center{ text-align:center; }

    /* Card wrapper (only in card layout) */
    #rewards-cta-{{ section.id }} .q-referral-cta__card{
      background: var(--q-ref-card-bg);
      border-radius: var(--q-ref-radius);
      box-shadow: var(--q-ref-shadow);
      padding: clamp(1rem, 2vw, 1.5rem);
      position: relative;
      overflow: hidden;
      border: 1px solid transparent;
    }
    #rewards-cta-{{ section.id }} .q-referral-cta__card.is-bordered{
      border-color: var(--q-ref-border);
    }

    /* Layout grid */
    #rewards-cta-{{ section.id }} .q-referral-cta__grid{
      display: grid;
      gap: clamp(1rem, 2.5vw, 1.75rem);
      align-items: start;
    }
    @media (min-width: 900px){
      #rewards-cta-{{ section.id }} .q-referral-cta__grid{
        grid-template-columns: minmax(0,1.3fr) minmax(0,.7fr);
        gap: clamp(1.25rem, 3vw, 2.25rem);
      }
      #rewards-cta-{{ section.id }}.q-referral-cta--strip .q-referral-cta__grid{
        grid-template-columns: minmax(0,1.4fr) minmax(0,.6fr);
      }
      #rewards-cta-{{ section.id }}.q-referral-cta--hero .q-referral-cta__grid.is-hero{
        grid-template-columns: minmax(0,1.35fr) minmax(0,.65fr);
      }
    }

    /* Hero spacing bump */
    #rewards-cta-{{ section.id }}.q-referral-cta--hero{
      padding-top: calc(var(--q-ref-pad-y) * 1.15);
      padding-bottom: calc(var(--q-ref-pad-y) * 1.15);
    }

    /* Badge / kicker / headings */
    #rewards-cta-{{ section.id }} .q-referral-cta__badge{ margin-bottom: .35rem; }
    #rewards-cta-{{ section.id }} .q-referral-cta__badge-pill{
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .35rem .65rem;
      border-radius: 999px;
      background: var(--q-ref-highlight);
      border: 1px solid var(--q-ref-border);
      color: var(--q-ref-text);
      font-size: .85rem;
      line-height: 1;
      font-weight: 600;
    }

    #rewards-cta-{{ section.id }} .q-referral-cta__kicker{
      margin: 0 0 .35rem 0;
      color: var(--q-ref-muted);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      font-size: .78rem;
    }

    #rewards-cta-{{ section.id }} .q-referral-cta__heading{
      margin: 0 0 .6rem 0;
      font-size: var(--q-ref-heading-fs);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    #rewards-cta-{{ section.id }} .q-referral-cta__body{
      color: var(--q-ref-muted);
      margin: 0;
    }
    #rewards-cta-{{ section.id }} .q-referral-cta__body p{ margin: 0 0 .75rem 0; }
    #rewards-cta-{{ section.id }} .q-referral-cta__body p:last-child{ margin-bottom: 0; }

    #rewards-cta-{{ section.id }} .q-referral-cta__highlight{
      margin: .85rem 0 0 0;
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .5rem .7rem;
      border-radius: 999px;
      background: var(--q-ref-highlight);
      border: 1px solid var(--q-ref-border);
      color: var(--q-ref-text);
      font-weight: 650;
      font-size: .95rem;
    }

    /* Benefits grid */
    #rewards-cta-{{ section.id }} .q-referral-cta__benefits{
      margin-top: 1rem;
      display: grid;
      gap: .75rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 700px){
      #rewards-cta-{{ section.id }} .q-referral-cta__benefits{
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (min-width: 1050px){
      #rewards-cta-{{ section.id }} .q-referral-cta__benefits{
        grid-template-columns: repeat(var(--q-ref-cols), minmax(0, 1fr));
      }
    }

    #rewards-cta-{{ section.id }} .q-referral-cta__benefit{
      display: grid;
      grid-template-columns: 36px minmax(0,1fr);
      gap: .75rem;
      align-items: start;
      padding: .9rem .95rem;
      border-radius: calc(var(--q-ref-radius) * .75);
      background: rgba(255,255,255,.0);
      border: 1px solid var(--q-ref-border);
    }

    #rewards-cta-{{ section.id }} .q-referral-cta__benefit-icon{
      width: 36px;
      height: 36px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--q-ref-accent) 14%, transparent);
      border: 1px solid color-mix(in srgb, var(--q-ref-accent) 25%, var(--q-ref-border));
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    #rewards-cta-{{ section.id }} .q-referral-cta__benefit-icon svg{display:block;width:20px;height:20px;color:var(--q-ref-accent);}

    #rewards-cta-{{ section.id }} .q-referral-cta__benefit-title{
      margin: 0 0 .2rem 0;
      font-size: 1rem;
      line-height: 1.2;
      font-weight: 750;
      letter-spacing: -0.01em;
    }
    #rewards-cta-{{ section.id }} .q-referral-cta__benefit-body{
      margin: 0;
      color: var(--q-ref-muted);
      font-size: .92rem;
      line-height: 1.35;
    }

    /* Actions */
    #rewards-cta-{{ section.id }} .q-referral-cta__actions{
      display: flex;
      flex-direction: column;
      gap: .6rem;
      align-items: stretch;
      justify-content: flex-start;
    }
    @media (min-width: 900px){
      #rewards-cta-{{ section.id }} .q-referral-cta__actions{
        align-items: {% if s.align == 'center' %}center{% else %}flex-start{% endif %};
      }
    }

    /* Button sizing + optional full-width mobile */
    #rewards-cta-{{ section.id }} .q-referral-cta__btn{
      width: 100%;
      justify-content: center;
      text-align: center;
      white-space: normal;
    }
    @media (min-width: 700px){
      #rewards-cta-{{ section.id }} .q-referral-cta__btn{
        width: auto;
        min-width: min(14rem,100%);
      }
    }
    {% if s.buttons_full_width_mobile == false %}
      #rewards-cta-{{ section.id }} .q-referral-cta__btn{ width: auto; align-self:{% if s.align == 'center' %}center{% else %}flex-start{% endif %}; }
    {% endif %}

    /* Strip layout: feels “intentional” */
    #rewards-cta-{{ section.id }}.q-referral-cta--strip{
      background: var(--q-ref-bg);
    }

    /* Program type nuance (subtle accent) */
    #rewards-cta-{{ section.id }}.q-referral-cta--program-referral .q-referral-cta__highlight{
      border-color: color-mix(in srgb, var(--q-ref-accent) 30%, var(--q-ref-border));
    }
    #rewards-cta-{{ section.id }}.q-referral-cta--program-loyalty .q-referral-cta__badge-pill{
      border-color: color-mix(in srgb, var(--q-ref-accent) 30%, var(--q-ref-border));
    }
    #rewards-cta-{{ section.id }}.q-referral-cta--program-hybrid .q-referral-cta__benefit-icon{
      background: color-mix(in srgb, var(--q-ref-accent) 18%, transparent);
    }

    #rewards-cta-{{ section.id }}{min-width:0;overflow-wrap:anywhere;font-family:var(--font-body,inherit);}
    #rewards-cta-{{ section.id }} .q-referral-cta__inner{max-width:var(--container-{{ s.max_width }},960px);margin-inline:auto;width:100%;min-width:0;box-sizing:border-box;}
    #rewards-cta-{{ section.id }} .q-referral-cta__grid>*{min-width:0;max-width:100%;}
    #rewards-cta-{{ section.id }}:not(.has-actions) .q-referral-cta__grid{grid-template-columns:minmax(0,1fr);}
    #rewards-cta-{{ section.id }} .q-referral-cta__card{--q-ref-bg:{{ v_card_bg }};}
    #rewards-cta-{{ section.id }} .q-referral-cta__heading,#rewards-cta-{{ section.id }} .q-referral-cta__benefit-title{font-family:var(--font-head,inherit);text-transform:var(--tt-head,none);}
    #rewards-cta-{{ section.id }} .q-referral-cta__btn{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.2rem;max-width:100%;box-sizing:border-box;border:var(--btn-border-w,1px) solid var(--q-ref-accent);border-radius:var(--btn-radius,12px);text-decoration:none;text-transform:var(--tt-btn,none);transition:opacity .12s ease,transform .12s ease;}
    #rewards-cta-{{ section.id }} .q-referral-cta__btn--primary{background:var(--q-ref-accent);color:var(--q-ref-accent-text);}
    #rewards-cta-{{ section.id }} .q-referral-cta__btn--secondary{background:transparent;color:var(--q-ref-text);border-color:currentColor;}
    #rewards-cta-{{ section.id }} .q-referral-cta__btn:hover{opacity:var(--btn-hover,.92);}
    #rewards-cta-{{ section.id }} .q-referral-cta__btn:active{transform:scale(var(--btn-active,.98));}
    #rewards-cta-{{ section.id }} .q-referral-cta__btn span{min-width:0;}
    #rewards-cta-{{ section.id }} a:focus-visible{outline:2px solid currentColor;outline-offset:3px;}
    #rewards-cta-{{ section.id }} .q-referral-cta__badge-pill,#rewards-cta-{{ section.id }} .q-referral-cta__highlight{max-width:100%;box-sizing:border-box;}
    @media(prefers-reduced-motion:reduce){#rewards-cta-{{ section.id }} .q-referral-cta__btn{transition:none;}#rewards-cta-{{ section.id }} .q-referral-cta__btn:active{transform:none;}}
    @media(forced-colors:active){#rewards-cta-{{ section.id }} .q-referral-cta__btn{border-color:ButtonText;}}
  </style>
</section>
  {%- elsif request.design_mode -%}
    <p role="status">Rewards program: add visible content or a labelled program link.</p>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <p role="status">Rewards program: enable the section to show its content.</p>
{%- endif -%}

{% schema %}
{
  "name": "3rd Party - Referral CTA",
  "class": "q-section q-section--referral-cta",
  "settings": [
    {"type": "paragraph", "content": "Content and links only. Configure a rewards service separately, add your program links, and use your actual program terms. This section does not issue points, credit or referral rewards."},
    { "type": "checkbox", "id": "enable_section", "label": "Enable section", "default": true },
    { "type": "text", "id": "aria_label", "label": "Section aria-label", "default": "Referral and rewards program" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Discover the program" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our rewards program" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Read the current rewards program details, eligibility requirements and terms.</p>" },
    { "type": "text", "id": "reward_highlight", "label": "Reward highlight", "default": "See current program terms" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "Join rewards program" },
    { "type": "url", "id": "primary_button_url", "label": "Primary button link"},
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Already a member? Sign in" },
    { "type": "url", "id": "secondary_button_url", "label": "Secondary button link" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "Open links in a new tab", "default": false },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "program_type",
      "label": "Program emphasis",
      "default": "referral",
      "options": [
        { "value": "referral", "label": "Referral program" },
        { "value": "loyalty", "label": "Loyalty / points program" },
        { "value": "hybrid", "label": "Both referral and loyalty" }
      ]
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "card",
      "options": [
        { "value": "card", "label": "Card" },
        { "value": "strip", "label": "Strip" },
        { "value": "hero", "label": "Hero" }
      ]
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "brand_soft",
      "options": [
        { "value": "surface", "label": "Surface" },
        { "value": "contrast", "label": "Contrast" },
        { "value": "brand", "label": "Brand solid" },
        { "value": "brand_soft", "label": "Brand soft / tint" }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Max content width",
      "default": "md",
