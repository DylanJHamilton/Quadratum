{
  "sections": {
    "northstar_1": {
      "type": "sub-banner-split",
      "settings": {
        "image_position": "right",
        "overlay_mode": "none",
        "min_height_vh": 45,
        "container_mode": "contained",
        "heading": "Talk to a system specialist.",
        "heading_level": "h1",
        "heading_size": "4xl",
        "subheading": "Questions about a configuration, an order or an upgrade. A person who builds these systems will answer.",
        "panel_bg_color": "#111821",
        "heading_color": "#F4F7F8",
        "subheading_color": "#9AA7B2",
        "text_alignment": "left",
        "image": "shopify://shop_images/northstar-nort06-axis-display-arm-catalog-v01.webp",
        "use_theme_spacing": false,
        "content_pad_y": "py-12 md:py-16",
        "content_pad_x": "px-6 md:px-10"
      },
      "blocks": {
        "ns_0": {
          "type": "button",
          "settings": {
            "label": "Send a message",
            "link": "/pages/northstar-contact",
            "button_mode": "solid",
            "use_theme_colors": true,
            "radius": 6
          }
        },
        "ns_1": {
          "type": "button",
          "settings": {
            "label": "(555) 018-4400",
            "link": "tel:5550184400",
            "button_mode": "outline",
            "radius": 6
          }
        }
      },
      "block_order": [
        "ns_0",
        "ns_1"
      ]
    },
    "northstar_2": {
      "type": "form-support-request",
      "settings": {
        "template_style": "split",
        "surface_style": "card",
        "split_media_side": "right",
        "kicker": "Contact",
        "heading": "Tell us about the work.",
        "subheading": "Explore the contact form. This is a fictional demonstration brand; do not include real order or payment details.",
        "success_text": "Your message has been submitted to the store owner.",
        "destination": "shopify_contact",
        "hidden_tags": "contact, northstar",
        "button_label": "Send message",
        "bg_color": "#080B10",
        "form_bg": "#111821",
        "input_radius": 6,
        "input_border": "#3A4A5A",
        "card_radius": 16,
        "split_image": "shopify://shop_images/northstar-home-hero-mobile-v01.webp",
        "input_background": "#1B2530"
      },
      "blocks": {
        "ns_0": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "contact[name]",
            "label": "Full name",
            "required": true,
            "width": "half"
          }
        },
        "ns_1": {
          "type": "field",
          "settings": {
            "field_type": "email",
            "name_attr": "contact[email]",
            "label": "Email",
            "required": true,
            "width": "half"
          }
        },
        "ns_2": {
          "type": "field",
          "settings": {
            "field_type": "select",
            "name_attr": "contact[topic]",
            "label": "Topic",
            "required": true,
            "width": "half",
            "options": "Choosing a system\nAn existing order\nWarranty claim\nUpgrade service\nStudio or team order\nSomething else"
          }
        },
        "ns_3": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "name_attr": "contact[order]",
            "label": "Order number",
            "required": false,
            "width": "half"
          }
        },
        "ns_4": {
          "type": "field",
          "settings": {
            "field_type": "textarea",
            "name_attr": "contact[body]",
            "label": "Message",
            "required": true,
            "width": "full"
          }
        }
      },
      "block_order": [
        "ns_0",
        "ns_1",
        "ns_2",
        "ns_3",
        "ns_4"
      ]
    },
