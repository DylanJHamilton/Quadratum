{%- liquid
  assign block_id = 'content-accordion-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'bordered'
  assign icon_style = block.settings.icon_style | default: 'plus_minus'
  assign item_count = block.settings.item_count | default: 5

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-accordion
    content-accordion--{{ layout_style }}
    content-accordion--width-{{ block_width }}
    content-accordion--align-{{ text_alignment }}
    content-accordion--icon-{{ icon_style }}
    {% unless show_on_desktop %} content-accordion--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-accordion--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-accordion--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-accordion--animate content-accordion--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-accordion-margin-top: {{ block.settings.margin_top }}px;
    --content-accordion-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-accordion-padding: {{ block.settings.padding }}px;
    --content-accordion-gap: {{ block.settings.gap }}px;
    --content-accordion-border-width: {{ block.settings.border_width }}px;
    --content-accordion-border-radius: {{ block.settings.border_radius }}px;
    --content-accordion-heading-color: {{ block.settings.heading_color }};
    --content-accordion-text-color: {{ block.settings.text_color }};
    --content-accordion-background-color: {{ block.settings.background_color }};
    --content-accordion-border-color: {{ block.settings.border_color }};
    --content-accordion-link-color: {{ block.settings.link_color }};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-accordion-margin-top);
      margin-bottom: var(--content-accordion-margin-bottom);
      padding: var(--content-accordion-padding);
      color: var(--content-accordion-text-color);
      background: var(--content-accordion-background-color);
    }

    #{{ block_id }}.content-accordion--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-accordion--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-accordion--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-accordion--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-accordion--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-accordion--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-accordion--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-accordion--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-accordion__items {
      display: flex;
      flex-direction: column;
      gap: var(--content-accordion-gap);
      width: 100%;
    }

    #{{ block_id }} .content-accordion__item {
      overflow: hidden;
      color: var(--content-accordion-text-color);
      background: transparent;
      border: 0 solid transparent;
      border-radius: var(--content-accordion-border-radius);
    }

    #{{ block_id }}.content-accordion--minimal .content-accordion__item {
      border-bottom: var(--content-accordion-border-width) solid var(--content-accordion-border-color);
      border-radius: 0;
    }

    #{{ block_id }}.content-accordion--bordered .content-accordion__item {
      border: var(--content-accordion-border-width) solid var(--content-accordion-border-color);
      background: transparent;
    }

    #{{ block_id }}.content-accordion--card .content-accordion__item {
      border: var(--content-accordion-border-width) solid var(--content-accordion-border-color);
      background: var(--content-accordion-background-color);
      box-shadow: 0 16px 44px rgba(0, 0, 0, 0.07);
    }

    #{{ block_id }}.content-accordion--flush .content-accordion__items {
      gap: 0;
    }

    #{{ block_id }}.content-accordion--flush .content-accordion__item {
      border-top: var(--content-accordion-border-width) solid var(--content-accordion-border-color);
      border-radius: 0;
    }

    #{{ block_id }}.content-accordion--flush .content-accordion__item:last-child {
      border-bottom: var(--content-accordion-border-width) solid var(--content-accordion-border-color);
    }

    #{{ block_id }} .content-accordion__summary {
      list-style: none;
      cursor: pointer;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 18px 20px;
      color: var(--content-accordion-heading-color);
      text-align: left;
      user-select: none;
    }

    #{{ block_id }} .content-accordion__summary::-webkit-details-marker {
      display: none;
    }

    #{{ block_id }}.content-accordion--align-center .content-accordion__summary {
      text-align: center;
    }

    #{{ block_id }}.content-accordion--align-right .content-accordion__summary {
      text-align: right;
    }

    #{{ block_id }} .content-accordion__summary:focus-visible {
      outline: 2px solid var(--content-accordion-link-color);
      outline-offset: -4px;
      border-radius: max(calc(var(--content-accordion-border-radius) - 2px), 0px);
    }

    #{{ block_id }} .content-accordion__item-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.6em;
      height: 1.6em;
      color: var(--content-accordion-link-color);
      line-height: 1;
    }

    #{{ block_id }} .content-accordion__heading {
      min-width: 0;
      color: var(--content-accordion-heading-color);
      line-height: 1.25;
      font-weight: inherit;
    }

    #{{ block_id }} .content-accordion__indicator {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.3em;
      height: 1.3em;
      color: var(--content-accordion-link-color);
      line-height: 1;
      transition: transform 180ms ease;
    }

    #{{ block_id }}.content-accordion--icon-none .content-accordion__indicator {
      display: none;
    }

    #{{ block_id }}.content-accordion--icon-plus_minus .content-accordion__indicator::before,
    #{{ block_id }}.content-accordion--icon-plus_minus .content-accordion__indicator::after {
      content: "";
      position: absolute;
      width: 0.85em;
      height: 2px;
      background: currentColor;
      border-radius: 999px;
    }

    #{{ block_id }}.content-accordion--icon-plus_minus .content-accordion__indicator::after {
      transform: rotate(90deg);
      transition: transform 180ms ease;
    }

    #{{ block_id }}.content-accordion--icon-plus_minus details[open] .content-accordion__indicator::after {
      transform: rotate(0deg);
    }

    #{{ block_id }}.content-accordion--icon-chevron .content-accordion__indicator::before {
      content: "";
      display: block;
      width: 0.65em;
      height: 0.65em;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-2px);
      transition: transform 180ms ease;
    }

    #{{ block_id }}.content-accordion--icon-chevron details[open] .content-accordion__indicator::before {
      transform: rotate(225deg) translateY(-2px);
    }

    #{{ block_id }} .content-accordion__content {
      padding: 0 20px 20px;
      color: var(--content-accordion-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-accordion__content p {
      margin-top: 0;
    }

    #{{ block_id }} .content-accordion__content p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-accordion__content a {
      color: var(--content-accordion-link-color);
      text-underline-offset: 0.2em;
    }

    #{{ block_id }}.content-accordion--minimal .content-accordion__summary,
    #{{ block_id }}.content-accordion--flush .content-accordion__summary {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }}.content-accordion--minimal .content-accordion__content,
    #{{ block_id }}.content-accordion--flush .content-accordion__content {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }}.content-accordion--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-accordion--animate-fade {
      animation-name: contentAccordionFade;
    }

    #{{ block_id }}.content-accordion--animate-fade_up {
      animation-name: contentAccordionFadeUp;
    }

    #{{ block_id }}.content-accordion--animate-fade_down {
      animation-name: contentAccordionFadeDown;
    }

    #{{ block_id }}.content-accordion--animate-fade_left {
      animation-name: contentAccordionFadeLeft;
    }

    #{{ block_id }}.content-accordion--animate-fade_right {
      animation-name: contentAccordionFadeRight;
    }

    #{{ block_id }}.content-accordion--animate-zoom {
      animation-name: contentAccordionZoom;
    }

    @keyframes contentAccordionFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentAccordionFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentAccordionFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentAccordionFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentAccordionFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentAccordionZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-accordion--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-accordion--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-accordion--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-accordion__summary {
        grid-template-columns: auto minmax(0, 1fr) auto;
        padding: 16px;
      }

      #{{ block_id }} .content-accordion__content {
        padding: 0 16px 16px;
      }

      #{{ block_id }}.content-accordion--minimal .content-accordion__summary,
      #{{ block_id }}.content-accordion--flush .content-accordion__summary,
      #{{ block_id }}.content-accordion--minimal .content-accordion__content,
      #{{ block_id }}.content-accordion--flush .content-accordion__content {
        padding-left: 0;
        padding-right: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-accordion--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-accordion__indicator,
      #{{ block_id }} .content-accordion__indicator::after,
      #{{ block_id }} .content-accordion__indicator::before {
        transition: none;
      }
    }
  </style>

  <div class="content-accordion__items" data-content-accordion-items>
    {%- for index in (1..8) -%}
      {%- if index <= item_count -%}
        {%- liquid
          assign heading_key = 'item_' | append: index | append: '_heading'
          assign content_key = 'item_' | append: index | append: '_content'
          assign icon_key = 'item_' | append: index | append: '_icon'
          assign open_key = 'item_' | append: index | append: '_open_by_default'

          assign item_heading = block.settings[heading_key]
          assign item_content = block.settings[content_key]
          assign item_icon = block.settings[icon_key]
          assign item_open_by_default = block.settings[open_key]

          assign item_is_open = false

          if block.settings.first_item_open and index == 1
            assign item_is_open = true
          endif

          if item_open_by_default
            assign item_is_open = true
          endif
        -%}

        {% if item_heading != blank or item_content != blank %}
          <details
            class="content-accordion__item"
            data-content-accordion-item
            {% if item_is_open %}open{% endif %}
          >
            <summary class="content-accordion__summary">
              {% if item_icon != blank %}
                <span class="content-accordion__item-icon" aria-hidden="true">
                  {{ item_icon }}
                </span>
              {% else %}
                <span class="content-accordion__item-icon" aria-hidden="true"></span>
              {% endif %}

              <span class="content-accordion__heading">
                {{ item_heading | escape }}
              </span>

              <span class="content-accordion__indicator" aria-hidden="true"></span>
            </summary>

            {% if item_content != blank %}
              <div class="content-accordion__content">
                {{ item_content }}
              </div>
            {% endif %}
          </details>
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% unless block.settings.allow_multiple_open %}
    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.contentAccordionReady === 'true') return;

        root.dataset.contentAccordionReady = 'true';

        const items = root.querySelectorAll('[data-content-accordion-item]');

        items.forEach((item) => {
          item.addEventListener('toggle', () => {
            if (!item.open) return;

            items.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.removeAttribute('open');
              }
            });
          });
        });
      })();
    </script>
  {% endunless %}
</div>

{% schema %}
{
  "name": "Content accordion",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple items open",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "first_item_open",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Indicator style",
      "default": "plus_minus",
      "options": [
        {
          "value": "plus_minus",
          "label": "Plus / minus"
        },
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "range",
      "id": "item_count",
      "label": "Number of items",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "bordered",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "flush",
          "label": "Flush"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "text",
      "id": "item_1_icon",
      "label": "Icon",
      "default": "?"
    },
    {
      "type": "text",
      "id": "item_1_heading",
      "label": "Heading",
      "default": "What makes this section useful?"
    },
    {
      "type": "richtext",
      "id": "item_1_content",
      "label": "Content",
      "default": "<p>This accordion lets merchants organize FAQs, policies, product details, support information, and other expandable content in a clean layout.</p>"
    },
    {
      "type": "checkbox",
      "id": "item_1_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "text",
      "id": "item_2_icon",
      "label": "Icon",
      "default": "↗"
    },
    {
      "type": "text",
      "id": "item_2_heading",
      "label": "Heading",
      "default": "Can I use this for FAQs?"
    },
    {
      "type": "richtext",
      "id": "item_2_content",
      "label": "Content",
      "default": "<p>Yes. FAQ content is handled as a preset of this block, so there is no need for a separate FAQ accordion block.</p>"
    },
    {
      "type": "checkbox",
      "id": "item_2_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 3"
    },
    {
      "type": "text",
      "id": "item_3_icon",
      "label": "Icon",
      "default": "✓"
    },
    {
      "type": "text",
      "id": "item_3_heading",
      "label": "Heading",
      "default": "Does it work on mobile?"
    },
    {
      "type": "richtext",
      "id": "item_3_content",
      "label": "Content",
      "default": "<p>The accordion is responsive, keyboard friendly, and uses native details and summary elements for reliable accessibility.</p>"
    },
    {
      "type": "checkbox",
      "id": "item_3_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 4"
    },
    {
      "type": "text",
      "id": "item_4_icon",
      "label": "Icon",
      "default": "★"
    },
    {
      "type": "text",
      "id": "item_4_heading",
      "label": "Heading",
      "default": "Can multiple items stay open?"
    },
    {
      "type": "richtext",
      "id": "item_4_content",
      "label": "Content",
      "default": "<p>Merchants can decide whether shoppers can open multiple accordion items at once or keep only one item open at a time.</p>"
    },
    {
      "type": "checkbox",
      "id": "item_4_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 5"
    },
    {
      "type": "text",
      "id": "item_5_icon",
      "label": "Icon",
      "default": "i"
    },
    {
      "type": "text",
      "id": "item_5_heading",
      "label": "Heading",
      "default": "Where should this block be used?"
    },
    {
      "type": "richtext",
      "id": "item_5_content",
      "label": "Content",
      "default": "<p>Use it on landing pages, product education pages, support sections, about pages, policy sections, and trust-building content areas.</p>"
    },
    {
      "type": "checkbox",
      "id": "item_5_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 6"
    },
    {
      "type": "text",
      "id": "item_6_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "item_6_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "item_6_content",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "item_6_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 7"
    },
    {
      "type": "text",
      "id": "item_7_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "item_7_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "item_7_content",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "item_7_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Item 8"
    },
    {
      "type": "text",
      "id": "item_8_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "item_8_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "item_8_content",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "item_8_open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border and radius"
    },
    {
      "type": "range",
      "id": "border_width",
