      "settings": {
        "region_label": "A shop built around the next conversation.",
        "image": "shopify://shop_images/ff-store-atmosphere.webp",
        "image_alt": "The front room of Folio & Field with tables of new titles and tall shelves",
        "image_position": "right",
        "overlay_mode": "none",
        "min_height_vh": 60,
        "min_height_vh_mobile": 50,
        "container_mode": "full",
        "content_max_w": "max-w-3xl",
        "heading": "A shop built around the next conversation.",
        "heading_level": "h1",
        "heading_size": "4xl",
        "subheading": "Folio & Field is an independent bookstore concept. The shelves are small on purpose, the notes are written by the people who read the books, and the back room is for talking about them.",
        "subheading_size": "lg",
        "heading_color": "#182E2A",
        "subheading_color": "#182E2A",
        "panel_bg_color": "#E5D8BE",
        "mobile_image_first": false,
        "text_alignment": "left"
      }
