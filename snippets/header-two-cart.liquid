{%- comment -%}
  Snippet: header-two-cart
  Reusable header cart trigger for Quadratum headers.

  Accepts:
    display       - 'icon' | 'icon_text'
    show_subtotal - boolean, render cart subtotal text

  Contracts preserved (DO NOT CHANGE):
    data-cart-drawer-open - opens global AJAX cart drawer
    data-cart-count       - updated by global cart system

  Usage:
    {% render 'header-two-cart', display: 'icon_text', show_subtotal: true %}
{%- endcomment -%}

{%- liquid
  assign cart_display = display | default: 'icon'
-%}

<button
  type="button"
  class="qtm-hm-icon-btn qtm-hm-cart{% if cart_display == 'icon_text' or show_subtotal %} qtm-hm-icon-btn--labeled{% endif %}"
  data-cart-drawer-open
  aria-label="Open cart"
>
  <span class="qtm-hm-cart__icon-wrap">
    <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 7H21L19.5 15H8L6 7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M6 7L5.4 4.8C5.17 3.98 4.43 3.4 3.58 3.4H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <circle cx="9.5" cy="19" r="1.2" fill="currentColor"/>
      <circle cx="18" cy="19" r="1.2" fill="currentColor"/>
    </svg>
    <span class="qtm-hm-cart__count" data-cart-count>{{ cart.item_count }}</span>
  </span>

  {%- if cart_display == 'icon_text' -%}
    <span class="qtm-hm-icon-btn__label">Cart</span>
  {%- endif -%}

  {%- if show_subtotal -%}
    <span class="qtm-hm-cart__subtotal">{{ cart.total_price | money }}</span>
  {%- endif -%}
</button>