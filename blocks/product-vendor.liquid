{%- liquid
  assign block_id = 'product-vendor-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign subtitle_source = block.settings.subtitle_source | default: 'vendor'

  assign subtitle_text = block.settings.custom_text
  assign subtitle_is_html = true

  if subtitle_source == 'vendor'
    assign subtitle_text = product_context.vendor
    assign subtitle_is_html = false
  elsif subtitle_source == 'metafield'
    assign namespace = block.settings.metafield_namespace | strip
    assign key = block.settings.metafield_key | strip

    if namespace != blank and key != blank
      assign metafield_value = product_context.metafields[namespace][key]

      if metafield_value != blank
        assign subtitle_text = metafield_value | metafield_text
        assign subtitle_is_html = false
      endif
    endif
  elsif subtitle_source == 'tagline'
    assign subtitle_is_html = false
    assign subtitle_text = product_context.metafields.custom.tagline | metafield_text

    if subtitle_text == blank
      assign subtitle_text = product_context.metafields.product.tagline | metafield_text
    endif

    if subtitle_text == blank
      assign subtitle_text = block.settings.custom_text
      assign subtitle_is_html = true
    endif
  endif

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{% if subtitle_text != blank or request.design_mode %}
  <div
    id="{{ block_id }}"
    class="
      product-vendor
      product-vendor--width-{{ width }}
      product-vendor--align-{{ alignment }}
      product-vendor--style-{{ block.settings.subtitle_style }}
      {% unless show_on_desktop or request.design_mode %} product-vendor--hide-desktop{% endunless %}
      {% unless show_on_tablet or request.design_mode %} product-vendor--hide-tablet{% endunless %}
      {% unless show_on_mobile or request.design_mode %} product-vendor--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-vendor--animate product-vendor--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-vendor-margin-top: {{ block.settings.margin_top }}px;
      --product-vendor-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-vendor-padding: {{ block.settings.padding }}px;
      --product-vendor-font-size-desktop: {{ block.settings.font_size_desktop }}px;
      --product-vendor-font-size-mobile: {{ block.settings.font_size_mobile }}px;
      --product-vendor-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
      --product-vendor-letter-spacing: {{ block.settings.letter_spacing }}px;
      --product-vendor-color: {{ block.settings.text_color }};
      --product-vendor-background: {{ block.settings.background_color }};
      --product-vendor-border-color: {{ block.settings.border_color }};
      --product-vendor-border-width: {{ block.settings.border_width }}px;
      --product-vendor-border-radius: {{ block.settings.border_radius }}px;
    "
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"

  >
    <style>
      #{{ block_id }} {
        min-width: 0;
        box-sizing: border-box;
        overflow-wrap: anywhere;
        width: 100%;
        margin-top: var(--product-vendor-margin-top);
        margin-bottom: var(--product-vendor-margin-bottom);
        padding: var(--product-vendor-padding);
        color: var(--product-vendor-color);
        background: transparent;
      }

      #{{ block_id }}.product-vendor--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-vendor--width-small {
        max-width: 640px;
      }

      #{{ block_id }}.product-vendor--width-medium {
        max-width: 820px;
      }

      #{{ block_id }}.product-vendor--width-large {
        max-width: 1040px;
      }

      #{{ block_id }}.product-vendor--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-vendor--align-left {
        margin-left: 0;
        margin-right: auto;
        text-align: left;
      }

      #{{ block_id }}.product-vendor--align-center {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      #{{ block_id }}.product-vendor--align-right {
        margin-left: auto;
        margin-right: 0;
        text-align: right;
      }

      #{{ block_id }} .product-vendor__text {
        margin: 0;
        color: var(--product-vendor-color);
        font-size: var(--product-vendor-font-size-desktop);
        line-height: var(--product-vendor-line-height);
        letter-spacing: var(--product-vendor-letter-spacing);
        overflow-wrap: anywhere;
      }

      #{{ block_id }}.product-vendor--style-badge .product-vendor__text {
        display: inline-block;
        min-width: 0;
        max-width: 100%;
        width: fit-content;
        padding: 8px 12px;
        background: var(--product-vendor-background);
        border: var(--product-vendor-border-width) solid var(--product-vendor-border-color);
        border-radius: var(--product-vendor-border-radius);
      }

      #{{ block_id }}.product-vendor--style-card .product-vendor__text {
        display: block;
        padding: 16px 18px;
        background: var(--product-vendor-background);
        border: var(--product-vendor-border-width) solid var(--product-vendor-border-color);
        border-radius: var(--product-vendor-border-radius);
      }

      #{{ block_id }}.product-vendor--style-minimal .product-vendor__text {
        opacity: 0.84;
      }

      #{{ block_id }}.product-vendor--align-center.product-vendor--style-badge .product-vendor__text {
        margin-left: auto;
        margin-right: auto;
      }

      #{{ block_id }}.product-vendor--align-right.product-vendor--style-badge .product-vendor__text {
        margin-left: auto;
        margin-right: 0;
      }

      #{{ block_id }}.product-vendor--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-vendor--animate-fade {
        animation-name: productVendorFade;
      }

      #{{ block_id }}.product-vendor--animate-fade_up {
        animation-name: productVendorFadeUp;
      }

      #{{ block_id }}.product-vendor--animate-fade_down {
        animation-name: productVendorFadeDown;
      }

      #{{ block_id }}.product-vendor--animate-fade_left {
        animation-name: productVendorFadeLeft;
      }

      #{{ block_id }}.product-vendor--animate-fade_right {
        animation-name: productVendorFadeRight;
      }

      #{{ block_id }}.product-vendor--animate-zoom {
        animation-name: productVendorZoom;
      }

      @keyframes productVendorFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productVendorFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productVendorFadeDown {
        from {
          opacity: 0;
          transform: translateY(-20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productVendorFadeLeft {
        from {
          opacity: 0;
          transform: translateX(20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productVendorFadeRight {
        from {
          opacity: 0;
          transform: translateX(-20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productVendorZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-vendor--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-vendor--hide-tablet {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }} .product-vendor__text { font-size: var(--product-vendor-font-size-mobile); }
        #{{ block_id }}.product-vendor--hide-mobile {
          display: none !important;
        }

        #{{ block_id }}.product-vendor--style-card .product-vendor__text {
          padding: 14px 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-vendor--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }
      }

      #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
      #{{ block_id }} :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
      #{{ block_id }}:focus-within { opacity: 1; animation: none; transform: none; }
          #{{ block_id }} .product-vendor__text > :first-child { margin-top: 0; }
      #{{ block_id }} .product-vendor__text > :last-child { margin-bottom: 0; }
    </style>

    {% if subtitle_text == blank %}
      <p class="product-vendor__text">Configure this block's content for the selected product.</p>
    {% elsif block.settings.render_as_paragraph and subtitle_is_html == false %}
      <p class="product-vendor__text">{{ subtitle_text | escape }}</p>
    {% else %}
      <div class="product-vendor__text">
        {% if subtitle_is_html %}{{ subtitle_text }}{% else %}{{ subtitle_text | escape }}{% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product vendor",
  "settings": [
    {
      "type": "header",
      "content": "Vendor content"
    },
    {
      "type": "select",
      "id": "subtitle_source",
      "label": "Content source",
      "default": "vendor",
      "options": [
        {
          "value": "vendor",
          "label": "Product vendor"
        },
        {
          "value": "custom",
          "label": "Custom text"
        },
        {
          "value": "metafield",
          "label": "Product metafield"
        },
        {
          "value": "tagline",
          "label": "Product tagline metafield"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "custom_text",
      "label": "Custom text",
      "default": "<p>A short product tagline or marketing subtitle that helps shoppers understand the product faster.</p>"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "subtitle"
    },
    {
      "type": "checkbox",
      "id": "render_as_paragraph",
      "label": "Wrap plain text in a paragraph",
      "info": "Rich text keeps its own paragraph and list markup.",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "subtitle_style",
      "label": "Subtitle style",
      "default": "minimal",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Desktop font size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 100,
      "max": 190,
      "step": 5,
      "unit": "%",
      "default": 150
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Badge/card background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Badge/card border",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Vendor",
      "settings": {
        "subtitle_source": "vendor",
        "custom_text": "<p>A short product tagline that supports the main product title.</p>",
        "metafield_namespace": "custom",
        "metafield_key": "tagline",
        "render_as_paragraph": true,
        "subtitle_style": "minimal",
        "font_size_desktop": 18,
        "font_size_mobile": 16,
        "line_height": 150,
        "letter_spacing": 0,
        "text_color": "#444444",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 18,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Vendor Badge",
      "settings": {
        "subtitle_source": "vendor",
        "custom_text": "<p>Designed to help shoppers quickly understand the main benefit of this product.</p>",
        "metafield_namespace": "custom",
        "metafield_key": "subtitle",
        "render_as_paragraph": true,
        "subtitle_style": "card",
        "font_size_desktop": 18,
        "font_size_mobile": 16,
        "line_height": 150,
        "letter_spacing": 0,
        "text_color": "#444444",
        "background_color": "#f7f7f7",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 18,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 16,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "fade_up"
      }
    },
    {
      "name": "Vendor Card",
      "settings": {
        "subtitle_source": "vendor",
        "custom_text": "<p>Simple supporting product copy.</p>",
        "metafield_namespace": "custom",
        "metafield_key": "subtitle",
        "render_as_paragraph": true,
        "subtitle_style": "minimal",
        "font_size_desktop": 15,
        "font_size_mobile": 14,
        "line_height": 145,
        "letter_spacing": 0,
        "text_color": "#555555",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 18,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    }
  ]
}
{% endschema %}
