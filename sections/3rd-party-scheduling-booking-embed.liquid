{% comment %}Native Shopify contact request; original layout retained.{% endcomment %}
{%- liquid
  assign s = section.settings
  assign has_embed = true
  assign has_help = false
  if s.show_help_link and s.help_url != blank and s.help_text != blank
    assign has_help = true
  endif
  assign max_width = 'var(--container-md,960px)'
  case s.max_width
    when 'sm'
      assign max_width = 'var(--container-sm,720px)'
    when 'lg'
      assign max_width = 'var(--container-lg,1152px)'
  endcase
  assign visible = false
  if s.enable_section
    if has_embed or has_help
      assign visible = true
    endif
  endif
-%}
{%- if visible -%}
<section id="third-party-scheduling-embed-{{ section.id }}" class="q-section q-third-party-scheduling-embed q-section--bg-{{ s.background_style }}" aria-label="{{ s.aria_label | default: s.heading | default: 'Contact and booking' | escape }}" data-q-third-party="scheduling-embed" style="--q-embed-width:{{ max_width }};--q-embed-min-h:{{ s.iframe_min_height | default: 640 }}px;--q-embed-min-h-mobile:{{ s.iframe_mobile_min_height | default: 560 }}px;">
  <div class="q-section__inner">
    {%- if s.kicker != blank or s.heading != blank or s.description != blank -%}
      <header class="q-section__header q-section__header--{{ s.content_align }}">
        {%- if s.kicker != blank -%}<p class="q-section__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="q-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.description != blank -%}<div class="q-section__body"><p>{{ s.description | escape | newline_to_br }}</p></div>{%- endif -%}
      </header>
    {%- endif -%}
    {%- if has_embed -%}<div class="q-third-party-scheduling-embed__wrap q-third-party-scheduling-embed__wrap--{{ s.content_align }}">
      <div class="q-third-party-scheduling-embed__surface" role="group" aria-label="Appointment request" tabindex="0">
        <div class="q-third-party-scheduling-embed__calendar">{% render 'native-inquiry', id: section.id, request_date: true %}</div>
      </div>
    </div>{%- endif -%}
    {%- if has_help -%}<div class="q-third-party-scheduling-embed__help q-section__header--{{ s.content_align }}"><a href="{{ s.help_url | escape }}" class="q-third-party-scheduling-embed__help-link">{{ s.help_text | escape }}</a></div>{%- endif -%}
  </div>
  <style data-q-embed-style>

    #third-party-scheduling-embed-{{ section.id }}{font-family:var(--font-body,inherit);color:var(--q-section-fg,var(--c-text,#111));overflow-wrap:anywhere;padding:48px 24px}
    #third-party-scheduling-embed-{{ section.id }} .q-section__inner{box-sizing:border-box;max-width:var(--q-embed-width);margin-inline:auto;min-width:0}
    #third-party-scheduling-embed-{{ section.id }} .q-section__header{display:grid;gap:.75rem;margin-bottom:1rem}
    #third-party-scheduling-embed-{{ section.id }} .q-section__header--center{text-align:center;justify-items:center}
    #third-party-scheduling-embed-{{ section.id }} .q-section__header--left{text-align:start;justify-items:start}
    #third-party-scheduling-embed-{{ section.id }} :is(.q-section__kicker,.q-section__heading,.q-section__body p){margin:0}
    #third-party-scheduling-embed-{{ section.id }} .q-section__heading{font-family:var(--font-head,inherit);font-size:var(--fs-h2,2rem);line-height:1.2;color:inherit}
    #third-party-scheduling-embed-{{ section.id }} .q-section__body{max-width:68ch;color:var(--q-section-muted,var(--c-muted,#666))}
    #third-party-scheduling-embed-{{ section.id }} .q-section__kicker{letter-spacing:.08em;text-transform:uppercase;font-weight:700;font-size:.85em;color:var(--q-section-muted,var(--c-muted,#666))}

    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__wrap{width:100%;min-width:0}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__wrap--center{display:flex;justify-content:center}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__calendar{position:relative;width:100%;min-width:0}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__help{margin-top:1rem}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__help-link{display:inline-flex;box-sizing:border-box;align-items:center;justify-content:center;min-height:44px;max-width:100%;padding:.65rem .9rem;border:1px solid currentColor;border-radius:999px;color:inherit;background:transparent;text-align:center;text-decoration:underline;text-underline-offset:.2em}

    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__surface{box-sizing:border-box;min-width:0;width:100%;max-width:100%;border-radius:16px;padding:16px;background:var(--c-bg,#fff);color:var(--c-text,#111);border:1px solid var(--c-border,#d1d5db);box-shadow:0 10px 30px rgb(0 0 0 / .08);overflow:auto}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__calendar>*{max-width:100%;box-sizing:border-box}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__calendar iframe{display:block;width:100%;max-width:100%;border:0;min-height:var(--q-embed-min-h)}
    #third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__surface:focus-visible,#third-party-scheduling-embed-{{ section.id }} a:focus-visible,#third-party-scheduling-embed-{{ section.id }} iframe:focus-visible{outline:3px solid currentColor;outline-offset:3px}
    @media(max-width:749px){#third-party-scheduling-embed-{{ section.id }}{padding-inline:16px}#third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__surface{padding:12px}#third-party-scheduling-embed-{{ section.id }} .q-third-party-scheduling-embed__calendar iframe{min-height:var(--q-embed-min-h-mobile)}}
  </style>
</section>
{%- endif -%}
{%- if request.design_mode -%}
  {%- unless visible -%}<p role="status">Booking embed: enable the section and paste your provider's configured HTML/iframe/script snippet. A configured help link can also be shown.</p>{%- endunless -%}
{%- endif -%}


{% schema %}
{
  "name": "Appointment request",
  "tag": "div",
  "class": "q-third-party-scheduling-embed",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses Shopify’s native contact form. This sends an inquiry; it does not reserve a time, create a booking, or connect to a CRM."
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request an appointment"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Send your preferred date and requirements. We will contact you to confirm availability."
    },
    {
      "type": "checkbox",
      "id": "show_help_link",
      "label": "Show help link",
      "default": false
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help link text",
      "default": "Contact us for help with your request."
    },
    {
      "type": "text",
      "id": "help_url",
      "label": "Help link URL"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "surface",
      "options": [
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "contrast",
          "label": "Contrast"
        },
        {
          "value": "brand",
          "label": "Brand color"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "md",
      "options": [
        {
          "value": "sm",
          "label": "Narrow"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria label",
      "default": "Appointment request"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Appointment request",
      "category": "3rd party integrations",
      "settings": {
        "kicker": "Get in touch",
        "heading": "Request an appointment",
        "description": "Send your preferred date and requirements. We will contact you to confirm availability."
      }
    }
  ]
}
{% endschema %}
