{% liquid
  assign threshold = section_settings.progress_threshold | default: 75
  assign threshold_cents = threshold | times: 100
  assign current_cents = cart.total_price | default: 0
  assign remaining_cents = threshold_cents | minus: current_cents
  assign progress_percent = 0

  if threshold_cents > 0
    assign progress_percent = current_cents | times: 100 | divided_by: threshold_cents
  endif

  if progress_percent > 100
    assign progress_percent = 100
  endif

  assign progress_message = section_settings.progress_message | default: 'Spend [amount] more for free shipping'
  assign complete_message = section_settings.progress_complete_message | default: 'You unlocked free shipping'

  assign remaining_money = remaining_cents | money
  assign rendered_message = progress_message | replace: '[amount]', remaining_money

  if remaining_cents <= 0
    assign rendered_message = complete_message
  endif
%}

<div
  class="qtmHeaderFour__progress"
  role="region"
  aria-label="{{ rendered_message | escape }}"
>
  <div class="qtmHeaderFour__progressText">
    {{ rendered_message }}
  </div>

  <div
    class="qtmHeaderFour__progressTrack"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="{{ progress_percent }}"
    aria-label="{{ rendered_message | escape }}"
  >
    <span
      class="qtmHeaderFour__progressFill"
      style="width: {{ progress_percent }}%;"
    ></span>
  </div>
</div>