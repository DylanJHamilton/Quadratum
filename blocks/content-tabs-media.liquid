{%- liquid
  assign block_id = 'content-tabs-media-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'media_right'
  assign tab_count = block.settings.tab_count | default: 3

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-tabs-media
    content-tabs-media--{{ layout_style }}
    content-tabs-media--width-{{ block_width }}
    content-tabs-media--align-{{ text_alignment }}
    {% unless show_on_desktop %} content-tabs-media--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-tabs-media--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-tabs-media--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-tabs-media--animate content-tabs-media--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-tabs-media-margin-top: {{ block.settings.margin_top }}px;
    --content-tabs-media-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-tabs-media-padding: {{ block.settings.padding }}px;
    --content-tabs-media-gap: {{ block.settings.gap }}px;
    --content-tabs-media-border-width: {{ block.settings.border_width }}px;
    --content-tabs-media-border-radius: {{ block.settings.border_radius }}px;
    --content-tabs-media-heading-color: {{ block.settings.heading_color }};
    --content-tabs-media-text-color: {{ block.settings.text_color }};
    --content-tabs-media-background-color: {{ block.settings.background_color }};
    --content-tabs-media-border-color: {{ block.settings.border_color }};
    --content-tabs-media-link-color: {{ block.settings.link_color }};
    --content-tabs-media-tab-background: {{ block.settings.tab_background_color }};
    --content-tabs-media-active-tab-background: {{ block.settings.active_tab_background_color }};
    --content-tabs-media-active-tab-text: {{ block.settings.active_tab_text_color }};
    --content-tabs-media-card-background: {{ block.settings.card_background_color }};
    --content-tabs-media-media-background: {{ block.settings.media_background_color }};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-tabs-media-margin-top);
      margin-bottom: var(--content-tabs-media-margin-bottom);
      padding: var(--content-tabs-media-padding);
      color: var(--content-tabs-media-text-color);
      background: var(--content-tabs-media-background-color);
    }

    #{{ block_id }}.content-tabs-media--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-tabs-media--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-tabs-media--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-tabs-media--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-tabs-media--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-tabs-media--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-tabs-media--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-tabs-media--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-tabs-media__inner {
      display: grid;
      gap: var(--content-tabs-media-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }}.content-tabs-media--media_left .content-tabs-media__inner,
    #{{ block_id }}.content-tabs-media--media_right .content-tabs-media__inner,
    #{{ block_id }}.content-tabs-media--split .content-tabs-media__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    #{{ block_id }}.content-tabs-media--media_left .content-tabs-media__media-wrap {
      order: 1;
    }

    #{{ block_id }}.content-tabs-media--media_left .content-tabs-media__content-wrap {
      order: 2;
    }

    #{{ block_id }}.content-tabs-media--media_right .content-tabs-media__content-wrap {
      order: 1;
    }

    #{{ block_id }}.content-tabs-media--media_right .content-tabs-media__media-wrap {
      order: 2;
    }

    #{{ block_id }}.content-tabs-media--media_top .content-tabs-media__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }} .content-tabs-media__content-wrap {
      min-width: 0;
      display: grid;
      gap: var(--content-tabs-media-gap);
    }

    #{{ block_id }} .content-tabs-media__list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }}.content-tabs-media--align-center .content-tabs-media__list {
      justify-content: center;
    }

    #{{ block_id }}.content-tabs-media--align-right .content-tabs-media__list {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-tabs-media__tab {
      appearance: none;
      cursor: pointer;
      min-height: 42px;
      padding: 11px 16px;
      border: var(--content-tabs-media-border-width) solid var(--content-tabs-media-border-color);
      border-radius: var(--content-tabs-media-border-radius);
      background: var(--content-tabs-media-tab-background);
      color: var(--content-tabs-media-heading-color);
      line-height: 1.2;
      text-align: inherit;
      transition: background 180ms ease, color 180ms ease, border-color 180ms ease, opacity 180ms ease;
    }

    #{{ block_id }} .content-tabs-media__tab:hover {
      opacity: 0.78;
    }

    #{{ block_id }} .content-tabs-media__tab[aria-selected="true"] {
      background: var(--content-tabs-media-active-tab-background);
      color: var(--content-tabs-media-active-tab-text);
      border-color: var(--content-tabs-media-link-color);
    }

    #{{ block_id }} .content-tabs-media__tab:focus-visible {
      outline: 2px solid var(--content-tabs-media-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-tabs-media__panels {
      min-width: 0;
      width: 100%;
    }

    #{{ block_id }} .content-tabs-media__panel {
      display: none;
      min-width: 0;
      color: var(--content-tabs-media-text-color);
      background: var(--content-tabs-media-card-background);
      border: var(--content-tabs-media-border-width) solid var(--content-tabs-media-border-color);
      border-radius: var(--content-tabs-media-border-radius);
      padding: 28px;
    }

    #{{ block_id }}.content-tabs-media--split .content-tabs-media__panel {
      background: transparent;
      border-color: transparent;
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }} .content-tabs-media__panel.is-active {
      display: block;
    }

    #{{ block_id }} .content-tabs-media__panel-inner {
      display: grid;
      gap: 14px;
      min-width: 0;
    }

    #{{ block_id }} .content-tabs-media__heading {
      margin: 0;
      color: var(--content-tabs-media-heading-color);
      line-height: 1.1;
    }

    #{{ block_id }} .content-tabs-media__text {
      color: var(--content-tabs-media-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-tabs-media__text p {
      margin-top: 0;
    }

    #{{ block_id }} .content-tabs-media__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-tabs-media__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      padding: 11px 16px;
      color: var(--content-tabs-media-link-color);
      border: var(--content-tabs-media-border-width) solid currentColor;
      border-radius: var(--content-tabs-media-border-radius);
      text-decoration: none;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-tabs-media__button:hover {
      opacity: 0.78;
      transform: translateY(-1px);
    }

    #{{ block_id }}.content-tabs-media--align-center .content-tabs-media__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-tabs-media--align-right .content-tabs-media__button {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-tabs-media__media-wrap {
      min-width: 0;
      width: 100%;
    }

    #{{ block_id }} .content-tabs-media__media-panel {
      display: none;
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .content-tabs-media__media-panel.is-active {
      display: block;
    }

    #{{ block_id }} .content-tabs-media__media-card {
      width: 100%;
      overflow: hidden;
      background: var(--content-tabs-media-media-background);
      border: var(--content-tabs-media-border-width) solid var(--content-tabs-media-border-color);
      border-radius: var(--content-tabs-media-border-radius);
    }

    #{{ block_id }} .content-tabs-media__image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    #{{ block_id }} .content-tabs-media__video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
    }

    #{{ block_id }} .content-tabs-media__media-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 320px;
      padding: 32px;
      color: var(--content-tabs-media-text-color);
      background: var(--content-tabs-media-media-background);
      text-align: center;
    }

    #{{ block_id }}.content-tabs-media--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-tabs-media--animate-fade {
      animation-name: contentTabsMediaFade;
    }

    #{{ block_id }}.content-tabs-media--animate-fade_up {
      animation-name: contentTabsMediaFadeUp;
    }

    #{{ block_id }}.content-tabs-media--animate-fade_down {
      animation-name: contentTabsMediaFadeDown;
    }

    #{{ block_id }}.content-tabs-media--animate-fade_left {
      animation-name: contentTabsMediaFadeLeft;
    }

    #{{ block_id }}.content-tabs-media--animate-fade_right {
      animation-name: contentTabsMediaFadeRight;
    }

    #{{ block_id }}.content-tabs-media--animate-zoom {
      animation-name: contentTabsMediaZoom;
    }

    @keyframes contentTabsMediaFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentTabsMediaFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTabsMediaFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTabsMediaFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTabsMediaFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTabsMediaZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-tabs-media--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-tabs-media--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-tabs-media--media_left .content-tabs-media__inner,
      #{{ block_id }}.content-tabs-media--media_right .content-tabs-media__inner,
      #{{ block_id }}.content-tabs-media--split .content-tabs-media__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .content-tabs-media__content-wrap,
      #{{ block_id }} .content-tabs-media__media-wrap {
        order: initial;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-tabs-media--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-tabs-media--media_left .content-tabs-media__inner,
      #{{ block_id }}.content-tabs-media--media_right .content-tabs-media__inner,
      #{{ block_id }}.content-tabs-media--split .content-tabs-media__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .content-tabs-media__content-wrap,
      #{{ block_id }} .content-tabs-media__media-wrap {
        order: initial;
      }

      #{{ block_id }} .content-tabs-media__list {
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
      }

      #{{ block_id }} .content-tabs-media__tab {
        flex: 0 0 auto;
        scroll-snap-align: start;
        white-space: nowrap;
      }

      #{{ block_id }} .content-tabs-media__panel {
        padding: 20px;
      }

      #{{ block_id }}.content-tabs-media--split .content-tabs-media__panel {
        padding-left: 0;
        padding-right: 0;
      }

      #{{ block_id }} .content-tabs-media__media-placeholder {
        min-height: 240px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-tabs-media--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-tabs-media__tab,
      #{{ block_id }} .content-tabs-media__button {
        transition: none;
      }

      #{{ block_id }} .content-tabs-media__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-tabs-media__inner">
    <div class="content-tabs-media__content-wrap">
      <div
        class="content-tabs-media__list"
        role="tablist"
        aria-label="{{ block.settings.aria_label | escape }}"
      >
        {%- for index in (1..6) -%}
          {%- if index <= tab_count -%}
            {%- liquid
              assign label_key = 'tab_' | append: index | append: '_label'
              assign tab_label = block.settings[label_key]
            -%}

            {% if tab_label != blank %}
              <button
                class="content-tabs-media__tab"
                id="{{ block_id }}-tab-{{ index }}"
                type="button"
                role="tab"
                aria-selected="{% if index == 1 %}true{% else %}false{% endif %}"
                aria-controls="{{ block_id }}-panel-{{ index }}"
                tabindex="{% if index == 1 %}0{% else %}-1{% endif %}"
                data-content-tabs-media-tab
                data-content-tabs-media-index="{{ index }}"
              >
                {{ tab_label | escape }}
              </button>
            {% endif %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="content-tabs-media__panels">
        {%- for index in (1..6) -%}
          {%- if index <= tab_count -%}
            {%- liquid
              assign label_key = 'tab_' | append: index | append: '_label'
              assign heading_key = 'tab_' | append: index | append: '_heading'
              assign text_key = 'tab_' | append: index | append: '_text'
              assign button_label_key = 'tab_' | append: index | append: '_button_label'
              assign button_url_key = 'tab_' | append: index | append: '_button_url'

              assign tab_label = block.settings[label_key]
              assign tab_heading = block.settings[heading_key]
              assign tab_text = block.settings[text_key]
              assign tab_button_label = block.settings[button_label_key]
              assign tab_button_url = block.settings[button_url_key]
            -%}

            {% if tab_label != blank %}
              <div
                class="content-tabs-media__panel {% if index == 1 %}is-active{% endif %}"
                id="{{ block_id }}-panel-{{ index }}"
                role="tabpanel"
                aria-labelledby="{{ block_id }}-tab-{{ index }}"
                {% unless index == 1 %}hidden{% endunless %}
                data-content-tabs-media-panel
                data-content-tabs-media-index="{{ index }}"
              >
                <div class="content-tabs-media__panel-inner">
                  {% if tab_heading != blank %}
                    <h3 class="content-tabs-media__heading">
                      {{ tab_heading | escape }}
                    </h3>
                  {% endif %}

                  {% if tab_text != blank %}
                    <div class="content-tabs-media__text">
                      {{ tab_text }}
                    </div>
                  {% endif %}

                  {% if tab_button_label != blank and tab_button_url != blank %}
                    <a class="content-tabs-media__button" href="{{ tab_button_url }}">
                      {{ tab_button_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="content-tabs-media__media-wrap" aria-live="polite">
      {%- for index in (1..6) -%}
        {%- if index <= tab_count -%}
          {%- liquid
            assign label_key = 'tab_' | append: index | append: '_label'
            assign image_key = 'tab_' | append: index | append: '_image'
            assign image_alt_key = 'tab_' | append: index | append: '_image_alt'
            assign video_key = 'tab_' | append: index | append: '_video_url'

            assign tab_label = block.settings[label_key]
            assign tab_image = block.settings[image_key]
            assign tab_image_alt = block.settings[image_alt_key]
            assign tab_video = block.settings[video_key]
          -%}

          {% if tab_label != blank %}
            <div
              class="content-tabs-media__media-panel {% if index == 1 %}is-active{% endif %}"
              {% unless index == 1 %}hidden{% endunless %}
              data-content-tabs-media-media
              data-content-tabs-media-index="{{ index }}"
            >
              <div class="content-tabs-media__media-card">
                {% if tab_video != blank %}
                  {{
                    tab_video
                    | external_video_url
                    | external_video_tag:
                      class: 'content-tabs-media__video',
                      loading: 'lazy'
                  }}
                {% elsif tab_image != blank %}
                  {{
                    tab_image
                    | image_url: width: 1400
                    | image_tag:
                      class: 'content-tabs-media__image',
                      loading: 'lazy',
                      alt: tab_image_alt
                  }}
                {% else %}
                  <div class="content-tabs-media__media-placeholder">
                    Add an image or video for {{ tab_label | escape }}.
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.contentTabsMediaReady === 'true') return;

      root.dataset.contentTabsMediaReady = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-content-tabs-media-tab]'));
      const panels = Array.from(root.querySelectorAll('[data-content-tabs-media-panel]'));
      const mediaPanels = Array.from(root.querySelectorAll('[data-content-tabs-media-media]'));

      if (!tabs.length || !panels.length) return;

      const activateTab = (tab) => {
        const index = tab.dataset.contentTabsMediaIndex;

        tabs.forEach((currentTab) => {
          const isActive = currentTab === tab;
          currentTab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          currentTab.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.contentTabsMediaIndex === index;
          panel.classList.toggle('is-active', isActive);

          if (isActive) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });

        mediaPanels.forEach((mediaPanel) => {
          const isActive = mediaPanel.dataset.contentTabsMediaIndex === index;
          mediaPanel.classList.toggle('is-active', isActive);

          if (isActive) {
            mediaPanel.removeAttribute('hidden');
          } else {
            mediaPanel.setAttribute('hidden', '');
          }
        });
      };

      tabs.forEach((tab, position) => {
        tab.addEventListener('click', () => {
          activateTab(tab);
        });

        tab.addEventListener('keydown', (event) => {
          let nextPosition = position;

          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            event.preventDefault();
            nextPosition = position + 1 >= tabs.length ? 0 : position + 1;
          }

          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            event.preventDefault();
            nextPosition = position - 1 < 0 ? tabs.length - 1 : position - 1;
          }

          if (event.key === 'Home') {
            event.preventDefault();
            nextPosition = 0;
          }

          if (event.key === 'End') {
            event.preventDefault();
            nextPosition = tabs.length - 1;
          }

          if (nextPosition !== position) {
            tabs[nextPosition].focus();
            activateTab(tabs[nextPosition]);
          }
        });
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Content tabs media",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Tab list accessibility label",
      "default": "Media tabs"
    },
    {
      "type": "range",
      "id": "tab_count",
      "label": "Number of tabs",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "media_right",
      "options": [
        {
          "value": "media_left",
          "label": "Media left"
        },
        {
          "value": "media_right",
          "label": "Media right"
        },
        {
          "value": "media_top",
          "label": "Media top"
        },
        {
          "value": "split",
          "label": "Split"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },

    {
      "type": "header",
      "content": "Tab 1"
    },
