{%- liquid
  assign block_id = 'content-stats-counter-' | append: block.id

  assign alignment = block.settings.alignment | default: 'center'
  assign width = block.settings.width | default: 'auto'
  assign layout_style = block.settings.layout_style | default: 'cards'
  assign desktop_columns = block.settings.desktop_columns | default: '4'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign stat_count = block.settings.stat_count | default: 4
  assign counter_animation = block.settings.counter_animation | default: 'static'

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-stats-counter
    content-stats-counter--{{ layout_style }}
    content-stats-counter--align-{{ alignment }}
    content-stats-counter--width-{{ width }}
    content-stats-counter--desktop-{{ desktop_columns }}
    content-stats-counter--mobile-{{ mobile_columns }}
    content-stats-counter--counter-{{ counter_animation }}
    {% unless show_desktop %} content-stats-counter--hide-desktop{% endunless %}
    {% unless show_tablet %} content-stats-counter--hide-tablet{% endunless %}
    {% unless show_mobile %} content-stats-counter--hide-mobile{% endunless %}
    {% if block.settings.animation != 'none' %} content-stats-counter--animate content-stats-counter--animate-{{ block.settings.animation }}{% endif %}
  "
  style="
    --content-stats-counter-margin-top: {{ block.settings.margin_top }}px;
    --content-stats-counter-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-stats-counter-padding-top: {{ block.settings.padding_top }}px;
    --content-stats-counter-padding-bottom: {{ block.settings.padding_bottom }}px;
    --content-stats-counter-padding-left: {{ block.settings.padding_left }}px;
    --content-stats-counter-padding-right: {{ block.settings.padding_right }}px;
    --content-stats-counter-gap: {{ block.settings.gap }}px;
    --content-stats-counter-card-padding: {{ block.settings.card_padding }}px;
    --content-stats-counter-border-width: {{ block.settings.border_width }}px;
    --content-stats-counter-border-radius: {{ block.settings.border_radius }}px;
    --content-stats-counter-heading-color: {{ block.settings.heading_color }};
    --content-stats-counter-text-color: {{ block.settings.text_color }};
    --content-stats-counter-link-color: {{ block.settings.link_color }};
    --content-stats-counter-background-color: {{ block.settings.background_color }};
    --content-stats-counter-card-background-color: {{ block.settings.card_background_color }};
    --content-stats-counter-border-color: {{ block.settings.border_color }};
    --content-stats-counter-number-color: {{ block.settings.number_color }};
    --content-stats-counter-icon-color: {{ block.settings.icon_color }};
    --content-stats-counter-icon-size: {{ block.settings.icon_size }}px;
    --content-stats-counter-number-size: {{ block.settings.number_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-stats-counter-margin-top);
      margin-bottom: var(--content-stats-counter-margin-bottom);
      padding-top: var(--content-stats-counter-padding-top);
      padding-bottom: var(--content-stats-counter-padding-bottom);
      padding-left: var(--content-stats-counter-padding-left);
      padding-right: var(--content-stats-counter-padding-right);
      background: var(--content-stats-counter-background-color);
      color: var(--content-stats-counter-text-color);
    }

    #{{ block_id }}.content-stats-counter--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-stats-counter--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-stats-counter--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-stats-counter--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-stats-counter--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-stats-counter--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-stats-counter--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-stats-counter--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-stats-counter__grid {
      display: grid;
      width: 100%;
      gap: var(--content-stats-counter-gap);
    }

    #{{ block_id }}.content-stats-counter--desktop-1 .content-stats-counter__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.content-stats-counter--desktop-2 .content-stats-counter__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.content-stats-counter--desktop-3 .content-stats-counter__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.content-stats-counter--desktop-4 .content-stats-counter__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .content-stats-counter__item {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
      color: var(--content-stats-counter-text-color);
      background: var(--content-stats-counter-card-background-color);
      border: var(--content-stats-counter-border-width) solid var(--content-stats-counter-border-color);
      border-radius: var(--content-stats-counter-border-radius);
      padding: var(--content-stats-counter-card-padding);
    }

    #{{ block_id }}.content-stats-counter--minimal .content-stats-counter__item {
      background: transparent;
      border-color: transparent;
      border-radius: 0;
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }}.content-stats-counter--cards .content-stats-counter__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .content-stats-counter__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      line-height: 1;
      color: var(--content-stats-counter-icon-color);
      font-size: var(--content-stats-counter-icon-size);
    }

    #{{ block_id }}.content-stats-counter--align-center .content-stats-counter__icon {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-stats-counter--align-right .content-stats-counter__icon {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-stats-counter__value {
      display: flex;
      align-items: baseline;
      gap: 2px;
      color: var(--content-stats-counter-number-color);
      line-height: 0.95;
    }

    #{{ block_id }}.content-stats-counter--align-center .content-stats-counter__value {
      justify-content: center;
    }

    #{{ block_id }}.content-stats-counter--align-right .content-stats-counter__value {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-stats-counter__prefix,
    #{{ block_id }} .content-stats-counter__number,
    #{{ block_id }} .content-stats-counter__suffix {
      display: inline-block;
      color: inherit;
      font-size: var(--content-stats-counter-number-size);
      font-weight: inherit;
      line-height: inherit;
    }

    #{{ block_id }} .content-stats-counter__heading {
      margin: 0;
      color: var(--content-stats-counter-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .content-stats-counter__description {
      margin: 0;
      color: var(--content-stats-counter-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-stats-counter__description p {
      margin-top: 0;
    }

    #{{ block_id }} .content-stats-counter__description p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }}.content-stats-counter--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-stats-counter--animate-fade {
      animation-name: contentStatsCounterFade;
    }

    #{{ block_id }}.content-stats-counter--animate-fade-up {
      animation-name: contentStatsCounterFadeUp;
    }

    #{{ block_id }}.content-stats-counter--animate-fade-down {
      animation-name: contentStatsCounterFadeDown;
    }

    #{{ block_id }}.content-stats-counter--animate-fade-left {
      animation-name: contentStatsCounterFadeLeft;
    }

    #{{ block_id }}.content-stats-counter--animate-fade-right {
      animation-name: contentStatsCounterFadeRight;
    }

    #{{ block_id }}.content-stats-counter--animate-zoom {
      animation-name: contentStatsCounterZoom;
    }

    @keyframes contentStatsCounterFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentStatsCounterFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentStatsCounterFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentStatsCounterFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentStatsCounterFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentStatsCounterZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-stats-counter--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-stats-counter--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-stats-counter--desktop-3 .content-stats-counter__grid,
      #{{ block_id }}.content-stats-counter--desktop-4 .content-stats-counter__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-stats-counter--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-stats-counter--mobile-1 .content-stats-counter__grid {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-stats-counter--mobile-2 .content-stats-counter__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }} .content-stats-counter__prefix,
      #{{ block_id }} .content-stats-counter__number,
      #{{ block_id }} .content-stats-counter__suffix {
        font-size: min(var(--content-stats-counter-number-size), 48px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-stats-counter--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="content-stats-counter__grid">
    {%- for index in (1..8) -%}
      {%- if index <= stat_count -%}
        {%- liquid
          assign icon_key = 'stat_' | append: index | append: '_icon'
          assign prefix_key = 'stat_' | append: index | append: '_prefix'
          assign number_key = 'stat_' | append: index | append: '_number'
          assign suffix_key = 'stat_' | append: index | append: '_suffix'
          assign heading_key = 'stat_' | append: index | append: '_heading'
          assign description_key = 'stat_' | append: index | append: '_description'

          assign stat_icon = block.settings[icon_key]
          assign stat_prefix = block.settings[prefix_key]
          assign stat_number = block.settings[number_key]
          assign stat_suffix = block.settings[suffix_key]
          assign stat_heading = block.settings[heading_key]
          assign stat_description = block.settings[description_key]
        -%}

        <article class="content-stats-counter__item">
          {% if stat_icon != blank %}
            <div class="content-stats-counter__icon" aria-hidden="true">
              {{ stat_icon }}
            </div>
          {% endif %}

          {% if stat_number != blank %}
            <div class="content-stats-counter__value" aria-label="{{ stat_prefix | append: stat_number | append: stat_suffix | escape }}">
              {% if stat_prefix != blank %}
                <span class="content-stats-counter__prefix">{{ stat_prefix | escape }}</span>
              {% endif %}

              <span
                class="content-stats-counter__number"
                data-content-stats-number
                data-content-stats-target="{{ stat_number | remove: ',' | escape }}"
              >
                {{ stat_number | escape }}
              </span>

              {% if stat_suffix != blank %}
                <span class="content-stats-counter__suffix">{{ stat_suffix | escape }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if stat_heading != blank %}
            <h3 class="content-stats-counter__heading">
              {{ stat_heading | escape }}
            </h3>
          {% endif %}

          {% if stat_description != blank %}
            <div class="content-stats-counter__description">
              {{ stat_description }}
            </div>
          {% endif %}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% if counter_animation == 'count-up' %}
    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.contentStatsCounterReady === 'true') return;

        root.dataset.contentStatsCounterReady = 'true';

        const numbers = root.querySelectorAll('[data-content-stats-number]');

        if (!numbers.length) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const formatNumber = (value, decimals) => {
          return Number(value).toLocaleString(undefined, {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
          });
        };

        const getDecimals = (value) => {
          const valueString = String(value);
          if (!valueString.includes('.')) return 0;
          return valueString.split('.')[1].length;
        };

        const animateNumber = (element) => {
          const rawTarget = element.dataset.contentStatsTarget || '0';
          const cleanedTarget = rawTarget.replace(/[^0-9.-]/g, '');
          const target = parseFloat(cleanedTarget);

          if (Number.isNaN(target)) return;

          const decimals = getDecimals(cleanedTarget);
          const duration = 1200;
          const startTime = performance.now();

          const tick = (now) => {
            const progress = Math.min((now - startTime) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = target * eased;

            element.textContent = formatNumber(current, decimals);

            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              element.textContent = formatNumber(target, decimals);
            }
          };

          element.textContent = formatNumber(0, decimals);
          requestAnimationFrame(tick);
        };

        const run = () => {
          numbers.forEach((element) => {
            if (element.dataset.contentStatsAnimated === 'true') return;
            element.dataset.contentStatsAnimated = 'true';

            if (prefersReducedMotion) return;

            animateNumber(element);
          });
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              run();
              observer.disconnect();
            });
          }, {
            threshold: 0.25
          });

          observer.observe(root);
        } else {
          run();
        }
      })();
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "Content stats counter",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "stat_count",
      "label": "Number of stats",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "counter_animation",
      "label": "Counter animation",
      "default": "static",
      "options": [
        {
          "value": "static",
          "label": "Static"
        },
        {
          "value": "count-up",
          "label": "Count up"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
