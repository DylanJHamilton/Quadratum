<script type="application/json" data-product-purchase-data>
[
{% for variant in product.variants %}
  {% capture sale_label %}Sale{% if variant.compare_at_price > variant.price %}{% assign savings = variant.compare_at_price | minus: variant.price %}{% if sale_badge_style == 'percent' %} −{{ savings | times: 100 | divided_by: variant.compare_at_price }}%{% elsif sale_badge_style == 'amount' %} −{{ savings | money }}{% endif %}{% endif %}{% endcapture %}
  {"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"compare":{{ variant.compare_at_price | money | json }},"onSale":{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},"saleLabel":{{ sale_label | json }},"sku":{{ variant.sku | json }},"allocations":{{ variant.selling_plan_allocations | json }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
</script>
