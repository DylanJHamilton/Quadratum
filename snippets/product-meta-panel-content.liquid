{%- liquid
  assign b = block.settings
  case b.source_type
    when 'manual'
      echo b.content
    when 'metafield'
      assign namespace = b.namespace | strip
      assign key = b.key | strip
      assign field = product.metafields[namespace][key]
      if field != blank
        if field.type == 'json'
          echo field.value | json | escape
        else
          echo field | metafield_tag
        endif
      endif
    when 'metaobject'
      assign entry = b.metaobject_reference
      assign keys = b.key | split: ','
      for key in keys
        assign field_key = key | strip
        assign field = entry[field_key]
        if field != blank
          echo '<div class="q-pmp__dl-row">'
          echo '<strong class="q-pmp__dl-term">'
          echo field_key | replace: '_', ' ' | escape
          echo '</strong><div class="q-pmp__dl-def">'
          if field.type == 'json'
            echo field.value | json | escape
          else
            echo field | metafield_tag
          endif
          echo '</div></div>'
        endif
      endfor
  endcase
-%}
