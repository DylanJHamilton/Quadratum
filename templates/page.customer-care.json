    "policies": {
      "type": "interactive-content-helper-tabs-accordion",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "label": "Privacy",
            "icon": "",
            "anchor_id": "policies",
            "content": "<p>We keep the details needed to fill an order and nothing more. Newsletter sign-up is separate from any purchase and every email has an unsubscribe link.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "Accessibility",
            "icon": "",
            "anchor_id": "accessibility",
            "content": "<p>The shop and this site aim for WCAG 2.2 AA: level entrance, large-print and audio editions on request, keyboard navigation, visible focus and reduced-motion support online.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Terms",
            "icon": "",
            "anchor_id": "terms",
            "content": "<p>Sample terms for a sample store. A real store replaces this section with its own policy pages from Shopify settings.</p>"
          }
        }
      },
