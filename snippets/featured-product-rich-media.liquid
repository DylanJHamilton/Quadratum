{%- capture rich_media -%}
  {%- for media in product.media -%}
    {%- unless media.media_type == 'image' -%}
      <div data-gallery-item data-media-id="{{ media.id }}" class="q-featured-rich-media__item">
        {% render 'qtm-block-product-media', media: media, product: product, image_loading: 'lazy', muted: false %}
      </div>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if rich_media != blank -%}
  {{ 'featured-product-rich-media.css' | asset_url | stylesheet_tag }}
  <details class="q-featured-rich-media" data-qtm-block-gallery>
    <summary>{{ 'products.services.all_media' | t }}</summary>
    <div data-product-gallery-viewport>{{ rich_media }}</div>
  </details>
{%- endif -%}
