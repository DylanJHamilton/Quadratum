{% liquid
  assign block_id = block.id
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  if request.design_mode
    assign animation = 'none'
  endif
%}

{% capture payment_items %}
{% for payment_type in shop.enabled_payment_types %}
  {% liquid
    assign show_payment = false
    assign payment_label = ''
    case payment_type
      when 'shopify_pay'
        assign show_payment = block.settings.show_shop_pay
        assign payment_label = 'Shop Pay'
      when 'apple_pay'
        assign show_payment = block.settings.show_apple_pay
        assign payment_label = 'Apple Pay'
      when 'google_pay'
        assign show_payment = block.settings.show_google_pay
        assign payment_label = 'Google Pay'
      when 'paypal'
        assign show_payment = block.settings.show_paypal
        assign payment_label = 'PayPal'
      when 'visa'
        assign show_payment = block.settings.show_visa
        assign payment_label = 'Visa'
      when 'master'
        assign show_payment = block.settings.show_mastercard
        assign payment_label = 'Mastercard'
      when 'american_express'
        assign show_payment = block.settings.show_amex
        assign payment_label = 'American Express'
      when 'discover'
        assign show_payment = block.settings.show_discover
        assign payment_label = 'Discover'
      when 'affirm'
        assign show_payment = block.settings.show_affirm
        assign payment_label = 'Affirm'
      when 'klarna' or 'klarna-pay-later'
        assign show_payment = block.settings.show_klarna
        assign payment_label = 'Klarna'
      when 'afterpay_touch' or 'afterpay'
        assign show_payment = block.settings.show_afterpay
        assign payment_label = 'Afterpay'
      when 'sezzle'
        assign show_payment = block.settings.show_sezzle
        assign payment_label = 'Sezzle'
      when 'zip'
        assign show_payment = block.settings.show_zip
        assign payment_label = 'Zip'
    endcase
  %}
  {% if show_payment %}
    <li class="qtm-payment-icons__item" data-payment-type="{{ payment_type | escape }}">
      <span class="qtm-payment-icons__icon" aria-hidden="true">{%- liquid
        assign svg_prefix = 'qtm-payment-' | append: block_id | append: '-' | append: payment_type | append: '-'
        assign svg_id = ' id="' | append: svg_prefix
        assign svg_label = 'aria-labelledby="' | append: svg_prefix
        assign svg_url = 'url(#' | append: svg_prefix
        assign svg_href = 'href="#' | append: svg_prefix
        assign payment_svg = payment_type | payment_type_svg_tag: class: 'qtm-payment-icons__svg'
        echo payment_svg | replace: ' id="', svg_id | replace: 'aria-labelledby="', svg_label | replace: 'url(#', svg_url | replace: 'href="#', svg_href
      -%}</span>
      <span class="qtm-payment-icons__label{% unless block.settings.show_labels %} visually-hidden{% endunless %}">{{ payment_label | escape }}</span>
    </li>
  {% endif %}
{% endfor %}
{% if block.settings.custom_1_label != blank %}
  <li class="qtm-payment-icons__item" data-custom-payment>
    <span class="qtm-payment-icons__icon qtm-payment-icons__icon--custom" aria-hidden="true">{{ block.settings.custom_1_icon | default: block.settings.custom_1_label | escape }}</span>
    <span class="qtm-payment-icons__label{% unless block.settings.show_labels %} visually-hidden{% endunless %}">{{ block.settings.custom_1_label | escape }}</span>
  </li>
{% endif %}
{% if block.settings.custom_2_label != blank %}
  <li class="qtm-payment-icons__item" data-custom-payment>
    <span class="qtm-payment-icons__icon qtm-payment-icons__icon--custom" aria-hidden="true">{{ block.settings.custom_2_icon | default: block.settings.custom_2_label | escape }}</span>
    <span class="qtm-payment-icons__label{% unless block.settings.show_labels %} visually-hidden{% endunless %}">{{ block.settings.custom_2_label | escape }}</span>
  </li>
{% endif %}
{% endcapture %}
{% assign payment_items = payment_items | strip %}

<div
  {% if payment_items == blank and request.design_mode == false %}hidden{% endif %}
  class="
    qtm-payment-icons
    qtm-payment-icons-{{ block_id }}
    qtm-payment-icons--width-{{ block_width }}
    qtm-payment-icons--align-{{ block_alignment }}
    qtm-payment-icons--layout-{{ block.settings.layout_style }}
    qtm-payment-icons--animation-{{ animation }}
    {% unless block.settings.show_desktop or request.design_mode %} qtm-payment-icons--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet or request.design_mode %} qtm-payment-icons--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile or request.design_mode %} qtm-payment-icons--hide-mobile{% endunless %}
  "
  style="
    --qtm-payment-icons-margin-top: {{ block.settings.margin_top }}px;
    --qtm-payment-icons-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-payment-icons-padding: {{ block.settings.padding }}px;
    --qtm-payment-icons-gap: {{ block.settings.gap }}px;
    --qtm-payment-icons-heading-color: {{ block.settings.heading_color }};
    --qtm-payment-icons-text-color: {{ block.settings.text_color }};
    --qtm-payment-icons-background-color: {{ block.settings.background_color }};
    --qtm-payment-icons-card-background: {{ block.settings.card_background_color }};
    --qtm-payment-icons-item-background: {{ block.settings.item_background_color }};
    --qtm-payment-icons-border-color: {{ block.settings.border_color }};
    --qtm-payment-icons-link-color: {{ block.settings.link_color }};
    --qtm-payment-icons-icon-text: {{ block.settings.icon_text_color }};
    --qtm-payment-icons-accent-color: {{ block.settings.accent_color }};
    --qtm-payment-icons-border-width: {{ block.settings.border_width }}px;
    --qtm-payment-icons-border-radius: {{ block.settings.border_radius }}px;
  "
>
  <div class="qtm-payment-icons__inner">
    {% if payment_items == blank and request.design_mode %}<p role="note">Choose enabled payment methods or add a custom method label.</p>{% endif %}
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-payment-icons__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-payment-icons__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-payment-icons__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-payment-icons__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-payment-icons__card">
      {% if payment_items != blank %}<ul class="qtm-payment-icons__list" role="list" aria-label="{{ block.settings.list_label | default: 'Payment methods' | escape }}">
{{ payment_items }}
      </ul>{% endif %}

      {% if block.settings.note != blank %}
        <div class="qtm-payment-icons__note">
          {{ block.settings.note }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-payment-icons-{{ block_id }} {
    box-sizing: border-box;
    min-width: 0;
    overflow-wrap: anywhere;
    margin-top: var(--qtm-payment-icons-margin-top);
    margin-bottom: var(--qtm-payment-icons-margin-bottom);
    padding: min(var(--qtm-payment-icons-padding), 12%);
    color: var(--qtm-payment-icons-text-color);
    background: var(--qtm-payment-icons-background-color);
    border: var(--qtm-payment-icons-border-width) solid var(--qtm-payment-icons-border-color);
    border-radius: var(--qtm-payment-icons-border-radius);
  }

  .qtm-payment-icons-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--width-auto {
    width: auto;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--width-small {
    max-width: 620px;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--width-medium {
    max-width: 860px;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--width-large {
    max-width: 1120px;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__inner {
    display: grid;
    gap: var(--qtm-payment-icons-gap);
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__header {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-center .qtm-payment-icons__header {
    margin-inline: auto;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-right .qtm-payment-icons__header {
    margin-left: auto;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__eyebrow {
    margin: 0;
    color: var(--qtm-payment-icons-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__heading {
    margin: 0;
    color: var(--qtm-payment-icons-heading-color);
    line-height: 1.05;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__text,
  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__note {
    color: var(--qtm-payment-icons-text-color);
    line-height: 1.7;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__text p,
  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__note p {
    margin-top: 0;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__text p:last-child,
  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__note p:last-child {
    margin-bottom: 0;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__card {
    display: grid;
    gap: calc(var(--qtm-payment-icons-gap) * 0.55);
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-grid .qtm-payment-icons__card,
  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-pills .qtm-payment-icons__card {
    padding: clamp(1rem, 2vw, 1.35rem);
    background: var(--qtm-payment-icons-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-payment-icons-border-color), transparent 10%);
    border-radius: calc(var(--qtm-payment-icons-border-radius) * 0.75);
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-minimal .qtm-payment-icons__card {
    padding: 0;
    background: transparent;
    border: 0;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__list {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--qtm-payment-icons-gap) * 0.45);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-center .qtm-payment-icons__list {
    justify-content: center;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-right .qtm-payment-icons__list {
    justify-content: flex-end;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-grid .qtm-payment-icons__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, {{ block.settings.grid_min_width }}px), 1fr));
    align-items: stretch;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    max-width: 100%;
    min-height: {{ block.settings.item_height }}px;
    color: var(--qtm-payment-icons-text-color);
    text-align: center;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-inline .qtm-payment-icons__item {
    padding: 0;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-grid .qtm-payment-icons__item,
  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-pills .qtm-payment-icons__item {
    padding: 0.5rem 0.75rem;
    background: var(--qtm-payment-icons-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-payment-icons-border-color), transparent 12%);
    border-radius: calc(var(--qtm-payment-icons-border-radius) * 0.5);
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-pills .qtm-payment-icons__item {
    border-radius: 999px;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-minimal .qtm-payment-icons__item {
    min-height: auto;
    padding: 0;
    background: transparent;
    border: 0;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(100%, {{ block.settings.icon_min_width }}px);
    min-height: {{ block.settings.icon_height }}px;
    padding: 0.35rem 0.55rem;
    color: var(--qtm-payment-icons-icon-text);
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--qtm-payment-icons-border-color), transparent 0%);
    border-radius: {{ block.settings.icon_radius }}px;
    font-size: {{ block.settings.icon_font_size }}px;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.04);
    white-space: normal;
  }














  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__icon--custom {
    color: var(--qtm-payment-icons-icon-text);
    background: #ffffff;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__label {
    color: var(--qtm-payment-icons-text-color);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.2;
    white-space: normal;
  }

  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__note {
    max-width: 740px;
    font-size: 0.9rem;
    opacity: 0.82;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-center .qtm-payment-icons__note {
    margin-inline: auto;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--align-right .qtm-payment-icons__note {
    margin-left: auto;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--animation-fade {
    animation: qtm-payment-icons-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--animation-fade-up {
    animation: qtm-payment-icons-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--animation-fade-down {
    animation: qtm-payment-icons-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--animation-fade-left {
    animation: qtm-payment-icons-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--animation-fade-right {
    animation: qtm-payment-icons-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--animation-zoom {
    animation: qtm-payment-icons-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-payment-icons-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-payment-icons-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-payment-icons-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-payment-icons-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-payment-icons-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-payment-icons-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {

  }

  @media screen and (min-width: 990px) {
    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-payment-icons-{{ block_id }} {
      padding: min(var(--qtm-payment-icons-padding), 24px, 12%);
    }

    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--hide-mobile {
      display: none !important;
    }

    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-grid .qtm-payment-icons__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-inline .qtm-payment-icons__list,
    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-pills .qtm-payment-icons__list,
    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--layout-minimal .qtm-payment-icons__list {
      gap: max(8px, calc(var(--qtm-payment-icons-gap) * 0.35));
    }

    .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__item {
      min-height: max(34px, {{ block.settings.item_height | minus: 8 }}px);
    }

    .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__icon {
      min-width: max(48px, {{ block.settings.icon_min_width | minus: 8 }}px);
      min-height: max(26px, {{ block.settings.icon_height | minus: 4 }}px);
      font-size: max(10px, {{ block.settings.icon_font_size | minus: 1 }}px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-payment-icons-{{ block_id }},
    .qtm-payment-icons-{{ block_id }} *,
    .qtm-payment-icons-{{ block_id }} *::before,
    .qtm-payment-icons-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .qtm-payment-icons-{{ block_id }}.qtm-payment-icons--hide-tablet {
      display: none !important;
    }
  }
  .qtm-payment-icons-{{ block_id }} :is(div,li,a,span,input,textarea,button) { min-width: 0; }
  .qtm-payment-icons-{{ block_id }} :is(a,input,textarea,button) { max-width: 100%; }
  .qtm-payment-icons-{{ block_id }}[hidden] { display: none !important; }
.qtm-payment-icons-{{ block_id }} .qtm-payment-icons__svg { display: block; max-width: 100%; width: auto; height: {{ block.settings.icon_height }}px; }
  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__icon { max-width: 100%; }
  .qtm-payment-icons-{{ block_id }} .qtm-payment-icons__icon--custom { border-color: var(--qtm-payment-icons-accent-color); }
</style>

{% schema %}
{
  "name": "Payment icons",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Payment methods"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "list_label",
      "label": "Payment list accessibility label",
      "default": "Accepted payment methods"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p>Available payment methods may vary by customer location, device, and checkout eligibility.</p>"
    },
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "checkbox",
      "id": "show_shop_pay",
      "label": "Show Shop Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_apple_pay",
      "label": "Show Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_google_pay",
      "label": "Show Google Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paypal",
      "label": "Show PayPal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Show Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Show Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "Show American Express",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discover",
      "label": "Show Discover",
      "default": true
    },
    {
      "type": "header",
      "content": "Financing and installments"
    },
    {
      "type": "checkbox",
      "id": "show_affirm",
      "label": "Show Affirm",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_klarna",
      "label": "Show Klarna",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_afterpay",
      "label": "Show Afterpay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sezzle",
      "label": "Show Sezzle",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_zip",
      "label": "Show Zip",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom methods"
    },
    {
      "type": "text",
      "id": "custom_1_label",
      "label": "Custom method 1 label",
      "info": "Only add payment methods you offer. Custom labels are merchant supplied; native methods are filtered by Shopify availability."
    },
    {
      "type": "text",
      "id": "custom_1_icon",
      "label": "Custom method 1 icon text"
