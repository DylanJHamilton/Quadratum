{%- liquid
  assign show_country = false
  assign show_language = false
  if settings.currency_selector_enable and localization.available_countries.size > 1
    assign show_country = true
  endif
  if settings.locale_selector_enable and localization.available_languages.size > 1
    assign show_language = true
  endif
  assign form_id = 'QtmLocalization-' | append: section_id
-%}
{%- if show_country or show_language -%}
  <div class="qtm-localization">
    {% form 'localization', id: form_id, class: 'qtm-localization__form' %}
      {% if settings.language_switcher_style == 'icon' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-5 5-5 13 0 18M12 3c5 5 5 13 0 18"/></svg>
      {% endif %}
      {% if show_country %}
        <div><label for="{{ form_id }}-country">Country/region</label>
          <select id="{{ form_id }}-country" name="country_code">
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code | escape }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code | escape }})</option>
            {% endfor %}
          </select>
        </div>
      {% endif %}
      {% if show_language %}
        <div><label for="{{ form_id }}-language">Language</label>
          <select id="{{ form_id }}-language" name="locale_code">
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code | escape }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | escape }}</option>
            {% endfor %}
          </select>
        </div>
      {% endif %}
      <button type="submit">Update preferences</button>
    {% endform %}
  </div>
  <style>
    .qtm-localization { padding: 16px; color: inherit; }
    .qtm-localization__form { display:flex; flex-wrap:wrap; justify-content:center; align-items:end; gap:12px; }
    .qtm-localization__form > div { min-width:0; max-width:100%; }
    .qtm-localization__form label { display:block; color:inherit; }
    .qtm-localization__form :is(select,button) { min-height:44px; max-width:100%; padding:8px 12px; border:1px solid currentColor; border-radius:4px; background:transparent; color:inherit; font:inherit; }
    .qtm-localization__form option { background:Canvas; color:CanvasText; }
    .qtm-localization__form :focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  </style>
{%- endif -%}
