{%- comment -%}Recognized HTTPS YouTube video URLs only; output empty to retain native navigation for other URLs.{%- endcomment -%}
{%- liquid
  assign clean_url = url | strip | split: '#' | first
  assign prefix = clean_url | slice: 0, 8
  assign video_id = ''
  if prefix == 'https://'
    assign without_protocol = clean_url | remove_first: 'https://'
    assign host = without_protocol | split: '/' | first | downcase
    assign path_and_query = without_protocol | remove_first: host | remove_first: '/'
    assign path = path_and_query | split: '?' | first
    assign path_parts = path | split: '/'
    if host == 'youtu.be'
      assign video_id = path_parts[0]
    elsif host == 'youtube.com' or host == 'www.youtube.com' or host == 'm.youtube.com' or host == 'www.youtube-nocookie.com' or host == 'youtube-nocookie.com'
      if path_parts[0] == 'embed' or path_parts[0] == 'shorts' or path_parts[0] == 'live'
        assign video_id = path_parts[1]
      elsif path == 'watch' and path_and_query contains '?'
        assign query = path_and_query | split: '?' | last | split: '&'
        for parameter in query
          assign parts = parameter | split: '='
          if parts[0] == 'v'
            assign video_id = parts[1]
            break
          endif
        endfor
      endif
    endif
  endif
  assign valid = true
  if video_id.size != 11
    assign valid = false
  endif
  assign allowed = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-'
  assign characters = video_id | split: ''
  for character in characters
    unless allowed contains character
      assign valid = false
    endunless
  endfor
-%}
{%- if valid -%}{{- video_id -}}{%- endif -%}
