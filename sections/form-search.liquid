{% comment %}Native GET search/finder with optional scoped predictive and price-band enhancement.{% endcomment %}


{%- assign s = section.settings -%}
{%- assign g = settings -%}
{%- liquid
  assign root_path = routes.root_url | append: '/' | replace: '//', '/'
  assign target = s.nav_target | strip
  assign target_valid = false
  assign target_first = target | slice: 0, 1
  assign target_pair = target | slice: 0, 2
  assign target_encoded = target | url_encode
  if target_first == '/' and target_pair != '//'
    assign target_valid = true
  endif
  if target contains '?' or target contains '#' or target contains ' ' or target_encoded contains '%5C' or target_encoded contains '%0A' or target_encoded contains '%0D' or target_encoded contains '%09'
    assign target_valid = false
  endif
  if target == '/search' or target == blank or target_valid == false
    assign target = routes.search_url
  else
    assign root_length = root_path | size
    assign target_prefix = target | slice: 0, root_length
    assign target_with_slash = target | append: '/'
    if root_path != '/' and target_prefix != root_path and target_with_slash != root_path
      assign target = target | remove_first: '/'
      assign target = root_path | append: target
    endif
  endif
  assign fallback_type = 'product,article,page'
  if s.scope_default == 'product' or s.scope_default == 'article' or s.scope_default == 'page'
    assign fallback_type = s.scope_default
  endif
  assign predictive_sources = s.predictive_sources | default: 'products,collections,articles,pages' | downcase | remove: ' ' | split: ','
  assign predictive_limit = s.predictive_limit | default: 5 | at_least: 1 | at_most: 10
  assign predictive_scope = 'all'
  case s.scope_default
    when 'product'
      assign predictive_scope = 'products_only'
    when 'collection'
      assign predictive_scope = 'collections_only'
    when 'article'
      assign predictive_scope = 'articles_only'
    when 'page'
      assign predictive_scope = 'pages_only'
  endcase
  assign form_surface_color = s.form_bg | default: g.bg_base | default: '#ffffff'
-%}
{%- if predictive_search.performed -%}
  {% render 'form-search-results', predictive_search: predictive_search, sources: predictive_sources, limit: predictive_limit, blocks: section.blocks, target: target, fallback_type: fallback_type %}
{%- else -%}
{{ 'forms-sections.css' | asset_url | stylesheet_tag }}
{% if s.mode == 'predictive' %}<script src="{{ 'interactive-content-search.js' | asset_url }}" defer></script>{% endif %}
{% if s.mode == 'finder' and s.enable_price %}<script src="{{ 'form-search.js' | asset_url }}" defer></script>{% endif %}
{%- capture form_surface_text -%}{% render 'contrast-text', background: form_surface_color, preferred: g.text_base %}{%- endcapture -%}
{%- capture form_input_text -%}{% render 'contrast-text', background: '#ffffff', preferred: g.text_base %}{%- endcapture -%}


{%- assign btn_default   = g.button_variant_default | default: 'solid' -%}
{%- assign btn_choice   = s.button_variant | default: 'inherit' -%}
{%- assign btn_variant  = btn_default -%}
{%- if btn_choice != 'inherit' and btn_choice != blank -%}{%- assign btn_variant = btn_choice -%}{%- endif -%}
{%- assign btn_mode_class = 'q-btn--solid' -%}
{%- if btn_variant == 'outline' -%}{%- assign btn_mode_class = 'q-btn--outline' -%}{%- endif -%}
{%- if btn_variant == 'ghost' -%}{%- assign btn_mode_class = 'q-btn--ghost' -%}{%- endif -%}

{%- assign visibility_classes = '' -%}
{%- if s.hide_on_mobile and request.design_mode == false -%}{%- assign visibility_classes = visibility_classes | append: ' hide-mobile' -%}{%- endif -%}
{%- if s.hide_on_desktop and request.design_mode == false -%}{%- assign visibility_classes = visibility_classes | append: ' hide-desktop' -%}{%- endif -%}

{%- assign anchor = s.anchor_id | strip -%}
{%- if anchor == blank -%}{%- assign anchor = 'section-' | append: section.id -%}{%- endif -%}

{%- assign c_primary     = g.color_primary | default: '#2563eb' -%}
{%- assign c_bg_base     = g.bg_base       | default: '#ffffff' -%}
{%- assign c_bg_contrast = g.bg_contrast   | default: '#f6f7f8' -%}
{%- assign c_text_base   = g.text_base     | default: '#111111' -%}
{%- assign c_text_muted  = g.text_muted    | default: '#6b7280' -%}
{%- assign btn_radius    = g.button_radius | default: 12 -%}
{%- assign btn_bw        = g.button_border_width | default: 1 -%}
{%- assign btn_hover_op  = g.button_hover_opacity | default: 92 -%}
{%- assign btn_active    = g.button_active_scale  | default: 98 -%}

{%- capture automatic_button_text -%}{% render 'contrast-text', background: c_primary, preferred: g.text_on_color %}{%- endcapture -%}
<style>
  .q-form-scope-{{ section.id }}{
    --q-pad-y: {{ s.padding_y | default: 40 }}px;
    --q-pad-x: {{ s.padding_x | default: 24 }}px;
    --q-card-br: {{ s.card_radius | default: 14 }}px;
    --q-card-shadow: {% case s.card_shadow %}{% when 0 %}none{% when 1 %}0 1px 2px rgba(0,0,0,.06){% when 3 %}0 2px 4px rgba(0,0,0,.08), 0 16px 40px rgba(0,0,0,.12){% else %}0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.08){% endcase %};
    --q-text: {{ c_text_base }};
    --q-muted: {{ c_text_muted }};
    --q-bg: {{ s.bg_color | default: c_bg_contrast }};
    --q-btn-bg: {{ c_primary }};
    --q-btn-fg: {{ automatic_button_text | strip }};
    --q-btn-bdr: {{ c_text_base }};
    --q-btn-bw: {{ btn_bw }}px;
    --q-btn-br: {{ btn_radius }}px;
    --q-btn-hover-op: {{ btn_hover_op }};
    --q-btn-active-scale: {{ btn_active | divided_by: 100.0 }};
    --q-form-bg: {{ s.form_bg | default: c_bg_base }};
    --q-input-br: {{ s.input_radius | default: 10 }}px;
    --q-input-bdr: {{ s.input_border | default: '#e5e7eb' }};
    --q-panel-bg: #fff;
    --q-panel-bdr: #e5e7eb;
  }

  .q-form-scope-{{ section.id }}[data-surface="frameless"] .q-card{ background:transparent!important; box-shadow:none!important; padding:0!important; border-radius:0!important; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-card{ padding:0; background:transparent; box-shadow:none; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-fields{ display:flex; gap:8px; align-items:stretch; flex-wrap:wrap; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-field{ margin:0; min-width:0; }

  .q-form-scope-{{ section.id }} .q-grid{ display:grid; gap:24px; }
  @media (min-width: 768px){
    .q-form-scope-{{ section.id }} .q-grid.split-left  { grid-template-columns: 1.1fr 1fr; }
    .q-form-scope-{{ section.id }} .q-grid.split-right { grid-template-columns: 1fr 1.1fr; }
  }

  /* Predictive UI */
  .q-form-scope-{{ section.id }} .q-predictive{ position:relative; }
  .q-form-scope-{{ section.id }} .q-panel{
    position:absolute; left:0; right:0; top:100%; margin-top:6px; z-index:50;
    background: var(--q-panel-bg); border:1px solid var(--q-panel-bdr); border-radius: 12px;
    box-shadow: 0 8px 22px rgba(0,0,0,.1);
    display:block; max-height:min(420px,60vh); overflow:auto;
    padding: 12px;
  }
  .q-form-scope-{{ section.id }} [hidden]{display:none !important;}

  .q-form-scope-{{ section.id }} .q-group{ padding: 8px 0; }
  .q-form-scope-{{ section.id }} .q-group-title{ font-size:.825rem; color: var(--q-muted); padding:6px 4px; }

  /* Items wrapper (this is what we grid — NOT .q-group itself) */
  .q-form-scope-{{ section.id }} .q-items{ display:grid; gap:8px; }

  /* Product group becomes a grid */
  .q-form-scope-{{ section.id }} .q-group[data-type="products"] .q-items{
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
    gap: 14px;
  }

  .q-form-scope-{{ section.id }} .q-item{
    display:flex; gap:10px; align-items:center;
    padding:10px 10px;
    border-radius: 10px;
    text-decoration:none;
    color: inherit;
    border: 1px solid rgba(0,0,0,.06);
    background: #fff;
    transition: box-shadow .12s ease, transform .12s ease, border-color .12s ease;
  }
  .q-form-scope-{{ section.id }} .q-item:hover{
    box-shadow: 0 6px 18px rgba(0,0,0,.10);
    transform: translateY(-1px);
    border-color: rgba(0,0,0,.10);
  }
  .q-form-scope-{{ section.id }} .q-item:focus-visible{
    outline: 2px solid var(--q-btn-bg, #2563eb);
    outline-offset: 2px;
  }

  /* Product cards stack vertically */
  .q-form-scope-{{ section.id }} .q-group[data-type="products"] .q-item{
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 10px;
  }

  .q-form-scope-{{ section.id }} .q-item-thumb{
    width:40px; height:40px; border-radius:8px; object-fit:cover; flex:0 0 auto; background:#f3f4f6;
  }
  .q-form-scope-{{ section.id }} .q-group[data-type="products"] .q-item-thumb{
    width:100%; height:auto; aspect-ratio: 1 / 1; margin:0; border-radius: 8px;
  }

  .q-form-scope-{{ section.id }} .q-item-content{ min-width:0; width:100%; }
  .q-form-scope-{{ section.id }} .q-item-title{ font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .q-form-scope-{{ section.id }} .q-group[data-type="products"] .q-item-title{
    white-space: normal;
    display:-webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow:hidden;
    min-height: 2.5em;
  }
  .q-form-scope-{{ section.id }} .q-item-sub{ font-size:.85rem; color: var(--q-muted); }
  .q-form-scope-{{ section.id }} .q-group[data-type="products"] .q-item-sub{ font-weight:600; color: var(--q-btn-bg, #2563eb); }

  .q-form-scope-{{ section.id }} .is-hidden{ display:none!important; }

  @media (max-width: 360px){
    .q-form-scope-{{ section.id }} .q-group[data-type="products"] .q-items{ grid-template-columns: minmax(0, 1fr); }
  }
  .q-form-scope-{{ section.id }}{min-width:0;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-wrap,.q-form-scope-{{ section.id }} .q-wrap-full{box-sizing:border-box;}
  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface,.q-form-scope-{{ section.id }} .q-grid>*{min-width:0;max-width:100%;}
  .q-form-scope-{{ section.id }} .q-field{min-width:0;max-width:100%;text-align:start;}
  .q-form-scope-{{ section.id }} .q-radio{width:auto;max-width:100%;text-align:start;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-radio span{min-width:0;}
  .q-form-scope-{{ section.id }} :is(button,a,input,select,textarea):focus-visible{outline:2px solid currentColor;outline-offset:3px;}
  .q-form-scope-{{ section.id }} [data-q-submit]{grid-column:1 / -1;max-width:100%;}
  @media(max-width:767.98px){.q-form-scope-{{ section.id }}.hide-mobile{display:none;}}
  @media(min-width:768px){.q-form-scope-{{ section.id }}.hide-desktop{display:none;}}
  @media(prefers-reduced-motion:reduce){.q-form-scope-{{ section.id }} .q-btn{transition:none;}}

  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface{--q-text:{{ form_surface_text | strip }};--q-muted:{{ form_surface_text | strip }};}
  .q-form-scope-{{ section.id }}[data-surface="frameless"] .q-card,.q-form-scope-{{ section.id }}[data-surface="frameless"] .q-surface{--q-text:{{ g.text_base | default: '#111111' }};--q-muted:{{ g.text_muted | default: '#6b7280' }};}
  .q-form-scope-{{ section.id }} input.q-input,.q-form-scope-{{ section.id }} select.q-select,.q-form-scope-{{ section.id }} textarea.q-textarea{color:{{ form_input_text | strip }};box-sizing:border-box;max-width:100%;}
  .q-form-scope-{{ section.id }}{--q-btn-hover-op:{{ g.button_hover_opacity | default: 92 }};--q-btn-active-scale:{{ g.button_active_scale | default: 98 | divided_by: 100.0 }};}
  {% if g.font_heading %}.q-form-scope-{{ section.id }} .q-head :is(h2,h3){font-family:{{ g.font_heading.family }},{{ g.font_heading.fallback_families }};}{% endif %}
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-card{--q-text:{{ g.text_base | default: '#111111' }};--q-muted:{{ g.text_muted | default: '#6b7280' }};}
  .q-form-scope-{{ section.id }} .q-wrap{margin:0 auto;padding-inline:min(var(--q-pad-x),8vw);max-width:{% if s.container_mode == 'full' or g.style_kit == 'full' %}100%{% elsif g.style_kit == 'wide' %}var(--q-cont-xl,1440px){% else %}var(--q-cont-lg,1152px){% endif %};}
  .q-form-scope-{{ section.id }} .q-search-query{flex:1 1 min(320px,100%);}
  .q-form-scope-{{ section.id }} .q-search-filter{flex:1 1 min(180px,100%);}
  .q-form-scope-{{ section.id }} .q-search-submit{flex:0 1 auto;align-self:end;}
  .q-form-scope-{{ section.id }} .q-btn{max-width:100%;white-space:normal;}
  .q-form-scope-{{ section.id }} .q-panel{--q-text:{{ form_input_text | strip }};--q-muted:{{ form_input_text | strip }};color:{{ form_input_text | strip }};box-sizing:border-box;max-width:100%;}
  .q-form-scope-{{ section.id }} .q-panel .q-item-sub{color:inherit;}
  .q-form-scope-{{ section.id }} .q-item-content>span{display:block;}
  .q-form-scope-{{ section.id }} .q-search-links{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;}
  .q-form-scope-{{ section.id }}:focus-within{z-index:5;}
  @media(prefers-reduced-motion:reduce){.q-form-scope-{{ section.id }} .q-item{transition:none;transform:none;}}
</style>

<section data-q-form-search
  {% if s.mode == 'predictive' %}data-qps-host{% endif %}
  data-section-id="{{ section.id | escape }}"
  data-suggest-url="{{ routes.predictive_search_url | escape }}"
  data-min-chars="{{ s.predictive_minchars | default: 2 | escape }}"
  data-debounce="{{ s.predictive_debounce | default: 160 | escape }}"
  data-scope="{{ predictive_scope | escape }}"
  data-max="{{ predictive_limit | escape }}"
  data-limit-products="{% if predictive_sources contains 'products' %}{{ predictive_limit }}{% else %}0{% endif %}"
  data-limit-collections="{% if predictive_sources contains 'collections' %}{{ predictive_limit }}{% else %}0{% endif %}"
  data-limit-articles="{% if predictive_sources contains 'articles' %}{{ predictive_limit }}{% else %}0{% endif %}"
  data-limit-pages="{% if predictive_sources contains 'pages' %}{{ predictive_limit }}{% else %}0{% endif %}"
  data-close-on-escape="true"
  id="{{ anchor | escape }}"
  class="q-form-scope-{{ section.id }} q-form q-form--site-search{{ visibility_classes }}"
  role="region"
  aria-label="{{ s.aria_label | default: 'Site search' | escape }}"
  data-template="{{ s.template_style | default: 'inline' | escape }}"
  data-surface="{{ s.surface_style | default: 'card' | escape }}"
  data-mode="{{ s.mode | default: 'basic' | escape }}"
>
  <div class="q-bleed">
    <div class="q-bg" aria-hidden="true">
      {%- if s.bg_image != blank -%}
        {{ s.bg_image | image_url: width: 2400 | image_tag: widths: '960,1440,1920,2400', sizes: '100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: '' }}
      {%- else -%}
        <div class="q-media" style="background: var(--q-bg);"></div>
      {%- endif -%}
      {%- if s.overlay_type == 'gradient' -%}
        {%- assign g1c = s.grad_start | default: '#000000' -%}
        {%- assign g2c = s.grad_end   | default: '#000000' -%}
        {%- assign g1o = s.grad_start_opacity | default: 35 | divided_by: 100.0 -%}
        {%- assign g2o = s.grad_end_opacity   | default: 0  | divided_by: 100.0 -%}
        <div class="q-overlay" style="background: linear-gradient({{ s.grad_angle | default: 180 }}deg, {{ g1c | color_modify: 'alpha', g1o }}, {{ g2c | color_modify: 'alpha', g2o }});"></div>
      {%- elsif s.overlay_type == 'solid' -%}
        <div class="q-overlay" style="background-color: {{ s.overlay_color | default: '#000000' }}; opacity: {{ s.overlay_opacity | default: 30 | divided_by: 100.0 }};"></div>
      {%- endif -%}
    </div>

    <div class="q-layer">
      <div class="q-wrap">
        <div class="q-grid{% if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'left' %} split-left{% elsif s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'right' %} split-right{% endif %}">
          {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'left' -%}
            <div class="q-media-card">
              {{ s.split_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: s.split_image.alt }}
            </div>
          {%- endif -%}

          <div class="q-card" data-q-form-card>
            <header class="q-head">
              {%- if s.kicker != blank -%}<p class="q-kicker">{{ s.kicker | escape }}</p>{%- endif -%}
              {%- assign heading_tag = s.heading_level | default: 'h3' -%}
              {%- if s.heading != blank -%}
                {%- if heading_tag == 'h2' -%}<h2 class="q-heading">{{ s.heading | escape }}</h2>{%- else -%}<h3 class="q-heading">{{ s.heading | escape }}</h3>{%- endif -%}
              {%- endif -%}
              {%- if s.subheading != blank -%}<p class="q-sub">{{ s.subheading | escape }}</p>{%- endif -%}
            </header>

            <form class="q-form q-predictive" role="search" method="get" action="{{ target | escape }}">
              <input type="hidden" name="options[prefix]" value="last">
              <div class="q-fields">
                <div class="q-field q-search-query">
                  <label class="q-label" for="qfs-{{ section.id }}-q">{{ s.query_label | default: 'Search' | escape }}</label>
                  <input id="qfs-{{ section.id }}-q" class="q-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ s.query_placeholder | default: 'Search products, articles, and more' | escape }}"
                    {% if s.mode == 'predictive' %}data-qps-input autocomplete="off" role="combobox" aria-haspopup="dialog" aria-expanded="false" aria-controls="qfs-{{ section.id }}-panel" aria-autocomplete="list"{% endif %}
                    {% if s.help_text != blank %}aria-describedby="qfs-{{ section.id }}-help"{% endif %}>
                  {% if s.help_text != blank %}<p id="qfs-{{ section.id }}-help" class="q-help">{{ s.help_text | escape }}</p>{% endif %}
                </div>
                {% if s.show_scope %}
                  <div class="q-field q-search-filter">
                    <label class="q-label" for="qfs-{{ section.id }}-scope">Scope</label>
                    <select id="qfs-{{ section.id }}-scope" class="q-select" name="type" data-qps-scope style="appearance:auto;background-image:none;">
                      <option value="product,article,page" data-resource-type="all"{% if s.scope_default == 'all' or s.scope_default == 'collection' and s.mode != 'predictive' %} selected{% endif %}>All</option>
                      <option value="product" data-resource-type="product"{% if s.scope_default == 'product' %} selected{% endif %}>Products</option>
                      {% if s.mode == 'predictive' %}<option value="product,article,page" data-resource-type="collection"{% if s.scope_default == 'collection' %} selected{% endif %}>Collections (suggestions)</option>{% endif %}
                      <option value="article" data-resource-type="article"{% if s.scope_default == 'article' %} selected{% endif %}>Articles</option>
                      <option value="page" data-resource-type="page"{% if s.scope_default == 'page' %} selected{% endif %}>Pages</option>
                    </select>
                  </div>
                {% else %}<input type="hidden" name="type" value="{{ fallback_type }}">{% endif %}
                {% if s.mode == 'finder' %}
                  {% assign filter_keys = 'category,tag' | split: ',' %}
                  {% for key in filter_keys %}
                    {% assign enabled_key = 'enable_' | append: key %}
                    {% assign options_key = key | append: '_options' %}
                    {% assign label_key = key | append: '_label' %}
                    {% assign placeholder_key = key | append: '_placeholder' %}
                    {% assign parameter = 'filter.p.tag' %}
                    {% if key == 'category' %}{% assign parameter = 'filter.p.t.category' %}{% endif %}
                    {% if s[enabled_key] and s[options_key] != blank %}
                      <div class="q-field q-search-filter">
                        <label class="q-label" for="qfs-{{ section.id }}-{{ key }}">{% if s[label_key] != blank %}{{ s[label_key] | escape }}{% else %}{{ key | capitalize | escape }}{% endif %}</label>
                        <select id="qfs-{{ section.id }}-{{ key }}" class="q-select" name="{{ parameter }}" style="appearance:auto;background-image:none;">
                          <option value="">{{ s[placeholder_key] | default: 'Any' | escape }}</option>
                          {% assign options = s[options_key] | newline_to_br | split: '<br />' %}
                          {% for option in options %}
                            {% assign pair = option | split: '|' %}
                            {% assign option_value = pair.first | strip %}
                            {% if option_value == blank %}{% continue %}{% endif %}
                            {% assign active = false %}
                            {% for filter in search.filters %}{% if filter.param_name == parameter %}{% for value in filter.active_values %}{% if value.value == option_value %}{% assign active = true %}{% endif %}{% endfor %}{% endif %}{% endfor %}
                            <option value="{{ option_value | escape }}"{% if active %} selected{% endif %}>{{ pair.last | default: pair.first | strip | escape }}</option>
                          {% endfor %}
                        </select>
                      </div>
                    {% elsif s[enabled_key] and request.design_mode %}<p class="q-help">Configure {{ key }} options with the enabled Shopify filter's exact values.</p>{% endif %}
                  {% endfor %}
                  {% if s.enable_price %}
                    {% assign min_price = blank %}{% assign max_price = blank %}
                    {% for filter in search.filters %}
                      {% if filter.type == 'price_range' %}
                        {% if filter.min_value.value != nil %}{% assign min_price = filter.min_value.value | divided_by: 100.0 %}{% endif %}
                        {% if filter.max_value.value != nil %}{% assign max_price = filter.max_value.value | divided_by: 100.0 %}{% endif %}
                      {% endif %}
                    {% endfor %}
                    <div class="q-field q-search-filter" data-price-shortcut hidden>
                      <label class="q-label" for="qfs-{{ section.id }}-price">{{ s.price_label | default: 'Price range' | escape }}</label>
                      <select id="qfs-{{ section.id }}-price" class="q-select" data-price-band style="appearance:auto;background-image:none;">
                        <option value="">{{ s.price_placeholder | default: 'Any' | escape }}</option>
                        {% assign price_options = s.price_options | newline_to_br | split: '<br />' %}
                        {% for option in price_options %}{% assign pair = option | split: '|' %}{% assign option_value = pair.first | strip %}{% if option_value == blank %}{% continue %}{% endif %}<option value="{{ option_value | escape }}">{{ pair.last | default: pair.first | strip | escape }}</option>{% endfor %}
                      </select>
                    </div>
                    <div class="q-field q-search-filter">
                      <label class="q-label" for="qfs-{{ section.id }}-min">Minimum price ({{ shop.currency | escape }})</label>
                      <input id="qfs-{{ section.id }}-min" class="q-input" type="number" inputmode="decimal" min="0" step="0.01" name="filter.v.price.gte" value="{{ min_price }}">
                    </div>
                    <div class="q-field q-search-filter">
                      <label class="q-label" for="qfs-{{ section.id }}-max">Maximum price ({{ shop.currency | escape }})</label>
                      <input id="qfs-{{ section.id }}-max" class="q-input" type="number" inputmode="decimal" min="0" step="0.01" name="filter.v.price.lte" value="{{ max_price }}">
                    </div>
                  {% endif %}
                {% endif %}
                <div class="q-field q-search-submit">
                  <button type="submit" class="q-btn {{ btn_mode_class }}">{{ s.button_label | default: 'Search' | escape }}</button>
                </div>
              </div>
              {% if s.mode == 'predictive' %}
                <div id="qfs-{{ section.id }}-panel" class="q-panel" data-qps-panel hidden role="dialog" aria-label="Search suggestions"><div data-qps-panel-inner></div></div>
                <p class="q-live" data-qps-status role="status" aria-live="polite"></p>
                {% if predictive_sources contains 'collections' %}<p class="q-help">Collections appear in suggestions; full search does not include collections.</p>{% endif %}
              {% endif %}
            </form>
            <div class="q-search-links">
              {% for block in section.blocks %}
                {% if block.type == 'quick_link' and block.settings.url != blank and block.settings.label != blank %}<a href="{{ block.settings.url | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}
              {% endfor %}
            </div>
            {% if request.design_mode and target_valid == false and s.nav_target != blank %}<p class="q-help">Use a store-relative target path without query parameters; this form currently uses the localized search page.</p>{% endif %}
            {% if request.design_mode and s.mode == 'finder' %}<p class="q-help">Enable matching Shopify category, tag and price filters in Search &amp; Discovery. Filter values and price bands must match your catalog and shop currency.</p>{% endif %}

          </div>

          {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'right' -%}
            <div class="q-media-card">
              {{ s.split_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: s.split_image.alt }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

</section>


{%- endif -%}
{% schema %}
{
  "name": "Form – Site Search",
  "tag": "section",
  "class": "q-form q-form--site-search",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Site search" },

    { "type": "header", "content": "Mode & Sources" },
    { "type": "select", "id": "mode", "label": "Mode", "default": "basic", "options": [
      { "value": "basic", "label": "Submit (basic)" },
      { "value": "predictive", "label": "Predictive search (typeahead)" },
      { "value": "finder", "label": "Finder (guided filters)" }
    ]},
    { "type": "checkbox", "id": "show_scope", "label": "Show scope select", "default": true },
    { "type": "select", "id": "scope_default", "label": "Default scope", "info": "Full Shopify search supports products, articles and pages. Collections are predictive suggestions only; full submission falls back to all supported types.", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "product", "label": "Products" },
      { "value": "collection", "label": "Collections" },
      { "value": "article", "label": "Articles" },
      { "value": "page", "label": "Pages" }
    ]},

    { "type": "header", "content": "Predictive Settings" },
    { "type": "text", "id": "predictive_sources", "label": "Sources (csv)", "info": "Use products, collections, articles and pages. Requests use the saved section settings and per-source limit.", "default": "products,collections,articles,pages" },
    { "type": "range", "id": "predictive_limit", "label": "Max per source", "min": 1, "max": 10, "step": 1, "default": 5 },
    { "type": "range", "id": "predictive_minchars", "label": "Min characters to trigger", "min": 1, "max": 5, "step": 1, "default": 2 },
    { "type": "range", "id": "predictive_debounce", "label": "Debounce (ms)", "min": 80, "max": 600, "step": 20, "default": 160 },

    { "type": "header", "content": "Finder Filters" },
    { "type": "checkbox", "id": "enable_category", "label": "Enable Category", "default": false },
    { "type": "text", "id": "category_label", "label": "Category label", "default": "Category" },
    { "type": "text", "id": "category_placeholder", "label": "Category placeholder", "default": "Any" },
    { "type": "textarea", "id": "category_options", "label": "Category options (value|label per line)", "info": "Use Shopify category IDs, for example aa-1|Category label, matching an enabled category filter. Blank options omit the control." },

    { "type": "checkbox", "id": "enable_price", "label": "Enable Price band", "default": false },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "Price" },
    { "type": "text", "id": "price_placeholder", "label": "Price placeholder", "default": "Any" },
    { "type": "textarea", "id": "price_options", "label": "Price options (value|label per line)", "info": "Optional JS shortcuts in shop currency: <50, 50-150 or 150+. Under uses an upper bound one cent below the value. Native min/max controls work without JS; enable the Shopify price filter.", "default": "<50|Under $50\n50-150|$50–$150\n150+|$150+" },

    { "type": "checkbox", "id": "enable_tag", "label": "Enable Tag filter", "default": false },
    { "type": "text", "id": "tag_label", "label": "Tag label", "default": "Tag" },
    { "type": "text", "id": "tag_placeholder", "label": "Tag placeholder", "default": "Any" },
    { "type": "textarea", "id": "tag_options", "label": "Tag options (value|label per line)", "info": "Use exact catalog tags matching an enabled Shopify tag filter. Blank options omit the control." },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find what you need" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "default": "h3", "options": [ { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" } ] },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "query_label", "label": "Query label", "default": "Search" },
    { "type": "text", "id": "query_placeholder", "label": "Query placeholder", "default": "Search products, articles, and more" },
    { "type": "textarea", "id": "help_text", "label": "Help text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Search" },

    { "type": "header", "content": "Navigation" },
    { "type": "text", "id": "nav_target", "label": "Target path", "info": "Use /search or another store-relative path that accepts native search/filter parameters. Locale prefix is retained. External URLs, query strings and fragments fall back to Shopify search.", "default": "/search" },

    { "type": "header", "content": "Styling" },
    { "type": "select", "id": "template_style", "label": "Template", "default": "inline", "options": [
      { "value": "inline", "label": "Inline" },
      { "value": "card", "label": "Card" },
      { "value": "split", "label": "Split (media + form)" }
    ]},
    { "type": "select", "id": "surface_style", "label": "Surface chrome", "info": "Inline always uses a minimal frameless surface. Card and Split use this setting.", "default": "card", "options": [
      { "value": "card", "label": "Card" },
      { "value": "frameless", "label": "Frameless (no card)" }
    ]},
    { "type": "select", "id": "split_media_side", "label": "Split media side", "default": "right", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "image_picker", "id": "split_image", "label": "Split image" },

    { "type": "color", "id": "form_bg", "label": "Form background", "default": "#ffffff" },
    { "type": "range", "id": "input_radius", "label": "Input radius", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "color", "id": "input_border", "label": "Input border color", "default": "#e5e7eb" },

    { "type": "header", "content": "Section Spacing & BG" },
    { "type": "select", "id": "container_mode", "label": "Container width", "default": "contained", "options": [
      { "value": "contained", "label": "Contained" },
      { "value": "full", "label": "Full width" }
    ]},
    { "type": "range", "id": "padding_y", "label": "Padding Y (px)", "min": 0, "max": 200, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_x", "label": "Padding X (px)", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Card radius (px)", "min": 0, "max": 28, "step": 1, "default": 14 },
    { "type": "range", "id": "card_shadow", "label": "Card elevation", "min": 0, "max": 3, "step": 1, "default": 2 },

    { "type": "header", "content": "Overlay (optional)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f6f7f8" },
    { "type": "select", "id": "overlay_type", "label": "Overlay", "default": "none", "options": [
      { "value": "none", "label": "None" },
      { "value": "solid", "label": "Solid" },
      { "value": "gradient", "label": "Gradient" }
    ]},
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 30 },
    { "type": "color", "id": "grad_start", "label": "Gradient start", "default": "#000000" },
    { "type": "range", "id": "grad_start_opacity", "label": "Start opacity", "min": 0, "max": 100, "step": 5, "default": 35 },
    { "type": "color", "id": "grad_end", "label": "Gradient end", "default": "#000000" },
    { "type": "range", "id": "grad_end_opacity", "label": "End opacity", "min": 0, "max": 100, "step": 5, "default": 0 },
    { "type": "range", "id": "grad_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 5, "default": 180 },

    { "type": "header", "content": "Visibility" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Best Sellers" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Form – Site Search (Predictive Card)",
      "category": "Forms",
      "settings": {
        "mode": "predictive",
        "template_style": "card",
        "surface_style": "card",
        "button_label": "Search"
      },
      "blocks": [
        { "type": "quick_link", "settings": { "label": "New Arrivals", "url": "/collections/new" } },
        { "type": "quick_link", "settings": { "label": "Best Sellers", "url": "/collections/best-sellers" } }
      ]
    },
    {
      "name": "Form – Site Search (Inline)",
      "category": "Forms",
      "settings": {
        "mode": "basic",
        "template_style": "inline",
        "surface_style": "frameless",
        "button_label": "Search"
      }
    },
    {
      "name": "Form – Finder (Split)",
      "category": "Forms",
      "settings": {
        "mode": "finder",
        "template_style": "split",
        "surface_style": "card",
        "enable_category": true,
        "enable_price": true,
        "enable_tag": true,
        "button_label": "Find"
      }
    }
  ]
}
{% endschema %}
