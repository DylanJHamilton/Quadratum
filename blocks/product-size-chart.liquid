{%- liquid
  assign block_id = 'product-size-chart-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign layout_style = block.settings.layout_style | default: 'inline'
  assign chart_source = block.settings.chart_source | default: 'rich_text'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign metafield_chart = blank

  if product_context != blank and block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
    assign metafield_chart = product_context.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
  endif

  assign chart_image = block.settings.chart_image
  assign chart_image_alt = block.settings.heading

  if chart_image != blank and chart_image.alt != blank
    assign chart_image_alt = chart_image.alt
  endif

  assign has_chart = false

  if chart_source == 'image' and chart_image != blank
    assign has_chart = true
  endif

  if chart_source == 'rich_text' and block.settings.chart_rich_text != blank
    assign has_chart = true
  endif

  if chart_source == 'table' and block.settings.table_rows != blank
    assign has_chart = true
  endif

  if chart_source == 'metafield' and metafield_chart != blank
    assign has_chart = true
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    product-size-chart
    product-size-chart--{{ layout_style }}
    product-size-chart--width-{{ width }}
    product-size-chart--align-{{ alignment }}
    {% unless show_on_desktop %} product-size-chart--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-size-chart--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-size-chart--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-size-chart--animate product-size-chart--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-size-chart-margin-top: {{ block.settings.margin_top }}px;
    --product-size-chart-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-size-chart-padding: {{ block.settings.padding }}px;
    --product-size-chart-card-padding: {{ block.settings.card_padding }}px;
    --product-size-chart-content-gap: {{ block.settings.content_gap }}px;
    --product-size-chart-radius: {{ block.settings.card_radius }}px;
    --product-size-chart-border-width: {{ block.settings.border_width }}px;
    --product-size-chart-modal-width: {{ block.settings.modal_width }}px;
    --product-size-chart-heading-color: {{ block.settings.heading_color }};
    --product-size-chart-text-color: {{ block.settings.text_color }};
    --product-size-chart-muted-color: {{ block.settings.muted_color }};
    --product-size-chart-background: {{ block.settings.background_color }};
    --product-size-chart-card-background: {{ block.settings.card_background_color }};
    --product-size-chart-border-color: {{ block.settings.border_color }};
    --product-size-chart-button-background: {{ block.settings.button_background_color }};
    --product-size-chart-button-text: {{ block.settings.button_text_color }};
    --product-size-chart-table-header-background: {{ block.settings.table_header_background_color }};
    --product-size-chart-table-row-background: {{ block.settings.table_row_background_color }};
    --product-size-chart-overlay-color: {{ block.settings.overlay_color }};
    --product-size-chart-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-size-chart
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-size-chart-margin-top);
      margin-bottom: var(--product-size-chart-margin-bottom);
      padding: var(--product-size-chart-padding);
      color: var(--product-size-chart-text-color);
      background: var(--product-size-chart-background);
    }

    #{{ block_id }}.product-size-chart--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-size-chart--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-size-chart--width-medium {
      max-width: 860px;
    }

    #{{ block_id }}.product-size-chart--width-large {
      max-width: 1080px;
    }

    #{{ block_id }}.product-size-chart--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-size-chart--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-size-chart--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-size-chart--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-size-chart__inner {
      display: grid;
      gap: var(--product-size-chart-content-gap);
      min-width: 0;
      color: var(--product-size-chart-text-color);
    }

    #{{ block_id }}.product-size-chart--inline .product-size-chart__inner,
    #{{ block_id }}.product-size-chart--accordion .product-size-chart__inner {
      padding: var(--product-size-chart-card-padding);
      background: var(--product-size-chart-card-background);
      border: var(--product-size-chart-border-width) solid var(--product-size-chart-border-color);
      border-radius: var(--product-size-chart-radius);
    }

    #{{ block_id }} .product-size-chart__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }}.product-size-chart--align-center .product-size-chart__header {
      margin-left: auto;
      margin-right: auto;
      justify-items: center;
    }

    #{{ block_id }}.product-size-chart--align-right .product-size-chart__header {
      margin-left: auto;
      margin-right: 0;
      justify-items: end;
    }

    #{{ block_id }} .product-size-chart__eyebrow {
      margin: 0;
      color: var(--product-size-chart-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-size-chart__heading {
      margin: 0;
      color: var(--product-size-chart-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.12;
    }

    #{{ block_id }} .product-size-chart__description {
      margin: 0;
      color: var(--product-size-chart-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-size-chart__trigger {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: {{ block.settings.button_height }}px;
      padding: 10px 16px;
      color: var(--product-size-chart-button-text);
      background: var(--product-size-chart-button-background);
      border: 1px solid var(--product-size-chart-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      cursor: pointer;
      font: inherit;
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.product-size-chart--align-center .product-size-chart__trigger {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-size-chart--align-right .product-size-chart__trigger {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-size-chart__trigger:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-size-chart__trigger:focus-visible,
    #{{ block_id }} .product-size-chart__accordion-toggle:focus-visible,
    #{{ block_id }} .product-size-chart__modal-close:focus-visible {
      outline: 2px solid var(--product-size-chart-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-size-chart__content {
      color: var(--product-size-chart-text-color);
      font-size: {{ block.settings.content_size }}px;
      line-height: 1.6;
      text-align: left;
    }

    #{{ block_id }} .product-size-chart__content p:first-child {
      margin-top: 0;
    }

    #{{ block_id }} .product-size-chart__content p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-size-chart__image-wrap {
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--product-size-chart-radius) - 8px), 8px);
    }

    #{{ block_id }} .product-size-chart__image {
      display: block;
      width: 100%;
      height: auto;
    }

    #{{ block_id }} .product-size-chart__table-wrap {
      overflow-x: auto;
      border: var(--product-size-chart-border-width) solid var(--product-size-chart-border-color);
      border-radius: max(calc(var(--product-size-chart-radius) - 8px), 8px);
    }

    #{{ block_id }} .product-size-chart__table {
      width: 100%;
      min-width: {{ block.settings.table_min_width }}px;
      border-collapse: collapse;
      color: var(--product-size-chart-text-color);
      font-size: {{ block.settings.content_size }}px;
      line-height: 1.4;
      text-align: left;
    }

    #{{ block_id }} .product-size-chart__table th,
    #{{ block_id }} .product-size-chart__table td {
      padding: {{ block.settings.table_cell_padding }}px;
      border-bottom: var(--product-size-chart-border-width) solid var(--product-size-chart-border-color);
      vertical-align: middle;
    }

    #{{ block_id }} .product-size-chart__table th {
      color: var(--product-size-chart-heading-color);
      background: var(--product-size-chart-table-header-background);
      font-weight: 800;
    }

    #{{ block_id }} .product-size-chart__table td {
      background: var(--product-size-chart-table-row-background);
    }

    #{{ block_id }} .product-size-chart__table tr:last-child td {
      border-bottom: 0;
    }

    #{{ block_id }} .product-size-chart__accordion-toggle {
      appearance: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 16px;
      width: 100%;
      min-height: {{ block.settings.accordion_toggle_height }}px;
      padding: 0;
      color: var(--product-size-chart-heading-color);
      background: transparent;
      border: 0;
      cursor: pointer;
      text-align: left;
      font: inherit;
      font-size: {{ block.settings.heading_size }}px;
      font-weight: 800;
      line-height: 1.2;
    }

    #{{ block_id }} .product-size-chart__accordion-icon {
      position: relative;
      width: 22px;
      height: 22px;
      color: var(--product-size-chart-heading-color);
    }

    #{{ block_id }} .product-size-chart__accordion-icon::before,
    #{{ block_id }} .product-size-chart__accordion-icon::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 14px;
      height: 2px;
      background: currentColor;
      border-radius: 999px;
      transform: translate(-50%, -50%);
      transition: transform 180ms ease, opacity 180ms ease;
    }

    #{{ block_id }} .product-size-chart__accordion-icon::after {
      transform: translate(-50%, -50%) rotate(90deg);
    }

    #{{ block_id }} .product-size-chart__accordion-toggle[aria-expanded="true"] .product-size-chart__accordion-icon::after {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(0deg);
    }

    #{{ block_id }} .product-size-chart__accordion-panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 240ms ease;
    }

    #{{ block_id }} .product-size-chart__accordion-panel[data-open="true"] {
      grid-template-rows: 1fr;
    }

    #{{ block_id }} .product-size-chart__accordion-panel-inner {
      min-height: 0;
      overflow: hidden;
    }

    #{{ block_id }} .product-size-chart__accordion-content {
      padding-top: var(--product-size-chart-content-gap);
    }

    #{{ block_id }} .product-size-chart__modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    #{{ block_id }} .product-size-chart__modal[aria-hidden="false"] {
      display: flex;
    }

    #{{ block_id }} .product-size-chart__modal-overlay {
      position: absolute;
      inset: 0;
      background: var(--product-size-chart-overlay-color);
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }

    #{{ block_id }} .product-size-chart__modal-dialog {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 18px;
      width: min(100%, var(--product-size-chart-modal-width));
      max-height: min(86vh, 900px);
      overflow: auto;
      padding: var(--product-size-chart-card-padding);
      color: var(--product-size-chart-text-color);
      background: var(--product-size-chart-card-background);
      border: var(--product-size-chart-border-width) solid var(--product-size-chart-border-color);
      border-radius: var(--product-size-chart-radius);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
      text-align: left;
    }

    #{{ block_id }} .product-size-chart__modal-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 16px;
    }

    #{{ block_id }} .product-size-chart__modal-title {
      margin: 0;
      color: var(--product-size-chart-heading-color);
      font-size: {{ block.settings.modal_heading_size }}px;
      line-height: 1.15;
    }

    #{{ block_id }} .product-size-chart__modal-close {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      color: var(--product-size-chart-heading-color);
      background: transparent;
      border: var(--product-size-chart-border-width) solid var(--product-size-chart-border-color);
      border-radius: 999px;
      cursor: pointer;
      font: inherit;
      font-size: 24px;
      line-height: 1;
    }

    #{{ block_id }} .product-size-chart__empty {
      padding: 18px;
      color: var(--product-size-chart-text-color);
      background: var(--product-size-chart-card-background);
      border: var(--product-size-chart-border-width) solid var(--product-size-chart-border-color);
      border-radius: var(--product-size-chart-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-size-chart--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-size-chart--animate-fade {
      animation-name: productSizeChartFade;
    }

    #{{ block_id }}.product-size-chart--animate-fade_up {
      animation-name: productSizeChartFadeUp;
    }

    #{{ block_id }}.product-size-chart--animate-zoom {
      animation-name: productSizeChartZoom;
    }

    @keyframes productSizeChartFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productSizeChartFadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productSizeChartZoom {
      from {
        opacity: 0;
        transform: scale(0.98);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-size-chart--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-size-chart--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-size-chart--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-size-chart__heading,
      #{{ block_id }} .product-size-chart__accordion-toggle {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-size-chart__modal-title {
        font-size: {{ block.settings.modal_heading_size_mobile }}px;
      }

      #{{ block_id }} .product-size-chart__modal {
        padding: 12px;
      }

      #{{ block_id }} .product-size-chart__modal-dialog {
        max-height: 88vh;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-size-chart--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-size-chart__trigger,
      #{{ block_id }} .product-size-chart__accordion-panel,
      #{{ block_id }} .product-size-chart__accordion-icon::before,
      #{{ block_id }} .product-size-chart__accordion-icon::after {
        transition: none;
      }

      #{{ block_id }} .product-size-chart__trigger:hover {
        transform: none;
      }
    }
  </style>

  {%- capture chart_content -%}
    {% case chart_source %}
      {% when 'image' %}
        {% if chart_image != blank %}
          <div class="product-size-chart__image-wrap">
            {{ chart_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1200, 1600', alt: chart_image_alt, class: 'product-size-chart__image' }}
          </div>
        {% endif %}

      {% when 'table' %}
        {% if block.settings.table_rows != blank %}
          <div class="product-size-chart__table-wrap">
            <table class="product-size-chart__table">
              {% if block.settings.table_heading_1 != blank or block.settings.table_heading_2 != blank or block.settings.table_heading_3 != blank or block.settings.table_heading_4 != blank %}
                <thead>
                  <tr>
                    {% if block.settings.table_heading_1 != blank %}
                      <th scope="col">{{ block.settings.table_heading_1 | escape }}</th>
                    {% endif %}
                    {% if block.settings.table_heading_2 != blank %}
                      <th scope="col">{{ block.settings.table_heading_2 | escape }}</th>
                    {% endif %}
                    {% if block.settings.table_heading_3 != blank %}
                      <th scope="col">{{ block.settings.table_heading_3 | escape }}</th>
                    {% endif %}
                    {% if block.settings.table_heading_4 != blank %}
                      <th scope="col">{{ block.settings.table_heading_4 | escape }}</th>
                    {% endif %}
                  </tr>
                </thead>
              {% endif %}

              <tbody>
                {% assign rows = block.settings.table_rows | newline_to_br | split: '<br />' %}
                {% for row in rows %}
                  {% assign cells = row | split: '|' %}
                  {% if row != blank %}
                    <tr>
                      {% for cell in cells limit: 4 %}
                        <td>{{ cell | strip | escape }}</td>
                      {% endfor %}
                    </tr>
                  {% endif %}
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

      {% when 'metafield' %}
        {% if metafield_chart != blank %}
          {{ metafield_chart | metafield_tag }}
        {% endif %}

      {% else %}
        {{ block.settings.chart_rich_text }}
    {% endcase %}
  {%- endcapture -%}

  {% if has_chart %}
    {% if layout_style == 'modal' %}
      <div class="product-size-chart__inner">
        {% if block.settings.show_header %}
          <div class="product-size-chart__header">
            {% if block.settings.eyebrow != blank %}
              <p class="product-size-chart__eyebrow">
                {{ block.settings.eyebrow | escape }}
              </p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="product-size-chart__heading">
                {{ block.settings.heading | escape }}
              </h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="product-size-chart__description">
                {{ block.settings.description | escape }}
              </p>
            {% endif %}
          </div>
        {% endif %}

        <button
          type="button"
          class="product-size-chart__trigger"
          data-product-size-chart-open
          aria-haspopup="dialog"
          aria-controls="{{ block_id }}-modal"
        >
          {{ block.settings.button_label | escape }}
        </button>
      </div>

      <div
        id="{{ block_id }}-modal"
        class="product-size-chart__modal"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
        aria-labelledby="{{ block_id }}-modal-title"
        data-product-size-chart-modal
      >
        <div class="product-size-chart__modal-overlay" data-product-size-chart-close aria-hidden="true"></div>

        <div class="product-size-chart__modal-dialog" data-product-size-chart-dialog>
          <div class="product-size-chart__modal-header">
            <h2 id="{{ block_id }}-modal-title" class="product-size-chart__modal-title">
              {{ block.settings.modal_heading | escape }}
            </h2>

            <button
              type="button"
              class="product-size-chart__modal-close"
              data-product-size-chart-close
              aria-label="{{ block.settings.close_label | escape }}"
            >
              ×
            </button>
          </div>

          <div class="product-size-chart__content">
            {{ chart_content }}
          </div>
        </div>
      </div>

      <script>
        (() => {
          const root = document.getElementById({{ block_id | json }});

          if (!root || root.dataset.productSizeChartReady === 'true') return;

          root.dataset.productSizeChartReady = 'true';

          const openButton = root.querySelector('[data-product-size-chart-open]');
          const modal = root.querySelector('[data-product-size-chart-modal]');
          const dialog = root.querySelector('[data-product-size-chart-dialog]');
          const closeButtons = Array.from(root.querySelectorAll('[data-product-size-chart-close]'));
          let lastFocusedElement = null;

          if (!openButton || !modal || !dialog) return;

          const focusableSelectors = [
            'a[href]',
            'button:not([disabled])',
            'textarea:not([disabled])',
            'input:not([disabled])',
            'select:not([disabled])',
            '[tabindex]:not([tabindex="-1"])'
          ].join(',');

          const getFocusableElements = () => Array.from(dialog.querySelectorAll(focusableSelectors));

          const openModal = () => {
            lastFocusedElement = document.activeElement;
            modal.setAttribute('aria-hidden', 'false');
            document.documentElement.style.overflow = 'hidden';

            const focusable = getFocusableElements();
            const firstFocusable = focusable[0];

            if (firstFocusable) {
              firstFocusable.focus();
            } else {
              dialog.setAttribute('tabindex', '-1');
              dialog.focus();
            }
          };

          const closeModal = () => {
            modal.setAttribute('aria-hidden', 'true');
            document.documentElement.style.overflow = '';

            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
              lastFocusedElement.focus();
            }
          };

          openButton.addEventListener('click', openModal);

          closeButtons.forEach((button) => {
            button.addEventListener('click', closeModal);
          });

          modal.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              event.preventDefault();
              closeModal();
            }

            if (event.key === 'Tab') {
              const focusable = getFocusableElements();

              if (!focusable.length) {
                event.preventDefault();
                return;
              }

              const first = focusable[0];
              const last = focusable[focusable.length - 1];

              if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              }

              if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              }
            }
          });
        })();
      </script>
    {% elsif layout_style == 'accordion' %}
      <div class="product-size-chart__inner">
        <button
          type="button"
          class="product-size-chart__accordion-toggle"
          aria-expanded="{% if block.settings.accordion_open_default %}true{% else %}false{% endif %}"
          aria-controls="{{ block_id }}-accordion-panel"
          data-product-size-chart-accordion-toggle
        >
          <span>{{ block.settings.heading | escape }}</span>
          <span class="product-size-chart__accordion-icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-accordion-panel"
          class="product-size-chart__accordion-panel"
          data-open="{% if block.settings.accordion_open_default %}true{% else %}false{% endif %}"
          data-product-size-chart-accordion-panel
        >
          <div class="product-size-chart__accordion-panel-inner">
            <div class="product-size-chart__accordion-content">
              {% if block.settings.description != blank %}
                <p class="product-size-chart__description">
                  {{ block.settings.description | escape }}
                </p>
              {% endif %}

              <div class="product-size-chart__content">
                {{ chart_content }}
              </div>
            </div>
          </div>
        </div>
      </div>

      <script>
        (() => {
          const root = document.getElementById({{ block_id | json }});

          if (!root || root.dataset.productSizeChartAccordionReady === 'true') return;

          root.dataset.productSizeChartAccordionReady = 'true';

          const toggle = root.querySelector('[data-product-size-chart-accordion-toggle]');
          const panel = root.querySelector('[data-product-size-chart-accordion-panel]');

          if (!toggle || !panel) return;

          toggle.addEventListener('click', () => {
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

            toggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
            panel.dataset.open = isExpanded ? 'false' : 'true';
          });
        })();
      </script>
    {% else %}
      <div class="product-size-chart__inner">
        {% if block.settings.show_header %}
          <div class="product-size-chart__header">
            {% if block.settings.eyebrow != blank %}
              <p class="product-size-chart__eyebrow">
                {{ block.settings.eyebrow | escape }}
              </p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="product-size-chart__heading">
                {{ block.settings.heading | escape }}
              </h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="product-size-chart__description">
                {{ block.settings.description | escape }}
              </p>
            {% endif %}
          </div>
        {% endif %}

        <div class="product-size-chart__content">
          {{ chart_content }}
        </div>
      </div>
    {% endif %}
  {% elsif block.settings.show_empty_state %}
    <div class="product-size-chart__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

