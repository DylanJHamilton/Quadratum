{%- comment -%}
  Snippet: header-two-actions
  Reusable actions cluster for Header Two.

  Accepts:
    search_mode, search_placeholder, show_account, account_display,
    cart_display, show_cart_subtotal, tracking_label, tracking_url
{%- endcomment -%}

<div class="qtm-hm-actions">
  {%- if search_mode == 'popup' or search_mode == 'page' -%}
    {% render 'header-two-search',
      mode: search_mode,
      placeholder: search_placeholder
    %}
  {%- endif -%}

  {%- if show_account -%}
    {% render 'header-two-account',
      display: account_display,
      tracking_label: tracking_label,
      tracking_url: tracking_url
    %}
  {%- endif -%}

{% if settings.pcard_show_wishlist and settings.wishlist_page != blank %}<a href="{{ settings.wishlist_link | default: settings.wishlist_page.url }}" class="qtm-wishlist-link" aria-label="Wishlist"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a4.4 4.4 0 0 0-6.2 0L12 7.2 9.4 4.6a4.4 4.4 0 0 0-6.2 6.2L12 21.6l8.8-10.8a4.4 4.4 0 0 0 0-6.2Z"/></svg><span data-wishlist-count hidden></span></a>{% endif %}
  {% render 'header-two-cart',
    display: cart_display,
    show_subtotal: show_cart_subtotal
  %}
</div>
