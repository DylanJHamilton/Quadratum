{%- capture json_less_than -%}\u003c{%- endcapture -%}
{% if product.selling_plan_groups.size > 0 %}
  {%- liquid
    assign plan_variant = product.selected_or_first_available_variant | default: product.variants.first
    assign selected_allocation = plan_variant.selected_selling_plan_allocation
    if selected_allocation == blank and product.requires_selling_plan
      assign selected_allocation = plan_variant.selling_plan_allocations.first
    endif
  -%}
  <div class="product-form-block__selling-plan">
    <label class="product-form-block__label" for="SellingPlan-{{ id | escape }}">{{ label | default: 'Purchase options' | escape }}</label>
    <select id="SellingPlan-{{ id | escape }}" name="selling_plan" class="product-form-block__select" data-product-form-selling-plan {% if product.requires_selling_plan %}required{% endif %}>
      {% unless product.requires_selling_plan %}<option value="" {% if selected_allocation == blank %}selected{% endif %}>{{ one_time_label | default: 'One-time purchase' | escape }}</option>{% endunless %}
      {% for group in product.selling_plan_groups %}
        <optgroup label="{{ group.name | escape }}">
          {% for plan in group.selling_plans %}
            {%- liquid
              assign plan_supported = false
              if plan_variant == blank
                assign plan_supported = true
              endif
              for allocation in plan_variant.selling_plan_allocations
                if allocation.selling_plan.id == plan.id
                  assign plan_supported = true
                  break
                endif
              endfor
            -%}
            <option value="{{ plan.id }}" {% if selected_allocation.selling_plan.id == plan.id %}selected{% endif %} {% unless plan_supported %}disabled hidden{% endunless %}>{{ plan.name | escape }}</option>
          {% endfor %}
        </optgroup>
      {% endfor %}
    </select>
    {% if note != blank %}<p class="product-form-block__selling-plan-note">{{ note | escape }}</p>{% endif %}
    {% capture plan_variants %}[
      {"id":{{ plan_variant.id | json }},"selling_plan_allocations":[{% for allocation in plan_variant.selling_plan_allocations %}{"selling_plan":{"id":{{ allocation.selling_plan.id | json }}}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
      {% for variant in product.variants %}{% unless variant.id == plan_variant.id %},{"id":{{ variant.id | json }},"selling_plan_allocations":[{% for allocation in variant.selling_plan_allocations %}{"selling_plan":{"id":{{ allocation.selling_plan.id | json }}}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% endunless %}{% endfor %}
    ]{% endcapture %}
    <script type="application/json" data-selling-plan-variants>{{ plan_variants | replace: '<', json_less_than }}</script>
  </div>
  <script src="{{ 'product-selling-plans.js' | asset_url }}" defer></script>
{% endif %}
