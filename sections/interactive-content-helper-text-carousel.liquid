{% schema %}
{
  "name": "Text Carousel",
  "tag": "section",
  "class": "q-section-wrap q-section-text-carousel",
  "settings": [
    { "type": "header", "content": "Content header" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Highlights" },
