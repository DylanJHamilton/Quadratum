{% liquid
  assign footer_layout = section.settings.footer_layout | default: 'commerce'
  assign footer_width = section.settings.footer_width | default: 'wide'
  assign mobile_layout = section.settings.mobile_layout | default: 'accordion'
  assign columns_desktop = section.settings.columns_desktop | default: 4

  assign has_trust_items = false
  assign has_featured_collections = false

  for block in section.blocks
    if block.type == 'trust_item'
      assign has_trust_items = true
    endif

    if block.type == 'featured_collection'
      assign has_featured_collections = true
    endif
  endfor
%}

<footer
  id="FooterTwo-{{ section.id }}"
  class="q-footer-two q-footer-two--layout-{{ footer_layout }} q-footer-two--width-{{ footer_width }} q-footer-two--mobile-{{ mobile_layout }}"
  aria-label="Site footer"
>
  <style>
    #FooterTwo-{{ section.id }}{
      --qf2-bg: {{ section.settings.bg_color }};
      --qf2-text: {{ section.settings.text_color }};
      --qf2-muted: {{ section.settings.muted_color }};
      --qf2-heading: {{ section.settings.heading_color }};
      --qf2-link: {{ section.settings.link_color }};
      --qf2-link-hover: {{ section.settings.link_hover_color }};
      --qf2-border: {{ section.settings.border_color }};
      --qf2-trust-bg: {{ section.settings.trust_bg }};
      --qf2-trust-text: {{ section.settings.trust_text }};
      --qf2-bottom-bg: {{ section.settings.bottom_bg }};
      --qf2-bottom-text: {{ section.settings.bottom_text_color }};
      --qf2-newsletter-bg: {{ section.settings.newsletter_bg }};
      --qf2-newsletter-button-bg: {{ section.settings.newsletter_button_bg }};
      --qf2-newsletter-button-text: {{ section.settings.newsletter_button_text }};
      --qf2-button-bg: {{ section.settings.button_bg }};
      --qf2-button-text: {{ section.settings.button_text }};
      --qf2-button-border: {{ section.settings.button_border }};
      --qf2-button-hover-bg: {{ section.settings.button_hover_bg }};
      --qf2-button-hover-text: {{ section.settings.button_hover_text }};
      --qf2-radius: {{ section.settings.radius }}px;
      --qf2-newsletter-radius: {{ section.settings.newsletter_radius }}px;
      --qf2-button-radius: {{ section.settings.button_radius }}px;
      --qf2-gap: {{ section.settings.gap }}px;
      --qf2-padding-top: {{ section.settings.padding_top }}px;
      --qf2-padding-bottom: {{ section.settings.padding_bottom }}px;
      --qf2-logo-height: {{ section.settings.logo_height }}px;
      --qf2-heading-size: {{ section.settings.heading_size }}px;
      --qf2-body-size: {{ section.settings.body_size }}px;
      --qf2-link-size: {{ section.settings.link_size }}px;
      --qf2-columns-desktop: {{ columns_desktop }};

      width: 100%;
      margin: 0;
      padding: 0;
      background: var(--qf2-bg);
      color: var(--qf2-text);
      border-top: 1px solid var(--qf2-border);
    }

    #FooterTwo-{{ section.id }},
    #FooterTwo-{{ section.id }} *{
      box-sizing: border-box;
    }

    #FooterTwo-{{ section.id }} a{
      color: var(--qf2-link);
      text-decoration: none;
      transition: color .18s ease, transform .18s ease, border-color .18s ease, background .18s ease, opacity .18s ease;
    }

    #FooterTwo-{{ section.id }} a:hover{
      color: var(--qf2-link-hover);
    }

    #FooterTwo-{{ section.id }} a:focus-visible,
    #FooterTwo-{{ section.id }} button:focus-visible,
    #FooterTwo-{{ section.id }} input:focus-visible,
    #FooterTwo-{{ section.id }} select:focus-visible,
    #FooterTwo-{{ section.id }} summary:focus-visible{
      outline: 2px solid var(--qf2-link-hover);
      outline-offset: 3px;
    }

    #FooterTwo-{{ section.id }} .qf2__shell,
    #FooterTwo-{{ section.id }} .qf2__trust-inner,
    #FooterTwo-{{ section.id }} .qf2__collections-inner,
    #FooterTwo-{{ section.id }} .qf2__bottom-inner{
      width: 100%;
      margin: 0 auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    #FooterTwo-{{ section.id }}.q-footer-two--width-wide .qf2__shell,
    #FooterTwo-{{ section.id }}.q-footer-two--width-wide .qf2__trust-inner,
    #FooterTwo-{{ section.id }}.q-footer-two--width-wide .qf2__collections-inner,
    #FooterTwo-{{ section.id }}.q-footer-two--width-wide .qf2__bottom-inner{
      max-width: 1440px;
    }

    #FooterTwo-{{ section.id }}.q-footer-two--width-contained .qf2__shell,
    #FooterTwo-{{ section.id }}.q-footer-two--width-contained .qf2__trust-inner,
    #FooterTwo-{{ section.id }}.q-footer-two--width-contained .qf2__collections-inner,
    #FooterTwo-{{ section.id }}.q-footer-two--width-contained .qf2__bottom-inner{
      max-width: 1180px;
    }

    #FooterTwo-{{ section.id }} .qf2__visually-hidden{
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #FooterTwo-{{ section.id }} .qf2__trust{
      width: 100%;
      background: var(--qf2-trust-bg);
      color: var(--qf2-trust-text);
      border-bottom: 1px solid var(--qf2-border);
    }

    #FooterTwo-{{ section.id }} .qf2__trust-inner{
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1px;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    #FooterTwo-{{ section.id }} .qf2__trust-item{
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 12px;
      align-items: start;
      min-width: 0;
      padding: 12px 16px;
      border: 1px solid color-mix(in srgb, var(--qf2-trust-text), transparent 86%);
      border-radius: calc(var(--qf2-radius) - 4px);
      background: color-mix(in srgb, var(--qf2-trust-text), transparent 96%);
    }

    #FooterTwo-{{ section.id }} .qf2__trust-icon{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 34px;
      height: 34px;
      padding: 0 8px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--qf2-trust-text), transparent 88%);
      color: var(--qf2-trust-text);
      font-size: .9rem;
      font-weight: 800;
      line-height: 1;
    }

    #FooterTwo-{{ section.id }} .qf2__trust-heading{
      margin: 0;
      color: inherit;
      font-size: .95rem;
      font-weight: 800;
      line-height: 1.2;
    }

    #FooterTwo-{{ section.id }} .qf2__trust-text{
      margin: 4px 0 0;
      color: inherit;
      opacity: .78;
      font-size: .88rem;
      line-height: 1.45;
    }

    #FooterTwo-{{ section.id }} .qf2__main{
      width: 100%;
      padding-top: var(--qf2-padding-top);
      padding-bottom: var(--qf2-padding-bottom);
    }

    #FooterTwo-{{ section.id }} .qf2__grid{
      display: grid;
      grid-template-columns: repeat(var(--qf2-columns-desktop), minmax(0, 1fr));
      gap: var(--qf2-gap);
      align-items: start;
    }

    #FooterTwo-{{ section.id }}.q-footer-two--layout-commerce_wide .qf2__grid{
      gap: calc(var(--qf2-gap) + 14px);
    }

    #FooterTwo-{{ section.id }}.q-footer-two--layout-commerce_dense .qf2__main{
      padding-top: calc(var(--qf2-padding-top) * .75);
      padding-bottom: calc(var(--qf2-padding-bottom) * .75);
    }

    #FooterTwo-{{ section.id }}.q-footer-two--layout-commerce_dense .qf2__grid{
      gap: calc(var(--qf2-gap) * .75);
    }

    #FooterTwo-{{ section.id }} .qf2__block{
      min-width: 0;
    }

    #FooterTwo-{{ section.id }} .qf2__block--newsletter{
      padding: 22px;
      border: 1px solid var(--qf2-border);
      border-radius: var(--qf2-radius);
      background: var(--qf2-newsletter-bg);
    }

    #FooterTwo-{{ section.id }} .qf2__heading{
      margin: 0 0 12px;
      color: var(--qf2-heading);
      font-size: var(--qf2-heading-size);
      font-weight: 800;
      line-height: 1.2;
    }

    #FooterTwo-{{ section.id }} .qf2__text,
    #FooterTwo-{{ section.id }} .qf2__rte{
      margin: 0;
      color: var(--qf2-muted);
      font-size: var(--qf2-body-size);
      line-height: 1.6;
    }

    #FooterTwo-{{ section.id }} .qf2__rte p,
    #FooterTwo-{{ section.id }} .qf2__text p{
      margin-top: 0;
    }

    #FooterTwo-{{ section.id }} .qf2__rte p:last-child,
    #FooterTwo-{{ section.id }} .qf2__text p:last-child{
      margin-bottom: 0;
    }

    #FooterTwo-{{ section.id }} .qf2__brand{
      display: grid;
      gap: 12px;
      align-content: start;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-link{
      display: inline-flex;
      align-items: center;
      width: fit-content;
      max-width: 100%;
    }

    #FooterTwo-{{ section.id }} .qf2__logo{
      display: block;
      width: auto;
      max-width: 100%;
      height: var(--qf2-brand-logo-height, var(--qf2-logo-height));
      object-fit: contain;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-name{
      margin: 0;
      color: var(--qf2-heading);
      font-size: 1.15rem;
      font-weight: 800;
      line-height: 1.1;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-copy{
      max-width: 42ch;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-contact-list,
    #FooterTwo-{{ section.id }} .qf2__contact-list,
    #FooterTwo-{{ section.id }} .qf2__account-list{
      display: grid;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
      color: var(--qf2-muted);
      font-size: var(--qf2-body-size);
      line-height: 1.5;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-contact-list a,
    #FooterTwo-{{ section.id }} .qf2__contact-list a,
    #FooterTwo-{{ section.id }} .qf2__account-list a{
      color: var(--qf2-link);
    }

    #FooterTwo-{{ section.id }} .qf2__brand-social-list,
    #FooterTwo-{{ section.id }} .qf2__social-list{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-social-link,
    #FooterTwo-{{ section.id }} .qf2__social-link{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 38px;
      height: 38px;
      padding: 0 11px;
      border: 1px solid var(--qf2-border);
      border-radius: 999px;
      color: var(--qf2-link);
      font-size: .78rem;
      font-weight: 800;
      line-height: 1;
    }

    #FooterTwo-{{ section.id }} .qf2__brand-social-link:hover,
    #FooterTwo-{{ section.id }} .qf2__social-link:hover{
      border-color: var(--qf2-link-hover);
      color: var(--qf2-link-hover);
      transform: translateY(-1px);
    }

    #FooterTwo-{{ section.id }} .qf2__button{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      padding: 0 18px;
      border: 1px solid var(--qf2-button-border);
      border-radius: var(--qf2-button-radius);
      background: var(--qf2-button-bg);
      color: var(--qf2-button-text);
      font-size: var(--qf2-link-size);
      font-weight: 800;
      line-height: 1;
      white-space: nowrap;
    }

    #FooterTwo-{{ section.id }} .qf2__button:hover{
      background: var(--qf2-button-hover-bg);
      border-color: var(--qf2-button-hover-bg);
      color: var(--qf2-button-hover-text);
      transform: translateY(-1px);
    }

    #FooterTwo-{{ section.id }} .qf2__button--outline{
      background: transparent;
      color: var(--qf2-link);
    }

    #FooterTwo-{{ section.id }} .qf2__button--text{
      min-height: auto;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--qf2-link);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    #FooterTwo-{{ section.id }} .qf2__menu-list{
      display: grid;
      gap: 9px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #FooterTwo-{{ section.id }} .qf2__menu-list a{
      display: inline-block;
      width: fit-content;
      max-width: 100%;
      color: var(--qf2-link);
      font-size: var(--qf2-link-size);
      line-height: 1.42;
      overflow-wrap: anywhere;
    }

    #FooterTwo-{{ section.id }} .qf2__menu-list a:hover{
      color: var(--qf2-link-hover);
      transform: translateX(2px);
    }

    #FooterTwo-{{ section.id }} .qf2__menu-details{
      margin: 0;
    }

    #FooterTwo-{{ section.id }} .qf2__menu-summary{
      display: block;
      list-style: none;
      cursor: default;
    }

    #FooterTwo-{{ section.id }} .qf2__menu-summary::-webkit-details-marker{
      display: none;
    }

    #FooterTwo-{{ section.id }} .qf2__menu-summary .qf2__heading{
      margin-bottom: 12px;
    }

    #FooterTwo-{{ section.id }} .qf2__newsletter-form{
      display: grid;
      gap: 12px;
      margin-top: 14px;
    }

    #FooterTwo-{{ section.id }} .qf2__newsletter-row{
      display: flex;
      gap: 8px;
      align-items: stretch;
      min-width: 0;
    }

    #FooterTwo-{{ section.id }} .qf2__newsletter-input{
      flex: 1 1 auto;
      min-width: 0;
      height: 46px;
      padding: 0 14px;
      border: 1px solid var(--qf2-border);
      border-radius: var(--qf2-newsletter-radius);
      background: var(--qf2-bg);
      color: var(--qf2-text);
      font-size: .95rem;
      box-shadow: none;
    }

    #FooterTwo-{{ section.id }} .qf2__newsletter-button{
      flex: 0 0 auto;
      min-height: 46px;
      padding: 0 18px;
      border: 1px solid var(--qf2-newsletter-button-bg);
      border-radius: var(--qf2-newsletter-radius);
      background: var(--qf2-newsletter-button-bg);
      color: var(--qf2-newsletter-button-text);
      cursor: pointer;
      font-weight: 800;
      line-height: 1;
      white-space: nowrap;
    }

    #FooterTwo-{{ section.id }} .qf2__form-message,
    #FooterTwo-{{ section.id }} .qf2__editor-note{
      margin: 0;
      font-size: .9rem;
      line-height: 1.45;
      color: var(--qf2-muted);
    }

    #FooterTwo-{{ section.id }} .qf2__form-message--success{
      color: var(--qf2-link-hover);
      font-weight: 700;
    }

    #FooterTwo-{{ section.id }} .qf2__custom-liquid{
      color: var(--qf2-text);
    }

    #FooterTwo-{{ section.id }} .qf2__collections{
      width: 100%;
      padding-bottom: var(--qf2-padding-bottom);
    }

    #FooterTwo-{{ section.id }} .qf2__collections-inner{
      display: grid;
      gap: 18px;
    }

    #FooterTwo-{{ section.id }} .qf2__collections-title{
      margin: 0;
      color: var(--qf2-heading);
      font-size: 1.05rem;
      font-weight: 800;
    }

    #FooterTwo-{{ section.id }} .qf2__collection-grid{
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
    }

    #FooterTwo-{{ section.id }} .qf2__collection-card{
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px;
      align-items: center;
      min-width: 0;
      padding: 12px;
      border: 1px solid var(--qf2-border);
      border-radius: var(--qf2-radius);
      background: color-mix(in srgb, var(--qf2-text), transparent 96%);
      color: var(--qf2-link);
    }

    #FooterTwo-{{ section.id }} .qf2__collection-card:hover{
      color: var(--qf2-link-hover);
      border-color: var(--qf2-link-hover);
      transform: translateY(-1px);
    }

    #FooterTwo-{{ section.id }} .qf2__collection-image{
      display: block;
      width: 64px;
      height: 64px;
      border-radius: calc(var(--qf2-radius) - 6px);
      object-fit: cover;
      background: color-mix(in srgb, var(--qf2-muted), transparent 86%);
    }

    #FooterTwo-{{ section.id }} .qf2__collection-placeholder{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      border-radius: calc(var(--qf2-radius) - 6px);
      background: color-mix(in srgb, var(--qf2-muted), transparent 86%);
      color: var(--qf2-muted);
      font-size: .78rem;
      font-weight: 800;
    }

    #FooterTwo-{{ section.id }} .qf2__collection-title{
      min-width: 0;
      color: inherit;
      font-weight: 800;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    #FooterTwo-{{ section.id }} .qf2__bottom{
      width: 100%;
      background: var(--qf2-bottom-bg);
      color: var(--qf2-bottom-text);
      border-top: 1px solid var(--qf2-border);
    }

    #FooterTwo-{{ section.id }} .qf2__bottom-inner{
      display: grid;
      gap: 14px;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    #FooterTwo-{{ section.id }} .qf2__bottom-top,
    #FooterTwo-{{ section.id }} .qf2__bottom-lower{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    #FooterTwo-{{ section.id }} .qf2__copyright,
    #FooterTwo-{{ section.id }} .qf2__bottom-text{
      margin: 0;
      color: var(--qf2-bottom-text);
      font-size: .9rem;
      line-height: 1.45;
    }

    #FooterTwo-{{ section.id }} .qf2__bottom-menu,
    #FooterTwo-{{ section.id }} .qf2__policy-links{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #FooterTwo-{{ section.id }} .qf2__bottom-menu a,
    #FooterTwo-{{ section.id }} .qf2__policy-links a{
      color: var(--qf2-bottom-text);
      font-size: .9rem;
      line-height: 1.35;
      text-decoration: none;
      opacity: .86;
    }

    #FooterTwo-{{ section.id }} .qf2__bottom-menu a:hover,
    #FooterTwo-{{ section.id }} .qf2__policy-links a:hover{
      opacity: 1;
      color: var(--qf2-link-hover);
    }

    #FooterTwo-{{ section.id }} .qf2__payments{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterTwo-{{ section.id }} .qf2__payment-icon{
      display: block;
      width: auto;
      height: 24px;
    }

    #FooterTwo-{{ section.id }} .qf2__payment-pill{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 6px 10px;
      border: 1px solid var(--qf2-border);
      border-radius: 999px;
      color: var(--qf2-bottom-text);
      background: rgba(255,255,255,.04);
      font-size: .78rem;
      line-height: 1;
    }

    #FooterTwo-{{ section.id }} .qf2__localization{
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    #FooterTwo-{{ section.id }} .qf2__localization-form{
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    #FooterTwo-{{ section.id }} .qf2__localization-select{
      min-height: 34px;
      padding: 0 30px 0 10px;
      border: 1px solid var(--qf2-border);
      border-radius: 999px;
      background: transparent;
      color: var(--qf2-bottom-text);
      font-size: .85rem;
    }

    @supports not (color: color-mix(in srgb, #000, #fff)){
      #FooterTwo-{{ section.id }} .qf2__collection-card,
      #FooterTwo-{{ section.id }} .qf2__trust-item{
        background: rgba(255,255,255,.04);
      }
    }

    @media (max-width: 1100px){
      #FooterTwo-{{ section.id }} .qf2__grid{
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #FooterTwo-{{ section.id }} .qf2__newsletter-row{
        flex-direction: column;
      }

      #FooterTwo-{{ section.id }} .qf2__newsletter-button{
        width: 100%;
      }
    }

    @media (min-width: 741px){
      #FooterTwo-{{ section.id }} .qf2__menu-details[open] > .qf2__menu-summary,
      #FooterTwo-{{ section.id }} .qf2__menu-details > .qf2__menu-summary{
        pointer-events: none;
      }

      #FooterTwo-{{ section.id }} .qf2__menu-details:not([open]) .qf2__menu-list{
        display: grid;
      }
    }

    @media (max-width: 740px){
      #FooterTwo-{{ section.id }} .qf2__shell,
      #FooterTwo-{{ section.id }} .qf2__trust-inner,
      #FooterTwo-{{ section.id }} .qf2__collections-inner,
      #FooterTwo-{{ section.id }} .qf2__bottom-inner{
        padding-left: 14px;
        padding-right: 14px;
      }

      #FooterTwo-{{ section.id }} .qf2__main{
        padding-top: 36px;
        padding-bottom: 36px;
      }

      #FooterTwo-{{ section.id }} .qf2__grid{
        grid-template-columns: 1fr;
        gap: 24px;
      }

      #FooterTwo-{{ section.id }} .qf2__trust-inner{
        grid-template-columns: 1fr;
      }

      #FooterTwo-{{ section.id }} .qf2__block--newsletter{
        padding: 18px;
      }

      #FooterTwo-{{ section.id }} .qf2__newsletter-row{
        flex-direction: column;
      }

      #FooterTwo-{{ section.id }} .qf2__newsletter-button{
        width: 100%;
      }

      #FooterTwo-{{ section.id }}.q-footer-two--mobile-accordion .qf2__menu-details{
        border-bottom: 1px solid var(--qf2-border);
        padding-bottom: 12px;
      }

      #FooterTwo-{{ section.id }}.q-footer-two--mobile-accordion .qf2__menu-summary{
        cursor: pointer;
        position: relative;
        padding-right: 26px;
      }

      #FooterTwo-{{ section.id }}.q-footer-two--mobile-accordion .qf2__menu-summary::after{
        content: "+";
        position: absolute;
        top: 0;
        right: 0;
        color: var(--qf2-heading);
        font-weight: 800;
      }

      #FooterTwo-{{ section.id }}.q-footer-two--mobile-accordion .qf2__menu-details[open] .qf2__menu-summary::after{
        content: "–";
      }

      #FooterTwo-{{ section.id }}.q-footer-two--mobile-accordion .qf2__menu-details:not([open]) .qf2__menu-list{
        display: none;
      }

      #FooterTwo-{{ section.id }} .qf2__collection-grid{
        grid-template-columns: 1fr;
      }

      #FooterTwo-{{ section.id }} .qf2__bottom-top,
      #FooterTwo-{{ section.id }} .qf2__bottom-lower{
        align-items: flex-start;
        justify-content: flex-start;
        flex-direction: column;
      }
    }
  </style>

  {% if section.settings.show_trust_strip and has_trust_items %}
    <div class="qf2__trust">
      <div class="qf2__trust-inner">
        {% for block in section.blocks %}
          {% if block.type == 'trust_item' %}
            <div class="qf2__trust-item" {{ block.shopify_attributes }}>
              {% if block.settings.icon_text != blank %}
                <span class="qf2__trust-icon" aria-hidden="true">{{ block.settings.icon_text }}</span>
              {% endif %}

              <div class="qf2__trust-content">
                {% if block.settings.heading != blank %}
                  <p class="qf2__trust-heading">{{ block.settings.heading }}</p>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="qf2__trust-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="qf2__main">
    <div class="qf2__shell">
      <div class="qf2__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'brand' %}
              <div
                class="qf2__block qf2__block--brand"
                {{ block.shopify_attributes }}
                style="--qf2-brand-logo-height: {{ block.settings.logo_height | default: section.settings.logo_height }}px;"
              >
                <div class="qf2__brand">
                  {% if block.settings.show_logo %}
                    <a class="qf2__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
                      {% if block.settings.logo != blank %}
                        <img
                          class="qf2__logo"
                          src="{{ block.settings.logo | image_url: width: 640 }}"
                          alt="{{ block.settings.logo_alt | default: shop.name | escape }}"
                          loading="lazy"
                        >
                      {% elsif settings.logo_primary != blank %}
                        <img
                          class="qf2__logo"
                          src="{{ settings.logo_primary | image_url: width: 640 }}"
                          alt="{{ shop.name | escape }}"
                          loading="lazy"
                        >
                      {% elsif settings.logo_mobile != blank %}
                        <img
                          class="qf2__logo"
                          src="{{ settings.logo_mobile | image_url: width: 640 }}"
                          alt="{{ shop.name | escape }}"
                          loading="lazy"
                        >
                      {% else %}
                        <span class="qf2__brand-name">{{ shop.name }}</span>
                      {% endif %}
                    </a>
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <p class="qf2__brand-name">{{ block.settings.heading }}</p>
                  {% elsif block.settings.show_heading_fallback %}
                    <p class="qf2__brand-name">{{ shop.name }}</p>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="qf2__text qf2__brand-copy">{{ block.settings.text }}</div>
                  {% elsif settings.site_tagline != blank %}
                    <p class="qf2__text qf2__brand-copy">{{ settings.site_tagline }}</p>
                  {% endif %}

                  {% if block.settings.phone != blank or block.settings.email != blank or block.settings.location_label != blank or block.settings.address != blank or block.settings.hours != blank %}
                    <ul class="qf2__brand-contact-list">
                      {% if block.settings.phone != blank %}
                        <li>
                          <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">
                            {{ block.settings.phone }}
                          </a>
                        </li>
                      {% endif %}

                      {% if block.settings.email != blank %}
                        <li>
                          <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                        </li>
                      {% endif %}

                      {% if block.settings.location_label != blank %}
                        <li>
                          {% if block.settings.location_url != blank %}
                            <a href="{{ block.settings.location_url }}">{{ block.settings.location_label }}</a>
                          {% else %}
                            {{ block.settings.location_label }}
                          {% endif %}
                        </li>
                      {% endif %}

                      {% if block.settings.address != blank %}
                        <li>{{ block.settings.address | newline_to_br }}</li>
                      {% endif %}

                      {% if block.settings.hours != blank %}
                        <li>{{ block.settings.hours | newline_to_br }}</li>
                      {% endif %}
                    </ul>
                  {% endif %}

                  {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                    <a class="qf2__button qf2__button--{{ block.settings.button_style }}" href="{{ block.settings.button_url }}">
                      {{ block.settings.button_label }}
                    </a>
                  {% endif %}

                  {% if block.settings.facebook_url != blank or block.settings.instagram_url != blank or block.settings.tiktok_url != blank or block.settings.youtube_url != blank or block.settings.pinterest_url != blank or block.settings.linkedin_url != blank or block.settings.x_url != blank %}
                    <ul class="qf2__brand-social-list" aria-label="Brand social links">
                      {% if block.settings.facebook_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.facebook_url }}" rel="noopener" target="_blank" aria-label="Facebook">FB</a></li>
                      {% endif %}

                      {% if block.settings.instagram_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.instagram_url }}" rel="noopener" target="_blank" aria-label="Instagram">IG</a></li>
                      {% endif %}

                      {% if block.settings.tiktok_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.tiktok_url }}" rel="noopener" target="_blank" aria-label="TikTok">TT</a></li>
                      {% endif %}

                      {% if block.settings.youtube_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.youtube_url }}" rel="noopener" target="_blank" aria-label="YouTube">YT</a></li>
                      {% endif %}

                      {% if block.settings.pinterest_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.pinterest_url }}" rel="noopener" target="_blank" aria-label="Pinterest">PI</a></li>
                      {% endif %}

                      {% if block.settings.linkedin_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.linkedin_url }}" rel="noopener" target="_blank" aria-label="LinkedIn">IN</a></li>
                      {% endif %}

                      {% if block.settings.x_url != blank %}
                        <li><a class="qf2__brand-social-link" href="{{ block.settings.x_url }}" rel="noopener" target="_blank" aria-label="X">X</a></li>
                      {% endif %}
                    </ul>
                  {% endif %}
                </div>
              </div>

            {% when 'menu' %}
              <div class="qf2__block qf2__block--menu" {{ block.shopify_attributes }}>
                {% if mobile_layout == 'accordion' and block.settings.collapse_on_mobile %}
                  <details class="qf2__menu-details" open>
                    <summary class="qf2__menu-summary">
                      {% if block.settings.heading != blank %}
                        <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                      {% endif %}
                    </summary>

                    {% if block.settings.menu != blank and block.settings.menu.links != blank %}
                      <ul class="qf2__menu-list">
                        {% for link in block.settings.menu.links %}
                          <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% elsif request.design_mode %}
                      <p class="qf2__editor-note">Select a menu for this footer block.</p>
                    {% endif %}
                  </details>
                {% else %}
                  {% if block.settings.heading != blank %}
                    <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                  {% endif %}

                  {% if block.settings.menu != blank and block.settings.menu.links != blank %}
                    <ul class="qf2__menu-list">
                      {% for link in block.settings.menu.links %}
                        <li>
                          <a href="{{ link.url }}">{{ link.title }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% elsif request.design_mode %}
                    <p class="qf2__editor-note">Select a menu for this footer block.</p>
                  {% endif %}
                {% endif %}
              </div>

            {% when 'account_links' %}
              <div class="qf2__block qf2__block--account" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                {% endif %}

                <ul class="qf2__account-list">
                  {% if block.settings.show_account %}
                    <li>
                      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                        {% if customer %}Account{% else %}Log in{% endif %}
                      </a>
                    </li>
                  {% endif %}

                  {% if block.settings.show_orders %}
                    <li>
                      <a href="{{ routes.account_url }}">Orders</a>
                    </li>
                  {% endif %}

                  {% if block.settings.show_addresses %}
                    <li>
                      <a href="{{ routes.account_addresses_url }}">Addresses</a>
                    </li>
                  {% endif %}

                  {% if block.settings.tracking_label != blank and block.settings.tracking_url != blank %}
                    <li>
                      <a href="{{ block.settings.tracking_url }}">{{ block.settings.tracking_label }}</a>
                    </li>
                  {% endif %}

                  {% if customer and block.settings.show_logout %}
                    <li>
                      <a href="{{ routes.account_logout_url }}">Log out</a>
                    </li>
                  {% endif %}
                </ul>
              </div>

            {% when 'newsletter' %}
              <div class="qf2__block qf2__block--newsletter" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="qf2__text">{{ block.settings.text }}</div>
                {% endif %}

                {% form 'customer', class: 'qf2__newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <div class="qf2__newsletter-row">
                    <label class="qf2__visually-hidden" for="FooterTwoNewsletterEmail-{{ section.id }}-{{ block.id }}">
                      Email address
                    </label>

                    <input
                      id="FooterTwoNewsletterEmail-{{ section.id }}-{{ block.id }}"
                      class="qf2__newsletter-input"
                      type="email"
                      name="contact[email]"
                      value="{{ form.email }}"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      placeholder="{{ block.settings.placeholder | escape }}"
                      aria-label="{{ block.settings.placeholder | default: 'Email address' | escape }}"
                      required
                    >

                    <button class="qf2__newsletter-button" type="submit">
                      {{ block.settings.button_label }}
                    </button>
                  </div>

                  {% if form.posted_successfully? %}
                    <p class="qf2__form-message qf2__form-message--success" tabindex="-1">
                      Thanks for subscribing.
                    </p>
                  {% endif %}

                  {% if form.errors %}
                    <div class="qf2__form-message">
                      {{ form.errors | default_errors }}
                    </div>
                  {% endif %}
                {% endform %}
              </div>

            {% when 'social' %}
              <div class="qf2__block qf2__block--social" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                {% endif %}

                <ul class="qf2__social-list" aria-label="Social links">
                  {% if settings.social_facebook_link != blank %}
                    <li><a class="qf2__social-link" href="{{ settings.social_facebook_link }}" rel="noopener" target="_blank" aria-label="Facebook">FB</a></li>
                  {% endif %}
                  {% if settings.social_instagram_link != blank %}
                    <li><a class="qf2__social-link" href="{{ settings.social_instagram_link }}" rel="noopener" target="_blank" aria-label="Instagram">IG</a></li>
                  {% endif %}
                  {% if settings.social_tiktok_link != blank %}
                    <li><a class="qf2__social-link" href="{{ settings.social_tiktok_link }}" rel="noopener" target="_blank" aria-label="TikTok">TT</a></li>
                  {% endif %}
                  {% if settings.social_youtube_link != blank %}
                    <li><a class="qf2__social-link" href="{{ settings.social_youtube_link }}" rel="noopener" target="_blank" aria-label="YouTube">YT</a></li>
                  {% endif %}
                  {% if settings.social_pinterest_link != blank %}
                    <li><a class="qf2__social-link" href="{{ settings.social_pinterest_link }}" rel="noopener" target="_blank" aria-label="Pinterest">PI</a></li>
                  {% endif %}
                  {% if settings.social_linkedin_link != blank %}
                    <li><a class="qf2__social-link" href="{{ settings.social_linkedin_link }}" rel="noopener" target="_blank" aria-label="LinkedIn">IN</a></li>
                  {% endif %}
                </ul>
              </div>

            {% when 'contact' %}
              <div class="qf2__block qf2__block--contact" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="qf2__text">{{ block.settings.text }}</div>
                {% endif %}

                <ul class="qf2__contact-list">
                  {% if block.settings.phone != blank %}
                    <li>
                      <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">
                        {{ block.settings.phone }}
                      </a>
                    </li>
                  {% endif %}

                  {% if block.settings.email != blank %}
                    <li>
                      <a href="mailto:{{ block.settings.email }}">
                        {{ block.settings.email }}
                      </a>
                    </li>
                  {% endif %}

                  {% if block.settings.location_label != blank %}
                    <li>
                      {% if block.settings.location_url != blank %}
                        <a href="{{ block.settings.location_url }}">{{ block.settings.location_label }}</a>
                      {% else %}
                        {{ block.settings.location_label }}
                      {% endif %}
                    </li>
                  {% endif %}

                  {% if block.settings.address != blank %}
                    <li>{{ block.settings.address | newline_to_br }}</li>
                  {% endif %}

                  {% if block.settings.hours != blank %}
                    <li>{{ block.settings.hours | newline_to_br }}</li>
                  {% endif %}
                </ul>

                {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                  <a class="qf2__button qf2__button--{{ block.settings.button_style }}" href="{{ block.settings.button_url }}">
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>

            {% when 'richtext' %}
              <div class="qf2__block qf2__block--richtext" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="qf2__heading">{{ block.settings.heading }}</h3>
                {% endif %}

                {% if block.settings.content != blank %}
                  <div class="qf2__rte">
                    {{ block.settings.content }}
                  </div>
                {% endif %}
              </div>

            {% when 'custom_liquid' %}
              <div class="qf2__block qf2__block--custom-liquid" {{ block.shopify_attributes }}>
                <div class="qf2__custom-liquid">
                  {{ block.settings.custom_liquid }}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% if has_featured_collections %}
    <div class="qf2__collections">
      <div class="qf2__collections-inner">
        {% if section.settings.featured_collections_heading != blank %}
          <h2 class="qf2__collections-title">{{ section.settings.featured_collections_heading }}</h2>
        {% endif %}

        <div class="qf2__collection-grid">
          {% for block in section.blocks %}
            {% if block.type == 'featured_collection' %}
              {% liquid
                assign featured_collection = block.settings.collection
                assign collection_title = block.settings.custom_heading

                if collection_title == blank and featured_collection != blank
                  assign collection_title = featured_collection.title
                endif
              %}

              {% if featured_collection != blank %}
                <a class="qf2__collection-card" href="{{ featured_collection.url }}" {{ block.shopify_attributes }}>
                  {% if block.settings.show_image %}
                    {% if featured_collection.image != blank %}
                      <img
                        class="qf2__collection-image"
                        src="{{ featured_collection.image | image_url: width: 180, height: 180, crop: 'center' }}"
                        alt="{{ collection_title | escape }}"
                        loading="lazy"
                      >
                    {% elsif featured_collection.featured_image != blank %}
                      <img
                        class="qf2__collection-image"
                        src="{{ featured_collection.featured_image | image_url: width: 180, height: 180, crop: 'center' }}"
                        alt="{{ collection_title | escape }}"
                        loading="lazy"
                      >
                    {% else %}
                      <span class="qf2__collection-placeholder" aria-hidden="true">Shop</span>
                    {% endif %}
                  {% endif %}

                  <span class="qf2__collection-title">{{ collection_title }}</span>
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="qf2__bottom">
    <div class="qf2__bottom-inner">
      <div class="qf2__bottom-top">
        <p class="qf2__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </p>

        {% if section.settings.bottom_menu != blank and section.settings.bottom_menu.links != blank %}
          <ul class="qf2__bottom-menu" aria-label="Footer utility links">
            {% for link in section.settings.bottom_menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% if section.settings.bottom_message != blank %}
        <p class="qf2__bottom-text">{{ section.settings.bottom_message }}</p>
      {% endif %}

      <div class="qf2__bottom-lower">
        {% if section.settings.show_policy_links and shop.policies != blank %}
          <ul class="qf2__policy-links" aria-label="Policy links">
            {% for policy in shop.policies %}
              {% if policy != blank and policy.url != blank %}
                <li>
                  <a href="{{ policy.url }}">{{ policy.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <div class="qf2__payments" aria-label="Accepted payment methods">
            {% if shop.enabled_payment_types != blank %}
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'qf2__payment-icon' }}
              {% endfor %}
            {% elsif section.settings.show_payment_fallback %}
              <span class="qf2__payment-pill" aria-hidden="true">Visa</span>
              <span class="qf2__payment-pill" aria-hidden="true">Mastercard</span>
              <span class="qf2__payment-pill" aria-hidden="true">Amex</span>
              <span class="qf2__payment-pill" aria-hidden="true">PayPal</span>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.show_country_selector or section.settings.show_language_selector %}
          <div class="qf2__localization">
            {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}
              {% assign qf2_country_form_id = 'FooterTwoCountryForm-' | append: section.id %}
              {% form 'localization', id: qf2_country_form_id, class: 'qf2__localization-form' %}
                <label class="qf2__visually-hidden" for="FooterTwoCountrySelector-{{ section.id }}">Country/region</label>
                <select
                  id="FooterTwoCountrySelector-{{ section.id }}"
                  class="qf2__localization-select"
                  name="country_code"
                  onchange="this.form.submit()"
                >
                  {% for country in localization.available_countries %}
                    <option
                      value="{{ country.iso_code }}"
                      {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {% endfor %}
                </select>
              {% endform %}
            {% endif %}

            {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
              {% assign qf2_language_form_id = 'FooterTwoLanguageForm-' | append: section.id %}
              {% form 'localization', id: qf2_language_form_id, class: 'qf2__localization-form' %}
                <label class="qf2__visually-hidden" for="FooterTwoLanguageSelector-{{ section.id }}">Language</label>
                <select
                  id="FooterTwoLanguageSelector-{{ section.id }}"
                  class="qf2__localization-select"
                  name="locale_code"
                  onchange="this.form.submit()"
                >
                  {% for language in localization.available_languages %}
                    <option
                      value="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                    >
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {% endfor %}
                </select>
              {% endform %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Two",
  "class": "qtm-footer-two-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "footer_layout",
      "label": "Footer layout",
      "default": "commerce",
      "options": [
        { "value": "commerce", "label": "Commerce" },
        { "value": "commerce_wide", "label": "Commerce wide" },
        { "value": "commerce_dense", "label": "Commerce dense" }
      ]
    },
    {
      "type": "select",
      "id": "footer_width",
      "label": "Footer width",
      "default": "wide",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "accordion",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "accordion", "label": "Accordion menus" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 24,
      "max": 96,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 24,
      "max": 96,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Trust strip"
