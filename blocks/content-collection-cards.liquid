{%- liquid
  assign block_id = 'content-collection-cards-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign collection_source = block.settings.collection_source | default: 'manual'
  assign selected_collection = block.settings.collection
  assign card_layout = block.settings.card_layout | default: 'visual'
  assign collection_limit = block.settings.collection_limit | default: 6

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-collection-cards
    content-collection-cards--{{ card_layout }}
    content-collection-cards--width-{{ width }}
    content-collection-cards--align-{{ alignment }}
    {% unless show_on_desktop %} content-collection-cards--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-collection-cards--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-collection-cards--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-collection-cards--animate content-collection-cards--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-collection-cards-margin-top: {{ block.settings.margin_top }}px;
    --content-collection-cards-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-collection-cards-padding: {{ block.settings.padding }}px;
    --content-collection-cards-gap: {{ block.settings.card_gap }}px;
    --content-collection-cards-card-padding: {{ block.settings.card_padding }}px;
    --content-collection-cards-card-radius: {{ block.settings.card_radius }}px;
    --content-collection-cards-image-radius: {{ block.settings.image_radius }}px;
    --content-collection-cards-border-width: {{ block.settings.border_width }}px;
    --content-collection-cards-columns-desktop: {{ block.settings.columns_desktop }};
    --content-collection-cards-columns-tablet: {{ block.settings.columns_tablet }};
    --content-collection-cards-columns-mobile: {{ block.settings.columns_mobile }};
    --content-collection-cards-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --content-collection-cards-heading-color: {{ block.settings.heading_color }};
    --content-collection-cards-text-color: {{ block.settings.text_color }};
    --content-collection-cards-background: {{ block.settings.background_color }};
    --content-collection-cards-card-background: {{ block.settings.card_background_color }};
    --content-collection-cards-border-color: {{ block.settings.border_color }};
    --content-collection-cards-button-background: {{ block.settings.button_background_color }};
    --content-collection-cards-button-text: {{ block.settings.button_text_color }};
    --content-collection-cards-overlay-color: {{ block.settings.overlay_color }};
    --content-collection-cards-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --content-collection-cards-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-collection-cards
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-collection-cards-margin-top);
      margin-bottom: var(--content-collection-cards-margin-bottom);
      padding: var(--content-collection-cards-padding);
      color: var(--content-collection-cards-text-color);
      background: var(--content-collection-cards-background);
    }

    #{{ block_id }}.content-collection-cards--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-collection-cards--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.content-collection-cards--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.content-collection-cards--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.content-collection-cards--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-collection-cards--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-collection-cards--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-collection-cards--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-collection-cards__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .content-collection-cards__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }}.content-collection-cards--align-center .content-collection-cards__header {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-collection-cards--align-right .content-collection-cards__header {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-collection-cards__eyebrow {
      margin: 0;
      color: var(--content-collection-cards-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    #{{ block_id }} .content-collection-cards__heading {
      margin: 0;
      color: var(--content-collection-cards-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .content-collection-cards__description {
      margin: 0;
      color: var(--content-collection-cards-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .content-collection-cards__items {
      display: grid;
      grid-template-columns: repeat(var(--content-collection-cards-columns-desktop), minmax(0, 1fr));
      gap: var(--content-collection-cards-gap);
      min-width: 0;
    }

    #{{ block_id }} .content-collection-cards__card {
      position: relative;
      display: grid;
      gap: 14px;
      min-width: 0;
      height: 100%;
      color: var(--content-collection-cards-text-color);
      text-decoration: none;
      padding: var(--content-collection-cards-card-padding);
      background: var(--content-collection-cards-card-background);
      border: var(--content-collection-cards-border-width) solid var(--content-collection-cards-border-color);
      border-radius: var(--content-collection-cards-card-radius);
      overflow: hidden;
      isolation: isolate;
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }

    #{{ block_id }} .content-collection-cards__card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--content-collection-cards-border-color), var(--content-collection-cards-heading-color) 28%);
      box-shadow: 0 18px 46px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.content-collection-cards--compact .content-collection-cards__card {
      grid-template-columns: {{ block.settings.compact_image_size }}px minmax(0, 1fr);
      align-items: center;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__card {
      min-height: {{ block.settings.overlay_card_height }}px;
      padding: 0;
    }

    #{{ block_id }} .content-collection-cards__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: var(--content-collection-cards-image-radius);
      aspect-ratio: var(--content-collection-cards-image-ratio);
    }

    #{{ block_id }}.content-collection-cards--compact .content-collection-cards__media {
      width: {{ block.settings.compact_image_size }}px;
      height: {{ block.settings.compact_image_size }}px;
      aspect-ratio: 1;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      height: 100%;
      border-radius: 0;
      aspect-ratio: auto;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--content-collection-cards-overlay-color);
      opacity: var(--content-collection-cards-overlay-opacity);
      pointer-events: none;
    }

    #{{ block_id }} .content-collection-cards__media img,
    #{{ block_id }} .content-collection-cards__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 340ms ease;
    }

    #{{ block_id }} .content-collection-cards__card:hover .content-collection-cards__media img {
      transform: scale(1.04);
    }

    #{{ block_id }} .content-collection-cards__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
    }

    #{{ block_id }} .content-collection-cards__content {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__content {
      position: relative;
      z-index: 2;
      align-self: end;
      padding: var(--content-collection-cards-card-padding);
      color: #ffffff;
    }

    #{{ block_id }}.content-collection-cards--align-center .content-collection-cards__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }}.content-collection-cards--align-right .content-collection-cards__content {
      justify-items: end;
      text-align: right;
    }

    #{{ block_id }}.content-collection-cards--compact.content-collection-cards--align-center .content-collection-cards__content,
    #{{ block_id }}.content-collection-cards--compact.content-collection-cards--align-right .content-collection-cards__content {
      justify-items: start;
      text-align: left;
    }

    #{{ block_id }} .content-collection-cards__title {
      margin: 0;
      color: var(--content-collection-cards-heading-color);
      font-size: {{ block.settings.collection_title_size }}px;
      line-height: 1.2;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__title {
      color: #ffffff;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.24);
    }

    #{{ block_id }} .content-collection-cards__meta {
      color: var(--content-collection-cards-text-color);
      font-size: 0.92em;
      line-height: 1.35;
      opacity: 0.76;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__meta {
      color: #ffffff;
      opacity: 0.9;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.24);
    }

    #{{ block_id }} .content-collection-cards__copy {
      margin: 0;
      color: var(--content-collection-cards-text-color);
      font-size: 0.95em;
      line-height: 1.5;
      opacity: 0.84;
    }

    #{{ block_id }}.content-collection-cards--overlay .content-collection-cards__copy {
      color: #ffffff;
      opacity: 0.92;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.24);
    }

    #{{ block_id }} .content-collection-cards__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 40px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--content-collection-cards-button-text);
      background: var(--content-collection-cards-button-background);
      border: 1px solid var(--content-collection-cards-button-background);
      border-radius: max(calc(var(--content-collection-cards-card-radius) - 12px), 6px);
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-collection-cards__button:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-collection-cards__card:focus-visible {
      outline: 2px solid var(--content-collection-cards-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-collection-cards__empty {
      padding: 18px;
      color: var(--content-collection-cards-text-color);
      background: var(--content-collection-cards-card-background);
      border: var(--content-collection-cards-border-width) solid var(--content-collection-cards-border-color);
      border-radius: var(--content-collection-cards-card-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-collection-cards--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-collection-cards--animate-fade {
      animation-name: contentCollectionCardsFade;
    }

    #{{ block_id }}.content-collection-cards--animate-fade_up {
      animation-name: contentCollectionCardsFadeUp;
    }

    #{{ block_id }}.content-collection-cards--animate-zoom {
      animation-name: contentCollectionCardsZoom;
    }

    @keyframes contentCollectionCardsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentCollectionCardsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentCollectionCardsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-collection-cards--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-collection-cards--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-collection-cards__items {
        grid-template-columns: repeat(var(--content-collection-cards-columns-tablet), minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-collection-cards--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-collection-cards__items {
        grid-template-columns: repeat(var(--content-collection-cards-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }} .content-collection-cards__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }}.content-collection-cards--compact .content-collection-cards__card {
        grid-template-columns: {{ block.settings.compact_image_size_mobile }}px minmax(0, 1fr);
      }

      #{{ block_id }}.content-collection-cards--compact .content-collection-cards__media {
        width: {{ block.settings.compact_image_size_mobile }}px;
        height: {{ block.settings.compact_image_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-collection-cards--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-collection-cards__card,
      #{{ block_id }} .content-collection-cards__media img,
      #{{ block_id }} .content-collection-cards__button {
        transition: none;
      }

      #{{ block_id }} .content-collection-cards__card:hover,
      #{{ block_id }} .content-collection-cards__card:hover .content-collection-cards__media img,
      #{{ block_id }} .content-collection-cards__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-collection-cards__inner">
    {% if block.settings.show_header %}
      <div class="content-collection-cards__header">
        {% if block.settings.eyebrow != blank %}
          <p class="content-collection-cards__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="content-collection-cards__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="content-collection-cards__description">
            {{ block.settings.description | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {%- liquid
      assign rendered_collections = 0
    -%}

    <div class="content-collection-cards__items">
      {% if collection_source == 'featured' and selected_collection != blank %}
        {%- liquid
          assign rendered_collections = rendered_collections | plus: 1
          assign card_collection = selected_collection
          assign collection_image = card_collection.image | default: card_collection.featured_image
        -%}

        <a class="content-collection-cards__card" href="{{ card_collection.url }}" aria-label="{{ card_collection.title | escape }}">
          <span class="content-collection-cards__media">
            {% if collection_image %}
              {{ collection_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '240, 360, 540, 720, 900, 1200', alt: collection_image.alt | default: card_collection.title }}
            {% else %}
              <span class="content-collection-cards__placeholder" aria-hidden="true"></span>
            {% endif %}
          </span>

          <span class="content-collection-cards__content">
            <span class="content-collection-cards__title">
              {{ card_collection.title | escape }}
            </span>

            {% if block.settings.show_product_count %}
              <span class="content-collection-cards__meta">
                {{ card_collection.products_count }} {{ block.settings.product_count_label | escape }}
              </span>
            {% endif %}

            {% if block.settings.show_collection_description %}
              <span class="content-collection-cards__copy">
                {% if card_collection.description != blank %}
                  {{ card_collection.description | strip_html | truncatewords: block.settings.description_words }}
                {% else %}
                  {{ block.settings.fallback_description | escape }}
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.show_button %}
              <span class="content-collection-cards__button">
                {{ block.settings.button_label | escape }}
              </span>
            {% endif %}
          </span>
        </a>
      {% else %}
        {% for card_collection in block.settings.collections limit: collection_limit %}
          {%- liquid
            assign rendered_collections = rendered_collections | plus: 1
            assign collection_image = card_collection.image | default: card_collection.featured_image
          -%}

          <a class="content-collection-cards__card" href="{{ card_collection.url }}" aria-label="{{ card_collection.title | escape }}">
            <span class="content-collection-cards__media">
              {% if collection_image %}
                {% if forloop.first %}
                  {{ collection_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '240, 360, 540, 720, 900, 1200', alt: collection_image.alt | default: card_collection.title }}
                {% else %}
                  {{ collection_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900, 1200', alt: collection_image.alt | default: card_collection.title }}
                {% endif %}
              {% else %}
                <span class="content-collection-cards__placeholder" aria-hidden="true"></span>
              {% endif %}
            </span>

            <span class="content-collection-cards__content">
              <span class="content-collection-cards__title">
                {{ card_collection.title | escape }}
              </span>

              {% if block.settings.show_product_count %}
                <span class="content-collection-cards__meta">
                  {{ card_collection.products_count }} {{ block.settings.product_count_label | escape }}
                </span>
              {% endif %}

              {% if block.settings.show_collection_description %}
                <span class="content-collection-cards__copy">
                  {% if card_collection.description != blank %}
                    {{ card_collection.description | strip_html | truncatewords: block.settings.description_words }}
                  {% else %}
                    {{ block.settings.fallback_description | escape }}
                  {% endif %}
                </span>
              {% endif %}

              {% if block.settings.show_button %}
                <span class="content-collection-cards__button">
                  {{ block.settings.button_label | escape }}
                </span>
              {% endif %}
            </span>
          </a>
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_collections == 0 and block.settings.show_empty_state %}
      <div class="content-collection-cards__empty">
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection cards",
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "select",
      "id": "collection_source",
      "label": "Collection source",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "Manual collections"
        },
        {
          "value": "featured",
          "label": "Featured collection"
        }
      ]
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Manual collections",
      "limit": 24
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "collection_limit",
      "label": "Collection limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },

    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visual navigation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Use visual cards to guide shoppers into important collections."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Card layout",
      "default": "visual",
      "options": [
        {
          "value": "visual",
          "label": "Visual"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "text",
      "id": "product_count_label",
      "label": "Product count label",
      "default": "products"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "text",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "Explore this collection and discover products selected for this shopping path."
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Description words",
      "min": 6,
      "max": 40,
      "step": 2,
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop collection"
    },
    {
      "type": "range",
      "id": "collection_title_size",
      "label": "Collection title size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },

    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
