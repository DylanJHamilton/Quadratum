{
  "sections": {
    "orvaine_1": {
      "type": "main-product-simple",
      "settings": {
        "section_aria_label": "Product details",
        "enable_sticky_info": true,
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "original",
        "gallery_layout": "thumbnails",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_looping": false,
        "variant_picker_type": "buttons",
        "show_dynamic_checkout": false,
        "below_atc_content": "short",
        "short_description_metafield_key": "custom.short_description",
        "padding_top": 36,
        "padding_bottom": 96
      },
      "blocks": {
        "er_1": {
          "type": "accordion_description",
          "settings": {
            "title": "Description",
            "open_by_default": true
          }
        },
        "er_2": {
          "type": "accordion_metafield",
          "settings": {
            "title": "Proposed specifications",
            "open_by_default": false,
            "metafield_key": "custom.proposed_specification",
            "fallback_text": "Proposed materials and construction for this fictional design."
          }
        },
        "er_3": {
          "type": "accordion_metafield",
          "settings": {
            "title": "Proposed dimensions",
            "open_by_default": false,
            "metafield_key": "custom.proposed_dimensions",
            "fallback_text": "Fictional proposed dimensions, not measured."
          }
        },
        "er_4": {
          "type": "accordion_metafield",
          "settings": {
            "title": "Care",
            "open_by_default": false,
            "metafield_key": "custom.care_guidance",
            "fallback_text": "Care guidance will be confirmed against the final material specification. Do not treat this concept listing as a cleaning instruction."
          }
        },
        "er_5": {
          "type": "accordion_metafield",
          "settings": {
            "title": "What is included",
            "open_by_default": false,
            "metafield_key": "custom.included_items",
            "fallback_text": ""
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4",
        "er_5"
      ]
    },
