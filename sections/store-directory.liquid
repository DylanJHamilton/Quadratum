{{ 'store-directory.css' | asset_url | stylesheet_tag }}
<section class="store-directory" aria-labelledby="Directory-{{ section.id }}">
  <header class="store-directory__header">
    {% if section.settings.eyebrow != blank %}<p class="store-directory__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <{{ section.settings.heading_tag }} id="Directory-{{ section.id }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
    {% if section.settings.intro != blank %}<div class="store-directory__intro rte">{{ section.settings.intro }}</div>{% endif %}
  </header>
  <div class="store-directory__grid">
    {% assign card_heading = 'h3' %}
    {% if section.settings.heading_tag == 'h1' %}{% assign card_heading = 'h2' %}{% endif %}
    {% for block in section.blocks %}
      <article class="store-directory__card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw', class: 'store-directory__image' }}
        {% endif %}
        <div class="store-directory__body">
          {% if block.settings.category != blank %}<p class="store-directory__eyebrow">{{ block.settings.category | escape }}</p>{% endif %}
          <{{ card_heading }}>{{ block.settings.title | escape }}</{{ card_heading }}>
          {% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}
          {% if block.settings.url != blank %}<a href="{{ block.settings.url }}" aria-label="{{ block.settings.label | escape }}: {{ block.settings.title | escape }}">{{ block.settings.label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  {% if section.settings.show_popup and settings.popup_enable %}
    <div class="store-directory__popup"><h3>Stay in the loop.</h3><p>Preview our newsletter invitation whenever you like.</p><button type="button" data-qtm-popup-open>Open invitation</button></div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Store directory",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Explore"},
    {"type":"text","id":"heading","label":"Heading","default":"Find your next destination."},
    {"type":"select","id":"heading_tag","label":"Heading level","default":"h2","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"}]},
    {"type":"richtext","id":"intro","label":"Introduction"},
    {"type":"checkbox","id":"show_popup","label":"Show newsletter invitation button","default":false}
  ],
  "blocks":[{"type":"destination","name":"Destination","settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"category","label":"Category"},
    {"type":"text","id":"title","label":"Title","default":"Explore the collection"},
    {"type":"textarea","id":"description","label":"Description"},
    {"type":"text","id":"label","label":"Link label","default":"Explore"},
    {"type":"url","id":"url","label":"Link"}
  ]}],
  "max_blocks":30,
  "presets":[{"name":"Store directory","blocks":[{"type":"destination"},{"type":"destination"},{"type":"destination"}]}]
}
{% endschema %}
