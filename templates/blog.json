      "block_order": [
        "van_1"
      ],
      "custom_css": [
        ".q-bhs__layout--single{grid-template-columns:1fr;}",
        ".q-blogcard{display:grid;grid-template-columns:1.25fr 1fr;}",
        ".q-blogcard__media{height:100%;min-height:420px;}",
