{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation

  assign phone_clean = block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' | remove: '+'
  assign phone_href = 'tel:' | append: block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign email_href = 'mailto:' | append: block.settings.email
%}

<div
  class="
    qtm-contact-info
    qtm-contact-info-{{ block_id }}
    qtm-contact-info--width-{{ block_width }}
    qtm-contact-info--align-{{ block_alignment }}
    qtm-contact-info--layout-{{ block.settings.layout_style }}
    qtm-contact-info--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-contact-info--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-contact-info--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-contact-info--hide-mobile{% endunless %}
  "
  style="
    --qtm-contact-info-margin-top: {{ block.settings.margin_top }}px;
    --qtm-contact-info-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-contact-info-padding: {{ block.settings.padding }}px;
    --qtm-contact-info-gap: {{ block.settings.gap }}px;
    --qtm-contact-info-heading-color: {{ block.settings.heading_color }};
    --qtm-contact-info-text-color: {{ block.settings.text_color }};
    --qtm-contact-info-background-color: {{ block.settings.background_color }};
    --qtm-contact-info-card-background: {{ block.settings.card_background_color }};
    --qtm-contact-info-border-color: {{ block.settings.border_color }};
    --qtm-contact-info-link-color: {{ block.settings.link_color }};
    --qtm-contact-info-icon-background: {{ block.settings.icon_background_color }};
    --qtm-contact-info-icon-color: {{ block.settings.icon_color }};
    --qtm-contact-info-button-background: {{ block.settings.button_background_color }};
    --qtm-contact-info-button-text: {{ block.settings.button_text_color }};
    --qtm-contact-info-border-width: {{ block.settings.border_width }}px;
    --qtm-contact-info-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-contact-info__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.support_text != blank %}
      <div class="qtm-contact-info__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-contact-info__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-contact-info__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.support_text != blank %}
          <div class="qtm-contact-info__support-text">
            {{ block.settings.support_text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-contact-info__items" role="list">
      {% if block.settings.phone != blank %}
        <div class="qtm-contact-info__item" role="listitem">
          {% if block.settings.show_icons %}
            <span class="qtm-contact-info__icon" aria-hidden="true">
              {{ block.settings.phone_icon | escape }}
            </span>
          {% endif %}

          <div class="qtm-contact-info__item-copy">
            <span class="qtm-contact-info__label">
              {{ block.settings.phone_label | escape }}
            </span>

            <a class="qtm-contact-info__link" href="{{ phone_href }}">
              {{ block.settings.phone | escape }}
            </a>
          </div>
        </div>
      {% endif %}

      {% if block.settings.email != blank %}
        <div class="qtm-contact-info__item" role="listitem">
          {% if block.settings.show_icons %}
            <span class="qtm-contact-info__icon" aria-hidden="true">
              {{ block.settings.email_icon | escape }}
            </span>
          {% endif %}

          <div class="qtm-contact-info__item-copy">
            <span class="qtm-contact-info__label">
              {{ block.settings.email_label | escape }}
            </span>

            <a class="qtm-contact-info__link" href="{{ email_href }}">
              {{ block.settings.email | escape }}
            </a>
          </div>
        </div>
      {% endif %}

      {% if block.settings.address != blank %}
        <div class="qtm-contact-info__item" role="listitem">
          {% if block.settings.show_icons %}
            <span class="qtm-contact-info__icon" aria-hidden="true">
              {{ block.settings.address_icon | escape }}
            </span>
          {% endif %}

          <div class="qtm-contact-info__item-copy">
            <span class="qtm-contact-info__label">
              {{ block.settings.address_label | escape }}
            </span>

            {% if block.settings.address_url != blank %}
              <a class="qtm-contact-info__link" href="{{ block.settings.address_url }}" target="_blank" rel="noopener">
                {{ block.settings.address | newline_to_br }}
              </a>
            {% else %}
              <span class="qtm-contact-info__value">
                {{ block.settings.address | newline_to_br }}
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.hours != blank %}
        <div class="qtm-contact-info__item" role="listitem">
          {% if block.settings.show_icons %}
            <span class="qtm-contact-info__icon" aria-hidden="true">
              {{ block.settings.hours_icon | escape }}
            </span>
          {% endif %}

          <div class="qtm-contact-info__item-copy">
            <span class="qtm-contact-info__label">
              {{ block.settings.hours_label | escape }}
            </span>

            <span class="qtm-contact-info__value">
              {{ block.settings.hours | newline_to_br }}
            </span>
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.button_label != blank and block.settings.button_url != blank %}
      <div class="qtm-contact-info__footer">
        <a class="qtm-contact-info__button" href="{{ block.settings.button_url }}">
          {{ block.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .qtm-contact-info-{{ block_id }} {
    margin-top: var(--qtm-contact-info-margin-top);
    margin-bottom: var(--qtm-contact-info-margin-bottom);
    padding: var(--qtm-contact-info-padding);
    color: var(--qtm-contact-info-text-color);
    background: var(--qtm-contact-info-background-color);
    border: var(--qtm-contact-info-border-width) solid var(--qtm-contact-info-border-color);
    border-radius: var(--qtm-contact-info-border-radius);
  }

  .qtm-contact-info-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--width-auto {
    width: auto;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--width-small {
    max-width: 640px;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--width-medium {
    max-width: 860px;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--width-large {
    max-width: 1120px;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__inner {
    display: grid;
    gap: var(--qtm-contact-info-gap);
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__header {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-center .qtm-contact-info__header {
    margin-inline: auto;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-right .qtm-contact-info__header {
    margin-left: auto;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__eyebrow {
    margin: 0;
    color: var(--qtm-contact-info-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__heading {
    margin: 0;
    color: var(--qtm-contact-info-heading-color);
    line-height: 1.05;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__support-text {
    color: var(--qtm-contact-info-text-color);
    line-height: 1.7;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__support-text p {
    margin-top: 0;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__support-text p:last-child {
    margin-bottom: 0;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__items {
    display: grid;
    gap: calc(var(--qtm-contact-info-gap) * 0.55);
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-cards .qtm-contact-info__items {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-compact .qtm-contact-info__items {
    gap: 0.5rem;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-minimal .qtm-contact-info__items {
    gap: 0.45rem;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding: 1rem;
    color: var(--qtm-contact-info-text-color);
    background: var(--qtm-contact-info-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-contact-info-border-color), transparent 12%);
    border-radius: calc(var(--qtm-contact-info-border-radius) * 0.65);
    text-align: left;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-list .qtm-contact-info__item {
    background: var(--qtm-contact-info-card-background);
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-compact .qtm-contact-info__item,
  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-minimal .qtm-contact-info__item {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-minimal .qtm-contact-info__item {
    grid-template-columns: minmax(0, 1fr);
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-minimal .qtm-contact-info__icon {
    display: none;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    color: var(--qtm-contact-info-icon-color);
    background: var(--qtm-contact-info-icon-background);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__item-copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__label {
    color: var(--qtm-contact-info-heading-color);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__link,
  .qtm-contact-info-{{ block_id }} .qtm-contact-info__value {
    color: var(--qtm-contact-info-text-color);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__link {
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__link:hover {
    color: var(--qtm-contact-info-link-color);
    opacity: 0.78;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__link:focus-visible,
  .qtm-contact-info-{{ block_id }} .qtm-contact-info__button:focus-visible {
    outline: 3px solid var(--qtm-contact-info-link-color);
    outline-offset: 4px;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__footer {
    display: flex;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-left .qtm-contact-info__footer {
    justify-content: flex-start;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-center .qtm-contact-info__footer {
    justify-content: center;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--align-right .qtm-contact-info__footer {
    justify-content: flex-end;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0.85rem 1.2rem;
    color: var(--qtm-contact-info-button-text);
    background: var(--qtm-contact-info-button-background);
    border: 1px solid var(--qtm-contact-info-button-background);
    border-radius: calc(var(--qtm-contact-info-border-radius) * 0.45);
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-contact-info-{{ block_id }} .qtm-contact-info__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--animation-fade {
    animation: qtm-contact-info-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--animation-fade-up {
    animation: qtm-contact-info-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--animation-fade-down {
    animation: qtm-contact-info-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--animation-fade-left {
    animation: qtm-contact-info-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--animation-fade-right {
    animation: qtm-contact-info-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-info-{{ block_id }}.qtm-contact-info--animation-zoom {
    animation: qtm-contact-info-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-contact-info-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-contact-info-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-contact-info-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-contact-info-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-contact-info-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-contact-info-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-contact-info-{{ block_id }}.qtm-contact-info--hide-tablet {
      display: none !important;
    }

    .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-cards .qtm-contact-info__items {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-contact-info-{{ block_id }}.qtm-contact-info--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-contact-info-{{ block_id }} {
      padding: min(var(--qtm-contact-info-padding), 24px);
    }

    .qtm-contact-info-{{ block_id }}.qtm-contact-info--hide-mobile {
      display: none !important;
    }

    .qtm-contact-info-{{ block_id }} .qtm-contact-info__item {
      padding: 0.9rem;
    }

    .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-compact .qtm-contact-info__item,
    .qtm-contact-info-{{ block_id }}.qtm-contact-info--layout-minimal .qtm-contact-info__item {
      padding: 0;
    }

    .qtm-contact-info-{{ block_id }} .qtm-contact-info__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-contact-info-{{ block_id }},
    .qtm-contact-info-{{ block_id }} *,
    .qtm-contact-info-{{ block_id }} *::before,
    .qtm-contact-info-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Contact info",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need help?"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text",
      "default": "<p>Reach out to our team for help with orders, products, services, or general questions.</p>"
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(555) 123-4567"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@example.com"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address label",
      "default": "Address"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Commerce Street\nSuite 100\nYour City, ST 00000"
    },
    {
      "type": "url",
      "id": "address_url",
      "label": "Address link"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours",
      "default": "Monday-Friday: 9am-5pm\nSaturday-Sunday: Closed"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_icon",
      "label": "Phone icon",
      "default": "☎"
    },
    {
      "type": "text",
      "id": "email_icon",
      "label": "Email icon",
      "default": "✉"
    },
    {
      "type": "text",
      "id": "address_icon",
      "label": "Address icon",
      "default": "⌖"
    },
    {
      "type": "text",
      "id": "hours_icon",
      "label": "Hours icon",
      "default": "◷"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "list",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
