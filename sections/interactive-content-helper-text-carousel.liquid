{%- liquid
  assign items = section.blocks | where: 'type', 'item'
  assign count = 0
  for block in items
    assign label = block.settings.label | strip
    if label != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{% if count == 0 %}
  {% render 'section-empty-state', section: section %}
{% else %}
{%- comment -%}
  Quadratum — Interactive · Text Carousel
  File: sections/interactive-content-helper-text-carousel.liquid

  Native CSS ticker with a persistent checkbox pause and reduced-motion/editor fallback.
  Carousel mode opts into the existing shared engine; saved settings remain local.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings

  assign show_header = s.show_header

  assign layout = s.layout | default: 'single_line'
  assign alignment = s.alignment | default: 'center'
  assign motion_mode = s.motion_mode | default: 'marquee'

  assign slides_d = s.slides_desktop | default: 1
  assign slides_t = s.slides_tablet | default: 1
  assign slides_m = s.slides_mobile | default: 1

  assign autoplay = s.autoplay
  assign loop = s.loop
  assign pause_on_hover = s.pause_on_hover
  assign show_arrows = s.show_arrows
  assign show_dots = s.show_dots

  assign aria_label = s.aria_label | default: 'Key messages carousel'
  assign announce_changes = s.announce_changes

  assign wants_controls = false
  if autoplay or loop or show_arrows or show_dots
    assign wants_controls = true
  endif

  assign should_init = false
  if motion_mode == 'carousel' and count > 1 and wants_controls
    assign should_init = true
  endif

  if count == 1
    assign should_init = false
    assign autoplay = false
    assign loop = false
    assign show_arrows = false
    assign show_dots = false
  endif

  assign use_custom_colors = s.use_custom_colors

  assign max_width = s.max_width | default: 'full'
  assign pad_y = s.pad_y | default: 'sm'
  assign pad_x = s.pad_x | default: 'md'

  assign badge_radius = s.badge_radius | default: 999
  assign card_radius = s.card_radius | default: 16
  assign control_radius = s.control_radius | default: 999

  assign marquee_speed = s.marquee_speed | default: 14
  assign marquee_direction = s.marquee_direction | default: 'left'
-%}

{% if motion_mode == 'carousel' %}<script src="{{ 'interactive-content-carousel-media.js' | asset_url }}" defer></script>{% endif %}
<section
  class="q-section q-text-carousel q-tc-layout--{{ layout }} q-tc-align--{{ alignment }} q-tc-motion--{{ motion_mode }} q-tc-maxw--{{ max_width }}{% if pause_on_hover %} q-tc-pause-hover{% endif %}"
  data-section-id="{{ sid }}" data-design-mode="{{ request.design_mode }}"
  role="region"
  aria-label="{{ aria_label | escape }}"
  style="
    --q-tc-space-xs: var(--q-space-xs, 8px);
    --q-tc-space-sm: var(--q-space-sm, 16px);
    --q-tc-space-md: var(--q-space-md, 24px);
    --q-tc-space-lg: var(--q-space-lg, 32px);
    --q-tc-pad-y: var(--q-tc-space-{{ pad_y }});
    --q-tc-pad-x: var(--q-tc-space-{{ pad_x }});

    --q-tc-bg: {% if use_custom_colors %}{{ s.bg_color }}{% else %}transparent{% endif %};
    --q-tc-fg: {% if use_custom_colors %}{{ s.text_color }}{% else %}currentColor{% endif %};
    --q-tc-muted: {% if use_custom_colors %}{{ s.muted_text_color }}{% else %}var(--c-muted, currentColor){% endif %};
    --q-tc-accent: {% if use_custom_colors %}{{ s.accent_color }}{% else %}var(--c-accent, currentColor){% endif %};
    --q-tc-surface: {% if use_custom_colors %}{{ s.surface_color }}{% else %}var(--c-surface, rgba(0,0,0,0.04)){% endif %};
    --q-tc-border: {% if use_custom_colors %}{{ s.border_color }}{% else %}color-mix(in srgb, currentColor 15%, transparent){% endif %};

    --q-tc-label-fs: {{ s.label_size }}px;
    --q-tc-label-fw: {{ s.label_weight }};
    --q-tc-subtext-fs: {{ s.subtext_size }}px;
    --q-tc-subtext-op: {{ s.subtext_opacity }};
    --q-tc-meta-fs: {{ s.meta_size }}px;
    --q-tc-meta-op: {{ s.meta_opacity }};
    --q-tc-lettersp: {{ s.letter_spacing }}em;

    --q-tc-card-radius: {{ card_radius }}px;
    --q-tc-card-bw: {{ s.card_border_width }}px;
    --q-tc-card-shadow: {{ s.card_shadow | default: 'none' | escape }};

    --q-tc-badge-radius: {{ badge_radius }}px;
    --q-tc-badge-bw: {{ s.badge_border_width }}px;
    --q-tc-badge-pad-y: var(--q-tc-space-{{ s.badge_pad_y }});
    --q-tc-badge-pad-x: var(--q-tc-space-{{ s.badge_pad_x }});

    --q-tc-control-size: {{ s.control_size }}px;
    --q-tc-control-radius: {{ control_radius }}px;
    --q-tc-control-bw: {{ s.control_border_width }}px;
    --q-tc-dot-size: {{ s.dot_size }}px;
    --q-tc-dot-scale: {{ s.dot_active_scale }};

    --q-tc-spv-d: {{ slides_d }};
    --q-tc-spv-t: {{ slides_t }};
    --q-tc-spv-m: {{ slides_m }};
    --q-tc-marquee-speed: {{ marquee_speed }}s;
    --q-tc-marquee-dir: {% if marquee_direction == 'right' %}reverse{% else %}normal{% endif %};
  "
>
  <div class="q-text-carousel__outer">
    <div class="q-text-carousel__inner">

      {%- if show_header -%}
        <header class="q-text-carousel__header">
          {%- if s.kicker != blank -%}
            <p class="q-text-carousel__kicker">{{ s.kicker | escape }}</p>
          {%- endif -%}
          {%- if s.title != blank -%}
            <h2 class="q-text-carousel__title">{{ s.title | escape }}</h2>
          {%- endif -%}
          {%- if s.subtitle != blank -%}
            <div class="q-text-carousel__subtitle rte">{{ s.subtitle }}</div>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if motion_mode == 'marquee' -%}
        <div class="q-tc-marquee{% if count > 1 %} q-tc-marquee--moving{% endif %}" aria-live="off">
          {% if count > 1 %}
            <input type="checkbox" class="q-tc-pause-check" id="TextTickerPause-{{ sid }}" aria-controls="TextTicker-{{ sid }}">
            <label class="q-tc-pause-label" for="TextTickerPause-{{ sid }}">Pause ticker</label>
          {% endif %}
          <div class="q-tc-marquee__viewport" id="TextTicker-{{ sid }}">
            <div class="q-tc-marquee__track">
              {%- for copy in (1..2) -%}
                <div class="q-tc-marquee__group" {% if copy == 2 %}aria-hidden="true" inert{% endif %}>
                  {%- for block in items -%}
                    {%- assign b = block.settings -%}
                    {%- if b.label == blank -%}{%- continue -%}{%- endif -%}
                    <div class="q-tc-item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                      {% if layout == 'card' %}
                        <div class="q-tc-card">
                          <div class="q-tc-card__label">{{ b.label | escape }}</div>
                          {% if b.subtext != blank %}<div class="q-tc-card__subtext">{{ b.subtext | escape }}</div>{% endif %}
                          {% if b.meta != blank %}<div class="q-tc-card__meta">{{ b.meta | escape }}</div>{% endif %}
                        </div>
                      {% else %}
                        <div class="q-tc-linewrap">
                          {% if layout == 'badge_strip' %}<span class="q-tc-badge">{{ b.label | escape }}</span>{% else %}<span class="q-tc-line">{{ b.label | escape }}</span>{% endif %}
                          {% if b.subtext != blank %}<span class="q-tc-subtext">{{ b.subtext | escape }}</span>{% endif %}
                          {% if b.meta != blank %}<span class="q-tc-meta">{{ b.meta | escape }}</span>{% endif %}
                        </div>
                      {% endif %}
                    </div>
                  {%- endfor -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>

      {%- else -%}
        <div
          class="q-tc-carousel"
          {% if should_init %}
            data-q-carousel-engine="shared"
            data-loop="{{ loop }}" data-autoplay="{{ autoplay }}"
            data-autoplay-speed="{{ s.autoplay_speed }}"
            data-pause-hover="{{ pause_on_hover }}" data-pause-focus="true"
            data-show-arrows="{{ show_arrows }}" data-show-dots="{{ show_dots }}"
            data-announce="{{ announce_changes }}"
          {% endif %}
          role="region" aria-roledescription="carousel" aria-label="{{ aria_label | escape }}"
        >
          {%- if should_init and show_arrows -%}
            <div class="q-tc-controls">
              <button type="button" class="q-tc-btn" aria-label="Previous message" data-q-carousel-prev hidden>
                <span aria-hidden="true">‹</span>
              </button>
              <button type="button" class="q-tc-btn" aria-label="Next message" data-q-carousel-next hidden>
                <span aria-hidden="true">›</span>
              </button>
            </div>
          {%- endif -%}

          <div class="q-tc-track q-carousel__viewport" tabindex="0" aria-label="Messages">
            <ul class="q-tc-slides q-carousel__track" role="list">
              {%- for block in items -%}
                {%- assign b = block.settings -%}
                {%- if b.label == blank -%}{%- continue -%}{%- endif -%}
                <li class="q-tc-slide q-carousel__slide" role="listitem" {{ block.shopify_attributes }}>
                  {%- if layout == 'card' -%}
                    <div class="q-tc-card">
                      <div class="q-tc-card__label">{{ b.label | escape }}</div>
                      {%- if b.subtext != blank -%}
                        <div class="q-tc-card__subtext">{{ b.subtext | escape }}</div>
                      {%- endif -%}
                      {%- if b.meta != blank -%}
                        <div class="q-tc-card__meta">{{ b.meta | escape }}</div>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    <div class="q-tc-linewrap">
                      {% if layout == 'badge_strip' %}<span class="q-tc-badge">{{ b.label | escape }}</span>{% else %}<span class="q-tc-line">{{ b.label | escape }}</span>{% endif %}
                      {%- if b.subtext != blank -%}
                        <span class="q-tc-subtext">{{ b.subtext | escape }}</span>
                      {%- endif -%}
                      {%- if b.meta != blank -%}
                        <span class="q-tc-meta">{{ b.meta | escape }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>

          {%- if should_init and show_dots -%}
            <div class="q-tc-dots" data-q-carousel-dots aria-label="Carousel pagination" hidden></div>
          {%- endif -%}
          {% if should_init and autoplay %}<button type="button" class="q-tc-pause" data-q-carousel-pause hidden aria-pressed="false">Pause rotation</button>{% endif %}
        </div>
      {%- endif -%}

    </div>
  </div>

  <style>
    .q-text-carousel{
      background: var(--q-tc-bg, transparent);
      color: var(--q-tc-fg, currentColor);
      overflow: hidden;
    }

    .q-text-carousel__outer{ padding: var(--q-tc-pad-y) min(var(--q-tc-pad-x), 6vw); }
    .q-text-carousel__inner{ margin: 0 auto; width: 100%; }

    .q-tc-maxw--full .q-text-carousel__inner{ max-width: none; }
    .q-tc-maxw--standard .q-text-carousel__inner{ max-width: 1240px; }
    .q-tc-maxw--narrow .q-text-carousel__inner{ max-width: 980px; }

    .q-text-carousel__header{ margin-bottom: 12px; text-align: center; }
    .q-tc-align--left .q-text-carousel__header{ text-align: left; }

    .q-text-carousel__kicker{
      margin: 0 0 6px;
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
      opacity: .75;
    }
    .q-text-carousel__title{
      margin: 0;
      line-height: 1.12;
      font-size: 28px;
      letter-spacing: -0.01em;
    }
    .q-text-carousel__subtitle{
      margin-top: 6px;
      opacity: .8;
      max-width: 70ch;
      margin-left: auto;
      margin-right: auto;
    }
    .q-tc-align--left .q-text-carousel__subtitle{ margin-left: 0; margin-right: 0; }

    /* MARQUEE */
    .q-tc-motion--marquee .q-tc-marquee{
      border-top: 1px solid var(--q-tc-border, rgba(0,0,0,0.10));
      border-bottom: 1px solid var(--q-tc-border, rgba(0,0,0,0.10));
    }
    .q-tc-marquee__viewport{ width: 100%; overflow: hidden; min-width: 0; }

    .q-tc-marquee__track{
      display: flex;
      align-items: center;
      width: max-content; gap: 0;
    }

    /* ✅ FIX: no liquid inside CSS — class toggles pause on hover */
    .q-text-carousel.q-tc-pause-hover:hover .q-tc-marquee__track{
      animation-play-state: paused;
    }

    .q-tc-marquee__group{
      display: inline-flex;
      align-items: center;
      gap: 28px;
      flex: 0 0 auto; padding-inline-end: 28px;
    }
    .q-tc-item{
      display: inline-flex;
      align-items: center;
      min-width: 0;
      white-space: nowrap;
    }
    .q-tc-line{
      font-size: var(--q-tc-label-fs, 22px);
      font-weight: var(--q-tc-label-fw, 800);
      letter-spacing: var(--q-tc-lettersp, 0.1em);
      text-transform: uppercase;
      line-height: 1;
      color: var(--q-tc-fg, #fff);
    }

    .q-tc-layout--badge_strip .q-tc-badge{
      display: inline-flex;
      align-items: center;
      padding: var(--q-tc-badge-pad-y, 8px) var(--q-tc-badge-pad-x, 12px);
      border-radius: var(--q-tc-badge-radius, 999px);
      border: var(--q-tc-badge-bw, 1px) solid var(--q-tc-border, rgba(255,255,255,0.18));
      background: color-mix(in srgb, var(--q-tc-surface, rgba(255,255,255,0.08)) 100%, transparent);
      font-size: var(--q-tc-label-fs, 22px);
      font-weight: var(--q-tc-label-fw, 800);
      letter-spacing: var(--q-tc-lettersp, 0.1em);
      text-transform: uppercase;
      white-space: nowrap;
    }

    @keyframes qtc-marquee{
      0%{ transform: translateX(0); }
      100%{ transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce){
      .q-tc-marquee__track{ animation: none !important; transform: none !important; }
    }

    /* CAROUSEL (engine) */
    .q-tc-motion--carousel .q-tc-carousel{
      position: relative;
      border: 1px solid var(--q-tc-border, rgba(0,0,0,0.10));
      border-radius: 14px;
      padding: 14px;
      background: var(--q-tc-bg, transparent);
    }
    .q-tc-track{
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      min-width: 0;
      outline: none;
    }
    .q-tc-track::-webkit-scrollbar{ display:none; }

    .q-tc-slides{
      display: flex;
      gap: 14px;
      margin: 0;
      padding: 2px;
      list-style: none;
      align-items: stretch;
      min-width: 0;
    }

    .q-text-carousel{ --q-tc-spv: var(--q-tc-spv-m); }
    .q-tc-slide{ flex: 0 0 calc((100% - 14px * (var(--q-tc-spv) - 1)) / var(--q-tc-spv)); min-width: 0; scroll-snap-align: start; }
    @media (min-width: 750px){ .q-text-carousel{ --q-tc-spv: var(--q-tc-spv-t); } }
    @media (min-width: 990px){ .q-text-carousel{ --q-tc-spv: var(--q-tc-spv-d); } }

    .q-tc-card{
      border-radius: var(--q-tc-card-radius, 16px);
      border: var(--q-tc-card-bw, 1px) solid var(--q-tc-border, rgba(0,0,0,0.10));
      background: var(--q-tc-surface, rgba(0,0,0,0.04));
      box-shadow: var(--q-tc-card-shadow, 0);
      padding: 14px 16px;
      min-width: 0;
    }
    .q-tc-card__label{
      font-size: var(--q-tc-label-fs, 18px);
      font-weight: var(--q-tc-label-fw, 700);
      letter-spacing: var(--q-tc-lettersp, 0em);
      line-height: 1.2;
    }
    .q-tc-card__subtext{
      margin-top: 6px;
      font-size: var(--q-tc-subtext-fs, 14px);
      opacity: calc(var(--q-tc-subtext-op, 85) / 100);
    }
    .q-tc-card__meta{
      margin-top: 8px;
      font-size: var(--q-tc-meta-fs, 12px);
      opacity: calc(var(--q-tc-meta-op, 75) / 100);
    }

    .q-tc-controls{
      position: relative;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      padding: 0 8px;
    }
    .q-tc-btn{
      pointer-events: auto;
      width: var(--q-tc-control-size, 40px);
      height: var(--q-tc-control-size, 40px);
      border-radius: var(--q-tc-control-radius, 999px);
      border: var(--q-tc-control-bw, 1px) solid var(--q-tc-border, rgba(0,0,0,0.12));
      background: color-mix(in srgb, var(--q-tc-bg, #fff) 92%, transparent);
      color: var(--q-tc-fg, currentColor);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .q-tc-btn:focus-visible{ outline: 2px solid currentColor; outline-offset: 2px; }

    .q-tc-dots{
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 10px;
    }
    .q-tc-dots button{
      width: var(--q-tc-dot-size, 8px);
      height: var(--q-tc-dot-size, 8px);
      border-radius: 999px;
      border: 0;
      background: rgba(0,0,0,0.25);
      padding: 0;
      cursor: pointer;
    }
    .q-tc-dots button[aria-current="true"]{
      transform: scale(calc(var(--q-tc-dot-scale, 125) / 100));
      background: rgba(0,0,0,0.70);
    }

    @media (max-width: 749px){
      .q-tc-line, .q-tc-layout--badge_strip .q-tc-badge{
        font-size: clamp(16px, 4.8vw, var(--q-tc-label-fs, 22px));
      }
      .q-tc-marquee__group{ gap: 18px; padding-inline-end: 18px; }
    }
    .q-text-carousel [hidden]{ display: none !important; }
    .q-text-carousel{ overflow-wrap: anywhere; }
    .q-text-carousel :is(button, input, [tabindex]):focus-visible{ outline: 2px solid var(--q-tc-accent); outline-offset: 2px; }
    .q-text-carousel .q-tc-track{ scroll-snap-type: x mandatory; }
    .q-text-carousel .q-tc-linewrap{ display: flex; flex-wrap: wrap; gap: .5em; align-items: center; justify-content: center; }
    .q-text-carousel.q-tc-align--left .q-tc-linewrap{ justify-content: flex-start; }
    .q-text-carousel.q-tc-align--center .q-tc-card{ text-align: center; }
    .q-text-carousel :is(.q-tc-subtext,.q-tc-card__subtext){ color: var(--q-tc-muted); font-size: var(--q-tc-subtext-fs); opacity: calc(var(--q-tc-subtext-op) / 100); }
    .q-text-carousel :is(.q-tc-meta,.q-tc-card__meta){ color: var(--q-tc-muted); font-size: var(--q-tc-meta-fs); opacity: calc(var(--q-tc-meta-op) / 100); }
    .q-text-carousel .q-tc-slide .q-tc-badge{ white-space: normal; }
    .q-text-carousel .q-tc-dots button{ min-width: 24px; min-height: 24px; background: transparent; display: grid; place-items: center; }
    .q-text-carousel .q-tc-dots button::before{ content: ''; width: var(--q-tc-dot-size); height: var(--q-tc-dot-size); background: var(--q-tc-muted); border-radius: 50%; }
    .q-text-carousel .q-tc-dots button[aria-current="true"]{ background: transparent; transform: none; }
    .q-text-carousel .q-tc-dots button[aria-current="true"]::before{ background: var(--q-tc-accent); transform: scale(calc(var(--q-tc-dot-scale) / 100)); }
    .q-text-carousel .q-tc-pause{ display: block; margin: 12px auto 0; padding: 8px 14px; background: var(--q-tc-surface); color: inherit; border: 1px solid var(--q-tc-border); border-radius: var(--q-tc-control-radius); }
    .q-text-carousel .q-tc-pause-check{ margin: 8px 4px 8px 0; accent-color: var(--q-tc-accent); }
    .q-text-carousel .q-tc-pause-label{ cursor: pointer; }
    .q-text-carousel .q-tc-marquee--moving .q-tc-marquee__track{ animation: qtc-marquee var(--q-tc-marquee-speed) linear infinite; animation-direction: var(--q-tc-marquee-dir); }
    .q-text-carousel .q-tc-pause-check:checked ~ .q-tc-marquee__viewport .q-tc-marquee__track,
    .q-text-carousel .q-tc-marquee:focus-within .q-tc-marquee__track{ animation-play-state: paused; }
    .q-text-carousel .q-tc-marquee:not(.q-tc-marquee--moving) .q-tc-marquee__track,
    .q-text-carousel[data-design-mode="true"] .q-tc-marquee__track{ animation: none; width: 100%; transform: none; }
    .q-text-carousel .q-tc-marquee:not(.q-tc-marquee--moving) .q-tc-marquee__group,
    .q-text-carousel[data-design-mode="true"] .q-tc-marquee__group{ flex-wrap: wrap; max-width: 100%; min-width: 0; padding: 0; }
    .q-text-carousel .q-tc-marquee:not(.q-tc-marquee--moving) .q-tc-item,
    .q-text-carousel[data-design-mode="true"] .q-tc-item,
    .q-text-carousel[data-design-mode="true"] .q-tc-badge,
    .q-text-carousel .q-tc-marquee:not(.q-tc-marquee--moving) .q-tc-badge{ white-space: normal; max-width: 100%; }
    .q-text-carousel .q-tc-marquee:not(.q-tc-marquee--moving) [aria-hidden="true"],
    .q-text-carousel[data-design-mode="true"] .q-tc-marquee [aria-hidden="true"],
    .q-text-carousel[data-design-mode="true"] :is(.q-tc-pause-check,.q-tc-pause-label){ display: none; }
    .q-text-carousel:dir(rtl) .q-tc-marquee__track{ direction: ltr; }
    .q-text-carousel:dir(rtl) .q-tc-item{ direction: rtl; }
    .q-text-carousel:dir(rtl) .q-tc-btn span{ display: inline-block; transform: scaleX(-1); }
    @media (prefers-reduced-motion: reduce){
      .q-text-carousel .q-tc-marquee__track{ width: 100%; }
      .q-text-carousel .q-tc-marquee__group{ flex-wrap: wrap; max-width: 100%; min-width: 0; padding: 0; }
      .q-text-carousel .q-tc-item, .q-text-carousel .q-tc-badge{ white-space: normal; max-width: 100%; }
      .q-text-carousel .q-tc-marquee [aria-hidden="true"], .q-text-carousel :is(.q-tc-pause-check,.q-tc-pause-label){ display: none; }
    }
  </style>
</section>


