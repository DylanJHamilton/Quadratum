{%- liquid
  assign block_id = 'product-related-products-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign product_source = block.settings.product_source | default: 'same_collection'
  assign selected_collection = block.settings.collection
  assign related_layout = block.settings.related_layout | default: 'grid'
  assign product_limit = block.settings.product_limit | default: 4

  assign fallback_collection = selected_collection

  if fallback_collection == blank and product_context != blank and product_context.collections.size > 0
    assign fallback_collection = product_context.collections.first
  endif

  if fallback_collection == blank
    assign fallback_collection = collections.all
  endif

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign rendered_products = 0
-%}

<div
  id="{{ block_id }}"
  class="
    product-related-products
    product-related-products--{{ related_layout }}
    product-related-products--width-{{ width }}
    product-related-products--align-{{ alignment }}
    {% unless show_on_desktop %} product-related-products--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-related-products--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-related-products--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-related-products--animate product-related-products--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-related-margin-top: {{ block.settings.margin_top }}px;
    --product-related-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-related-padding: {{ block.settings.padding }}px;
    --product-related-gap: {{ block.settings.grid_gap }}px;
    --product-related-card-padding: {{ block.settings.card_padding }}px;
    --product-related-radius: {{ block.settings.card_radius }}px;
    --product-related-border-width: {{ block.settings.border_width }}px;
    --product-related-columns-desktop: {{ block.settings.columns_desktop }};
    --product-related-columns-tablet: {{ block.settings.columns_tablet }};
    --product-related-columns-mobile: {{ block.settings.columns_mobile }};
    --product-related-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --product-related-heading-color: {{ block.settings.heading_color }};
    --product-related-text-color: {{ block.settings.text_color }};
    --product-related-muted-color: {{ block.settings.muted_color }};
    --product-related-price-color: {{ block.settings.price_color }};
    --product-related-sale-color: {{ block.settings.sale_color }};
    --product-related-background: {{ block.settings.background_color }};
    --product-related-card-background: {{ block.settings.card_background_color }};
    --product-related-border-color: {{ block.settings.border_color }};
    --product-related-button-background: {{ block.settings.button_background_color }};
    --product-related-button-text: {{ block.settings.button_text_color }};
    --product-related-arrow-background: {{ block.settings.arrow_background_color }};
    --product-related-arrow-text: {{ block.settings.arrow_text_color }};
    --product-related-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-related-products
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-related-margin-top);
      margin-bottom: var(--product-related-margin-bottom);
      padding: var(--product-related-padding);
      color: var(--product-related-text-color);
      background: var(--product-related-background);
    }

    #{{ block_id }}.product-related-products--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-related-products--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.product-related-products--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.product-related-products--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.product-related-products--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-related-products--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-related-products--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-related-products--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-related-products__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .product-related-products__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.product-related-products--align-center .product-related-products__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .product-related-products__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .product-related-products__eyebrow {
      margin: 0;
      color: var(--product-related-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-related-products__heading {
      margin: 0;
      color: var(--product-related-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .product-related-products__description {
      margin: 0;
      color: var(--product-related-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-related-products__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .product-related-products__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--product-related-arrow-text);
      background: var(--product-related-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-related-products__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-related-products__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .product-related-products__arrow:focus-visible {
      outline: 2px solid var(--product-related-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-related-products__items {
      display: grid;
      grid-template-columns: repeat(var(--product-related-columns-desktop), minmax(0, 1fr));
      gap: var(--product-related-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-related-products--carousel .product-related-products__items {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    #{{ block_id }}.product-related-products--carousel .product-related-products__items::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }}.product-related-products--carousel .product-related-products__item {
      flex: 0 0 calc((100% - (var(--product-related-gap) * (var(--product-related-columns-desktop) - 1))) / var(--product-related-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }} .product-related-products__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--product-related-text-color);
      text-decoration: none;
    }

    #{{ block_id }}.product-related-products--grid .product-related-products__card,
    #{{ block_id }}.product-related-products--carousel .product-related-products__card {
      padding: var(--product-related-card-padding);
      background: var(--product-related-card-background);
      border: var(--product-related-border-width) solid var(--product-related-border-color);
      border-radius: var(--product-related-radius);
      overflow: hidden;
    }

    #{{ block_id }}.product-related-products--minimal .product-related-products__card {
      grid-template-columns: {{ block.settings.minimal_image_size }}px minmax(0, 1fr);
      align-items: center;
      padding: {{ block.settings.minimal_card_padding }}px;
      background: var(--product-related-card-background);
      border: var(--product-related-border-width) solid var(--product-related-border-color);
      border-radius: var(--product-related-radius);
    }

    #{{ block_id }} .product-related-products__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--product-related-radius) - 8px), 8px);
      aspect-ratio: var(--product-related-image-ratio);
    }

    #{{ block_id }}.product-related-products--minimal .product-related-products__media {
      width: {{ block.settings.minimal_image_size }}px;
      height: {{ block.settings.minimal_image_size }}px;
      aspect-ratio: auto;
    }

    #{{ block_id }} .product-related-products__media img,
    #{{ block_id }} .product-related-products__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 300ms ease;
    }

    #{{ block_id }} .product-related-products__card:hover .product-related-products__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .product-related-products__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .product-related-products__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--product-related-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .product-related-products__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.product-related-products--align-center .product-related-products__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }}.product-related-products--align-right .product-related-products__content {
      justify-items: end;
      text-align: right;
    }

    #{{ block_id }}.product-related-products--minimal .product-related-products__content {
      justify-items: start;
      text-align: left;
    }

    #{{ block_id }} .product-related-products__vendor {
      color: var(--product-related-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-related-products__title {
      margin: 0;
      color: var(--product-related-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-related-products__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-related-products__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .product-related-products__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--product-related-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.product-related-products--align-center .product-related-products__price-row {
      justify-content: center;
    }

    #{{ block_id }}.product-related-products--align-right .product-related-products__price-row {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-related-products--minimal .product-related-products__price-row {
      justify-content: flex-start;
    }

    #{{ block_id }} .product-related-products__price {
      color: var(--product-related-price-color);
      font-weight: 800;
    }

    #{{ block_id }} .product-related-products__compare {
      color: var(--product-related-muted-color);
      text-decoration: line-through;
      opacity: 0.72;
    }

    #{{ block_id }} .product-related-products__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 40px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--product-related-button-text);
      background: var(--product-related-button-background);
      border: 1px solid var(--product-related-button-background);
      border-radius: max(calc(var(--product-related-radius) - 10px), 6px);
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 700;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-related-products__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-related-products__media:focus-visible,
    #{{ block_id }} .product-related-products__title a:focus-visible,
    #{{ block_id }} .product-related-products__button:focus-visible {
      outline: 2px solid var(--product-related-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-related-products__empty {
      padding: 18px;
      color: var(--product-related-text-color);
      background: var(--product-related-card-background);
      border: var(--product-related-border-width) solid var(--product-related-border-color);
      border-radius: var(--product-related-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-related-products--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-related-products--animate-fade {
      animation-name: productRelatedProductsFade;
    }

    #{{ block_id }}.product-related-products--animate-fade_up {
      animation-name: productRelatedProductsFadeUp;
    }

    #{{ block_id }}.product-related-products--animate-zoom {
      animation-name: productRelatedProductsZoom;
    }

    @keyframes productRelatedProductsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productRelatedProductsFadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productRelatedProductsZoom {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-related-products--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-related-products--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .product-related-products__items {
        grid-template-columns: repeat(var(--product-related-columns-tablet), minmax(0, 1fr));
      }

      #{{ block_id }}.product-related-products--carousel .product-related-products__item {
        flex-basis: calc((100% - (var(--product-related-gap) * (var(--product-related-columns-tablet) - 1))) / var(--product-related-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-related-products--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-related-products__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .product-related-products__items {
        grid-template-columns: repeat(var(--product-related-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }}.product-related-products--carousel .product-related-products__item {
        flex-basis: calc((100% - (var(--product-related-gap) * (var(--product-related-columns-mobile) - 1))) / var(--product-related-columns-mobile));
      }

      #{{ block_id }} .product-related-products__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-related-products__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }

      #{{ block_id }}.product-related-products--minimal .product-related-products__card {
        grid-template-columns: {{ block.settings.minimal_image_size_mobile }}px minmax(0, 1fr);
      }

      #{{ block_id }}.product-related-products--minimal .product-related-products__media {
        width: {{ block.settings.minimal_image_size_mobile }}px;
        height: {{ block.settings.minimal_image_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-related-products--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }}.product-related-products--carousel .product-related-products__items {
        scroll-behavior: auto;
      }

      #{{ block_id }} .product-related-products__media img,
      #{{ block_id }} .product-related-products__button,
      #{{ block_id }} .product-related-products__arrow {
        transition: none;
      }

      #{{ block_id }} .product-related-products__card:hover .product-related-products__media img,
      #{{ block_id }} .product-related-products__button:hover,
      #{{ block_id }} .product-related-products__arrow:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-related-products__inner">
    {% if block.settings.show_header %}
      <div class="product-related-products__header-row">
        <div class="product-related-products__header">
          {% if block.settings.eyebrow != blank %}
            <p class="product-related-products__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="product-related-products__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="product-related-products__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>

        {% if related_layout == 'carousel' and block.settings.show_arrows %}
          <div class="product-related-products__controls">
            <button
              type="button"
              class="product-related-products__arrow"
              data-product-related-products-prev
              aria-label="{{ block.settings.previous_label | escape }}"
            >
              ‹
            </button>

            <button
              type="button"
              class="product-related-products__arrow"
              data-product-related-products-next
              aria-label="{{ block.settings.next_label | escape }}"
            >
              ›
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="product-related-products__items"
      data-product-related-products-items
      aria-label="{{ block.settings.related_products_label | escape }}"
      {% if related_layout == 'carousel' %}tabindex="0"{% endif %}
    >
      {% if product_source == 'manual' %}
        {% for related_product in block.settings.products limit: product_limit %}
          {% if related_product != blank %}
            {% unless product_context != blank and related_product.id == product_context.id %}
              {%- liquid
                assign rendered_products = rendered_products | plus: 1
                assign related_variant = related_product.selected_or_first_available_variant
                assign is_on_sale = false
                assign image_alt = related_product.title

                if related_product.featured_image.alt != blank
                  assign image_alt = related_product.featured_image.alt
                endif

                if related_variant.compare_at_price > related_variant.price
                  assign is_on_sale = true
                endif
              -%}

              <article class="product-related-products__item" data-product-related-products-item>
                <div class="product-related-products__card">
                  <a class="product-related-products__media" href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">
                    {% if related_product.featured_image %}
                      {% if forloop.first %}
                        {{ related_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% else %}
                        {{ related_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% endif %}
                    {% else %}
                      <span class="product-related-products__placeholder" aria-hidden="true"></span>
                    {% endif %}

                    {% if block.settings.show_sale_badge and is_on_sale %}
                      <span class="product-related-products__badge">
                        {{ block.settings.sale_badge_text | escape }}
                      </span>
                    {% endif %}
                  </a>

                  <div class="product-related-products__content">
                    {% if block.settings.show_vendor and related_product.vendor != blank %}
                      <div class="product-related-products__vendor">
                        {{ related_product.vendor | escape }}
                      </div>
                    {% endif %}

                    <h3 class="product-related-products__title">
                      <a href="{{ related_product.url }}">
                        {{ related_product.title | escape }}
                      </a>
                    </h3>

                    {% if block.settings.show_price %}
                      <div class="product-related-products__price-row">
                        <span class="product-related-products__price">
                          {{ related_variant.price | money }}
                        </span>

                        {% if is_on_sale %}
                          <span class="product-related-products__compare">
                            {{ related_variant.compare_at_price | money }}
                          </span>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if block.settings.show_button %}
                      <a class="product-related-products__button" href="{{ related_product.url }}">
                        {{ block.settings.button_label | escape }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% elsif fallback_collection != blank %}
        {% for related_product in fallback_collection.products %}
          {% if rendered_products < product_limit %}
            {% unless product_context != blank and related_product.id == product_context.id %}
              {%- liquid
                assign should_render = false

                if product_source == 'same_collection'
                  assign should_render = true
                endif

                if product_source == 'vendor'
                  if product_context != blank and related_product.vendor == product_context.vendor
                    assign should_render = true
                  endif
                endif

                if product_source == 'product_type'
                  if product_context != blank and related_product.type == product_context.type
                    assign should_render = true
                  endif
                endif
              -%}

              {% if should_render %}
                {%- liquid
                  assign rendered_products = rendered_products | plus: 1
                  assign related_variant = related_product.selected_or_first_available_variant
                  assign is_on_sale = false
                  assign image_alt = related_product.title

                  if related_product.featured_image.alt != blank
                    assign image_alt = related_product.featured_image.alt
                  endif

                  if related_variant.compare_at_price > related_variant.price
                    assign is_on_sale = true
                  endif
                -%}

                <article class="product-related-products__item" data-product-related-products-item>
                  <div class="product-related-products__card">
                    <a class="product-related-products__media" href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">
                      {% if related_product.featured_image %}
                        {% if rendered_products == 1 %}
                          {{ related_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                        {% else %}
                          {{ related_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                        {% endif %}
                      {% else %}
                        <span class="product-related-products__placeholder" aria-hidden="true"></span>
                      {% endif %}

                      {% if block.settings.show_sale_badge and is_on_sale %}
                        <span class="product-related-products__badge">
                          {{ block.settings.sale_badge_text | escape }}
                        </span>
                      {% endif %}
                    </a>

                    <div class="product-related-products__content">
                      {% if block.settings.show_vendor and related_product.vendor != blank %}
                        <div class="product-related-products__vendor">
                          {{ related_product.vendor | escape }}
                        </div>
                      {% endif %}

                      <h3 class="product-related-products__title">
                        <a href="{{ related_product.url }}">
                          {{ related_product.title | escape }}
                        </a>
                      </h3>

                      {% if block.settings.show_price %}
                        <div class="product-related-products__price-row">
                          <span class="product-related-products__price">
                            {{ related_variant.price | money }}
                          </span>

                          {% if is_on_sale %}
                            <span class="product-related-products__compare">
                              {{ related_variant.compare_at_price | money }}
                            </span>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% if block.settings.show_button %}
                        <a class="product-related-products__button" href="{{ related_product.url }}">
                          {{ block.settings.button_label | escape }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_products == 0 and block.settings.show_empty_state %}
      <div class="product-related-products__empty">
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>

  {% if related_layout == 'carousel' %}
    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productRelatedProductsReady === 'true') return;

        root.dataset.productRelatedProductsReady = 'true';

        const items = root.querySelector('[data-product-related-products-items]');
        const previousButton = root.querySelector('[data-product-related-products-prev]');
        const nextButton = root.querySelector('[data-product-related-products-next]');

        if (!items) return;

        const updateControls = () => {
          const maxScroll = items.scrollWidth - items.clientWidth - 2;

          if (previousButton) {
            previousButton.disabled = items.scrollLeft <= 2;
          }

          if (nextButton) {
            nextButton.disabled = items.scrollLeft >= maxScroll;
          }
        };

        const scrollCarousel = (direction) => {
          const firstItem = items.querySelector('[data-product-related-products-item]');
          const amount = firstItem ? firstItem.getBoundingClientRect().width + 20 : items.clientWidth * 0.8;

          items.scrollBy({
            left: amount * direction,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
          });
        };

        if (previousButton) {
          previousButton.addEventListener('click', () => scrollCarousel(-1));
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => scrollCarousel(1));
        }

        items.addEventListener('scroll', () => {
          window.requestAnimationFrame(updateControls);
        }, { passive: true });

        items.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            scrollCarousel(-1);
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            scrollCarousel(1);
          }
        });

        window.addEventListener('resize', updateControls, { passive: true });
        updateControls();
      })();
    </script>
  {% endif %}
</div>

