{%- liquid
  assign block_id = 'product-tabs-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign layout_style = block.settings.layout_style | default: 'underline'
  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign metafield_1_content = blank
  assign metafield_2_content = blank
  assign metafield_3_content = blank

  if product_context != blank
    if block.settings.metafield_1_namespace != blank and block.settings.metafield_1_key != blank
      assign metafield_1_content = product_context.metafields[block.settings.metafield_1_namespace][block.settings.metafield_1_key]
    endif

    if block.settings.metafield_2_namespace != blank and block.settings.metafield_2_key != blank
      assign metafield_2_content = product_context.metafields[block.settings.metafield_2_namespace][block.settings.metafield_2_key]
    endif

    if block.settings.metafield_3_namespace != blank and block.settings.metafield_3_key != blank
      assign metafield_3_content = product_context.metafields[block.settings.metafield_3_namespace][block.settings.metafield_3_key]
    endif
  endif

  assign tab_index = 0
  assign panel_index = 0
-%}

<div
  id="{{ block_id }}"
  class="
    product-tabs
    product-tabs--{{ layout_style }}
    product-tabs--width-{{ width }}
    product-tabs--align-{{ alignment }}
    {% unless show_on_desktop %} product-tabs--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-tabs--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-tabs--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-tabs--animate product-tabs--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-tabs-margin-top: {{ block.settings.margin_top }}px;
    --product-tabs-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-tabs-padding: {{ block.settings.padding }}px;
    --product-tabs-card-padding: {{ block.settings.card_padding }}px;
    --product-tabs-tab-padding-x: {{ block.settings.tab_padding_x }}px;
    --product-tabs-tab-padding-y: {{ block.settings.tab_padding_y }}px;
    --product-tabs-panel-padding: {{ block.settings.panel_padding }}px;
    --product-tabs-gap: {{ block.settings.tab_gap }}px;
    --product-tabs-radius: {{ block.settings.card_radius }}px;
    --product-tabs-tab-radius: {{ block.settings.tab_radius }}px;
    --product-tabs-border-width: {{ block.settings.border_width }}px;
    --product-tabs-heading-color: {{ block.settings.heading_color }};
    --product-tabs-text-color: {{ block.settings.text_color }};
    --product-tabs-muted-color: {{ block.settings.muted_color }};
    --product-tabs-background: {{ block.settings.background_color }};
    --product-tabs-card-background: {{ block.settings.card_background_color }};
    --product-tabs-tab-background: {{ block.settings.tab_background_color }};
    --product-tabs-active-tab-background: {{ block.settings.active_tab_background_color }};
    --product-tabs-border-color: {{ block.settings.border_color }};
    --product-tabs-active-color: {{ block.settings.active_color }};
    --product-tabs-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-tabs
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-tabs-margin-top);
      margin-bottom: var(--product-tabs-margin-bottom);
      padding: var(--product-tabs-padding);
      color: var(--product-tabs-text-color);
      background: var(--product-tabs-background);
    }

    #{{ block_id }}.product-tabs--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-tabs--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-tabs--width-medium {
      max-width: 940px;
    }

    #{{ block_id }}.product-tabs--width-large {
      max-width: 1180px;
    }

    #{{ block_id }}.product-tabs--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-tabs--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-tabs--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-tabs--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: left;
    }

    #{{ block_id }} .product-tabs__inner {
      display: grid;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.product-tabs--boxed .product-tabs__inner,
    #{{ block_id }}.product-tabs--vertical .product-tabs__inner {
      padding: var(--product-tabs-card-padding);
      background: var(--product-tabs-card-background);
      border: var(--product-tabs-border-width) solid var(--product-tabs-border-color);
      border-radius: var(--product-tabs-radius);
    }

    #{{ block_id }} .product-tabs__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .product-tabs__eyebrow {
      margin: 0;
      color: var(--product-tabs-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-tabs__heading {
      margin: 0;
      color: var(--product-tabs-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.12;
    }

    #{{ block_id }} .product-tabs__description {
      margin: 0;
      color: var(--product-tabs-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-tabs__interface {
      display: grid;
      gap: 0;
      min-width: 0;
    }

    #{{ block_id }}.product-tabs--vertical .product-tabs__interface {
      grid-template-columns: minmax(180px, {{ block.settings.vertical_nav_width }}px) minmax(0, 1fr);
      gap: {{ block.settings.vertical_gap }}px;
      align-items: start;
    }

    #{{ block_id }} .product-tabs__nav {
      display: flex;
      gap: var(--product-tabs-gap);
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      border-bottom: var(--product-tabs-border-width) solid var(--product-tabs-border-color);
    }

    #{{ block_id }} .product-tabs__nav::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }}.product-tabs--pills .product-tabs__nav,
    #{{ block_id }}.product-tabs--boxed .product-tabs__nav {
      border-bottom: 0;
    }

    #{{ block_id }}.product-tabs--vertical .product-tabs__nav {
      display: grid;
      overflow: visible;
      border-bottom: 0;
      gap: var(--product-tabs-gap);
    }

    #{{ block_id }} .product-tabs__tab {
      appearance: none;
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: {{ block.settings.tab_min_height }}px;
      padding: var(--product-tabs-tab-padding-y) var(--product-tabs-tab-padding-x);
      color: var(--product-tabs-muted-color);
      background: transparent;
      border: 0;
      border-radius: 0;
      cursor: pointer;
      text-align: center;
      white-space: nowrap;
      font: inherit;
      font-size: {{ block.settings.tab_text_size }}px;
      font-weight: 800;
      line-height: 1.2;
      transition: color 180ms ease, background 180ms ease;
    }

    #{{ block_id }}.product-tabs--underline .product-tabs__tab::after {
      content: "";
      position: absolute;
      left: var(--product-tabs-tab-padding-x);
      right: var(--product-tabs-tab-padding-x);
      bottom: calc(var(--product-tabs-border-width) * -1);
      height: 2px;
      background: var(--product-tabs-active-color);
      opacity: 0;
      transform: scaleX(0.8);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }}.product-tabs--underline .product-tabs__tab[aria-selected="true"]::after {
      opacity: 1;
      transform: scaleX(1);
    }

    #{{ block_id }}.product-tabs--pills .product-tabs__tab,
    #{{ block_id }}.product-tabs--boxed .product-tabs__tab,
    #{{ block_id }}.product-tabs--vertical .product-tabs__tab {
      background: var(--product-tabs-tab-background);
      border: var(--product-tabs-border-width) solid var(--product-tabs-border-color);
      border-radius: var(--product-tabs-tab-radius);
    }

    #{{ block_id }}.product-tabs--boxed .product-tabs__tab {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    #{{ block_id }}.product-tabs--vertical .product-tabs__tab {
      justify-content: flex-start;
      text-align: left;
      white-space: normal;
    }

    #{{ block_id }} .product-tabs__tab[aria-selected="true"] {
      color: var(--product-tabs-active-color);
      background: var(--product-tabs-active-tab-background);
    }

    #{{ block_id }} .product-tabs__tab:focus-visible {
      outline: 2px solid var(--product-tabs-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-tabs__panels {
      min-width: 0;
      color: var(--product-tabs-text-color);
      background: var(--product-tabs-card-background);
    }

    #{{ block_id }}.product-tabs--underline .product-tabs__panels,
    #{{ block_id }}.product-tabs--pills .product-tabs__panels {
      padding-top: var(--product-tabs-panel-padding);
    }

    #{{ block_id }}.product-tabs--boxed .product-tabs__panels {
      padding: var(--product-tabs-panel-padding);
      border: var(--product-tabs-border-width) solid var(--product-tabs-border-color);
      border-radius: 0 0 var(--product-tabs-radius) var(--product-tabs-radius);
    }

    #{{ block_id }}.product-tabs--vertical .product-tabs__panels {
      padding: var(--product-tabs-panel-padding);
      border: var(--product-tabs-border-width) solid var(--product-tabs-border-color);
      border-radius: var(--product-tabs-radius);
    }

    #{{ block_id }} .product-tabs__panel {
      display: none;
      color: var(--product-tabs-text-color);
      font-size: {{ block.settings.content_size }}px;
      line-height: 1.65;
    }

    #{{ block_id }} .product-tabs__panel[data-active="true"] {
      display: block;
    }

    #{{ block_id }} .product-tabs__panel p:first-child {
      margin-top: 0;
    }

    #{{ block_id }} .product-tabs__panel p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-tabs__panel ul,
    #{{ block_id }} .product-tabs__panel ol {
      padding-left: 1.25em;
    }

    #{{ block_id }} .product-tabs__empty {
      padding: 18px;
      color: var(--product-tabs-text-color);
      background: var(--product-tabs-card-background);
      border: var(--product-tabs-border-width) solid var(--product-tabs-border-color);
      border-radius: var(--product-tabs-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-tabs--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-tabs--animate-fade {
      animation-name: productTabsFade;
    }

    #{{ block_id }}.product-tabs--animate-fade_up {
      animation-name: productTabsFadeUp;
    }

    #{{ block_id }}.product-tabs--animate-zoom {
      animation-name: productTabsZoom;
    }

    @keyframes productTabsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productTabsFadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTabsZoom {
      from {
        opacity: 0;
        transform: scale(0.98);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-tabs--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-tabs--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-tabs--vertical .product-tabs__interface {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-tabs--vertical .product-tabs__nav {
        display: flex;
        overflow-x: auto;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-tabs--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-tabs__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }}.product-tabs--vertical .product-tabs__interface {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-tabs--vertical .product-tabs__nav {
        display: flex;
        overflow-x: auto;
      }

      #{{ block_id }} .product-tabs__tab {
        min-height: {{ block.settings.tab_min_height_mobile }}px;
        font-size: {{ block.settings.tab_text_size_mobile }}px;
      }

      #{{ block_id }}.product-tabs--boxed .product-tabs__tab {
        border-radius: var(--product-tabs-tab-radius);
      }

      #{{ block_id }}.product-tabs--boxed .product-tabs__panels {
        border-radius: var(--product-tabs-radius);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-tabs--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-tabs__tab,
      #{{ block_id }} .product-tabs__tab::after {
        transition: none;
      }
    }
  </style>

  {%- capture tab_buttons -%}
    {% if block.settings.show_description_tab and product_context.description != blank %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-description"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-description"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.description_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_specs_tab %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-specs"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-specs"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.specs_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_shipping_tab %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-shipping"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-shipping"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.shipping_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_returns_tab %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-returns"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-returns"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.returns_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_care_tab %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-care"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-care"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.care_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_custom_tab %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-custom"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-custom"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.custom_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_metafield_1 and metafield_1_content != blank %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-metafield-1"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-metafield-1"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.metafield_1_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_metafield_2 and metafield_2_content != blank %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-metafield-2"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-metafield-2"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.metafield_2_title | escape }}
      </button>
    {% endif %}

    {% if block.settings.show_metafield_3 and metafield_3_content != blank %}
      {% assign tab_index = tab_index | plus: 1 %}
      <button
        type="button"
        class="product-tabs__tab"
        id="{{ block_id }}-tab-metafield-3"
        role="tab"
        aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ block_id }}-panel-metafield-3"
        tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
        data-product-tab
      >
        {{ block.settings.metafield_3_title | escape }}
      </button>
    {% endif %}
  {%- endcapture -%}

  {%- capture tab_panels -%}
    {% if block.settings.show_description_tab and product_context.description != blank %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-description"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-description"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ product_context.description }}
      </div>
    {% endif %}

    {% if block.settings.show_specs_tab %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-specs"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-specs"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ block.settings.specs_text }}
      </div>
    {% endif %}

    {% if block.settings.show_shipping_tab %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-shipping"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-shipping"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ block.settings.shipping_text }}
      </div>
    {% endif %}

    {% if block.settings.show_returns_tab %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-returns"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-returns"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ block.settings.returns_text }}
      </div>
    {% endif %}

    {% if block.settings.show_care_tab %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-care"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-care"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ block.settings.care_text }}
      </div>
    {% endif %}

    {% if block.settings.show_custom_tab %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-custom"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-custom"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ block.settings.custom_text }}
      </div>
    {% endif %}

    {% if block.settings.show_metafield_1 and metafield_1_content != blank %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-metafield-1"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-metafield-1"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ metafield_1_content | metafield_tag }}
      </div>
    {% endif %}

    {% if block.settings.show_metafield_2 and metafield_2_content != blank %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-metafield-2"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-metafield-2"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ metafield_2_content | metafield_tag }}
      </div>
    {% endif %}

    {% if block.settings.show_metafield_3 and metafield_3_content != blank %}
      {% assign panel_index = panel_index | plus: 1 %}
      <div
        class="product-tabs__panel"
        id="{{ block_id }}-panel-metafield-3"
        role="tabpanel"
        aria-labelledby="{{ block_id }}-tab-metafield-3"
        data-active="{% if panel_index == 1 %}true{% else %}false{% endif %}"
        data-product-tab-panel
      >
        {{ metafield_3_content | metafield_tag }}
      </div>
    {% endif %}
  {%- endcapture -%}

  {% if tab_buttons != blank and tab_panels != blank %}
    <div class="product-tabs__inner">
      {% if block.settings.show_header %}
        <div class="product-tabs__header">
          {% if block.settings.eyebrow != blank %}
            <p class="product-tabs__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="product-tabs__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="product-tabs__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      <div class="product-tabs__interface">
        <div
          class="product-tabs__nav"
          role="tablist"
          aria-label="{{ block.settings.tabs_label | escape }}"
          data-product-tabs-nav
        >
          {{ tab_buttons }}
        </div>

        <div class="product-tabs__panels" data-product-tabs-panels>
          {{ tab_panels }}
        </div>
      </div>
    </div>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productTabsReady === 'true') return;

        root.dataset.productTabsReady = 'true';

        const tabs = Array.from(root.querySelectorAll('[data-product-tab]'));
        const panels = Array.from(root.querySelectorAll('[data-product-tab-panel]'));

        const activateTab = (tab, shouldFocus = false) => {
          const panelId = tab.getAttribute('aria-controls');

          tabs.forEach((item) => {
            item.setAttribute('aria-selected', item === tab ? 'true' : 'false');
            item.setAttribute('tabindex', item === tab ? '0' : '-1');
          });

          panels.forEach((panel) => {
            panel.dataset.active = panel.id === panelId ? 'true' : 'false';
          });

          if (shouldFocus) {
            tab.focus();
          }
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activateTab(tab));

          tab.addEventListener('keydown', (event) => {
            const isVertical = root.classList.contains('product-tabs--vertical');
            let nextIndex = index;

            if (event.key === 'ArrowRight' || (!isVertical && event.key === 'ArrowDown')) {
              nextIndex = index + 1;
            }

            if (event.key === 'ArrowLeft' || (!isVertical && event.key === 'ArrowUp')) {
              nextIndex = index - 1;
            }

            if (isVertical && event.key === 'ArrowDown') {
              nextIndex = index + 1;
            }

            if (isVertical && event.key === 'ArrowUp') {
              nextIndex = index - 1;
            }

            if (event.key === 'Home') {
              nextIndex = 0;
            }

            if (event.key === 'End') {
              nextIndex = tabs.length - 1;
            }

            if (nextIndex !== index) {
              event.preventDefault();

              if (nextIndex < 0) {
                nextIndex = tabs.length - 1;
              }

              if (nextIndex >= tabs.length) {
                nextIndex = 0;
              }

              activateTab(tabs[nextIndex], true);
            }
          });
        });
      })();
    </script>
  {% elsif block.settings.show_empty_state %}
    <div class="product-tabs__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

