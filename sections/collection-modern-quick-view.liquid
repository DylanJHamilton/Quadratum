{%- comment -%}
  Quadratum — Collection Modern Quick View
  File: sections/collection-modern-quick-view.liquid

  Rendered via:
  /products/:handle?section_id=collection-modern-quick-view

  IMPORTANT:
  - This section is NOT placed on a template.
  - Styling + behavior are controlled by the Collection section that injects it.
  - JS sets: [data-qcm-qv-fragment][data-qcm-qv-mode="slider|hover"]
{%- endcomment -%}

{%- liquid
  assign p = product
  assign minimum_quantity = p.variants | map: 'quantity_rule' | map: 'min' | compact | sort | last | default: 1
  assign purchase_details_required = p.requires_selling_plan
  if minimum_quantity > 1
    assign purchase_details_required = true
  endif

  assign v = p.selected_or_first_available_variant
  if v.available == false and p.available
    for candidate in p.variants
      if candidate.available
        assign v = candidate
        break
      endif
    endfor
  endif

  assign featured = p.featured_media.preview_image
  if featured == blank
    assign featured = p.featured_image
  endif

  assign max_imgs = 8
-%}

{%- if p != blank and p.url != blank -%}
<div class="qcmQv" data-qcm-qv-fragment data-qcm-qv-mode="slider">
  <div class="qcmQv__grid">
    <div class="qcmQv__media">
      {%- comment -%} SLIDER MODE (default) {%- endcomment -%}
      <div class="qcmQv__slider" data-qcm-qv-slider data-qcmc-index="0">
        <div class="qcmQv__track" data-qcm-qv-track>
          {%- assign count = 0 -%}
          {%- if p.media != blank -%}
            {%- for m in p.media -%}
              {%- if m.media_type == 'image' -%}
                {%- assign count = count | plus: 1 -%}
                <img
                  class="qcmQv__img qcmQv__img--slide"
                  src="{{ m | image_url: width: 1200 }}"
                  alt="{{ m.alt | default: p.title | escape }}"
                  loading="eager" width="{{ m.width | default: 900 }}" height="{{ m.height | default: 900 }}"
                >
                {%- if count >= max_imgs -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if count == 0 -%}
            {%- if featured != blank -%}
              <img class="qcmQv__img qcmQv__img--slide" src="{{ featured | image_url: width: 1200 }}" alt="{{ featured.alt | default: p.title | escape }}" loading="eager" width="{{ featured.width | default: 900 }}" height="{{ featured.height | default: 900 }}">
            {%- else -%}
              <div class="qcmQv__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if count > 1 -%}<button class="qcmQv__arrow qcmQv__arrow--prev" type="button" data-qcm-qv-prev aria-label="Previous image">‹</button>
        <button class="qcmQv__arrow qcmQv__arrow--next" type="button" data-qcm-qv-next aria-label="Next image">›</button>{%- endif -%}
      </div>

      {%- comment -%} HOVER MODE (first + second image) {%- endcomment -%}
      {%- assign second_image = blank -%}
      {%- if p.media != blank and p.media.size > 1 -%}
        {%- assign m2 = p.media[1] -%}
        {%- if m2.media_type == 'image' -%}
          {%- assign second_image = m2 -%}
        {%- endif -%}
      {%- endif -%}

      <a class="qcmQv__hoverLink" href="{{ p.url | escape }}" aria-label="{{ p.title | escape }}">
        {%- if featured != blank -%}
          <img class="qcmQv__img qcmQv__img--primary" src="{{ featured | image_url: width: 1200 }}" alt="{{ featured.alt | default: p.title | escape }}" loading="eager" width="{{ featured.width | default: 900 }}" height="{{ featured.height | default: 900 }}">
        {%- else -%}
          <div class="qcmQv__placeholder" aria-hidden="true"></div>
        {%- endif -%}

        {%- if second_image != blank -%}
          <img class="qcmQv__img qcmQv__img--second" src="{{ second_image | image_url: width: 1200 }}" alt="{{ second_image.alt | default: p.title | escape }}" loading="eager" width="{{ second_image.width | default: 900 }}" height="{{ second_image.height | default: 900 }}">
        {%- endif -%}
      </a>
    </div>

    <div class="qcmQv__info">
      <h3 class="qcmQv__title"><a href="{{ p.url | escape }}">{{ p.title | escape }}</a></h3>

      {%- if v != blank -%}
        <div class="qcmQv__price">
          <span class="qcmQv__priceNow">{{ v.price | money }}</span>
          <span class="qcmQv__priceWas" {% unless v.compare_at_price > v.price %}hidden{% endunless %}><s>{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}</s></span>
        </div>
      {%- endif -%}

      {%- if p.description != blank -%}
        <div class="qcmQv__desc">
          {{ p.description | strip_html | truncate: 260 | escape }}
        </div>
      {%- endif -%}

      <div class="qcmQv__actions">
        {%- if v != blank and purchase_details_required != true -%}
          <form class="qcmQv__form" method="post" action="{{ routes.cart_add_url }}" {% if settings.cart_mode == 'ajax_drawer' %}data-cart-drawer-add{% endif %}>
            {%- if p.variants.size > 1 -%}
              <label class="qcmQv__label">Options
                <select class="qcmQv__select" name="id" data-qcm-qv-variant>
                  {%- for vr in p.variants -%}<option value="{{ vr.id }}" data-price="{{ vr.price | money | escape }}" data-compare="{% if vr.compare_at_price > vr.price %}{{ vr.compare_at_price | money | escape }}{% endif %}" {% if vr.id == v.id %}selected{% endif %} {% unless vr.available %}disabled{% endunless %}>{{ vr.title | escape }}</option>{%- endfor -%}
                </select>
              </label>
            {%- else -%}<input type="hidden" name="id" value="{{ v.id }}">{%- endif -%}
            <button class="qcmQv__btn qcmQv__btn--atc" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}Add to cart{% else %}Sold out{% endif %}</button>
          </form>
          {%- if p.variants.size == 1 and v.available -%}<a class="qcmQv__btn qcmQv__btn--buy" href="{{ routes.cart_url }}/{{ v.id }}:1?checkout">Buy now</a>{%- endif -%}
        {%- endif -%}
        <a class="qcmQv__btn qcmQv__btn--view" href="{{ p.url | escape }}">{% if purchase_details_required %}Choose options{% else %}View product{% endif %}</a>
      </div>

      <div class="qcmQv__status" aria-live="polite" data-qcm-qv-status></div>
    </div>
  </div>
</div>

  <template data-global-qv-product>{% render 'q-quick-view-product', product: p %}</template>
{%- endif -%}
{% schema %}
{ "name": "Collection Quick View", "settings": [], "presets": [{ "name": "Collection Modern Quick View" }] }
{% endschema %}