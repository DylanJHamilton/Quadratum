{
  "sections": {
    "main": {
      "type": "product-block-section",
      "blocks": {
        "product_layout_row_1": {
          "type": "product-layout-row",
          "settings": {
            "is_primary_product_row": true,
            "columns": "2",
            "vertical_alignment": "top",
            "mobile_behavior": "stack",
            "column_gap": 48,
            "row_gap": 32
          },
          "blocks": {
            "product_layout_row_1_product_layout_column_1": {
              "type": "product-layout-column",
              "settings": {
                "column_type": "media",
                "horizontal_alignment": "stretch",
                "sticky_column": true
              },
              "blocks": {
                "product_layout_row_1_product_layout_column_1_product_gallery_1": {
                  "type": "product-gallery",
                  "settings": {
                    "gallery_mode": "horizontal_thumbs",
                    "image_fit": "cover",
                    "main_media_ratio": 140,
                    "show_arrows": true,
                    "show_dots": false,
                    "show_thumbnails": true,
                    "thumbnail_position": "left",
                    "thumbnail_size": 72,
                    "thumbnail_radius": 4,
                    "media_gap": 12,
                    "media_radius": 6,
                    "media_border_width": 0,
                    "media_background": "#E5D8BE",
                    "media_border_color": "#E5D8BE",
                    "thumbnail_border_color": "#E5D8BE",
                    "thumbnail_active_color": "#182E2A",
                    "arrow_background": "#182E2A",
                    "arrow_text_color": "#F6F1E7",
                    "dot_color": "#E5D8BE"
                  }
                }
              },
              "block_order": [
                "product_layout_row_1_product_layout_column_1_product_gallery_1"
              ]
            },
            "product_layout_row_1_product_layout_column_2": {
              "type": "product-layout-column",
              "settings": {
                "column_type": "content",
                "horizontal_alignment": "stretch"
              },
              "blocks": {
                "product_layout_row_1_product_layout_column_2_product_vendor_1": {
                  "type": "product-vendor",
                  "settings": {
                    "subtitle_source": "custom",
                    "custom_text": "<p>Bookseller pick</p>",
                    "subtitle_style": "badge",
                    "font_size_desktop": 13,
                    "font_size_mobile": 12,
                    "text_color": "#793D43",
                    "background_color": "#F6F1E7",
                    "border_color": "#793D43",
                    "border_width": 1,
                    "border_radius": 4,
                    "margin_bottom": 16
                  }
                },
                "product_layout_row_1_product_layout_column_2_product_title_2": {
                  "type": "product-title",
                  "settings": {
                    "heading_tag": "h1",
                    "title_size_desktop": 48,
                    "title_size_mobile": 34,
                    "line_height": 105,
                    "letter_spacing": -1,
                    "margin_bottom": 12
                  }
                },
                "product_layout_row_1_product_layout_column_2_product_subtitle_3": {
                  "type": "product-subtitle",
                  "settings": {
                    "subtitle_source": "metafield",
                    "metafield_namespace": "folio",
                    "metafield_key": "creator",
                    "render_as_paragraph": true,
                    "subtitle_style": "minimal",
                    "font_size_desktop": 20,
                    "font_size_mobile": 17,
                    "text_color": "#62665E",
                    "margin_bottom": 20
