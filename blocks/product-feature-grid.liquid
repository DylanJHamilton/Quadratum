{%- liquid
  assign block_id = 'product-features-grid-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'grid'
  assign desktop_columns = block.settings.desktop_columns | default: '3'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign feature_count = block.settings.feature_count | default: 4

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-features-grid
    product-features-grid--{{ layout_style }}
    product-features-grid--width-{{ block_width }}
    product-features-grid--align-{{ alignment }}
    product-features-grid--desktop-{{ desktop_columns }}
    product-features-grid--mobile-{{ mobile_columns }}
    {% unless show_on_desktop %} product-features-grid--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-features-grid--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-features-grid--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-features-grid--animate product-features-grid--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-features-grid-margin-top: {{ block.settings.margin_top }}px;
    --product-features-grid-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-features-grid-padding: {{ block.settings.padding }}px;
    --product-features-grid-gap: {{ block.settings.gap }}px;
    --product-features-grid-card-padding: {{ block.settings.card_padding }}px;
    --product-features-grid-border-width: {{ block.settings.border_width }}px;
    --product-features-grid-border-radius: {{ block.settings.border_radius }}px;
    --product-features-grid-heading-color: {{ block.settings.heading_color }};
    --product-features-grid-text-color: {{ block.settings.text_color }};
    --product-features-grid-background-color: {{ block.settings.background_color }};
    --product-features-grid-card-background-color: {{ block.settings.card_background_color }};
    --product-features-grid-border-color: {{ block.settings.border_color }};
    --product-features-grid-link-color: {{ block.settings.link_color }};
    --product-features-grid-icon-color: {{ block.settings.icon_color }};
    --product-features-grid-icon-background: {{ block.settings.icon_background_color }};
    --product-features-grid-icon-size: {{ block.settings.icon_size }}px;
    --product-features-grid-image-radius: {{ block.settings.image_radius }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-features-grid-margin-top);
      margin-bottom: var(--product-features-grid-margin-bottom);
      padding: var(--product-features-grid-padding);
      color: var(--product-features-grid-text-color);
      background: var(--product-features-grid-background-color);
    }

    #{{ block_id }}.product-features-grid--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-features-grid--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-features-grid--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-features-grid--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-features-grid--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-features-grid--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-features-grid--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-features-grid--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-features-grid__inner {
      display: grid;
      gap: var(--product-features-grid-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .product-features-grid__header {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-features-grid__heading {
      margin: 0;
      color: var(--product-features-grid-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-features-grid__text {
      color: var(--product-features-grid-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-features-grid__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-features-grid__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-features-grid__items {
      width: 100%;
      min-width: 0;
      gap: var(--product-features-grid-gap);
    }

    #{{ block_id }}.product-features-grid--grid .product-features-grid__items,
    #{{ block_id }}.product-features-grid--cards .product-features-grid__items,
    #{{ block_id }}.product-features-grid--minimal .product-features-grid__items,
    #{{ block_id }}.product-features-grid--bordered .product-features-grid__items {
      display: grid;
    }

    #{{ block_id }}.product-features-grid--desktop-1 .product-features-grid__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.product-features-grid--desktop-2 .product-features-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.product-features-grid--desktop-3 .product-features-grid__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.product-features-grid--desktop-4 .product-features-grid__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .product-features-grid__item {
      min-width: 0;
      display: grid;
      gap: 14px;
      color: var(--product-features-grid-text-color);
      background: transparent;
      border: 0 solid transparent;
      border-radius: var(--product-features-grid-border-radius);
      padding: 0;
    }

    #{{ block_id }}.product-features-grid--grid .product-features-grid__item,
    #{{ block_id }}.product-features-grid--cards .product-features-grid__item,
    #{{ block_id }}.product-features-grid--bordered .product-features-grid__item {
      padding: var(--product-features-grid-card-padding);
      background: var(--product-features-grid-card-background-color);
      border: var(--product-features-grid-border-width) solid var(--product-features-grid-border-color);
    }

    #{{ block_id }}.product-features-grid--cards .product-features-grid__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.product-features-grid--minimal .product-features-grid__item {
      border-bottom: var(--product-features-grid-border-width) solid var(--product-features-grid-border-color);
      border-radius: 0;
      padding-bottom: var(--product-features-grid-card-padding);
    }

    #{{ block_id }}.product-features-grid--minimal .product-features-grid__item:last-child {
      border-bottom: 0;
    }

    #{{ block_id }}.product-features-grid--align-center .product-features-grid__item {
      justify-items: center;
    }

    #{{ block_id }}.product-features-grid--align-right .product-features-grid__item {
      justify-items: end;
    }

    #{{ block_id }} .product-features-grid__visual {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--product-features-grid-icon-size);
      height: var(--product-features-grid-icon-size);
      color: var(--product-features-grid-icon-color);
      background: var(--product-features-grid-icon-background);
      border-radius: 999px;
      overflow: hidden;
      line-height: 1;
    }

    #{{ block_id }} .product-features-grid__icon {
      font-size: calc(var(--product-features-grid-icon-size) * 0.45);
      line-height: 1;
    }

    #{{ block_id }} .product-features-grid__image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: var(--product-features-grid-image-radius);
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .product-features-grid__content {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-features-grid__item-heading {
      margin: 0;
      color: var(--product-features-grid-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .product-features-grid__item-text {
      color: var(--product-features-grid-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-features-grid__item-text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-features-grid__item-text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-features-grid__link {
      display: inline-flex;
      width: fit-content;
      color: var(--product-features-grid-link-color);
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
      line-height: 1.2;
      transition: opacity 180ms ease;
    }

    #{{ block_id }} .product-features-grid__link:hover {
      opacity: 0.72;
    }

    #{{ block_id }} .product-features-grid__link:focus-visible {
      outline: 2px solid var(--product-features-grid-link-color);
      outline-offset: 3px;
      border-radius: 4px;
    }

    #{{ block_id }}.product-features-grid--align-center .product-features-grid__link {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-features-grid--align-right .product-features-grid__link {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.product-features-grid--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-features-grid--animate-fade {
      animation-name: productFeaturesGridFade;
    }

    #{{ block_id }}.product-features-grid--animate-fade_up {
      animation-name: productFeaturesGridFadeUp;
    }

    #{{ block_id }}.product-features-grid--animate-fade_down {
      animation-name: productFeaturesGridFadeDown;
    }

    #{{ block_id }}.product-features-grid--animate-fade_left {
      animation-name: productFeaturesGridFadeLeft;
    }

    #{{ block_id }}.product-features-grid--animate-fade_right {
      animation-name: productFeaturesGridFadeRight;
    }

    #{{ block_id }}.product-features-grid--animate-zoom {
      animation-name: productFeaturesGridZoom;
    }

    @keyframes productFeaturesGridFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productFeaturesGridFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFeaturesGridFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFeaturesGridFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productFeaturesGridFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productFeaturesGridZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-features-grid--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-features-grid--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-features-grid--desktop-3 .product-features-grid__items,
      #{{ block_id }}.product-features-grid--desktop-4 .product-features-grid__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-features-grid--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-features-grid--mobile-1 .product-features-grid__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-features-grid--mobile-2 .product-features-grid__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }} .product-features-grid__item {
        padding: min(var(--product-features-grid-card-padding), 22px);
      }

      #{{ block_id }}.product-features-grid--minimal .product-features-grid__item {
        padding-left: 0;
        padding-right: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-features-grid--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-features-grid__link {
        transition: none;
      }
    }
  </style>

  <div class="product-features-grid__inner">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="product-features-grid__header">
        {% if block.settings.heading != blank %}
          <h3 class="product-features-grid__heading">
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="product-features-grid__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-features-grid__items">
      {%- for index in (1..8) -%}
        {%- if index <= feature_count -%}
          {%- liquid
            assign icon_key = 'feature_' | append: index | append: '_icon'
            assign image_key = 'feature_' | append: index | append: '_image'
            assign image_alt_key = 'feature_' | append: index | append: '_image_alt'
            assign heading_key = 'feature_' | append: index | append: '_heading'
            assign text_key = 'feature_' | append: index | append: '_text'
            assign link_label_key = 'feature_' | append: index | append: '_link_label'
            assign link_url_key = 'feature_' | append: index | append: '_link_url'

            assign feature_icon = block.settings[icon_key]
            assign feature_image = block.settings[image_key]
            assign feature_image_alt = block.settings[image_alt_key]
            assign feature_heading = block.settings[heading_key]
            assign feature_text = block.settings[text_key]
            assign feature_link_label = block.settings[link_label_key]
            assign feature_link_url = block.settings[link_url_key]
          -%}

          {% if feature_heading != blank or feature_text != blank or feature_icon != blank or feature_image != blank %}
            <article class="product-features-grid__item">
              {% if feature_image != blank %}
                {{
                  feature_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'product-features-grid__image',
                    loading: 'lazy',
                    alt: feature_image_alt
                }}
              {% elsif feature_icon != blank %}
                <div class="product-features-grid__visual" aria-hidden="true">
                  <span class="product-features-grid__icon">
                    {{ feature_icon }}
                  </span>
                </div>
              {% endif %}

              <div class="product-features-grid__content">
                {% if feature_heading != blank %}
                  <h4 class="product-features-grid__item-heading">
                    {{ feature_heading | escape }}
                  </h4>
                {% endif %}

                {% if feature_text != blank %}
                  <div class="product-features-grid__item-text">
                    {{ feature_text }}
                  </div>
                {% endif %}

                {% if feature_link_label != blank and feature_link_url != blank %}
                  <a class="product-features-grid__link" href="{{ feature_link_url }}">
                    {{ feature_link_label | escape }}
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product features grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shoppers choose this product"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Highlight the product benefits, features, and confidence-building details that help shoppers make a purchase decision.</p>"
    },
    {
      "type": "range",
      "id": "feature_count",
      "label": "Number of features",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "text",
      "id": "feature_1_icon",
      "label": "Icon",
      "default": "✓"
    },
    {
      "type": "image_picker",
      "id": "feature_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "feature_1_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "feature_1_heading",
      "label": "Heading",
      "default": "Built for everyday use"
    },
    {
      "type": "richtext",
      "id": "feature_1_text",
      "label": "Text",
      "default": "<p>Explain the practical benefit that makes this product useful, reliable, or easy to choose.</p>"
    },
    {
      "type": "text",
      "id": "feature_1_link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "feature_1_link_url",
      "label": "Link URL"
    },

    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_2_icon",
      "label": "Icon",
      "default": "★"
    },
    {
      "type": "image_picker",
      "id": "feature_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "feature_2_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "feature_2_heading",
      "label": "Heading",
      "default": "Premium quality"
    },
    {
      "type": "richtext",
      "id": "feature_2_text",
      "label": "Text",
      "default": "<p>Show the materials, construction, ingredients, or care that supports a better product experience.</p>"
    },
    {
      "type": "text",
      "id": "feature_2_link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "feature_2_link_url",
      "label": "Link URL"
    },

    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature_3_icon",
      "label": "Icon",
      "default": "↗"
    },
    {
      "type": "image_picker",
      "id": "feature_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "feature_3_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "feature_3_heading",
      "label": "Heading",
      "default": "Designed for confidence"
    },
    {
      "type": "richtext",
      "id": "feature_3_text",
      "label": "Text",
      "default": "<p>Reduce purchase hesitation by explaining why this product is a safe, smart, or proven choice.</p>"
    },
    {
      "type": "text",
      "id": "feature_3_link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "feature_3_link_url",
      "label": "Link URL"
    },

    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "text",
      "id": "feature_4_icon",
      "label": "Icon",
      "default": "↺"
    },
    {
      "type": "image_picker",
      "id": "feature_4_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "feature_4_image_alt",
      "label": "Image alt text"
