      "blocks": {
        "or_1": {
          "type": "item",
          "settings": {
            "label": "Are the dimensions measured?",
            "content": "<p>No. Every dimension is a proposed design detail for a fictional concept. Measured sizes would be confirmed with a maker before any real sale.</p>",
            "icon": ""
          }
        },
        "or_2": {
          "type": "item",
          "settings": {
            "label": "Will my laptop or phone fit?",
            "content": "<p>We do not make device-fit claims. Compare the proposed interior dimensions with your device, and treat any fit as unconfirmed.</p>",
            "icon": ""
          }
        },
        "or_3": {
          "type": "item",
          "settings": {
            "label": "Can I see a design in another color?",
            "content": "<p>Each design is photographed in its primary color only. Secondary colors are proposed specifications without photographs, and are labeled that way.</p>",
            "icon": ""
          }
        },
        "or_4": {
          "type": "item",
          "settings": {
            "label": "How do I choose between two families?",
            "content": "<p>Forma is architectural and framed, Solis relaxed and warm, Nocturne compact and deep, Atelier detail-led, Voyage built for travel. Start with the one that matches your day.</p>",
