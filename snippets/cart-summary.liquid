{%- liquid
  assign context = context | default: 'page'
  assign compact = compact | default: false
  assign show_continue = settings.cart_drawer_show_continue_shopping | default: true, allow_false: true
  if context == 'page'
    assign show_continue = section.settings.show_continue_shopping | default: true, allow_false: true
  endif
  assign checkout_style = 'solid'
  if context == 'page'
    assign checkout_style = section.settings.checkout_button_style | default: 'solid'
  endif
-%}

<div class="qtm-cart-summary qtm-cart-summary--{{ context }} {% if compact %}qtm-cart-summary--compact{% endif %}" data-cart-summary aria-live="polite">
  <h2 class="qtm-cart-summary__title">Summary</h2>

  <div class="qtm-cart-summary__rows">
    <div class="qtm-cart-summary__row">
      <span class="qtm-cart-summary__label">Subtotal</span>
      <span class="qtm-cart-summary__value" data-cart-subtotal>
        {{ cart.items_subtotal_price | money }}
      </span>
    </div>

    {%- if cart.cart_level_discount_applications.size > 0 -%}
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="qtm-cart-summary__row qtm-cart-summary__row--discount">
          <span class="qtm-cart-summary__label">{{ discount.title | escape }}</span>
          <span class="qtm-cart-summary__value">
            -{{ discount.total_allocated_amount | money }}
          </span>
        </div>
      {%- endfor -%}
    {%- endif -%}
    <div class="qtm-cart-summary__row"><span class="qtm-cart-summary__label">Total</span><span class="qtm-cart-summary__value">{{ cart.total_price | money }}</span></div>
  </div>

  {%- unless compact -%}
    <div class="qtm-cart-summary__notice qtm-cart-summary__notice--shipping">
      {{ section.settings.shipping_notice | default: 'Shipping calculated at checkout.' | escape }}
    </div>

    <div class="qtm-cart-summary__notice qtm-cart-summary__notice--tax">
      {% if cart.taxes_included %}Taxes included.{% else %}Taxes calculated at checkout.{% endif %}
    </div>
  {%- endunless -%}

  {% if settings.checkout_note != blank %}<p class="qtm-cart-summary__notice">{{ settings.checkout_note | escape }}</p>{% endif %}
  <div class="qtm-cart-summary__actions">
    {% if context == 'page' %}
      <button type="submit" name="checkout" form="CartForm-{{ section_id }}" class="qtm-cart-summary__checkout-button qtm-cart-summary__checkout-button--{{ checkout_style }}">Checkout</button>
    {% else %}
      <form action="{{ routes.cart_url | escape }}" method="post"><button type="submit" name="checkout" class="qtm-cart-summary__checkout-button qtm-cart-summary__checkout-button--{{ checkout_style }}">Checkout</button></form>
    {% endif %}

    {%- if continue_shopping_url != blank and show_continue -%}
      <a href="{{ continue_shopping_url | escape }}" class="qtm-cart-summary__continue-link">
        Continue shopping
      </a>
    {%- endif -%}
  </div>
</div>