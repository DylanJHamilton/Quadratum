    { "type": "range", "id": "meta_size", "label": "Meta size (px)", "min": 10, "max": 22, "step": 1, "default": 12 },
    { "type": "range", "id": "meta_opacity", "label": "Meta opacity (%)", "min": 40, "max": 100, "step": 1, "default": 75 },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing (em)", "min": -0.2, "max": 0.2, "step": 0.1, "default": 0.1 },

    { "type": "header", "content": "Card / badge styling" },
    { "type": "range", "id": "card_radius", "label": "Card radius (px)", "min": 0, "max": 28, "step": 1, "default": 16 },
