{%- liquid
  assign block_id = 'product-trust-badges-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'center'
  assign layout_style = block.settings.layout_style | default: 'grid'
  assign desktop_columns = block.settings.desktop_columns | default: '4'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign badge_count = block.settings.badge_count | default: 4

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-trust-badges
    product-trust-badges--{{ layout_style }}
    product-trust-badges--width-{{ block_width }}
    product-trust-badges--align-{{ alignment }}
    product-trust-badges--desktop-{{ desktop_columns }}
    product-trust-badges--mobile-{{ mobile_columns }}
    {% unless show_on_desktop %} product-trust-badges--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-trust-badges--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-trust-badges--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-trust-badges--animate product-trust-badges--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-trust-badges-margin-top: {{ block.settings.margin_top }}px;
    --product-trust-badges-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-trust-badges-padding: {{ block.settings.padding }}px;
    --product-trust-badges-gap: {{ block.settings.gap }}px;
    --product-trust-badges-card-padding: {{ block.settings.card_padding }}px;
    --product-trust-badges-border-width: {{ block.settings.border_width }}px;
    --product-trust-badges-border-radius: {{ block.settings.border_radius }}px;
    --product-trust-badges-heading-color: {{ block.settings.heading_color }};
    --product-trust-badges-text-color: {{ block.settings.text_color }};
    --product-trust-badges-background-color: {{ block.settings.background_color }};
    --product-trust-badges-card-background-color: {{ block.settings.card_background_color }};
    --product-trust-badges-border-color: {{ block.settings.border_color }};
    --product-trust-badges-link-color: {{ block.settings.link_color }};
    --product-trust-badges-icon-color: {{ block.settings.icon_color }};
    --product-trust-badges-icon-background: {{ block.settings.icon_background_color }};
    --product-trust-badges-icon-size: {{ block.settings.icon_size }}px;
    --product-trust-badges-image-size: {{ block.settings.image_size }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-trust-badges-margin-top);
      margin-bottom: var(--product-trust-badges-margin-bottom);
      padding: var(--product-trust-badges-padding);
      color: var(--product-trust-badges-text-color);
      background: var(--product-trust-badges-background-color);
    }

    #{{ block_id }}.product-trust-badges--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-trust-badges--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-trust-badges--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-trust-badges--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-trust-badges--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-trust-badges--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-trust-badges--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-trust-badges--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-trust-badges__items {
      width: 100%;
      min-width: 0;
      gap: var(--product-trust-badges-gap);
    }

    #{{ block_id }}.product-trust-badges--grid .product-trust-badges__items,
    #{{ block_id }}.product-trust-badges--cards .product-trust-badges__items,
    #{{ block_id }}.product-trust-badges--minimal .product-trust-badges__items {
      display: grid;
    }

    #{{ block_id }}.product-trust-badges--inline .product-trust-badges__items {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: flex-start;
    }

    #{{ block_id }}.product-trust-badges--align-center.product-trust-badges--inline .product-trust-badges__items {
      justify-content: center;
    }

    #{{ block_id }}.product-trust-badges--align-right.product-trust-badges--inline .product-trust-badges__items {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-trust-badges--desktop-1 .product-trust-badges__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.product-trust-badges--desktop-2 .product-trust-badges__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.product-trust-badges--desktop-3 .product-trust-badges__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.product-trust-badges--desktop-4 .product-trust-badges__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .product-trust-badges__item {
      min-width: 0;
      display: flex;
      gap: 14px;
      color: var(--product-trust-badges-text-color);
      background: transparent;
      border: 0 solid transparent;
      border-radius: var(--product-trust-badges-border-radius);
      padding: 0;
    }

    #{{ block_id }}.product-trust-badges--grid .product-trust-badges__item,
    #{{ block_id }}.product-trust-badges--cards .product-trust-badges__item {
      background: var(--product-trust-badges-card-background-color);
      border: var(--product-trust-badges-border-width) solid var(--product-trust-badges-border-color);
      padding: var(--product-trust-badges-card-padding);
    }

    #{{ block_id }}.product-trust-badges--cards .product-trust-badges__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.product-trust-badges--minimal .product-trust-badges__item {
      border-bottom: var(--product-trust-badges-border-width) solid var(--product-trust-badges-border-color);
      border-radius: 0;
      padding-bottom: var(--product-trust-badges-card-padding);
    }

    #{{ block_id }}.product-trust-badges--minimal .product-trust-badges__item:last-child {
      border-bottom: 0;
    }

    #{{ block_id }}.product-trust-badges--inline .product-trust-badges__item {
      flex: 0 1 auto;
      align-items: center;
      background: var(--product-trust-badges-card-background-color);
      border: var(--product-trust-badges-border-width) solid var(--product-trust-badges-border-color);
      padding: 12px 16px;
    }

    #{{ block_id }}.product-trust-badges--align-center .product-trust-badges__item {
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }

    #{{ block_id }}.product-trust-badges--align-left .product-trust-badges__item {
      align-items: flex-start;
      justify-content: flex-start;
    }

    #{{ block_id }}.product-trust-badges--align-right .product-trust-badges__item {
      align-items: flex-end;
      justify-content: flex-start;
    }

    #{{ block_id }}.product-trust-badges--inline.product-trust-badges--align-left .product-trust-badges__item,
    #{{ block_id }}.product-trust-badges--inline.product-trust-badges--align-center .product-trust-badges__item,
    #{{ block_id }}.product-trust-badges--inline.product-trust-badges--align-right .product-trust-badges__item {
      flex-direction: row;
    }

    #{{ block_id }} .product-trust-badges__visual {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--product-trust-badges-icon-size);
      height: var(--product-trust-badges-icon-size);
      flex: 0 0 var(--product-trust-badges-icon-size);
      color: var(--product-trust-badges-icon-color);
      background: var(--product-trust-badges-icon-background);
      border-radius: 999px;
      overflow: hidden;
      line-height: 1;
    }

    #{{ block_id }} .product-trust-badges__icon {
      font-size: calc(var(--product-trust-badges-icon-size) * 0.45);
      line-height: 1;
    }

    #{{ block_id }} .product-trust-badges__image {
      display: block;
      width: var(--product-trust-badges-image-size);
      height: var(--product-trust-badges-image-size);
      object-fit: contain;
    }

    #{{ block_id }} .product-trust-badges__content {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    #{{ block_id }} .product-trust-badges__heading {
      margin: 0;
      color: var(--product-trust-badges-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .product-trust-badges__text {
      color: var(--product-trust-badges-text-color);
      line-height: 1.55;
      opacity: 0.9;
    }

    #{{ block_id }} .product-trust-badges__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-trust-badges__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }}.product-trust-badges--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-trust-badges--animate-fade {
      animation-name: productTrustBadgesFade;
    }

    #{{ block_id }}.product-trust-badges--animate-fade_up {
      animation-name: productTrustBadgesFadeUp;
    }

    #{{ block_id }}.product-trust-badges--animate-fade_down {
      animation-name: productTrustBadgesFadeDown;
    }

    #{{ block_id }}.product-trust-badges--animate-fade_left {
      animation-name: productTrustBadgesFadeLeft;
    }

    #{{ block_id }}.product-trust-badges--animate-fade_right {
      animation-name: productTrustBadgesFadeRight;
    }

    #{{ block_id }}.product-trust-badges--animate-zoom {
      animation-name: productTrustBadgesZoom;
    }

    @keyframes productTrustBadgesFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productTrustBadgesFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTrustBadgesFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productTrustBadgesFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productTrustBadgesFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productTrustBadgesZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-trust-badges--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-trust-badges--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-trust-badges--desktop-3 .product-trust-badges__items,
      #{{ block_id }}.product-trust-badges--desktop-4 .product-trust-badges__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-trust-badges--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-trust-badges--mobile-1 .product-trust-badges__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-trust-badges--mobile-2 .product-trust-badges__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.product-trust-badges--inline .product-trust-badges__items {
        display: grid;
      }

      #{{ block_id }} .product-trust-badges__item {
        padding: min(var(--product-trust-badges-card-padding), 22px);
      }

      #{{ block_id }}.product-trust-badges--inline .product-trust-badges__item {
        padding: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-trust-badges--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-trust-badges__items">
    {%- for index in (1..8) -%}
      {%- if index <= badge_count -%}
        {%- liquid
          assign icon_key = 'badge_' | append: index | append: '_icon'
          assign image_key = 'badge_' | append: index | append: '_image'
          assign image_alt_key = 'badge_' | append: index | append: '_image_alt'
          assign heading_key = 'badge_' | append: index | append: '_heading'
          assign text_key = 'badge_' | append: index | append: '_text'

          assign badge_icon = block.settings[icon_key]
          assign badge_image = block.settings[image_key]
          assign badge_image_alt = block.settings[image_alt_key]
          assign badge_heading = block.settings[heading_key]
          assign badge_text = block.settings[text_key]
        -%}

        {% if badge_heading != blank or badge_text != blank or badge_icon != blank or badge_image != blank %}
          <article class="product-trust-badges__item">
            {% if badge_image != blank or badge_icon != blank %}
              <div class="product-trust-badges__visual" aria-hidden="{% if badge_image != blank %}false{% else %}true{% endif %}">
                {% if badge_image != blank %}
                  {{
                    badge_image
                    | image_url: width: 240
                    | image_tag:
                      class: 'product-trust-badges__image',
                      loading: 'lazy',
                      alt: badge_image_alt
                  }}
                {% elsif badge_icon != blank %}
                  <span class="product-trust-badges__icon">
                    {{ badge_icon }}
                  </span>
                {% endif %}
              </div>
            {% endif %}

            <div class="product-trust-badges__content">
              {% if badge_heading != blank %}
                <h3 class="product-trust-badges__heading">
                  {{ badge_heading | escape }}
                </h3>
              {% endif %}

              {% if badge_text != blank %}
                <div class="product-trust-badges__text">
                  {{ badge_text }}
                </div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Product trust badges",
  "settings": [
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "range",
      "id": "badge_count",
      "label": "Number of badges",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "grid",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44
    },

    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "text",
      "id": "badge_1_icon",
      "label": "Icon",
      "default": "🔒"
    },
    {
      "type": "image_picker",
      "id": "badge_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_1_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "badge_1_heading",
      "label": "Heading",
      "default": "Secure checkout"
    },
    {
      "type": "richtext",
      "id": "badge_1_text",
      "label": "Text",
      "default": "<p>Protected checkout built to help customers buy with confidence.</p>"
    },

    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "text",
      "id": "badge_2_icon",
      "label": "Icon",
      "default": "↗"
    },
    {
      "type": "image_picker",
      "id": "badge_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_2_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "badge_2_heading",
      "label": "Heading",
      "default": "Fast shipping"
    },
    {
      "type": "richtext",
      "id": "badge_2_text",
      "label": "Text",
      "default": "<p>Clear fulfillment and delivery messaging for stronger purchase confidence.</p>"
    },

    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "text",
      "id": "badge_3_icon",
      "label": "Icon",
      "default": "↺"
    },
    {
      "type": "image_picker",
      "id": "badge_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_3_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "badge_3_heading",
      "label": "Heading",
      "default": "Easy returns"
    },
    {
      "type": "richtext",
      "id": "badge_3_text",
      "label": "Text",
      "default": "<p>Reduce hesitation with simple return and support messaging.</p>"
    },

    {
      "type": "header",
      "content": "Badge 4"
    },
    {
      "type": "text",
      "id": "badge_4_icon",
      "label": "Icon",
      "default": "✓"
    },
    {
      "type": "image_picker",
      "id": "badge_4_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_4_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "badge_4_heading",
      "label": "Heading",
      "default": "Satisfaction guarantee"
    },
    {
      "type": "richtext",
      "id": "badge_4_text",
      "label": "Text",
      "default": "<p>Support the buying decision with a clear guarantee or quality promise.</p>"
    },

    {
      "type": "header",
      "content": "Badge 5"
    },
    {
      "type": "text",
      "id": "badge_5_icon",
      "label": "Icon"
    },
    {
      "type": "image_picker",
      "id": "badge_5_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_5_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "badge_5_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "badge_5_text",
      "label": "Text"
    },

    {
      "type": "header",
      "content": "Badge 6"
    },
    {
      "type": "text",
      "id": "badge_6_icon",
      "label": "Icon"
    },
    {
      "type": "image_picker",
      "id": "badge_6_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_6_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "badge_6_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "badge_6_text",
      "label": "Text"
    },

    {
      "type": "header",
      "content": "Badge 7"
    },
    {
      "type": "text",
      "id": "badge_7_icon",
      "label": "Icon"
