{%- liquid
  assign block_id = 'qtm-content-feature-cards-' | append: block.id

  assign alignment = block.settings.alignment | default: 'left'
  assign width = block.settings.width | default: 'auto'
  assign desktop_columns = block.settings.desktop_columns | default: '3'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign layout_style = block.settings.layout_style | default: 'cards'
  assign card_count = block.settings.card_count | default: 3

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-feature-cards
    content-feature-cards--{{ layout_style }}
    content-feature-cards--align-{{ alignment }}
    content-feature-cards--width-{{ width }}
    content-feature-cards--desktop-{{ desktop_columns }}
    content-feature-cards--mobile-{{ mobile_columns }}
    {% unless show_desktop %} content-feature-cards--hide-desktop{% endunless %}
    {% unless show_tablet %} content-feature-cards--hide-tablet{% endunless %}
    {% unless show_mobile %} content-feature-cards--hide-mobile{% endunless %}
    {% if block.settings.animation != 'none' %} content-feature-cards--animate content-feature-cards--animate-{{ block.settings.animation }}{% endif %}
  "
  style="
    --content-feature-cards-margin-top: {{ block.settings.margin_top }}px;
    --content-feature-cards-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-feature-cards-padding-top: {{ block.settings.padding_top }}px;
    --content-feature-cards-padding-bottom: {{ block.settings.padding_bottom }}px;
    --content-feature-cards-padding-left: {{ block.settings.padding_left }}px;
    --content-feature-cards-padding-right: {{ block.settings.padding_right }}px;
    --content-feature-cards-gap: {{ block.settings.gap }}px;
    --content-feature-cards-card-padding: {{ block.settings.card_padding }}px;
    --content-feature-cards-card-radius: {{ block.settings.border_radius }}px;
    --content-feature-cards-border-width: {{ block.settings.border_width }}px;
    --content-feature-cards-heading-color: {{ block.settings.heading_color }};
    --content-feature-cards-text-color: {{ block.settings.text_color }};
    --content-feature-cards-link-color: {{ block.settings.link_color }};
    --content-feature-cards-background-color: {{ block.settings.background_color }};
    --content-feature-cards-card-background-color: {{ block.settings.card_background_color }};
    --content-feature-cards-border-color: {{ block.settings.border_color }};
    --content-feature-cards-icon-size: {{ block.settings.icon_size }}px;
    --content-feature-cards-image-radius: {{ block.settings.image_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-feature-cards-margin-top);
      margin-bottom: var(--content-feature-cards-margin-bottom);
      padding-top: var(--content-feature-cards-padding-top);
      padding-bottom: var(--content-feature-cards-padding-bottom);
      padding-left: var(--content-feature-cards-padding-left);
      padding-right: var(--content-feature-cards-padding-right);
      background: var(--content-feature-cards-background-color);
      color: var(--content-feature-cards-text-color);
    }

    #{{ block_id }}.content-feature-cards--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-feature-cards--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-feature-cards--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-feature-cards--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-feature-cards--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-feature-cards--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-feature-cards--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-feature-cards--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-feature-cards__grid {
      display: grid;
      gap: var(--content-feature-cards-gap);
      width: 100%;
    }

    #{{ block_id }}.content-feature-cards--desktop-1 .content-feature-cards__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.content-feature-cards--desktop-2 .content-feature-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.content-feature-cards--desktop-3 .content-feature-cards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.content-feature-cards--desktop-4 .content-feature-cards__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .content-feature-cards__item {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
      color: var(--content-feature-cards-text-color);
      background: var(--content-feature-cards-card-background-color);
      border: var(--content-feature-cards-border-width) solid var(--content-feature-cards-border-color);
      border-radius: var(--content-feature-cards-card-radius);
      padding: var(--content-feature-cards-card-padding);
      overflow: hidden;
    }

    #{{ block_id }}.content-feature-cards--minimal .content-feature-cards__item {
      padding: 0;
      border-color: transparent;
      background: transparent;
      border-radius: 0;
    }

    #{{ block_id }}.content-feature-cards--bordered .content-feature-cards__item {
      background: transparent;
    }

    #{{ block_id }}.content-feature-cards--cards .content-feature-cards__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .content-feature-cards__media {
      display: flex;
      justify-content: inherit;
      align-items: center;
      width: 100%;
    }

    #{{ block_id }}.content-feature-cards--align-left .content-feature-cards__media {
      justify-content: flex-start;
    }

    #{{ block_id }}.content-feature-cards--align-center .content-feature-cards__media {
      justify-content: center;
    }

    #{{ block_id }}.content-feature-cards--align-right .content-feature-cards__media {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-feature-cards__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--content-feature-cards-icon-size);
      height: var(--content-feature-cards-icon-size);
      line-height: 1;
      color: var(--content-feature-cards-heading-color);
      font-size: var(--content-feature-cards-icon-size);
    }

    #{{ block_id }} .content-feature-cards__image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: var(--content-feature-cards-image-radius);
    }

    #{{ block_id }} .content-feature-cards__heading {
      margin: 0;
      color: var(--content-feature-cards-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .content-feature-cards__text {
      margin: 0;
      color: var(--content-feature-cards-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-feature-cards__link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      color: var(--content-feature-cards-link-color);
      text-decoration: none;
      line-height: 1.2;
      font-weight: inherit;
    }

    #{{ block_id }}.content-feature-cards--align-center .content-feature-cards__link {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-feature-cards--align-right .content-feature-cards__link {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-feature-cards__link:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    #{{ block_id }}.content-feature-cards--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-feature-cards--animate-fade {
      animation-name: contentFeatureCardsFade;
    }

    #{{ block_id }}.content-feature-cards--animate-fade-up {
      animation-name: contentFeatureCardsFadeUp;
    }

    #{{ block_id }}.content-feature-cards--animate-fade-down {
      animation-name: contentFeatureCardsFadeDown;
    }

    #{{ block_id }}.content-feature-cards--animate-fade-left {
      animation-name: contentFeatureCardsFadeLeft;
    }

    #{{ block_id }}.content-feature-cards--animate-fade-right {
      animation-name: contentFeatureCardsFadeRight;
    }

    #{{ block_id }}.content-feature-cards--animate-zoom {
      animation-name: contentFeatureCardsZoom;
    }

    @keyframes contentFeatureCardsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentFeatureCardsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentFeatureCardsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentFeatureCardsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentFeatureCardsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentFeatureCardsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-feature-cards--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-feature-cards--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-feature-cards--desktop-3 .content-feature-cards__grid,
      #{{ block_id }}.content-feature-cards--desktop-4 .content-feature-cards__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-feature-cards--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-feature-cards--mobile-1 .content-feature-cards__grid {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-feature-cards--mobile-2 .content-feature-cards__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-feature-cards--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="content-feature-cards__grid">
    {%- for index in (1..8) -%}
      {%- if index <= card_count -%}
        {%- liquid
          assign image_key = 'card_' | append: index | append: '_image'
          assign icon_key = 'card_' | append: index | append: '_icon'
          assign heading_key = 'card_' | append: index | append: '_heading'
          assign text_key = 'card_' | append: index | append: '_text'
          assign link_label_key = 'card_' | append: index | append: '_link_label'
          assign link_url_key = 'card_' | append: index | append: '_link_url'
          assign alt_key = 'card_' | append: index | append: '_image_alt'

          assign card_image = block.settings[image_key]
          assign card_icon = block.settings[icon_key]
          assign card_heading = block.settings[heading_key]
          assign card_text = block.settings[text_key]
          assign card_link_label = block.settings[link_label_key]
          assign card_link_url = block.settings[link_url_key]
          assign card_image_alt = block.settings[alt_key]
        -%}

        <article class="content-feature-cards__item">
          {% if card_image != blank %}
            <div class="content-feature-cards__media">
              {{
                card_image
                | image_url: width: 900
                | image_tag:
                  class: 'content-feature-cards__image',
                  loading: 'lazy',
                  alt: card_image_alt
              }}
            </div>
          {% elsif card_icon != blank %}
            <div class="content-feature-cards__media" aria-hidden="true">
              <span class="content-feature-cards__icon">{{ card_icon }}</span>
            </div>
          {% endif %}

          {% if card_heading != blank %}
            <h3 class="content-feature-cards__heading">
              {{ card_heading | escape }}
            </h3>
          {% endif %}

          {% if card_text != blank %}
            <div class="content-feature-cards__text">
              {{ card_text }}
            </div>
          {% endif %}

          {% if card_link_label != blank and card_link_url != blank %}
            <a class="content-feature-cards__link" href="{{ card_link_url }}">
              <span>{{ card_link_label | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Content feature cards",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_count",
      "label": "Number of cards",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "3",
