{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-feature-map
    qtm-feature-map-{{ block_id }}
    qtm-feature-map--width-{{ block_width }}
    qtm-feature-map--align-{{ block_alignment }}
    qtm-feature-map--layout-{{ block.settings.layout_style }}
    qtm-feature-map--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-feature-map--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-feature-map--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-feature-map--hide-mobile{% endunless %}
  "
  style="
    --qtm-feature-map-margin-top: {{ block.settings.margin_top }}px;
    --qtm-feature-map-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-feature-map-padding: {{ block.settings.padding }}px;
    --qtm-feature-map-gap: {{ block.settings.gap }}px;
    --qtm-feature-map-heading-color: {{ block.settings.heading_color }};
    --qtm-feature-map-text-color: {{ block.settings.text_color }};
    --qtm-feature-map-background-color: {{ block.settings.background_color }};
    --qtm-feature-map-border-color: {{ block.settings.border_color }};
    --qtm-feature-map-link-color: {{ block.settings.link_color }};
    --qtm-feature-map-card-background: {{ block.settings.card_background_color }};
    --qtm-feature-map-pin-color: {{ block.settings.pin_color }};
    --qtm-feature-map-pin-text-color: {{ block.settings.pin_text_color }};
    --qtm-feature-map-active-color: {{ block.settings.active_color }};
    --qtm-feature-map-border-width: {{ block.settings.border_width }}px;
    --qtm-feature-map-border-radius: {{ block.settings.border_radius }}px;
    --qtm-feature-map-image-radius: {{ block.settings.image_radius }}px;
    --qtm-feature-map-media-height: {{ block.settings.media_min_height }}px;
    --qtm-feature-map-mobile-media-height: {{ block.settings.mobile_media_min_height }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-feature-map__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-feature-map__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-feature-map__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-feature-map__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-feature-map__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-feature-map__experience">
      <div class="qtm-feature-map__media-wrap">
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 2200
            | image_tag:
              class: 'qtm-feature-map__image',
              loading: 'lazy',
              widths: '375, 550, 750, 950, 1200, 1600, 2200',
              sizes: '(min-width: 990px) 60vw, 100vw',
              alt: block.settings.image.alt
          }}
        {% else %}
          <div class="qtm-feature-map__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'qtm-feature-map__placeholder-svg' }}
            <div class="qtm-feature-map__placeholder-content">
              <strong>Add a main image</strong>
              <span>Use this map for product breakdowns, facility tours, or visual feature explorers.</span>
            </div>
          </div>
        {% endif %}

        {% for i in (1..6) %}
          {% liquid
            assign enabled_key = 'pin_' | append: i | append: '_enabled'
            assign x_key = 'pin_' | append: i | append: '_x'
            assign y_key = 'pin_' | append: i | append: '_y'
            assign label_key = 'pin_' | append: i | append: '_label'
            assign heading_key = 'pin_' | append: i | append: '_heading'

            assign pin_enabled = block.settings[enabled_key]
            assign pin_x = block.settings[x_key]
            assign pin_y = block.settings[y_key]
            assign pin_label = block.settings[label_key]
            assign pin_heading = block.settings[heading_key]
          %}

          {% if pin_enabled %}
            <button
              type="button"
              class="qtm-feature-map__pin {% if forloop.first %}is-active{% endif %}"
              style="
                --qtm-feature-map-pin-x: {{ pin_x }}%;
                --qtm-feature-map-pin-y: {{ pin_y }}%;
              "
              data-qtm-feature-map-pin="{{ i }}"
              aria-controls="qtm-feature-map-panel-{{ block_id }}-{{ i }}"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{% if pin_heading != blank %}{{ pin_heading | escape }}{% else %}Feature {{ i }}{% endif %}"
            >
              <span class="qtm-feature-map__pin-inner">
                {% if block.settings.pin_style == 'number' %}
                  {{ pin_label | default: i }}
                {% elsif block.settings.pin_style == 'plus' %}
                  +
                {% else %}
                  <span class="qtm-feature-map__pin-dot" aria-hidden="true"></span>
                {% endif %}
              </span>
            </button>
          {% endif %}
        {% endfor %}
      </div>

      <div class="qtm-feature-map__panels" aria-live="polite">
        {% for i in (1..6) %}
          {% liquid
            assign enabled_key = 'pin_' | append: i | append: '_enabled'
            assign label_key = 'pin_' | append: i | append: '_label'
            assign eyebrow_key = 'pin_' | append: i | append: '_eyebrow'
            assign heading_key = 'pin_' | append: i | append: '_heading'
            assign text_key = 'pin_' | append: i | append: '_text'
            assign link_key = 'pin_' | append: i | append: '_link'
            assign link_text_key = 'pin_' | append: i | append: '_link_text'

            assign pin_enabled = block.settings[enabled_key]
            assign pin_label = block.settings[label_key]
            assign pin_eyebrow = block.settings[eyebrow_key]
            assign pin_heading = block.settings[heading_key]
            assign pin_text = block.settings[text_key]
            assign pin_link = block.settings[link_key]
            assign pin_link_text = block.settings[link_text_key]
          %}

          {% if pin_enabled %}
            <article
              id="qtm-feature-map-panel-{{ block_id }}-{{ i }}"
              class="qtm-feature-map__panel {% if forloop.first %}is-active{% endif %}"
              data-qtm-feature-map-panel="{{ i }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <div class="qtm-feature-map__panel-index">
                {{ pin_label | default: i }}
              </div>

              <div class="qtm-feature-map__panel-copy">
                {% if pin_eyebrow != blank %}
                  <p class="qtm-feature-map__panel-eyebrow">
                    {{ pin_eyebrow | escape }}
                  </p>
                {% endif %}

                {% if pin_heading != blank %}
                  <h3 class="qtm-feature-map__panel-heading">
                    {{ pin_heading | escape }}
                  </h3>
                {% endif %}

                {% if pin_text != blank %}
                  <div class="qtm-feature-map__panel-text">
                    {{ pin_text }}
                  </div>
                {% endif %}

                {% if pin_link != blank and pin_link_text != blank %}
                  <a class="qtm-feature-map__panel-link" href="{{ pin_link }}">
                    {{ pin_link_text | escape }}
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  .qtm-feature-map-{{ block_id }} {
    margin-top: var(--qtm-feature-map-margin-top);
    margin-bottom: var(--qtm-feature-map-margin-bottom);
    padding: var(--qtm-feature-map-padding);
    color: var(--qtm-feature-map-text-color);
    background: var(--qtm-feature-map-background-color);
    border: var(--qtm-feature-map-border-width) solid var(--qtm-feature-map-border-color);
    border-radius: var(--qtm-feature-map-border-radius);
  }

  .qtm-feature-map-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--width-auto {
    width: auto;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--width-small {
    max-width: 760px;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--width-medium {
    max-width: 980px;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--width-large {
    max-width: 1240px;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__inner {
    display: grid;
    gap: var(--qtm-feature-map-gap);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__header {
    display: grid;
    gap: 0.75rem;
    max-width: 780px;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--align-center .qtm-feature-map__header {
    margin-inline: auto;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--align-right .qtm-feature-map__header {
    margin-left: auto;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__eyebrow {
    margin: 0;
    color: var(--qtm-feature-map-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__heading {
    margin: 0;
    color: var(--qtm-feature-map-heading-color);
    line-height: 1.05;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__text,
  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-text {
    color: var(--qtm-feature-map-text-color);
    line-height: 1.7;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__text p,
  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-text p {
    margin-top: 0;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__text p:last-child,
  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-text p:last-child {
    margin-bottom: 0;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__experience {
    display: grid;
    gap: var(--qtm-feature-map-gap);
    align-items: start;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-side-panel .qtm-feature-map__experience {
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-panel-left .qtm-feature-map__experience {
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-panel-left .qtm-feature-map__panels {
    order: -1;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-stacked .qtm-feature-map__experience {
    grid-template-columns: 1fr;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__media-wrap {
    position: relative;
    overflow: hidden;
    min-height: var(--qtm-feature-map-media-height);
    background: color-mix(in srgb, var(--qtm-feature-map-text-color), transparent 94%);
    border: 1px solid color-mix(in srgb, var(--qtm-feature-map-border-color), transparent 12%);
    border-radius: var(--qtm-feature-map-image-radius);
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.075);
    isolation: isolate;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__image,
  .qtm-feature-map-{{ block_id }} .qtm-feature-map__placeholder {
    display: block;
    width: 100%;
    min-height: var(--qtm-feature-map-media-height);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__image {
    height: 100%;
    object-fit: cover;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__placeholder {
    position: relative;
    display: grid;
    place-items: center;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.24;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__placeholder-content {
    position: absolute;
    inset: auto 1.25rem 1.25rem;
    display: grid;
    gap: 0.25rem;
    max-width: 28rem;
    padding: 1rem;
    color: var(--qtm-feature-map-text-color);
    background: var(--qtm-feature-map-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-feature-map-border-color), transparent 20%);
    border-radius: calc(var(--qtm-feature-map-border-radius) * 0.55);
    text-align: left;
    box-shadow: 0 1rem 2.2rem rgba(0, 0, 0, 0.08);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__placeholder-content strong {
    color: var(--qtm-feature-map-heading-color);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin {
    position: absolute;
    left: var(--qtm-feature-map-pin-x);
    top: var(--qtm-feature-map-pin-y);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    color: var(--qtm-feature-map-pin-text-color);
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transform: translate(-50%, -50%);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--qtm-feature-map-pin-color);
    opacity: 0.22;
    transform: scale(1);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin-inner {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    color: var(--qtm-feature-map-pin-text-color);
    background: var(--qtm-feature-map-pin-color);
    border: 2px solid rgba(255, 255, 255, 0.86);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.2);
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    border-radius: 999px;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin:hover .qtm-feature-map__pin-inner,
  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin:focus-visible .qtm-feature-map__pin-inner,
  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin.is-active .qtm-feature-map__pin-inner {
    background: var(--qtm-feature-map-active-color);
    transform: scale(1.08);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.26);
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin.is-active::before {
    background: var(--qtm-feature-map-active-color);
    opacity: 0.32;
  }

  {% if block.settings.enable_pin_pulse %}
    .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin::before {
      animation: qtm-feature-map-pulse-{{ block_id }} 1.9s ease-in-out infinite;
    }

    @keyframes qtm-feature-map-pulse-{{ block_id }} {
      0%, 100% {
        opacity: 0.22;
        transform: scale(1);
      }

      50% {
        opacity: 0.07;
        transform: scale(1.5);
      }
    }
  {% endif %}

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--qtm-feature-map-active-color), #ffffff 30%);
    outline-offset: 5px;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panels {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1rem, 2vw, 1.4rem);
    color: var(--qtm-feature-map-text-color);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--qtm-feature-map-active-color), transparent 92%),
        transparent 46%
      ),
      var(--qtm-feature-map-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-feature-map-border-color), transparent 8%);
    border-radius: calc(var(--qtm-feature-map-border-radius) * 0.75);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.055);
    text-align: left;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel[hidden] {
    display: none;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-index {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--qtm-feature-map-pin-text-color);
    background: var(--qtm-feature-map-active-color);
    border-radius: 999px;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-copy {
    display: grid;
    gap: 0.5rem;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-eyebrow {
    margin: 0;
    color: var(--qtm-feature-map-link-color);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-heading {
    margin: 0;
    color: var(--qtm-feature-map-heading-color);
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.12;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-link {
    display: inline-flex;
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--qtm-feature-map-link-color);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 180ms ease;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-link:hover {
    opacity: 0.72;
  }

  .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-link:focus-visible {
    outline: 3px solid var(--qtm-feature-map-link-color);
    outline-offset: 4px;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--animation-fade {
    animation: qtm-feature-map-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--animation-fade-up {
    animation: qtm-feature-map-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--animation-fade-down {
    animation: qtm-feature-map-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--animation-fade-left {
    animation: qtm-feature-map-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--animation-fade-right {
    animation: qtm-feature-map-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-feature-map-{{ block_id }}.qtm-feature-map--animation-zoom {
    animation: qtm-feature-map-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-feature-map-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-feature-map-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-feature-map-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-feature-map-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-feature-map-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-feature-map-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-feature-map-{{ block_id }}.qtm-feature-map--hide-tablet {
      display: none !important;
    }

    .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-side-panel .qtm-feature-map__experience,
    .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-panel-left .qtm-feature-map__experience {
      grid-template-columns: 1fr;
    }

    .qtm-feature-map-{{ block_id }}.qtm-feature-map--layout-panel-left .qtm-feature-map__panels {
      order: initial;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-feature-map-{{ block_id }}.qtm-feature-map--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-feature-map-{{ block_id }} {
      padding: min(var(--qtm-feature-map-padding), 24px);
    }

    .qtm-feature-map-{{ block_id }}.qtm-feature-map--hide-mobile {
      display: none !important;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__media-wrap,
    .qtm-feature-map-{{ block_id }} .qtm-feature-map__image,
    .qtm-feature-map-{{ block_id }} .qtm-feature-map__placeholder {
      min-height: var(--qtm-feature-map-mobile-media-height);
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin {
      width: 2.55rem;
      height: 2.55rem;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__pin-inner {
      width: 1.65rem;
      height: 1.65rem;
      font-size: 0.78rem;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__panels {
      display: grid;
      gap: 0.85rem;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel {
      display: grid !important;
      grid-template-columns: auto minmax(0, 1fr);
      padding: 1rem;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel[hidden] {
      display: grid !important;
      opacity: 0.72;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel:not(.is-active) {
      border-style: dashed;
    }

    .qtm-feature-map-{{ block_id }} .qtm-feature-map__panel-index {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-feature-map-{{ block_id }},
    .qtm-feature-map-{{ block_id }} *,
    .qtm-feature-map-{{ block_id }} *::before,
    .qtm-feature-map-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.qtm-feature-map-{{ block_id }}');
    if (!root) return;

    const pins = Array.from(root.querySelectorAll('[data-qtm-feature-map-pin]'));
    const panels = Array.from(root.querySelectorAll('[data-qtm-feature-map-panel]'));

    const activate = (id) => {
      pins.forEach((pin) => {
        const isActive = pin.dataset.qtmFeatureMapPin === id;
        pin.classList.toggle('is-active', isActive);
        pin.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.qtmFeatureMapPanel === id;
        panel.classList.toggle('is-active', isActive);

        if (window.matchMedia('(max-width: 749px)').matches) {
          panel.hidden = false;
        } else {
          panel.hidden = !isActive;
        }
      });
    };

    pins.forEach((pin, index) => {
      pin.addEventListener('click', () => {
        activate(pin.dataset.qtmFeatureMapPin);
      });

      pin.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;

        event.preventDefault();

        let nextIndex = index;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = index + 1 >= pins.length ? 0 : index + 1;
        }

        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = index - 1 < 0 ? pins.length - 1 : index - 1;
        }

        if (event.key === 'Home') {
          nextIndex = 0;
        }

        if (event.key === 'End') {
          nextIndex = pins.length - 1;
        }

        const nextPin = pins[nextIndex];
        if (!nextPin) return;

        nextPin.focus();
        activate(nextPin.dataset.qtmFeatureMapPin);
      });
    });

    const syncMobilePanels = () => {
      const activePin = root.querySelector('[data-qtm-feature-map-pin].is-active');
      if (activePin) {
        activate(activePin.dataset.qtmFeatureMapPin);
      }
    };

    window.addEventListener('resize', syncMobilePanels, { passive: true });
    syncMobilePanels();
  })();
</script>

