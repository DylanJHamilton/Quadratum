{% comment %}
  Quadratum — Sub Page Banner (Classic)
  • Exact behavior of Classic Hero (media, overlays, slideshow), scoped to sub-banner
  • Default height tuned for sub pages: 60vh + 80px (editable)
  • Click safety: background/slides inert; CTAs above dots
{% endcomment %}



{%- assign s = section.settings -%}

{%- assign T_font_heading        = settings.font_heading -%}
{%- assign T_font_body           = settings.font_body -%}
{%- assign T_head_letter         = settings.headings_letterspacing | default: 0 -%}
{%- assign T_head_uppercase      = settings.headings_uppercase -%}
{%- assign T_btn_variant_default = settings.button_variant_default | default: 'solid' -%}
{%- assign T_btn_radius          = settings.button_radius | default: 12 -%}
{%- assign T_btn_bw              = settings.button_border_width | default: 1 -%}
{%- assign T_btn_hover_op        = settings.button_hover_opacity | default: 92 -%}
{%- assign T_btn_active_scale    = settings.button_active_scale | default: 98 -%}

{%- assign C_primary        = settings.color_primary        | default: '#2563eb' -%}
{%- assign C_bg_contrast    = settings.bg_contrast          | default: '#f6f7f8' -%}
{%- assign C_text_base      = settings.text_base            | default: '#111111' -%}
{%- assign C_text_on_color  = settings.text_on_color        | default: '#ffffff' -%}

{%- assign pos_m    = s.content_position_mobile | default: 'center_center' -%}
{%- assign pos_d    = s.content_position        | default: 'center_center' -%}
{%- assign txt_align = s.text_alignment         | default: 'center' -%}

{%- assign cta_align = s.cta_group_align | default: txt_align -%}
{%- assign cta_justify_css = 'center' -%}
{%- if cta_align == 'left'  -%}{%- assign cta_justify_css = 'flex-start' -%}{%- endif -%}
{%- if cta_align == 'right' -%}{%- assign cta_justify_css = 'flex-end'   -%}{%- endif -%}

{%- assign head_align_choice = s.heading_alignment | default: 'inherit' -%}
{%- assign head_align = txt_align -%}
{%- unless head_align_choice == 'inherit' or head_align_choice == blank -%}
  {%- assign head_align = head_align_choice -%}
{%- endunless -%}

{%- assign min_h_val = '60vh' -%}
{%- if s.min_height == 'min-h-[50vh]' -%}{%- assign min_h_val = '50vh' -%}{%- endif -%}
{%- if s.min_height == 'min-h-[60vh]' -%}{%- assign min_h_val = '60vh' -%}{%- endif -%}
{%- if s.min_height == 'min-h-[75vh]' -%}{%- assign min_h_val = '75vh' -%}{%- endif -%}
{%- if s.min_height == 'min-h-screen' -%}{%- assign min_h_val = '100vh' -%}{%- endif -%}

{%- assign min_h_val_tablet = blank -%}
{%- if s.min_height_tablet == 'min-h-[50vh]' -%}{%- assign min_h_val_tablet = '50vh' -%}{%- endif -%}
{%- if s.min_height_tablet == 'min-h-[60vh]' -%}{%- assign min_h_val_tablet = '60vh' -%}{%- endif -%}
{%- if s.min_height_tablet == 'min-h-[75vh]' -%}{%- assign min_h_val_tablet = '75vh' -%}{%- endif -%}
{%- if s.min_height_tablet == 'min-h-screen' -%}{%- assign min_h_val_tablet = '100vh' -%}{%- endif -%}

{%- assign min_h_val_mobile = blank -%}
{%- if s.min_height_mobile == 'min-h-[50vh]' -%}{%- assign min_h_val_mobile = '50vh' -%}{%- endif -%}
{%- if s.min_height_mobile == 'min-h-[60vh]' -%}{%- assign min_h_val_mobile = '60vh' -%}{%- endif -%}
{%- if s.min_height_mobile == 'min-h-[75vh]' -%}{%- assign min_h_val_mobile = '75vh' -%}{%- endif -%}
{%- if s.min_height_mobile == 'min-h-screen' -%}{%- assign min_h_val_mobile = '100vh' -%}{%- endif -%}

{%- assign max_w_css = '56rem' -%}
{%- if s.content_max_w == 'max-w-2xl' -%}{%- assign max_w_css = '42rem' -%}{%- endif -%}
{%- if s.content_max_w == 'max-w-3xl' -%}{%- assign max_w_css = '48rem' -%}{%- endif -%}

{%- assign accent_fs  = '1.125rem' -%}
{%- if s.accent_size == 'sm'   -%}{%- assign accent_fs = '0.875rem' -%}{%- endif -%}
{%- if s.accent_size == 'base' -%}{%- assign accent_fs = '1rem'     -%}{%- endif -%}
{%- if s.accent_size == 'xl'   -%}{%- assign accent_fs = '1.25rem'  -%}{%- endif -%}

{%- assign heading_fs = '3rem' -%}
{%- if s.heading_size == '3xl' -%}{%- assign heading_fs = '1.875rem' -%}{%- endif -%}
{%- if s.heading_size == '4xl' -%}{%- assign heading_fs = '2.25rem'  -%}{%- endif -%}
{%- if s.heading_size == '6xl' -%}{%- assign heading_fs = '3.75rem'  -%}{%- endif -%}

{%- assign sub_fs = '1.125rem' -%}
{%- if s.subheading_size == 'base' -%}{%- assign sub_fs = '1rem'     -%}{%- endif -%}
{%- if s.subheading_size == 'xl'   -%}{%- assign sub_fs = '1.25rem'  -%}{%- endif -%}

{%- assign _btn_choice = s.button_mode | default: 'inherit' -%}
{%- if _btn_choice == 'inherit' or _btn_choice == blank -%}
  {%- assign _btn_variant = T_btn_variant_default -%}
{%- else -%}
  {%- assign _btn_variant = _btn_choice -%}
{%- endif -%}

{%- assign btn_mode_class = 'q-btn--solid' -%}
{%- if _btn_variant == 'outline' -%}{%- assign btn_mode_class = 'q-btn--outline' -%}{%- endif -%}
{%- if _btn_variant == 'ghost'   -%}{%- assign btn_mode_class = 'q-btn--ghost'   -%}{%- endif -%}

{%- assign visibility_classes = '' -%}
{%- if s.hide_on_mobile  -%}{%- assign visibility_classes = visibility_classes | append: ' hidden md:block q-hide-mobile' -%}{%- endif -%}
{%- if s.hide_on_desktop -%}{%- assign visibility_classes = visibility_classes | append: ' md:hidden q-hide-desktop' -%}{%- endif -%}

{%- assign pad_l_m = 0 -%}{%- assign pad_r_m = 0 -%}
{%- assign pad_l_d = 0 -%}{%- assign pad_r_d = 0 -%}
{%- if s.container_mode == 'contained' -%}
  {%- assign pad_l_m = 16 -%}{%- assign pad_r_m = 16 -%}
  {%- assign pad_l_d = 24 -%}{%- assign pad_r_d = 24 -%}
{%- endif -%}

{%- assign _accent_color = s.accent_color     | default: C_text_on_color -%}
{%- assign _head_color   = s.heading_color    | default: C_text_on_color -%}
{%- assign _sub_color    = s.subheading_color | default: C_text_on_color -%}

{%- assign _btn_bg   = s.button_bg_color     | default: C_primary -%}
{%- assign _btn_fg   = s.button_text_color   | default: settings.text_on_color | default: '#ffffff' -%}
{%- assign _btn_bdr  = s.button_border_color | default: C_text_base -%}
{%- assign _btn_bw   = s.button_border_width | default: T_btn_bw -%}
{%- assign _btn_rad  = s.button_radius       | default: T_btn_radius -%}
{%- assign _btn_px   = s.button_padding_horizontal | default: 24 -%}
{%- assign _btn_py   = s.button_padding_vertical   | default: 12 -%}

<style>
  #shopify-section-{{ section.id }} [data-classic-hero] {
    --q-min-h: {{ min_h_val }};
    position:relative; isolation:isolate; min-height:calc(var(--q-min-h) + {{ s.extra_height | default: 80 }}px);
    margin-top:{{ s.margin_top | default: 0 }}px; margin-bottom:{{ s.margin_bottom | default: 0 }}px;
    background:{{ s.background_color | default: '#111827' }};
    {% if T_font_body %}font-family:{{ T_font_body.family }}, {{ T_font_body.fallback_families }};{% endif %}
  }
  #shopify-section-{{ section.id }} [data-classic-hero] * { box-sizing:border-box; }
  #shopify-section-{{ section.id }} .q-bleed { position:relative; min-height:inherit; }
  #shopify-section-{{ section.id }} .q-bg,
  #shopify-section-{{ section.id }} .q-slides,
  #shopify-section-{{ section.id }} .q-frame,
  #shopify-section-{{ section.id }} .q-overlay,
  #shopify-section-{{ section.id }} .q-overlay-i { position:absolute; inset:0; pointer-events:none; }
  #shopify-section-{{ section.id }} .q-bg { overflow:hidden; }
  #shopify-section-{{ section.id }} .q-frame { opacity:0; transition:opacity 500ms ease; }
  #shopify-section-{{ section.id }} .q-frame.is-active { opacity:1; }
  #shopify-section-{{ section.id }} .q-media { width:100%; height:100%; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .q-media-wrap { position:absolute; inset:0; overflow:hidden; }
  #shopify-section-{{ section.id }} .q-media-embed { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); min-width:100%; min-height:100%; width:177.78vh; height:56.25vw; border:0; }
  #shopify-section-{{ section.id }} [hidden] { display:none; }
  #shopify-section-{{ section.id }} .q-layer { position:relative; z-index:1; min-height:inherit; pointer-events:none; }
  #shopify-section-{{ section.id }} .q-flexor { display:flex; min-height:inherit; padding:{{ s.padding_top | default: 60 }}px {{ pad_l_m }}px {{ s.padding_bottom | default: 60 }}px {{ pad_r_m }}px; }
  #shopify-section-{{ section.id }} .q-wrap { width:100%; max-width:{{ max_w_css }}; min-width:0; overflow-wrap:anywhere; pointer-events:auto; }
  #shopify-section-{{ section.id }} [data-pos-m*="start_"] .q-flexor { align-items:flex-start; }
  #shopify-section-{{ section.id }} [data-pos-m*="center_"] .q-flexor { align-items:center; }
  #shopify-section-{{ section.id }} [data-pos-m*="end_"] .q-flexor { align-items:flex-end; }
  #shopify-section-{{ section.id }} [data-pos-m$="_start"] .q-flexor { justify-content:flex-start; }
  #shopify-section-{{ section.id }} [data-pos-m$="_center"] .q-flexor { justify-content:center; }
  #shopify-section-{{ section.id }} [data-pos-m$="_end"] .q-flexor { justify-content:flex-end; }
  #shopify-section-{{ section.id }} .q-heading {
    {% if T_font_heading %}font-family:{{ T_font_heading.family }}, {{ T_font_heading.fallback_families }};{% endif %}
    {% if T_head_uppercase %}text-transform:uppercase;{% endif %}
    letter-spacing:{{ T_head_letter | divided_by: 1000.0 }}em; line-height:1.12;
  }
  #shopify-section-{{ section.id }} .q-sub { line-height:1.5; }
  #shopify-section-{{ section.id }} .q-ctas { flex-wrap:wrap; }
  #shopify-section-{{ section.id }} .q-btn {
    display:inline-flex; align-items:center; justify-content:center; min-height:44px; max-width:100%;
    padding:{{ _btn_py }}px {{ _btn_px }}px; border:{{ _btn_bw }}px solid {{ _btn_bdr }}; border-radius:{{ _btn_rad }}px;
    background:{{ _btn_bg }}; color:{{ _btn_fg }}; text-decoration:none; font-weight:600;
    transition:transform .15s ease, opacity .15s ease;
  }
  #shopify-section-{{ section.id }} .q-btn--outline { background:transparent; color:{{ _btn_fg }}; }
  #shopify-section-{{ section.id }} .q-btn--ghost { background:transparent; border-color:transparent; color:{{ _btn_fg }}; }
  #shopify-section-{{ section.id }} .q-btn:hover { opacity:{{ T_btn_hover_op | divided_by: 100.0 }}; }
  #shopify-section-{{ section.id }} .q-btn:active { transform:scale({{ T_btn_active_scale | divided_by: 100.0 }}); }
  #shopify-section-{{ section.id }} .q-hero-dots { position:absolute; bottom:8px; left:0; right:0; display:flex; justify-content:center; flex-wrap:wrap; z-index:2; }
  #shopify-section-{{ section.id }} .q-hero-dot { position:relative; width:44px; height:44px; border:0; background:transparent; cursor:pointer; }
  #shopify-section-{{ section.id }} .q-hero-dot::after { content:''; position:absolute; inset:17px; border-radius:50%; background:#aaa; }
  #shopify-section-{{ section.id }} .q-hero-dot[aria-current="true"]::after { background:#fff; }
  #shopify-section-{{ section.id }} .q-hero-pause { position:absolute; z-index:2; bottom:60px; right:16px; min-height:44px; max-width:calc(100% - 32px); background:#111; color:#fff; border:1px solid #fff; padding:8px 12px; }
  #shopify-section-{{ section.id }} .q-btn:focus-visible,
  #shopify-section-{{ section.id }} button:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  @keyframes subKenIn-{{ section.id }} { from { transform:scale(1); } to { transform:scale(1.06); } }
  @keyframes subKenOut-{{ section.id }} { from { transform:scale(1.06); } to { transform:scale(1); } }
  @keyframes subPanL-{{ section.id }} { from { transform:translateX(0); } to { transform:translateX(-2.5%); } }
  @keyframes subPanR-{{ section.id }} { from { transform:translateX(0); } to { transform:translateX(2.5%); } }
  #shopify-section-{{ section.id }} .q-ken-in { animation:subKenIn-{{ section.id }} 20s linear infinite alternate; }
  #shopify-section-{{ section.id }} .q-ken-out { animation:subKenOut-{{ section.id }} 20s linear infinite alternate; }
  #shopify-section-{{ section.id }} .q-pan-left { animation:subPanL-{{ section.id }} 20s linear infinite alternate; }
  #shopify-section-{{ section.id }} .q-pan-right { animation:subPanR-{{ section.id }} 20s linear infinite alternate; }
  #shopify-section-{{ section.id }} [data-motion-paused="true"] .q-media,
  #shopify-section-{{ section.id }} .q-frame:not(.is-active) .q-media { animation-play-state:paused; }
  @media (min-width:768px) {
    #shopify-section-{{ section.id }} .q-hide-desktop { display:none; }
    #shopify-section-{{ section.id }} .q-flexor { padding-left:{{ pad_l_d }}px; padding-right:{{ pad_r_d }}px; }
    #shopify-section-{{ section.id }} [data-pos-d*="start_"] .q-flexor { align-items:flex-start; }
    #shopify-section-{{ section.id }} [data-pos-d*="center_"] .q-flexor { align-items:center; }
    #shopify-section-{{ section.id }} [data-pos-d*="end_"] .q-flexor { align-items:flex-end; }
    #shopify-section-{{ section.id }} [data-pos-d$="_start"] .q-flexor { justify-content:flex-start; }
    #shopify-section-{{ section.id }} [data-pos-d$="_center"] .q-flexor { justify-content:center; }
    #shopify-section-{{ section.id }} [data-pos-d$="_end"] .q-flexor { justify-content:flex-end; }
  }
  @media (max-width:1023px) {
    {% if min_h_val_tablet != blank %}#shopify-section-{{ section.id }} [data-classic-hero] { --q-min-h:{{ min_h_val_tablet }}; }{% endif %}
  }
  @media (max-width:767.98px) {
    #shopify-section-{{ section.id }} .q-hide-mobile { display:none; }
    {% if min_h_val_mobile != blank %}#shopify-section-{{ section.id }} [data-classic-hero] { --q-min-h:{{ min_h_val_mobile }}; }{% endif %}
    {% if s.accent_size_mobile != blank and s.accent_size_mobile != 'auto' %}#shopify-section-{{ section.id }} .q-accent { font-size:{{ s.accent_size_mobile }} !important; }{% endif %}
    {% if s.heading_size_mobile != blank and s.heading_size_mobile != 'auto' %}#shopify-section-{{ section.id }} .q-heading { font-size:{{ s.heading_size_mobile }} !important; }{% endif %}
    {% if s.subheading_size_mobile != blank and s.subheading_size_mobile != 'auto' %}#shopify-section-{{ section.id }} .q-sub { font-size:{{ s.subheading_size_mobile }} !important; }{% endif %}
  }
  @media (prefers-reduced-motion:reduce) {
    #shopify-section-{{ section.id }} .q-media { animation:none; }
    #shopify-section-{{ section.id }} .q-frame,
    #shopify-section-{{ section.id }} .q-btn { transition:none; transform:none; }
  }
</style>

<section
  id="{{ s.anchor_id | default: section.id | escape }}"
  data-classic-hero
  class="q-sub-banner-classic banner-section{{ visibility_classes }}"
  role="region"
  aria-label="{{ s.aria_label | default: 'Sub page banner' | escape }}"
  data-pos-m="{{ pos_m }}"
  data-pos-d="{{ pos_d }}"
  data-text-align="{{ txt_align }}"
  style="
    --q-max-w: {{ max_w_css }};
    --q-pad-top: {{ s.padding_top | default: 60 }}px;
    --q-pad-bot: {{ s.padding_bottom | default: 60 }}px;
    --q-mar-top: {{ s.margin_top | default: 0 }}px;
    --q-mar-bot: {{ s.margin_bottom | default: 0 }}px;
    --q-accent-fs: {{ accent_fs }};
    --q-head-fs: {{ heading_fs }};
    --q-sub-fs: {{ sub_fs }};
    --q-accent-color: {{ _accent_color }};
    --q-head-color: {{ _head_color }};
    --q-sub-color: {{ _sub_color }};
    --q-cta-justify: {{ cta_justify_css }};

  "
>
  <div class="q-bleed">
    <div class="q-bg"
         {% if s.use_slideshow and section.blocks.size > 0 %}
           data-q-hero
           data-autoplay="{{ s.autoplay }}"
           data-interval="{{ s.autoplay_interval | default: 5 }}"
         {% endif %}
         aria-hidden="true">

      {%- if s.use_slideshow and section.blocks.size > 0 -%}
        <div class="q-slides">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign effect = b.media_effect | default: 'none' -%}
            {%- assign effect_class = '' -%}
            {%- if effect == 'ken_in'   -%}{%- assign effect_class = 'q-ken-in'    -%}{%- endif -%}
            {%- if effect == 'ken_out'  -%}{%- assign effect_class = 'q-ken-out'   -%}{%- endif -%}
            {%- if effect == 'pan_left' -%}{%- assign effect_class = 'q-pan-left'  -%}{%- endif -%}
            {%- if effect == 'pan_right'-%}{%- assign effect_class = 'q-pan-right' -%}{%- endif -%}
            {%- assign focal = b.focal_point | default: 'center' -%}

            <div class="q-frame{% if forloop.first %} is-active{% endif %}" data-q-hero-slide data-block-id="{{ block.id }}" {% unless forloop.first %}inert aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
              {%- if b.video_url != blank -%}
                <video class="q-media" loop muted playsinline preload="{% if forloop.first %}auto{% else %}metadata{% endif %}"
                       {% if b.image != blank %}poster="{{ b.image | image_url: width: 1600 }}"{% endif %}>
                  <source src="{{ b.video_url | escape }}" type="video/mp4">
                </video>
              {%- elsif b.image != blank or b.mobile_image != blank -%}
                {%- assign slide_image = b.image | default: b.mobile_image -%}
                {%- assign widths = '960,1440,1920,2560,2880' | split: ',' -%}
                <picture>
                  {%- if b.mobile_image != blank -%}
                    <source media="(max-width: 767px)"
                            srcset="{% for w in widths %}{{ b.mobile_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                            sizes="100vw">
                  {%- endif -%}
                  <img class="q-media {{ effect_class }}"
                       alt="{{ b.alt | default: '' | escape }}" width="{{ slide_image.width }}" height="{{ slide_image.height }}"
                       style="object-position: {{ focal }};"
                       {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                       decoding="async"
                       src="{{ slide_image | image_url: width: 1920 }}"
                       srcset="{% for w in widths %}{{ slide_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                       sizes="100vw">
                </picture>
              {%- endif -%}

              {%- assign ov_mode = b.overlay_mode | default: 'inherit' -%}
              {%- if ov_mode == 'gradient' -%}
                {%- assign g1 = b.grad_start | default: s.grad_start | default: '#000000' -%}
                {%- assign g1o = b.grad_start_opacity | default: s.grad_start_opacity | default: 0 | divided_by: 100.0 -%}
                {%- assign g2 = b.grad_end   | default: s.grad_end   | default: '#000000' -%}
                {%- assign g2o = b.grad_end_opacity | default: s.grad_end_opacity | default: 0 | divided_by: 100.0 -%}
                {%- assign ang = b.grad_angle | default: s.grad_angle | default: 180 -%}
                {%- assign g1c = g1 | color_modify: 'alpha', g1o -%}
                {%- assign g2c = g2 | color_modify: 'alpha', g2o -%}
                <div class="q-overlay-i" style="background: linear-gradient({{ ang }}deg, {{ g1c }}, {{ g2c }});"></div>
              {%- elsif ov_mode == 'solid' -%}
                {%- assign oc = b.overlay_color | default: s.overlay_color | default: '#000000' -%}
                {%- assign oo = b.overlay_opacity | default: s.overlay_opacity | default: 0 | divided_by: 100.0 -%}
                <div class="q-overlay-i" style="background-color: {{ oc }}; opacity: {{ oo }};"></div>
              {%- else -%}
                {%- assign oc = s.overlay_color | default: '#000000' -%}
                {%- assign oo = s.overlay_opacity | default: 0 | divided_by: 100.0 -%}
                {%- if s.overlay_type == 'gradient' -%}
                  {%- assign g1 = s.grad_start | default: '#000000' -%}
                  {%- assign g2 = s.grad_end   | default: '#000000' -%}
                  {%- assign g1o = s.grad_start_opacity | default: 0 | divided_by: 100.0 -%}
                  {%- assign g2o = s.grad_end_opacity   | default: 0 | divided_by: 100.0 -%}
                  {%- assign ang = s.grad_angle | default: 180 -%}
                  {%- assign g1c = g1 | color_modify: 'alpha', g1o -%}
                  {%- assign g2c = g2 | color_modify: 'alpha', g2o -%}
                  <div class="q-overlay-i" style="background: linear-gradient({{ ang }}deg, {{ g1c }}, {{ g2c }});"></div>
                {%- else -%}
                  <div class="q-overlay-i" style="background-color: {{ oc }}; opacity: {{ oo }};"></div>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- comment %} Single-media with video support {% endcomment -%}
        {% assign vurl = s.background_video | strip %}
        {% if vurl != blank %}
          {%- assign is_youtube = false -%}
          {%- assign is_vimeo = false -%}
          {%- if vurl contains 'youtube.com' or vurl contains 'youtu.be' -%}{%- assign is_youtube = true -%}{%- endif -%}
          {%- if vurl contains 'vimeo.com' -%}{%- assign is_vimeo = true -%}{%- endif -%}

          {% if is_youtube %}
            {%- assign yid = vurl
              | replace: 'https://youtu.be/',''
              | replace: 'http://youtu.be/',''
              | replace: 'https://www.youtube.com/watch?v=',''
              | replace: 'http://www.youtube.com/watch?v=',''
              | replace: 'https://youtube.com/watch?v=',''
              | replace: 'http://youtube.com/watch?v=',''
              | split:'?' | first | split:'&' | first -%}
            <div class="q-media-wrap" aria-hidden="true">
              <iframe
                class="q-media-embed"
                hidden data-classic-video-src="https://www.youtube.com/embed/{{ yid | escape }}?autoplay=1&mute=1&controls=0&playsinline=1&loop=1&playlist={{ yid | escape }}&modestbranding=1&rel=0"
                title="Background video" tabindex="-1"
                allow="autoplay; encrypted-media"></iframe>
            </div>
          {% elsif is_vimeo %}
            {%- assign vid = vurl | split:'/' | last | split:'?' | first | split:'&' | first -%}
            <div class="q-media-wrap" aria-hidden="true">
              <iframe
                class="q-media-embed"
                hidden data-classic-video-src="https://player.vimeo.com/video/{{ vid | escape }}?background=1&autoplay=1&muted=1&loop=1&autopause=0&controls=0"
                title="Background video" tabindex="-1"
                allow="autoplay; fullscreen; picture-in-picture"></iframe>
            </div>
          {% else %}
            <video class="q-media" loop muted playsinline preload="none"
              {% if s.background_image != blank %}poster="{{ s.background_image | image_url: width: 1600 }}"{% endif %}>
              <source src="{{ vurl | escape }}" type="video/mp4">
            </video>
          {% endif %}
        {% elsif s.background_image != blank %}
          {{ s.background_image
            | image_url: width: 2880
            | image_tag:
              widths: '960,1440,1920,2560,2880',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'q-media',
              decoding: 'async',
              alt: '' }}
        {% else %}
          <div class="q-media" style="background:{{ s.background_color | default: C_bg_contrast }};"></div>
        {% endif %}

        {% if s.overlay_type == 'gradient' %}
          {%- assign g1 = s.grad_start | default: '#000000' -%}
          {%- assign g2 = s.grad_end   | default: '#000000' -%}
          {%- assign g1o = s.grad_start_opacity | default: 0 | divided_by: 100.0 -%}
          {%- assign g2o = s.grad_end_opacity   | default: 0 | divided_by: 100.0 -%}
          {%- assign ang = s.grad_angle | default: 180 -%}
          {%- assign g1c = g1 | color_modify: 'alpha', g1o -%}
          {%- assign g2c = g2 | color_modify: 'alpha', g2o -%}
          <div class="q-overlay" style="background: linear-gradient({{ ang }}deg, {{ g1c }}, {{ g2c }});"></div>
        {% else %}
          <div class="q-overlay" style="background-color: {{ s.overlay_color }}; opacity: {{ s.overlay_opacity | divided_by: 100.0 }};"></div>
        {% endif %}
      {%- endif -%}
    </div>

    <div class="q-layer">
      <div class="q-flexor">
        <div class="q-wrap {{ s.content_max_w }}"
             style="--q-pad-l-m: {{ pad_l_m }}px; --q-pad-r-m: {{ pad_r_m }}px; --q-pad-l-d: {{ pad_l_d }}px; --q-pad-r-d: {{ pad_r_d }}px; text-align: {{ txt_align }};">
          {% if s.accent_heading != blank %}
            <p class="q-accent" style="color: var(--q-accent-color, {{ _accent_color }}); font-size: var(--q-accent-fs, {{ accent_fs }});">{{ s.accent_heading }}</p>
          {% endif %}

          {% if s.heading != blank %}
            {% case s.heading_level %}
              {% when 'h2' %}<h2 class="q-heading" style="color: var(--q-head-color, {{ _head_color }}); font-size: var(--q-head-fs, {{ heading_fs }}); text-align: {{ head_align }};">{{ s.heading }}</h2>
              {% else %}<h1 class="q-heading" style="color: var(--q-head-color, {{ _head_color }}); font-size: var(--q-head-fs, {{ heading_fs }}); text-align: {{ head_align }};">{{ s.heading }}</h1>
            {% endcase %}
          {% endif %}

          {% if s.subheading != blank %}
            <p class="q-sub" style="color: var(--q-sub-color, {{ _sub_color }}); font-size: var(--q-sub-fs, {{ sub_fs }});">{{ s.subheading }}</p>
          {% endif %}

          {% if s.cta_text != blank or s.cta2_text != blank %}
            <div class="q-ctas" style="display:flex; gap:.75rem; justify-content: var(--q-cta-justify); margin-top: 1rem;">
              {% if s.cta_text != blank and s.cta_link != blank %}
                <a href="{{ s.cta_link | escape }}"
                   rel="noopener" aria-label="{{ s.cta_aria_label | default: s.cta_text | escape }}"
                   class="q-btn {{ btn_mode_class }}"
                   data-cta="primary">{{ s.cta_text }}</a>
              {% endif %}
              {% if s.cta2_text != blank and s.cta2_link != blank %}
                <a href="{{ s.cta2_link | escape }}"
                   rel="noopener" aria-label="{{ s.cta2_aria_label | default: s.cta2_text | escape }}"
                   class="q-btn {{ btn_mode_class }}"
                   data-cta="secondary">{{ s.cta2_text }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {%- if s.use_slideshow and s.show_dots and section.blocks.size > 1 -%}
      <div class="q-hero-dots" data-q-hero-dots>
        {%- for block in section.blocks -%}
          <button class="q-hero-dot" type="button" data-q-hero-dot data-index="{{ forloop.index0 }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                  aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <button type="button" class="q-hero-pause" data-classic-pause hidden aria-pressed="false">Pause background motion</button>
  </div>
</section>

<script src="{{ 'section-hero-classic.js' | asset_url }}" defer="defer"></script>

