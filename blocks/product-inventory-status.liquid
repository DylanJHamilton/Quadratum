{%- liquid
  assign block_id = 'product-inventory-status-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'center'
  assign layout_style = block.settings.layout_style | default: 'grid'
  assign desktop_columns = block.settings.desktop_columns | default: '4'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign badge_count = block.settings.badge_count | default: 4

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{% capture information_variants %}[
  {% assign information_separator = '' %}
  {% assign information_size = product_context.variants.size | default: 0 %}
  {% for information_index in (0..information_size) %}
    {% if information_index == 0 %}{% assign information_variant = current_variant %}{% else %}{% assign information_offset = information_index | minus: 1 %}{% assign information_variant = product_context.variants[information_offset] %}{% endif %}
    {% if information_variant != blank %}
      {% if information_index == 0 or information_variant.id != current_variant.id %}
        {{ information_separator }}{"id":{{ information_variant.id | json }},"values":{
          {% assign information_keys = 'sku,availability,weight,option_1,option_2,option_3,inventory' | split: ',' %}
          {% for information_key in information_keys %}{% capture information_value %}{% render 'qtm-product-information-value', source: information_key, variant: information_variant, block: block %}{% endcapture %}{{ information_key | json }}:{{ information_value | strip | json }}{% unless forloop.last %},{% endunless %}{% endfor %}
        }}{% assign information_separator = ',' %}
      {% endif %}
    {% endif %}
  {% endfor %}
]{% endcapture %}
{% if product_context != blank %}
<div
  id="{{ block_id }}"
  class="
    product-inventory-status
    product-inventory-status--{{ layout_style }}
    product-inventory-status--width-{{ block_width }}
    product-inventory-status--align-{{ alignment }}
    product-inventory-status--desktop-{{ desktop_columns }}
    product-inventory-status--mobile-{{ mobile_columns }}
    {% unless show_on_desktop or request.design_mode %} product-inventory-status--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} product-inventory-status--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} product-inventory-status--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-inventory-status--animate product-inventory-status--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-inventory-status-margin-top: {{ block.settings.margin_top }}px;
    --product-inventory-status-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-inventory-status-padding: {{ block.settings.padding }}px;
    --product-inventory-status-gap: {{ block.settings.gap }}px;
    --product-inventory-status-card-padding: {{ block.settings.card_padding }}px;
    --product-inventory-status-border-width: {{ block.settings.border_width }}px;
    --product-inventory-status-border-radius: {{ block.settings.border_radius }}px;
    --product-inventory-status-heading-color: {{ block.settings.heading_color }};
    --product-inventory-status-text-color: {{ block.settings.text_color }};
    --product-inventory-status-background-color: {{ block.settings.background_color }};
    --product-inventory-status-card-background-color: {{ block.settings.card_background_color }};
    --product-inventory-status-border-color: {{ block.settings.border_color }};
    --product-inventory-status-link-color: {{ block.settings.link_color }};
    --product-inventory-status-icon-color: {{ block.settings.icon_color }};
    --product-inventory-status-icon-background: {{ block.settings.icon_background_color }};
    --product-inventory-status-icon-size: {{ block.settings.icon_size }}px;
    --product-inventory-status-image-size: {{ block.settings.image_size }}px;
  "
  data-product-info
  data-variants="{{ information_variants | escape }}"
  data-unavailable-text="{{ block.settings.unavailable_text | escape }}"
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
>
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--product-inventory-status-margin-top);
      margin-bottom: var(--product-inventory-status-margin-bottom);
      padding: var(--product-inventory-status-padding);
      color: var(--product-inventory-status-text-color);
      background: var(--product-inventory-status-background-color);
    }

    #{{ block_id }}.product-inventory-status--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-inventory-status--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-inventory-status--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-inventory-status--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-inventory-status--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-inventory-status--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-inventory-status--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-inventory-status--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-inventory-status__items {
      width: 100%;
      min-width: 0;
      gap: var(--product-inventory-status-gap);
    }

    #{{ block_id }}.product-inventory-status--grid .product-inventory-status__items,
    #{{ block_id }}.product-inventory-status--cards .product-inventory-status__items,
    #{{ block_id }}.product-inventory-status--minimal .product-inventory-status__items {
      display: grid;
    }

    #{{ block_id }}.product-inventory-status--inline .product-inventory-status__items {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: flex-start;
    }

    #{{ block_id }}.product-inventory-status--align-center.product-inventory-status--inline .product-inventory-status__items {
      justify-content: center;
    }

    #{{ block_id }}.product-inventory-status--align-right.product-inventory-status--inline .product-inventory-status__items {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-inventory-status--desktop-1 .product-inventory-status__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.product-inventory-status--desktop-2 .product-inventory-status__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.product-inventory-status--desktop-3 .product-inventory-status__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.product-inventory-status--desktop-4 .product-inventory-status__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .product-inventory-status__item {
      min-width: 0;
      display: flex;
      gap: 14px;
      color: var(--product-inventory-status-text-color);
      background: transparent;
      border: 0 solid transparent;
      border-radius: var(--product-inventory-status-border-radius);
      padding: 0;
    }

    #{{ block_id }}.product-inventory-status--grid .product-inventory-status__item,
    #{{ block_id }}.product-inventory-status--cards .product-inventory-status__item {
      background: var(--product-inventory-status-card-background-color);
      border: var(--product-inventory-status-border-width) solid var(--product-inventory-status-border-color);
      padding: var(--product-inventory-status-card-padding);
    }

    #{{ block_id }}.product-inventory-status--cards .product-inventory-status__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.product-inventory-status--minimal .product-inventory-status__item {
      border-bottom: var(--product-inventory-status-border-width) solid var(--product-inventory-status-border-color);
      border-radius: 0;
      padding-bottom: var(--product-inventory-status-card-padding);
    }

    #{{ block_id }}.product-inventory-status--minimal .product-inventory-status__item:last-child {
      border-bottom: 0;
    }

    #{{ block_id }}.product-inventory-status--inline .product-inventory-status__item {
      flex: 0 1 auto;
      align-items: center;
      background: var(--product-inventory-status-card-background-color);
      border: var(--product-inventory-status-border-width) solid var(--product-inventory-status-border-color);
      padding: 12px 16px;
    }

    #{{ block_id }}.product-inventory-status--align-center .product-inventory-status__item {
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }

    #{{ block_id }}.product-inventory-status--align-left .product-inventory-status__item {
      align-items: flex-start;
      justify-content: flex-start;
    }

    #{{ block_id }}.product-inventory-status--align-right .product-inventory-status__item {
      align-items: flex-end;
      justify-content: flex-start;
    }

    #{{ block_id }}.product-inventory-status--inline.product-inventory-status--align-left .product-inventory-status__item,
    #{{ block_id }}.product-inventory-status--inline.product-inventory-status--align-center .product-inventory-status__item,
    #{{ block_id }}.product-inventory-status--inline.product-inventory-status--align-right .product-inventory-status__item {
      flex-direction: row;
    }

    #{{ block_id }} .product-inventory-status__visual {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--product-inventory-status-icon-size);
      height: var(--product-inventory-status-icon-size);
      flex: 0 0 var(--product-inventory-status-icon-size);
      color: var(--product-inventory-status-icon-color);
      background: var(--product-inventory-status-icon-background);
      border-radius: 999px;
      overflow: hidden;
      line-height: 1;
    }

    #{{ block_id }} .product-inventory-status__icon {
      font-size: calc(var(--product-inventory-status-icon-size) * 0.45);
      line-height: 1;
    }

    #{{ block_id }} .product-inventory-status__image {
      display: block;
      width: var(--product-inventory-status-image-size);
      height: var(--product-inventory-status-image-size);
      object-fit: contain;
    }

    #{{ block_id }} .product-inventory-status__content {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    #{{ block_id }} .product-inventory-status__heading {
      margin: 0;
      color: var(--product-inventory-status-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .product-inventory-status__text {
      color: var(--product-inventory-status-text-color);
      line-height: 1.55;
      opacity: 0.9;
    }

    #{{ block_id }} .product-inventory-status__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-inventory-status__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }}.product-inventory-status--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-inventory-status--animate-fade {
      animation-name: productInventoryStatusFade;
    }

    #{{ block_id }}.product-inventory-status--animate-fade_up {
      animation-name: productInventoryStatusFadeUp;
    }

    #{{ block_id }}.product-inventory-status--animate-fade_down {
      animation-name: productInventoryStatusFadeDown;
    }

    #{{ block_id }}.product-inventory-status--animate-fade_left {
      animation-name: productInventoryStatusFadeLeft;
    }

    #{{ block_id }}.product-inventory-status--animate-fade_right {
      animation-name: productInventoryStatusFadeRight;
    }

    #{{ block_id }}.product-inventory-status--animate-zoom {
      animation-name: productInventoryStatusZoom;
    }

    @keyframes productInventoryStatusFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productInventoryStatusFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productInventoryStatusFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productInventoryStatusFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productInventoryStatusFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productInventoryStatusZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-inventory-status--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-inventory-status--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-inventory-status--desktop-3 .product-inventory-status__items,
      #{{ block_id }}.product-inventory-status--desktop-4 .product-inventory-status__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-inventory-status--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-inventory-status--mobile-1 .product-inventory-status__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.product-inventory-status--mobile-2 .product-inventory-status__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.product-inventory-status--inline .product-inventory-status__items {
        display: grid;
      }

      #{{ block_id }} .product-inventory-status__item {
        padding: min(var(--product-inventory-status-card-padding), 22px);
      }

      #{{ block_id }}.product-inventory-status--inline .product-inventory-status__item {
        padding: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-inventory-status--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }

    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} img { max-width: 100%; }
    #{{ block_id }} a { color: var(--product-inventory-status-link-color); text-underline-offset: .2em; }
    #{{ block_id }} a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
{% unless show_on_desktop or request.design_mode %}@media (min-width: 990px) { #shopify-block-{{ block.id }} { display: none !important; } }{% endunless %}
{% unless show_on_tablet or request.design_mode %}@media (min-width: 750px) and (max-width: 989px) { #shopify-block-{{ block.id }} { display: none !important; } }{% endunless %}
{% unless show_on_mobile or request.design_mode %}@media (max-width: 749px) { #shopify-block-{{ block.id }} { display: none !important; } }{% endunless %}
    #{{ block_id }} .product-inventory-status__visual--image { width: var(--product-inventory-status-image-size); height: var(--product-inventory-status-image-size); flex-basis: var(--product-inventory-status-image-size); }
    #{{ block_id }}.product-inventory-status--inline .product-inventory-status__item { padding: var(--product-inventory-status-card-padding); max-width: 100%; }
    #{{ block_id }} .product-inventory-status__status { color: var(--product-inventory-status-heading-color); padding: var(--product-inventory-status-card-padding); border: var(--product-inventory-status-border-width) solid var(--product-inventory-status-border-color); border-radius: var(--product-inventory-status-border-radius); background: var(--product-inventory-status-card-background-color); margin: 0 0 var(--product-inventory-status-gap); }
  </style>

  {% if block.settings.show_inventory %}<p class="product-inventory-status__status" role="status" aria-live="polite"><span data-product-info-value data-info-key="inventory">{% capture stock_text %}{% render 'qtm-product-information-value', source: 'inventory', variant: current_variant, block: block %}{% endcapture %}{{ stock_text | strip | escape }}</span></p>{% endif %}
  <div class="product-inventory-status__items">
    {%- for index in (1..8) -%}
      {%- if index <= badge_count -%}
        {%- liquid
          assign icon_key = 'badge_' | append: index | append: '_icon'
          assign image_key = 'badge_' | append: index | append: '_image'
          assign image_alt_key = 'badge_' | append: index | append: '_image_alt'
          assign heading_key = 'badge_' | append: index | append: '_heading'
          assign text_key = 'badge_' | append: index | append: '_text'

          assign badge_icon = block.settings[icon_key]
          assign badge_image = block.settings[image_key]
          assign badge_image_alt = block.settings[image_alt_key] | default: badge_image.alt
          assign badge_heading = block.settings[heading_key]
          assign badge_text = block.settings[text_key]
        -%}

        {% if badge_heading != blank or badge_text != blank or badge_icon != blank or badge_image != blank %}
          <article class="product-inventory-status__item">
            {% if badge_image != blank or badge_icon != blank %}
              <div class="product-inventory-status__visual{% if badge_image != blank %} product-inventory-status__visual--image{% endif %}" aria-hidden="{% if badge_image != blank %}false{% else %}true{% endif %}">
                {% if badge_image != blank %}
                  {{
                    badge_image
                    | image_url: width: 240
                    | image_tag:
                      class: 'product-inventory-status__image',
                      loading: 'lazy',
                      alt: badge_image_alt
                  }}
                {% elsif badge_icon != blank %}
                  <span class="product-inventory-status__icon">
                    {{ badge_icon | escape }}
                  </span>
                {% endif %}
              </div>
            {% endif %}

            <div class="product-inventory-status__content">
              {% if badge_heading != blank %}
                <h3 class="product-inventory-status__heading">
                  {{ badge_heading | escape }}
                </h3>
              {% endif %}

              {% if badge_text != blank %}
                <div class="product-inventory-status__text">
                  {{ badge_text }}
                </div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>


{% elsif request.design_mode %}<p>Select a product to preview inventory status.</p>{% endif %}
{% schema %}
{
  "name": "Product inventory status",
  "settings": [
    {
      "type": "header",
      "content": "Inventory status"
    },
    {
      "type": "checkbox",
      "id": "show_inventory",
      "label": "Show inventory status",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock_count",
      "label": "Show tracked low-stock quantity",
      "default": false
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low-stock threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "Available label",
      "default": "Available"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold-out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "backorder_text",
      "label": "Backorder label",
      "default": "Available to order"
    },
    {
      "type": "text",
      "id": "low_stock_text",
      "label": "Low-stock label",
      "default": "[quantity] available",
      "info": "[quantity] is replaced only by actual tracked inventory."
    },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Invalid variant label",
      "default": "Unavailable"
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "range",
      "id": "badge_count",
      "label": "Number of badges",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "grid",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44
    },
