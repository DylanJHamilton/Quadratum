{% liquid
  assign main_menu = linklists[settings.desktop_menu]

  assign department_menu = blank
  assign category_menu = blank

  if section.settings.department_menu != blank
    assign department_menu = linklists[section.settings.department_menu]
  endif

  if department_menu == blank
    assign department_menu = main_menu
  endif

  if section.settings.category_menu != blank
    assign category_menu = linklists[section.settings.category_menu]
  endif

  assign header_layout = section.settings.header_layout | default: 'departments_left'
  assign header_width = section.settings.header_width | default: 'wide'
  assign sticky_mode = section.settings.sticky_mode | default: 'sticky_shadow'
  assign mobile_menu_style = section.settings.mobile_menu_style | default: 'department_first'

  assign search_display = section.settings.search_display | default: 'predictive'
  assign account_display = section.settings.account_display | default: 'icon_text'
  assign cart_display = section.settings.cart_display | default: 'icon_text'

  assign sticky_enabled = false
  assign sticky_shadow_enabled = false
  assign search_sticky_enabled = false

  if sticky_mode == 'sticky' or sticky_mode == 'sticky_shadow' or sticky_mode == 'search_sticky'
    assign sticky_enabled = true
  endif

  if sticky_mode == 'sticky_shadow'
    assign sticky_shadow_enabled = true
  endif

  if sticky_mode == 'search_sticky'
    assign search_sticky_enabled = true
  endif
%}

{{ 'header-five.css' | asset_url | stylesheet_tag }}

<div
  id="HeaderFive-{{ section.id }}"
  class="
    qtmHeaderFive
    qtmHeaderFive--layout-{{ header_layout }}
    qtmHeaderFive--width-{{ header_width }}
    qtmHeaderFive--sticky-{{ sticky_mode }}
    qtmHeaderFive--mobile-{{ mobile_menu_style }}
    {% if sticky_enabled %}qtmHeaderFive--sticky{% endif %}
    {% if sticky_shadow_enabled %}qtmHeaderFive--stickyShadow{% endif %}
    {% if search_sticky_enabled %}qtmHeaderFive--searchSticky{% endif %}
  "
  style="
    --qtm-h5-bg: {{ section.settings.header_bg }};
    --qtm-h5-text: {{ section.settings.header_text }};
    --qtm-h5-link: {{ section.settings.header_link }};
    --qtm-h5-link-hover: {{ section.settings.header_link_hover }};
    --qtm-h5-border: {{ section.settings.header_border }};
    --qtm-h5-utility-bg: {{ section.settings.utility_bg }};
    --qtm-h5-utility-text: {{ section.settings.utility_text_color }};
    --qtm-h5-search-bg: {{ section.settings.search_bg }};
    --qtm-h5-search-text: {{ section.settings.search_text }};
    --qtm-h5-search-border: {{ section.settings.search_border }};
    --qtm-h5-department-bg: {{ section.settings.department_bg }};
    --qtm-h5-department-text: {{ section.settings.department_text }};
    --qtm-h5-department-hover-bg: {{ section.settings.department_hover_bg }};
    --qtm-h5-menu-font-size: {{ section.settings.menu_font_size }}px;
    --qtm-h5-menu-font-weight: {{ section.settings.menu_font_weight }};
    --qtm-h5-utility-font-size: {{ section.settings.utility_font_size }}px;
    --qtm-h5-search-font-size: {{ section.settings.search_font_size }}px;
    --qtm-h5-padding-y: {{ section.settings.header_padding_y }}px;
    --qtm-h5-padding-x: {{ section.settings.header_padding_x }}px;
    --qtm-h5-row-gap: {{ section.settings.row_gap }}px;
    --qtm-h5-action-gap: {{ section.settings.action_gap }}px;
    --qtm-h5-category-gap: {{ section.settings.category_gap }}px;
    --qtm-h5-search-radius: {{ section.settings.search_radius }}px;
    --qtm-h5-button-radius: {{ section.settings.button_radius }}px;
    --qtm-h5-flyout-radius: {{ section.settings.flyout_radius }}px;
    --qtm-h5-logo-desktop: {{ section.settings.logo_height_desktop }}px;
    --qtm-h5-logo-mobile: {{ section.settings.logo_height_mobile }}px;
  "
  data-qtm-header-five
  data-sticky-mode="{{ sticky_mode }}"
>
  {% if section.settings.show_utility_bar %}
    {% render 'header-marketplace-utility-links',
      section_settings: section.settings,
      blocks: section.blocks
    %}
  {% endif %}

  <header class="qtmHeaderFive__header" aria-label="Marketplace header">
    <div class="qtmHeaderFive__commerceRow" data-qtm-h5-commerce-row>
      <div class="qtmHeaderFive__left">
        <button
          type="button"
          class="qtmHeaderFive__mobileMenuButton"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="HeaderFiveMobileDrawer-{{ section.id }}"
          data-qtm-h5-mobile-open
        >
          <span class="qtmHeaderFive__menuIcon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <a class="qtmHeaderFive__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if settings.logo_primary != blank %}
            <img
              class="qtmHeaderFive__logo"
              src="{{ settings.logo_primary | image_url: width: 620 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% elsif settings.logo_mobile != blank %}
            <img
              class="qtmHeaderFive__logo"
              src="{{ settings.logo_mobile | image_url: width: 620 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% else %}
            <span class="qtmHeaderFive__brandText">{{ shop.name }}</span>
          {% endif %}
        </a>

        {% if header_layout == 'departments_left' or header_layout == 'utility_dense' %}
          {% render 'header-marketplace-departments',
            menu: department_menu,
            section_id: section.id,
            section_settings: section.settings,
            blocks: section.blocks
          %}
        {% endif %}
      </div>

      <div class="qtmHeaderFive__searchWrap" data-qtm-h5-search-row>
        {% if search_display == 'inline_static' or search_display == 'predictive' %}
          <div class="qtmHeaderFive__search qtmHeaderFive__search--{{ search_display }}">
            {% render 'search-form-static',
              form_context: 'header-five',
              input_id: 'HeaderFiveSearchInput-' | append: section.id,
              placeholder: section.settings.search_placeholder,
              show_button: true
            %}
          </div>
        {% elsif search_display == 'popup' %}
          {% if settings.enable_search_popup %}
            <button
              type="button"
              class="qtmHeaderFive__searchButton"
              data-search-popup-open
              aria-label="Open search"
              aria-haspopup="dialog"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <span>Search products</span>
            </button>
          {% else %}
            <a class="qtmHeaderFive__searchButton" href="{{ routes.search_url }}" aria-label="Go to search page">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <span>Search products</span>
            </a>
          {% endif %}
        {% elsif search_display == 'page' %}
          <a class="qtmHeaderFive__searchButton" href="{{ routes.search_url }}" aria-label="Go to search page">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>Search products</span>
          </a>
        {% endif %}
      </div>

      <div class="qtmHeaderFive__actions">
        {% if section.settings.show_tracking_link and section.settings.tracking_url != blank %}
          <a class="qtmHeaderFive__action qtmHeaderFive__action--tracking" href="{{ section.settings.tracking_url }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7H14V17H4V7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M14 10H18L21 13V17H14V10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <circle cx="8" cy="18.5" r="1.5" fill="currentColor"/>
              <circle cx="17" cy="18.5" r="1.5" fill="currentColor"/>
            </svg>
            <span>{{ section.settings.tracking_label }}</span>
          </a>
        {% endif %}

        {% if section.settings.show_wishlist and section.settings.wishlist_url != blank %}
          <a class="qtmHeaderFive__action qtmHeaderFive__action--optional" href="{{ section.settings.wishlist_url }}">
            <span>Wishlist</span>
          </a>
        {% endif %}

        {% if section.settings.show_compare and section.settings.compare_url != blank %}
          <a class="qtmHeaderFive__action qtmHeaderFive__action--optional" href="{{ section.settings.compare_url }}">
            <span>Compare</span>
          </a>
        {% endif %}

        {% if section.settings.show_recently_viewed and section.settings.recently_viewed_url != blank %}
          <a class="qtmHeaderFive__action qtmHeaderFive__action--optional" href="{{ section.settings.recently_viewed_url }}">
            <span>Recent</span>
          </a>
        {% endif %}

        {% if section.settings.show_account %}
          <div class="qtmHeaderFive__account">
            <a
              class="qtmHeaderFive__action qtmHeaderFive__action--account qtmHeaderFive__action--{{ account_display }}"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="{% if customer %}Account{% else %}Sign in{% endif %}"
              aria-haspopup="true"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.7"/>
                <path d="M5 20C5.75 16.5 8.25 14.5 12 14.5C15.75 14.5 18.25 16.5 19 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
              <span>{% if customer %}Account{% else %}Sign In{% endif %}</span>
            </a>

            {% if customer %}
              <div class="qtmHeaderFive__accountDropdown">
                <a href="{{ routes.account_url }}">Account</a>
                <a href="{{ routes.account_url }}">Orders</a>
                <a href="{{ routes.account_addresses_url }}">Addresses</a>
                <a href="{{ routes.account_logout_url }}">Logout</a>
              </div>
            {% else %}
              <div class="qtmHeaderFive__accountDropdown">
                <a href="{{ routes.account_login_url }}">Sign In</a>
                <a href="{{ routes.account_register_url }}">Create Account</a>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.show_cart %}
          <button
            type="button"
            class="qtmHeaderFive__action qtmHeaderFive__action--cart qtmHeaderFive__action--{{ cart_display }}"
            data-cart-drawer-open
            aria-label="Open cart"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 7H21L19.5 15H8L6 7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M6 7L5.4 4.8C5.17 3.98 4.43 3.4 3.58 3.4H2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="9.5" cy="19" r="1.25" fill="currentColor"/>
              <circle cx="18" cy="19" r="1.25" fill="currentColor"/>
            </svg>

            <span class="qtmHeaderFive__cartLabel">
              Cart
              {% if section.settings.show_cart_subtotal %}
                <small>{{ cart.total_price | money }}</small>
              {% endif %}
            </span>

            <span class="qtmHeaderFive__cartCount" data-cart-count>{{ cart.item_count }}</span>
          </button>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_category_row and category_menu != blank %}
      <div class="qtmHeaderFive__categoryRow">
        <nav class="qtmHeaderFive__categoryNav" aria-label="Primary navigation">
          {% for link in category_menu.links %}
            <a
              class="qtmHeaderFive__categoryLink{% if link.active %} qtmHeaderFive__categoryLink--active{% endif %}"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>
          {% endfor %}
        </nav>
      </div>
    {% endif %}
  </header>

  {% render 'header-marketplace-category-drawer',
    section_id: section.id,
    section_settings: section.settings,
    department_menu: department_menu,
    category_menu: category_menu,
    blocks: section.blocks,
    customer: customer,
    cart: cart,
    search_display: search_display
  %}
</div>

<script src="{{ 'header-five.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header Five",
  "class": "qtm-header-five-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "default": "departments_left",
      "options": [
        { "value": "search_centered", "label": "Search centered" },
        { "value": "departments_left", "label": "Departments left" },
        { "value": "utility_dense", "label": "Utility dense" }
      ]
    },
    {
      "type": "select",
      "id": "header_width",
      "label": "Header width",
      "default": "wide",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky mode",
      "default": "sticky_shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sticky", "label": "Sticky" },
        { "value": "sticky_shadow", "label": "Sticky with shadow" },
        { "value": "search_sticky", "label": "Search sticky" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_menu_style",
      "label": "Mobile menu style",
      "default": "department_first",
      "options": [
        { "value": "drawer", "label": "Drawer" },
        { "value": "fullscreen", "label": "Fullscreen" },
        { "value": "department_first", "label": "Department first" }
      ]
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Desktop logo height",
      "min": 20,
      "max": 90,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Mobile logo height",
      "min": 18,
      "max": 64,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "select",
      "id": "search_display",
      "label": "Search display",
      "default": "predictive",
      "options": [
        { "value": "inline_static", "label": "Inline static" },
        { "value": "predictive", "label": "Predictive/search form" },
        { "value": "popup", "label": "Popup" },
        { "value": "page", "label": "Search page" }
      ]
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products, parts, brands, SKUs..."
    },
    {
      "type": "header",
      "content": "Departments"
    },
    {
      "type": "link_list",
      "id": "department_menu",
      "label": "Department menu"
    },
    {
      "type": "text",
      "id": "department_button_label",
      "label": "Department button label",
      "default": "All Departments"
    },
    {
      "type": "select",
      "id": "department_display",
      "label": "Department display",
      "default": "flyout",
      "options": [
        { "value": "flyout", "label": "Flyout" },
        { "value": "drawer", "label": "Drawer" },
        { "value": "dropdown", "label": "Dropdown" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_category_row",
      "label": "Show category row",
      "default": true
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category row menu"
    },
    {
      "type": "header",
      "content": "Utility bar"
    },
    {
      "type": "checkbox",
      "id": "show_utility_bar",
      "label": "Show utility bar",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_text",
      "label": "Utility text",
      "default": "Fast shipping, easy returns, and expert support"
    },
    {
      "type": "text",
      "id": "utility_link_label",
      "label": "Utility link label",
      "default": "Need help?"
    },
    {
      "type": "url",
      "id": "utility_link_url",
      "label": "Utility link URL"
    },
    {
      "type": "header",
      "content": "Tracking"
    },
    {
      "type": "checkbox",
      "id": "show_tracking_link",
      "label": "Show tracking link",
      "default": true
    },
    {
      "type": "text",
      "id": "tracking_label",
      "label": "Tracking label",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "tracking_url",
      "label": "Tracking URL"
    },
    {
      "type": "header",
      "content": "Account and cart"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "select",
      "id": "account_display",
      "label": "Account display",
      "default": "icon_text",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "text", "label": "Text" },
        { "value": "icon_text", "label": "Icon and text" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    },
    {
      "type": "select",
      "id": "cart_display",
      "label": "Cart display",
      "default": "icon_text",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "icon_text", "label": "Icon and text" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_cart_subtotal",
      "label": "Show cart subtotal",
      "default": true
    },
    {
      "type": "header",
      "content": "Optional utility links"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist placeholder",
      "default": false
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist URL"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare placeholder",
      "default": false
    },
    {
      "type": "url",
      "id": "compare_url",
      "label": "Compare URL"
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "Show recently viewed placeholder",
      "default": false
    },
    {
      "type": "url",
      "id": "recently_viewed_url",
      "label": "Recently viewed URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "header_link",
      "label": "Header links",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "header_link_hover",
      "label": "Header link hover",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Header border",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "utility_bg",
      "label": "Utility background",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "utility_text_color",
      "label": "Utility text color",
      "default": "#374151"
    },
    {
      "type": "color",
      "id": "search_bg",
      "label": "Search background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_text",
      "label": "Search text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "search_border",
      "label": "Search border",
      "default": "#cbd5e1"
    },
    {
      "type": "color",
      "id": "department_bg",
      "label": "Department background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "department_text",
      "label": "Department text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "department_hover_bg",
      "label": "Department hover background",
      "default": "#1f2937"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "menu_font_weight",
      "label": "Menu font weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "utility_font_size",
      "label": "Utility font size",
      "min": 11,
      "max": 16,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "search_font_size",
      "label": "Search font size",
      "min": 13,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "header_padding_y",
      "label": "Vertical padding",
      "min": 8,
      "max": 28,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_padding_x",
      "label": "Horizontal padding",
      "min": 12,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 6,
      "max": 28,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "action_gap",
      "label": "Action gap",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "category_gap",
      "label": "Category gap",
