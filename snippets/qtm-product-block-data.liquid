{%- comment -%}Explicit native purchase data, including a selected variant outside the enumerated list.{%- endcomment -%}
{%- capture less_than -%}\u003c{%- endcapture -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign separator = '' -%}
{%- capture variants_json -%}[
  {%- if selected_variant != blank -%}
    {%- render 'qtm-product-block-variant', product: product, variant: selected_variant, image_width: image_width -%}
    {%- assign separator = ',' -%}
  {%- endif -%}
  {%- for variant in product.variants -%}
    {%- unless variant.id == selected_variant.id -%}
      {{- separator -}}{%- render 'qtm-product-block-variant', product: product, variant: variant, image_width: image_width -%}
      {%- assign separator = ',' -%}
    {%- endunless -%}
  {%- endfor -%}
]{%- endcapture -%}
<script type="application/json" data-qtm-product-block-variants>{{ variants_json | replace: '<', less_than }}</script>
