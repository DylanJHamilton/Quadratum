{% comment %}
  Quadratum Account System
  Shared Account Navigation Snippet

  Purpose:
  - Reusable navigation for authenticated account pages
  - Supports sidebar, horizontal, and compact layouts
  - Uses native details/summary for compact mobile-friendly behavior
  - No account forms or account page logic included

  Recommended usage:

  {% render 'account-main-account-nav',
    active: 'orders',
    show_tracking: section.settings.show_tracking_link,
    tracking_url: section.settings.tracking_url,
    orders_url: section.settings.orders_page_url,
    layout: section.settings.account_nav_layout
  %}

  Supported active values:
  - dashboard
  - orders
  - addresses
  - tracking
{% endcomment %}

{{ 'account-main-account-nav.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign account_nav_active_item = active | default: 'dashboard'
  assign account_nav_layout = layout | default: 'sidebar'

  assign account_nav_orders_url = orders_url
  if account_nav_orders_url == blank
    assign account_nav_orders_url = routes.account_url | append: '?view=orders'
  endif

  assign account_nav_tracking_url = tracking_url
  assign account_nav_show_tracking = show_tracking | default: false


  assign account_nav_current_label = section.settings.dashboard_label | default: 'Dashboard'

  case account_nav_active_item
    when 'orders'
      assign account_nav_current_label = section.settings.orders_label | default: 'Orders'
    when 'addresses'
      assign account_nav_current_label = section.settings.addresses_label | default: 'Addresses'
    when 'tracking'
      assign account_nav_current_label = section.settings.tracking_label | default: 'Order Tracking'
    else
      assign account_nav_current_label = section.settings.dashboard_label | default: 'Dashboard'
  endcase
-%}

{% capture account_nav_links %}
    <ul class="qtmAccountNav__list" role="list">
      <li class="qtmAccountNav__item">
        <a
          href="{{ routes.account_url | escape }}"
          class="qtmAccountNav__link {% if account_nav_active_item == 'dashboard' %}qtmAccountNav__link--active{% endif %}"
          {% if account_nav_active_item == 'dashboard' %}
            aria-current="page"
          {% endif %}
        >
          <span class="qtmAccountNav__label">{{ section.settings.dashboard_label | default: 'Dashboard' | escape }}</span>
        </a>
      </li>

      <li class="qtmAccountNav__item">
        <a
          href="{{ account_nav_orders_url | escape }}"
          class="qtmAccountNav__link {% if account_nav_active_item == 'orders' %}qtmAccountNav__link--active{% endif %}"
          {% if account_nav_active_item == 'orders' %}
            aria-current="page"
          {% endif %}
        >
          <span class="qtmAccountNav__label">{{ section.settings.orders_label | default: 'Orders' | escape }}</span>
        </a>
      </li>

      <li class="qtmAccountNav__item">
        <a
          href="{{ routes.account_addresses_url | escape }}"
          class="qtmAccountNav__link {% if account_nav_active_item == 'addresses' %}qtmAccountNav__link--active{% endif %}"
          {% if account_nav_active_item == 'addresses' %}
            aria-current="page"
          {% endif %}
        >
          <span class="qtmAccountNav__label">{{ section.settings.addresses_label | default: 'Addresses' | escape }}</span>
        </a>
      </li>

      {% if account_nav_show_tracking and account_nav_tracking_url != blank %}
        <li class="qtmAccountNav__item">
          <a
            href="{{ account_nav_tracking_url | escape }}"
            class="qtmAccountNav__link {% if account_nav_active_item == 'tracking' %}qtmAccountNav__link--active{% endif %}"
            {% if account_nav_active_item == 'tracking' %}
              aria-current="page"
            {% endif %}
          >
            <span class="qtmAccountNav__label">{{ section.settings.tracking_label | default: 'Order Tracking' | escape }}</span>
          </a>
        </li>
      {% endif %}

      <li class="qtmAccountNav__item">
        <a
          href="{{ routes.account_logout_url | escape }}"
          class="qtmAccountNav__link qtmAccountNav__link--logout"
        >
          <span class="qtmAccountNav__label">{{ section.settings.logout_label | default: 'Logout' | escape }}</span>
        </a>
      </li>
    </ul>
{% endcapture %}

<nav
  class="
    qtmAccountNav
    qtmAccountNav--{{ account_nav_layout }}
  "
  aria-label="Account navigation"
>
  {% if account_nav_layout == 'compact' %}
    <details class="qtmAccountNav__details">
      <summary class="qtmAccountNav__summary">
        <span class="qtmAccountNav__summaryText">
          {{ account_nav_current_label | escape }}
        </span>

        <span class="qtmAccountNav__summaryIcon" aria-hidden="true">
          ↓
        </span>
      </summary>

      <div class="qtmAccountNav__compactPanel">
        {{ account_nav_links }}
      </div>
    </details>
  {% else %}
    {{ account_nav_links }}
  {% endif %}
</nav>
