{%- liquid
  assign block_id = 'product-specifications-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign block_width = block.settings.block_width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'table'
  assign spec_count = block.settings.spec_count | default: 6

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-specifications
    product-specifications--{{ layout_style }}
    product-specifications--width-{{ block_width }}
    product-specifications--align-{{ alignment }}
    {% unless show_on_desktop %} product-specifications--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-specifications--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-specifications--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-specifications--animate product-specifications--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-specifications-margin-top: {{ block.settings.margin_top }}px;
    --product-specifications-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-specifications-padding: {{ block.settings.padding }}px;
    --product-specifications-gap: {{ block.settings.gap }}px;
    --product-specifications-item-padding: {{ block.settings.item_padding }}px;
    --product-specifications-border-width: {{ block.settings.border_width }}px;
    --product-specifications-border-radius: {{ block.settings.border_radius }}px;
    --product-specifications-heading-color: {{ block.settings.heading_color }};
    --product-specifications-text-color: {{ block.settings.text_color }};
    --product-specifications-background-color: {{ block.settings.background_color }};
    --product-specifications-card-background-color: {{ block.settings.card_background_color }};
    --product-specifications-border-color: {{ block.settings.border_color }};
    --product-specifications-link-color: {{ block.settings.link_color }};
    --product-specifications-icon-color: {{ block.settings.icon_color }};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-specifications-margin-top);
      margin-bottom: var(--product-specifications-margin-bottom);
      padding: var(--product-specifications-padding);
      color: var(--product-specifications-text-color);
      background: var(--product-specifications-background-color);
    }

    #{{ block_id }}.product-specifications--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-specifications--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-specifications--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.product-specifications--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.product-specifications--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-specifications--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-specifications--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-specifications--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-specifications__inner {
      display: grid;
      gap: var(--product-specifications-gap);
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .product-specifications__header {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-specifications__heading {
      margin: 0;
      color: var(--product-specifications-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .product-specifications__text {
      color: var(--product-specifications-text-color);
      line-height: 1.6;
    }

    #{{ block_id }} .product-specifications__text p {
      margin-top: 0;
    }

    #{{ block_id }} .product-specifications__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-specifications__items {
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }}.product-specifications--table .product-specifications__items,
    #{{ block_id }}.product-specifications--minimal .product-specifications__items {
      display: grid;
      border: var(--product-specifications-border-width) solid var(--product-specifications-border-color);
      border-radius: var(--product-specifications-border-radius);
      overflow: hidden;
      background: var(--product-specifications-card-background-color);
    }

    #{{ block_id }}.product-specifications--minimal .product-specifications__items {
      border-left: 0;
      border-right: 0;
      border-radius: 0;
      background: transparent;
    }

    #{{ block_id }}.product-specifications--grid .product-specifications__items,
    #{{ block_id }}.product-specifications--cards .product-specifications__items {
      display: grid;
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
      gap: var(--product-specifications-gap);
    }

    #{{ block_id }} .product-specifications__item {
      min-width: 0;
      color: var(--product-specifications-text-color);
    }

    #{{ block_id }}.product-specifications--table .product-specifications__item,
    #{{ block_id }}.product-specifications--minimal .product-specifications__item {
      display: grid;
      grid-template-columns: minmax(140px, 0.38fr) minmax(0, 1fr);
      gap: 16px;
      align-items: center;
      padding: var(--product-specifications-item-padding);
      border-bottom: var(--product-specifications-border-width) solid var(--product-specifications-border-color);
    }

    #{{ block_id }}.product-specifications--table .product-specifications__item:last-child,
    #{{ block_id }}.product-specifications--minimal .product-specifications__item:last-child {
      border-bottom: 0;
    }

    #{{ block_id }}.product-specifications--grid .product-specifications__item,
    #{{ block_id }}.product-specifications--cards .product-specifications__item {
      display: grid;
      gap: 10px;
      padding: var(--product-specifications-item-padding);
      background: var(--product-specifications-card-background-color);
      border: var(--product-specifications-border-width) solid var(--product-specifications-border-color);
      border-radius: var(--product-specifications-border-radius);
    }

    #{{ block_id }}.product-specifications--cards .product-specifications__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .product-specifications__label-wrap {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }}.product-specifications--align-center .product-specifications__label-wrap {
      justify-content: center;
    }

    #{{ block_id }}.product-specifications--align-right .product-specifications__label-wrap {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-specifications__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      color: var(--product-specifications-icon-color);
      line-height: 1;
    }

    #{{ block_id }} .product-specifications__label {
      color: var(--product-specifications-heading-color);
      line-height: 1.3;
    }

    #{{ block_id }} .product-specifications__value {
      color: var(--product-specifications-text-color);
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    #{{ block_id }} .product-specifications__value a {
      color: var(--product-specifications-link-color);
      text-underline-offset: 0.2em;
    }

    #{{ block_id }}.product-specifications--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-specifications--animate-fade {
      animation-name: productSpecificationsFade;
    }

    #{{ block_id }}.product-specifications--animate-fade_up {
      animation-name: productSpecificationsFadeUp;
    }

    #{{ block_id }}.product-specifications--animate-fade_down {
      animation-name: productSpecificationsFadeDown;
    }

    #{{ block_id }}.product-specifications--animate-fade_left {
      animation-name: productSpecificationsFadeLeft;
    }

    #{{ block_id }}.product-specifications--animate-fade_right {
      animation-name: productSpecificationsFadeRight;
    }

    #{{ block_id }}.product-specifications--animate-zoom {
      animation-name: productSpecificationsZoom;
    }

    @keyframes productSpecificationsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productSpecificationsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productSpecificationsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productSpecificationsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productSpecificationsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productSpecificationsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-specifications--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-specifications--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-specifications--grid .product-specifications__items,
      #{{ block_id }}.product-specifications--cards .product-specifications__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-specifications--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-specifications--table .product-specifications__item,
      #{{ block_id }}.product-specifications--minimal .product-specifications__item {
        grid-template-columns: minmax(0, 1fr);
        gap: 6px;
      }

      #{{ block_id }}.product-specifications--grid .product-specifications__items,
      #{{ block_id }}.product-specifications--cards .product-specifications__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }} .product-specifications__item {
        padding: min(var(--product-specifications-item-padding), 22px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-specifications--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-specifications__inner">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="product-specifications__header">
        {% if block.settings.heading != blank %}
          <h3 class="product-specifications__heading">
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="product-specifications__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-specifications__items">
      {%- for index in (1..10) -%}
        {%- if index <= spec_count -%}
          {%- liquid
            assign icon_key = 'spec_' | append: index | append: '_icon'
            assign label_key = 'spec_' | append: index | append: '_label'
            assign value_key = 'spec_' | append: index | append: '_value'
            assign source_key = 'spec_' | append: index | append: '_value_source'

            assign spec_icon = block.settings[icon_key]
            assign spec_label = block.settings[label_key]
            assign spec_value = block.settings[value_key]
            assign spec_source = block.settings[source_key]

            assign resolved_value = spec_value

            if spec_source == 'sku'
              if current_variant.sku != blank
                assign resolved_value = current_variant.sku
              else
                assign resolved_value = ''
              endif
            endif

            if spec_source == 'vendor'
              assign resolved_value = product_context.vendor
            endif

            if spec_source == 'product_type'
              assign resolved_value = product_context.type
            endif

            if spec_source == 'availability'
              if current_variant.available
                assign resolved_value = 'In stock'
              else
                assign resolved_value = 'Out of stock'
              endif
            endif

            if spec_source == 'weight'
              if current_variant.weight > 0
                assign resolved_value = current_variant.weight | weight_with_unit
              else
                assign resolved_value = ''
              endif
            endif

            if spec_source == 'option_1'
              assign resolved_value = current_variant.option1
            endif

            if spec_source == 'option_2'
              assign resolved_value = current_variant.option2
            endif

            if spec_source == 'option_3'
              assign resolved_value = current_variant.option3
            endif
          -%}

          {% if spec_label != blank or resolved_value != blank %}
            <div class="product-specifications__item">
              <div class="product-specifications__label-wrap">
                {% if spec_icon != blank %}
                  <span class="product-specifications__icon" aria-hidden="true">
                    {{ spec_icon }}
                  </span>
                {% endif %}

                {% if spec_label != blank %}
                  <span class="product-specifications__label">
                    {{ spec_label | escape }}
                  </span>
                {% endif %}
              </div>

              {% if resolved_value != blank %}
                <div class="product-specifications__value">
                  {{ resolved_value }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product specifications",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product specifications"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Give shoppers the important details they need to compare, confirm fit, and buy with confidence.</p>"
    },
    {
      "type": "range",
      "id": "spec_count",
      "label": "Number of specifications",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 6
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "table",
      "options": [
        {
          "value": "table",
          "label": "Table"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "cards",
