{%- liquid
  assign block_id = 'product-sku-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign sku_style = block.settings.sku_style | default: 'standard'

  assign sku_value = current_variant.sku

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-sku
    product-sku--{{ sku_style }}
    product-sku--width-{{ width }}
    product-sku--align-{{ alignment }}
    {% if sku_value == blank and block.settings.hide_when_empty %} product-sku--empty{% endif %}
    {% unless show_on_desktop %} product-sku--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-sku--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-sku--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-sku--animate product-sku--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-sku-margin-top: {{ block.settings.margin_top }}px;
    --product-sku-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-sku-padding: {{ block.settings.padding }}px;
    --product-sku-font-size: {{ block.settings.font_size }}px;
    --product-sku-letter-spacing: {{ block.settings.letter_spacing }}px;
    --product-sku-text-color: {{ block.settings.text_color }};
    --product-sku-label-color: {{ block.settings.label_color }};
    --product-sku-background-color: {{ block.settings.background_color }};
    --product-sku-border-color: {{ block.settings.border_color }};
    --product-sku-border-width: {{ block.settings.border_width }}px;
    --product-sku-border-radius: {{ block.settings.border_radius }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-sku
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-sku-margin-top);
      margin-bottom: var(--product-sku-margin-bottom);
      padding: var(--product-sku-padding);
      color: var(--product-sku-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-sku--empty {
      display: none;
    }

    #{{ block_id }}.product-sku--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-sku--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-sku--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-sku--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-sku--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-sku--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-sku--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-sku--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-sku__inner {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 100%;
      color: var(--product-sku-text-color);
      font-size: var(--product-sku-font-size);
      line-height: 1.25;
      letter-spacing: var(--product-sku-letter-spacing);
    }

    #{{ block_id }}.product-sku--badge .product-sku__inner {
      padding: 7px 11px;
      background: var(--product-sku-background-color);
      border: var(--product-sku-border-width) solid var(--product-sku-border-color);
      border-radius: var(--product-sku-border-radius);
    }

    #{{ block_id }}.product-sku--compact .product-sku__inner {
      gap: 4px;
      font-size: calc(var(--product-sku-font-size) * 0.92);
      opacity: 0.86;
    }

    #{{ block_id }}.product-sku--minimal .product-sku__inner {
      opacity: 0.78;
    }

    #{{ block_id }} .product-sku__label {
      color: var(--product-sku-label-color);
      white-space: nowrap;
    }

    #{{ block_id }} .product-sku__value {
      color: var(--product-sku-text-color);
      overflow-wrap: anywhere;
    }

    #{{ block_id }}.product-sku--align-center .product-sku__inner {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-sku--align-right .product-sku__inner {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.product-sku--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-sku--animate-fade {
      animation-name: productSkuFade;
    }

    #{{ block_id }}.product-sku--animate-fade_up {
      animation-name: productSkuFadeUp;
    }

    #{{ block_id }}.product-sku--animate-fade_down {
      animation-name: productSkuFadeDown;
    }

    #{{ block_id }}.product-sku--animate-fade_left {
      animation-name: productSkuFadeLeft;
    }

    #{{ block_id }}.product-sku--animate-fade_right {
      animation-name: productSkuFadeRight;
    }

    #{{ block_id }}.product-sku--animate-zoom {
      animation-name: productSkuZoom;
    }

    @keyframes productSkuFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productSkuFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productSkuFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productSkuFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productSkuFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productSkuZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-sku--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-sku--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-sku--hide-mobile {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-sku--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-sku__inner">
    {% if block.settings.show_label and block.settings.label != blank %}
      <span class="product-sku__label">
        {{ block.settings.label | escape }}
      </span>
    {% endif %}

    <span class="product-sku__value" data-product-sku-value>
      {% if sku_value != blank %}
        {{ sku_value | escape }}
      {% else %}
        {{ block.settings.empty_text | escape }}
      {% endif %}
    </span>
  </div>

  <script type="application/json" data-product-sku-variants>
    {{ product_context.variants | json }}
  </script>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productSkuReady === 'true') return;

      root.dataset.productSkuReady = 'true';

      const valueEl = root.querySelector('[data-product-sku-value]');
      const variantsJson = root.querySelector('[data-product-sku-variants]');
      const emptyText = {{ block.settings.empty_text | json }};
      const hideWhenEmpty = {{ block.settings.hide_when_empty | json }};

      if (!valueEl || !variantsJson) return;

      let variants = [];

      try {
        variants = JSON.parse(variantsJson.textContent || '[]');
      } catch (error) {
        variants = [];
      }

      const updateSku = (variantId) => {
        if (!variantId) return;

        const variant = variants.find((item) => String(item.id) === String(variantId));

        if (!variant) return;

        const sku = variant.sku || '';

        valueEl.textContent = sku || emptyText || '';

        if (hideWhenEmpty) {
          root.classList.toggle('product-sku--empty', !sku);
        }

        root.dataset.variantId = String(variant.id);
      };

      document.addEventListener('variant:change', (event) => {
        const detail = event.detail || {};
        const variantId = detail.variantId || detail.variant_id || detail.id;

        updateSku(variantId);
      });

      document.addEventListener('product:variant-change', (event) => {
        const detail = event.detail || {};
        const variant = detail.variant || {};
        const variantId = variant.id || detail.variantId || detail.variant_id;

        updateSku(variantId);
      });

      document.addEventListener('qtm:variant:change', (event) => {
        const detail = event.detail || {};
        const variant = detail.variant || {};
        const variantId = variant.id || detail.variantId || detail.variant_id;

        updateSku(variantId);
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product SKU",
  "settings": [
    {
      "type": "header",
      "content": "SKU"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "SKU:"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty SKU text",
      "default": "Not available"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide block when SKU is empty",
      "default": false
    },
    {
      "type": "select",
      "id": "sku_style",
      "label": "SKU style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "SKU color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Badge background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Badge border",
      "default": "#e5e5e5"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 80
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard SKU",
      "settings": {
        "show_label": true,
        "label": "SKU:",
        "empty_text": "Not available",
        "hide_when_empty": false,
        "sku_style": "standard",
        "font_size": 14,
        "letter_spacing": 0,
        "text_color": "#111111",
        "label_color": "#666666",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Compact SKU",
      "settings": {
        "show_label": true,
        "label": "SKU",
        "empty_text": "N/A",
        "hide_when_empty": false,
        "sku_style": "compact",
        "font_size": 12,
        "letter_spacing": 0,
        "text_color": "#555555",
        "label_color": "#777777",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 8,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Label + SKU",
      "settings": {
        "show_label": true,
        "label": "Item number:",
        "empty_text": "Not available",
        "hide_when_empty": false,
        "sku_style": "badge",
        "font_size": 13,
        "letter_spacing": 0,
        "text_color": "#111111",
        "label_color": "#666666",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    }
  ]
}
{% endschema %}