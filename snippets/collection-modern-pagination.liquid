{%- liquid
  assign s = s
  assign current_page_text = paginate.current_page | append: ''
  assign style = pagination_style | default: 'numbered'
-%}

{%- if paginate.pages > 1 -%}
  <nav class="qcmPagination qcm__pagination" role="navigation" aria-label="Pagination">
    {%- if style == 'numbered' -%}
      <div class="qcmPagination__parts qcm__pager">
        {%- if paginate.previous -%}
          <a class="qcm__btn qcm__pageLink" href="{{ paginate.previous.url | escape }}" data-qcm-ajax-link aria-label="Previous page">Prev</a>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a class="qcm__btn qcm__pageLink" href="{{ part.url | escape }}" data-qcm-ajax-link aria-label="Page {{ part.title | escape }}">{{ part.title | escape }}</a>
          {%- else -%}
            <span class="qcm__btn qcm__pageLink" {% if part.title == current_page_text %}aria-current="page"{% endif %}>{{ part.title | escape }}</span>
          {%- endif -%}
        {%- endfor -%}

        {%- if paginate.next -%}
          <a class="qcm__btn qcm__pageLink" href="{{ paginate.next.url | escape }}" data-qcm-ajax-link aria-label="Next page">Next</a>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- if paginate.previous -%}<a class="qcm__btn qcm__pageLink" href="{{ paginate.previous.url | escape }}">Previous page</a>{%- endif -%}
      {%- if paginate.next -%}
        <div class="qcmPagination__parts qcm__pager">
          <a class="qcm__btn qcm__pageLink" href="{{ paginate.next.url | escape }}" data-qcm-loadmore>
            {{ s.load_more_label | default: 'Load more' }}
          </a>
        </div>

        {%- if style == 'infinite_scroll' -%}
          <div data-qcm-sentinel data-next-url="{{ paginate.next.url | escape }}" style="height:1px;"></div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    <span role="status" data-qcm-status></span>
  </nav>
{%- endif -%}