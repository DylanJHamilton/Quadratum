{%- liquid
  assign block_id = 'product-complementary-products-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign product_limit = block.settings.product_limit | default: 4
  assign layout_style = block.settings.layout_style | default: 'cards'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign rendered_products = 0
  assign recommendations_url = ''

  if product_context != blank
    assign recommendations_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product_context.id | append: '&limit=' | append: product_limit | append: '&intent=complementary'
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    product-complementary-products
    product-complementary-products--{{ layout_style }}
    product-complementary-products--width-{{ width }}
    product-complementary-products--align-{{ alignment }}
    {% unless show_on_desktop %} product-complementary-products--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-complementary-products--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-complementary-products--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-complementary-products--animate product-complementary-products--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-complementary-margin-top: {{ block.settings.margin_top }}px;
    --product-complementary-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-complementary-padding: {{ block.settings.padding }}px;
    --product-complementary-gap: {{ block.settings.grid_gap }}px;
    --product-complementary-card-padding: {{ block.settings.card_padding }}px;
    --product-complementary-radius: {{ block.settings.card_radius }}px;
    --product-complementary-border-width: {{ block.settings.border_width }}px;
    --product-complementary-columns-desktop: {{ block.settings.columns_desktop }};
    --product-complementary-columns-tablet: {{ block.settings.columns_tablet }};
    --product-complementary-columns-mobile: {{ block.settings.columns_mobile }};
    --product-complementary-image-ratio: {{ block.settings.image_ratio | divided_by: 100.0 }};
    --product-complementary-heading-color: {{ block.settings.heading_color }};
    --product-complementary-text-color: {{ block.settings.text_color }};
    --product-complementary-muted-color: {{ block.settings.muted_color }};
    --product-complementary-price-color: {{ block.settings.price_color }};
    --product-complementary-sale-color: {{ block.settings.sale_color }};
    --product-complementary-background: {{ block.settings.background_color }};
    --product-complementary-card-background: {{ block.settings.card_background_color }};
    --product-complementary-border-color: {{ block.settings.border_color }};
    --product-complementary-button-background: {{ block.settings.button_background_color }};
    --product-complementary-button-text: {{ block.settings.button_text_color }};
    --product-complementary-arrow-background: {{ block.settings.arrow_background_color }};
    --product-complementary-arrow-text: {{ block.settings.arrow_text_color }};
    --product-complementary-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-complementary-products
  data-recommendations-url="{{ recommendations_url }}"
  data-dynamic-recommendations="{{ block.settings.enable_shopify_recommendations }}"
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-complementary-margin-top);
      margin-bottom: var(--product-complementary-margin-bottom);
      padding: var(--product-complementary-padding);
      color: var(--product-complementary-text-color);
      background: var(--product-complementary-background);
    }

    #{{ block_id }}.product-complementary-products--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-complementary-products--width-small {
      max-width: 900px;
    }

    #{{ block_id }}.product-complementary-products--width-medium {
      max-width: 1100px;
    }

    #{{ block_id }}.product-complementary-products--width-large {
      max-width: 1320px;
    }

    #{{ block_id }}.product-complementary-products--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-complementary-products--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-complementary-products--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-complementary-products--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-complementary-products__inner {
      display: grid;
      gap: 22px;
      min-width: 0;
    }

    #{{ block_id }} .product-complementary-products__header-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      min-width: 0;
    }

    #{{ block_id }}.product-complementary-products--align-center .product-complementary-products__header-row {
      display: grid;
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }} .product-complementary-products__header {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    #{{ block_id }} .product-complementary-products__eyebrow {
      margin: 0;
      color: var(--product-complementary-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-complementary-products__heading {
      margin: 0;
      color: var(--product-complementary-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.1;
    }

    #{{ block_id }} .product-complementary-products__description {
      margin: 0;
      color: var(--product-complementary-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-complementary-products__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    #{{ block_id }} .product-complementary-products__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--product-complementary-arrow-text);
      background: var(--product-complementary-arrow-background);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1;
      font: inherit;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-complementary-products__arrow:hover {
      opacity: 0.84;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-complementary-products__arrow[disabled] {
      cursor: not-allowed;
      opacity: 0.38;
      transform: none;
    }

    #{{ block_id }} .product-complementary-products__arrow:focus-visible {
      outline: 2px solid var(--product-complementary-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-complementary-products__items {
      display: grid;
      grid-template-columns: repeat(var(--product-complementary-columns-desktop), minmax(0, 1fr));
      gap: var(--product-complementary-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-complementary-products--carousel .product-complementary-products__items {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    #{{ block_id }}.product-complementary-products--carousel .product-complementary-products__items::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }}.product-complementary-products--carousel .product-complementary-products__item {
      flex: 0 0 calc((100% - (var(--product-complementary-gap) * (var(--product-complementary-columns-desktop) - 1))) / var(--product-complementary-columns-desktop));
      min-width: 0;
      scroll-snap-align: start;
    }

    #{{ block_id }} .product-complementary-products__card {
      position: relative;
      display: grid;
      gap: 12px;
      height: 100%;
      min-width: 0;
      color: var(--product-complementary-text-color);
      text-decoration: none;
      padding: var(--product-complementary-card-padding);
      background: var(--product-complementary-card-background);
      border: var(--product-complementary-border-width) solid var(--product-complementary-border-color);
      border-radius: var(--product-complementary-radius);
      overflow: hidden;
    }

    #{{ block_id }}.product-complementary-products--grid .product-complementary-products__card {
      gap: 12px;
    }

    #{{ block_id }}.product-complementary-products--cards .product-complementary-products__card {
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .product-complementary-products__media {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: max(calc(var(--product-complementary-radius) - 8px), 8px);
      aspect-ratio: var(--product-complementary-image-ratio);
    }

    #{{ block_id }} .product-complementary-products__media img,
    #{{ block_id }} .product-complementary-products__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      transition: transform 300ms ease;
    }

    #{{ block_id }} .product-complementary-products__card:hover .product-complementary-products__media img {
      transform: scale(1.035);
    }

    #{{ block_id }} .product-complementary-products__placeholder {
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.1));
    }

    #{{ block_id }} .product-complementary-products__badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 9px;
      color: #ffffff;
      background: var(--product-complementary-sale-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1.2;
    }

    #{{ block_id }} .product-complementary-products__content {
      display: grid;
      gap: 7px;
      min-width: 0;
    }

    #{{ block_id }}.product-complementary-products--align-center .product-complementary-products__content {
      justify-items: center;
      text-align: center;
    }

    #{{ block_id }}.product-complementary-products--align-right .product-complementary-products__content {
      justify-items: end;
      text-align: right;
    }

    #{{ block_id }} .product-complementary-products__vendor {
      color: var(--product-complementary-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-complementary-products__title {
      margin: 0;
      color: var(--product-complementary-heading-color);
      font-size: {{ block.settings.product_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-complementary-products__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ block_id }} .product-complementary-products__title a:hover {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    #{{ block_id }} .product-complementary-products__price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 7px;
      color: var(--product-complementary-price-color);
      line-height: 1.25;
    }

    #{{ block_id }}.product-complementary-products--align-center .product-complementary-products__price-row {
      justify-content: center;
    }

    #{{ block_id }}.product-complementary-products--align-right .product-complementary-products__price-row {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-complementary-products__price {
      color: var(--product-complementary-price-color);
      font-weight: 800;
    }

    #{{ block_id }} .product-complementary-products__compare {
      color: var(--product-complementary-muted-color);
      text-decoration: line-through;
      opacity: 0.72;
    }

    #{{ block_id }} .product-complementary-products__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 40px;
      margin-top: 4px;
      padding: 10px 14px;
      color: var(--product-complementary-button-text);
      background: var(--product-complementary-button-background);
      border: 1px solid var(--product-complementary-button-background);
      border-radius: max(calc(var(--product-complementary-radius) - 10px), 6px);
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 700;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-complementary-products__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-complementary-products__media:focus-visible,
    #{{ block_id }} .product-complementary-products__title a:focus-visible,
    #{{ block_id }} .product-complementary-products__button:focus-visible {
      outline: 2px solid var(--product-complementary-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-complementary-products__empty {
      padding: 18px;
      color: var(--product-complementary-text-color);
      background: var(--product-complementary-card-background);
      border: var(--product-complementary-border-width) solid var(--product-complementary-border-color);
      border-radius: var(--product-complementary-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-complementary-products--is-loading .product-complementary-products__items {
      opacity: 0.45;
      pointer-events: none;
    }

    #{{ block_id }}.product-complementary-products--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-complementary-products--animate-fade {
      animation-name: productComplementaryProductsFade;
    }

    #{{ block_id }}.product-complementary-products--animate-fade_up {
      animation-name: productComplementaryProductsFadeUp;
    }

    #{{ block_id }}.product-complementary-products--animate-zoom {
      animation-name: productComplementaryProductsZoom;
    }

    @keyframes productComplementaryProductsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productComplementaryProductsFadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productComplementaryProductsZoom {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-complementary-products--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-complementary-products--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .product-complementary-products__items {
        grid-template-columns: repeat(var(--product-complementary-columns-tablet), minmax(0, 1fr));
      }

      #{{ block_id }}.product-complementary-products--carousel .product-complementary-products__item {
        flex-basis: calc((100% - (var(--product-complementary-gap) * (var(--product-complementary-columns-tablet) - 1))) / var(--product-complementary-columns-tablet));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-complementary-products--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-complementary-products__header-row {
        display: grid;
        gap: 14px;
      }

      #{{ block_id }} .product-complementary-products__items {
        grid-template-columns: repeat(var(--product-complementary-columns-mobile), minmax(0, 1fr));
      }

      #{{ block_id }}.product-complementary-products--carousel .product-complementary-products__item {
        flex-basis: calc((100% - (var(--product-complementary-gap) * (var(--product-complementary-columns-mobile) - 1))) / var(--product-complementary-columns-mobile));
      }

      #{{ block_id }} .product-complementary-products__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-complementary-products__controls {
        {% if block.settings.show_mobile_arrows %}
          display: flex;
        {% else %}
          display: none;
        {% endif %}
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-complementary-products--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }}.product-complementary-products--carousel .product-complementary-products__items {
        scroll-behavior: auto;
      }

      #{{ block_id }} .product-complementary-products__media img,
      #{{ block_id }} .product-complementary-products__button,
      #{{ block_id }} .product-complementary-products__arrow {
        transition: none;
      }

      #{{ block_id }} .product-complementary-products__card:hover .product-complementary-products__media img,
      #{{ block_id }} .product-complementary-products__button:hover,
      #{{ block_id }} .product-complementary-products__arrow:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-complementary-products__inner">
    {% if block.settings.show_header %}
      <div class="product-complementary-products__header-row">
        <div class="product-complementary-products__header">
          {% if block.settings.eyebrow != blank %}
            <p class="product-complementary-products__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="product-complementary-products__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="product-complementary-products__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>

        {% if layout_style == 'carousel' and block.settings.show_arrows %}
          <div class="product-complementary-products__controls">
            <button
              type="button"
              class="product-complementary-products__arrow"
              data-product-complementary-products-prev
              aria-label="{{ block.settings.previous_label | escape }}"
            >
              ‹
            </button>

            <button
              type="button"
              class="product-complementary-products__arrow"
              data-product-complementary-products-next
              aria-label="{{ block.settings.next_label | escape }}"
            >
              ›
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="product-complementary-products__items"
      data-product-complementary-products-items
      aria-label="{{ block.settings.complementary_products_label | escape }}"
      {% if layout_style == 'carousel' %}tabindex="0"{% endif %}
    >
      {% if block.settings.enable_shopify_recommendations and recommendations.performed and recommendations.products_count > 0 %}
        {% for complementary_product in recommendations.products limit: product_limit %}
          {% unless product_context != blank and complementary_product.id == product_context.id %}
            {%- liquid
              assign rendered_products = rendered_products | plus: 1
              assign complementary_variant = complementary_product.selected_or_first_available_variant
              assign is_on_sale = false
              assign image_alt = complementary_product.title

              if complementary_product.featured_image.alt != blank
                assign image_alt = complementary_product.featured_image.alt
              endif

              if complementary_variant.compare_at_price > complementary_variant.price
                assign is_on_sale = true
              endif
            -%}

            <article class="product-complementary-products__item" data-product-complementary-products-item>
              <div class="product-complementary-products__card">
                <a class="product-complementary-products__media" href="{{ complementary_product.url }}" aria-label="{{ complementary_product.title | escape }}">
                  {% if complementary_product.featured_image %}
                    {% if rendered_products == 1 %}
                      {{ complementary_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                    {% else %}
                      {{ complementary_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                    {% endif %}
                  {% else %}
                    <span class="product-complementary-products__placeholder" aria-hidden="true"></span>
                  {% endif %}

                  {% if block.settings.show_sale_badge and is_on_sale %}
                    <span class="product-complementary-products__badge">
                      {{ block.settings.sale_badge_text | escape }}
                    </span>
                  {% endif %}
                </a>

                <div class="product-complementary-products__content">
                  {% if block.settings.show_vendor and complementary_product.vendor != blank %}
                    <div class="product-complementary-products__vendor">
                      {{ complementary_product.vendor | escape }}
                    </div>
                  {% endif %}

                  <h3 class="product-complementary-products__title">
                    <a href="{{ complementary_product.url }}">
                      {{ complementary_product.title | escape }}
                    </a>
                  </h3>

                  {% if block.settings.show_price %}
                    <div class="product-complementary-products__price-row">
                      <span class="product-complementary-products__price">
                        {{ complementary_variant.price | money }}
                      </span>

                      {% if is_on_sale %}
                        <span class="product-complementary-products__compare">
                          {{ complementary_variant.compare_at_price | money }}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.show_button %}
                    <a class="product-complementary-products__button" href="{{ complementary_product.url }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if rendered_products == 0 %}
        {% for complementary_product in block.settings.products limit: product_limit %}
          {% if complementary_product != blank %}
            {% unless product_context != blank and complementary_product.id == product_context.id %}
              {%- liquid
                assign rendered_products = rendered_products | plus: 1
                assign complementary_variant = complementary_product.selected_or_first_available_variant
                assign is_on_sale = false
                assign image_alt = complementary_product.title

                if complementary_product.featured_image.alt != blank
                  assign image_alt = complementary_product.featured_image.alt
                endif

                if complementary_variant.compare_at_price > complementary_variant.price
                  assign is_on_sale = true
                endif
              -%}

              <article class="product-complementary-products__item" data-product-complementary-products-item>
                <div class="product-complementary-products__card">
                  <a class="product-complementary-products__media" href="{{ complementary_product.url }}" aria-label="{{ complementary_product.title | escape }}">
                    {% if complementary_product.featured_image %}
                      {% if forloop.first %}
                        {{ complementary_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% else %}
                        {{ complementary_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 360, 480, 640, 800, 900', alt: image_alt }}
                      {% endif %}
                    {% else %}
                      <span class="product-complementary-products__placeholder" aria-hidden="true"></span>
                    {% endif %}

                    {% if block.settings.show_sale_badge and is_on_sale %}
                      <span class="product-complementary-products__badge">
                        {{ block.settings.sale_badge_text | escape }}
                      </span>
                    {% endif %}
                  </a>

                  <div class="product-complementary-products__content">
                    {% if block.settings.show_vendor and complementary_product.vendor != blank %}
                      <div class="product-complementary-products__vendor">
                        {{ complementary_product.vendor | escape }}
                      </div>
                    {% endif %}

                    <h3 class="product-complementary-products__title">
                      <a href="{{ complementary_product.url }}">
                        {{ complementary_product.title | escape }}
                      </a>
                    </h3>

                    {% if block.settings.show_price %}
                      <div class="product-complementary-products__price-row">
                        <span class="product-complementary-products__price">
                          {{ complementary_variant.price | money }}
                        </span>

                        {% if is_on_sale %}
                          <span class="product-complementary-products__compare">
                            {{ complementary_variant.compare_at_price | money }}
                          </span>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if block.settings.show_button %}
                      <a class="product-complementary-products__button" href="{{ complementary_product.url }}">
                        {{ block.settings.button_label | escape }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_products == 0 and block.settings.show_empty_state %}
      <div class="product-complementary-products__empty" data-product-complementary-products-empty>
        {{ block.settings.empty_text | escape }}
      </div>
    {% endif %}
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productComplementaryProductsReady === 'true') return;

      root.dataset.productComplementaryProductsReady = 'true';

      const items = root.querySelector('[data-product-complementary-products-items]');
      const previousButton = root.querySelector('[data-product-complementary-products-prev]');
      const nextButton = root.querySelector('[data-product-complementary-products-next]');
      const emptyState = root.querySelector('[data-product-complementary-products-empty]');

      if (!items) return;

      const hydrateRecommendations = async () => {
        const url = root.dataset.recommendationsUrl;

        if (root.dataset.dynamicRecommendations !== 'true') return;
        if (!url) return;
        if (items.children.length > 0) return;

        root.classList.add('product-complementary-products--is-loading');

        try {
          const response = await fetch(url);

          if (!response.ok) return;

          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const incomingRoot = doc.querySelector(`#${CSS.escape(root.id)}`);
          const incomingItems = incomingRoot ? incomingRoot.querySelector('[data-product-complementary-products-items]') : null;

          if (incomingItems && incomingItems.children.length > 0) {
            items.innerHTML = incomingItems.innerHTML;

            if (emptyState) {
              emptyState.hidden = true;
            }
          }
        } catch (error) {
          return;
        } finally {
          root.classList.remove('product-complementary-products--is-loading');
          updateControls();
        }
      };

      const updateControls = () => {
        if (!previousButton && !nextButton) return;

        const maxScroll = items.scrollWidth - items.clientWidth - 2;

        if (previousButton) {
          previousButton.disabled = items.scrollLeft <= 2;
        }

        if (nextButton) {
          nextButton.disabled = items.scrollLeft >= maxScroll;
        }
      };

      const scrollCarousel = (direction) => {
        const firstItem = items.querySelector('[data-product-complementary-products-item]');
        const amount = firstItem ? firstItem.getBoundingClientRect().width + 20 : items.clientWidth * 0.8;

        items.scrollBy({
          left: amount * direction,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      };

      if (previousButton) {
        previousButton.addEventListener('click', () => scrollCarousel(-1));
      }

      if (nextButton) {
        nextButton.addEventListener('click', () => scrollCarousel(1));
      }

      items.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateControls);
      }, { passive: true });

      items.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          scrollCarousel(-1);
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          scrollCarousel(1);
        }
      });

      window.addEventListener('resize', updateControls, { passive: true });

      hydrateRecommendations();
      updateControls();
    })();
  </script>
</div>

