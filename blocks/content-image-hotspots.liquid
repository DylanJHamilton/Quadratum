{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation

  assign has_image = false
  if block.settings.image != blank
    assign has_image = true
  endif
%}

<div
  class="
    qtm-image-hotspots
    qtm-image-hotspots-{{ block_id }}
    qtm-image-hotspots--width-{{ block_width }}
    qtm-image-hotspots--align-{{ block_alignment }}
    qtm-image-hotspots--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-image-hotspots--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-image-hotspots--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-image-hotspots--hide-mobile{% endunless %}
  "
  style="
    --qtm-hotspots-margin-top: {{ block.settings.margin_top }}px;
    --qtm-hotspots-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-hotspots-padding: {{ block.settings.padding }}px;
    --qtm-hotspots-gap: {{ block.settings.gap }}px;
    --qtm-hotspots-heading-color: {{ block.settings.heading_color }};
    --qtm-hotspots-text-color: {{ block.settings.text_color }};
    --qtm-hotspots-background-color: {{ block.settings.background_color }};
    --qtm-hotspots-border-color: {{ block.settings.border_color }};
    --qtm-hotspots-link-color: {{ block.settings.link_color }};
    --qtm-hotspots-border-width: {{ block.settings.border_width }}px;
    --qtm-hotspots-border-radius: {{ block.settings.border_radius }}px;
    --qtm-hotspots-hotspot-color: {{ block.settings.hotspot_color }};
    --qtm-hotspots-hotspot-text-color: {{ block.settings.hotspot_text_color }};
    --qtm-hotspots-tooltip-bg: {{ block.settings.tooltip_background_color }};
    --qtm-hotspots-tooltip-text: {{ block.settings.tooltip_text_color }};
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-image-hotspots__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-image-hotspots__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-image-hotspots__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-image-hotspots__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-image-hotspots__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-image-hotspots__media-wrap">
      {% if has_image %}
        {{
          block.settings.image
          | image_url: width: 2200
          | image_tag:
            class: 'qtm-image-hotspots__image',
            loading: 'lazy',
            widths: '375, 550, 750, 950, 1200, 1600, 2200',
            sizes: '(min-width: 990px) 900px, 100vw',
            alt: block.settings.image.alt
        }}

        {% for i in (1..6) %}
          {% liquid
            assign enabled_key = 'hotspot_' | append: i | append: '_enabled'
            assign x_key = 'hotspot_' | append: i | append: '_x'
            assign y_key = 'hotspot_' | append: i | append: '_y'
            assign label_key = 'hotspot_' | append: i | append: '_label'
            assign heading_key = 'hotspot_' | append: i | append: '_heading'
            assign text_key = 'hotspot_' | append: i | append: '_text'
            assign product_key = 'hotspot_' | append: i | append: '_product'
            assign collection_key = 'hotspot_' | append: i | append: '_collection'
            assign custom_url_key = 'hotspot_' | append: i | append: '_custom_url'
            assign cta_key = 'hotspot_' | append: i | append: '_cta_text'

            assign hotspot_enabled = block.settings[enabled_key]
            assign hotspot_x = block.settings[x_key]
            assign hotspot_y = block.settings[y_key]
            assign hotspot_label = block.settings[label_key]
            assign hotspot_heading = block.settings[heading_key]
            assign hotspot_text = block.settings[text_key]
            assign hotspot_product = block.settings[product_key]
            assign hotspot_collection = block.settings[collection_key]
            assign hotspot_custom_url = block.settings[custom_url_key]
            assign hotspot_cta = block.settings[cta_key]

            assign hotspot_url = blank
            assign hotspot_link_label = hotspot_cta

            if hotspot_custom_url != blank
              assign hotspot_url = hotspot_custom_url
            elsif hotspot_product != blank
              assign hotspot_url = hotspot_product.url
              if hotspot_link_label == blank
                assign hotspot_link_label = 'View product'
              endif
            elsif hotspot_collection != blank
              assign hotspot_url = hotspot_collection.url
              if hotspot_link_label == blank
                assign hotspot_link_label = 'View collection'
              endif
            endif

            if hotspot_link_label == blank
              assign hotspot_link_label = 'Learn more'
            endif
          %}

          {% if hotspot_enabled %}
            <details
              class="qtm-image-hotspots__hotspot"
              style="
                --qtm-hotspot-x: {{ hotspot_x }}%;
                --qtm-hotspot-y: {{ hotspot_y }}%;
              "
            >
              <summary
                class="qtm-image-hotspots__trigger"
                aria-label="{% if hotspot_heading != blank %}{{ hotspot_heading | escape }}{% else %}Hotspot {{ i }}{% endif %}"
              >
                <span class="qtm-image-hotspots__trigger-inner">
                  {% if block.settings.hotspot_style == 'number' %}
                    {{ hotspot_label | default: i }}
                  {% elsif block.settings.hotspot_style == 'plus' %}
                    +
                  {% else %}
                    <span class="qtm-image-hotspots__dot" aria-hidden="true"></span>
                  {% endif %}
                </span>
              </summary>

              <div class="qtm-image-hotspots__tooltip" role="group">
                {% if hotspot_product != blank and block.settings.show_product_preview %}
                  <a class="qtm-image-hotspots__product-preview" href="{{ hotspot_product.url }}">
                    {% if hotspot_product.featured_image != blank %}
                      {{
                        hotspot_product.featured_image
                        | image_url: width: 240
                        | image_tag:
                          class: 'qtm-image-hotspots__product-image',
                          loading: 'lazy',
                          widths: '120, 180, 240',
                          sizes: '120px',
                          alt: hotspot_product.featured_image.alt
                      }}
                    {% endif %}

                    <span class="qtm-image-hotspots__product-content">
                      <span class="qtm-image-hotspots__product-title">
                        {{ hotspot_product.title | escape }}
                      </span>

                      {% if block.settings.show_product_price %}
                        <span class="qtm-image-hotspots__product-price">
                          {{ hotspot_product.price | money }}
                        </span>
                      {% endif %}
                    </span>
                  </a>
                {% endif %}

                {% if hotspot_heading != blank %}
                  <h3 class="qtm-image-hotspots__tooltip-heading">
                    {{ hotspot_heading | escape }}
                  </h3>
                {% endif %}

                {% if hotspot_text != blank %}
                  <div class="qtm-image-hotspots__tooltip-text">
                    {{ hotspot_text }}
                  </div>
                {% endif %}

                {% if hotspot_url != blank %}
                  <a class="qtm-image-hotspots__tooltip-link" href="{{ hotspot_url }}">
                    {{ hotspot_link_label | escape }}
                  </a>
                {% endif %}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="qtm-image-hotspots__placeholder">
          {{ 'image' | placeholder_svg_tag: 'qtm-image-hotspots__placeholder-svg' }}
          <div class="qtm-image-hotspots__placeholder-content">
            <strong>Add an image</strong>
            <span>Use this block to create a shoppable image, product tour, or interactive feature map.</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-image-hotspots-{{ block_id }} {
    margin-top: var(--qtm-hotspots-margin-top);
    margin-bottom: var(--qtm-hotspots-margin-bottom);
    padding: var(--qtm-hotspots-padding);
    color: var(--qtm-hotspots-text-color);
    background: var(--qtm-hotspots-background-color);
    border: var(--qtm-hotspots-border-width) solid var(--qtm-hotspots-border-color);
    border-radius: var(--qtm-hotspots-border-radius);
  }

  .qtm-image-hotspots-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--width-auto {
    width: auto;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--width-small {
    max-width: 640px;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--width-medium {
    max-width: 880px;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--width-large {
    max-width: 1120px;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__inner {
    display: grid;
    gap: var(--qtm-hotspots-gap);
    width: 100%;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__header {
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--align-center .qtm-image-hotspots__header {
    margin-inline: auto;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--align-right .qtm-image-hotspots__header {
    margin-left: auto;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__eyebrow {
    margin: 0;
    color: var(--qtm-hotspots-link-color);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__heading {
    margin: 0;
    color: var(--qtm-hotspots-heading-color);
    line-height: 1.05;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__text {
    color: var(--qtm-hotspots-text-color);
    line-height: 1.7;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__text p {
    margin-top: 0;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__media-wrap {
    position: relative;
    overflow: visible;
    width: 100%;
    border-radius: calc(var(--qtm-hotspots-border-radius) * 0.85);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--qtm-hotspots-border-radius) * 0.85);
    object-fit: cover;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__hotspot {
    position: absolute;
    left: var(--qtm-hotspot-x);
    top: var(--qtm-hotspot-y);
    z-index: 3;
    transform: translate(-50%, -50%);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__hotspot[open] {
    z-index: 10;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--qtm-hotspots-hotspot-text-color);
    list-style: none;
    cursor: pointer;
    border-radius: 999px;
    outline: none;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger::-webkit-details-marker {
    display: none;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--qtm-hotspots-hotspot-color);
    opacity: 0.28;
    transform: scale(1);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger-inner {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--qtm-hotspots-hotspot-text-color);
    background: var(--qtm-hotspots-hotspot-color);
    border: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.18);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__dot {
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    border-radius: 999px;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger:hover .qtm-image-hotspots__trigger-inner,
  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger:focus-visible .qtm-image-hotspots__trigger-inner {
    transform: scale(1.08);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.24);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--qtm-hotspots-hotspot-color), #ffffff 35%);
    outline-offset: 4px;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.85rem);
    width: min(18rem, 82vw);
    padding: 1rem;
    color: var(--qtm-hotspots-tooltip-text);
    background: var(--qtm-hotspots-tooltip-bg);
    border: 1px solid color-mix(in srgb, var(--qtm-hotspots-tooltip-text), transparent 86%);
    border-radius: calc(var(--qtm-hotspots-border-radius) * 0.7);
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.18);
    text-align: left;
    transform: translateX(-50%);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--qtm-hotspots-tooltip-bg);
    border-right: 1px solid color-mix(in srgb, var(--qtm-hotspots-tooltip-text), transparent 86%);
    border-bottom: 1px solid color-mix(in srgb, var(--qtm-hotspots-tooltip-text), transparent 86%);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip-heading {
    margin: 0 0 0.4rem;
    color: var(--qtm-hotspots-tooltip-text);
    font-size: 1rem;
    line-height: 1.2;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip-text {
    color: var(--qtm-hotspots-tooltip-text);
    font-size: 0.92rem;
    line-height: 1.55;
    opacity: 0.82;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip-text p {
    margin-top: 0;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip-text p:last-child {
    margin-bottom: 0;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.8rem;
    color: var(--qtm-hotspots-link-color);
    font-weight: 700;
    text-decoration: none;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-preview {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.85rem;
    color: inherit;
    text-decoration: none;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-image {
    width: 4rem;
    height: 4rem;
    border-radius: calc(var(--qtm-hotspots-border-radius) * 0.45);
    object-fit: cover;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-content {
    display: grid;
    gap: 0.25rem;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-title {
    color: var(--qtm-hotspots-tooltip-text);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-price {
    color: var(--qtm-hotspots-tooltip-text);
    font-size: 0.85rem;
    opacity: 0.72;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__placeholder {
    position: relative;
    display: grid;
    min-height: 380px;
    overflow: hidden;
    color: var(--qtm-hotspots-text-color);
    background: color-mix(in srgb, var(--qtm-hotspots-text-color), transparent 94%);
    border: 1px dashed color-mix(in srgb, var(--qtm-hotspots-text-color), transparent 65%);
    border-radius: calc(var(--qtm-hotspots-border-radius) * 0.85);
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__placeholder-svg {
    width: 100%;
    height: 100%;
    min-height: 380px;
    opacity: 0.24;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__placeholder-content {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    display: grid;
    gap: 0.25rem;
    max-width: 28rem;
    padding: 1rem;
    background: var(--qtm-hotspots-tooltip-bg);
    border-radius: calc(var(--qtm-hotspots-border-radius) * 0.6);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.08);
    text-align: left;
  }

  .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__placeholder-content strong {
    color: var(--qtm-hotspots-heading-color);
  }

  {% if block.settings.enable_pulse %}
    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger::before {
      animation: qtm-hotspot-pulse-{{ block_id }} 1.8s ease-in-out infinite;
    }

    @keyframes qtm-hotspot-pulse-{{ block_id }} {
      0%, 100% {
        opacity: 0.22;
        transform: scale(1);
      }

      50% {
        opacity: 0.08;
        transform: scale(1.45);
      }
    }
  {% endif %}

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--animation-fade {
    animation: qtm-hotspots-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--animation-fade-up {
    animation: qtm-hotspots-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--animation-fade-down {
    animation: qtm-hotspots-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--animation-fade-left {
    animation: qtm-hotspots-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--animation-fade-right {
    animation: qtm-hotspots-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--animation-zoom {
    animation: qtm-hotspots-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-hotspots-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-hotspots-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-hotspots-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-hotspots-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-hotspots-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-hotspots-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--hide-tablet {
      display: none !important;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-image-hotspots-{{ block_id }} {
      padding: min(var(--qtm-hotspots-padding), 24px);
    }

    .qtm-image-hotspots-{{ block_id }}.qtm-image-hotspots--hide-mobile {
      display: none !important;
    }

    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger {
      width: 2.55rem;
      height: 2.55rem;
    }

    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__trigger-inner {
      width: 1.65rem;
      height: 1.65rem;
      font-size: 0.82rem;
    }

    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip {
      position: fixed;
      left: 50%;
      right: auto;
      bottom: 1rem;
      top: auto;
      z-index: 50;
      width: min(calc(100vw - 2rem), 24rem);
      max-height: min(70vh, 28rem);
      overflow: auto;
      transform: translateX(-50%);
    }

    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__tooltip::after {
      display: none;
    }

    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-preview {
      grid-template-columns: 3.5rem 1fr;
    }

    .qtm-image-hotspots-{{ block_id }} .qtm-image-hotspots__product-image {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-image-hotspots-{{ block_id }},
    .qtm-image-hotspots-{{ block_id }} *,
    .qtm-image-hotspots-{{ block_id }} *::before,
    .qtm-image-hotspots-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.qtm-image-hotspots-{{ block_id }}');
    if (!root) return;

    const hotspots = root.querySelectorAll('.qtm-image-hotspots__hotspot');

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('toggle', () => {
        if (!hotspot.open) return;

        hotspots.forEach((otherHotspot) => {
          if (otherHotspot !== hotspot) {
            otherHotspot.removeAttribute('open');
          }
        });
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      hotspots.forEach((hotspot) => {
        hotspot.removeAttribute('open');
      });
    });

    document.addEventListener('click', (event) => {
      if (root.contains(event.target)) return;

      hotspots.forEach((hotspot) => {
        hotspot.removeAttribute('open');
      });
    });
  })();
</script>

