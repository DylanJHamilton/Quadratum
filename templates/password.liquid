{% layout 'password' %}
<h1>{{ shop.name | escape }}</h1>
{% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}
{% form 'storefront_password' %}
  {{ form.errors | default_errors }}
  <label for="StorePassword">Store password</label>
  <input id="StorePassword" name="password" type="password" autocomplete="current-password" required>
  <button type="submit" class="qtm-button">Enter store</button>
{% endform %}
