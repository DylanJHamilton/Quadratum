{%- liquid
  assign block_id = 'product-form-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign form_style = block.settings.form_style | default: 'standard'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-form-block
    product-form-block--{{ form_style }}
    product-form-block--width-{{ width }}
    product-form-block--align-{{ alignment }}
    {% unless show_on_desktop %} product-form-block--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-form-block--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-form-block--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-form-block--animate product-form-block--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-form-margin-top: {{ block.settings.margin_top }}px;
    --product-form-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-form-padding: {{ block.settings.padding }}px;
    --product-form-gap: {{ block.settings.gap }}px;
    --product-form-field-gap: {{ block.settings.field_gap }}px;
    --product-form-border-width: {{ block.settings.border_width }}px;
    --product-form-border-radius: {{ block.settings.border_radius }}px;
    --product-form-heading-color: {{ block.settings.heading_color }};
    --product-form-text-color: {{ block.settings.text_color }};
    --product-form-background-color: {{ block.settings.background_color }};
    --product-form-card-background-color: {{ block.settings.card_background_color }};
    --product-form-border-color: {{ block.settings.border_color }};
    --product-form-accent-color: {{ block.settings.accent_color }};
    --product-form-button-background: {{ block.settings.button_background_color }};
    --product-form-button-text: {{ block.settings.button_text_color }};
    --product-form-input-background: {{ block.settings.input_background_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-form-block
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-form-margin-top);
      margin-bottom: var(--product-form-margin-bottom);
      padding: var(--product-form-padding);
      color: var(--product-form-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-form-block--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-form-block--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-form-block--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-form-block--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-form-block--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-form-block--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-form-block--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-form-block--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-form-block__inner {
      display: grid;
      gap: var(--product-form-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-form-block--standard .product-form-block__inner,
    #{{ block_id }}.product-form-block--conversion .product-form-block__inner {
      padding: 20px;
      color: var(--product-form-text-color);
      background: var(--product-form-card-background-color);
      border: var(--product-form-border-width) solid var(--product-form-border-color);
      border-radius: var(--product-form-border-radius);
    }

    #{{ block_id }}.product-form-block--compact .product-form-block__inner {
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    #{{ block_id }} .product-form-block__heading {
      margin: 0;
      color: var(--product-form-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .product-form-block__form {
      display: grid;
      gap: var(--product-form-gap);
      margin: 0;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__options {
      display: grid;
      gap: var(--product-form-field-gap);
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__option {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__label {
      color: var(--product-form-heading-color);
      line-height: 1.25;
      font-size: 0.92em;
    }

    #{{ block_id }} .product-form-block__select,
    #{{ block_id }} .product-form-block__quantity {
      width: 100%;
      min-height: 46px;
      color: var(--product-form-heading-color);
      background: var(--product-form-input-background);
      border: var(--product-form-border-width) solid var(--product-form-border-color);
      border-radius: max(calc(var(--product-form-border-radius) - 10px), 6px);
    }

    #{{ block_id }} .product-form-block__select {
      padding: 0 38px 0 12px;
    }

    #{{ block_id }} .product-form-block__quantity {
      max-width: 120px;
      padding: 0 12px;
      text-align: center;
    }

    #{{ block_id }} .product-form-block__select:focus-visible,
    #{{ block_id }} .product-form-block__quantity:focus-visible {
      outline: 2px solid var(--product-form-accent-color);
      outline-offset: 2px;
    }

    #{{ block_id }} .product-form-block__quantity-row {
      display: flex;
      align-items: stretch;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }}.product-form-block--align-center .product-form-block__quantity-row {
      justify-content: center;
    }

    #{{ block_id }}.product-form-block--align-right .product-form-block__quantity-row {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-form-block__quantity-button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      min-height: 46px;
      color: var(--product-form-heading-color);
      background: var(--product-form-input-background);
      border: var(--product-form-border-width) solid var(--product-form-border-color);
      border-radius: max(calc(var(--product-form-border-radius) - 10px), 6px);
      cursor: pointer;
      font: inherit;
      line-height: 1;
    }

    #{{ block_id }} .product-form-block__quantity-button:hover {
      border-color: var(--product-form-accent-color);
    }

    #{{ block_id }} .product-form-block__quantity-button:focus-visible {
      outline: 2px solid var(--product-form-accent-color);
      outline-offset: 2px;
    }

    #{{ block_id }} .product-form-block__actions {
      display: grid;
      gap: 10px;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 50px;
      padding: 14px 18px;
      color: var(--product-form-button-text);
      background: var(--product-form-button-background);
      border: var(--product-form-border-width) solid var(--product-form-button-background);
      border-radius: max(calc(var(--product-form-border-radius) - 10px), 6px);
      cursor: pointer;
      text-align: center;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-form-block__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-form-block__button:focus-visible {
      outline: 2px solid var(--product-form-accent-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-form-block__button[disabled] {
      cursor: not-allowed;
      opacity: 0.55;
      transform: none;
    }

    #{{ block_id }} .product-form-block__payment-button {
      display: block;
    }

    #{{ block_id }} .product-form-block__message {
      min-height: 1.3em;
      color: var(--product-form-text-color);
      line-height: 1.35;
      font-size: 0.92em;
    }

    #{{ block_id }}.product-form-block--compact .product-form-block__message {
      display: none;
    }

    #{{ block_id }} .product-form-block__selling-plan {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__selling-plan-note {
      color: var(--product-form-text-color);
      line-height: 1.45;
      font-size: 0.9em;
      opacity: 0.85;
    }

    #{{ block_id }}.product-form-block--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-form-block--animate-fade {
      animation-name: productFormFade;
    }

    #{{ block_id }}.product-form-block--animate-fade_up {
      animation-name: productFormFadeUp;
    }

    #{{ block_id }}.product-form-block--animate-fade_down {
      animation-name: productFormFadeDown;
    }

    #{{ block_id }}.product-form-block--animate-fade_left {
      animation-name: productFormFadeLeft;
    }

    #{{ block_id }}.product-form-block--animate-fade_right {
      animation-name: productFormFadeRight;
    }

    #{{ block_id }}.product-form-block--animate-zoom {
      animation-name: productFormZoom;
    }

    @keyframes productFormFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productFormFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFormFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFormFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productFormFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productFormZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-form-block--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-form-block--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-form-block--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-form-block--standard .product-form-block__inner,
      #{{ block_id }}.product-form-block--conversion .product-form-block__inner {
        padding: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-form-block--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-form-block__button {
        transition: none;
      }

      #{{ block_id }} .product-form-block__button:hover {
        transform: none;
      }
    }
  </style>

  <div class="product-form-block__inner">
    {% if block.settings.heading != blank %}
      <h3 class="product-form-block__heading">
        {{ block.settings.heading | escape }}
      </h3>
    {% endif %}

    {% form 'product', product_context, class: 'product-form-block__form', data-product-form: '', data-ajax-cart-form: '', data-cart-add-form: '', data-product-form-block-form: '' %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-form-variant-input>

      {% if block.settings.show_variant_picker and product_context.has_only_default_variant == false %}
        <div class="product-form-block__options">
          {% for option in product_context.options_with_values %}
            <div class="product-form-block__option">
              <label class="product-form-block__label" for="{{ block_id }}-option-{{ forloop.index }}">
                {{ option.name | escape }}
              </label>

              <select
                id="{{ block_id }}-option-{{ forloop.index }}"
                class="product-form-block__select"
                data-product-form-option-select
                data-option-position="{{ option.position }}"
                aria-label="{{ option.name | escape }}"
              >
                {% for value in option.values %}
                  <option
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}selected{% endif %}
                  >
                    {{ value | escape }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if block.settings.show_selling_plans and product_context.selling_plan_groups.size > 0 %}
        <div class="product-form-block__selling-plan">
          <label class="product-form-block__label" for="{{ block_id }}-selling-plan">
            {{ block.settings.selling_plan_label | escape }}
          </label>

          <select
            id="{{ block_id }}-selling-plan"
            class="product-form-block__select"
            name="selling_plan"
            data-product-form-selling-plan
          >
            <option value="">
              {{ block.settings.one_time_purchase_label | escape }}
            </option>

            {% for group in product_context.selling_plan_groups %}
              <optgroup label="{{ group.name | escape }}">
                {% for selling_plan in group.selling_plans %}
                  <option value="{{ selling_plan.id }}">
                    {{ selling_plan.name | escape }}
                  </option>
                {% endfor %}
              </optgroup>
            {% endfor %}
          </select>

          {% if block.settings.selling_plan_note != blank %}
            <div class="product-form-block__selling-plan-note">
              {{ block.settings.selling_plan_note | escape }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_quantity %}
        <div class="product-form-block__option">
          <label class="product-form-block__label" for="{{ block_id }}-quantity">
            {{ block.settings.quantity_label | escape }}
          </label>

          <div class="product-form-block__quantity-row">
            {% if block.settings.show_quantity_buttons %}
              <button
                type="button"
                class="product-form-block__quantity-button"
                data-product-form-quantity-minus
                aria-label="{{ block.settings.decrease_quantity_label | escape }}"
              >
                −
              </button>
            {% endif %}

            <input
              id="{{ block_id }}-quantity"
              class="product-form-block__quantity"
              type="number"
              name="quantity"
              min="1"
              value="1"
              inputmode="numeric"
              data-product-form-quantity
              aria-label="{{ block.settings.quantity_label | escape }}"
            >

            {% if block.settings.show_quantity_buttons %}
              <button
                type="button"
                class="product-form-block__quantity-button"
                data-product-form-quantity-plus
                aria-label="{{ block.settings.increase_quantity_label | escape }}"
              >
                +
              </button>
            {% endif %}
          </div>
        </div>
      {% else %}
        <input type="hidden" name="quantity" value="1">
      {% endif %}

      <div class="product-form-block__actions">
        {% if block.settings.show_add_to_cart %}
          <button
            type="submit"
            class="product-form-block__button"
            {% unless current_variant.available %}disabled{% endunless %}
            data-add-to-cart
            data-ajax-cart-submit
            data-cart-drawer-trigger
            data-product-form-submit
          >
            {% if current_variant.available %}
              {{ block.settings.add_to_cart_label | escape }}
            {% else %}
              {{ block.settings.sold_out_label | escape }}
            {% endif %}
          </button>
        {% endif %}

        {% if block.settings.show_dynamic_checkout %}
          <div class="product-form-block__payment-button">
            {{ form | payment_button }}
          </div>
        {% endif %}
      </div>

      <div
        class="product-form-block__message"
        data-product-form-message
        role="status"
        aria-live="polite"
      ></div>
    {% endform %}
  </div>

  <script type="application/json" data-product-form-variants>
    {{ product_context.variants | json }}
  </script>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productFormBlockReady === 'true') return;

      root.dataset.productFormBlockReady = 'true';

      const form = root.querySelector('[data-product-form-block-form]');
      const variantsJson = root.querySelector('[data-product-form-variants]');
      const variantInput = root.querySelector('[data-product-form-variant-input]');
      const optionSelects = Array.from(root.querySelectorAll('[data-product-form-option-select]'));
      const submitButton = root.querySelector('[data-product-form-submit]');
      const quantityInput = root.querySelector('[data-product-form-quantity]');
      const quantityMinus = root.querySelector('[data-product-form-quantity-minus]');
      const quantityPlus = root.querySelector('[data-product-form-quantity-plus]');
      const messageEl = root.querySelector('[data-product-form-message]');

      if (!form || !variantsJson || !variantInput) return;

      let variants = [];

      try {
        variants = JSON.parse(variantsJson.textContent || '[]');
      } catch (error) {
        variants = [];
      }

      const setMessage = (message) => {
        if (messageEl) messageEl.textContent = message || '';
      };

      const selectedOptions = () => {
        return optionSelects.map((select) => select.value);
      };

      const findVariantByOptions = () => {
        const selected = selectedOptions();

        return variants.find((variant) => {
          return selected.every((value, index) => variant.options[index] === value);
        });
      };

      const dispatchVariantChange = (variant) => {
        if (!variant) return;

        root.dataset.variantId = String(variant.id);

        document.dispatchEvent(new CustomEvent('variant:change', {
          bubbles: true,
          detail: {
            productId: {{ product_context.id | json }},
            variantId: Number(variant.id),
            variant
          }
        }));

        document.dispatchEvent(new CustomEvent('qtm:variant:change', {
          bubbles: true,
          detail: {
            productId: {{ product_context.id | json }},
            variantId: Number(variant.id),
            variant
          }
        }));
      };

      const updateVariant = () => {
        if (!optionSelects.length) {
          const existingVariant = variants.find((variant) => String(variant.id) === String(variantInput.value));
          dispatchVariantChange(existingVariant);
          return;
        }

        const variant = findVariantByOptions();

        if (!variant) {
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = {{ block.settings.unavailable_label | json }};
          }

          return;
        }

        variantInput.value = variant.id;

        if (submitButton) {
          submitButton.disabled = !variant.available;
          submitButton.textContent = variant.available
            ? {{ block.settings.add_to_cart_label | json }}
            : {{ block.settings.sold_out_label | json }};
        }

        dispatchVariantChange(variant);
      };

      optionSelects.forEach((select) => {
        select.addEventListener('change', updateVariant);
      });

      if (quantityMinus && quantityInput) {
        quantityMinus.addEventListener('click', () => {
          const value = Math.max(Number(quantityInput.value || 1) - 1, 1);
          quantityInput.value = String(value);
          quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }

      if (quantityPlus && quantityInput) {
        quantityPlus.addEventListener('click', () => {
          const value = Math.max(Number(quantityInput.value || 1) + 1, 1);
          quantityInput.value = String(value);
          quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }

      form.addEventListener('submit', () => {
        setMessage({{ block.settings.adding_message | json }});

        window.setTimeout(() => {
          setMessage('');
        }, 3500);
      });

      document.addEventListener('cart:updated', () => {
        setMessage({{ block.settings.added_message | json }});
      });

      document.addEventListener('ajaxCart:refresh', () => {
        setMessage({{ block.settings.added_message | json }});
      });

      updateVariant();
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product form",
  "settings": [
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "Show variant picker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity_buttons",
      "label": "Show quantity buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_selling_plans",
      "label": "Show selling plans",
      "default": true
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "decrease_quantity_label",
      "label": "Decrease quantity label",
      "default": "Decrease quantity"
    },
    {
      "type": "text",
      "id": "increase_quantity_label",
      "label": "Increase quantity label",
      "default": "Increase quantity"
    },
    {
      "type": "text",
      "id": "selling_plan_label",
      "label": "Selling plan label",
      "default": "Purchase options"
    },
    {
      "type": "text",
      "id": "one_time_purchase_label",
      "label": "One-time purchase label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "selling_plan_note",
      "label": "Selling plan note"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "Unavailable"
    },
    {
      "type": "text",
      "id": "adding_message",
      "label": "Adding message",
      "default": "Adding to cart..."
    },
    {
      "type": "text",
      "id": "added_message",
      "label": "Added message",
      "default": "Added to cart."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "form_style",
      "label": "Form style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "conversion",
          "label": "Conversion"
        }
