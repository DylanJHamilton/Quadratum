{%- liquid
  assign item_count = 0

  if block.settings.item_1_heading != blank or block.settings.item_1_text != blank
    assign item_count = item_count | plus: 1
  endif

  if block.settings.item_2_heading != blank or block.settings.item_2_text != blank
    assign item_count = item_count | plus: 1
  endif

  if block.settings.item_3_heading != blank or block.settings.item_3_text != blank
    assign item_count = item_count | plus: 1
  endif

  if block.settings.item_4_heading != blank or block.settings.item_4_text != blank
    assign item_count = item_count | plus: 1
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'icon-list' %}

<div
  class="
    qtm-icon-list
    qtm-icon-list--{{ block.settings.list_layout }}
    qtm-icon-list--icon-{{ block.settings.icon_position }}
    qtm-icon-list--columns-{{ block.settings.columns }}
  "
  style="
    --qtm-icon-list-gap: {{ block.settings.gap }}px;
    --qtm-icon-list-item-gap: {{ block.settings.item_gap }}px;
    --qtm-icon-list-max-width: {{ block.settings.max_width }}px;
    --qtm-icon-list-item-padding: {{ block.settings.item_padding }}px;
    --qtm-icon-list-item-background: {{ block.settings.item_background }};
    --qtm-icon-list-item-border-width: {{ block.settings.item_border_width }}px;
    --qtm-icon-list-item-border-color: {{ block.settings.item_border_color }};
    --qtm-icon-list-item-radius: {{ block.settings.item_radius }}px;
    --qtm-icon-list-icon-size: {{ block.settings.icon_size }}px;
    --qtm-icon-list-icon-color: {{ block.settings.icon_color }};
    --qtm-icon-list-icon-background: {{ block.settings.icon_background }};
    --qtm-icon-list-icon-radius: {{ block.settings.icon_radius }}px;
    --qtm-icon-list-icon-padding: {{ block.settings.icon_padding }}px;
    --qtm-icon-list-heading-color: {{ block.settings.heading_color }};
    --qtm-icon-list-text-color: {{ block.settings.text_color }};
    --qtm-icon-list-link-color: {{ block.settings.link_color }};
  "
>
  {% for i in (1..4) %}
    {%- liquid
      assign icon_key = 'item_' | append: i | append: '_icon'
      assign heading_key = 'item_' | append: i | append: '_heading'
      assign text_key = 'item_' | append: i | append: '_text'
      assign link_key = 'item_' | append: i | append: '_link'
      assign aria_key = 'item_' | append: i | append: '_aria_label'

      assign item_icon = block.settings[icon_key]
      assign item_heading = block.settings[heading_key]
      assign item_text = block.settings[text_key]
      assign item_link = block.settings[link_key]
      assign item_aria_label = block.settings[aria_key]

      assign item_tag = 'div'

      if item_link != blank
        assign item_tag = 'a'
      endif
    -%}

    {% if item_icon != blank or item_heading != blank or item_text != blank %}
      <{{ item_tag }}
        class="qtm-icon-list__item"
        {% if item_link != blank %}
          href="{{ item_link }}"
          aria-label="{{ item_aria_label | default: item_heading | escape }}"
        {% endif %}
      >
        {% if item_icon != blank %}
          <span class="qtm-icon-list__icon" aria-hidden="true">
            {{ item_icon | escape }}
          </span>
        {% endif %}

        <span class="qtm-icon-list__content">
          {% if item_heading != blank %}
            <span class="qtm-icon-list__heading">
              {{ item_heading | escape }}
            </span>
          {% endif %}

          {% if item_text != blank %}
            <span class="qtm-icon-list__text">
              {{ item_text | escape }}
            </span>
          {% endif %}
        </span>
      </{{ item_tag }}>
    {% endif %}
  {% endfor %}
</div>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

