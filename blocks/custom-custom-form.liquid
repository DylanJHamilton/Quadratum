    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our location"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
