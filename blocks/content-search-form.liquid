{% liquid
  assign block_id = block.id
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  if request.design_mode
    assign animation = 'none'
  endif

  assign search_label = block.settings.search_label
  if search_label == blank
    assign search_label = 'Search'
  endif

  assign allow_products = settings.search_src_products | default: true, allow_false: true
  assign allow_articles = settings.search_src_articles | default: true, allow_false: true
  assign allow_pages = settings.search_src_pages | default: true, allow_false: true
  assign allow_collections = settings.search_src_collections | default: true, allow_false: true
  if block.settings.search_type != 'all'
    assign allow_collections = false
    unless block.settings.search_type == 'product'
      assign allow_products = false
    endunless
    unless block.settings.search_type == 'article'
      assign allow_articles = false
    endunless
    unless block.settings.search_type == 'page'
      assign allow_pages = false
    endunless
  endif
  assign search_types = ''
  if allow_products
    assign search_types = search_types | append: ',product'
  endif
  if allow_articles
    assign search_types = search_types | append: ',article'
  endif
  if allow_pages
    assign search_types = search_types | append: ',page'
  endif
  assign search_types = search_types | remove_first: ','
  assign predictive_enabled = false
  if block.settings.enable_predictive_search and settings.enable_predictive_search != false
    if search_types != blank or allow_collections
      assign predictive_enabled = true
    endif
  endif
  assign search_action = routes.search_url
%}

<div
  class="
    qtm-search-form
    qtm-search-form-{{ block_id }}
    qtm-search-form--width-{{ block_width }}
    qtm-search-form--align-{{ block_alignment }}
    qtm-search-form--layout-{{ block.settings.layout_style }}
    qtm-search-form--animation-{{ animation }}
    {% unless block.settings.show_desktop or request.design_mode %} qtm-search-form--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet or request.design_mode %} qtm-search-form--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile or request.design_mode %} qtm-search-form--hide-mobile{% endunless %}
  "
  style="
    --qtm-search-form-margin-top: {{ block.settings.margin_top }}px;
    --qtm-search-form-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-search-form-padding: {{ block.settings.padding }}px;
    --qtm-search-form-gap: {{ block.settings.gap }}px;
    --qtm-search-form-heading-color: {{ block.settings.heading_color }};
    --qtm-search-form-text-color: {{ block.settings.text_color }};
    --qtm-search-form-background-color: {{ block.settings.background_color }};
    --qtm-search-form-card-background: {{ block.settings.card_background_color }};
    --qtm-search-form-border-color: {{ block.settings.border_color }};
    --qtm-search-form-link-color: {{ block.settings.link_color }};
    --qtm-search-form-input-background: {{ block.settings.input_background_color }};
    --qtm-search-form-input-text: {{ block.settings.input_text_color }};
    --qtm-search-form-button-background: {{ block.settings.button_background_color }};
    --qtm-search-form-button-text: {{ block.settings.button_text_color }};
    --qtm-search-form-icon-color: {{ block.settings.icon_color }};
    --qtm-search-form-border-width: {{ block.settings.border_width }}px;
    --qtm-search-form-border-radius: {{ block.settings.border_radius }}px;
    --qtm-search-form-input-height: {{ block.settings.input_height }}px;
  "
>
  <div class="qtm-search-form__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-search-form__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-search-form__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-search-form__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-search-form__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-search-form__card">
      <div
  style="
    --qtm-ps-panel-bg: {{ settings.predictive_search_panel_bg | default: settings.bg_base }};
    --qtm-ps-panel-border: {{ settings.predictive_search_panel_border | default: settings.bg_contrast }};
    --qtm-ps-item-bg: {{ settings.predictive_search_item_bg | default: settings.bg_contrast }};
    --qtm-ps-item-hover-bg: {{ settings.predictive_search_item_hover_bg | default: settings.bg_contrast }};
    --qtm-ps-heading-color: {{ settings.predictive_search_heading_color | default: settings.text_muted }};
    --qtm-ps-title-color: {{ settings.predictive_search_title_color | default: settings.text_base }};
    --qtm-ps-meta-color: {{ settings.predictive_search_meta_color | default: settings.text_muted }};
    --qtm-ps-price-color: {{ settings.predictive_search_price_color | default: settings.color_primary }};
    --qtm-ps-panel-radius: {{ settings.predictive_search_panel_radius | default: 18 }}px;
    --qtm-ps-item-radius: {{ settings.predictive_search_item_radius | default: 14 }}px;
    --qtm-ps-panel-padding: {{ settings.predictive_search_panel_padding | default: 14 }}px;
    --qtm-ps-item-padding: {{ settings.predictive_search_item_padding | default: 10 }}px;
    --qtm-ps-thumb-size: {{ settings.predictive_search_thumbnail_size | default: 56 }}px;
  "
        class="qtm-search-form__predictive qtm-search-form--predictive-{{ settings.predictive_search_panel_style | default: 'soft' | escape }}"
        {% if predictive_enabled %}
          data-qtm-predictive-search
          data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
          data-min-chars="{{ settings.predictive_search_min_chars | default: 2 }}"
          data-debounce="{{ settings.predictive_search_debounce | default: 250 }}"
          data-products-enabled="{{ allow_products }}" data-collections-enabled="{{ allow_collections }}"
          data-articles-enabled="{{ allow_articles }}" data-pages-enabled="{{ allow_pages }}"
          data-products-limit="{{ settings.predictive_search_products_limit | default: 4 }}"
          data-collections-limit="{{ settings.predictive_search_collections_limit | default: 3 }}"
          data-articles-limit="{{ settings.predictive_search_articles_limit | default: 3 }}"
          data-pages-limit="{{ settings.predictive_search_pages_limit | default: 3 }}"
          data-products-layout="{{ settings.predictive_search_products_layout | default: 'list' | escape }}"
          data-show-group-headings="{{ settings.predictive_search_show_group_headings | default: true, allow_false: true }}"
          data-show-thumbnails="{{ settings.predictive_search_show_thumbnails | default: true, allow_false: true }}"
          data-show-view-all="{{ settings.predictive_search_show_view_all | default: true, allow_false: true }}"
          data-view-all-label="{{ settings.search_view_all_label | default: 'View all results' | escape }}"
        {% endif %}
      >
      <form
        class="qtm-search-form__form"
        action="{{ search_action | escape }}"
        method="get"
        role="search"
        aria-label="{{ search_label | escape }}"
      >
        <div class="qtm-search-form__field">
          <label
            class="qtm-search-form__label {% unless block.settings.show_label %}visually-hidden{% endunless %}"
            for="qtm-search-form-input-{{ block_id }}"
          >
            {{ search_label | escape }}
          </label>

          <div class="qtm-search-form__input-wrap">
            {% if block.settings.show_search_icon %}
              <span class="qtm-search-form__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" class="qtm-search-form__svg">
                  <path d="M10.8 18.1a7.3 7.3 0 1 1 5.2-2.15l4.03 4.02-1.42 1.42-4.02-4.03a7.26 7.26 0 0 1-3.79 1.04Zm0-2a5.3 5.3 0 1 0 0-10.6 5.3 5.3 0 0 0 0 10.6Z" fill="currentColor"/>
                </svg>
              </span>
            {% endif %}

            <input
              id="qtm-search-form-input-{{ block_id }}"
              class="qtm-search-form__input"
              type="search"
              {% if search_types != blank %}name="q"{% endif %}
              {% if search_types == blank and predictive_enabled == false %}disabled{% endif %}
              value="{{ search.terms | escape }}"
              placeholder="{{ block.settings.placeholder | escape }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label="{{ search_label | escape }}"
              {% if predictive_enabled %}
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
                aria-controls="qtm-search-panel-{{ block_id }}"
                aria-haspopup="listbox"
                data-qtm-predictive-input
              {% endif %}
              required
            >

            {% if search_types != blank %}
              <input type="hidden" name="type" value="{{ search_types | escape }}">
            {% endif %}

            {% if block.settings.enable_unavailable_filter %}
              <input type="hidden" name="options[unavailable_products]" value="{{ block.settings.unavailable_products_behavior | escape }}">
            {% endif %}

            {% if block.settings.enable_prefix_filter %}
              <input type="hidden" name="options[prefix]" value="{{ block.settings.prefix_behavior | escape }}">
            {% endif %}
          </div>
        </div>

        <button class="qtm-search-form__button" type="submit"{% if search_types == blank %} disabled{% endif %}>
          {% if block.settings.button_style == 'icon' %}
            <span class="qtm-search-form__button-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" class="qtm-search-form__svg">
                <path d="M10.8 18.1a7.3 7.3 0 1 1 5.2-2.15l4.03 4.02-1.42 1.42-4.02-4.03a7.26 7.26 0 0 1-3.79 1.04Zm0-2a5.3 5.3 0 1 0 0-10.6 5.3 5.3 0 0 0 0 10.6Z" fill="currentColor"/>
              </svg>
            </span>
            <span class="visually-hidden">
              {{ block.settings.button_label | default: 'Search' | escape }}
            </span>
          {% else %}
            {{ block.settings.button_label | default: 'Search' | escape }}
          {% endif %}
        </button>
      </form>
      {% if predictive_enabled %}
        <span class="visually-hidden" data-qtm-predictive-status role="status" aria-live="polite"></span>
        <div id="qtm-search-panel-{{ block_id }}" class="qtm-search-predictive__panel" data-qtm-predictive-panel role="listbox" aria-label="Search suggestions" hidden></div>
      {% endif %}
      </div>
      {% if search_types == blank %}
        <p class="qtm-search-form__notice">{% if predictive_enabled %}Choose a collection from the search suggestions.{% else %}Search is currently unavailable.{% endif %}</p>
        {% if predictive_enabled %}<noscript><p>Enable JavaScript to see collection suggestions.</p></noscript>{% endif %}
      {% endif %}

      {% if block.settings.note != blank %}
        <div class="qtm-search-form__note">
          {{ block.settings.note }}
        </div>
      {% endif %}

{% capture suggestions_markup %}
            {% for i in (1..5) %}
              {% liquid
                assign label_key = 'suggestion_' | append: i | append: '_label'
                assign query_key = 'suggestion_' | append: i | append: '_query'

                assign suggestion_label = block.settings[label_key]
                assign suggestion_query = block.settings[query_key]
              %}

              {% if suggestion_label != blank %}
                {% if suggestion_query != blank %}
                  <a
                    class="qtm-search-form__suggestion"
                    href="{{ routes.search_url | escape }}?q={{ suggestion_query | url_encode }}&amp;type={{ search_types | url_encode }}{% if block.settings.enable_unavailable_filter %}&amp;options[unavailable_products]={{ block.settings.unavailable_products_behavior | url_encode }}{% endif %}{% if block.settings.enable_prefix_filter %}&amp;options[prefix]={{ block.settings.prefix_behavior | url_encode }}{% endif %}"
                  >
                    {{ suggestion_label | escape }}
                  </a>
                {% else %}
                  <a
                    class="qtm-search-form__suggestion"
                    href="{{ routes.search_url | escape }}?q={{ suggestion_label | url_encode }}&amp;type={{ search_types | url_encode }}{% if block.settings.enable_unavailable_filter %}&amp;options[unavailable_products]={{ block.settings.unavailable_products_behavior | url_encode }}{% endif %}{% if block.settings.enable_prefix_filter %}&amp;options[prefix]={{ block.settings.prefix_behavior | url_encode }}{% endif %}"
                  >
                    {{ suggestion_label | escape }}
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
{% endcapture %}
{% assign suggestions_markup = suggestions_markup | strip %}
      {% if block.settings.show_suggestions and search_types != blank and suggestions_markup != blank %}
        <div class="qtm-search-form__suggestions" aria-label="{{ block.settings.suggestions_label | escape }}">
          {% if block.settings.suggestions_label != blank %}
            <span class="qtm-search-form__suggestions-title">
              {{ block.settings.suggestions_label | escape }}
            </span>
          {% endif %}

          <div class="qtm-search-form__suggestion-list">
{{ suggestions_markup }}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-search-form-{{ block_id }} {
    container-type: inline-size;
    box-sizing: border-box;
    min-width: 0;
    overflow-wrap: anywhere;
    margin-top: var(--qtm-search-form-margin-top);
    margin-bottom: var(--qtm-search-form-margin-bottom);
    padding: min(var(--qtm-search-form-padding), 12%);
    color: var(--qtm-search-form-text-color);
    background: var(--qtm-search-form-background-color);
    border: var(--qtm-search-form-border-width) solid var(--qtm-search-form-border-color);
    border-radius: var(--qtm-search-form-border-radius);
  }

  .qtm-search-form-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--width-auto {
    width: auto;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--width-small {
    max-width: 620px;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--width-medium {
    max-width: 860px;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--width-large {
    max-width: 1120px;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__inner {
    display: grid;
    gap: var(--qtm-search-form-gap);
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__header {
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-center .qtm-search-form__header {
    margin-inline: auto;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-right .qtm-search-form__header {
    margin-left: auto;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__eyebrow {
    margin: 0;
    color: var(--qtm-search-form-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__heading {
    margin: 0;
    color: var(--qtm-search-form-heading-color);
    line-height: 1.05;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__text,
  .qtm-search-form-{{ block_id }} .qtm-search-form__note {
    color: var(--qtm-search-form-text-color);
    line-height: 1.7;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__text p,
  .qtm-search-form-{{ block_id }} .qtm-search-form__note p {
    margin-top: 0;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__text p:last-child,
  .qtm-search-form-{{ block_id }} .qtm-search-form__note p:last-child {
    margin-bottom: 0;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__card {
    display: grid;
    gap: calc(var(--qtm-search-form-gap) * 0.6);
    width: 100%;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--layout-boxed .qtm-search-form__card,
  .qtm-search-form-{{ block_id }}.qtm-search-form--layout-large .qtm-search-form__card {
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--qtm-search-form-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-search-form-border-color), transparent 10%);
    border-radius: calc(var(--qtm-search-form-border-radius) * 0.75);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--layout-minimal .qtm-search-form__card {
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: end;
    width: 100%;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--layout-minimal .qtm-search-form__form {
    gap: 0.5rem;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    text-align: left;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__label {
    color: var(--qtm-search-form-heading-color);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__icon {
    position: absolute;
    left: 1rem;
    z-index: 2;
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--qtm-search-form-icon-color);
    pointer-events: none;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__input {
    width: 100%;
    min-height: var(--qtm-search-form-input-height);
    padding: 0.8rem 1rem;
    color: var(--qtm-search-form-input-text);
    background: var(--qtm-search-form-input-background);
    border: 1px solid color-mix(in srgb, var(--qtm-search-form-border-color), transparent 5%);
    border-radius: calc(var(--qtm-search-form-border-radius) * 0.55);
    font: inherit;
    line-height: 1.2;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__icon + .qtm-search-form__input {
    padding-left: 2.7rem;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--layout-large .qtm-search-form__input {
    font-size: 1.08rem;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__input::placeholder {
    color: color-mix(in srgb, var(--qtm-search-form-input-text), transparent 48%);
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__input:focus-visible {
    outline: 3px solid var(--qtm-search-form-link-color);
    outline-offset: 3px;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(100%, {{ block.settings.button_min_width }}px);
    min-height: var(--qtm-search-form-input-height);
    padding: 0.85rem 1.25rem;
    color: var(--qtm-search-form-button-text);
    background: var(--qtm-search-form-button-background);
    border: 1px solid var(--qtm-search-form-button-background);
    border-radius: calc(var(--qtm-search-form-border-radius) * 0.55);
    font: inherit;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    cursor: pointer;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__button:focus-visible {
    outline: 3px solid var(--qtm-search-form-link-color);
    outline-offset: 4px;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__button-icon {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__note {
    max-width: 720px;
    font-size: 0.9rem;
    opacity: 0.82;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-center .qtm-search-form__note {
    margin-inline: auto;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-right .qtm-search-form__note {
    margin-left: auto;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__suggestions {
    display: grid;
    gap: 0.55rem;
    text-align: left;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-center .qtm-search-form__suggestions {
    text-align: center;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-right .qtm-search-form__suggestions {
    text-align: right;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__suggestions-title {
    color: var(--qtm-search-form-heading-color);
    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__suggestion-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-center .qtm-search-form__suggestion-list {
    justify-content: center;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--align-right .qtm-search-form__suggestion-list {
    justify-content: flex-end;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__suggestion {
    display: inline-flex;
    padding: 0.45rem 0.7rem;
    color: var(--qtm-search-form-link-color);
    background: color-mix(in srgb, var(--qtm-search-form-link-color), transparent 94%);
    border: 1px solid color-mix(in srgb, var(--qtm-search-form-border-color), transparent 12%);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 750;
    line-height: 1.1;
    text-decoration: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__suggestion:hover {
    opacity: 0.78;
    transform: translateY(-1px);
  }

  .qtm-search-form-{{ block_id }} .qtm-search-form__suggestion:focus-visible {
    outline: 3px solid var(--qtm-search-form-link-color);
    outline-offset: 4px;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--animation-fade {
    animation: qtm-search-form-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--animation-fade-up {
    animation: qtm-search-form-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--animation-fade-down {
    animation: qtm-search-form-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--animation-fade-left {
    animation: qtm-search-form-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--animation-fade-right {
    animation: qtm-search-form-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-search-form-{{ block_id }}.qtm-search-form--animation-zoom {
    animation: qtm-search-form-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-search-form-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-search-form-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-search-form-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-search-form-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-search-form-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-search-form-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {

  }

  @media screen and (min-width: 990px) {
    .qtm-search-form-{{ block_id }}.qtm-search-form--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-search-form-{{ block_id }} {
      padding: min(var(--qtm-search-form-padding), 24px, 12%);
    }

    .qtm-search-form-{{ block_id }}.qtm-search-form--hide-mobile {
      display: none !important;
    }

    .qtm-search-form-{{ block_id }} .qtm-search-form__form {
      grid-template-columns: 1fr;
    }

    .qtm-search-form-{{ block_id }} .qtm-search-form__button {
      width: 100%;
    }

    .qtm-search-form-{{ block_id }}.qtm-search-form--layout-boxed .qtm-search-form__card,
    .qtm-search-form-{{ block_id }}.qtm-search-form--layout-large .qtm-search-form__card {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-search-form-{{ block_id }},
    .qtm-search-form-{{ block_id }} *,
    .qtm-search-form-{{ block_id }} *::before,
    .qtm-search-form-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .qtm-search-form-{{ block_id }}.qtm-search-form--hide-tablet {
      display: none !important;
    }
  }
  .qtm-search-form-{{ block_id }} :is(div,li,a,span,input,textarea,button) { min-width: 0; }
  .qtm-search-form-{{ block_id }} :is(a,input,textarea,button) { max-width: 100%; }
  .qtm-search-form-{{ block_id }}[hidden] { display: none !important; }
  @container (max-width: 420px) { .qtm-search-form-{{ block_id }} .qtm-search-form__form { grid-template-columns: minmax(0, 1fr); } }
</style>

{% schema %}
