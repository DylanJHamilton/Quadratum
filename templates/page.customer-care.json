    "returns-and-exchanges": {
      "type": "interactive-content-helper-tabs-accordion",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "label": "What is the returns policy?",
            "icon": "",
            "anchor_id": "returns-and-exchanges",
            "content": "<p>Thirty days, any reason, for books and goods in resalable condition. Bring the receipt or order email to the shop, or post it back with the slip from your parcel.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "How are refunds issued?",
            "icon": "",
            "anchor_id": "how-are-refunds-issued",
            "content": "<p>To the original payment method within five working days of the return arriving. Shop returns are refunded on the spot.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "What about damaged books?",
            "icon": "",
            "anchor_id": "what-about-damaged-books",
            "content": "<p>Tell us within seven days of delivery with a photo and we will replace it or refund it, whichever you prefer.</p>"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3"
