{% liquid
  assign main_menu = linklists[settings.desktop_menu]

  assign header_layout = section.settings.header_layout | default: 'center_logo'
  assign header_width = section.settings.header_width | default: 'wide'
  assign background_mode = section.settings.background_mode | default: 'solid'
  assign sticky_mode = section.settings.sticky_mode | default: 'sticky_shadow'
  assign mobile_menu_style = section.settings.mobile_menu_style | default: 'fullscreen'

  assign search_display = section.settings.search_display | default: 'search_button'
  assign search_button_action = section.settings.search_button_action | default: 'popup'

  assign account_display = section.settings.account_display | default: 'icon'
  assign cart_display = section.settings.cart_display | default: 'icon'

  assign announcement_enabled = section.settings.announcement_enable
  assign announcement_text = section.settings.announcement_text

  assign sticky_enabled = false
  assign sticky_shadow_enabled = false
  assign transparent_enabled = false
  assign transparent_until_scroll = false

  if background_mode == 'transparent'
    assign transparent_enabled = true
  elsif background_mode == 'transparent_until_scroll'
    assign transparent_enabled = true
    assign transparent_until_scroll = true
  endif

  if sticky_mode == 'sticky' or sticky_mode == 'sticky_shadow' or sticky_mode == 'transparent_to_solid'
    assign sticky_enabled = true
  endif

  if sticky_mode == 'sticky_shadow'
    assign sticky_shadow_enabled = true
  endif

  if sticky_mode == 'transparent_to_solid'
    assign sticky_enabled = true
    assign transparent_enabled = true
    assign transparent_until_scroll = true
  endif
%}

{{ 'header-three.css' | asset_url | stylesheet_tag }}

<div
  id="HeaderThree-{{ section.id }}"
  class="
    qtmHeaderThree
    qtmHeaderThree--layout-{{ header_layout }}
    qtmHeaderThree--width-{{ header_width }}
    qtmHeaderThree--background-{{ background_mode }}
    qtmHeaderThree--sticky-{{ sticky_mode }}
    qtmHeaderThree--mobile-{{ mobile_menu_style }}
    {% if transparent_enabled %}qtmHeaderThree--transparent{% endif %}
    {% if transparent_until_scroll %}qtmHeaderThree--transparentUntilScroll{% endif %}
    {% if sticky_enabled %}qtmHeaderThree--sticky{% endif %}
    {% if sticky_shadow_enabled %}qtmHeaderThree--stickyShadow{% endif %}
    {% if section.settings.enable_blur %}qtmHeaderThree--blur{% endif %}
    {% if section.settings.header_shadow %}qtmHeaderThree--shadow{% endif %}
  "
  style="
    --qtm-h3-bg: {{ section.settings.header_bg }};
    --qtm-h3-text: {{ section.settings.header_text }};
    --qtm-h3-link: {{ section.settings.header_link }};
    --qtm-h3-link-hover: {{ section.settings.header_link_hover }};
    --qtm-h3-border: {{ section.settings.header_border }};
    --qtm-h3-transparent-text: {{ section.settings.transparent_text }};
    --qtm-h3-transparent-link: {{ section.settings.transparent_link }};
    --qtm-h3-dropdown-bg: {{ section.settings.dropdown_bg }};
    --qtm-h3-dropdown-text: {{ section.settings.dropdown_text }};
    --qtm-h3-dropdown-border: {{ section.settings.dropdown_border }};
    --qtm-h3-announcement-bg: {{ section.settings.announcement_bg }};
    --qtm-h3-announcement-text: {{ section.settings.announcement_text_color }};
    --qtm-h3-menu-font-size: {{ section.settings.menu_font_size }}px;
    --qtm-h3-menu-font-weight: {{ section.settings.menu_font_weight }};
    --qtm-h3-logo-text-size: {{ section.settings.logo_text_size }}px;
    --qtm-h3-letter-spacing: {{ section.settings.letter_spacing }}em;
    --qtm-h3-text-transform: {{ section.settings.text_transform }};
    --qtm-h3-padding-y: {{ section.settings.header_padding_y }}px;
    --qtm-h3-padding-x: {{ section.settings.header_padding_x }}px;
    --qtm-h3-menu-gap: {{ section.settings.menu_gap }}px;
    --qtm-h3-dropdown-padding: {{ section.settings.dropdown_padding }}px;
    --qtm-h3-button-radius: {{ section.settings.button_radius }}px;
    --qtm-h3-dropdown-radius: {{ section.settings.dropdown_radius }}px;
    --qtm-h3-transition-speed: {{ section.settings.transition_speed }}ms;
    --qtm-h3-logo-desktop: {{ section.settings.logo_height_desktop }}px;
    --qtm-h3-logo-mobile: {{ section.settings.logo_height_mobile }}px;
    --qtm-h3-announcement-font-size: {{ section.settings.announcement_font_size }}px;
  "
  data-qtm-header-three
  data-transparent-until-scroll="{% if transparent_until_scroll %}true{% else %}false{% endif %}"
>
  {% if announcement_enabled and announcement_text != blank %}
    <div class="qtmHeaderThree__announcement qtmHeaderThree__announcement--{{ section.settings.announcement_alignment }}">
      <div class="qtmHeaderThree__announcementInner">
        <p class="qtmHeaderThree__announcementText">
          <span>{{ announcement_text }}</span>

          {% if section.settings.announcement_link_label != blank and section.settings.announcement_link_url != blank %}
            <a class="qtmHeaderThree__announcementLink" href="{{ section.settings.announcement_link_url }}">
              {{ section.settings.announcement_link_label }}
            </a>
          {% endif %}
        </p>
      </div>
    </div>
  {% endif %}

  <header class="qtmHeaderThree__header" aria-label="Site header">
    <div class="qtmHeaderThree__inner">
      <button
        type="button"
        class="qtmHeaderThree__menuButton"
        aria-label="Open menu"
        aria-controls="HeaderThreeMobileMenu-{{ section.id }}"
        aria-expanded="false"
        data-qtm-h3-mobile-open
      >
        <span class="qtmHeaderThree__menuIcon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
        <span class="qtmHeaderThree__menuButtonText">Menu</span>
      </button>

      <div class="qtmHeaderThree__navArea qtmHeaderThree__navArea--left">
        <nav class="qtmHeaderThree__nav" aria-label="Primary navigation">
          {% if main_menu != blank %}
            {% for link in main_menu.links %}
              {% liquid
                assign has_dropdown = false
                if link.links != blank
                  assign has_dropdown = true
                endif
              %}

              <div class="qtmHeaderThree__navItem{% if has_dropdown %} qtmHeaderThree__navItem--hasDropdown{% endif %}">
                {% if has_dropdown %}
                  <button
                    type="button"
                    class="qtmHeaderThree__navLink qtmHeaderThree__navDropdownButton{% if link.active or link.child_active %} qtmHeaderThree__navLink--active{% endif %}"
                    aria-expanded="false"
                    aria-controls="HeaderThreeDropdown-{{ section.id }}-{{ forloop.index }}"
                    data-qtm-h3-dropdown-toggle
                  >
                    <span>{{ link.title }}</span>
                    <svg class="qtmHeaderThree__chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                      <path d="M1 1.25L6 6.25L11 1.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <div
                    id="HeaderThreeDropdown-{{ section.id }}-{{ forloop.index }}"
                    class="qtmHeaderThree__dropdown"
                    hidden
                    data-qtm-h3-dropdown-panel
                  >
                    <div class="qtmHeaderThree__dropdownInner">
                      <a
                        class="qtmHeaderThree__dropdownLink qtmHeaderThree__dropdownLink--parent"
                        href="{{ link.url }}"
                        {% if link.active %}aria-current="page"{% endif %}
                      >
                        View {{ link.title }}
                      </a>

                      {% for child_link in link.links %}
                        <a
                          class="qtmHeaderThree__dropdownLink{% if child_link.active %} qtmHeaderThree__dropdownLink--active{% endif %}"
                          href="{{ child_link.url }}"
                          {% if child_link.active %}aria-current="page"{% endif %}
                        >
                          {{ child_link.title }}
                        </a>
                      {% endfor %}
                    </div>
                  </div>
                {% else %}
                  <a
                    class="qtmHeaderThree__navLink{% if link.active %} qtmHeaderThree__navLink--active{% endif %}"
                    href="{{ link.url }}"
                    {% if link.active %}aria-current="page"{% endif %}
                  >
                    {{ link.title }}
                  </a>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </nav>
      </div>

      <a class="qtmHeaderThree__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <span class="qtmHeaderThree__logoWrap">
          {% if section.settings.transparent_logo != blank %}
            <img
              class="qtmHeaderThree__logo qtmHeaderThree__logo--transparent"
              src="{{ section.settings.transparent_logo | image_url: width: 700 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% endif %}

          {% if settings.logo_primary != blank %}
            <img
              class="qtmHeaderThree__logo qtmHeaderThree__logo--primary"
              src="{{ settings.logo_primary | image_url: width: 700 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% elsif settings.logo_mobile != blank %}
            <img
              class="qtmHeaderThree__logo qtmHeaderThree__logo--primary"
              src="{{ settings.logo_mobile | image_url: width: 700 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% else %}
            <span class="qtmHeaderThree__brandText">{{ shop.name }}</span>
          {% endif %}
        </span>
      </a>

      <div class="qtmHeaderThree__navArea qtmHeaderThree__navArea--below">
        <nav class="qtmHeaderThree__nav qtmHeaderThree__nav--below" aria-label="Secondary primary navigation">
          {% if main_menu != blank %}
            {% for link in main_menu.links %}
              <a
                class="qtmHeaderThree__navLink{% if link.active or link.child_active %} qtmHeaderThree__navLink--active{% endif %}"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            {% endfor %}
          {% endif %}
        </nav>
      </div>

      <div class="qtmHeaderThree__actions">
        {% if search_display == 'search_button' %}
          {% if search_button_action == 'popup' and settings.enable_search_popup %}
            <button
              type="button"
              class="qtmHeaderThree__action qtmHeaderThree__action--search"
              data-search-popup-open
              aria-label="Open search"
              aria-haspopup="dialog"
            >
              <svg class="qtmHeaderThree__actionIcon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
              <span class="qtmHeaderThree__actionText">Search</span>
            </button>
          {% else %}
            <a
              href="{{ routes.search_url }}"
              class="qtmHeaderThree__action qtmHeaderThree__action--search"
              aria-label="Go to search page"
            >
              <svg class="qtmHeaderThree__actionIcon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7"/>
                <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
              <span class="qtmHeaderThree__actionText">Search</span>
            </a>
          {% endif %}
        {% endif %}

        {% if section.settings.show_account %}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="qtmHeaderThree__action qtmHeaderThree__action--account qtmHeaderThree__action--{{ account_display }}"
            aria-label="{% if customer %}Account{% else %}Sign in{% endif %}"
          >
            <svg class="qtmHeaderThree__actionIcon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.7"/>
              <path d="M5 20C5.75 16.5 8.25 14.55 12 14.55C15.75 14.55 18.25 16.5 19 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <span class="qtmHeaderThree__actionText">
              {% if customer %}Account{% else %}Sign in{% endif %}
            </span>
          </a>
        {% endif %}

        <button
          type="button"
          class="qtmHeaderThree__action qtmHeaderThree__action--cart qtmHeaderThree__action--{{ cart_display }}"
          data-cart-drawer-open
          aria-label="Open cart"
        >
          <svg class="qtmHeaderThree__actionIcon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.5 7.5H19.5L18.25 17H7.75L6.5 7.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M9 7.5C9 4.95 10.15 3.5 12 3.5C13.85 3.5 15 4.95 15 7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
          <span class="qtmHeaderThree__actionText">Bag</span>
          <span class="qtmHeaderThree__cartCount" data-cart-count>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </header>

  <div
    id="HeaderThreeMobileMenu-{{ section.id }}"
    class="qtmHeaderThree__mobile"
    hidden
    aria-hidden="true"
    data-qtm-h3-mobile-panel
  >
    <div class="qtmHeaderThree__mobileOverlay" data-qtm-h3-mobile-close></div>

    <div class="qtmHeaderThree__mobileDialog" role="dialog" aria-modal="true" aria-label="Mobile navigation">
      <div class="qtmHeaderThree__mobileHeader">
        <a class="qtmHeaderThree__mobileBrand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if settings.logo_primary != blank %}
            <img
              class="qtmHeaderThree__mobileLogo"
              src="{{ settings.logo_primary | image_url: width: 500 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% elsif settings.logo_mobile != blank %}
            <img
              class="qtmHeaderThree__mobileLogo"
              src="{{ settings.logo_mobile | image_url: width: 500 }}"
              alt="{{ shop.name | escape }}"
              loading="eager"
            >
          {% else %}
            <span class="qtmHeaderThree__mobileBrandText">{{ shop.name }}</span>
          {% endif %}
        </a>

        <button
          type="button"
          class="qtmHeaderThree__mobileClose"
          aria-label="Close menu"
          data-qtm-h3-mobile-close
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <nav class="qtmHeaderThree__mobileNav" aria-label="Mobile navigation">
        {% if main_menu != blank %}
          {% for link in main_menu.links %}
            <div class="qtmHeaderThree__mobileItem">
              <a
                class="qtmHeaderThree__mobileLink{% if link.active or link.child_active %} qtmHeaderThree__mobileLink--active{% endif %}"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>

              {% if link.links != blank %}
                <div class="qtmHeaderThree__mobileChildren">
                  {% for child_link in link.links %}
                    <a
                      class="qtmHeaderThree__mobileChildLink{% if child_link.active %} qtmHeaderThree__mobileChildLink--active{% endif %}"
                      href="{{ child_link.url }}"
                      {% if child_link.active %}aria-current="page"{% endif %}
                    >
                      {{ child_link.title }}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </nav>

      <div class="qtmHeaderThree__mobileActions">
        {% if search_display == 'search_button' %}
          {% if search_button_action == 'popup' and settings.enable_search_popup %}
            <button
              type="button"
              class="qtmHeaderThree__mobileAction"
              data-search-popup-open
              aria-label="Open search"
              aria-haspopup="dialog"
            >
              Search
            </button>
          {% else %}
            <a class="qtmHeaderThree__mobileAction" href="{{ routes.search_url }}">
              Search
            </a>
          {% endif %}
        {% endif %}

        {% if section.settings.show_account %}
          <a class="qtmHeaderThree__mobileAction" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
            {% if customer %}Account{% else %}Sign in{% endif %}
          </a>
        {% endif %}

        <button type="button" class="qtmHeaderThree__mobileAction" data-cart-drawer-open>
          Bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
        </button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'header-three.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header Three",
  "class": "qtm-header-three-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "default": "menu_left_logo_center",
      "options": [
        { "value": "center_logo", "label": "Center logo" },
        { "value": "menu_left_logo_center", "label": "Menu left, logo center" },
        { "value": "logo_center_nav_below", "label": "Logo center, nav below" },
        { "value": "minimal_split", "label": "Minimal split" }
      ]
    },
    {
      "type": "select",
      "id": "header_width",
      "label": "Header width",
      "default": "wide",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "select",
      "id": "background_mode",
      "label": "Background mode",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "transparent", "label": "Transparent overlay" },
        { "value": "transparent_until_scroll", "label": "Transparent until scroll" }
      ]
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky mode",
      "default": "sticky_shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sticky", "label": "Sticky" },
        { "value": "sticky_shadow", "label": "Sticky with shadow" },
        { "value": "transparent_to_solid", "label": "Transparent to solid" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_menu_style",
      "label": "Mobile menu style",
      "default": "fullscreen",
      "options": [
        { "value": "drawer", "label": "Drawer" },
        { "value": "fullscreen", "label": "Fullscreen" },
        { "value": "minimal", "label": "Minimal" }
      ]
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "checkbox",
      "id": "announcement_enable",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Complimentary shipping on select orders"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement link label"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link URL"
    },
    {
      "type": "select",
      "id": "announcement_alignment",
      "label": "Announcement alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "announcement_font_size",
      "label": "Announcement font size",
      "min": 11,
      "max": 16,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "transparent_logo",
      "label": "Transparent header logo"
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Desktop logo height",
      "min": 18,
      "max": 110,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Mobile logo height",
      "min": 18,
      "max": 70,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Store name size",
      "min": 18,
      "max": 44,
      "step": 1,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "select",
      "id": "search_display",
      "label": "Search display",
      "default": "search_button",
      "options": [
        { "value": "none", "label": "No search" },
        { "value": "search_button", "label": "Search button" }
      ]
    },
    {
      "type": "select",
      "id": "search_button_action",
      "label": "Search button action",
      "default": "popup",
      "options": [
        { "value": "popup", "label": "Open popup" },
        { "value": "page", "label": "Go to search page" }
      ]
    },
    {
      "type": "header",
      "content": "Account"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "select",
      "id": "account_display",
      "label": "Account display",
      "default": "icon",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "text", "label": "Text" },
        { "value": "icon_text", "label": "Icon and text" }
      ]
    },
    {
      "type": "header",
      "content": "Cart"
    },
    {
      "type": "select",
      "id": "cart_display",
      "label": "Cart display",
      "default": "icon",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "icon_text", "label": "Icon and text" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "header_link",
      "label": "Header links",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "header_link_hover",
      "label": "Header link hover",
      "default": "#7a5c3a"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Header border",
      "default": "#e8e2d8"
    },
    {
      "type": "color",
      "id": "transparent_text",
      "label": "Transparent text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "transparent_link",
      "label": "Transparent links",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dropdown_bg",
      "label": "Dropdown background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dropdown_text",
      "label": "Dropdown text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "dropdown_border",
      "label": "Dropdown border",
      "default": "#e8e2d8"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
