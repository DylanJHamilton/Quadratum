    },
    {
      "type": "select",
      "id": "testimonial_2_rating",
      "label": "Rating",
      "default": "5",
      "options": [
        {
          "value": "none",
          "label": "No rating"
        },
        {
          "value": "1",
          "label": "1 star"
        },
        {
          "value": "2",
          "label": "2 stars"
        },
        {
          "value": "3",
          "label": "3 stars"
        },
        {
          "value": "4",
