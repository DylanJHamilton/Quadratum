{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-scrolling-text
    qtm-scrolling-text-{{ block_id }}
    qtm-scrolling-text--width-{{ block_width }}
    qtm-scrolling-text--align-{{ block_alignment }}
    qtm-scrolling-text--style-{{ block.settings.text_style }}
    qtm-scrolling-text--mode-{{ block.settings.motion_mode }}
    qtm-scrolling-text--direction-{{ block.settings.direction }}
    qtm-scrolling-text--animation-{{ animation }}
    {% if block.settings.pause_on_hover %} qtm-scrolling-text--pause-hover{% endif %}
    {% unless block.settings.show_desktop %} qtm-scrolling-text--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-scrolling-text--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-scrolling-text--hide-mobile{% endunless %}
  "
  style="
    --qtm-scrolling-text-margin-top: {{ block.settings.margin_top }}px;
    --qtm-scrolling-text-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-scrolling-text-padding: {{ block.settings.padding }}px;
    --qtm-scrolling-text-gap: {{ block.settings.gap }}px;
    --qtm-scrolling-text-speed: {{ block.settings.speed }}s;
    --qtm-scrolling-text-heading-color: {{ block.settings.heading_color }};
    --qtm-scrolling-text-text-color: {{ block.settings.text_color }};
    --qtm-scrolling-text-background-color: {{ block.settings.background_color }};
    --qtm-scrolling-text-border-color: {{ block.settings.border_color }};
    --qtm-scrolling-text-link-color: {{ block.settings.link_color }};
    --qtm-scrolling-text-accent-color: {{ block.settings.accent_color }};
    --qtm-scrolling-text-outline-width: {{ block.settings.outline_width }}px;
    --qtm-scrolling-text-font-size: {{ block.settings.desktop_text_size }}px;
    --qtm-scrolling-text-mobile-font-size: {{ block.settings.mobile_text_size }}px;
    --qtm-scrolling-text-letter-spacing: {{ block.settings.letter_spacing }}em;
    --qtm-scrolling-text-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
    --qtm-scrolling-text-border-width: {{ block.settings.border_width }}px;
    --qtm-scrolling-text-border-radius: {{ block.settings.border_radius }}px;
  "
  aria-label="{{ block.settings.accessibility_label | default: block.settings.display_text | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="qtm-scrolling-text__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank or block.settings.cta_text != blank %}
      <div class="qtm-scrolling-text__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-scrolling-text__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-scrolling-text__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-scrolling-text__supporting-text">
            {{ block.settings.text }}
          </div>
        {% endif %}

        {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
          <a class="qtm-scrolling-text__button" href="{{ block.settings.cta_url }}">
            {{ block.settings.cta_text | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-scrolling-text__viewport">
      {% if block.settings.motion_mode == 'static' %}
        <div class="qtm-scrolling-text__static">
          <span class="qtm-scrolling-text__display">
            {{ block.settings.display_text | escape }}
          </span>
        </div>
      {% else %}
        <div class="qtm-scrolling-text__track">
          {% for repeat in (1..2) %}
            <div class="qtm-scrolling-text__group" {% if repeat == 2 %}aria-hidden="true"{% endif %}>
              {% for i in (1..6) %}
                <span class="qtm-scrolling-text__display">
                  {{ block.settings.display_text | escape }}
                </span>

                {% if block.settings.show_separator %}
                  <span class="qtm-scrolling-text__separator" aria-hidden="true">
                    {{ block.settings.separator_text | escape }}
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .qtm-scrolling-text-{{ block_id }} {
    margin-top: var(--qtm-scrolling-text-margin-top);
    margin-bottom: var(--qtm-scrolling-text-margin-bottom);
    padding: var(--qtm-scrolling-text-padding);
    color: var(--qtm-scrolling-text-text-color);
    background: var(--qtm-scrolling-text-background-color);
    border: var(--qtm-scrolling-text-border-width) solid var(--qtm-scrolling-text-border-color);
    border-radius: var(--qtm-scrolling-text-border-radius);
    overflow: hidden;
  }

  .qtm-scrolling-text-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--width-auto {
    width: auto;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--width-small {
    max-width: 720px;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--width-medium {
    max-width: 960px;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--width-large {
    max-width: 1240px;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__inner {
    display: grid;
    gap: var(--qtm-scrolling-text-gap);
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__header {
    display: grid;
    gap: 0.75rem;
    max-width: 780px;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-center .qtm-scrolling-text__header {
    margin-inline: auto;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-right .qtm-scrolling-text__header {
    margin-left: auto;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__eyebrow {
    margin: 0;
    color: var(--qtm-scrolling-text-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__heading {
    margin: 0;
    color: var(--qtm-scrolling-text-heading-color);
    line-height: 1.05;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__supporting-text {
    color: var(--qtm-scrolling-text-text-color);
    line-height: 1.7;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__supporting-text p {
    margin-top: 0;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__supporting-text p:last-child {
    margin-bottom: 0;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.9rem;
    margin-top: 0.25rem;
    padding: 0.9rem 1.25rem;
    color: #ffffff;
    background: var(--qtm-scrolling-text-link-color);
    border: 1px solid var(--qtm-scrolling-text-link-color);
    border-radius: 999px;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-center .qtm-scrolling-text__button {
    justify-self: center;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-right .qtm-scrolling-text__button {
    justify-self: end;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__button:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__button:focus-visible {
    outline: 3px solid var(--qtm-scrolling-text-link-color);
    outline-offset: 4px;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-block: {{ block.settings.display_padding_vertical }}px;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__viewport::before,
  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__viewport::after {
    content: "";
    position: absolute;
    top: 0;
    z-index: 3;
    width: min(10vw, 110px);
    height: 100%;
    pointer-events: none;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--qtm-scrolling-text-background-color), transparent);
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--qtm-scrolling-text-background-color), transparent);
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--mode-static .qtm-scrolling-text__viewport::before,
  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--mode-static .qtm-scrolling-text__viewport::after {
    display: none;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__static {
    display: flex;
    justify-content: inherit;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-left .qtm-scrolling-text__static {
    justify-content: flex-start;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-center .qtm-scrolling-text__static {
    justify-content: center;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--align-right .qtm-scrolling-text__static {
    justify-content: flex-end;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__track {
    display: flex;
    width: max-content;
    animation: qtm-scrolling-text-scroll-{{ block_id }} var(--qtm-scrolling-text-speed) linear infinite;
    will-change: transform;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--direction-right .qtm-scrolling-text__track {
    animation-name: qtm-scrolling-text-scroll-reverse-{{ block_id }};
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--pause-hover:hover .qtm-scrolling-text__track,
  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--pause-hover:focus-within .qtm-scrolling-text__track {
    animation-play-state: paused;
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--qtm-scrolling-text-gap);
    min-width: max-content;
    padding-right: var(--qtm-scrolling-text-gap);
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__display {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    color: var(--qtm-scrolling-text-heading-color);
    font-size: var(--qtm-scrolling-text-font-size);
    font-weight: {{ block.settings.text_weight }};
    letter-spacing: var(--qtm-scrolling-text-letter-spacing);
    line-height: var(--qtm-scrolling-text-line-height);
    text-transform: {% if block.settings.uppercase_text %}uppercase{% else %}none{% endif %};
    white-space: nowrap;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--style-outline .qtm-scrolling-text__display {
    color: transparent;
    -webkit-text-stroke: var(--qtm-scrolling-text-outline-width) var(--qtm-scrolling-text-heading-color);
    text-stroke: var(--qtm-scrolling-text-outline-width) var(--qtm-scrolling-text-heading-color);
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--style-mixed .qtm-scrolling-text__display:nth-child(odd) {
    color: var(--qtm-scrolling-text-heading-color);
    -webkit-text-stroke: 0 transparent;
    text-stroke: 0 transparent;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--style-mixed .qtm-scrolling-text__display:nth-child(even) {
    color: transparent;
    -webkit-text-stroke: var(--qtm-scrolling-text-outline-width) var(--qtm-scrolling-text-accent-color);
    text-stroke: var(--qtm-scrolling-text-outline-width) var(--qtm-scrolling-text-accent-color);
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--style-accent .qtm-scrolling-text__display {
    color: var(--qtm-scrolling-text-accent-color);
  }

  .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__separator {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    color: var(--qtm-scrolling-text-accent-color);
    font-size: calc(var(--qtm-scrolling-text-font-size) * 0.42);
    font-weight: 800;
    line-height: 1;
    opacity: 0.75;
  }

  @keyframes qtm-scrolling-text-scroll-{{ block_id }} {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @keyframes qtm-scrolling-text-scroll-reverse-{{ block_id }} {
    from {
      transform: translateX(-50%);
    }

    to {
      transform: translateX(0);
    }
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--animation-fade {
    animation: qtm-scrolling-text-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--animation-fade-up {
    animation: qtm-scrolling-text-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--animation-fade-down {
    animation: qtm-scrolling-text-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--animation-fade-left {
    animation: qtm-scrolling-text-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--animation-fade-right {
    animation: qtm-scrolling-text-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--animation-zoom {
    animation: qtm-scrolling-text-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-scrolling-text-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-scrolling-text-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-scrolling-text-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-scrolling-text-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-scrolling-text-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-scrolling-text-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--hide-tablet {
      display: none !important;
    }

    .qtm-scrolling-text-{{ block_id }} {
      --qtm-scrolling-text-font-size: clamp(var(--qtm-scrolling-text-mobile-font-size), 12vw, {{ block.settings.tablet_text_size }}px);
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-scrolling-text-{{ block_id }} {
      padding: min(var(--qtm-scrolling-text-padding), 24px);
      --qtm-scrolling-text-font-size: var(--qtm-scrolling-text-mobile-font-size);
    }

    .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--hide-mobile {
      display: none !important;
    }

    .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__viewport {
      padding-block: min({{ block.settings.display_padding_vertical }}px, 22px);
    }

    .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__display {
      white-space: nowrap;
    }

    .qtm-scrolling-text-{{ block_id }}.qtm-scrolling-text--mode-static .qtm-scrolling-text__display {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-scrolling-text-{{ block_id }},
    .qtm-scrolling-text-{{ block_id }} *,
    .qtm-scrolling-text-{{ block_id }} *::before,
    .qtm-scrolling-text-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }

    .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__track {
      width: 100%;
      transform: none !important;
    }

    .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__group {
      flex-wrap: wrap;
      width: 100%;
      min-width: 0;
      justify-content: center;
      padding-right: 0;
    }

    .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__group[aria-hidden="true"] {
      display: none;
    }

    .qtm-scrolling-text-{{ block_id }} .qtm-scrolling-text__display {
      white-space: normal;
    }
  }
</style>

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    {
      "type": "header",
      "content": "Supporting content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Display text"
    },
    {
      "type": "text",
      "id": "display_text",
      "label": "Display text",
      "default": "Built for modern commerce"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Large campaign message"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "default": "filled",
      "options": [
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "mixed",
          "label": "Mixed filled and outline"
        },
        {
          "value": "accent",
          "label": "Accent color"
        }
      ]
    },
    {
      "type": "select",
      "id": "motion_mode",
      "label": "Motion mode",
      "default": "scroll",
      "options": [
        {
          "value": "scroll",
          "label": "Scrolling"
        },
        {
          "value": "static",
          "label": "Static"
        }
      ]
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 8,
      "max": 90,
      "step": 2,
      "unit": "s",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover or focus",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Separator",
      "default": "•"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "label": "Desktop text size",
      "min": 36,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "tablet_text_size",
      "label": "Tablet text size",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "default": "800",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
