{%- comment -%}Account web links only. Return an unescaped URL; callers escape the attribute.{%- endcomment -%}
{%- liquid
  assign candidate = url | strip
  assign normalized = candidate | downcase
  assign encoded = candidate | url_encode | downcase
  assign first = normalized | slice: 0, 1
  assign second = normalized | slice: 1, 1
  assign https_prefix = normalized | slice: 0, 8
  assign http_prefix = normalized | slice: 0, 7
  assign allowed = false
  if first == '/' and second != '/'
    assign allowed = true
  elsif https_prefix == 'https://' or http_prefix == 'http://'
    assign authority = candidate | split: '://' | last | split: '/' | first | split: '?' | first | split: '#' | first
    unless authority == blank or authority contains '@'
      assign allowed = true
    endunless
  endif
  if encoded contains '%5c' or encoded contains '%0a' or encoded contains '%0d' or encoded contains '%09' or encoded contains '%00'
    assign allowed = false
  endif
  if allowed
    echo candidate
  endif
-%}
