{%- liquid
  assign column_tag = block.settings.column_tag | default: 'div'
  assign column_label = block.settings.accessibility_label
  assign column_role = block.settings.column_role | default: 'none'
  assign vertical_alignment = block.settings.vertical_alignment | default: 'top'
  assign horizontal_alignment = block.settings.horizontal_alignment | default: 'left'

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<{{ column_tag }}
  id="qtm-layout-column-{{ block.id }}"
  class="
    qtm-layout-column
    qtm-layout-column--valign-{{ vertical_alignment }}
    qtm-layout-column--halign-{{ horizontal_alignment }}
    {% if block.settings.full_height %} qtm-layout-column--full-height{% endif %}
    {% unless show_desktop %} qtm-layout-column--hide-desktop{% endunless %}
    {% unless show_tablet %} qtm-layout-column--hide-tablet{% endunless %}
    {% unless show_mobile %} qtm-layout-column--hide-mobile{% endunless %}
  "
  {% if column_role != 'none' %}
    role="{{ column_role }}"
  {% endif %}
  {% if column_label != blank %}
    aria-label="{{ column_label | escape }}"
  {% endif %}
  style="
    {% if block.settings.background_gradient != blank %}
      --qtm-layout-column-background: {{ block.settings.background_gradient }};
    {% else %}
      --qtm-layout-column-background: {{ block.settings.background_color }};
    {% endif %}
    --qtm-layout-column-border-width: {{ block.settings.border_width }}px;
    --qtm-layout-column-border-color: {{ block.settings.border_color }};
    --qtm-layout-column-radius: {{ block.settings.border_radius }}px;
    --qtm-layout-column-padding-top: {{ block.settings.padding_top }}px;
    --qtm-layout-column-padding-bottom: {{ block.settings.padding_bottom }}px;
    --qtm-layout-column-padding-left: {{ block.settings.padding_left }}px;
    --qtm-layout-column-padding-right: {{ block.settings.padding_right }}px;
    --qtm-layout-column-min-height: {{ block.settings.min_height }}px;
    --qtm-layout-column-shadow: {% if block.settings.shadow %}0 18px 60px rgba(0, 0, 0, 0.10){% else %}none{% endif %};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #qtm-layout-column-{{ block.id }} {
      min-width: 0;
      min-height: var(--qtm-layout-column-min-height, 0);
      background: var(--qtm-layout-column-background, transparent);
      border: var(--qtm-layout-column-border-width, 0) solid var(--qtm-layout-column-border-color, transparent);
      border-radius: var(--qtm-layout-column-radius, 0);
      padding-top: var(--qtm-layout-column-padding-top, 0);
      padding-bottom: var(--qtm-layout-column-padding-bottom, 0);
      padding-left: var(--qtm-layout-column-padding-left, 0);
      padding-right: var(--qtm-layout-column-padding-right, 0);
      box-shadow: var(--qtm-layout-column-shadow, none);
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--full-height {
      height: 100%;
    }

    #qtm-layout-column-{{ block.id }} > .qtm-layout-column__inner {
      min-width: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--valign-top > .qtm-layout-column__inner {
      justify-content: flex-start;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--valign-center > .qtm-layout-column__inner {
      justify-content: center;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--valign-bottom > .qtm-layout-column__inner {
      justify-content: flex-end;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--valign-stretch > .qtm-layout-column__inner {
      justify-content: stretch;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--halign-left > .qtm-layout-column__inner {
      align-items: flex-start;
      text-align: left;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--halign-center > .qtm-layout-column__inner {
      align-items: center;
      text-align: center;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--halign-right > .qtm-layout-column__inner {
      align-items: flex-end;
      text-align: right;
    }

    #qtm-layout-column-{{ block.id }}.qtm-layout-column--halign-stretch > .qtm-layout-column__inner {
      align-items: stretch;
      text-align: inherit;
    }

    #qtm-layout-column-{{ block.id }} .qtm-content-block {
      width: 100%;
    }

    #qtm-layout-column-{{ block.id }} .qtm-layout-column__placeholder {
      width: 100%;
      padding: 24px;
      border: 1px dashed rgba(0, 0, 0, 0.25);
      border-radius: 14px;
      text-align: center;
      color: rgba(0, 0, 0, 0.65);
      background: rgba(0, 0, 0, 0.03);
    }

    @media screen and (min-width: 990px) {
      #qtm-layout-column-{{ block.id }}.qtm-layout-column--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #qtm-layout-column-{{ block.id }}.qtm-layout-column--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #qtm-layout-column-{{ block.id }}.qtm-layout-column--hide-mobile {
        display: none !important;
      }
    }
  </style>

  <div class="qtm-layout-column__inner">
    {% content_for 'blocks' %}

    {% if request.design_mode and block.blocks.size == 0 %}
      <div class="qtm-layout-column__placeholder">
        Add content blocks inside this column.
      </div>
    {% endif %}
  </div>
</{{ column_tag }}>

{% schema %}
{
  "name": "Layout column",
  "blocks": [
    {
      "type": "content-heading"
    },
    {
      "type": "content-rich-text"
    },
    {
      "type": "content-button"
    },
    {
      "type": "content-button-group"
    },
    {
      "type": "content-divider"
    },
    {
      "type": "content-spacer"
    },
    {
      "type": "content-icon"
    },
    {
      "type": "content-icon-list"
    },
    {
      "type": "content-badge"
    },
    {
      "type": "content-quote"
    },
    {
      "type": "content-alert"
    },
    {
      "type": "content-code"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Column"
    },
    {
      "type": "select",
      "id": "column_tag",
      "label": "HTML tag",
      "default": "div",
      "options": [
        {
          "value": "div",
          "label": "Div"
        },
        {
          "value": "section",
          "label": "Section"
        },
        {
          "value": "article",
          "label": "Article"
        },
        {
          "value": "aside",
          "label": "Aside"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_role",
      "label": "ARIA role",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "region",
          "label": "Region"
        },
        {
          "value": "group",
          "label": "Group"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ]
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full height",
      "default": true
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Column style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Column padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Layout column"
    },
    {
      "name": "Card column",
      "settings": {
        "background_color": "#ffffff",
        "border_width": 1,
        "border_color": "#e5e5e5",
        "border_radius": 20,
        "shadow": true,
        "padding_top": 32,
        "padding_bottom": 32,
        "padding_left": 32,
        "padding_right": 32
      }
    },
    {
      "name": "Centered column",
      "settings": {
        "vertical_alignment": "center",
        "horizontal_alignment": "center",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#e5e5e5",
        "border_radius": 0,
        "shadow": false,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0
      }
    }
  ]
}
{% endschema %}