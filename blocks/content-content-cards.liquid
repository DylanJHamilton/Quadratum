{%- liquid
  assign block_id = 'content-content-cards-' | append: block.id

  assign alignment = block.settings.alignment | default: 'left'
  assign width = block.settings.width | default: 'auto'
  assign layout_style = block.settings.layout_style | default: 'stacked'
  assign desktop_columns = block.settings.desktop_columns | default: '3'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign card_count = block.settings.card_count | default: 3

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-content-cards
    content-content-cards--{{ layout_style }}
    content-content-cards--align-{{ alignment }}
    content-content-cards--width-{{ width }}
    content-content-cards--desktop-{{ desktop_columns }}
    content-content-cards--mobile-{{ mobile_columns }}
    {% unless show_desktop %} content-content-cards--hide-desktop{% endunless %}
    {% unless show_tablet %} content-content-cards--hide-tablet{% endunless %}
    {% unless show_mobile %} content-content-cards--hide-mobile{% endunless %}
    {% if block.settings.animation != 'none' %} content-content-cards--animate content-content-cards--animate-{{ block.settings.animation }}{% endif %}
  "
  style="
    --content-content-cards-margin-top: {{ block.settings.margin_top }}px;
    --content-content-cards-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-content-cards-padding-top: {{ block.settings.padding_top }}px;
    --content-content-cards-padding-bottom: {{ block.settings.padding_bottom }}px;
    --content-content-cards-padding-left: {{ block.settings.padding_left }}px;
    --content-content-cards-padding-right: {{ block.settings.padding_right }}px;
    --content-content-cards-gap: {{ block.settings.gap }}px;
    --content-content-cards-card-padding: {{ block.settings.card_padding }}px;
    --content-content-cards-card-radius: {{ block.settings.border_radius }}px;
    --content-content-cards-border-width: {{ block.settings.border_width }}px;
    --content-content-cards-image-radius: {{ block.settings.image_radius }}px;
    --content-content-cards-heading-color: {{ block.settings.heading_color }};
    --content-content-cards-text-color: {{ block.settings.text_color }};
    --content-content-cards-link-color: {{ block.settings.link_color }};
    --content-content-cards-background-color: {{ block.settings.background_color }};
    --content-content-cards-card-background-color: {{ block.settings.card_background_color }};
    --content-content-cards-border-color: {{ block.settings.border_color }};
    --content-content-cards-badge-background: {{ block.settings.badge_background_color }};
    --content-content-cards-badge-text: {{ block.settings.badge_text_color }};
    --content-content-cards-overlay-color: {{ block.settings.overlay_color }};
    --content-content-cards-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-content-cards-margin-top);
      margin-bottom: var(--content-content-cards-margin-bottom);
      padding-top: var(--content-content-cards-padding-top);
      padding-bottom: var(--content-content-cards-padding-bottom);
      padding-left: var(--content-content-cards-padding-left);
      padding-right: var(--content-content-cards-padding-right);
      background: var(--content-content-cards-background-color);
      color: var(--content-content-cards-text-color);
    }

    #{{ block_id }}.content-content-cards--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-content-cards--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-content-cards--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-content-cards--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-content-cards--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-content-cards--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-content-cards--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-content-cards--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-content-cards__grid {
      display: grid;
      gap: var(--content-content-cards-gap);
      width: 100%;
    }

    #{{ block_id }}.content-content-cards--desktop-1 .content-content-cards__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.content-content-cards--desktop-2 .content-content-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.content-content-cards--desktop-3 .content-content-cards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.content-content-cards--desktop-4 .content-content-cards__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }} .content-content-cards__item {
      position: relative;
      min-width: 0;
      display: flex;
      overflow: hidden;
      color: var(--content-content-cards-text-color);
      background: var(--content-content-cards-card-background-color);
      border: var(--content-content-cards-border-width) solid var(--content-content-cards-border-color);
      border-radius: var(--content-content-cards-card-radius);
    }

    #{{ block_id }}.content-content-cards--stacked .content-content-cards__item,
    #{{ block_id }}.content-content-cards--minimal .content-content-cards__item {
      flex-direction: column;
    }

    #{{ block_id }}.content-content-cards--horizontal .content-content-cards__item {
      flex-direction: row;
      align-items: stretch;
    }

    #{{ block_id }}.content-content-cards--overlay .content-content-cards__item {
      min-height: 360px;
      align-items: flex-end;
      background: #111111;
    }

    #{{ block_id }}.content-content-cards--minimal .content-content-cards__item {
      background: transparent;
      border-color: transparent;
      border-radius: 0;
    }

    #{{ block_id }} .content-content-cards__media {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.04);
    }

    #{{ block_id }}.content-content-cards--horizontal .content-content-cards__media {
      width: 42%;
      flex: 0 0 42%;
    }

    #{{ block_id }}.content-content-cards--overlay .content-content-cards__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    #{{ block_id }}.content-content-cards--minimal .content-content-cards__media {
      border-radius: var(--content-content-cards-image-radius);
    }

    #{{ block_id }} .content-content-cards__image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: var(--content-content-cards-image-radius);
    }

    #{{ block_id }}.content-content-cards--stacked .content-content-cards__image {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 0;
    }

    #{{ block_id }}.content-content-cards--horizontal .content-content-cards__image {
      height: 100%;
      min-height: 260px;
      object-fit: cover;
      border-radius: 0;
    }

    #{{ block_id }}.content-content-cards--overlay .content-content-cards__image {
      height: 100%;
      object-fit: cover;
      border-radius: 0;
    }

    #{{ block_id }} .content-content-cards__overlay {
      display: none;
    }

    #{{ block_id }}.content-content-cards--overlay .content-content-cards__overlay {
      display: block;
      position: absolute;
      inset: 0;
      background: var(--content-content-cards-overlay-color);
      opacity: var(--content-content-cards-overlay-opacity);
      z-index: 1;
      pointer-events: none;
    }

    #{{ block_id }} .content-content-cards__body {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
      padding: var(--content-content-cards-card-padding);
    }

    #{{ block_id }}.content-content-cards--minimal .content-content-cards__body {
      padding-left: 0;
      padding-right: 0;
      padding-bottom: 0;
    }

    #{{ block_id }}.content-content-cards--overlay .content-content-cards__body {
      color: #ffffff;
    }

    #{{ block_id }} .content-content-cards__badge,
    #{{ block_id }} .content-content-cards__eyebrow {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      align-items: center;
      line-height: 1.2;
    }

    #{{ block_id }} .content-content-cards__badge {
      padding: 7px 11px;
      border-radius: 999px;
      background: var(--content-content-cards-badge-background);
      color: var(--content-content-cards-badge-text);
    }

    #{{ block_id }} .content-content-cards__eyebrow {
      color: var(--content-content-cards-link-color);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.78em;
    }

    #{{ block_id }}.content-content-cards--overlay .content-content-cards__eyebrow,
    #{{ block_id }}.content-content-cards--overlay .content-content-cards__heading,
    #{{ block_id }}.content-content-cards--overlay .content-content-cards__text,
    #{{ block_id }}.content-content-cards--overlay .content-content-cards__button {
      color: #ffffff;
    }

    #{{ block_id }} .content-content-cards__heading {
      margin: 0;
      color: var(--content-content-cards-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .content-content-cards__text {
      margin: 0;
      color: var(--content-content-cards-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-content-cards__text p {
      margin-top: 0;
    }

    #{{ block_id }} .content-content-cards__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-content-cards__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      color: var(--content-content-cards-link-color);
      text-decoration: none;
      line-height: 1.2;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
    }

    #{{ block_id }}.content-content-cards--align-center .content-content-cards__badge,
    #{{ block_id }}.content-content-cards--align-center .content-content-cards__eyebrow,
    #{{ block_id }}.content-content-cards--align-center .content-content-cards__button {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-content-cards--align-right .content-content-cards__badge,
    #{{ block_id }}.content-content-cards--align-right .content-content-cards__eyebrow,
    #{{ block_id }}.content-content-cards--align-right .content-content-cards__button {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-content-cards__button:hover {
      opacity: 0.72;
    }

    #{{ block_id }}.content-content-cards--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-content-cards--animate-fade {
      animation-name: contentContentCardsFade;
    }

    #{{ block_id }}.content-content-cards--animate-fade-up {
      animation-name: contentContentCardsFadeUp;
    }

    #{{ block_id }}.content-content-cards--animate-fade-down {
      animation-name: contentContentCardsFadeDown;
    }

    #{{ block_id }}.content-content-cards--animate-fade-left {
      animation-name: contentContentCardsFadeLeft;
    }

    #{{ block_id }}.content-content-cards--animate-fade-right {
      animation-name: contentContentCardsFadeRight;
    }

    #{{ block_id }}.content-content-cards--animate-zoom {
      animation-name: contentContentCardsZoom;
    }

    @keyframes contentContentCardsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentContentCardsFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentContentCardsFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentContentCardsFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentContentCardsFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentContentCardsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-content-cards--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-content-cards--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-content-cards--desktop-3 .content-content-cards__grid,
      #{{ block_id }}.content-content-cards--desktop-4 .content-content-cards__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.content-content-cards--horizontal .content-content-cards__item {
        flex-direction: column;
      }

      #{{ block_id }}.content-content-cards--horizontal .content-content-cards__media {
        width: 100%;
        flex-basis: auto;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-content-cards--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-content-cards--mobile-1 .content-content-cards__grid {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-content-cards--mobile-2 .content-content-cards__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.content-content-cards--horizontal .content-content-cards__item {
        flex-direction: column;
      }

      #{{ block_id }}.content-content-cards--horizontal .content-content-cards__media {
        width: 100%;
        flex-basis: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-content-cards--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="content-content-cards__grid">
    {%- for index in (1..8) -%}
      {%- if index <= card_count -%}
        {%- liquid
          assign image_key = 'card_' | append: index | append: '_image'
          assign image_alt_key = 'card_' | append: index | append: '_image_alt'
          assign eyebrow_key = 'card_' | append: index | append: '_eyebrow'
          assign badge_key = 'card_' | append: index | append: '_badge'
          assign heading_key = 'card_' | append: index | append: '_heading'
          assign text_key = 'card_' | append: index | append: '_text'
          assign button_label_key = 'card_' | append: index | append: '_button_label'
          assign button_url_key = 'card_' | append: index | append: '_button_url'

          assign card_image = block.settings[image_key]
          assign card_image_alt = block.settings[image_alt_key]
          assign card_eyebrow = block.settings[eyebrow_key]
          assign card_badge = block.settings[badge_key]
          assign card_heading = block.settings[heading_key]
          assign card_text = block.settings[text_key]
          assign card_button_label = block.settings[button_label_key]
          assign card_button_url = block.settings[button_url_key]
        -%}

        <article class="content-content-cards__item">
          {% if card_image != blank %}
            <div class="content-content-cards__media">
              {{
                card_image
                | image_url: width: 1100
                | image_tag:
                  class: 'content-content-cards__image',
                  loading: 'lazy',
                  alt: card_image_alt
              }}
            </div>
          {% endif %}

          <span class="content-content-cards__overlay" aria-hidden="true"></span>

          <div class="content-content-cards__body">
            {% if card_badge != blank %}
              <span class="content-content-cards__badge">
                {{ card_badge | escape }}
              </span>
            {% endif %}

            {% if card_eyebrow != blank %}
              <span class="content-content-cards__eyebrow">
                {{ card_eyebrow | escape }}
              </span>
            {% endif %}

            {% if card_heading != blank %}
              <h3 class="content-content-cards__heading">
                {{ card_heading | escape }}
              </h3>
            {% endif %}

            {% if card_text != blank %}
              <div class="content-content-cards__text">
                {{ card_text }}
              </div>
            {% endif %}

            {% if card_button_label != blank and card_button_url != blank %}
              <a class="content-content-cards__button" href="{{ card_button_url }}">
                {{ card_button_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Content cards",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "stacked",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_count",
      "label": "Number of cards",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },

    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_1_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "card_1_badge",
      "label": "Badge",
      "default": "Popular"
    },
    {
      "type": "text",
      "id": "card_1_eyebrow",
      "label": "Eyebrow",
      "default": "Service"
    },
    {
      "type": "text",
      "id": "card_1_heading",
      "label": "Heading",
      "default": "Universal card layout"
    },
    {
      "type": "richtext",
      "id": "card_1_text",
      "label": "Text",
      "default": "<p>Build flexible cards for services, categories, team members, features, or benefit sections.</p>"
    },
    {
      "type": "text",
      "id": "card_1_button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "card_1_button_url",
      "label": "Button URL"
    },

    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_2_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "card_2_badge",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "card_2_eyebrow",
      "label": "Eyebrow",
      "default": "Category"
    },
    {
      "type": "text",
      "id": "card_2_heading",
      "label": "Heading",
      "default": "Flexible presentation"
    },
    {
      "type": "richtext",
      "id": "card_2_text",
      "label": "Text",
      "default": "<p>Choose stacked, horizontal, overlay, or minimal layouts depending on the section goal.</p>"
    },
    {
      "type": "text",
      "id": "card_2_button_label",
      "label": "Button label",
      "default": "View details"
    },
    {
      "type": "url",
      "id": "card_2_button_url",
      "label": "Button URL"
    },

    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "image_picker",
      "id": "card_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_3_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "card_3_badge",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "card_3_eyebrow",
      "label": "Eyebrow",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "card_3_heading",
      "label": "Heading",
      "default": "Built for landing pages"
    },
    {
      "type": "richtext",
      "id": "card_3_text",
      "label": "Text",
      "default": "<p>Use cards to create stronger page structure, better scanning, and clearer calls to action.</p>"
    },
    {
