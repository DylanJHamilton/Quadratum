{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-benefits-drawbacks
    qtm-benefits-drawbacks-{{ block_id }}
    qtm-benefits-drawbacks--width-{{ block_width }}
    qtm-benefits-drawbacks--align-{{ block_alignment }}
    qtm-benefits-drawbacks--layout-{{ block.settings.layout_style }}
    qtm-benefits-drawbacks--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-benefits-drawbacks--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-benefits-drawbacks--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-benefits-drawbacks--hide-mobile{% endunless %}
  "
  style="
    --qtm-bvd-margin-top: {{ block.settings.margin_top }}px;
    --qtm-bvd-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-bvd-padding: {{ block.settings.padding }}px;
    --qtm-bvd-gap: {{ block.settings.gap }}px;
    --qtm-bvd-heading-color: {{ block.settings.heading_color }};
    --qtm-bvd-text-color: {{ block.settings.text_color }};
    --qtm-bvd-background-color: {{ block.settings.background_color }};
    --qtm-bvd-border-color: {{ block.settings.border_color }};
    --qtm-bvd-link-color: {{ block.settings.link_color }};
    --qtm-bvd-card-background: {{ block.settings.card_background_color }};
    --qtm-bvd-benefit-color: {{ block.settings.benefit_color }};
    --qtm-bvd-drawback-color: {{ block.settings.drawback_color }};
    --qtm-bvd-badge-background: {{ block.settings.badge_background_color }};
    --qtm-bvd-badge-text: {{ block.settings.badge_text_color }};
    --qtm-bvd-border-width: {{ block.settings.border_width }}px;
    --qtm-bvd-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-benefits-drawbacks__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-benefits-drawbacks__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-benefits-drawbacks__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-benefits-drawbacks__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-benefits-drawbacks__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-benefits-drawbacks__grid">
      <article class="qtm-benefits-drawbacks__panel qtm-benefits-drawbacks__panel--benefits">
        <div class="qtm-benefits-drawbacks__panel-header">
          {% if block.settings.benefits_badge != blank %}
            <span class="qtm-benefits-drawbacks__badge">
              {{ block.settings.benefits_badge | escape }}
            </span>
          {% endif %}

          <div class="qtm-benefits-drawbacks__panel-title-wrap">
            <span class="qtm-benefits-drawbacks__panel-icon" aria-hidden="true">
              {% case block.settings.benefits_icon %}
                {% when 'check' %}
                  ✓
                {% when 'star' %}
                  ★
                {% when 'plus' %}
                  +
                {% when 'arrow' %}
                  →
                {% else %}
                  ✓
              {% endcase %}
            </span>

            {% if block.settings.benefits_heading != blank %}
              <h3 class="qtm-benefits-drawbacks__panel-heading">
                {{ block.settings.benefits_heading | escape }}
              </h3>
            {% endif %}
          </div>

          {% if block.settings.benefits_text != blank %}
            <div class="qtm-benefits-drawbacks__panel-text">
              {{ block.settings.benefits_text }}
            </div>
          {% endif %}
        </div>

        <ul class="qtm-benefits-drawbacks__list" role="list">
          {% for i in (1..6) %}
            {% liquid
              assign item_key = 'benefit_' | append: i
              assign item = block.settings[item_key]
            %}

            {% if item != blank %}
              <li class="qtm-benefits-drawbacks__item">
                <span class="qtm-benefits-drawbacks__item-icon" aria-hidden="true">✓</span>
                <span>{{ item | escape }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>

      <article class="qtm-benefits-drawbacks__panel qtm-benefits-drawbacks__panel--drawbacks">
        <div class="qtm-benefits-drawbacks__panel-header">
          {% if block.settings.drawbacks_badge != blank %}
            <span class="qtm-benefits-drawbacks__badge">
              {{ block.settings.drawbacks_badge | escape }}
            </span>
          {% endif %}

          <div class="qtm-benefits-drawbacks__panel-title-wrap">
            <span class="qtm-benefits-drawbacks__panel-icon" aria-hidden="true">
              {% case block.settings.drawbacks_icon %}
                {% when 'x' %}
                  ×
                {% when 'minus' %}
                  −
                {% when 'warning' %}
                  !
                {% when 'arrow' %}
                  →
                {% else %}
                  ×
              {% endcase %}
            </span>

            {% if block.settings.drawbacks_heading != blank %}
              <h3 class="qtm-benefits-drawbacks__panel-heading">
                {{ block.settings.drawbacks_heading | escape }}
              </h3>
            {% endif %}
          </div>

          {% if block.settings.drawbacks_text != blank %}
            <div class="qtm-benefits-drawbacks__panel-text">
              {{ block.settings.drawbacks_text }}
            </div>
          {% endif %}
        </div>

        <ul class="qtm-benefits-drawbacks__list" role="list">
          {% for i in (1..6) %}
            {% liquid
              assign item_key = 'drawback_' | append: i
              assign item = block.settings[item_key]
            %}

            {% if item != blank %}
              <li class="qtm-benefits-drawbacks__item">
                <span class="qtm-benefits-drawbacks__item-icon" aria-hidden="true">
                  {% if block.settings.drawbacks_item_icon == 'dash' %}
                    —
                  {% else %}
                    ×
                  {% endif %}
                </span>
                <span>{{ item | escape }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>
    </div>

    {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
      <div class="qtm-benefits-drawbacks__footer">
        <a class="qtm-benefits-drawbacks__button" href="{{ block.settings.cta_url }}">
          {{ block.settings.cta_text | escape }}
        </a>
      </div>
    {% elsif block.settings.footer_note != blank %}
      <div class="qtm-benefits-drawbacks__footer">
        <div class="qtm-benefits-drawbacks__footer-note">
          {{ block.settings.footer_note }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .qtm-benefits-drawbacks-{{ block_id }} {
    margin-top: var(--qtm-bvd-margin-top);
    margin-bottom: var(--qtm-bvd-margin-bottom);
    padding: var(--qtm-bvd-padding);
    color: var(--qtm-bvd-text-color);
    background: var(--qtm-bvd-background-color);
    border: var(--qtm-bvd-border-width) solid var(--qtm-bvd-border-color);
    border-radius: var(--qtm-bvd-border-radius);
  }

  .qtm-benefits-drawbacks-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--width-auto {
    width: auto;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--width-small {
    max-width: 720px;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--width-medium {
    max-width: 960px;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--width-large {
    max-width: 1180px;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__inner {
    display: grid;
    gap: var(--qtm-bvd-gap);
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__header {
    display: grid;
    gap: 0.75rem;
    max-width: 780px;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-center .qtm-benefits-drawbacks__header {
    margin-inline: auto;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-right .qtm-benefits-drawbacks__header {
    margin-left: auto;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__eyebrow {
    margin: 0;
    color: var(--qtm-bvd-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__heading {
    margin: 0;
    color: var(--qtm-bvd-heading-color);
    line-height: 1.05;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__text {
    color: var(--qtm-bvd-text-color);
    line-height: 1.7;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__text p,
  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-text p,
  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__footer-note p {
    margin-top: 0;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__text p:last-child,
  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-text p:last-child,
  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__footer-note p:last-child {
    margin-bottom: 0;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__grid {
    display: grid;
    gap: var(--qtm-bvd-gap);
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--layout-side-by-side .qtm-benefits-drawbacks__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--layout-stacked .qtm-benefits-drawbacks__grid {
    grid-template-columns: 1fr;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1.25rem;
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.75rem);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, currentColor, transparent 96%),
        transparent 44%
      ),
      var(--qtm-bvd-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-bvd-border-color), transparent 10%);
    border-radius: calc(var(--qtm-bvd-border-radius) * 0.82);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.055);
    text-align: left;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: currentColor;
    opacity: 0.95;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel--benefits {
    color: var(--qtm-bvd-benefit-color);
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel--drawbacks {
    color: var(--qtm-bvd-drawback-color);
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-header {
    display: grid;
    gap: 0.7rem;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__badge {
    display: inline-flex;
    width: fit-content;
    padding: 0.38rem 0.65rem;
    color: var(--qtm-bvd-badge-text);
    background: var(--qtm-bvd-badge-background);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-title-wrap {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-icon {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    color: #ffffff;
    background: currentColor;
    border-radius: 999px;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 0.7rem 1.5rem color-mix(in srgb, currentColor, transparent 76%);
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-icon::first-letter {
    color: #ffffff;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-heading {
    margin: 0;
    color: var(--qtm-bvd-heading-color);
    font-size: clamp(1.2rem, 1.6vw, 1.65rem);
    line-height: 1.12;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-text {
    color: var(--qtm-bvd-text-color);
    line-height: 1.65;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__item {
    display: grid;
    grid-template-columns: 1.45rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    color: var(--qtm-bvd-text-color);
    line-height: 1.55;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__item-icon {
    display: inline-grid;
    place-items: center;
    width: 1.45rem;
    height: 1.45rem;
    color: #ffffff;
    background: currentColor;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__item-icon::first-letter {
    color: #ffffff;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__footer {
    display: flex;
    justify-content: inherit;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-left .qtm-benefits-drawbacks__footer {
    justify-content: flex-start;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-center .qtm-benefits-drawbacks__footer {
    justify-content: center;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--align-right .qtm-benefits-drawbacks__footer {
    justify-content: flex-end;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0.9rem 1.25rem;
    color: #ffffff;
    background: var(--qtm-bvd-link-color);
    border: 1px solid var(--qtm-bvd-link-color);
    border-radius: 999px;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__button:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__button:focus-visible {
    outline: 3px solid var(--qtm-bvd-link-color);
    outline-offset: 4px;
  }

  .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__footer-note {
    max-width: 760px;
    color: var(--qtm-bvd-text-color);
    line-height: 1.7;
    opacity: 0.86;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--animation-fade {
    animation: qtm-bvd-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--animation-fade-up {
    animation: qtm-bvd-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--animation-fade-down {
    animation: qtm-bvd-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--animation-fade-left {
    animation: qtm-bvd-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--animation-fade-right {
    animation: qtm-bvd-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--animation-zoom {
    animation: qtm-bvd-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-bvd-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-bvd-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-bvd-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-bvd-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-bvd-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-bvd-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--hide-tablet {
      display: none !important;
    }

    .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--layout-side-by-side .qtm-benefits-drawbacks__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-benefits-drawbacks-{{ block_id }} {
      padding: min(var(--qtm-bvd-padding), 24px);
    }

    .qtm-benefits-drawbacks-{{ block_id }}.qtm-benefits-drawbacks--hide-mobile {
      display: none !important;
    }

    .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel {
      padding: 1rem;
    }

    .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-title-wrap {
      align-items: flex-start;
    }

    .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__panel-icon {
      width: 2rem;
      height: 2rem;
    }

    .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__item {
      grid-template-columns: 1.35rem minmax(0, 1fr);
    }

    .qtm-benefits-drawbacks-{{ block_id }} .qtm-benefits-drawbacks__item-icon {
      width: 1.35rem;
      height: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-benefits-drawbacks-{{ block_id }},
    .qtm-benefits-drawbacks-{{ block_id }} *,
    .qtm-benefits-drawbacks-{{ block_id }} *::before,
    .qtm-benefits-drawbacks-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Benefits vs drawbacks",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Compare the difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A clearer way to choose"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this section to compare advantages, tradeoffs, product decisions, or your solution against the alternative.</p>"
    },
    {
      "type": "header",
      "content": "Benefits column"
    },
    {
      "type": "text",
      "id": "benefits_badge",
      "label": "Benefits badge",
      "default": "Recommended"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Why customers choose us"
    },
    {
      "type": "richtext",
      "id": "benefits_text",
      "label": "Benefits text",
      "default": "<p>Show the strongest reasons customers should choose this product, package, or solution.</p>"
    },
    {
      "type": "select",
      "id": "benefits_icon",
      "label": "Benefits icon",
      "default": "check",
      "options": [
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        }
      ]
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Premium quality and better long-term value"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Clearer shopping experience with fewer decisions"
    },
