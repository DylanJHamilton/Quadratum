{%- comment -%}
  Snippet: header-two-logo
  Reusable header brand/logo block for Quadratum headers.

  Uses global theme settings:
    settings.logo_primary          - desktop logo
    settings.logo_mobile           - mobile logo fallback
    settings.header_show_store_name - force store name beside logo

  Logo heights are controlled by the consuming header's CSS variables:
    --qtm-hm-logo-desktop
    --qtm-hm-logo-mobile

  Usage:
    {% render 'header-two-logo' %}
{%- endcomment -%}

<a class="qtm-hm-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
  {%- if settings.logo_primary != blank -%}
    <img
      class="qtm-hm-brand__logo qtm-hm-brand__logo--desktop"
      src="{{ settings.logo_primary | image_url: width: 600 }}"
      alt="{{ settings.logo_primary.alt | default: shop.name | escape }}"
      width="{{ settings.logo_primary.width }}"
      height="{{ settings.logo_primary.height }}"
      loading="eager"
    >
    {%- if settings.logo_mobile != blank -%}
      <img
        class="qtm-hm-brand__logo qtm-hm-brand__logo--mobile"
        src="{{ settings.logo_mobile | image_url: width: 400 }}"
        alt="{{ settings.logo_mobile.alt | default: shop.name | escape }}"
        width="{{ settings.logo_mobile.width }}"
        height="{{ settings.logo_mobile.height }}"
        loading="eager"
      >
    {%- endif -%}
  {%- elsif settings.logo_mobile != blank -%}
    <img
      class="qtm-hm-brand__logo"
      src="{{ settings.logo_mobile | image_url: width: 400 }}"
      alt="{{ settings.logo_mobile.alt | default: shop.name | escape }}"
      width="{{ settings.logo_mobile.width }}"
      height="{{ settings.logo_mobile.height }}"
      loading="eager"
    >
  {%- endif -%}

  {%- if settings.logo_primary == blank and settings.logo_mobile == blank -%}
    <span class="qtm-hm-brand__name">{{ shop.name }}</span>
  {%- elsif settings.header_show_store_name -%}
    <span class="qtm-hm-brand__name">{{ shop.name }}</span>
  {%- endif -%}
</a>