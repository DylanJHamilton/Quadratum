{%- comment -%}Validated decimal latitude,longitude; empty for incomplete/invalid pairs. Zero is valid.{%- endcomment -%}
{%- liquid
  assign lat_text = lat | append: '' | strip
  assign lng_text = lng | append: '' | strip
  assign valid = true
  assign coordinates = lat_text | append: ',' | append: lng_text | split: ','
  if coordinates.size != 2
    assign valid = false
  endif
  for coordinate in coordinates
    assign digits = coordinate | remove_first: '-' | remove_first: '.'
    assign residue = digits | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    assign first_character = coordinate | slice: 0, 1
    if digits == blank or residue != blank
      assign valid = false
    endif
    if coordinate contains '-' and first_character != '-'
      assign valid = false
    endif
  endfor
  assign lat_number = lat_text | plus: 0.0
  assign lng_number = lng_text | plus: 0.0
  if lat_text == blank or lng_text == blank or lat_number < -90 or lat_number > 90 or lng_number < -180 or lng_number > 180
    assign valid = false
  endif
-%}
{%- if valid -%}{{- lat_number -}},{{- lng_number -}}{%- endif -%}
