{% comment %}
  Quadratum Account System
  File 1 of 5 — Account Entry Only

  Handles:
  - Login
  - Recover Password
  - Create Account CTA

  Does NOT handle:
  - Dashboard
  - Orders
  - Order Details
  - Order Tracking
  - Addresses
{% endcomment %}

{{ 'account-main-account-login.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign create_account_url = section.settings.create_account_url
  if create_account_url == blank
    assign create_account_url = routes.account_register_url
  endif

  assign recover_display = section.settings.recover_display
  assign layout_style = section.settings.layout_style
-%}

<section
  id="QtmAccountMainLogin-{{ section.id }}"
  class="
    account-main-account-login
    account-main-account-login--{{ layout_style }}
    account-main-account-login--recover-{{ recover_display }}
  "
  style="
    --account-main-account-login-heading-size: {{ section.settings.heading_font_size }}px;
    --account-main-account-login-subheading-size: {{ section.settings.subheading_font_size }}px;
    --account-main-account-login-body-size: {{ section.settings.body_font_size }}px;
    --account-main-account-login-field-radius: {{ section.settings.field_radius }}px;
    --account-main-account-login-field-padding: {{ section.settings.field_padding }}px;
    --account-main-account-login-field-spacing: {{ section.settings.field_spacing }}px;
    --account-main-account-login-button-radius: {{ section.settings.button_radius }}px;
    --account-main-account-login-button-padding: {{ section.settings.button_padding }}px;
    --account-main-account-login-card-background: {{ section.settings.card_background }};
    --account-main-account-login-card-border: {{ section.settings.card_border }};
    --account-main-account-login-card-radius: {{ section.settings.card_radius }}px;
    --account-main-account-login-card-padding: {{ section.settings.card_padding }}px;
  "
  data-account-main-account-login
  data-recover-display="{{ recover_display }}"
>
  <div class="account-main-account-login__shell">
    <div class="account-main-account-login__content">
      {% if layout_style == 'centered' and section.settings.logo != blank %}
        <div class="account-main-account-login__logo">
          {{ section.settings.logo | image_url: width: 220 | image_tag: loading: 'lazy', alt: shop.name }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="account-main-account-login__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="account-main-account-login__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      {% if section.settings.content != blank %}
        <div class="account-main-account-login__richtext rte">
          {{ section.settings.content }}
        </div>
      {% endif %}

      {% if section.settings.show_social_placeholder %}
        <div class="account-main-account-login__social-placeholder" role="note">
          {{ section.settings.social_placeholder_text }}
        </div>
      {% endif %}
    </div>

    <div class="account-main-account-login__auth">
      <div class="account-main-account-login__card">
        <div
          class="account-main-account-login__panel account-main-account-login__panel--login is-active"
          data-account-main-account-login-panel="login"
        >
          {% form 'customer_login', class: 'account-main-account-login__form', novalidate: 'novalidate' %}
            <div class="account-main-account-login__form-header">
              <h2 class="account-main-account-login__form-title">
                {{ section.settings.login_heading }}
              </h2>
            </div>

            {% if form.errors %}
              <div
                class="account-main-account-login__errors"
                role="alert"
                aria-live="assertive"
                tabindex="-1"
              >
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="account-main-account-login__field">
              <label for="AccountMainLoginEmail-{{ section.id }}">
                {{ section.settings.email_label }}
              </label>
              <input
                id="AccountMainLoginEmail-{{ section.id }}"
                type="email"
                name="customer[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                required
              >
            </div>

            <div class="account-main-account-login__field">
              <label for="AccountMainLoginPassword-{{ section.id }}">
                {{ section.settings.password_label }}
              </label>

              <div class="account-main-account-login__password-wrap">
                <input
                  id="AccountMainLoginPassword-{{ section.id }}"
                  type="password"
                  name="customer[password]"
                  autocomplete="current-password"
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                >

                {% if section.settings.show_password_toggle %}
                  <button
                    type="button"
                    class="account-main-account-login__password-toggle"
                    aria-label="{{ section.settings.show_password_label }}"
                    data-account-main-account-login-password-toggle
                    data-show-label="{{ section.settings.show_password_label }}"
                    data-hide-label="{{ section.settings.hide_password_label }}"
                  >
                    <span data-account-main-account-login-password-toggle-text>
                      {{ section.settings.show_password_text }}
                    </span>
                  </button>
                {% endif %}
              </div>
            </div>

            {% if section.settings.show_remember_me %}
              <div class="account-main-account-login__checkbox">
                <input
                  id="AccountMainLoginRemember-{{ section.id }}"
                  type="checkbox"
                  name="remember_me"
                  value="1"
                >
                <label for="AccountMainLoginRemember-{{ section.id }}">
                  {{ section.settings.remember_me_label }}
                </label>
              </div>
            {% endif %}

            <div class="account-main-account-login__actions">
              <button
                type="submit"
                class="account-main-account-login__button account-main-account-login__button--{{ section.settings.button_style }}"
              >
                {{ section.settings.login_button_label }}
              </button>
            </div>

            {% if recover_display == 'toggle' or recover_display == 'panel' %}
              <button
                type="button"
                class="account-main-account-login__text-button"
                data-account-main-account-login-recover-trigger
              >
                {{ section.settings.forgot_password_label }}
              </button>
            {% endif %}
          {% endform %}

          {% if recover_display == 'inline' or recover_display == 'toggle' %}
            <div
              class="
                account-main-account-login__recover-inline
                {% if recover_display == 'toggle' %}is-hidden{% endif %}
              "
              data-account-main-account-login-recover-inline
            >
              {% render 'account-main-account-login-recover-form-placeholder' %}
            </div>
          {% endif %}
        </div>

        {% if recover_display == 'panel' %}
          <div
            class="account-main-account-login__panel account-main-account-login__panel--recover"
            data-account-main-account-login-panel="recover"
            hidden
          >
            {% render 'account-main-account-login-recover-form-placeholder' %}
          </div>
        {% endif %}

        {% if section.settings.show_create_account %}
          <div class="account-main-account-login__create">
            {% if section.settings.create_account_text != blank %}
              <p>{{ section.settings.create_account_text }}</p>
            {% endif %}

            <a
              href="{{ create_account_url }}"
              class="account-main-account-login__create-link"
            >
              {{ section.settings.create_account_label }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <template data-account-main-account-login-recover-template>
    {% form 'recover_customer_password', class: 'account-main-account-login__form account-main-account-login__form--recover' %}
      <div class="account-main-account-login__form-header">
        <h2 class="account-main-account-login__form-title">
          {{ section.settings.recover_heading }}
        </h2>

        {% if section.settings.recover_subheading != blank %}
          <p class="account-main-account-login__form-subtitle">
            {{ section.settings.recover_subheading }}
          </p>
        {% endif %}
      </div>

      {% if form.posted_successfully? %}
        <div
          class="account-main-account-login__success"
          role="status"
          aria-live="polite"
          tabindex="-1"
        >
          {{ section.settings.recover_success_message }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div
          class="account-main-account-login__errors"
          role="alert"
          aria-live="assertive"
          tabindex="-1"
        >
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="account-main-account-login__field">
        <label for="AccountMainRecoverEmail-{{ section.id }}">
          {{ section.settings.email_label }}
        </label>
        <input
          id="AccountMainRecoverEmail-{{ section.id }}"
          type="email"
          name="email"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors %}
            aria-invalid="true"
          {% endif %}
          required
        >
      </div>

      <div class="account-main-account-login__actions">
        <button
          type="submit"
          class="account-main-account-login__button account-main-account-login__button--{{ section.settings.button_style }}"
        >
          {{ section.settings.recover_button_label }}
        </button>
      </div>

      {% if recover_display == 'panel' %}
        <button
          type="button"
          class="account-main-account-login__text-button"
          data-account-main-account-login-login-trigger
        >
          {{ section.settings.back_to_login_label }}
        </button>
      {% endif %}
    {% endform %}
  </template>
</section>

<script>
  (() => {
    const root = document.getElementById('QtmAccountMainLogin-{{ section.id }}');
    if (!root) return;

    const template = root.querySelector('[data-account-main-account-login-recover-template]');
    const inlineTarget = root.querySelector('[data-account-main-account-login-recover-inline]');
    const panelTarget = root.querySelector('[data-account-main-account-login-panel="recover"]');

    function mountRecoverForm(target) {
      if (!target || !template || target.dataset.recoverMounted === 'true') return;
      target.appendChild(template.content.cloneNode(true));
      target.dataset.recoverMounted = 'true';
    }

    mountRecoverForm(inlineTarget);
    mountRecoverForm(panelTarget);

    const recoverTrigger = root.querySelector('[data-account-main-account-login-recover-trigger]');
    const loginTrigger = root.querySelector('[data-account-main-account-login-login-trigger]');
    const loginPanel = root.querySelector('[data-account-main-account-login-panel="login"]');
    const recoverPanel = root.querySelector('[data-account-main-account-login-panel="recover"]');

    if (recoverTrigger) {
      recoverTrigger.addEventListener('click', () => {
        const display = root.dataset.recoverDisplay;

        if (display === 'toggle' && inlineTarget) {
          inlineTarget.classList.toggle('is-hidden');
          const email = inlineTarget.querySelector('input[type="email"]');
          if (!inlineTarget.classList.contains('is-hidden') && email) email.focus();
        }

        if (display === 'panel' && loginPanel && recoverPanel) {
          loginPanel.classList.remove('is-active');
          loginPanel.hidden = true;
          recoverPanel.hidden = false;
          recoverPanel.classList.add('is-active');

          const email = recoverPanel.querySelector('input[type="email"]');
          if (email) email.focus();
        }
      });
    }

    if (loginTrigger && loginPanel && recoverPanel) {
      loginTrigger.addEventListener('click', () => {
        recoverPanel.classList.remove('is-active');
        recoverPanel.hidden = true;
        loginPanel.hidden = false;
        loginPanel.classList.add('is-active');

        const email = loginPanel.querySelector('input[type="email"]');
        if (email) email.focus();
      });
    }

    root.querySelectorAll('[data-account-main-account-login-password-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const wrap = button.closest('.account-main-account-login__password-wrap');
        const input = wrap ? wrap.querySelector('input') : null;
        const text = button.querySelector('[data-account-main-account-login-password-toggle-text]');

        if (!input) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';

        button.setAttribute(
          'aria-label',
          isPassword ? button.dataset.hideLabel : button.dataset.showLabel
        );

        if (text) {
          text.textContent = isPassword
            ? '{{ section.settings.hide_password_text | escape }}'
            : '{{ section.settings.show_password_text | escape }}';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Account Main Login",
  "tag": "section",
  "class": "qtm-account-main-login",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "Split Layout"
        },
        {
          "value": "centered",
          "label": "Centered Layout"
        },
        {
          "value": "card",
          "label": "Card Layout"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Used in centered layout."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome Back"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sign in to access your account."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Optional content",
      "default": "<p>View your account details, access customer support, and manage your shopping experience.</p>"
    },
    {
      "type": "text",
      "id": "login_heading",
      "label": "Login form heading",
      "default": "Sign in"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password label",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "login_button_label",
      "label": "Login button label",
      "default": "Sign In"
    },
    {
      "type": "text",
      "id": "forgot_password_label",
      "label": "Forgot password label",
      "default": "Forgot your password?"
    },
    {
      "type": "select",
      "id": "recover_display",
      "label": "Recover password display",
      "default": "toggle",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "toggle",
          "label": "Toggle"
        },
        {
          "value": "panel",
          "label": "Separate Panel"
        }
      ]
    },
    {
      "type": "text",
      "id": "recover_heading",
      "label": "Recover heading",
      "default": "Reset your password"
    },
    {
      "type": "text",
      "id": "recover_subheading",
      "label": "Recover subheading",
      "default": "Enter your email and we’ll send you a password reset link."
    },
    {
      "type": "text",
      "id": "recover_button_label",
      "label": "Recover button label",
      "default": "Reset Password"
    },
    {
      "type": "text",
      "id": "recover_success_message",
      "label": "Recover success message",
      "default": "We’ve sent you an email with a link to update your password."
    },
    {
      "type": "text",
      "id": "back_to_login_label",
      "label": "Back to login label",
      "default": "Back to sign in"
    },
    {
      "type": "checkbox",
      "id": "show_create_account",
      "label": "Show create account prompt",
      "default": true
    },
    {
      "type": "text",
      "id": "create_account_text",
      "label": "Create account text",
      "default": "New here?"
    },
    {
      "type": "text",
      "id": "create_account_label",
      "label": "Create account label",
      "default": "Create Account"
    },
    {
      "type": "url",
      "id": "create_account_url",
      "label": "Create account URL"
    },
    {
      "type": "checkbox",
      "id": "show_remember_me",
      "label": "Show remember me checkbox",
      "default": false
    },
    {
      "type": "text",
      "id": "remember_me_label",
      "label": "Remember me label",
      "default": "Remember me"
    },
    {
      "type": "checkbox",
      "id": "show_password_toggle",
      "label": "Show password toggle",
      "default": true
    },
    {
      "type": "text",
      "id": "show_password_text",
      "label": "Show password visible text",
      "default": "Show"
    },
    {
      "type": "text",
      "id": "hide_password_text",
      "label": "Hide password visible text",
      "default": "Hide"
    },
    {
      "type": "text",
      "id": "show_password_label",
      "label": "Show password accessible label",
      "default": "Show password"
    },
    {
      "type": "text",
      "id": "hide_password_label",
      "label": "Hide password accessible label",
      "default": "Hide password"
    },
    {
      "type": "checkbox",
      "id": "show_social_placeholder",
      "label": "Show social login placeholder",
      "default": false
    },
    {
      "type": "text",
      "id": "social_placeholder_text",
      "label": "Social placeholder text",
      "default": "Social login integrations coming soon."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "range",
      "id": "field_radius",
      "label": "Field radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "field_padding",
      "label": "Field padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "field_spacing",
      "label": "Field spacing",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Account Main Login"
    }
  ]
}
{% endschema %}