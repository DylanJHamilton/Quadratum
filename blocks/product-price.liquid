{%- liquid
  assign block_id = 'product-price-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign price_style = block.settings.price_style | default: 'standard'

  assign price = current_variant.price
  assign compare_at_price = current_variant.compare_at_price
  assign unit_price = current_variant.unit_price
  assign unit_price_measurement = current_variant.unit_price_measurement

  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif

  assign savings_amount = 0
  assign savings_percent = 0

  if on_sale
    assign savings_amount = compare_at_price | minus: price
    if compare_at_price > 0
      assign savings_percent = savings_amount | times: 100 | divided_by: compare_at_price
    endif
  endif

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-price
    product-price--{{ price_style }}
    product-price--width-{{ width }}
    product-price--align-{{ alignment }}
    {% if on_sale %} product-price--on-sale{% endif %}
    {% unless show_on_desktop %} product-price--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-price--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-price--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-price--animate product-price--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-price-margin-top: {{ block.settings.margin_top }}px;
    --product-price-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-price-padding: {{ block.settings.padding }}px;
    --product-price-gap: {{ block.settings.gap }}px;
    --product-price-font-size: {{ block.settings.price_font_size }}px;
    --product-price-compare-font-size: {{ block.settings.compare_font_size }}px;
    --product-price-badge-font-size: {{ block.settings.badge_font_size }}px;
    --product-price-text-color: {{ block.settings.text_color }};
    --product-price-sale-color: {{ block.settings.sale_color }};
    --product-price-compare-color: {{ block.settings.compare_color }};
    --product-price-badge-background: {{ block.settings.badge_background_color }};
    --product-price-badge-text: {{ block.settings.badge_text_color }};
    --product-price-background-color: {{ block.settings.background_color }};
    --product-price-border-color: {{ block.settings.border_color }};
    --product-price-border-width: {{ block.settings.border_width }}px;
    --product-price-border-radius: {{ block.settings.border_radius }}px;
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-price
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-price-margin-top);
      margin-bottom: var(--product-price-margin-bottom);
      padding: var(--product-price-padding);
      color: var(--product-price-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-price--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-price--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-price--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-price--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-price--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-price--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-price--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-price--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-price__inner {
      display: grid;
      gap: var(--product-price-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-price--card .product-price__inner,
    #{{ block_id }}.product-price--highlight .product-price__inner {
      width: fit-content;
      max-width: 100%;
      padding: 16px 18px;
      background: var(--product-price-background-color);
      border: var(--product-price-border-width) solid var(--product-price-border-color);
      border-radius: var(--product-price-border-radius);
    }

    #{{ block_id }}.product-price--align-center.product-price--card .product-price__inner,
    #{{ block_id }}.product-price--align-center.product-price--highlight .product-price__inner {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-price--align-right.product-price--card .product-price__inner,
    #{{ block_id }}.product-price--align-right.product-price--highlight .product-price__inner {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-price__row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px 12px;
      min-width: 0;
    }

    #{{ block_id }}.product-price--align-center .product-price__row {
      justify-content: center;
    }

    #{{ block_id }}.product-price--align-right .product-price__row {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-price__current {
      color: var(--product-price-text-color);
      font-size: var(--product-price-font-size);
      line-height: 1.1;
      font-weight: 700;
      white-space: nowrap;
    }

    #{{ block_id }}.product-price--on-sale .product-price__current {
      color: var(--product-price-sale-color);
    }

    #{{ block_id }} .product-price__compare {
      color: var(--product-price-compare-color);
      font-size: var(--product-price-compare-font-size);
      line-height: 1.2;
      text-decoration: line-through;
      opacity: 0.8;
      white-space: nowrap;
    }

    #{{ block_id }} .product-price__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      padding: 5px 9px;
      color: var(--product-price-badge-text);
      background: var(--product-price-badge-background);
      border-radius: 999px;
      font-size: var(--product-price-badge-font-size);
      line-height: 1.2;
      white-space: nowrap;
    }

    #{{ block_id }} .product-price__unit {
      color: var(--product-price-compare-color);
      font-size: 0.9em;
      line-height: 1.35;
    }

    #{{ block_id }} .product-price__tax {
      color: var(--product-price-compare-color);
      font-size: 0.9em;
      line-height: 1.35;
    }

    #{{ block_id }}.product-price--minimal .product-price__compare,
    #{{ block_id }}.product-price--minimal .product-price__badge,
    #{{ block_id }}.product-price--minimal .product-price__unit,
    #{{ block_id }}.product-price--minimal .product-price__tax {
      font-size: 0.85em;
    }

    #{{ block_id }}.product-price--highlight .product-price__current {
      font-size: calc(var(--product-price-font-size) * 1.12);
    }

    #{{ block_id }}.product-price--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-price--animate-fade {
      animation-name: productPriceFade;
    }

    #{{ block_id }}.product-price--animate-fade_up {
      animation-name: productPriceFadeUp;
    }

    #{{ block_id }}.product-price--animate-fade_down {
      animation-name: productPriceFadeDown;
    }

    #{{ block_id }}.product-price--animate-fade_left {
      animation-name: productPriceFadeLeft;
    }

    #{{ block_id }}.product-price--animate-fade_right {
      animation-name: productPriceFadeRight;
    }

    #{{ block_id }}.product-price--animate-zoom {
      animation-name: productPriceZoom;
    }

    @keyframes productPriceFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productPriceFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productPriceFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productPriceFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productPriceFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productPriceZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-price--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-price--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-price--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-price--card .product-price__inner,
      #{{ block_id }}.product-price--highlight .product-price__inner {
        padding: 14px 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-price--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-price__inner">
    <div class="product-price__row">
      <span class="product-price__current" data-product-price-current>
        {{ price | money }}
      </span>

      {% if block.settings.show_compare_price %}
        <span
          class="product-price__compare"
          data-product-price-compare
          {% unless on_sale %}hidden{% endunless %}
        >
          {{ compare_at_price | money }}
        </span>
      {% endif %}

      {% if block.settings.show_sale_badge %}
        <span
          class="product-price__badge"
          data-product-price-badge
          {% unless on_sale %}hidden{% endunless %}
        >
          {% if block.settings.savings_display == 'percentage' %}
            {{ block.settings.sale_badge_prefix | escape }} {{ savings_percent }}%
          {% elsif block.settings.savings_display == 'amount' %}
            {{ block.settings.sale_badge_prefix | escape }} {{ savings_amount | money }}
          {% else %}
            {{ block.settings.sale_badge_text | escape }}
          {% endif %}
        </span>
      {% endif %}
    </div>

    {% if block.settings.show_unit_price %}
      <div
        class="product-price__unit"
        data-product-price-unit
        {% unless unit_price and unit_price_measurement %}hidden{% endunless %}
      >
        {% if unit_price and unit_price_measurement %}
          {{ unit_price | money }}
          <span aria-hidden="true">/</span>
          {% if unit_price_measurement.reference_value != 1 %}
            {{ unit_price_measurement.reference_value }}
          {% endif %}
          {{ unit_price_measurement.reference_unit }}
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.tax_text != blank %}
      <div class="product-price__tax">
        {{ block.settings.tax_text | escape }}
      </div>
    {% endif %}
  </div>

  <script type="application/json" data-product-price-variants>
    {{ product_context.variants | json }}
  </script>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productPriceReady === 'true') return;

      root.dataset.productPriceReady = 'true';

      const variantsJson = root.querySelector('[data-product-price-variants]');
      const currentEl = root.querySelector('[data-product-price-current]');
      const compareEl = root.querySelector('[data-product-price-compare]');
      const badgeEl = root.querySelector('[data-product-price-badge]');
      const unitEl = root.querySelector('[data-product-price-unit]');

      const savingsDisplay = {{ block.settings.savings_display | json }};
      const saleBadgePrefix = {{ block.settings.sale_badge_prefix | json }};
      const saleBadgeText = {{ block.settings.sale_badge_text | json }};
      const currency = {{ cart.currency.iso_code | default: shop.currency | json }};

      if (!variantsJson || !currentEl) return;

      let variants = [];

      try {
        variants = JSON.parse(variantsJson.textContent || '[]');
      } catch (error) {
        variants = [];
      }

      const formatMoney = (cents) => {
        const amount = Number(cents || 0) / 100;

        try {
          return new Intl.NumberFormat(document.documentElement.lang || 'en-US', {
            style: 'currency',
            currency
          }).format(amount);
        } catch (error) {
          return `$${amount.toFixed(2)}`;
        }
      };

      const updatePrice = (variantId) => {
        if (!variantId) return;

        const variant = variants.find((item) => String(item.id) === String(variantId));

        if (!variant) return;

        const price = Number(variant.price || 0);
        const compareAtPrice = Number(variant.compare_at_price || 0);
        const onSale = compareAtPrice > price;
        const savingsAmount = onSale ? compareAtPrice - price : 0;
        const savingsPercent = onSale && compareAtPrice > 0 ? Math.round((savingsAmount / compareAtPrice) * 100) : 0;

        currentEl.textContent = formatMoney(price);

        if (compareEl) {
          compareEl.textContent = onSale ? formatMoney(compareAtPrice) : '';
          compareEl.hidden = !onSale;
        }

        if (badgeEl) {
          if (onSale) {
            if (savingsDisplay === 'percentage') {
              badgeEl.textContent = `${saleBadgePrefix} ${savingsPercent}%`;
            } else if (savingsDisplay === 'amount') {
              badgeEl.textContent = `${saleBadgePrefix} ${formatMoney(savingsAmount)}`;
            } else {
              badgeEl.textContent = saleBadgeText;
            }
          }

          badgeEl.hidden = !onSale;
        }

        if (unitEl) {
          unitEl.hidden = true;
          unitEl.textContent = '';
        }

        root.classList.toggle('product-price--on-sale', onSale);
        root.dataset.variantId = String(variant.id);
      };

      document.addEventListener('variant:change', (event) => {
        const detail = event.detail || {};
        const variantId = detail.variantId || detail.variant_id || detail.id;

        updatePrice(variantId);
      });

      document.addEventListener('product:variant-change', (event) => {
        const detail = event.detail || {};
        const variant = detail.variant || {};
        const variantId = variant.id || detail.variantId || detail.variant_id;

        updatePrice(variantId);
      });

      document.addEventListener('qtm:variant:change', (event) => {
        const detail = event.detail || {};
        const variant = detail.variant || {};
        const variantId = variant.id || detail.variantId || detail.variant_id;

        updatePrice(variantId);
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product price",
  "settings": [
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "select",
      "id": "savings_display",
      "label": "Sale badge display",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "Custom text"
        },
        {
          "value": "amount",
          "label": "Savings amount"
        },
        {
          "value": "percentage",
          "label": "Savings percentage"
        }
      ]
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "sale_badge_prefix",
      "label": "Savings prefix",
      "default": "Save"
    },
    {
      "type": "checkbox",
      "id": "show_unit_price",
      "label": "Show unit price",
      "default": true
    },
    {
      "type": "text",
      "id": "tax_text",
      "label": "Tax/shipping text",
      "default": "Including Tax"
    },
    {
      "type": "select",
      "id": "price_style",
      "label": "Price style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "highlight",
          "label": "Highlight"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price font size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "compare_font_size",
      "label": "Compare price font size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Sale price color",
      "default": "#b42318"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare price color",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background",
      "default": "#b42318"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e5e5e5"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Pricing",
      "settings": {
        "show_compare_price": true,
        "show_sale_badge": false,
        "savings_display": "text",
        "sale_badge_text": "Sale",
        "sale_badge_prefix": "Save",
        "show_unit_price": true,
        "tax_text": "",
        "price_style": "standard",
        "price_font_size": 32,
        "compare_font_size": 18,
        "badge_font_size": 12,
        "text_color": "#111111",
        "sale_color": "#b42318",
        "compare_color": "#777777",
        "badge_background_color": "#b42318",
        "badge_text_color": "#ffffff",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 20,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 16,
        "padding": 0,
