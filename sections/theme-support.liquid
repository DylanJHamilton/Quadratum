{{ 'documentation-hub.css' | asset_url | stylesheet_tag }}
<section class="q-docs" aria-labelledby="Support-{{ section.id }}">
  <header class="q-docs__heading"><p class="q-docs__eyebrow">QUADRATUM / SUPPORT</p><h1 id="Support-{{ section.id }}">A useful answer<br>starts here.</h1><p>Find the control you need, follow a setup guide, or send a clear description of the problem.</p><a href="{{ routes.root_url }}pages/features?view=documentation">Open the complete documentation ↗</a></header>
  <div class="q-docs__support">
    <div class="q-docs__main">
      <h2>Help us reproduce it.</h2>
      <p>Include the page, template, section or block, the steps you took, and what you expected to happen. A screenshot link and your device or browser are useful.</p>
      <details open><summary>Theme setup and bugs</summary><p>Use this form for questions about native Quadratum sections, blocks, Theme Settings, and reproducible theme errors. Custom development, third-party apps, and business operations can require separate assistance.</p></details>
      <details><summary>A setting has no visible effect</summary><p>Check whether the section has a local override, whether its display condition is active, and whether the connected product, collection, or image exists. Use the documentation search to find the exact control.</p></details>
      <details><summary>Working with ChatGPT or Claude</summary><p>Share the relevant section name, setting, template, and proposed change. Use an unpublished copy and ask your assistant to preserve existing content. Connector capabilities determine which files it can read or change.</p></details>
      <p>Do not send passwords, access tokens, payment information, or customer data. This form sends a message to the store’s configured contact email.</p>
    </div>
    {% assign support_form_id = 'ThemeSupport-' | append: section.id %}
    {% form 'contact', id: support_form_id, class: 'q-docs__form' %}
      {% if form.posted_successfully? %}<p role="status" tabindex="-1">Your message was submitted. Thank you for including the details.</p>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <input type="hidden" name="contact[Theme]" value="Quadratum 1.0.0">
      <div><label for="SupportName-{{ section.id }}">Name</label><input id="SupportName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required></div>
      <div><label for="SupportEmail-{{ section.id }}">Email</label><input id="SupportEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" required></div>
      <div><label for="SupportStore-{{ section.id }}">Store URL</label><input id="SupportStore-{{ section.id }}" type="url" name="contact[Store URL]" placeholder="https://your-store.myshopify.com" required></div>
      <div><label for="SupportTopic-{{ section.id }}">Topic</label><select id="SupportTopic-{{ section.id }}" name="contact[Topic]"><option>Setup question</option><option>Section or block</option><option>Theme Settings</option><option>Report a bug</option><option>AI-assisted workflow</option></select></div>
      <div><label for="SupportMessage-{{ section.id }}">What do you need help with?</label><textarea id="SupportMessage-{{ section.id }}" name="contact[body]" required>{{ form.body | escape }}</textarea></div>
      <div><label for="SupportScreenshot-{{ section.id }}">Screenshot link (optional)</label><input id="SupportScreenshot-{{ section.id }}" type="url" name="contact[Screenshot link]" aria-describedby="SupportScreenshotHelp-{{ section.id }}"><p id="SupportScreenshotHelp-{{ section.id }}">Link to an image you are comfortable sharing. Remove personal or customer information first.</p></div>
      <button type="submit">Send support request</button>
    {% endform %}
  </div>
</section>
{% schema %}
{"name":"Theme support","settings":[],"presets":[{"name":"Theme support"}]}
{% endschema %}
