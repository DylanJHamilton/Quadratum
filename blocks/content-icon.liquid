{%- liquid
  assign icon_mode = block.settings.icon_mode | default: 'text'
  assign icon_text = block.settings.icon_text
  assign icon_svg = block.settings.icon_svg
  assign icon_image = block.settings.icon_image
  assign icon_link = block.settings.icon_link
  assign icon_aria_label = block.settings.aria_label
  assign is_decorative = block.settings.decorative
  assign icon_tag = 'div'

  if icon_link != blank
    assign icon_tag = 'a'
  endif
-%}

{% render 'qtm-content-block-wrapper-start', block: block, block_type: 'icon' %}

<{{ icon_tag }}
  class="
    qtm-icon
    qtm-icon--{{ icon_mode }}
    {% if block.settings.show_background %} qtm-icon--has-background{% endif %}
  "
  {% if icon_link != blank %}
    href="{{ icon_link }}"
    {% if block.settings.open_new_tab %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  {% endif %}
  {% if is_decorative %}
    aria-hidden="true"
  {% else %}
    role="img"
    aria-label="{{ icon_aria_label | default: icon_text | escape }}"
  {% endif %}
  style="
    --qtm-icon-size: {{ block.settings.icon_size }}px;
    --qtm-icon-color: {{ block.settings.icon_color }};
    --qtm-icon-background: {{ block.settings.icon_background }};
    --qtm-icon-radius: {{ block.settings.icon_radius }}px;
    --qtm-icon-padding: {{ block.settings.icon_padding }}px;
    --qtm-icon-border-width: {{ block.settings.icon_border_width }}px;
    --qtm-icon-border-color: {{ block.settings.icon_border_color }};
  "
>
  {% if icon_mode == 'svg' and icon_svg != blank %}
    <span class="qtm-icon__svg" aria-hidden="true">
      {{ icon_svg }}
    </span>
  {% elsif icon_mode == 'image' and icon_image != blank %}
    {{
      icon_image
      | image_url: width: 240
      | image_tag:
        class: 'qtm-icon__image',
        loading: 'lazy',
        alt: icon_aria_label
    }}
  {% else %}
    <span class="qtm-icon__text" aria-hidden="true">
      {{ icon_text | escape }}
    </span>
  {% endif %}
</{{ icon_tag }}>

{% render 'qtm-content-block-wrapper-end' %}

<script src="{{ 'qtm-content-blocks-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Icon",
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "select",
      "id": "icon_mode",
      "label": "Icon mode",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "Text / symbol"
        },
        {
          "value": "svg",
          "label": "Custom SVG"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "text",
      "id": "icon_text",
      "label": "Text icon",
      "default": "★",
      "info": "Use a symbol, emoji, short icon label, or icon font character."
    },
    {
      "type": "textarea",
      "id": "icon_svg",
      "label": "SVG code",
      "info": "Paste inline SVG markup. Use trusted SVG only."
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon image"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "Show background",
      "default": false
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "icon_padding",
      "label": "Icon padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_radius",
      "label": "Icon radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_border_width",
      "label": "Icon border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon border color",
      "default": "#dddddd"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "icon_link",
      "label": "Icon link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "checkbox",
      "id": "decorative",
      "label": "Decorative icon",
      "default": true,
      "info": "Enable when the icon is visual only. Disable when the icon communicates meaning."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "info": "Required if the icon is meaningful or linked."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": "100",
      "options": [
        {
          "value": "25",
          "label": "25%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "100",
          "label": "100%"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade-up",
          "label": "Fade up"
        },
        {
          "value": "fade-down",
          "label": "Fade down"
        },
        {
          "value": "fade-left",
          "label": "Fade left"
        },
        {
          "value": "fade-right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Simple icon",
      "settings": {
        "icon_mode": "text",
        "icon_text": "★",
        "icon_size": 48,
        "icon_color": "#111111",
        "show_background": false,
        "icon_background": "#f4f4f4",
        "icon_padding": 12,
        "icon_radius": 16,
        "icon_border_width": 0,
        "icon_border_color": "#dddddd",
        "open_new_tab": false,
        "decorative": true,
        "aria_label": "",
        "content_width": "auto",
        "alignment": "left",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "none",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
        "border_radius": 0
      }
    },
    {
      "name": "Icon badge",
      "settings": {
        "icon_mode": "text",
        "icon_text": "✓",
        "icon_size": 32,
        "icon_color": "#111111",
        "show_background": true,
        "icon_background": "#f4f4f4",
        "icon_padding": 16,
        "icon_radius": 80,
        "icon_border_width": 1,
        "icon_border_color": "#e5e5e5",
        "open_new_tab": false,
        "decorative": true,
        "aria_label": "",
        "content_width": "auto",
        "alignment": "center",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "fade-up",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
