{%- comment -%}
  Snippet: header-two-search
  Reusable header search entry point for Quadratum headers.

  Accepts:
    mode        - 'inline_static' | 'popup' | 'page' | 'none'
    placeholder - input placeholder (string)
    input_id    - unique input id for inline forms (string)
    show_button - show the inline submit button (boolean)
    context     - form_context passed to search-form-static (string)

  Contracts:
    - Popup mode uses the global data-search-popup-open trigger.
    - Inline mode renders the existing 'search-form-static' snippet.
    - Predictive search is NOT rebuilt here; it belongs to the global system.

  Usage:
    {% render 'header-two-search', mode: 'popup', context: 'header-two' %}
{%- endcomment -%}

{%- liquid
  assign search_mode = mode | default: 'none'
  assign search_placeholder = placeholder | default: settings.search_placeholder

  if search_mode == 'popup' and settings.enable_search_popup != true
    assign search_mode = 'page'
  endif
-%}

{%- case search_mode -%}
  {%- when 'inline_static' -%}
    <div class="qtm-hm-search qtm-hm-search--inline">
      {% render 'search-form-static',
        form_context: context,
        input_id: input_id,
        placeholder: search_placeholder,
        show_button: show_button
      %}
    </div>

  {%- when 'popup' -%}
    <button
      type="button"
      class="qtm-hm-icon-btn qtm-hm-search-btn"
      data-search-popup-open
      aria-label="Open search"
      aria-haspopup="dialog"
    >
      <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>

  {%- when 'page' -%}
    <a
      href="{{ routes.search_url }}"
      class="qtm-hm-icon-btn qtm-hm-search-btn"
      aria-label="Go to search page"
    >
      <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </a>
{%- endcase -%}