{%- comment -%}Additional source candidates for native images whose existing markup owns alt, loading and geometry.{%- endcomment -%}
srcset="{% render 'responsive-image-srcset', image: image, max_width: max_width, crop: crop, crop_height: crop_height %}"
sizes="{{ sizes | default: '100vw' }}"
{% if focal_style %}style="object-position: {{ image.presentation.focal_point | default: image.preview_image.presentation.focal_point | default: '50% 50%' }};"{% endif %}
