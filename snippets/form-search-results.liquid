{% comment %}Native predictive result data; panel-only response, no client HTML interpolation.{% endcomment %}
{% assign result_groups = 'products,collections,articles,pages' | split: ',' %}
{% assign result_count = 0 %}
<div data-qps-render="panel">
  {% for group in result_groups %}
    {% unless sources contains group %}{% continue %}{% endunless %}
    {% assign items = predictive_search.resources[group] %}
    {% if items.size > 0 %}
      <div class="q-group" data-type="{{ group }}" role="group" aria-label="{{ group | capitalize }}">
        <p class="q-group-title">{{ group | capitalize }}</p>
        <div class="q-items">
          {% for item in items limit: limit %}
            {% assign result_count = result_count | plus: 1 %}
            {% assign result_image = item.image %}
            {% if group == 'products' %}{% assign result_image = item.featured_image %}{% endif %}
            <a class="q-item" href="{{ item.url | escape }}">
              {% if result_image != blank %}{{ result_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'q-item-thumb', alt: '' }}{% endif %}
              <span class="q-item-content">
                <span class="q-item-title">{{ item.title | escape }}</span>
                {% if group == 'products' %}<span class="q-item-sub">{{ item.price | money }}</span>{% elsif group == 'articles' and item.author != blank %}<span class="q-item-sub">{{ item.author | escape }}</span>{% endif %}
              </span>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
  {% if result_count == 0 %}
    <p class="q-ps__empty">No matches for “{{ predictive_search.terms | escape }}”.</p>
    <div class="q-items">
      {% for block in blocks %}
        {% if block.type == 'quick_link' and block.settings.url != blank and block.settings.label != blank %}<a class="q-item" href="{{ block.settings.url | escape }}">{{ block.settings.label | escape }}</a>{% endif %}
      {% endfor %}
    </div>
  {% endif %}
  <p><a data-qps-view-all href="{{ target | escape }}?q={{ predictive_search.terms | url_encode }}&amp;type={{ fallback_type | escape }}">Search all results</a></p>
</div>
