{%- liquid
  assign s = section.settings
  assign qtm_image_loading = 'lazy'
  if settings.images_lazyload == false
    assign qtm_image_loading = 'eager'
  endif
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif

  assign has_any_links = false
-%}

        {%- capture links_markup -%}
          <ul class="q-social-profile__links" role="list" aria-label="Social links">
            {% if s.use_global_social_urls %}
              {% assign networks = 'facebook,instagram,tiktok,youtube,twitter,pinterest' | split: ',' %}
              {% for network in networks %}
                {% liquid
                  assign key = 'social_url_' | append: network
                  assign url = settings[key] | strip
                  assign label = network | capitalize
                  if network == 'twitter'
                    assign label = 'X'
                  endif
                  if network == 'youtube'
                    assign label = 'YouTube'
                  endif
                  if network == 'tiktok'
                    assign label = 'TikTok'
                  endif
                %}
                {%- capture url -%}{%- render 'account-safe-link', url: url -%}{%- endcapture -%}
                {% if url != blank %}
                  {% assign has_any_links = true %}
                  <li class="q-social-profile__link"><a class="q-social-profile__a" href="{{ url | escape }}" target="_blank" rel="noopener noreferrer">
                    {% render 'q-social-profile-icon', network: network %}
                    <span class="{% if s.show_labels %}q-social-profile__label{% else %}q-visually-hidden{% endif %}">{{ label | escape }}</span>
                  </a></li>
                {% endif %}
              {% endfor %}
            {% endif %}

            {%- if has_blocks -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'social_link' -%}
                  {%- liquid
                    assign b = block.settings
                    assign url = b.url | strip
                    assign prefix = url | slice: 0, 8 | downcase
                    assign short_prefix = url | slice: 0, 7 | downcase
                    assign first = url | slice: 0, 1
                    assign valid_url = false
                    if prefix == 'https://' or short_prefix == 'http://' or first == '/'
                      assign valid_url = true
                    endif
                    assign net = b.network
                    assign label = ''
                    if net == 'custom'
                      assign label = b.custom_label | default: 'Website'
                    else
                      assign label = net
                    endif

                    if valid_url
                      assign has_any_links = true
                    endif
                  -%}

                  {%- if valid_url -%}
                    <li class="q-social-profile__link" {{ block.shopify_attributes }}>
                      <a
                        class="q-social-profile__a"
                        href="{{ url | escape }}"
                        {% if b.new_tab %} target="_blank"{% endif %}
                        rel="{% if b.new_tab %}noopener noreferrer{% else %}noopener{% endif %}"
                        aria-label="{{ b.aria_label | default: label | escape }}"
                      >
                        {%- render 'q-social-profile-icon', network: net -%}
                        {%- if s.show_labels -%}
                          <span class="q-social-profile__label">{{ label | escape }}</span>
                        {%- else -%}
                          <span class="q-visually-hidden">{{ label | escape }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {% elsif request.design_mode %}
                    {% assign has_any_links = true %}<li {{ block.shopify_attributes }}>Add an http(s) profile URL or a site path.</li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        {%- endcapture -%}
{% liquid
 assign visible = false
 if s.avatar != blank or s.name != blank or s.role != blank or s.bio != blank or has_any_links
   assign visible = true
 endif
 if s.show_button and s.button_link != blank and s.button_label != blank
   assign visible = true
 endif
 if request.design_mode
   assign visible = true
 endif
%}
{% if visible %}
<section
  id="social-media-profile-card-{{ section.id }}"
  class="q-section q-social-profile q-social-profile--align-{{ s.align }}"
  data-section-id="{{ section.id }}"
  style="--qsp-icon-size: {{ s.icon_size }}px; --qsp-icon-gap: {{ s.icon_gap }}px; --qsp-radius: {{ s.card_radius }}px; --qsp-py: {{ s.padding_y }}px; --qsp-px: {{ s.padding_x }}px; --qsp-pt: {{ s.section_padding_top }}px; --qsp-pb: {{ s.section_padding_bottom }}px;"
>
  <div class="q-social-profile__container">
    <div class="q-social-profile__card{% if s.avatar != blank %} q-social-profile__card--avatar{% endif %}{% if s.use_contrast_surface %} q-social-profile__card--contrast{% endif %}">
      {%- if s.avatar != blank -%}
        <div class="q-social-profile__avatar">
          {%- assign alt_text = s.name | default: s.avatar.alt | default: 'Profile photo' -%}

          {{ s.avatar | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '96px', alt: alt_text, loading: qtm_image_loading }}
        </div>
      {%- endif -%}

      <div class="q-social-profile__content">
        {%- if s.name != blank -%}
          <h2 class="q-social-profile__name">{{ s.name | escape }}</h2>
        {%- endif -%}

        {%- if s.role != blank -%}
          <p class="q-social-profile__role">{{ s.role | escape }}</p>
        {%- endif -%}

        {%- if s.bio != blank -%}
          <div class="q-social-profile__bio rte">
            {{ s.bio | escape | newline_to_br }}
          </div>
        {%- endif -%}

        {%- comment -%}
          Links: global first (optional), then blocks.
          Global theme settings present: social_url_facebook/instagram/tiktok/youtube/twitter/pinterest.
          Treat blank OR "none" as unset.
        {%- endcomment -%}



        {%- if has_any_links -%}
          {{ links_markup }}
        {%- elsif request.design_mode -%}
          <p class="q-social-profile__empty">
            Add social URLs in Theme Settings → Integrations, or add “Social link” blocks to this section.
          </p>
        {%- endif -%}

        {%- if s.show_button and s.button_link != blank and s.button_label != blank -%}
          <div class="q-social-profile__cta">
            <a class="q-social-profile__btn" href="{{ s.button_link | escape }}">
              {{ s.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>




</section>
{% endif %}
<style>

    #social-media-profile-card-{{ section.id }}.q-social-profile { padding-top: var(--qsp-pt); padding-bottom: var(--qsp-pb); }
    #social-media-profile-card-{{ section.id }} .q-social-profile__container { max-width: var(--container-lg, 1152px); margin: 0 auto; padding: 0 16px; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__card {
      border-radius: var(--qsp-radius);
      padding: var(--qsp-py) var(--qsp-px);
      border: 1px solid rgba(0,0,0,.08);
      display: grid;
      grid-template-columns:minmax(0,1fr);
      gap: 16px;
      align-items: start;
    }
    #social-media-profile-card-{{ section.id }} .q-social-profile__card--contrast { background: var(--c-surface, #f6f7f8); }
    #social-media-profile-card-{{ section.id }}.q-social-profile--align-center .q-social-profile__card { text-align: center; grid-template-columns: 1fr; justify-items: center; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__avatar img { width: 96px; height: 96px; border-radius: 999px; object-fit: cover; display: block; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__name { margin: 0; font-size: 1.25rem; line-height: 1.2; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__role { margin: 6px 0 0; opacity: .75; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__bio { margin-top: 12px; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__links {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--qsp-icon-gap);
      align-items: center;
      justify-content: flex-start;
    }
    #social-media-profile-card-{{ section.id }}.q-social-profile--align-center .q-social-profile__links { justify-content: center; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__a {
      display: inline-flex;
      gap: 10px;
      align-items: center;
      text-decoration: none;
      border-radius: 999px;
      padding: 8px 10px;
      border: 1px solid rgba(0,0,0,.10);
      background:var(--c-bg,#fff);color:var(--c-text,#111);
    }
    #social-media-profile-card-{{ section.id }} .q-social-profile__a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__icon { width: var(--qsp-icon-size); height: var(--qsp-icon-size); display: block; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__label { font-size: .95rem; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__cta { margin-top: 16px; }
    #social-media-profile-card-{{ section.id }} .q-social-profile__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 12px 18px;
      text-decoration: none;
      border: 1px solid rgba(0,0,0,.14);
      background:var(--c-primary,#2563eb);color:var(--c-oncolor,#fff);
    }
    #social-media-profile-card-{{ section.id }} .q-social-profile__empty { margin-top: 12px; opacity: .7; }
    #social-media-profile-card-{{ section.id }} .q-visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

#social-media-profile-card-{{ section.id }}{color:var(--c-text,#111111);font-family:var(--font-body);overflow-wrap:anywhere;min-width:0;max-width:100%}
#social-media-profile-card-{{ section.id }} *,#social-media-profile-card-{{ section.id }} *::before,#social-media-profile-card-{{ section.id }} *::after{box-sizing:border-box;min-width:0}
#social-media-profile-card-{{ section.id }} :is(h2,h3){font-family:var(--font-head)}
#social-media-profile-card-{{ section.id }} :is(a,button,[tabindex]):focus-visible{outline:2px solid currentColor;outline-offset:3px}
#social-media-profile-card-{{ section.id }} :is(a,button){max-width:100%;overflow-wrap:anywhere}
#social-media-profile-card-{{ section.id }} [hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){#social-media-profile-card-{{ section.id }} *,#social-media-profile-card-{{ section.id }} *::before,#social-media-profile-card-{{ section.id }} *::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}

#social-media-profile-card-{{ section.id }} .q-social-profile__card--avatar{grid-template-columns:96px minmax(0,1fr)}
#social-media-profile-card-{{ section.id }}.q-social-profile--align-center .q-social-profile__card{grid-template-columns:minmax(0,1fr)}
#social-media-profile-card-{{ section.id }} .q-social-profile__icon{flex-shrink:0;fill:currentColor}
#social-media-profile-card-{{ section.id }} .q-social-profile__icon svg{width:100%;height:100%;display:block}
#social-media-profile-card-{{ section.id }} .q-social-profile__link{max-width:100%}
@media(max-width:600px){#social-media-profile-card-{{ section.id }} .q-social-profile__card--avatar{grid-template-columns:minmax(0,1fr)}#social-media-profile-card-{{ section.id }} .q-social-profile__card{padding-inline:min(var(--qsp-px),8vw)}}

</style>

{% schema %}
{
  "name": "Social Media - Profile",
  "tag": "section",
  "class": "q-host-social-media-profile-card",
  "settings": [
    {
      "type": "paragraph",
      "content": "Profile content and links are manual. Global URLs use Theme Settings → Integrations. No account connection, verification badge or automatic social data is supplied."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar image"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role / title"
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Short bio"
    },
    {
      "type": "checkbox",
      "id": "use_global_social_urls",
      "label": "Use global social URLs (Theme Settings → Integrations)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show network labels next to icons",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size (px)",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Icon gap (px)",
      "min": 6,
      "max": 28,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius (px)",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "use_contrast_surface",
      "label": "Use contrast surface background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Card padding Y (px)",
      "min": 12,
      "max": 72,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Card padding X (px)",
      "min": 12,
      "max": 72,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "instagram",
          "options": [
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "x",
              "label": "X"
            },
            {
              "value": "bluesky",
              "label": "Bluesky"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom label (only if Network = Custom)",
          "default": "Website"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Profile URL",
          "info": "Enter an http(s) URL or a site path beginning with /."
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Screen reader label"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in new tab",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Social Media - Profile",
      "category": "Social Media"
    }
  ]
}
{% endschema %}
