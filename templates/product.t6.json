                  "type": "product-inventory-status",
                  "settings": {
                    "show_inventory": true,
                    "show_stock_count": false,
                    "in_stock_text": "In the shop today",
                    "sold_out_text": "Order in, about a week",
                    "backorder_text": "Order in, about a week",
                    "badge_count": 3,
                    "layout_style": "minimal",
                    "desktop_columns": "3",
                    "mobile_columns": "1",
                    "alignment": "left",
                    "gap": 12,
                    "icon_size": 36,
                    "badge_1_icon": "\u2192",
                    "badge_1_heading": "Ships in 2 to 5 days",
                    "badge_1_text": "<p>Flat in paper, never plastic.</p>",
                    "badge_2_icon": "\u21ba",
                    "badge_2_heading": "Thirty-day returns",
                    "badge_2_text": "<p>Any reason, in the shop or by post.</p>",
                    "badge_3_icon": "\u2713",
                    "badge_3_heading": "Free shop pickup",
                    "badge_3_text": "<p>Ready the same day.</p>"
                  }
                },
                "product_layout_row_1_product_layout_column_2_product_accordion_9": {
                  "type": "product-accordion",
                  "settings": {
                    "show_header": false,
                    "open_first_item": true,
                    "allow_multiple_open": true,
                    "show_description_item": true,
                    "description_title": "About this book",
                    "show_metafield_1": true,
                    "metafield_1_title": "Who might enjoy it",
                    "metafield_1_namespace": "folio",
                    "metafield_1_key": "reader_note",
                    "show_metafield_2": true,
                    "metafield_2_title": "A question to take with you",
                    "metafield_2_namespace": "folio",
                    "metafield_2_key": "discussion_question",
                    "show_shipping_item": true,
                    "shipping_title": "Shipping and pickup",
                    "shipping_text": "<p>Flat-rate shipping shown at checkout. Free shop pickup, ready the same day and held for ten days.</p>",
                    "show_returns_item": true,
                    "returns_title": "Returns",
                    "returns_text": "<p>Thirty days, any reason, with the receipt or order email.</p>",
                    "show_care_item": false,
                    "show_custom_item": true,
                    "custom_title": "Edition details",
                    "custom_text": "<p>Formats are listed above. The front-cover artwork is shared across formats. Creators are fictional placeholders and demo prices are illustrative.</p>"
                  }
                },
                "product_layout_row_1_product_layout_column_2_product_share_10": {
                  "type": "product-share",
                  "settings": {
                    "show_label": true,
                    "label": "Share",
                    "share_style": "icons",
                    "show_native_share": true,
                    "show_facebook": true,
                    "show_x": true,
                    "show_pinterest": true,
                    "show_email": true,
                    "show_copy_link": true,
                    "show_message": false,
                    "button_size": 40,
                    "label_color": "#62665E",
                    "text_color": "#182E2A",
                    "background_color": "#F6F1E7",
                    "border_color": "#E5D8BE",
                    "hover_background_color": "#182E2A"
                  }
                }
              },
              "block_order": [
                "product_layout_row_1_product_layout_column_2_product_vendor_1",
                "product_layout_row_1_product_layout_column_2_product_title_2",
                "product_layout_row_1_product_layout_column_2_product_subtitle_3",
                "product_layout_row_1_product_layout_column_2_product_price_4",
                "product_layout_row_1_product_layout_column_2_product_sku_5",
                "product_layout_row_1_product_layout_column_2_product_variant_picker_6",
                "product_layout_row_1_product_layout_column_2_product_add_to_cart_7",
                "product_layout_row_1_product_layout_column_2_product_inventory_status_8",
                "product_layout_row_1_product_layout_column_2_product_accordion_9",
                "product_layout_row_1_product_layout_column_2_product_share_10"
