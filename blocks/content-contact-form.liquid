{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-contact-form
    qtm-contact-form-{{ block_id }}
    qtm-contact-form--width-{{ block_width }}
    qtm-contact-form--align-{{ block_alignment }}
    qtm-contact-form--layout-{{ block.settings.layout_style }}
    qtm-contact-form--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-contact-form--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-contact-form--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-contact-form--hide-mobile{% endunless %}
  "
  style="
    --qtm-contact-form-margin-top: {{ block.settings.margin_top }}px;
    --qtm-contact-form-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-contact-form-padding: {{ block.settings.padding }}px;
    --qtm-contact-form-gap: {{ block.settings.gap }}px;
    --qtm-contact-form-heading-color: {{ block.settings.heading_color }};
    --qtm-contact-form-text-color: {{ block.settings.text_color }};
    --qtm-contact-form-background-color: {{ block.settings.background_color }};
    --qtm-contact-form-card-background: {{ block.settings.card_background_color }};
    --qtm-contact-form-border-color: {{ block.settings.border_color }};
    --qtm-contact-form-link-color: {{ block.settings.link_color }};
    --qtm-contact-form-input-background: {{ block.settings.input_background_color }};
    --qtm-contact-form-input-text: {{ block.settings.input_text_color }};
    --qtm-contact-form-button-background: {{ block.settings.button_background_color }};
    --qtm-contact-form-button-text: {{ block.settings.button_text_color }};
    --qtm-contact-form-success-color: {{ block.settings.success_color }};
    --qtm-contact-form-error-color: {{ block.settings.error_color }};
    --qtm-contact-form-border-width: {{ block.settings.border_width }}px;
    --qtm-contact-form-border-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-contact-form__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-contact-form__content">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-contact-form__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-contact-form__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-contact-form__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="qtm-contact-form__form-card">
      {% form 'contact', class: 'qtm-contact-form__form' %}
        {% if form.posted_successfully? %}
          <div
            class="qtm-contact-form__message qtm-contact-form__message--success"
            role="status"
            tabindex="-1"
          >
            {{ block.settings.success_message | escape }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div
            class="qtm-contact-form__message qtm-contact-form__message--error"
            role="alert"
          >
            {{ block.settings.error_message | escape }}
          </div>
        {% endif %}

        <div class="qtm-contact-form__fields">
          <div class="qtm-contact-form__field qtm-contact-form__field--name">
            <label class="qtm-contact-form__label" for="qtm-contact-form-name-{{ block_id }}">
              {{ block.settings.name_label | escape }}
            </label>

            <input
              id="qtm-contact-form-name-{{ block_id }}"
              class="qtm-contact-form__input"
              type="text"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              autocomplete="name"
              placeholder="{{ block.settings.name_placeholder | escape }}"
              required
            >
          </div>

          <div class="qtm-contact-form__field qtm-contact-form__field--email">
            <label class="qtm-contact-form__label" for="qtm-contact-form-email-{{ block_id }}">
              {{ block.settings.email_label | escape }}
            </label>

            <input
              id="qtm-contact-form-email-{{ block_id }}"
              class="qtm-contact-form__input"
              type="email"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ block.settings.email_placeholder | escape }}"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="qtm-contact-form-error-{{ block_id }}"
              {% endif %}
            >
          </div>

          {% if block.settings.show_phone %}
            <div class="qtm-contact-form__field qtm-contact-form__field--phone">
              <label class="qtm-contact-form__label" for="qtm-contact-form-phone-{{ block_id }}">
                {{ block.settings.phone_label | escape }}
              </label>

              <input
                id="qtm-contact-form-phone-{{ block_id }}"
                class="qtm-contact-form__input"
                type="tel"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone }}{% endif %}"
                autocomplete="tel"
                placeholder="{{ block.settings.phone_placeholder | escape }}"
                {% if block.settings.require_phone %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if block.settings.show_subject %}
            <div class="qtm-contact-form__field qtm-contact-form__field--subject">
              <label class="qtm-contact-form__label" for="qtm-contact-form-subject-{{ block_id }}">
                {{ block.settings.subject_label | escape }}
              </label>

              <input
                id="qtm-contact-form-subject-{{ block_id }}"
                class="qtm-contact-form__input"
                type="text"
                name="contact[subject]"
                value="{% if form.subject %}{{ form.subject }}{% endif %}"
                placeholder="{{ block.settings.subject_placeholder | escape }}"
                {% if block.settings.require_subject %}required{% endif %}
              >
            </div>
          {% endif %}

          <div class="qtm-contact-form__field qtm-contact-form__field--message">
            <label class="qtm-contact-form__label" for="qtm-contact-form-message-{{ block_id }}">
              {{ block.settings.message_label | escape }}
            </label>

            <textarea
              id="qtm-contact-form-message-{{ block_id }}"
              class="qtm-contact-form__textarea"
              name="contact[body]"
              rows="{{ block.settings.message_rows }}"
              placeholder="{{ block.settings.message_placeholder | escape }}"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
        </div>

        {% if block.settings.show_consent %}
          <div class="qtm-contact-form__consent">
            <input
              id="qtm-contact-form-consent-{{ block_id }}"
              class="qtm-contact-form__checkbox"
              type="checkbox"
              name="contact[consent]"
              value="{{ block.settings.consent_text | escape }}"
              required
            >

            <label class="qtm-contact-form__consent-label" for="qtm-contact-form-consent-{{ block_id }}">
              {{ block.settings.consent_text | escape }}
            </label>
          </div>
        {% endif %}

        {% if form.errors %}
          <span id="qtm-contact-form-error-{{ block_id }}" class="visually-hidden">
            {{ block.settings.error_message | escape }}
          </span>
        {% endif %}

        <button class="qtm-contact-form__button" type="submit">
          {{ block.settings.button_label | escape }}
        </button>

        {% if block.settings.disclaimer != blank %}
          <div class="qtm-contact-form__disclaimer">
            {{ block.settings.disclaimer }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

<style>
  .qtm-contact-form-{{ block_id }} {
    margin-top: var(--qtm-contact-form-margin-top);
    margin-bottom: var(--qtm-contact-form-margin-bottom);
    padding: var(--qtm-contact-form-padding);
    color: var(--qtm-contact-form-text-color);
    background: var(--qtm-contact-form-background-color);
    border: var(--qtm-contact-form-border-width) solid var(--qtm-contact-form-border-color);
    border-radius: var(--qtm-contact-form-border-radius);
  }

  .qtm-contact-form-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--width-auto {
    width: auto;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--width-small {
    max-width: 640px;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--width-medium {
    max-width: 860px;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--width-large {
    max-width: 1120px;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__inner {
    display: grid;
    gap: var(--qtm-contact-form-gap);
    align-items: start;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__inner {
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-stacked .qtm-contact-form__inner,
  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-card .qtm-contact-form__inner,
  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-minimal .qtm-contact-form__inner {
    grid-template-columns: 1fr;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__content {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-center .qtm-contact-form__content {
    margin-inline: auto;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-right .qtm-contact-form__content {
    margin-left: auto;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__eyebrow {
    margin: 0;
    color: var(--qtm-contact-form-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__heading {
    margin: 0;
    color: var(--qtm-contact-form-heading-color);
    line-height: 1.05;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__text,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__disclaimer {
    color: var(--qtm-contact-form-text-color);
    line-height: 1.7;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__text p,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__disclaimer p {
    margin-top: 0;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__text p:last-child,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__disclaimer p:last-child {
    margin-bottom: 0;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__form-card {
    width: 100%;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-card .qtm-contact-form__form-card,
  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__form-card {
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--qtm-contact-form-card-background);
    border: 1px solid color-mix(in srgb, var(--qtm-contact-form-border-color), transparent 10%);
    border-radius: calc(var(--qtm-contact-form-border-radius) * 0.75);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.055);
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-minimal .qtm-contact-form__form-card {
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__form {
    display: grid;
    gap: 1rem;
    width: 100%;
    text-align: left;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__fields {
    display: grid;
    gap: 0.9rem;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__fields {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__field--message,
  .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__field--subject {
    grid-column: 1 / -1;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__label {
    color: var(--qtm-contact-form-heading-color);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__input,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    color: var(--qtm-contact-form-input-text);
    background: var(--qtm-contact-form-input-background);
    border: 1px solid color-mix(in srgb, var(--qtm-contact-form-border-color), transparent 5%);
    border-radius: calc(var(--qtm-contact-form-border-radius) * 0.45);
    font: inherit;
    line-height: 1.35;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__input {
    min-height: 3rem;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__textarea {
    min-height: 8.5rem;
    resize: vertical;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__input::placeholder,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__textarea::placeholder {
    color: color-mix(in srgb, var(--qtm-contact-form-input-text), transparent 45%);
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__input:focus-visible,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__textarea:focus-visible,
  .qtm-contact-form-{{ block_id }} .qtm-contact-form__checkbox:focus-visible {
    outline: 3px solid var(--qtm-contact-form-link-color);
    outline-offset: 3px;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__consent {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__checkbox {
    width: 1rem;
    height: 1rem;
    margin-top: 0.18rem;
    accent-color: var(--qtm-contact-form-link-color);
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__consent-label {
    color: var(--qtm-contact-form-text-color);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 3rem;
    padding: 0.85rem 1.25rem;
    color: var(--qtm-contact-form-button-text);
    background: var(--qtm-contact-form-button-background);
    border: 1px solid var(--qtm-contact-form-button-background);
    border-radius: calc(var(--qtm-contact-form-border-radius) * 0.45);
    font: inherit;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    cursor: pointer;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-center .qtm-contact-form__button {
    justify-self: center;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--align-right .qtm-contact-form__button {
    justify-self: end;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__button:hover {
    opacity: 0.86;
    transform: translateY(-1px);
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__button:focus-visible {
    outline: 3px solid var(--qtm-contact-form-link-color);
    outline-offset: 4px;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__message {
    padding: 0.75rem 0.85rem;
    border-radius: calc(var(--qtm-contact-form-border-radius) * 0.42);
    font-weight: 700;
    line-height: 1.45;
    text-align: left;
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__message--success {
    color: var(--qtm-contact-form-success-color);
    background: color-mix(in srgb, var(--qtm-contact-form-success-color), transparent 92%);
    border: 1px solid color-mix(in srgb, var(--qtm-contact-form-success-color), transparent 72%);
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__message--error {
    color: var(--qtm-contact-form-error-color);
    background: color-mix(in srgb, var(--qtm-contact-form-error-color), transparent 92%);
    border: 1px solid color-mix(in srgb, var(--qtm-contact-form-error-color), transparent 72%);
  }

  .qtm-contact-form-{{ block_id }} .qtm-contact-form__disclaimer {
    font-size: 0.82rem;
    opacity: 0.78;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--animation-fade {
    animation: qtm-contact-form-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--animation-fade-up {
    animation: qtm-contact-form-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--animation-fade-down {
    animation: qtm-contact-form-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--animation-fade-left {
    animation: qtm-contact-form-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--animation-fade-right {
    animation: qtm-contact-form-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-contact-form-{{ block_id }}.qtm-contact-form--animation-zoom {
    animation: qtm-contact-form-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-contact-form-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-contact-form-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-contact-form-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-contact-form-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-contact-form-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-contact-form-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-contact-form-{{ block_id }}.qtm-contact-form--hide-tablet {
      display: none !important;
    }

    .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-contact-form-{{ block_id }}.qtm-contact-form--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-contact-form-{{ block_id }} {
      padding: min(var(--qtm-contact-form-padding), 24px);
    }

    .qtm-contact-form-{{ block_id }}.qtm-contact-form--hide-mobile {
      display: none !important;
    }

    .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__fields {
      grid-template-columns: 1fr;
    }

    .qtm-contact-form-{{ block_id }} .qtm-contact-form__button {
      width: 100%;
    }

    .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-card .qtm-contact-form__form-card,
    .qtm-contact-form-{{ block_id }}.qtm-contact-form--layout-two-column .qtm-contact-form__form-card {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-contact-form-{{ block_id }},
    .qtm-contact-form-{{ block_id }} *,
    .qtm-contact-form-{{ block_id }} *::before,
    .qtm-contact-form-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send us a message"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Have a question? Fill out the form and our team will get back to you as soon as possible.</p>"
    },
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
