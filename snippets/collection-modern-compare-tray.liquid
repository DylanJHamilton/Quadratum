{% comment %}Collection comparison tray and accessible dialog.{% endcomment %}
{% if s.enable_compare %}
<q-collection-compare data-limit="{{ s.compare_limit | default: 3 }}">
  <div class="qcm__compare" hidden data-qcm-compare>
    <span><strong data-qcm-compare-count>0</strong> selected</span>
    <div data-qcm-selected-links aria-label="Selected products"></div>
    <button type="button" data-qcm-compare-open disabled>Compare products</button>
    <button type="button" data-qcm-compare-clear>Clear</button>
  </div>
  <p class="visually-hidden" role="status" data-qcm-compare-status></p>
  <dialog class="qcm__compare-dialog" aria-labelledby="CompareTitle-{{ section_id }}">
    <header><h2 id="CompareTitle-{{ section_id }}">Compare products</h2><button type="button" data-qcm-compare-close aria-label="Close product comparison">×</button></header>
    <div class="qcm__compare-table" tabindex="0" role="region" aria-label="Product comparison table"><table><thead></thead><tbody></tbody></table></div>
  </dialog>
</q-collection-compare>
{% endif %}
