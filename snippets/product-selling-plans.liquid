{% if product.selling_plan_groups.size > 0 %}
  <div class="product-form-block__selling-plan">
    <label class="product-form-block__label" for="SellingPlan-{{ id }}">{{ label | default: 'Purchase options' | escape }}</label>
    <select id="SellingPlan-{{ id }}" name="selling_plan" class="product-form-block__select" data-product-form-selling-plan {% if product.requires_selling_plan %}required{% endif %}>
      {% unless product.requires_selling_plan %}<option value="">{{ one_time_label | default: 'One-time purchase' | escape }}</option>{% endunless %}
      {% for group in product.selling_plan_groups %}
        <optgroup label="{{ group.name | escape }}">
          {% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}
        </optgroup>
      {% endfor %}
    </select>
    {% if note != blank %}<p class="product-form-block__selling-plan-note">{{ note | escape }}</p>{% endif %}
    <script type="application/json" data-selling-plan-variants>{{ product.variants | json }}</script>
  </div>
  <script src="{{ 'product-selling-plans.js' | asset_url }}" defer></script>
{% endif %}
