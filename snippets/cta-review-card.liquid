{%- liquid
  assign b = block.settings
  assign review_rating = b.rating | default: 5 | at_least: 1 | at_most: 5
  assign product_name = b.product_name_override | default: b.product.title
  assign has_media = false
  if b.review_image != blank or b.review_video_url != blank
    assign has_media = true
  endif
-%}
<div class="q-review-slide-inner{% unless has_media %} q-review-no-media{% endunless %}">
  {%- if has_media -%}
    <div class="q-review-image-wrapper q-review-media">
      {%- if b.review_image != blank -%}
        {%- assign review_alt = b.review_image.alt | default: product_name | default: 'Review image' -%}
        {%- capture review_image -%}
          {{ b.review_image | image_url: width: 1200 | image_tag: class: 'q-review-img', alt: review_alt, loading: 'lazy', widths: '320,480,640,900,1200', sizes: '(min-width: 1024px) 40vw, 90vw' }}
        {%- endcapture -%}
        {%- if b.product.url != blank -%}
          <a href="{{ b.product.url | escape }}" aria-label="View {{ product_name | escape }}">{{ review_image }}</a>
        {%- else -%}
          {{ review_image }}
        {%- endif -%}
      {%- endif -%}
      {%- if b.review_video_url != blank -%}
        <video class="q-review-video-el" controls playsinline preload="none" aria-label="Review video{% if b.reviewer_name != blank %} by {{ b.reviewer_name | escape }}{% endif %}">
          <source src="{{ b.review_video_url | escape }}" type="video/mp4">
        </video>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="q-review-content">
    <div class="q-review-stars" role="img" aria-label="{{ review_rating }} out of 5 stars">
      {%- for i in (1..5) -%}
        <svg class="q-review-star {% if i <= review_rating %}q-star-filled{% else %}q-star-empty{% endif %}" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false" {% if i <= review_rating %}fill="currentColor"{% else %}fill="none" stroke="currentColor" stroke-width="2"{% endif %}><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- endfor -%}
    </div>
    {%- if b.review_text != blank -%}<blockquote class="q-review-text"><p>{{ b.review_text | escape }}</p></blockquote>{%- endif -%}
    <div class="q-reviewer-meta">
      <div class="q-reviewer-row">
        {%- if b.reviewer_image != blank -%}
          {%- assign reviewer_alt = b.reviewer_image.alt | default: b.reviewer_name -%}
          {{ b.reviewer_image | image_url: width: 96 | image_tag: class: 'q-reviewer-avatar', alt: reviewer_alt, loading: 'lazy', width: 48, height: 48 }}
        {%- endif -%}
        <div class="q-reviewer-details">
          {%- if b.reviewer_name != blank -%}<p class="q-reviewer-name">{{ b.reviewer_name | escape }}</p>{%- endif -%}
          {%- if b.reviewer_location != blank -%}<p class="q-reviewer-location">{{ b.reviewer_location | escape }}</p>{%- endif -%}
          {%- if b.verified_purchase -%}<span class="q-verified-badge">Verified Purchase</span>{%- endif -%}
        </div>
      </div>
      {%- if b.review_date != blank -%}<p class="q-review-date">{{ b.review_date | escape }}</p>{%- endif -%}
    </div>
    {%- if product_name != blank -%}
      <p class="q-product-name">
        {%- if b.product.url != blank -%}<a href="{{ b.product.url | escape }}">{{ product_name | escape }}</a>{%- else -%}{{ product_name | escape }}{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>
