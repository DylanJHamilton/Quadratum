{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
  assign selected_menu = block.settings.menu
%}

<div
  class="
    qtm-menu-list
    qtm-menu-list-{{ block_id }}
    qtm-menu-list--width-{{ block_width }}
    qtm-menu-list--align-{{ block_alignment }}
    qtm-menu-list--layout-{{ block.settings.layout_style }}
    qtm-menu-list--animation-{{ animation }}
    {% if block.settings.enable_mobile_accordion %} qtm-menu-list--mobile-accordion{% endif %}
    {% unless block.settings.show_desktop %} qtm-menu-list--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-menu-list--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-menu-list--hide-mobile{% endunless %}
  "
  style="
    --qtm-menu-list-margin-top: {{ block.settings.margin_top }}px;
    --qtm-menu-list-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-menu-list-padding: {{ block.settings.padding }}px;
    --qtm-menu-list-gap: {{ block.settings.gap }}px;
    --qtm-menu-list-heading-color: {{ block.settings.heading_color }};
    --qtm-menu-list-text-color: {{ block.settings.text_color }};
    --qtm-menu-list-background-color: {{ block.settings.background_color }};
    --qtm-menu-list-item-background: {{ block.settings.item_background_color }};
    --qtm-menu-list-active-background: {{ block.settings.active_background_color }};
    --qtm-menu-list-border-color: {{ block.settings.border_color }};
    --qtm-menu-list-link-color: {{ block.settings.link_color }};
    --qtm-menu-list-active-color: {{ block.settings.active_link_color }};
    --qtm-menu-list-border-width: {{ block.settings.border_width }}px;
    --qtm-menu-list-border-radius: {{ block.settings.border_radius }}px;
    --qtm-menu-list-columns: {{ block.settings.columns }};
  "
  {{ block.shopify_attributes }}
>
  <nav class="qtm-menu-list__nav" aria-label="{{ block.settings.nav_label | escape }}">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-menu-list__header">
        {% if block.settings.heading != blank %}
          <h2 class="qtm-menu-list__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-menu-list__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if selected_menu != blank and selected_menu.links.size > 0 %}
      <ul class="qtm-menu-list__list" role="list">
        {% for link in selected_menu.links %}
          <li class="qtm-menu-list__item {% if link.active or link.child_active %}is-active{% endif %}">
            {% if link.links.size > 0 %}
              <details class="qtm-menu-list__details" {% if link.active or link.child_active or block.settings.expand_nested_by_default %}open{% endif %}>
                <summary class="qtm-menu-list__summary">
                  <span class="qtm-menu-list__summary-text">
                    {{ link.title | escape }}
                  </span>

                  <span class="qtm-menu-list__summary-icon" aria-hidden="true">
                    {{ block.settings.accordion_icon | escape }}
                  </span>
                </summary>

                <ul class="qtm-menu-list__sublist" role="list">
                  {% for child_link in link.links %}
                    <li class="qtm-menu-list__subitem {% if child_link.active or child_link.child_active %}is-active{% endif %}">
                      <a
                        class="qtm-menu-list__link qtm-menu-list__link--child"
                        href="{{ child_link.url }}"
                        {% if child_link.active %}aria-current="page"{% endif %}
                      >
                        {{ child_link.title | escape }}
                      </a>

                      {% if child_link.links.size > 0 and block.settings.show_grandchildren %}
                        <ul class="qtm-menu-list__grandlist" role="list">
                          {% for grandchild_link in child_link.links %}
                            <li class="qtm-menu-list__granditem {% if grandchild_link.active %}is-active{% endif %}">
                              <a
                                class="qtm-menu-list__link qtm-menu-list__link--grandchild"
                                href="{{ grandchild_link.url }}"
                                {% if grandchild_link.active %}aria-current="page"{% endif %}
                              >
                                {{ grandchild_link.title | escape }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a
                class="qtm-menu-list__link qtm-menu-list__link--parent"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="qtm-menu-list__empty" role="note">
        {{ block.settings.empty_message | escape }}
      </div>
    {% endif %}
  </nav>
</div>

<style>
  .qtm-menu-list-{{ block_id }} {
    margin-top: var(--qtm-menu-list-margin-top);
    margin-bottom: var(--qtm-menu-list-margin-bottom);
    padding: var(--qtm-menu-list-padding);
    color: var(--qtm-menu-list-text-color);
    background: var(--qtm-menu-list-background-color);
    border: var(--qtm-menu-list-border-width) solid var(--qtm-menu-list-border-color);
    border-radius: var(--qtm-menu-list-border-radius);
  }

  .qtm-menu-list-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--width-auto {
    width: auto;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--width-small {
    max-width: 520px;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--width-medium {
    max-width: 760px;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--width-large {
    max-width: 1120px;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__nav {
    display: grid;
    gap: var(--qtm-menu-list-gap);
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__header {
    display: grid;
    gap: 0.6rem;
    max-width: 720px;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-center .qtm-menu-list__header {
    margin-inline: auto;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-right .qtm-menu-list__header {
    margin-left: auto;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__heading {
    margin: 0;
    color: var(--qtm-menu-list-heading-color);
    line-height: 1.08;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__text {
    color: var(--qtm-menu-list-text-color);
    line-height: 1.7;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__text p {
    margin-top: 0;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__list,
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__sublist,
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__grandlist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__list {
    display: grid;
    gap: calc(var(--qtm-menu-list-gap) * 0.45);
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal .qtm-menu-list__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal.qtm-menu-list--align-center .qtm-menu-list__list {
    justify-content: center;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal.qtm-menu-list--align-right .qtm-menu-list__list {
    justify-content: flex-end;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-columns .qtm-menu-list__list {
    grid-template-columns: repeat(var(--qtm-menu-list-columns), minmax(0, 1fr));
    align-items: start;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__item {
    min-width: 0;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__link,
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: {{ block.settings.item_height }}px;
    padding: 0.65rem 0.8rem;
    color: var(--qtm-menu-list-link-color);
    background: var(--qtm-menu-list-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-menu-list-border-color), transparent 10%);
    border-radius: calc(var(--qtm-menu-list-border-radius) * 0.5);
    font-weight: 750;
    line-height: 1.25;
    text-decoration: none;
    text-align: left;
    cursor: pointer;
    transition: opacity 180ms ease, transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-center .qtm-menu-list__link,
  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-center .qtm-menu-list__summary {
    justify-content: center;
    text-align: center;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-right .qtm-menu-list__link,
  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-right .qtm-menu-list__summary {
    text-align: right;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__link:hover,
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__summary:hover {
    opacity: 0.84;
    transform: translateY(-1px);
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__link:focus-visible,
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__summary:focus-visible {
    outline: 3px solid var(--qtm-menu-list-link-color);
    outline-offset: 4px;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__link[aria-current="page"],
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__item.is-active > .qtm-menu-list__link,
  .qtm-menu-list-{{ block_id }} .qtm-menu-list__item.is-active > .qtm-menu-list__details > .qtm-menu-list__summary {
    color: var(--qtm-menu-list-active-color);
    background: var(--qtm-menu-list-active-background);
    border-color: color-mix(in srgb, var(--qtm-menu-list-active-color), transparent 70%);
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__details {
    display: grid;
    gap: 0.5rem;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__details summary {
    list-style: none;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__details summary::-webkit-details-marker {
    display: none;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__summary-icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: currentColor;
    font-weight: 900;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__details[open] > .qtm-menu-list__summary .qtm-menu-list__summary-icon {
    transform: rotate(45deg);
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__sublist {
    display: grid;
    gap: 0.4rem;
    padding: 0.25rem 0 0.25rem {{ block.settings.nested_indent }}px;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-right .qtm-menu-list__sublist {
    padding-left: 0;
    padding-right: {{ block.settings.nested_indent }}px;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__grandlist {
    display: grid;
    gap: 0.35rem;
    padding: 0.4rem 0 0.2rem {{ block.settings.nested_indent }}px;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--align-right .qtm-menu-list__grandlist {
    padding-left: 0;
    padding-right: {{ block.settings.nested_indent }}px;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__link--child {
    min-height: {{ block.settings.child_item_height }}px;
    padding: 0.5rem 0.7rem;
    font-size: 0.95em;
    font-weight: 650;
    background: color-mix(in srgb, var(--qtm-menu-list-item-background), transparent 24%);
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__link--grandchild {
    min-height: auto;
    padding: 0.35rem 0.55rem;
    font-size: 0.88em;
    font-weight: 600;
    background: transparent;
    border-color: transparent;
    opacity: 0.86;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal .qtm-menu-list__details {
    position: relative;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal .qtm-menu-list__details[open] .qtm-menu-list__sublist {
    position: absolute;
    left: 0;
    top: calc(100% + 0.45rem);
    z-index: 20;
    min-width: 220px;
    padding: 0.6rem;
    background: var(--qtm-menu-list-background-color);
    border: 1px solid color-mix(in srgb, var(--qtm-menu-list-border-color), transparent 8%);
    border-radius: calc(var(--qtm-menu-list-border-radius) * 0.6);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.12);
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-minimal .qtm-menu-list__link,
  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-minimal .qtm-menu-list__summary {
    min-height: auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-minimal .qtm-menu-list__link--child,
  .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-minimal .qtm-menu-list__link--grandchild {
    padding: 0;
    background: transparent;
    border: 0;
  }

  .qtm-menu-list-{{ block_id }} .qtm-menu-list__empty {
    padding: 1rem;
    color: var(--qtm-menu-list-text-color);
    background: var(--qtm-menu-list-item-background);
    border: 1px dashed var(--qtm-menu-list-border-color);
    border-radius: calc(var(--qtm-menu-list-border-radius) * 0.55);
    line-height: 1.5;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--animation-fade {
    animation: qtm-menu-list-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--animation-fade-up {
    animation: qtm-menu-list-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--animation-fade-down {
    animation: qtm-menu-list-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--animation-fade-left {
    animation: qtm-menu-list-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--animation-fade-right {
    animation: qtm-menu-list-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-menu-list-{{ block_id }}.qtm-menu-list--animation-zoom {
    animation: qtm-menu-list-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-menu-list-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-menu-list-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-menu-list-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-menu-list-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-menu-list-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-menu-list-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-menu-list-{{ block_id }}.qtm-menu-list--hide-tablet {
      display: none !important;
    }

    .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-columns .qtm-menu-list__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal .qtm-menu-list__details[open] .qtm-menu-list__sublist {
      position: static;
      min-width: 0;
      margin-top: 0.5rem;
      box-shadow: none;
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-menu-list-{{ block_id }}.qtm-menu-list--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-menu-list-{{ block_id }} {
      padding: min(var(--qtm-menu-list-padding), 24px);
    }

    .qtm-menu-list-{{ block_id }}.qtm-menu-list--hide-mobile {
      display: none !important;
    }

    .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-columns .qtm-menu-list__list,
    .qtm-menu-list-{{ block_id }}.qtm-menu-list--layout-horizontal .qtm-menu-list__list {
      display: grid;
      grid-template-columns: 1fr;
    }

    .qtm-menu-list-{{ block_id }}.qtm-menu-list--mobile-accordion .qtm-menu-list__item:not(.is-active) .qtm-menu-list__details:not([open]) .qtm-menu-list__sublist {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-menu-list-{{ block_id }},
    .qtm-menu-list-{{ block_id }} *,
    .qtm-menu-list-{{ block_id }} *::before,
    .qtm-menu-list-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Menu list",
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation label",
      "default": "Menu navigation"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty message",
      "default": "Choose a menu to display links."
    },
    {
      "type": "checkbox",
      "id": "show_grandchildren",
      "label": "Show third-level links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "expand_nested_by_default",
      "label": "Expand nested links by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_accordion",
      "label": "Enable mobile accordion behavior",
      "default": true
    },
    {
      "type": "text",
      "id": "accordion_icon",
      "label": "Accordion icon",
      "default": "+"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Menu"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this block to display a Shopify menu inside a flexible Quadratum layout.</p>"
    },
    {
      "type": "header",
      "content": "Sizing"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "item_height",
      "label": "Parent item height",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "child_item_height",
      "label": "Child item height",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "nested_indent",
      "label": "Nested indent",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "vertical",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "columns",
          "label": "Columns"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
