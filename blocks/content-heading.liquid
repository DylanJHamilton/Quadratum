      "default": "Build a better store with Quadratum"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "div",
          "label": "DIV"
        },
        {
          "value": "span",
          "label": "SPAN"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style",
      "default": "large",
      "options": [
        {
          "value": "display",
          "label": "Display"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 280,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "default": "heading",
      "options": [
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "inherit",
          "label": "Inherit"
        }
      ]
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "700",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -4,
      "max": 8,
      "step": 0.5,
      "unit": "px",
      "default": -1
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 105
    },
    {
      "type": "header",
      "content": "Effects"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_text",
      "label": "Enable gradient text",
      "default": false
    },
    {
      "type": "color_background",
      "id": "text_gradient",
      "label": "Text gradient"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight text",
      "info": "Enter exact text from the heading to highlight."
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "highlight_background",
      "label": "Highlight background",
      "default": "#f4d35e"
    },
    {
      "type": "range",
      "id": "highlight_radius",
      "label": "Highlight radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
