{%- liquid
  assign block_id = 'product-type-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign type_style = block.settings.type_style | default: 'standard'

  assign product_type = product_context.type

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign type_url = ''
  if product_type != blank
    assign type_url = product_type | url_for_type
  endif
-%}

{% if product_type != blank or block.settings.hide_when_empty == false %}
  <div
    id="{{ block_id }}"
    class="
      product-type
      product-type--{{ type_style }}
      product-type--width-{{ width }}
      product-type--align-{{ alignment }}
      {% if product_type == blank and block.settings.hide_when_empty %} product-type--empty{% endif %}
      {% unless show_on_desktop %} product-type--hide-desktop{% endunless %}
      {% unless show_on_tablet %} product-type--hide-tablet{% endunless %}
      {% unless show_on_mobile %} product-type--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' %} product-type--animate product-type--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-type-margin-top: {{ block.settings.margin_top }}px;
      --product-type-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-type-padding: {{ block.settings.padding }}px;
      --product-type-font-size: {{ block.settings.font_size }}px;
      --product-type-letter-spacing: {{ block.settings.letter_spacing }}px;
      --product-type-text-color: {{ block.settings.text_color }};
      --product-type-label-color: {{ block.settings.label_color }};
      --product-type-background-color: {{ block.settings.background_color }};
      --product-type-border-color: {{ block.settings.border_color }};
      --product-type-border-width: {{ block.settings.border_width }}px;
      --product-type-border-radius: {{ block.settings.border_radius }}px;
    "
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-product-type
    {{ block.shopify_attributes }}
  >
    <style>
      #{{ block_id }} {
        width: 100%;
        margin-top: var(--product-type-margin-top);
        margin-bottom: var(--product-type-margin-bottom);
        padding: var(--product-type-padding);
        color: var(--product-type-text-color);
        background: transparent;
      }

      #{{ block_id }}.product-type--empty {
        display: none;
      }

      #{{ block_id }}.product-type--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-type--width-small {
        max-width: 640px;
      }

      #{{ block_id }}.product-type--width-medium {
        max-width: 820px;
      }

      #{{ block_id }}.product-type--width-large {
        max-width: 1040px;
      }

      #{{ block_id }}.product-type--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-type--align-left {
        margin-left: 0;
        margin-right: auto;
        text-align: left;
      }

      #{{ block_id }}.product-type--align-center {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      #{{ block_id }}.product-type--align-right {
        margin-left: auto;
        margin-right: 0;
        text-align: right;
      }

      #{{ block_id }} .product-type__inner {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
        color: var(--product-type-text-color);
        font-size: var(--product-type-font-size);
        line-height: 1.25;
        letter-spacing: var(--product-type-letter-spacing);
        text-transform: {{ block.settings.text_transform }};
      }

      #{{ block_id }}.product-type--badge .product-type__inner {
        padding: 7px 11px;
        color: var(--product-type-text-color);
        background: var(--product-type-background-color);
        border: var(--product-type-border-width) solid var(--product-type-border-color);
        border-radius: var(--product-type-border-radius);
      }

      #{{ block_id }}.product-type--minimal .product-type__inner {
        opacity: 0.82;
      }

      #{{ block_id }} .product-type__label {
        color: var(--product-type-label-color);
        white-space: nowrap;
      }

      #{{ block_id }} .product-type__value,
      #{{ block_id }} .product-type__link {
        color: var(--product-type-text-color);
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      #{{ block_id }} .product-type__link {
        border-bottom: 1px solid currentColor;
        padding-bottom: 2px;
        transition: opacity 180ms ease;
      }

      #{{ block_id }} .product-type__link:hover {
        opacity: 0.72;
      }

      #{{ block_id }} .product-type__link:focus-visible {
        outline: 2px solid var(--product-type-text-color);
        outline-offset: 3px;
        border-radius: 4px;
      }

      #{{ block_id }}.product-type--align-center .product-type__inner {
        margin-left: auto;
        margin-right: auto;
      }

      #{{ block_id }}.product-type--align-right .product-type__inner {
        margin-left: auto;
        margin-right: 0;
      }

      #{{ block_id }}.product-type--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-type--animate-fade {
        animation-name: productTypeFade;
      }

      #{{ block_id }}.product-type--animate-fade_up {
        animation-name: productTypeFadeUp;
      }

      #{{ block_id }}.product-type--animate-fade_down {
        animation-name: productTypeFadeDown;
      }

      #{{ block_id }}.product-type--animate-fade_left {
        animation-name: productTypeFadeLeft;
      }

      #{{ block_id }}.product-type--animate-fade_right {
        animation-name: productTypeFadeRight;
      }

      #{{ block_id }}.product-type--animate-zoom {
        animation-name: productTypeZoom;
      }

      @keyframes productTypeFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productTypeFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productTypeFadeDown {
        from {
          opacity: 0;
          transform: translateY(-20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productTypeFadeLeft {
        from {
          opacity: 0;
          transform: translateX(20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productTypeFadeRight {
        from {
          opacity: 0;
          transform: translateX(-20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productTypeZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-type--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-type--hide-tablet {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }}.product-type--hide-mobile {
          display: none !important;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-type--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }

        #{{ block_id }} .product-type__link {
          transition: none;
        }
      }
    </style>

    <div class="product-type__inner">
      {% if block.settings.show_label and block.settings.label != blank %}
        <span class="product-type__label">
          {{ block.settings.label | escape }}
        </span>
      {% endif %}

      {% if product_type != blank %}
        {% if block.settings.link_type %}
          <a class="product-type__link" href="{{ type_url }}">
            {{ product_type | escape }}
          </a>
        {% else %}
          <span class="product-type__value">
            {{ product_type | escape }}
          </span>
        {% endif %}
      {% else %}
        <span class="product-type__value">
          {{ block.settings.empty_text | escape }}
        </span>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product type",
  "settings": [
    {
      "type": "header",
      "content": "Product type"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Type:"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty type text",
      "default": "Not categorized"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide block when product type is empty",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "link_type",
      "label": "Link to product type collection",
      "default": false
    },
    {
      "type": "select",
      "id": "type_style",
      "label": "Type style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Type color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Badge background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Badge border",
      "default": "#e5e5e5"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 80
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Type",
      "settings": {
        "show_label": true,
        "label": "Type:",
        "empty_text": "Not categorized",
        "hide_when_empty": true,
        "link_type": false,
        "type_style": "standard",
        "font_size": 14,
        "letter_spacing": 0,
        "text_transform": "none",
        "text_color": "#111111",
        "label_color": "#666666",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 8,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Badge Style",
      "settings": {
        "show_label": false,
        "label": "Type:",
        "empty_text": "Not categorized",
        "hide_when_empty": true,
        "link_type": true,
        "type_style": "badge",
        "font_size": 13,
        "letter_spacing": 0,
        "text_transform": "none",
        "text_color": "#111111",
        "label_color": "#666666",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 8,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Minimal Type",
      "settings": {
        "show_label": false,
        "label": "Type:",
        "empty_text": "Not categorized",
        "hide_when_empty": true,
        "link_type": false,
        "type_style": "minimal",
        "font_size": 12,
        "letter_spacing": 1,
        "text_transform": "uppercase",
        "text_color": "#555555",
        "label_color": "#777777",
        "background_color": "#f4f4f4",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 8,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    }
  ]
}
{% endschema %}