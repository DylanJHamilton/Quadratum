{%- assign items = section.blocks | where: 'type', 'item' -%}
{% if items.size == 0 %}
  {% render 'section-empty-state', section: section %}
{% else %}
{%- liquid
  assign s = section.settings
  assign ui_id = 'q-tac-' | append: section.id
  assign style_preset = s.style_preset
  assign maxw = s.max_width
  assign pad_y = s.pad_y
  assign pad_x = s.pad_x
  assign gap = s.gap
  assign use_custom_colors = s.use_custom_colors
-%}
<section class="q-section q-tac q-tac--preset-{{ style_preset }}" id="section-{{ section.id }}"
  style="
    --q-tac-pad-y: {{ pad_y }}px;
    --q-tac-pad-x: {{ pad_x }}px;
    --q-tac-gap: {{ gap }}px;
    --q-tac-maxw: {{ maxw }}px;
    --q-tac-bp: {{ section.settings.mobile_breakpoint | default: 768 | at_least: 320 }}px;

    --q-tac-radius: {{ section.settings.radius }}px;

    --q-tac-heading-fs: {{ section.settings.heading_fs }}px;
    --q-tac-heading-fw: {{ section.settings.heading_fw }};
    --q-tac-subheading-fs: {{ section.settings.subheading_fs }}px;
    --q-tac-subheading-lh: {{ section.settings.subheading_lh_x100 | divided_by: 100.0 }};

    --q-tac-label-fs: {{ section.settings.label_fs }}px;
    --q-tac-label-fw: {{ section.settings.label_fw }};
    --q-tac-label-ls: {{ section.settings.label_ls_x1000 | divided_by: 1000.0 }}em;

    --q-tac-body-fs: {{ section.settings.body_fs }}px;
    --q-tac-body-lh: {{ section.settings.body_lh_x100 | divided_by: 100.0 }};

    --q-tac-shadow-strength: {{ section.settings.shadow_strength_x100 | divided_by: 100.0 }};

    --q-tac-tab-radius: {{ section.settings.tab_radius }}px;
    --q-tac-tab-pad-y: {{ section.settings.tab_pad_y }}px;
    --q-tac-tab-pad-x: {{ section.settings.tab_pad_x }}px;
    --q-tac-tab-gap: {{ section.settings.tab_gap }}px;
    --q-tac-tab-border-w: {{ section.settings.tab_border_w }}px;

    --q-tac-acc-radius: {{ section.settings.acc_radius }}px;
    --q-tac-acc-pad-y: {{ section.settings.acc_pad_y }}px;
    --q-tac-acc-pad-x: {{ section.settings.acc_pad_x }}px;
    --q-tac-acc-gap: {{ section.settings.acc_gap }}px;
    --q-tac-acc-border-w: {{ section.settings.acc_border_w }}px;

    {% if use_custom_colors %}
      --q-tac-bg: {{ section.settings.bg }};
      --q-tac-text: {{ section.settings.text }};
      --q-tac-muted: {{ section.settings.muted }};
      --q-tac-accent: {{ section.settings.accent }};
      --q-tac-surface: {{ section.settings.surface }};
      --q-tac-border: {{ section.settings.border }};

      --q-tac-tab-bg: {{ section.settings.tab_bg }};
      --q-tac-tab-fg: {{ section.settings.tab_text }};
      --q-tac-tab-border: {{ section.settings.tab_border }};
      --q-tac-tab-active-bg: {{ section.settings.tab_active_bg }};
      --q-tac-tab-active-fg: {{ section.settings.tab_active_text }};
      --q-tac-tab-active-border: {{ section.settings.tab_active_border }};

      --q-tac-acc-bg: {{ section.settings.acc_bg }};
      --q-tac-acc-fg: {{ section.settings.acc_text }};
      --q-tac-acc-border: {{ section.settings.acc_border }};
      --q-tac-acc-active-bg: {{ section.settings.acc_active_bg }};
      --q-tac-acc-active-fg: {{ section.settings.acc_active_text }};
      --q-tac-acc-active-border: {{ section.settings.acc_active_border }};
    {% else %}
      --q-tac-bg: var(--q-bg, var(--c-bg, #ffffff));
      --q-tac-text: var(--q-text, var(--c-text, #111111));
      --q-tac-muted: var(--q-muted, var(--c-text, #6b7280));
      --q-tac-accent: var(--q-accent, var(--c-primary, #2563eb));
      --q-tac-surface: var(--q-surface, var(--c-surface, #f6f7f8));
      --q-tac-border: var(--q-border, rgba(0,0,0,.12));

      /* sensible defaults for chrome */
      --q-tac-tab-bg: var(--q-tac-surface);
      --q-tac-tab-fg: var(--q-tac-text);
      --q-tac-tab-border: var(--q-tac-border);
      --q-tac-tab-active-bg: var(--q-tac-accent);
      --q-tac-tab-active-fg: #ffffff;
      --q-tac-tab-active-border: var(--q-tac-accent);

      --q-tac-acc-bg: var(--q-tac-surface);
      --q-tac-acc-fg: var(--q-tac-text);
      --q-tac-acc-border: var(--q-tac-border);
      --q-tac-acc-active-bg: var(--q-tac-accent);
      --q-tac-acc-active-fg: #ffffff;
      --q-tac-acc-active-border: var(--q-tac-accent);
    {% endif %}
  "
  data-q-tac-root data-layout="{{ s.layout_mode }}" data-mobile="{{ s.mobile_mode }}"
  data-breakpoint="{{ s.mobile_breakpoint }}" data-update-hash="{{ s.update_hash }}"
  data-single-open="{% if s.accordion_behavior == 'single_open_only' %}true{% else %}false{% endif %}"
  data-label-font="{{ s.label_font_mode }}" data-label-style="{{ s.label_font_style }}"
  data-label-transform="{{ s.label_transform }}" data-tab-indicator="{{ s.tab_active_indicator }}">
  <div class="q-tac__wrap">
    {% if s.show_header and s.heading != blank or s.show_header and s.subheading != blank %}
      <header class="q-tac__header">
        {% if s.heading != blank %}<h2 class="q-tac__heading">{{ s.heading | escape }}</h2>{% endif %}
        {% if s.subheading != blank %}<div class="q-tac__subheading rte">{{ s.subheading }}</div>{% endif %}
      </header>
    {% endif %}
    <div class="q-tac__ui q-tac__ui--accordion" data-align="{{ s.tab_alignment }}">
      <div class="q-tac__tabs" role="tablist" aria-label="{{ s.heading | default: 'Content details' | escape }}" hidden>
        {% for block in items %}
          <button class="q-tac__tab" type="button" role="tab" id="{{ ui_id }}-tab-{{ forloop.index }}"
            aria-controls="{{ ui_id }}-panel-{{ forloop.index }}" aria-selected="false" tabindex="-1" data-q-tac-trigger>
            {% if s.icon_position == 'left' and block.settings.icon != blank %}<span class="q-tac__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>{% endif %}
            <span class="q-tac__label">{{ block.settings.label | default: 'Details' | escape }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="q-tac__panels">
        {% assign used = '|' %}
        {% for block in items %}
          {% liquid
            assign base_anchor = block.settings.anchor_id | default: block.settings.label | handle
            if base_anchor == blank
              assign base_anchor = 'item-' | append: forloop.index
            endif
            assign final_anchor = base_anchor
            for attempt in (1..items.size)
              assign key = '|' | append: final_anchor | append: '|'
              unless used contains key
                break
              endunless
              assign suffix = forloop.index | plus: 1
              assign final_anchor = base_anchor | append: '-' | append: suffix
            endfor
            assign used = used | append: final_anchor | append: '|'
          %}
          <details class="q-tac__acc-item" id="{{ section.id }}-{{ final_anchor | escape }}" data-q-tac-item data-block-id="{{ block.id }}" {{ block.shopify_attributes }}
            {% if s.accordion_default_open == 'first_open' and forloop.first %}open{% endif %}>
            <summary class="q-tac__acc-btn" id="{{ ui_id }}-summary-{{ forloop.index }}">
              <span class="q-tac__acc-left">
                {% if s.icon_position == 'left' and block.settings.icon != blank %}<span class="q-tac__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>{% endif %}
                <span class="q-tac__label">{{ block.settings.label | default: 'Details' | escape }}</span>
              </span><span class="q-tac__chev" aria-hidden="true">▾</span>
            </summary>
            <div class="q-tac__panel q-tac__acc-panel rte" id="{{ ui_id }}-panel-{{ forloop.index }}" role="region" aria-labelledby="{{ ui_id }}-summary-{{ forloop.index }}" data-q-tac-panel>{{ block.settings.content }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
  <style>
    #section-{{ section.id }}.q-tac{
      background: var(--q-tac-bg);
      color: var(--q-tac-text);
      padding: var(--q-tac-pad-y) var(--q-tac-pad-x);
    }
    #section-{{ section.id }} .q-tac__wrap{
      max-width: var(--q-tac-maxw);
      margin: 0 auto;
      display: grid;
      gap: var(--q-tac-gap);
    }
    #section-{{ section.id }} .q-tac__header{ display:grid; gap:.5rem; }
    #section-{{ section.id }} .q-tac__heading{
      margin: 0;
      font-size: var(--q-tac-heading-fs);
      font-weight: var(--q-tac-heading-fw);
    }
    #section-{{ section.id }} .q-tac__subheading{
      color: var(--q-tac-muted);
      font-size: var(--q-tac-subheading-fs);
      line-height: var(--q-tac-subheading-lh);
    }

    /* label typography controls */
    #section-{{ section.id }}.q-tac[data-label-font="body"] .q-tac__label { font-family: var(--font-body-family, inherit); }
    #section-{{ section.id }}.q-tac[data-label-font="heading"] .q-tac__label { font-family: var(--font-heading-family, inherit); }
    #section-{{ section.id }}.q-tac[data-label-font="inherit"] .q-tac__label { font-family: inherit; }

    #section-{{ section.id }}.q-tac[data-label-style="italic"] .q-tac__label { font-style: italic; }
    #section-{{ section.id }}.q-tac[data-label-style="normal"] .q-tac__label { font-style: normal; }

    #section-{{ section.id }}.q-tac[data-label-transform="uppercase"] .q-tac__label { text-transform: uppercase; }
    #section-{{ section.id }}.q-tac[data-label-transform="lowercase"] .q-tac__label { text-transform: lowercase; }
    #section-{{ section.id }}.q-tac[data-label-transform="capitalize"] .q-tac__label { text-transform: capitalize; }
    #section-{{ section.id }}.q-tac[data-label-transform="none"] .q-tac__label { text-transform: none; }

    /* Presets */
    #section-{{ section.id }}.q-tac--preset-boxed .q-tac__ui{
      background: var(--q-tac-surface);
      border: 1px solid var(--q-tac-border);
      border-radius: var(--q-tac-radius);
      box-shadow: 0 10px 28px rgba(0,0,0, calc(var(--q-tac-shadow-strength) * 0.12));
      padding: clamp(12px, 2vw, 20px);
    }
    #section-{{ section.id }}.q-tac--preset-minimal .q-tac__ui{
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0;
    }
    #section-{{ section.id }}.q-tac--preset-faq .q-tac__ui--accordion .q-tac__acc-item{
      border-bottom: 1px solid var(--q-tac-border);
    }

    /* Tabs */
    #section-{{ section.id }} .q-tac__ui--tabs{ display:grid; gap: calc(var(--q-tac-gap) * 0.75); }
    #section-{{ section.id }} .q-tac__tabs{
      display:flex;
      flex-wrap: wrap;
      gap: var(--q-tac-tab-gap);
      align-items: center;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: .25rem;
    }
    #section-{{ section.id }} .q-tac__ui[data-align="center"] .q-tac__tabs{ justify-content:center; }
    #section-{{ section.id }} .q-tac__ui[data-align="justify"] .q-tac__tabs{ justify-content:space-between; }

    #section-{{ section.id }} .q-tac__ui--tabs.q-tac__ui--tabs_vertical{
      grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
      align-items: start;
    }
    #section-{{ section.id }} .q-tac__ui--tabs.q-tac__ui--tabs_vertical .q-tac__tabs{
      flex-direction: column;
      align-items: stretch;
      overflow: visible;
      padding-bottom: 0;
    }

    #section-{{ section.id }} .q-tac__tab{
      appearance:none;
      border: var(--q-tac-tab-border-w) solid var(--q-tac-tab-border);
      background: var(--q-tac-tab-bg);
      color: var(--q-tac-tab-fg);
      border-radius: var(--q-tac-tab-radius);
      padding: var(--q-tac-tab-pad-y) var(--q-tac-tab-pad-x);
      font-size: var(--q-tac-label-fs);
      font-weight: var(--q-tac-label-fw);
      letter-spacing: var(--q-tac-label-ls);
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      cursor:pointer;
      white-space: nowrap;
      position: relative;
      transition: transform .12s ease, opacity .12s ease, border-color .12s ease, background-color .12s ease;
    }
    #section-{{ section.id }} .q-tac__tab:hover{ transform: translateY(-1px); }

    #section-{{ section.id }} .q-tac__tab[aria-selected="true"]{
      background: var(--q-tac-tab-active-bg);
      color: var(--q-tac-tab-active-fg);
      border-color: var(--q-tac-tab-active-border);
      box-shadow: 0 10px 24px rgba(0,0,0,.10);
    }

    /* active indicator option */
    #section-{{ section.id }}.q-tac[data-tab-indicator="underline"] .q-tac__tab[aria-selected="true"]::after{
      content:"";
      position:absolute;
      left: 14px;
      right: 14px;
      bottom: 8px;
      height: 2px;
      border-radius: 99px;
      background: currentColor;
      opacity: .9;
    }
    #section-{{ section.id }}.q-tac[data-tab-indicator="none"] .q-tac__tab[aria-selected="true"]::after{ display:none; }

    #section-{{ section.id }} .q-tac__tab:focus-visible{
      outline: 2px solid var(--q-tac-accent);
      outline-offset: 2px;
    }

    #section-{{ section.id }} .q-tac__panel{
      font-size: var(--q-tac-body-fs);
      line-height: var(--q-tac-body-lh);
      min-width: 0;
    }

    /* Accordion */
    #section-{{ section.id }} .q-tac__ui--accordion{ display:grid; gap: var(--q-tac-acc-gap); }

    #section-{{ section.id }} .q-tac__acc-item{
      border-radius: var(--q-tac-acc-radius);
      overflow: hidden;
    }

    #section-{{ section.id }} .q-tac__acc-btn{
      width: 100%;
      display:flex;
      align-items:center;
      justify-content: space-between;
      gap: .75rem;
      text-align:left;
      appearance:none;
      border: var(--q-tac-acc-border-w) solid var(--q-tac-acc-border);
      background: var(--q-tac-acc-bg);
      color: var(--q-tac-acc-fg);
      padding: var(--q-tac-acc-pad-y) var(--q-tac-acc-pad-x);
      font-size: var(--q-tac-label-fs);
      font-weight: var(--q-tac-label-fw);
      letter-spacing: var(--q-tac-label-ls);
      cursor:pointer;
      transition: background-color .12s ease, border-color .12s ease, transform .12s ease;
    }
    #section-{{ section.id }} .q-tac__acc-btn:hover{ transform: translateY(-1px); }

    #section-{{ section.id }} .q-tac__acc-btn[aria-expanded="true"]{
      background: var(--q-tac-acc-active-bg);
      color: var(--q-tac-acc-active-fg);
      border-color: var(--q-tac-acc-active-border);
      box-shadow: 0 10px 24px rgba(0,0,0,.10);
    }

    #section-{{ section.id }} .q-tac__acc-left{ display:inline-flex; align-items:center; gap:.5rem; }
    #section-{{ section.id }} .q-tac__chev{
      opacity:.9;
      transform: rotate(0deg);
      transition: transform .2s ease;
    }
    #section-{{ section.id }} .q-tac__acc-btn[aria-expanded="true"] .q-tac__chev{ transform: rotate(180deg); }

    #section-{{ section.id }} .q-tac__acc-btn:focus-visible{
      outline: 2px solid var(--q-tac-accent);
      outline-offset: 3px;
    }

    #section-{{ section.id }} .q-tac__acc-panel{
      padding: 0 var(--q-tac-acc-pad-x) calc(var(--q-tac-acc-pad-y) + 6px) var(--q-tac-acc-pad-x);
      font-size: var(--q-tac-body-fs);
      line-height: var(--q-tac-body-lh);
      background: var(--q-tac-bg);
      color: var(--q-tac-text);
    }
    #section-{{ section.id }} .q-tac__acc-panel[data-animating]{ overflow:hidden; }

    @media (prefers-reduced-motion: reduce){
      #section-{{ section.id }} .q-tac__tab, #section-{{ section.id }} .q-tac__acc-btn, #section-{{ section.id }} .q-tac__chev{ transition:none !important; }
    }

    #section-{{ section.id }}, #section-{{ section.id }} * { box-sizing: border-box; }
    #section-{{ section.id }} { overflow-wrap: anywhere; }
    #section-{{ section.id }} .q-tac__ui, #section-{{ section.id }} .q-tac__tabs, #section-{{ section.id }} .q-tac__panels { min-width: 0; }
    #section-{{ section.id }} [hidden] { display: none !important; }
    #section-{{ section.id }} summary { list-style: none; }
    #section-{{ section.id }} summary::-webkit-details-marker { display: none; }
    #section-{{ section.id }} details[open] > summary { background: var(--q-tac-acc-active-bg); color: var(--q-tac-acc-active-fg); border-color: var(--q-tac-acc-active-border); }
    #section-{{ section.id }} details[open] #section-{{ section.id }} .q-tac__chev { transform: rotate(180deg); }
    #section-{{ section.id }} .q-tac__acc-btn, #section-{{ section.id }} .q-tac__tab { min-height: 44px; max-width: 100%; white-space: normal; text-align: start; }
    #section-{{ section.id }} .q-tac__acc-left { min-width: 0; }
    #section-{{ section.id }} .q-tac__panels { display: grid; gap: var(--q-tac-acc-gap); }
    #section-{{ section.id }} .q-tac__panel img, #section-{{ section.id }} .q-tac__panel iframe { max-width: 100%; }
    #section-{{ section.id }} .q-tac__panel table { display: block; max-width: 100%; overflow: auto; }
    #section-{{ section.id }} .q-tac__panel, #section-{{ section.id }} .q-tac__subheading { color: inherit; }
    #section-{{ section.id }} .q-tac__panel :is(p,a,strong,em,span,li), #section-{{ section.id }} .q-tac__subheading :is(p,a,strong,em,span,li) { color: inherit; }
    @media (max-width: {{ section.settings.mobile_breakpoint | default: 768 | at_least: 320 | minus: 1 }}px) {
      #section-{{ section.id }} .q-tac__ui--tabs.q-tac__ui--tabs_vertical { grid-template-columns: minmax(0, 1fr); }
    }
  </style>
<script src="{{ 'interactive-content-tabs.js' | asset_url }}" defer></script>
</section>
{% endif %}
{% schema %}
{
  "name": "Content - Tab/Accordion",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_header", "label": "Show header", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs & details" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Organize policies, specs, and answers into a clean interactive UI.</p>" },

    { "type": "header", "content": "Layout & behavior" },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "tabs_horizontal",
      "options": [
        { "value": "tabs_horizontal", "label": "Tabs (horizontal)" },
        { "value": "tabs_vertical", "label": "Tabs (vertical)" },
        { "value": "accordion", "label": "Accordion" }
      ]
    },
    {
      "type": "select",
      "id": "style_preset",
      "label": "Style preset",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "faq", "label": "FAQ" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "boxed", "label": "Boxed" }
      ]
    },
    {
      "type": "select",
      "id": "tab_alignment",
      "label": "Tab alignment (horizontal tabs)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "justify", "label": "Justify" }
      ]
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "select",
      "id": "accordion_default_open",
      "label": "Accordion default open",
      "default": "first_open",
      "options": [
        { "value": "first_open", "label": "First open" },
        { "value": "all_closed", "label": "All closed" }
      ]
    },
    {
      "type": "select",
      "id": "accordion_behavior",
      "label": "Accordion behavior",
      "default": "multi_open",
      "options": [
        { "value": "multi_open", "label": "Allow multiple open" },
        { "value": "single_open_only", "label": "Single open only" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_mode",
      "label": "Mobile behavior",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto (horizontal tabs → accordion on mobile)" },
        { "value": "keep_tabs", "label": "Keep tabs" },
        { "value": "force_accordion", "label": "Force accordion" }
      ]
    },
    { "type": "number", "id": "mobile_breakpoint", "label": "Mobile breakpoint (px)", "default": 768 },
    { "type": "checkbox", "id": "update_hash", "label": "Update URL hash on activate (section-id + anchor_id)", "default": true },

    { "type": "header", "content": "Layout sizing" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 720, "max": 1440, "step": 24, "default": 1152 },
    { "type": "range", "id": "pad_y", "label": "Padding Y (px)", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "pad_x", "label": "Padding X (px)", "min": 0, "max": 80, "step": 4, "default": 24 },
    { "type": "range", "id": "gap", "label": "Gap (px)", "min": 8, "max": 48, "step": 2, "default": 16 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_fs", "label": "Heading size (px)", "min": 18, "max": 56, "step": 1, "default": 32 },
    { "type": "range", "id": "heading_fw", "label": "Heading weight", "min": 300, "max": 900, "step": 100, "default": 700 },

