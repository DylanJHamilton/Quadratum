{% liquid
  assign block_id = block.id | replace: '_', '-' | downcase
  assign block_width = block.settings.width
  assign block_alignment = block.settings.alignment
  assign animation = block.settings.animation
%}

<div
  class="
    qtm-link-list
    qtm-link-list-{{ block_id }}
    qtm-link-list--width-{{ block_width }}
    qtm-link-list--align-{{ block_alignment }}
    qtm-link-list--layout-{{ block.settings.layout_style }}
    qtm-link-list--animation-{{ animation }}
    {% unless block.settings.show_desktop %} qtm-link-list--hide-desktop{% endunless %}
    {% unless block.settings.show_tablet %} qtm-link-list--hide-tablet{% endunless %}
    {% unless block.settings.show_mobile %} qtm-link-list--hide-mobile{% endunless %}
  "
  style="
    --qtm-link-list-margin-top: {{ block.settings.margin_top }}px;
    --qtm-link-list-margin-bottom: {{ block.settings.margin_bottom }}px;
    --qtm-link-list-padding: {{ block.settings.padding }}px;
    --qtm-link-list-gap: {{ block.settings.gap }}px;
    --qtm-link-list-heading-color: {{ block.settings.heading_color }};
    --qtm-link-list-text-color: {{ block.settings.text_color }};
    --qtm-link-list-background-color: {{ block.settings.background_color }};
    --qtm-link-list-item-background: {{ block.settings.item_background_color }};
    --qtm-link-list-item-hover-background: {{ block.settings.item_hover_background_color }};
    --qtm-link-list-border-color: {{ block.settings.border_color }};
    --qtm-link-list-link-color: {{ block.settings.link_color }};
    --qtm-link-list-icon-background: {{ block.settings.icon_background_color }};
    --qtm-link-list-icon-color: {{ block.settings.icon_color }};
    --qtm-link-list-arrow-color: {{ block.settings.arrow_color }};
    --qtm-link-list-border-width: {{ block.settings.border_width }}px;
    --qtm-link-list-border-radius: {{ block.settings.border_radius }}px;
    --qtm-link-list-columns: {{ block.settings.columns }};
  "
  {{ block.shopify_attributes }}
>
  <div class="qtm-link-list__inner">
    {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank %}
      <div class="qtm-link-list__header">
        {% if block.settings.eyebrow != blank %}
          <p class="qtm-link-list__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="qtm-link-list__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="qtm-link-list__text">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <nav class="qtm-link-list__nav" aria-label="{{ block.settings.nav_label | escape }}">
      <ul class="qtm-link-list__list" role="list">
        {% for i in (1..8) %}
          {% liquid
            assign enabled_key = 'link_' | append: i | append: '_enabled'
            assign icon_key = 'link_' | append: i | append: '_icon'
            assign label_key = 'link_' | append: i | append: '_label'
            assign text_key = 'link_' | append: i | append: '_text'
            assign url_key = 'link_' | append: i | append: '_url'
            assign badge_key = 'link_' | append: i | append: '_badge'
            assign new_tab_key = 'link_' | append: i | append: '_new_tab'

            assign link_enabled = block.settings[enabled_key]
            assign link_icon = block.settings[icon_key]
            assign link_label = block.settings[label_key]
            assign link_text = block.settings[text_key]
            assign link_url = block.settings[url_key]
            assign link_badge = block.settings[badge_key]
            assign link_new_tab = block.settings[new_tab_key]
          %}

          {% if link_enabled and link_label != blank %}
            <li class="qtm-link-list__item">
              {% if link_url != blank %}
                <a
                  class="qtm-link-list__link"
                  href="{{ link_url }}"
                  {% if link_new_tab %}target="_blank" rel="noopener"{% endif %}
                >
                  {% if block.settings.show_icons %}
                    <span class="qtm-link-list__icon" aria-hidden="true">
                      {% if link_icon != blank %}
                        {{ link_icon | escape }}
                      {% else %}
                        {{ i }}
                      {% endif %}
                    </span>
                  {% endif %}

                  <span class="qtm-link-list__copy">
                    <span class="qtm-link-list__label-row">
                      <span class="qtm-link-list__label">
                        {{ link_label | escape }}
                      </span>

                      {% if link_badge != blank %}
                        <span class="qtm-link-list__badge">
                          {{ link_badge | escape }}
                        </span>
                      {% endif %}
                    </span>

                    {% if link_text != blank and block.settings.show_descriptions %}
                      <span class="qtm-link-list__description">
                        {{ link_text | escape }}
                      </span>
                    {% endif %}
                  </span>

                  {% if block.settings.show_arrows %}
                    <span class="qtm-link-list__arrow" aria-hidden="true">
                      {{ block.settings.arrow_icon | escape }}
                    </span>
                  {% endif %}
                </a>
              {% else %}
                <div class="qtm-link-list__link qtm-link-list__link--disabled">
                  {% if block.settings.show_icons %}
                    <span class="qtm-link-list__icon" aria-hidden="true">
                      {% if link_icon != blank %}
                        {{ link_icon | escape }}
                      {% else %}
                        {{ i }}
                      {% endif %}
                    </span>
                  {% endif %}

                  <span class="qtm-link-list__copy">
                    <span class="qtm-link-list__label-row">
                      <span class="qtm-link-list__label">
                        {{ link_label | escape }}
                      </span>

                      {% if link_badge != blank %}
                        <span class="qtm-link-list__badge">
                          {{ link_badge | escape }}
                        </span>
                      {% endif %}
                    </span>

                    {% if link_text != blank and block.settings.show_descriptions %}
                      <span class="qtm-link-list__description">
                        {{ link_text | escape }}
                      </span>
                    {% endif %}
                  </span>
                </div>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</div>

<style>
  .qtm-link-list-{{ block_id }} {
    margin-top: var(--qtm-link-list-margin-top);
    margin-bottom: var(--qtm-link-list-margin-bottom);
    padding: var(--qtm-link-list-padding);
    color: var(--qtm-link-list-text-color);
    background: var(--qtm-link-list-background-color);
    border: var(--qtm-link-list-border-width) solid var(--qtm-link-list-border-color);
    border-radius: var(--qtm-link-list-border-radius);
  }

  .qtm-link-list-{{ block_id }} * {
    box-sizing: border-box;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--width-auto {
    width: auto;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--width-small {
    max-width: 620px;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--width-medium {
    max-width: 860px;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--width-large {
    max-width: 1120px;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--width-full {
    width: 100%;
    max-width: none;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__inner {
    display: grid;
    gap: var(--qtm-link-list-gap);
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__header {
    display: grid;
    gap: 0.7rem;
    max-width: 740px;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-center .qtm-link-list__header {
    margin-inline: auto;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-right .qtm-link-list__header {
    margin-left: auto;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__eyebrow {
    margin: 0;
    color: var(--qtm-link-list-link-color);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__heading {
    margin: 0;
    color: var(--qtm-link-list-heading-color);
    line-height: 1.05;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__text {
    color: var(--qtm-link-list-text-color);
    line-height: 1.7;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__text p {
    margin-top: 0;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__text p:last-child {
    margin-bottom: 0;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__list {
    display: grid;
    gap: calc(var(--qtm-link-list-gap) * 0.5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-cards .qtm-link-list__list {
    grid-template-columns: repeat(var(--qtm-link-list-columns), minmax(0, 1fr));
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-pills .qtm-link-list__list,
  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-buttons .qtm-link-list__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-center .qtm-link-list__list {
    justify-content: center;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-right .qtm-link-list__list {
    justify-content: flex-end;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__item {
    min-width: 0;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    width: 100%;
    min-height: {{ block.settings.item_min_height }}px;
    padding: 0.85rem 1rem;
    color: var(--qtm-link-list-link-color);
    background: var(--qtm-link-list-item-background);
    border: 1px solid color-mix(in srgb, var(--qtm-link-list-border-color), transparent 10%);
    border-radius: calc(var(--qtm-link-list-border-radius) * 0.55);
    line-height: 1.25;
    text-align: left;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__link:hover {
    background: var(--qtm-link-list-item-hover-background);
    border-color: color-mix(in srgb, var(--qtm-link-list-link-color), transparent 70%);
    opacity: 0.94;
    transform: translateY(-1px);
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__link:focus-visible {
    outline: 3px solid var(--qtm-link-list-link-color);
    outline-offset: 4px;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__link--disabled {
    cursor: default;
    opacity: 0.72;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__link--disabled:hover {
    background: var(--qtm-link-list-item-background);
    border-color: color-mix(in srgb, var(--qtm-link-list-border-color), transparent 10%);
    transform: none;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-center .qtm-link-list__link {
    text-align: center;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-right .qtm-link-list__link {
    text-align: right;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__icon {
    display: grid;
    place-items: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: var(--qtm-link-list-icon-color);
    background: var(--qtm-link-list-icon-background);
    border-radius: 999px;
    font-size: {{ block.settings.icon_font_size }}px;
    font-weight: 900;
    line-height: 1;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__label-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-center .qtm-link-list__label-row {
    justify-content: center;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--align-right .qtm-link-list__label-row {
    justify-content: flex-end;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__label {
    color: inherit;
    font-weight: 850;
    line-height: 1.2;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__description {
    color: var(--qtm-link-list-text-color);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0.22rem 0.45rem;
    color: var(--qtm-link-list-icon-color);
    background: var(--qtm-link-list-icon-background);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__arrow {
    color: var(--qtm-link-list-arrow-color);
    font-weight: 900;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .qtm-link-list-{{ block_id }} .qtm-link-list__link:hover .qtm-link-list__arrow {
    transform: translateX(2px);
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-list .qtm-link-list__link {
    border-radius: calc(var(--qtm-link-list-border-radius) * 0.45);
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-pills .qtm-link-list__link {
    display: inline-flex;
    width: auto;
    min-height: {{ block.settings.pill_height }}px;
    padding: 0.65rem 0.95rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-pills .qtm-link-list__description,
  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-pills .qtm-link-list__arrow {
    display: none;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-buttons .qtm-link-list__link {
    display: inline-flex;
    width: auto;
    min-height: {{ block.settings.button_height }}px;
    padding: 0.85rem 1.15rem;
    border-radius: calc(var(--qtm-link-list-border-radius) * 0.55);
    white-space: nowrap;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-buttons .qtm-link-list__description {
    display: none;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--layout-cards .qtm-link-list__link {
    min-height: {{ block.settings.card_min_height }}px;
    align-items: start;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--animation-fade {
    animation: qtm-link-list-fade-{{ block_id }} 520ms ease both;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--animation-fade-up {
    animation: qtm-link-list-fade-up-{{ block_id }} 620ms ease both;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--animation-fade-down {
    animation: qtm-link-list-fade-down-{{ block_id }} 620ms ease both;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--animation-fade-left {
    animation: qtm-link-list-fade-left-{{ block_id }} 620ms ease both;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--animation-fade-right {
    animation: qtm-link-list-fade-right-{{ block_id }} 620ms ease both;
  }

  .qtm-link-list-{{ block_id }}.qtm-link-list--animation-zoom {
    animation: qtm-link-list-zoom-{{ block_id }} 620ms ease both;
  }

  @keyframes qtm-link-list-fade-{{ block_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes qtm-link-list-fade-up-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-link-list-fade-down-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes qtm-link-list-fade-left-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-link-list-fade-right-{{ block_id }} {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes qtm-link-list-zoom-{{ block_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .qtm-link-list-{{ block_id }}.qtm-link-list--hide-tablet {
      display: none !important;
    }

    .qtm-link-list-{{ block_id }}.qtm-link-list--layout-cards .qtm-link-list__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .qtm-link-list-{{ block_id }}.qtm-link-list--hide-desktop {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .qtm-link-list-{{ block_id }} {
      padding: min(var(--qtm-link-list-padding), 24px);
    }

    .qtm-link-list-{{ block_id }}.qtm-link-list--hide-mobile {
      display: none !important;
    }

    .qtm-link-list-{{ block_id }}.qtm-link-list--layout-cards .qtm-link-list__list {
      grid-template-columns: 1fr;
    }

    .qtm-link-list-{{ block_id }}.qtm-link-list--layout-pills .qtm-link-list__item,
    .qtm-link-list-{{ block_id }}.qtm-link-list--layout-buttons .qtm-link-list__item {
      flex: 1 1 100%;
    }

    .qtm-link-list-{{ block_id }}.qtm-link-list--layout-pills .qtm-link-list__link,
    .qtm-link-list-{{ block_id }}.qtm-link-list--layout-buttons .qtm-link-list__link {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-link-list-{{ block_id }},
    .qtm-link-list-{{ block_id }} *,
    .qtm-link-list-{{ block_id }} *::before,
    .qtm-link-list-{{ block_id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Link list",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Quick links"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Helpful links"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Guide customers to important pages, resources, collections, or next steps.</p>"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation label",
      "default": "Helpful links"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_descriptions",
      "label": "Show descriptions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "text",
      "id": "arrow_icon",
      "label": "Arrow icon",
      "default": "→"
    },

    {
      "type": "header",
      "content": "Link 1"
    },
    {
      "type": "checkbox",
      "id": "link_1_enabled",
      "label": "Enable link 1",
      "default": true
    },
    {
      "type": "text",
      "id": "link_1_icon",
      "label": "Link 1 icon",
      "default": "1"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 label",
      "default": "Shop new arrivals"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 description",
      "default": "Explore the latest products and collections."
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_1_badge",
      "label": "Link 1 badge",
      "default": "New"
    },
    {
      "type": "checkbox",
      "id": "link_1_new_tab",
      "label": "Open link 1 in new tab",
      "default": false
    },

    {
      "type": "header",
      "content": "Link 2"
    },
    {
      "type": "checkbox",
      "id": "link_2_enabled",
      "label": "Enable link 2",
      "default": true
    },
    {
      "type": "text",
      "id": "link_2_icon",
      "label": "Link 2 icon",
      "default": "2"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 label",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 description",
      "default": "Browse customer favorites and proven picks."
