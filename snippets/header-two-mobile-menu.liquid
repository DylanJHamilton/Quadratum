{%- comment -%}
  Snippet: header-two-mobile-menu
  Reusable mobile drawer navigation for Quadratum headers.

  Accepts:
    menu               - linklist object
    section_id         - section.id (unique ids)
    search_mode        - 'inline_static' | 'popup' | 'page' | 'none'
    search_placeholder - placeholder string
    show_account       - boolean
    show_cart          - boolean

  Contracts:
    data-header-two-mobile-open  - any element opens this drawer (lives in header)
    data-header-two-mobile-close - closes the drawer
    data-cart-drawer-open / data-cart-count - global cart contracts preserved

  Usage:
    {% render 'header-two-mobile-menu', menu: main_menu, section_id: section.id, search_mode: header_search_mode, search_placeholder: header_search_placeholder, show_account: section.settings.show_account, show_cart: true %}
{%- endcomment -%}

<div class="qtm-hm-drawer-overlay" data-qh2-drawer-overlay data-header-two-mobile-close hidden></div>

<aside
  id="QH2MobileDrawer-{{ section_id }}"
  class="qtm-hm-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  data-qh2-drawer
  hidden
>
  <div class="qtm-hm-drawer__head">
    {% render 'header-two-logo' %}
    <button
      type="button"
      class="qtm-hm-icon-btn qtm-hm-drawer__close"
      data-header-two-mobile-close
      aria-label="Close menu"
    >
      <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  {%- if search_mode == 'inline_static' or search_mode == 'page' -%}
    {%- assign mobile_search_input_id = 'QH2MobileSearchInput-' | append: section_id -%}
    <div class="qtm-hm-drawer__search">
      {% render 'search-form-static',
        form_context: 'header-two-mobile',
        input_id: mobile_search_input_id,
        placeholder: search_placeholder,
        show_button: true
      %}
    </div>
  {%- elsif search_mode == 'popup' and settings.enable_search_popup -%}
    <div class="qtm-hm-drawer__search">
      <button
        type="button"
        class="qtm-hm-drawer__search-trigger"
        data-search-popup-open
        aria-label="Open search"
        aria-haspopup="dialog"
      >
        <svg class="qtm-hm-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
          <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>{{ search_placeholder | default: 'Search' }}</span>
      </button>
    </div>
  {%- endif -%}

  <nav class="qtm-hm-drawer__nav" aria-label="Mobile navigation">
    {%- if menu != blank -%}
      <ul class="qtm-hm-drawer__list" role="list">
        {%- for link in menu.links -%}
          {%- assign sub_id = 'QH2MobileSub-' | append: section_id | append: '-' | append: forloop.index -%}
          <li class="qtm-hm-drawer__item">
            {%- if link.links.size > 0 -%}
              <div class="qtm-hm-drawer__row">
                <a
                  class="qtm-hm-drawer__link{% if link.active %} qtm-hm-drawer__link--active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.active %}aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>
                <button
                  type="button"
                  class="qtm-hm-drawer__toggle"
                  aria-expanded="false"
                  aria-controls="{{ sub_id }}"
                  aria-label="Expand {{ link.title | escape }}"
                  data-qh2-sub-toggle
                >
                  <svg class="qtm-hm-caret-icon" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                    <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>

              <ul id="{{ sub_id }}" class="qtm-hm-drawer__sublist" role="list" hidden>
                {%- for child in link.links -%}
                  {%- assign sub_sub_id = sub_id | append: '-' | append: forloop.index -%}
                  <li class="qtm-hm-drawer__subitem">
                    {%- if child.links.size > 0 -%}
                      <div class="qtm-hm-drawer__row">
                        <a
                          class="qtm-hm-drawer__sublink{% if child.active %} qtm-hm-drawer__sublink--active{% endif %}"
                          href="{{ child.url }}"
                          {% if child.active %}aria-current="page"{% endif %}
                        >
                          {{ child.title | escape }}
                        </a>
                        <button
                          type="button"
                          class="qtm-hm-drawer__toggle qtm-hm-drawer__toggle--sub"
                          aria-expanded="false"
                          aria-controls="{{ sub_sub_id }}"
                          aria-label="Expand {{ child.title | escape }}"
                          data-qh2-sub-toggle
                        >
                          <svg class="qtm-hm-caret-icon" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                            <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </div>
                      <ul id="{{ sub_sub_id }}" class="qtm-hm-drawer__sublist qtm-hm-drawer__sublist--nested" role="list" hidden>
                        {%- for grandchild in child.links -%}
                          <li>
                            <a
                              class="qtm-hm-drawer__sublink qtm-hm-drawer__sublink--nested{% if grandchild.active %} qtm-hm-drawer__sublink--active{% endif %}"
                              href="{{ grandchild.url }}"
                              {% if grandchild.active %}aria-current="page"{% endif %}
                            >
                              {{ grandchild.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <a
                        class="qtm-hm-drawer__sublink{% if child.active %} qtm-hm-drawer__sublink--active{% endif %}"
                        href="{{ child.url }}"
                        {% if child.active %}aria-current="page"{% endif %}
                      >
                        {{ child.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a
                class="qtm-hm-drawer__link{% if link.active %} qtm-hm-drawer__link--active{% endif %}"
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </nav>

  <div class="qtm-hm-drawer__utilities">
    {%- if show_account -%}
      {%- if customer -%}
        <a class="qtm-hm-drawer__utility" href="{{ routes.account_url }}">Account</a>
        <a class="qtm-hm-drawer__utility" href="{{ routes.account_logout_url }}">Logout</a>
      {%- else -%}
        <a class="qtm-hm-drawer__utility" href="{{ routes.account_login_url }}">Sign In</a>
        <a class="qtm-hm-drawer__utility" href="{{ routes.account_register_url }}">Create Account</a>
      {%- endif -%}
    {%- endif -%}

    {%- if show_cart -%}
      <button type="button" class="qtm-hm-drawer__utility qtm-hm-drawer__utility--cart" data-cart-drawer-open>
        Cart
        <span class="qtm-hm-cart__count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    {%- endif -%}
  </div>
</aside>