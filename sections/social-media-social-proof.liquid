{% comment %}Manual merchant-supplied metrics; no provider verification or live counts.{% endcomment %}

{%- assign s = section.settings -%}



{% assign social_count = 0 %}{% capture social_content %}
<section
  id="social-media-social-proof-{{ section.id }}"
  class="
    q-social-proof-strip
    q-social-proof-strip--align-{{ s.align }}
    q-social-proof-strip--layout-{{ s.layout_variant }}
    q-social-proof-strip--style-{{ s.style }}
    q-social-proof-strip--justify-{{ s.justify | replace: ' ', '-' }}
    q-social-proof-strip--bg-{{ s.bg_scheme }}
  "
  style="
    --q-proof-gap: {{ s.gap }}px;
    --q-proof-icon-size: {{ s.icon_size }}px;
  "
>
  <div class="q-social-proof-strip__outer">
    <div class="q-social-proof-strip__inner">
      {%- if s.show_kicker or s.heading != blank or s.show_body -%}
        <div class="q-social-proof-strip__header">
          {%- if s.show_kicker and s.kicker != blank -%}
            <p class="q-social-proof-strip__kicker">
              {{ s.kicker | escape }}
            </p>
          {%- endif -%}

          {%- if s.heading != blank -%}
            <h2 class="q-social-proof-strip__heading">
              {{ s.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if s.show_body and s.body != blank -%}
            <p class="q-social-proof-strip__body">
              {{ s.body | escape | newline_to_br }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="q-social-proof-strip__items-wrap">
          <ul
            class="q-social-proof-strip__list"
            role="list"
            aria-label="{{ s.aria_label | escape }}"
            tabindex="0"
          >
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}

              {%- comment %}
                Simple icon glyphs mapped from icon setting.
                (No external snippets to avoid runtime errors.)
              {%- endcomment -%}
              {%- assign icon_glyph = '●' -%}
              {%- case b.icon -%}
                {%- when 'star' -%}
                  {%- assign icon_glyph = '★' -%}
                {%- when 'heart' -%}
                  {%- assign icon_glyph = '♥' -%}
                {%- when 'users' -%}
                  {%- assign icon_glyph = '👥' -%}
                {%- when 'shopping-bag' -%}
                  {%- assign icon_glyph = '🛍' -%}
                {%- when 'trophy' -%}
                  {%- assign icon_glyph = '🏆' -%}
                {%- when 'shield-check' -%}
                  {%- assign icon_glyph = '✔' -%}
              {%- endcase -%}



              {% if b.value != blank or b.label != blank %}{% assign social_count = social_count | plus: 1 %}<li
                class="
                  q-social-proof-strip__item
                  {% if b.emphasis %}q-social-proof-strip__item--emphasis{% endif %}
                "
                role="listitem"
                {{ block.shopify_attributes }}
              >
                {%- if s.show_icons -%}
                  <span class="q-social-proof-strip__icon" aria-hidden="true">
                    {{ icon_glyph }}
                  </span>
                {%- endif -%}

                <div class="q-social-proof-strip__content"{% if b.sr_label != blank %} aria-hidden="true"{% endif %}>
                  <span class="q-social-proof-strip__value">
                    {{ b.value | escape }}
                  </span>

                  {%- if b.label != blank -%}
                    <span class="q-social-proof-strip__label">
                      {{ b.label | escape }}
                    </span>
                  {%- endif -%}
                </div>
                {% if b.sr_label != blank %}<span class="q-sr-only">{{ b.sr_label | escape }}</span>{% endif %}
              </li>{% elsif request.design_mode %}<li {{ block.shopify_attributes }}>Enter a verified metric value and label.</li>{% endif %}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% endcapture %}
{% if social_count > 0 or request.design_mode %}{{ social_content }}{% endif %}
<style>

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip {
    padding-block: var(--q-section-pad-y, 40px);
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__outer {
    max-width: var(--container-md, 960px);
    margin-inline: auto;
    padding-inline: var(--q-container-pad-x, 1.25rem);
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 1.25rem);
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__header {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--align-left .q-social-proof-strip__header,
  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--align-left .q-social-proof-strip__items-wrap {
    text-align: left;
    align-items: flex-start;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--align-right .q-social-proof-strip__header,
  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--align-right .q-social-proof-strip__items-wrap {
    text-align: right;
    align-items: flex-end;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:inherit;
    margin: 0 0 0.2rem 0;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__heading {
    margin: 0 0 0.3rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color:inherit;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__body {
    margin: 0;
    color:inherit;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__items-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--q-proof-gap, 16px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--justify-start .q-social-proof-strip__list {
    justify-content: flex-start;
  }
  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--justify-center .q-social-proof-strip__list {
    justify-content: center;
  }
  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--justify-space-between .q-social-proof-strip__list {
    justify-content: space-between;
  }
  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--justify-space-around .q-social-proof-strip__list {
    justify-content: space-around;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--layout-stacked .q-social-proof-strip__list {
    flex-direction: column;
    align-items: stretch;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border-width: 1px;
    border-style: solid;
    border-color: transparent;
    background-color: transparent;
    color: inherit;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--style-pill .q-social-proof-strip__item {
    background-color: var(--c-surface, #f3f4f6);
    border-color: transparent;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--style-outline .q-social-proof-strip__item {
    background-color: transparent;
    border-color: rgba(15, 23, 42, 0.14);
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--style-bare .q-social-proof-strip__item {
    padding-inline: 0;
    padding-block: 0.25rem;
    border-color: transparent;
    border-width: 0;
    border-radius: 0;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__icon {
    width: var(--q-proof-icon-size, 18px);
    height: var(--q-proof-icon-size, 18px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background-color: transparent;
    color: inherit;
    font-size: calc(var(--q-proof-icon-size, 18px) * 0.7);
    flex-shrink: 0;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--style-pill .q-social-proof-strip__icon {
    background-color: rgba(15, 23, 42, 0.06);
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__value {
    font-weight: 600;
    white-space:normal;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__label {
    opacity: 0.88;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__item--emphasis .q-social-proof-strip__value {
    font-weight: 700;
  }

  #social-media-social-proof-{{ section.id }} .q-social-proof-strip__item--emphasis {
    box-shadow: 0 8px 26px rgba(15, 23, 42, 0.12);
  }

  /* Background schemes */
  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--bg-default {
    background-color: var(--c-bg, #ffffff);
    color:inherit;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--bg-subtle {
    background-color: var(--c-surface, #f6f7f8);
    color:inherit;
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--bg-emphasis {
    background-color: var(--c-primary, #2563eb);
    color: var(--c-oncolor, #ffffff);
  }

  #social-media-social-proof-{{ section.id }}.q-social-proof-strip--bg-emphasis .q-social-proof-strip__body {
    color: var(--c-oncolor, #ffffff);
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    #social-media-social-proof-{{ section.id }} .q-social-proof-strip__outer {
      padding-inline: 1rem;
    }
  }

  #social-media-social-proof-{{ section.id }} .q-sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

#social-media-social-proof-{{ section.id }}{color:var(--c-text,#111111);font-family:var(--font-body);overflow-wrap:anywhere;min-width:0;max-width:100%}
#social-media-social-proof-{{ section.id }} *,#social-media-social-proof-{{ section.id }} *::before,#social-media-social-proof-{{ section.id }} *::after{box-sizing:border-box;min-width:0}
#social-media-social-proof-{{ section.id }} :is(h2,h3){font-family:var(--font-head)}
#social-media-social-proof-{{ section.id }} :is(a,button,[tabindex]):focus-visible{outline:2px solid currentColor;outline-offset:3px}
#social-media-social-proof-{{ section.id }} :is(a,button){max-width:100%;overflow-wrap:anywhere}
#social-media-social-proof-{{ section.id }} [hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){#social-media-social-proof-{{ section.id }} *,#social-media-social-proof-{{ section.id }} *::before,#social-media-social-proof-{{ section.id }} *::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}

#social-media-social-proof-{{ section.id }} .q-social-proof-strip__list{width:100%;max-width:100%;overflow-x:auto;padding:4px}
#social-media-social-proof-{{ section.id }} .q-social-proof-strip__item{max-width:100%;flex:0 0 auto}
#social-media-social-proof-{{ section.id }}.q-social-proof-strip--style-pill .q-social-proof-strip__item{color:var(--c-text,#111)}
#social-media-social-proof-{{ section.id }}.q-social-proof-strip--bg-emphasis{color:var(--c-oncolor,#fff)}
#social-media-social-proof-{{ section.id }}.q-social-proof-strip--align-left .q-social-proof-strip__header{margin-inline:0}
#social-media-social-proof-{{ section.id }}.q-social-proof-strip--align-right .q-social-proof-strip__header{margin-inline-start:auto;margin-inline-end:0}
@media(max-width:640px){#social-media-social-proof-{{ section.id }}.q-social-proof-strip .q-social-proof-strip__list{flex-wrap:{% if s.wrap_on_mobile %}wrap{% else %}nowrap{% endif %};justify-content:{% if s.wrap_on_mobile %}{{ s.justify }}{% else %}flex-start{% endif %}}}

</style>

{% schema %}
{
  "name": "Social Media - Proof",
  "tag": "section",
  "class": "q-host-social-media-social-proof",
  "settings": [
    {
      "type": "paragraph",
