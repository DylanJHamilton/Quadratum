    },
    {
      "name": "Custom Liquid",
      "settings": {
        "code_mode": "liquid",
        "custom_code": "<div>{{ product.title }}</div>",
        "fallback_message": "Add custom Liquid content here.",
        "contain_overflow": true,
        "show_warning": true,
        "warning_text": "Custom Liquid should be tested across templates before publishing.",
