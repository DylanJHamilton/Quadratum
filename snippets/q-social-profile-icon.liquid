{%- comment -%}Profile icon wrapper. The adjacent link text supplies the accessible name. Existing social glyph dependency is reused; Bluesky uses a decorative initial.{%- endcomment -%}
{%- assign n = network | downcase -%}
<span class="q-social-profile__icon" aria-hidden="true">
  {%- if n == 'bluesky' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><text x="12" y="17" text-anchor="middle" font-size="18" font-family="sans-serif" fill="currentColor">B</text></svg>
  {%- else -%}
    {%- render 'icon-social', name: n -%}
  {%- endif -%}
</span>
