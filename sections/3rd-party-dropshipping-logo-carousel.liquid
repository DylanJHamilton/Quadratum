{% comment %}
  Partner logos: native static grid/scroll list, optionally enhanced with disposable
  strip advance or a marquee. System reduced motion and editor mode stay static.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign logo_count = 0
  for block in section.blocks
    if block.type == 'logo'
      if block.settings.logo != blank or block.settings.brand_name != blank or request.design_mode
        assign logo_count = logo_count | plus: 1
      endif
    endif
  endfor
  assign has_header = false
  if s.kicker != blank or s.heading != blank or s.body != blank
    assign has_header = true
  endif
  assign visible = false
  if s.enable_section
    if has_header or logo_count > 0
      assign visible = true
    endif
  endif
  assign autoplay_enabled = false
  if s.autoplay and s.layout_mode != 'grid' and logo_count > 1
    assign autoplay_enabled = true
  endif
  assign passes = 1
  if autoplay_enabled and s.layout_mode == 'marquee'
    assign passes = 2
  endif
  assign inner_max = 'var(--container-lg,1152px)'
  case s.max_width
    when 'sm'
      assign inner_max = 'var(--container-sm,720px)'
    when 'md'
      assign inner_max = 'var(--container-md,960px)'
  endcase
  assign img_class = 'q-logos__image q-logos__image--' | append: s.logo_style
-%}
{%- if visible -%}
<script src="{{ '3rd-party-partner-logos.js' | asset_url }}" defer></script>
<section id="brand-logo-carousel-{{ section.id }}" class="q-section q-brand-logo-carousel q-section--bg-{{ s.background_style }}{% if s.respect_reduced_motion %} q-logos-respect-effects{% endif %}" aria-label="{{ s.aria_label | default: s.heading | default: 'Partner logos' | escape }}" data-q-partner-logos data-mode="{{ s.layout_mode }}" data-autoplay="{{ autoplay_enabled }}" data-speed="{{ s.autoplay_speed_ms }}" data-editor="{{ request.design_mode }}" style="--q-logos-gap:{{ s.gutter }}px;--q-logos-max-h:{{ s.logo_max_height }}px;--q-logos-speed:{{ s.autoplay_speed_ms }}ms;--q-logos-max-width:{{ inner_max }};">
  <div class="q-section__inner">
    {%- if has_header -%}<header class="q-section__header q-section__header--{{ s.content_align }}">
      {%- if s.kicker != blank -%}<p class="q-section__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="q-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<div class="q-section__body"><p>{{ s.body | escape | newline_to_br }}</p></div>{%- endif -%}
    </header>{%- endif -%}
    {%- if logo_count > 0 -%}
      <button type="button" class="q-logos__motion" data-q-logos-toggle aria-pressed="false" aria-controls="q-logos-viewport-{{ section.id }}" hidden>Stop logo motion</button>
      <div id="q-logos-viewport-{{ section.id }}" class="q-logos q-logos--mode-{{ s.layout_mode }} q-logos--align-{{ s.logos_align }}" data-q-logos-viewport{% if s.layout_mode != 'grid' %} tabindex="0" role="region" aria-label="Browse partner logos"{% endif %}>
        <div class="q-logos__track" role="list">
          {%- for pass in (1..passes) -%}
            {%- assign is_clone = false -%}{%- if pass == 2 -%}{%- assign is_clone = true -%}{%- endif -%}
            <div class="q-logos__group{% if is_clone %} q-logos__group--clone{% endif %}"{% if is_clone %} aria-hidden="true" inert{% else %} role="presentation" data-q-logos-original{% endif %}>
              {%- for block in section.blocks -%}
                {%- if block.type != 'logo' -%}{%- continue -%}{%- endif -%}
                {%- assign b = block.settings -%}
                {%- if b.logo == blank and b.brand_name == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
                {%- assign brand_label = b.brand_name | default: b.logo.alt | default: 'Brand logo' -%}
                {%- assign link_label = b.aria_label | default: brand_label -%}
                <div class="q-logos__item"{% unless is_clone %} role="listitem" {{ block.shopify_attributes }}{% endunless %}>
                  {%- if b.link_url != blank and is_clone == false -%}
                    <a href="{{ b.link_url | escape }}" class="q-logos__link" aria-label="{{ link_label | escape }}"{% if b.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                  {%- else -%}<span class="q-logos__tile">{%- endif -%}
                    {%- if b.logo != blank -%}
                      {{ b.logo | image_url: width: 480 | image_tag: class: img_class, alt: brand_label, loading: 'lazy', widths: '160,240,320,480', sizes: '200px' }}
                    {%- elsif b.brand_name != blank -%}<span class="q-logos__fallback">{{ b.brand_name | escape }}</span>
                    {%- else -%}<span class="q-logos__fallback">Add a logo or brand name</span>{%- endif -%}
                  {%- if b.link_url != blank and is_clone == false -%}</a>{%- else -%}</span>{%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  <style>
    #brand-logo-carousel-{{ section.id }}{font-family:var(--font-body,inherit);overflow-wrap:anywhere;padding-block:48px}
    #brand-logo-carousel-{{ section.id }} .q-section__inner{box-sizing:border-box;max-width:var(--q-logos-max-width);margin-inline:auto;padding-inline:clamp(16px,3vw,32px);min-width:0}
    #brand-logo-carousel-{{ section.id }} .q-section__header--center{text-align:center}
    #brand-logo-carousel-{{ section.id }} .q-section__header--left{text-align:start}
    #brand-logo-carousel-{{ section.id }} .q-section__heading{font-family:var(--font-head,inherit);font-size:var(--fs-h2,2rem);color:inherit}
    #brand-logo-carousel-{{ section.id }} :is(.q-section__kicker,.q-section__body){color:var(--q-section-muted,var(--c-muted,#666))}
    #brand-logo-carousel-{{ section.id }} .q-logos{box-sizing:border-box;position:relative;width:100%;min-width:0;margin-top:.75rem;padding:12px;border-radius:16px;background:color-mix(in srgb,currentColor 6%,transparent);border:1px solid color-mix(in srgb,currentColor 12%,transparent);overflow-x:auto;scroll-snap-type:x proximity}
    #brand-logo-carousel-{{ section.id }} .q-logos__track{display:flex;width:max-content;min-width:100%;align-items:center}
    #brand-logo-carousel-{{ section.id }} .q-logos__group{box-sizing:border-box;display:flex;align-items:center;gap:var(--q-logos-gap);min-width:var(--q-logos-viewport,100%);flex:0 0 auto;padding-inline-end:var(--q-logos-gap)}
    #brand-logo-carousel-{{ section.id }} .q-logos__group--clone{display:none}
    #brand-logo-carousel-{{ section.id }} .q-logos--align-center .q-logos__group{justify-content:safe center}
    #brand-logo-carousel-{{ section.id }} .q-logos--align-left .q-logos__group{justify-content:flex-start}
    #brand-logo-carousel-{{ section.id }} .q-logos__item{box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:0 0 min(200px,70vw);width:min(200px,70vw);min-width:0;scroll-snap-align:start}
    #brand-logo-carousel-{{ section.id }} :is(.q-logos__link,.q-logos__tile){box-sizing:border-box;display:flex;align-items:center;justify-content:center;max-width:100%;width:100%;padding:.65rem .85rem;border-radius:14px;text-decoration:none;color:inherit;background:color-mix(in srgb,currentColor 4%,transparent);border:1px solid color-mix(in srgb,currentColor 10%,transparent);min-height:calc(var(--q-logos-max-h) + 24px)}
    #brand-logo-carousel-{{ section.id }} .q-logos__image{display:block;max-width:100%;max-height:var(--q-logos-max-h);width:auto;height:auto;object-fit:contain}
    #brand-logo-carousel-{{ section.id }} .q-logos__fallback{font-size:.95em;line-height:1.3;text-align:center;overflow-wrap:anywhere}
    #brand-logo-carousel-{{ section.id }} .q-logos__image--mono{filter:grayscale(1);opacity:.78;transition:filter .16s ease,opacity .16s ease}
    #brand-logo-carousel-{{ section.id }} .q-logos__link:is(:hover,:focus-visible) .q-logos__image--mono{filter:none;opacity:1}
    #brand-logo-carousel-{{ section.id }} .q-logos__motion{font:inherit;min-height:44px;padding:.5rem .85rem;border:1px solid currentColor;border-radius:999px;background:transparent;color:inherit;cursor:pointer}
    #brand-logo-carousel-{{ section.id }} .q-logos__motion[hidden]{display:none}
    #brand-logo-carousel-{{ section.id }} :focus-visible{outline:2px solid currentColor;outline-offset:-3px}
    #brand-logo-carousel-{{ section.id }} .q-logos--mode-grid{overflow:visible}
    #brand-logo-carousel-{{ section.id }} .q-logos--mode-grid .q-logos__track{display:block;width:100%}
    #brand-logo-carousel-{{ section.id }} .q-logos--mode-grid .q-logos__group{display:grid;width:100%;padding:0;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr))}
    #brand-logo-carousel-{{ section.id }} .q-logos--mode-grid .q-logos__item{width:100%}
    #brand-logo-carousel-{{ section.id }}[data-playing="true"][data-mode="marquee"] .q-logos{overflow:hidden;scroll-snap-type:none}
    #brand-logo-carousel-{{ section.id }}[data-playing="true"][data-mode="marquee"] .q-logos__group--clone{display:flex}
    #brand-logo-carousel-{{ section.id }}[data-playing="true"][data-mode="marquee"] .q-logos__track{animation:q-partner-logos-{{ section.id }} var(--q-logos-speed) linear infinite}
    #brand-logo-carousel-{{ section.id }}:dir(rtl){--q-logos-direction:1}
    @keyframes q-partner-logos-{{ section.id }}{from{transform:translateX(0)}to{transform:translateX(calc(var(--q-logos-direction,-1) * var(--q-logos-distance,0px)))}}
    @media(prefers-reduced-motion:reduce){
      #brand-logo-carousel-{{ section.id }} .q-logos__track{animation:none!important;transform:none!important}
      #brand-logo-carousel-{{ section.id }} .q-logos__group--clone{display:none!important}
      #brand-logo-carousel-{{ section.id }} .q-logos{overflow-x:auto!important}
      #brand-logo-carousel-{{ section.id }}.q-logos-respect-effects .q-logos__image{transition:none}
    }
  </style>
</section>
{%- elsif request.design_mode -%}<p role="status">Partner logos: enable the section and add a heading, logo or brand name.</p>{%- endif -%}

{% schema %}
{
  "name": "3rd Party - Partner Logos",
  "tag": "div",
  "class": "q-brand-logo-carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Brand directory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured brands"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Explore the brands and suppliers featured by our store."
    },
    {
      "type": "header",
      "content": "Layout & styling"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "strip",
      "options": [
        {
          "value": "strip",
          "label": "Carousel strip"
        },
        {
          "value": "marquee",
          "label": "Continuous marquee"
        },
        {
          "value": "grid",
          "label": "Static grid"
        }
      ]
    },
    {
      "type": "select",
      "id": "logos_align",
      "label": "Logo alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Max logo height (px)",
      "min": 24,
      "max": 96,
      "step": 4,
      "default": 48
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo style",
      "default": "color",
      "options": [
        {
          "value": "color",
          "label": "Full color"
        },
        {
          "value": "mono",
          "label": "Monochrome / subdued"
        }
      ]
    },
    {
      "type": "range",
      "id": "gutter",
      "label": "Gap between logos (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay (strip/marquee)",
      "default": true,
      "info": "Requires at least two logos and JavaScript. Hover, keyboard focus, the stop button, hidden/offscreen pages, reduced motion and the Theme Editor use a static browsable list."
    },
    {
      "type": "range",
      "id": "autoplay_speed_ms",
      "label": "Strip interval / marquee cycle (ms)",
      "min": 1000,
      "max": 9500,
      "step": 500,
      "default": 4000
    },
    {
      "type": "checkbox",
      "id": "respect_reduced_motion",
      "label": "Reduce decorative hover transitions",
      "default": true,
      "info": "Autoplay always respects the visitor’s reduced-motion preference. This also removes decorative hover transitions."
    },
    {
      "type": "header",
      "content": "Background & accessibility"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "surface",
      "options": [
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "contrast",
          "label": "Contrast"
        },
        {
          "value": "brand",
          "label": "Brand color"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "lg",
      "options": [
        {
          "value": "sm",
          "label": "Narrow"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria label",
      "default": "Supplier and brand logos"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name",
          "default": "Brand name"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Logo link (optional)"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessibility label (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3rd Party - Partner Logos",
      "category": "3rd Party Integrations",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
