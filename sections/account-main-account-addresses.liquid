{% comment %}
  Quadratum Account System
  File 7 of 10 — Customer Addresses Only

  Handles:
  - Saved address display
  - Add address form
  - Edit address forms
  - Delete confirmation
  - Set default address
  - Account navigation
  - Empty state

  Does NOT handle:
  - Login
  - Register
  - Dashboard
  - Orders
  - Order tracking
{% endcomment %}

{{ 'account-main-account-addresses.css' | asset_url | stylesheet_tag }}
<script src="{{ 'account-main-account-addresses.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tracking_url = section.settings.tracking_url
  if tracking_url == blank
    assign tracking_url = '/pages/order-tracking'
  endif
-%}

<section
  id="QtmAccountMainAddresses-{{ section.id }}"
  class="
    qtmAccountAddresses
    qtmAccountAddresses--{{ section.settings.layout_style }}
  "
  style="
    --qtm-account-heading-size: {{ section.settings.heading_font_size }}px;
    --qtm-account-body-size: {{ section.settings.body_font_size }}px;
    --qtm-account-meta-size: {{ section.settings.meta_font_size }}px;
    --qtm-account-radius: {{ section.settings.card_radius }}px;
    --qtm-account-gap: {{ section.settings.card_gap }}px;
    --qtm-account-card-bg: {{ section.settings.card_background }};
    --qtm-account-card-border: {{ section.settings.card_border }};
    --qtm-account-card-padding: {{ section.settings.card_padding }}px;
    --qtm-account-badge-radius: {{ section.settings.badge_radius }}px;
    --qtm-account-button-radius: {{ section.settings.card_radius }}px;
    --qtm-account-form-field-radius: {{ section.settings.form_field_radius }}px;
    --qtm-account-form-field-padding: {{ section.settings.form_field_padding }}px;
  "
  data-qtm-account-addresses
  data-delete-confirm-message="{{ section.settings.delete_confirm_message | escape }}"
>
  <div class="qtmAccountAddresses__shell">
    {% if customer %}
      <header class="qtmAccountAddresses__header">
        <div>
          <h1 class="qtmAccountAddresses__heading">
            {{ section.settings.heading | default: 'Addresses' }}
          </h1>

          {% if section.settings.subheading != blank %}
            <p class="qtmAccountAddresses__subheading">
              {{ section.settings.subheading }}
            </p>
          {% endif %}
        </div>

        <button
          type="button"
          class="qtmAccountAddresses__button qtmAccountAddresses__button--{{ section.settings.button_style }}"
          aria-expanded="false"
          aria-controls="QtmAccountAddressesNewForm-{{ section.id }}"
          data-qtm-addresses-add-toggle
        >
          Add new address
        </button>
      </header>

      <div class="qtmAccountAddresses__layout">
        {% if section.settings.show_account_nav %}
          <aside class="qtmAccountAddresses__sidebar">
            <nav class="qtmAccountAddresses__accountNav" aria-label="Account navigation">
              <a href="{{ routes.account_url }}" class="qtmAccountAddresses__accountNavLink">
                {{ section.settings.dashboard_label }}
              </a>

              <a href="{{ routes.account_url }}" class="qtmAccountAddresses__accountNavLink">
                {{ section.settings.orders_label }}
              </a>

              <a href="{{ routes.account_addresses_url }}" class="qtmAccountAddresses__accountNavLink is-active" aria-current="page">
                {{ section.settings.addresses_label }}
              </a>

              <a href="{{ tracking_url }}" class="qtmAccountAddresses__accountNavLink">
                {{ section.settings.tracking_label }}
              </a>

              <a href="{{ routes.account_logout_url }}" class="qtmAccountAddresses__accountNavLink">
                {{ section.settings.logout_label }}
              </a>
            </nav>
          </aside>
        {% endif %}

        <main class="qtmAccountAddresses__main" aria-label="Saved addresses">
          <section
            id="QtmAccountAddressesNewForm-{{ section.id }}"
            class="qtmAccountAddresses__formPanel"
            aria-labelledby="QtmAccountAddressesNewHeading-{{ section.id }}"
            data-qtm-addresses-add-panel
            hidden
          >
            <div class="qtmAccountAddresses__formHeader">
              <h2 id="QtmAccountAddressesNewHeading-{{ section.id }}" class="qtmAccountAddresses__panelTitle">
                Add new address
              </h2>

              <button
                type="button"
                class="qtmAccountAddresses__textButton"
                data-qtm-addresses-add-close
              >
                Close
              </button>
            </div>

            {% form 'customer_address', customer.new_address, class: 'qtmAccountAddresses__form' %}
              <div class="qtmAccountAddresses__formGrid">
                <div class="qtmAccountAddresses__field">
                  <label for="AddressFirstNameNew-{{ section.id }}">First name</label>
                  <input id="AddressFirstNameNew-{{ section.id }}" type="text" name="address[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
                </div>

                <div class="qtmAccountAddresses__field">
                  <label for="AddressLastNameNew-{{ section.id }}">Last name</label>
                  <input id="AddressLastNameNew-{{ section.id }}" type="text" name="address[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
                </div>

                <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                  <label for="AddressCompanyNew-{{ section.id }}">Company</label>
                  <input id="AddressCompanyNew-{{ section.id }}" type="text" name="address[company]" autocomplete="organization" value="{{ form.company }}">
                </div>

                <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                  <label for="AddressAddress1New-{{ section.id }}">Address 1</label>
                  <input id="AddressAddress1New-{{ section.id }}" type="text" name="address[address1]" autocomplete="address-line1" value="{{ form.address1 }}">
                </div>

                <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                  <label for="AddressAddress2New-{{ section.id }}">Address 2</label>
                  <input id="AddressAddress2New-{{ section.id }}" type="text" name="address[address2]" autocomplete="address-line2" value="{{ form.address2 }}">
                </div>

                <div class="qtmAccountAddresses__field">
                  <label for="AddressCityNew-{{ section.id }}">City</label>
                  <input id="AddressCityNew-{{ section.id }}" type="text" name="address[city]" autocomplete="address-level2" value="{{ form.city }}">
                </div>

                <div class="qtmAccountAddresses__field">
                  <label for="AddressCountryNew-{{ section.id }}">Country/region</label>
                  <select
                    id="AddressCountryNew-{{ section.id }}"
                    name="address[country]"
                    data-default="{{ form.country }}"
                    data-qtm-address-country
                  >
                    {{ all_country_option_tags }}
                  </select>
                </div>

                <div class="qtmAccountAddresses__field" id="AddressProvinceContainerNew-{{ section.id }}" data-qtm-address-province-container>
                  <label for="AddressProvinceNew-{{ section.id }}">Province/state</label>
                  <select
                    id="AddressProvinceNew-{{ section.id }}"
                    name="address[province]"
                    data-default="{{ form.province }}"
                    data-qtm-address-province
                  ></select>
                </div>

                <div class="qtmAccountAddresses__field">
                  <label for="AddressZipNew-{{ section.id }}">Postal/ZIP code</label>
                  <input id="AddressZipNew-{{ section.id }}" type="text" name="address[zip]" autocomplete="postal-code" value="{{ form.zip }}">
                </div>

                <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                  <label for="AddressPhoneNew-{{ section.id }}">Phone</label>
                  <input id="AddressPhoneNew-{{ section.id }}" type="tel" name="address[phone]" autocomplete="tel" value="{{ form.phone }}">
                </div>

                <div class="qtmAccountAddresses__checkbox qtmAccountAddresses__field--wide">
                  {{ form.set_as_default_checkbox }}
                  <label for="address_default_address_new">Set as default address</label>
                </div>
              </div>

              <div class="qtmAccountAddresses__formActions">
                <button type="submit" class="qtmAccountAddresses__button qtmAccountAddresses__button--{{ section.settings.button_style }}">
                  Add address
                </button>

                <button type="reset" class="qtmAccountAddresses__secondaryButton">
                  Clear
                </button>
              </div>
            {% endform %}
          </section>

          {% if customer.addresses.size > 0 %}
            <div class="qtmAccountAddresses__list">
              {% for address in customer.addresses %}
                {%- liquid
                  assign address_is_default = false
                  if customer.default_address and address.id == customer.default_address.id
                    assign address_is_default = true
                  endif
                -%}

                <article class="qtmAccountAddresses__card" aria-labelledby="QtmAddressTitle-{{ address.id }}">
                  <div class="qtmAccountAddresses__cardHeader">
                    <div>
                      <h2 id="QtmAddressTitle-{{ address.id }}" class="qtmAccountAddresses__cardTitle">
                        {% if address.first_name != blank or address.last_name != blank %}
                          {{ address.first_name }} {{ address.last_name }}
                        {% else %}
                          Address {{ forloop.index }}
                        {% endif %}
                      </h2>

                      {% if address.company != blank %}
                        <p class="qtmAccountAddresses__company">
                          {{ address.company }}
                        </p>
                      {% endif %}
                    </div>

                    {% if address_is_default %}
                      <span class="qtmAccountAddresses__badge">
                        Default address
                      </span>
                    {% endif %}
                  </div>

                  <div class="qtmAccountAddresses__addressText">
                    {{ address | format_address }}

                    {% if address.phone != blank %}
                      <p>{{ address.phone }}</p>
                    {% endif %}
                  </div>

                  <div class="qtmAccountAddresses__cardActions">
                    <button
                      type="button"
                      class="qtmAccountAddresses__secondaryButton"
                      aria-expanded="false"
                      aria-controls="QtmAddressEditForm-{{ address.id }}"
                      data-qtm-addresses-edit-toggle
                    >
                      Edit
                    </button>

                    <button
                      type="button"
                      class="qtmAccountAddresses__dangerButton"
                      data-qtm-address-delete-button
                      data-delete-url="{{ address.url }}"
                    >
                      Delete
                    </button>

                    {% unless address_is_default %}
                      {% form 'customer_address', address, class: 'qtmAccountAddresses__setDefaultForm' %}
                        <input type="hidden" name="address[first_name]" value="{{ address.first_name | escape }}">
                        <input type="hidden" name="address[last_name]" value="{{ address.last_name | escape }}">
                        <input type="hidden" name="address[company]" value="{{ address.company | escape }}">
                        <input type="hidden" name="address[address1]" value="{{ address.address1 | escape }}">
                        <input type="hidden" name="address[address2]" value="{{ address.address2 | escape }}">
                        <input type="hidden" name="address[city]" value="{{ address.city | escape }}">
                        <input type="hidden" name="address[country]" value="{{ address.country | escape }}">
                        <input type="hidden" name="address[province]" value="{{ address.province | escape }}">
                        <input type="hidden" name="address[zip]" value="{{ address.zip | escape }}">
                        <input type="hidden" name="address[phone]" value="{{ address.phone | escape }}">
                        <input type="hidden" name="address[default]" value="1">

                        <button type="submit" class="qtmAccountAddresses__secondaryButton">
                          Set as default
                        </button>
                      {% endform %}
                    {% endunless %}
                  </div>

                  <div
                    id="QtmAddressEditForm-{{ address.id }}"
                    class="qtmAccountAddresses__editPanel"
                    data-qtm-addresses-edit-panel
                    hidden
                  >
                    <div class="qtmAccountAddresses__formHeader">
                      <h3 class="qtmAccountAddresses__editTitle">
                        Edit address
                      </h3>

                      <button
                        type="button"
                        class="qtmAccountAddresses__textButton"
                        data-qtm-addresses-edit-close
                      >
                        Close
                      </button>
                    </div>

                    {% form 'customer_address', address, class: 'qtmAccountAddresses__form' %}
                      <div class="qtmAccountAddresses__formGrid">
                        <div class="qtmAccountAddresses__field">
                          <label for="AddressFirstName_{{ address.id }}">First name</label>
                          <input id="AddressFirstName_{{ address.id }}" type="text" name="address[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
                        </div>

                        <div class="qtmAccountAddresses__field">
                          <label for="AddressLastName_{{ address.id }}">Last name</label>
                          <input id="AddressLastName_{{ address.id }}" type="text" name="address[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
                        </div>

                        <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                          <label for="AddressCompany_{{ address.id }}">Company</label>
                          <input id="AddressCompany_{{ address.id }}" type="text" name="address[company]" autocomplete="organization" value="{{ form.company }}">
                        </div>

                        <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                          <label for="AddressAddress1_{{ address.id }}">Address 1</label>
                          <input id="AddressAddress1_{{ address.id }}" type="text" name="address[address1]" autocomplete="address-line1" value="{{ form.address1 }}">
                        </div>

                        <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                          <label for="AddressAddress2_{{ address.id }}">Address 2</label>
                          <input id="AddressAddress2_{{ address.id }}" type="text" name="address[address2]" autocomplete="address-line2" value="{{ form.address2 }}">
                        </div>

                        <div class="qtmAccountAddresses__field">
                          <label for="AddressCity_{{ address.id }}">City</label>
                          <input id="AddressCity_{{ address.id }}" type="text" name="address[city]" autocomplete="address-level2" value="{{ form.city }}">
                        </div>

                        <div class="qtmAccountAddresses__field">
                          <label for="AddressCountry_{{ address.id }}">Country/region</label>
                          <select
                            id="AddressCountry_{{ address.id }}"
                            name="address[country]"
                            data-default="{{ form.country }}"
                            data-qtm-address-country
                          >
                            {{ all_country_option_tags }}
                          </select>
                        </div>

                        <div class="qtmAccountAddresses__field" id="AddressProvinceContainer_{{ address.id }}" data-qtm-address-province-container>
                          <label for="AddressProvince_{{ address.id }}">Province/state</label>
                          <select
                            id="AddressProvince_{{ address.id }}"
                            name="address[province]"
                            data-default="{{ form.province }}"
                            data-qtm-address-province
                          ></select>
                        </div>

                        <div class="qtmAccountAddresses__field">
                          <label for="AddressZip_{{ address.id }}">Postal/ZIP code</label>
                          <input id="AddressZip_{{ address.id }}" type="text" name="address[zip]" autocomplete="postal-code" value="{{ form.zip }}">
                        </div>

                        <div class="qtmAccountAddresses__field qtmAccountAddresses__field--wide">
                          <label for="AddressPhone_{{ address.id }}">Phone</label>
                          <input id="AddressPhone_{{ address.id }}" type="tel" name="address[phone]" autocomplete="tel" value="{{ form.phone }}">
                        </div>

                        <div class="qtmAccountAddresses__checkbox qtmAccountAddresses__field--wide">
                          {{ form.set_as_default_checkbox }}
                          <label for="address_default_address_{{ form.id }}">Set as default address</label>
                        </div>
                      </div>

                      <div class="qtmAccountAddresses__formActions">
                        <button type="submit" class="qtmAccountAddresses__button qtmAccountAddresses__button--{{ section.settings.button_style }}">
                          Save address
                        </button>

                        <button type="reset" class="qtmAccountAddresses__secondaryButton">
                          Reset
                        </button>
                      </div>
                    {% endform %}
                  </div>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="qtmAccountAddresses__empty">
              <h2>{{ section.settings.empty_heading }}</h2>

              {% if section.settings.empty_text != blank %}
                <p>{{ section.settings.empty_text }}</p>
              {% endif %}

              <button
                type="button"
                class="qtmAccountAddresses__button qtmAccountAddresses__button--{{ section.settings.button_style }}"
                aria-expanded="false"
                aria-controls="QtmAccountAddressesNewForm-{{ section.id }}"
                data-qtm-addresses-add-toggle
              >
                {{ section.settings.empty_button_label }}
              </button>
            </div>
          {% endif %}
        </main>
      </div>
    {% else %}
      <div class="qtmAccountAddresses__empty">
        <h1 class="qtmAccountAddresses__heading">
          {{ section.settings.heading | default: 'Addresses' }}
        </h1>

        <p>Please sign in to manage your saved addresses.</p>

        <a
          href="{{ routes.account_login_url }}"
          class="qtmAccountAddresses__button qtmAccountAddresses__button--{{ section.settings.button_style }}"
        >
          Sign in
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Account Main Addresses",
  "tag": "section",
  "class": "qtm-account-main-addresses",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Addresses"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Manage your saved shipping and billing addresses."
    },
    {
      "type": "header",
      "content": "Account navigation"
    },
    {
      "type": "checkbox",
      "id": "show_account_nav",
      "label": "Show account navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "dashboard_label",
      "label": "Dashboard label",
      "default": "Dashboard"
    },
    {
      "type": "text",
      "id": "orders_label",
      "label": "Orders label",
      "default": "Orders"
    },
    {
      "type": "text",
      "id": "addresses_label",
      "label": "Addresses label",
      "default": "Addresses"
    },
    {
      "type": "text",
      "id": "tracking_label",
      "label": "Order tracking label",
      "default": "Order Tracking"
    },
    {
      "type": "url",
      "id": "tracking_url",
      "label": "Order tracking URL"
    },
    {
      "type": "text",
      "id": "logout_label",
      "label": "Logout label",
      "default": "Logout"
    },
    {
      "type": "header",
      "content": "Delete confirmation"
    },
    {
      "type": "text",
      "id": "delete_confirm_message",
      "label": "Delete confirmation message",
      "default": "Are you sure you want to delete this address?"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "You have not added any addresses yet."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Add your first address to make future checkouts faster."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Empty button label",
      "default": "Add your first address"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "label": "Meta font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Badge radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Buttons and forms"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        }
      ]
    },
    {
      "type": "range",
      "id": "form_field_radius",
      "label": "Form field radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "form_field_padding",
      "label": "Form field padding",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Account Main Addresses"
    }
  ]
}
{% endschema %}