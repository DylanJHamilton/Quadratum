{%- assign rendered_count = 0 -%}
<div class="q-feed__items" data-q-feed-items id="q-feed-items-{{ section.id }}">
  {%- for article in articles -%}
    {%- if article.url != blank -%}
      {%- if filter_tag == blank or article.tags contains filter_tag -%}
        {%- liquid
          assign raw = article.excerpt_or_content | strip_html | strip
          if section.settings.excerpt_mode == 'chars'
            assign excerpt_text = raw | truncate: section.settings.excerpt_chars, '…'
          else
            assign excerpt_text = raw | truncatewords: section.settings.excerpt_words, '…'
          endif
        -%}
        <div class="q-feed__item">
          {% render 'blog-card', article: article, heading_level: 3,
            show_image: section.settings.show_image, show_author: section.settings.show_author,
            show_date: section.settings.show_date, show_read_time: section.settings.show_read_time,
            show_tags: section.settings.show_tags, show_excerpt: section.settings.show_excerpt,
            excerpt_text: excerpt_text, cta_label: section.settings.cta_label %}
        </div>
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- if rendered_count >= limit -%}{%- break -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</div>
{% if rendered_count == 0 %}<p class="q-feed__empty">{% if filter_tag != blank %}No matching articles in this preview. Browse the tagged archive below.{% else %}No articles on this page.{% endif %}</p>{% endif %}
