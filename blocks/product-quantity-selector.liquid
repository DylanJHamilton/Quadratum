{%- liquid
  assign block_id = 'product-quantity-selector-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign selector_style = block.settings.selector_style | default: 'standard'

  assign min_quantity = block.settings.min_quantity | default: 1
  assign max_quantity = block.settings.max_quantity | default: 99

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-quantity-selector
    product-quantity-selector--{{ selector_style }}
    product-quantity-selector--width-{{ width }}
    product-quantity-selector--align-{{ alignment }}
    {% unless show_on_desktop %} product-quantity-selector--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-quantity-selector--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-quantity-selector--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-quantity-selector--animate product-quantity-selector--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-quantity-selector-margin-top: {{ block.settings.margin_top }}px;
    --product-quantity-selector-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-quantity-selector-padding: {{ block.settings.padding }}px;
    --product-quantity-selector-gap: {{ block.settings.gap }}px;
    --product-quantity-selector-width: {{ block.settings.control_width }}px;
    --product-quantity-selector-height: {{ block.settings.control_height }}px;
    --product-quantity-selector-border-width: {{ block.settings.border_width }}px;
    --product-quantity-selector-border-radius: {{ block.settings.border_radius }}px;
    --product-quantity-selector-heading-color: {{ block.settings.heading_color }};
    --product-quantity-selector-text-color: {{ block.settings.text_color }};
    --product-quantity-selector-background-color: {{ block.settings.background_color }};
    --product-quantity-selector-border-color: {{ block.settings.border_color }};
    --product-quantity-selector-active-color: {{ block.settings.active_color }};
  "
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-quantity-selector
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-quantity-selector-margin-top);
      margin-bottom: var(--product-quantity-selector-margin-bottom);
      padding: var(--product-quantity-selector-padding);
      color: var(--product-quantity-selector-text-color);
      background: transparent;
    }

    #{{ block_id }}.product-quantity-selector--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-quantity-selector--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-quantity-selector--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-quantity-selector--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-quantity-selector--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-quantity-selector--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-quantity-selector--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-quantity-selector--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-quantity-selector__inner {
      display: grid;
      gap: var(--product-quantity-selector-gap);
      min-width: 0;
    }

    #{{ block_id }} .product-quantity-selector__label {
      margin: 0;
      color: var(--product-quantity-selector-heading-color);
      line-height: 1.25;
      font-size: 0.94em;
    }

    #{{ block_id }} .product-quantity-selector__control {
      display: inline-grid;
      grid-template-columns: var(--product-quantity-selector-height) minmax(64px, 1fr) var(--product-quantity-selector-height);
      align-items: stretch;
      width: var(--product-quantity-selector-width);
      max-width: 100%;
      height: var(--product-quantity-selector-height);
      overflow: hidden;
      color: var(--product-quantity-selector-text-color);
      background: var(--product-quantity-selector-background-color);
      border: var(--product-quantity-selector-border-width) solid var(--product-quantity-selector-border-color);
      border-radius: var(--product-quantity-selector-border-radius);
    }

    #{{ block_id }}.product-quantity-selector--compact .product-quantity-selector__control {
      grid-template-columns: 38px minmax(54px, 1fr) 38px;
      height: 38px;
    }

    #{{ block_id }}.product-quantity-selector--minimal .product-quantity-selector__control {
      border-left: 0;
      border-right: 0;
      border-radius: 0;
      width: min(var(--product-quantity-selector-width), 180px);
    }

    #{{ block_id }}.product-quantity-selector--align-center .product-quantity-selector__control {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-quantity-selector--align-right .product-quantity-selector__control {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-quantity-selector__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      color: var(--product-quantity-selector-heading-color);
      background: transparent;
      border: 0;
      cursor: pointer;
      font: inherit;
      font-size: 1.25em;
      line-height: 1;
      transition: background 180ms ease, color 180ms ease, opacity 180ms ease;
    }

    #{{ block_id }} .product-quantity-selector__button:hover {
      color: var(--product-quantity-selector-active-color);
      background: rgba(0, 0, 0, 0.04);
    }

    #{{ block_id }} .product-quantity-selector__button:focus-visible {
      outline: 2px solid var(--product-quantity-selector-active-color);
      outline-offset: -2px;
    }

    #{{ block_id }} .product-quantity-selector__button[disabled] {
      cursor: not-allowed;
      opacity: 0.4;
    }

    #{{ block_id }} .product-quantity-selector__input {
      width: 100%;
      height: 100%;
      min-width: 0;
      padding: 0 8px;
      color: var(--product-quantity-selector-heading-color);
      background: transparent;
      border-top: 0;
      border-bottom: 0;
      border-left: var(--product-quantity-selector-border-width) solid var(--product-quantity-selector-border-color);
      border-right: var(--product-quantity-selector-border-width) solid var(--product-quantity-selector-border-color);
      border-radius: 0;
      text-align: center;
      font: inherit;
      font-variant-numeric: tabular-nums;
      appearance: textfield;
      -moz-appearance: textfield;
    }

    #{{ block_id }} .product-quantity-selector__input::-webkit-outer-spin-button,
    #{{ block_id }} .product-quantity-selector__input::-webkit-inner-spin-button {
      margin: 0;
      appearance: none;
      -webkit-appearance: none;
    }

    #{{ block_id }} .product-quantity-selector__input:focus-visible {
      outline: 2px solid var(--product-quantity-selector-active-color);
      outline-offset: -2px;
    }

    #{{ block_id }} .product-quantity-selector__note {
      color: var(--product-quantity-selector-text-color);
      line-height: 1.35;
      font-size: 0.88em;
      opacity: 0.78;
    }

    #{{ block_id }}.product-quantity-selector--align-center .product-quantity-selector__note {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-quantity-selector--align-right .product-quantity-selector__note {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.product-quantity-selector--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-quantity-selector--animate-fade {
      animation-name: productQuantitySelectorFade;
    }

    #{{ block_id }}.product-quantity-selector--animate-fade_up {
      animation-name: productQuantitySelectorFadeUp;
    }

    #{{ block_id }}.product-quantity-selector--animate-fade_down {
      animation-name: productQuantitySelectorFadeDown;
    }

    #{{ block_id }}.product-quantity-selector--animate-fade_left {
      animation-name: productQuantitySelectorFadeLeft;
    }

    #{{ block_id }}.product-quantity-selector--animate-fade_right {
      animation-name: productQuantitySelectorFadeRight;
    }

    #{{ block_id }}.product-quantity-selector--animate-zoom {
      animation-name: productQuantitySelectorZoom;
    }

    @keyframes productQuantitySelectorFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productQuantitySelectorFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productQuantitySelectorFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productQuantitySelectorFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productQuantitySelectorFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productQuantitySelectorZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-quantity-selector--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-quantity-selector--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-quantity-selector--hide-mobile {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-quantity-selector--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-quantity-selector__button {
        transition: none;
      }
    }
  </style>

  <div class="product-quantity-selector__inner">
    {% if block.settings.show_label and block.settings.label != blank %}
      <label class="product-quantity-selector__label" for="{{ block_id }}-quantity">
        {{ block.settings.label | escape }}
      </label>
    {% endif %}

    <div class="product-quantity-selector__control">
      <button
        type="button"
        class="product-quantity-selector__button"
        data-product-quantity-minus
        aria-label="{{ block.settings.decrease_label | escape }}"
      >
        −
      </button>

      <input
        id="{{ block_id }}-quantity"
        class="product-quantity-selector__input"
        type="number"
        name="quantity"
        min="{{ min_quantity }}"
        max="{{ max_quantity }}"
        value="{{ block.settings.default_quantity }}"
        inputmode="numeric"
        data-product-quantity-input
        aria-label="{{ block.settings.input_label | escape }}"
      >

      <button
        type="button"
        class="product-quantity-selector__button"
        data-product-quantity-plus
        aria-label="{{ block.settings.increase_label | escape }}"
      >
        +
      </button>
    </div>

    {% if block.settings.show_note and block.settings.note != blank %}
      <div class="product-quantity-selector__note">
        {{ block.settings.note | escape }}
      </div>
    {% endif %}
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.productQuantitySelectorReady === 'true') return;

      root.dataset.productQuantitySelectorReady = 'true';

      const input = root.querySelector('[data-product-quantity-input]');
      const minusButton = root.querySelector('[data-product-quantity-minus]');
      const plusButton = root.querySelector('[data-product-quantity-plus]');

      if (!input || !minusButton || !plusButton) return;

      const min = Number(input.getAttribute('min') || 1);
      const max = Number(input.getAttribute('max') || 9999);

      const normalize = (value) => {
        const parsed = Number(value || min);

        if (Number.isNaN(parsed)) return min;

        return Math.min(Math.max(Math.floor(parsed), min), max);
      };

      const dispatchQuantityChange = () => {
        document.dispatchEvent(new CustomEvent('quantity:change', {
          bubbles: true,
          detail: {
            productId: {{ product_context.id | json }},
            variantId: Number(root.dataset.variantId || {{ current_variant.id | json }}),
            quantity: Number(input.value || min)
          }
        }));

        document.dispatchEvent(new CustomEvent('qtm:quantity:change', {
          bubbles: true,
          detail: {
            productId: {{ product_context.id | json }},
            variantId: Number(root.dataset.variantId || {{ current_variant.id | json }}),
            quantity: Number(input.value || min)
          }
        }));
      };

      const updateButtons = () => {
        const value = normalize(input.value);

        input.value = String(value);
        minusButton.disabled = value <= min;
        plusButton.disabled = value >= max;
      };

      minusButton.addEventListener('click', () => {
        input.value = String(normalize(Number(input.value || min) - 1));
        updateButtons();
        dispatchQuantityChange();
      });

      plusButton.addEventListener('click', () => {
        input.value = String(normalize(Number(input.value || min) + 1));
        updateButtons();
        dispatchQuantityChange();
      });

      input.addEventListener('change', () => {
        updateButtons();
        dispatchQuantityChange();
      });

      input.addEventListener('blur', updateButtons);

      document.addEventListener('variant:change', (event) => {
        const detail = event.detail || {};
        const variantId = detail.variantId || detail.variant_id || detail.id;

        if (variantId) {
          root.dataset.variantId = String(variantId);
        }
      });

      document.addEventListener('qtm:variant:change', (event) => {
        const detail = event.detail || {};
        const variantId = detail.variantId || detail.variant_id || detail.id;

        if (variantId) {
          root.dataset.variantId = String(variantId);
        }
      });

      updateButtons();
    })();
  </script>
</div>

{% schema %}
{
  "name": "Product quantity selector",
  "settings": [
    {
      "type": "header",
      "content": "Quantity"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input accessibility label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "decrease_label",
      "label": "Decrease button label",
      "default": "Decrease quantity"
    },
    {
      "type": "text",
      "id": "increase_label",
      "label": "Increase button label",
      "default": "Increase quantity"
    },
    {
      "type": "range",
      "id": "default_quantity",
      "label": "Default quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "min_quantity",
      "label": "Minimum quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum quantity",
      "min": 1,
      "max": 101,
      "step": 1,
      "default": 99
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note",
      "default": false
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "select",
      "id": "selector_style",
      "label": "Selector style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "control_width",
      "label": "Control width",
      "min": 120,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "control_height",
      "label": "Control height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Label color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Control background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Control border",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Quantity",
      "settings": {
        "show_label": true,
        "label": "Quantity",
        "input_label": "Quantity",
        "decrease_label": "Decrease quantity",
        "increase_label": "Increase quantity",
        "default_quantity": 1,
        "min_quantity": 1,
        "max_quantity": 99,
        "show_note": false,
        "selector_style": "standard",
        "control_width": 180,
        "control_height": 46,
        "heading_color": "#111111",
        "text_color": "#444444",
        "background_color": "#ffffff",
        "border_color": "#d9d9d9",
        "active_color": "#111111",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "gap": 8,
        "margin_top": 0,
        "margin_bottom": 16,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Compact Quantity",
      "settings": {
        "show_label": true,
        "label": "Qty",
        "input_label": "Quantity",
        "decrease_label": "Decrease quantity",
        "increase_label": "Increase quantity",
        "default_quantity": 1,
        "min_quantity": 1,
        "max_quantity": 99,
        "show_note": false,
        "selector_style": "compact",
        "control_width": 156,
        "control_height": 38,
        "heading_color": "#111111",
        "text_color": "#444444",
        "background_color": "#ffffff",
        "border_color": "#d9d9d9",
        "active_color": "#111111",
        "border_width": 1,
        "border_radius": 80,
        "width": "auto",
        "alignment": "left",
        "gap": 6,
        "margin_top": 0,
        "margin_bottom": 12,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Minimal Quantity",
      "settings": {
        "show_label": false,
        "label": "Quantity",
        "input_label": "Quantity",
        "decrease_label": "Decrease quantity",
        "increase_label": "Increase quantity",
        "default_quantity": 1,
        "min_quantity": 1,
        "max_quantity": 99,
