{%- liquid
  assign block_id = 'content-review-wall-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign layout_style = block.settings.layout_style | default: 'grid'
  assign desktop_columns = block.settings.desktop_columns | default: '3'
  assign mobile_columns = block.settings.mobile_columns | default: '1'
  assign review_count = block.settings.review_count | default: 6

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-review-wall
    content-review-wall--{{ layout_style }}
    content-review-wall--width-{{ block_width }}
    content-review-wall--align-{{ text_alignment }}
    content-review-wall--desktop-{{ desktop_columns }}
    content-review-wall--mobile-{{ mobile_columns }}
    {% unless show_on_desktop %} content-review-wall--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-review-wall--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-review-wall--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-review-wall--animate content-review-wall--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-review-wall-margin-top: {{ block.settings.margin_top }}px;
    --content-review-wall-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-review-wall-padding: {{ block.settings.padding }}px;
    --content-review-wall-gap: {{ block.settings.gap }}px;
    --content-review-wall-card-padding: {{ block.settings.card_padding }}px;
    --content-review-wall-border-width: {{ block.settings.border_width }}px;
    --content-review-wall-border-radius: {{ block.settings.border_radius }}px;
    --content-review-wall-heading-color: {{ block.settings.heading_color }};
    --content-review-wall-text-color: {{ block.settings.text_color }};
    --content-review-wall-background-color: {{ block.settings.background_color }};
    --content-review-wall-card-background-color: {{ block.settings.card_background_color }};
    --content-review-wall-border-color: {{ block.settings.border_color }};
    --content-review-wall-link-color: {{ block.settings.link_color }};
    --content-review-wall-rating-color: {{ block.settings.rating_color }};
    --content-review-wall-verified-background: {{ block.settings.verified_background_color }};
    --content-review-wall-verified-text: {{ block.settings.verified_text_color }};
    --content-review-wall-image-size: {{ block.settings.image_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-review-wall-margin-top);
      margin-bottom: var(--content-review-wall-margin-bottom);
      padding: var(--content-review-wall-padding);
      color: var(--content-review-wall-text-color);
      background: var(--content-review-wall-background-color);
    }

    #{{ block_id }}.content-review-wall--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-review-wall--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-review-wall--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-review-wall--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-review-wall--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-review-wall--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-review-wall--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-review-wall--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-review-wall__items {
      width: 100%;
      gap: var(--content-review-wall-gap);
    }

    #{{ block_id }}.content-review-wall--grid .content-review-wall__items,
    #{{ block_id }}.content-review-wall--cards .content-review-wall__items,
    #{{ block_id }}.content-review-wall--compact .content-review-wall__items {
      display: grid;
    }

    #{{ block_id }}.content-review-wall--desktop-1 .content-review-wall__items {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ block_id }}.content-review-wall--desktop-2 .content-review-wall__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ block_id }}.content-review-wall--desktop-3 .content-review-wall__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ block_id }}.content-review-wall--desktop-4 .content-review-wall__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ block_id }}.content-review-wall--masonry .content-review-wall__items {
      columns: {{ desktop_columns }};
      column-gap: var(--content-review-wall-gap);
    }

    #{{ block_id }} .content-review-wall__item {
      min-width: 0;
      color: var(--content-review-wall-text-color);
      background: var(--content-review-wall-card-background-color);
      border: var(--content-review-wall-border-width) solid var(--content-review-wall-border-color);
      border-radius: var(--content-review-wall-border-radius);
      padding: var(--content-review-wall-card-padding);
      overflow: hidden;
    }

    #{{ block_id }}.content-review-wall--masonry .content-review-wall__item {
      display: inline-block;
      width: 100%;
      break-inside: avoid;
      margin-bottom: var(--content-review-wall-gap);
    }

    #{{ block_id }}.content-review-wall--cards .content-review-wall__item,
    #{{ block_id }}.content-review-wall--masonry .content-review-wall__item {
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }}.content-review-wall--compact .content-review-wall__item {
      padding: min(var(--content-review-wall-card-padding), 20px);
    }

    #{{ block_id }} .content-review-wall__card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
      height: 100%;
    }

    #{{ block_id }} .content-review-wall__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-width: 0;
    }

    #{{ block_id }}.content-review-wall--align-center .content-review-wall__top {
      flex-direction: column;
      justify-content: center;
    }

    #{{ block_id }}.content-review-wall--align-right .content-review-wall__top {
      flex-direction: row-reverse;
    }

    #{{ block_id }} .content-review-wall__author {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    #{{ block_id }}.content-review-wall--align-center .content-review-wall__author {
      flex-direction: column;
      justify-content: center;
    }

    #{{ block_id }}.content-review-wall--align-right .content-review-wall__author {
      flex-direction: row-reverse;
      text-align: right;
    }

    #{{ block_id }} .content-review-wall__image {
      width: var(--content-review-wall-image-size);
      height: var(--content-review-wall-image-size);
      flex: 0 0 var(--content-review-wall-image-size);
      display: block;
      object-fit: cover;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .content-review-wall__author-content {
      display: grid;
      gap: 3px;
      min-width: 0;
    }

    #{{ block_id }} .content-review-wall__name {
      color: var(--content-review-wall-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .content-review-wall__source {
      color: var(--content-review-wall-text-color);
      line-height: 1.3;
      opacity: 0.76;
    }

    #{{ block_id }} .content-review-wall__rating {
      display: flex;
      gap: 2px;
      color: var(--content-review-wall-rating-color);
      line-height: 1;
      white-space: nowrap;
    }

    #{{ block_id }}.content-review-wall--align-center .content-review-wall__rating {
      justify-content: center;
    }

    #{{ block_id }}.content-review-wall--align-right .content-review-wall__rating {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-review-wall__quote {
      margin: 0;
      color: var(--content-review-wall-text-color);
      line-height: 1.65;
    }

    #{{ block_id }}.content-review-wall--compact .content-review-wall__quote {
      line-height: 1.5;
    }

    #{{ block_id }} .content-review-wall__verified {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      color: var(--content-review-wall-verified-text);
      background: var(--content-review-wall-verified-background);
      line-height: 1.2;
      font-size: 0.82em;
    }

    #{{ block_id }}.content-review-wall--align-center .content-review-wall__verified {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-review-wall--align-right .content-review-wall__verified {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }}.content-review-wall--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-review-wall--animate-fade {
      animation-name: contentReviewWallFade;
    }

    #{{ block_id }}.content-review-wall--animate-fade_up {
      animation-name: contentReviewWallFadeUp;
    }

    #{{ block_id }}.content-review-wall--animate-fade_down {
      animation-name: contentReviewWallFadeDown;
    }

    #{{ block_id }}.content-review-wall--animate-fade_left {
      animation-name: contentReviewWallFadeLeft;
    }

    #{{ block_id }}.content-review-wall--animate-fade_right {
      animation-name: contentReviewWallFadeRight;
    }

    #{{ block_id }}.content-review-wall--animate-zoom {
      animation-name: contentReviewWallZoom;
    }

    @keyframes contentReviewWallFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentReviewWallFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentReviewWallFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentReviewWallFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentReviewWallFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentReviewWallZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-review-wall--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-review-wall--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-review-wall--desktop-3 .content-review-wall__items,
      #{{ block_id }}.content-review-wall--desktop-4 .content-review-wall__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.content-review-wall--masonry .content-review-wall__items {
        columns: 2;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-review-wall--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-review-wall--mobile-1 .content-review-wall__items {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-review-wall--mobile-2 .content-review-wall__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ block_id }}.content-review-wall--masonry .content-review-wall__items {
        columns: {{ mobile_columns }};
      }

      #{{ block_id }} .content-review-wall__item {
        padding: min(var(--content-review-wall-card-padding), 22px);
      }

      #{{ block_id }}.content-review-wall--mobile-2 .content-review-wall__top {
        flex-direction: column;
        align-items: flex-start;
      }

      #{{ block_id }}.content-review-wall--mobile-2 .content-review-wall__author {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-review-wall--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="content-review-wall__items">
    {%- for index in (1..12) -%}
      {%- if index <= review_count -%}
        {%- liquid
          assign quote_key = 'review_' | append: index | append: '_quote'
          assign name_key = 'review_' | append: index | append: '_name'
          assign rating_key = 'review_' | append: index | append: '_rating'
          assign source_key = 'review_' | append: index | append: '_source'
          assign image_key = 'review_' | append: index | append: '_image'
          assign image_alt_key = 'review_' | append: index | append: '_image_alt'
          assign verified_key = 'review_' | append: index | append: '_verified_label'

          assign quote = block.settings[quote_key]
          assign name = block.settings[name_key]
          assign rating = block.settings[rating_key]
          assign source = block.settings[source_key]
          assign image = block.settings[image_key]
          assign image_alt = block.settings[image_alt_key]
          assign verified_label = block.settings[verified_key]
        -%}

        {% if quote != blank or name != blank %}
          <article class="content-review-wall__item">
            <div class="content-review-wall__card">
              <div class="content-review-wall__top">
                <div class="content-review-wall__author">
                  {% if image != blank %}
                    {{
                      image
                      | image_url: width: 220
                      | image_tag:
                        class: 'content-review-wall__image',
                        loading: 'lazy',
                        alt: image_alt
                    }}
                  {% endif %}

                  <div class="content-review-wall__author-content">
                    {% if name != blank %}
                      <strong class="content-review-wall__name">{{ name | escape }}</strong>
                    {% endif %}

                    {% if source != blank %}
                      <span class="content-review-wall__source">{{ source | escape }}</span>
                    {% endif %}
                  </div>
                </div>

                {% if rating != 'none' %}
                  <div class="content-review-wall__rating" aria-label="{{ rating | escape }} out of 5 stars">
                    {%- case rating -%}
                      {%- when '1' -%}★
                      {%- when '2' -%}★★
                      {%- when '3' -%}★★★
                      {%- when '4' -%}★★★★
                      {%- when '5' -%}★★★★★
                    {%- endcase -%}
                  </div>
                {% endif %}
              </div>

              {% if quote != blank %}
                <blockquote class="content-review-wall__quote">
                  “{{ quote | escape }}”
                </blockquote>
              {% endif %}

              {% if verified_label != blank %}
                <span class="content-review-wall__verified">
                  <span aria-hidden="true">✓</span>
                  <span>{{ verified_label | escape }}</span>
                </span>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Content review wall",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "grid",
      "options": [
        {
          "value": "masonry",
          "label": "Masonry"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ]
    },
    {
      "type": "range",
      "id": "review_count",
      "label": "Number of reviews",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Block width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },

    {
      "type": "header",
      "content": "Review 1"
    },
    {
      "type": "textarea",
      "id": "review_1_quote",
      "label": "Quote",
      "default": "Fast, clear, and exactly what I needed. The entire process felt easy from start to finish."
    },
    {
      "type": "text",
      "id": "review_1_name",
      "label": "Name",
      "default": "Alex Morgan"
    },
    {
      "type": "select",
      "id": "review_1_rating",
      "label": "Rating",
      "default": "5",
      "options": [
        {
          "value": "none",
          "label": "No rating"
        },
        {
          "value": "1",
          "label": "1 star"
        },
        {
          "value": "2",
          "label": "2 stars"
        },
        {
          "value": "3",
          "label": "3 stars"
        },
        {
          "value": "4",
          "label": "4 stars"
        },
        {
          "value": "5",
          "label": "5 stars"
        }
      ]
    },
    {
      "type": "text",
      "id": "review_1_source",
      "label": "Source",
      "default": "Verified Buyer"
    },
    {
      "type": "image_picker",
      "id": "review_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "review_1_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "review_1_verified_label",
      "label": "Verified label",
      "default": "Verified"
    },

    {
      "type": "header",
      "content": "Review 2"
    },
    {
      "type": "textarea",
      "id": "review_2_quote",
      "label": "Quote",
      "default": "The experience was professional and gave me confidence before making a decision."
    },
    {
      "type": "text",
      "id": "review_2_name",
      "label": "Name",
      "default": "Jordan Lee"
    },
    {
      "type": "select",
      "id": "review_2_rating",
      "label": "Rating",
      "default": "5",
      "options": [
        {
          "value": "none",
          "label": "No rating"
        },
        {
          "value": "1",
          "label": "1 star"
        },
        {
          "value": "2",
          "label": "2 stars"
        },
        {
          "value": "3",
          "label": "3 stars"
        },
        {
          "value": "4",
          "label": "4 stars"
        },
        {
          "value": "5",
          "label": "5 stars"
        }
      ]
    },
    {
      "type": "text",
      "id": "review_2_source",
      "label": "Source",
      "default": "Customer Review"
    },
    {
      "type": "image_picker",
      "id": "review_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "review_2_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "review_2_verified_label",
      "label": "Verified label",
      "default": "Verified"
    },

    {
      "type": "header",
      "content": "Review 3"
    },
    {
      "type": "textarea",
      "id": "review_3_quote",
      "label": "Quote",
      "default": "Everything was simple to understand. It made the buying experience feel much more trustworthy."
    },
    {
      "type": "text",
      "id": "review_3_name",
      "label": "Name",
      "default": "Taylor Reed"
    },
    {
      "type": "select",
      "id": "review_3_rating",
      "label": "Rating",
      "default": "5",
      "options": [
        {
          "value": "none",
          "label": "No rating"
        },
        {
          "value": "1",
          "label": "1 star"
        },
        {
          "value": "2",
          "label": "2 stars"
        },
        {
          "value": "3",
          "label": "3 stars"
        },
        {
          "value": "4",
          "label": "4 stars"
        },
        {
          "value": "5",
          "label": "5 stars"
        }
      ]
    },
    {
      "type": "text",
      "id": "review_3_source",
      "label": "Source",
      "default": "Online Review"
    },
    {
      "type": "image_picker",
      "id": "review_3_image",
      "label": "Image"
    },
    {
      "type": "text",
