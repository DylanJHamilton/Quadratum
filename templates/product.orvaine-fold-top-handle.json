            "icon": "",
            "cta_style": "link",
            "cta_label": "View the rear",
            "cta_url": "#product-details"
          }
        },
        "or_4": {
          "type": "tile",
          "settings": {
            "title": "Carried by hand",
            "body": "<p>A 12 cm handle drop for carrying in the hand or the crook of the arm. Scale is illustrative.</p>",
