    "timeline": {
      "type": "interactive-content-helper-story-timeline",
      "blocks": {
        "milestone_1": {
          "type": "milestone",
          "settings": {
            "year_or_date": "The table",
            "title": "A monthly reading group outgrows a kitchen",
            "description": "<p>Eight people, one book, and a habit of opening with a question instead of a summary.</p>",
            "badge": ""
          }
        },
        "milestone_2": {
          "type": "milestone",
          "settings": {
            "year_or_date": "The shelf",
            "title": "A single shelf of hand-noted titles",
            "description": "<p>Short notes on index cards. People started buying the books with the notes attached.</p>",
            "badge": ""
          }
        },
        "milestone_3": {
          "type": "milestone",
          "settings": {
            "year_or_date": "The room",
            "title": "A storefront on Linden Row",
            "description": "<p>Four shelves, a long table and a window seat. The notes moved from cards to the shelf edge.</p>",
            "badge": ""
          }
        },
        "milestone_4": {
          "type": "milestone",
          "settings": {
            "year_or_date": "The goods",
            "title": "A journal, a tote and a set of bookmarks",
            "description": "<p>Made for the shop's own readers, in Field, Ink, Oxblood and Oat.</p>",
            "badge": ""
          }
        },
        "milestone_5": {
          "type": "milestone",
          "settings": {
            "year_or_date": "Online",
            "title": "The same shop, built on Quadratum",
            "description": "<p>Every section on this site is a stock Quadratum section with brand settings. No custom code.</p>",
            "badge": "Now"
          }
        }
      },
      "block_order": [
        "milestone_1",
        "milestone_2",
        "milestone_3",
        "milestone_4",
        "milestone_5"
