        "button_hover_background": "#333333",
        "button_hover_border_color": "#333333",
        "content_width": "auto",
        "alignment": "left",
        "desktop_width": "100",
        "mobile_width": "100",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_left": 0,
        "padding_right": 0,
        "show_desktop": true,
        "show_tablet": true,
        "show_mobile": true,
        "animation": "none",
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_color": "#000000",
