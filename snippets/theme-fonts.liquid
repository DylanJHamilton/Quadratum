{%- liquid
  assign font_display = settings.font_loading | default: 'swap'
  unless font_display == 'fallback'
    assign font_display = 'swap'
  endunless
-%}
<style data-quadratum-fonts>
  {%- if settings.font_heading != blank -%}
    {{ settings.font_heading | font_face: font_display: font_display }}
  {%- endif -%}
  {%- if settings.font_body != blank and settings.font_body != settings.font_heading -%}
    {{ settings.font_body | font_face: font_display: font_display }}
  {%- endif -%}
</style>
{%- assign font_keys = 'font_heading,font_body' | split: ',' -%}
<style data-quadratum-font-variants>
  {%- for font_key in font_keys -%}
    {%- assign base_font = settings[font_key] -%}
    {%- if base_font != blank -%}
      {%- assign bold_font = base_font | font_modify: 'weight', 'bold' -%}
      {%- assign italic_font = base_font | font_modify: 'style', 'italic' -%}
      {%- assign bold_italic_font = bold_font | font_modify: 'style', 'italic' -%}
      {%- if bold_font != blank and bold_font != base_font -%}{{ bold_font | font_face: font_display: font_display }}{%- endif -%}
      {%- if italic_font != blank and italic_font != base_font -%}{{ italic_font | font_face: font_display: font_display }}{%- endif -%}
      {%- if bold_italic_font != blank and bold_italic_font != base_font -%}{{ bold_italic_font | font_face: font_display: font_display }}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</style>
