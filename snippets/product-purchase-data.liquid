{%- capture json_less_than -%}\u003c{%- endcapture -%}
{%- capture purchase_data -%}
[
{% assign variant = product.selected_or_first_available_variant %}
{% assign emitted_variant = false %}
{% if variant != blank %}
{% render 'product-purchase-variant', variant: variant, product: product, include_media: include_media, include_image: include_image, sale_badge_style: sale_badge_style %}
{% assign emitted_variant = true %}
{% endif %}
{% unless product.variants_count > 250 %}
{% for variant in product.variants %}{% unless variant.id == product.selected_or_first_available_variant.id %}
{% if emitted_variant %},{% endif %}
{% render 'product-purchase-variant', variant: variant, product: product, include_media: include_media, include_image: include_image, sale_badge_style: sale_badge_style %}
{% assign emitted_variant = true %}
{% endunless %}{% endfor %}
{% endunless %}

]
{%- endcapture -%}
<script type="application/json" data-product-purchase-data data-requires-selling-plan="{{ product.requires_selling_plan | default: false }}">{{ purchase_data | replace: '<', json_less_than }}</script>
