    "script_head": "<style id=\"arc-reference-style\">\nbody{background:#f5f5f1;color:#111}body h1,body h2,body h3{font-weight:500;letter-spacing:-.045em}body h1{line-height:.97}body h2{line-height:1.04}body .q-collection-highlights .q-heading{font-size:clamp(2rem,4.6vw,4rem)}body .q-collection-highlights .q-collection-card,body .q-collection-highlights .q-collection-card__media{border-radius:0!important;box-shadow:none!important}body .q-collection-highlights .q-section-header{max-width:850px;margin-bottom:40px}body .q-collection-highlights .q-bento{grid-auto-rows:minmax(125px,auto)}body .q-collection-highlights .q-bento>:nth-child(5){grid-column:span 6}body .q-collection-highlights .q-bento>:nth-child(4){grid-column:span 3}body .q-collection-highlights .q-bento>:first-child{grid-row:span 4}body .shopify-section{scroll-margin-top:100px}body .fp-specs{border-top:1px solid #ffffff50;padding-top:24px}body .qtm-content-block{min-width:0}body .qtm-content-heading{font-weight:500}body [id*=\"__portfolio-\"] h3{font-size:20px}body [id*=\"__portfolio-\"] [class*=\"card\"]{box-shadow:none}body [id*=\"__fam-\"]{border-top:1px solid #cfcfca}body [id*=\"__fam-\"] h2{font-size:clamp(2rem,4vw,3.5rem)}body [id*=\"__fam-\"] .qtm-layout-column{min-width:0}body [id*=\"__hero\"] h1{max-width:13ch}body [id*=\"__finish\"]{color:#f5f5f1}body [id*=\"__finish\"] h2,body [id*=\"__finish\"] p{color:inherit}body [id*=\"__finish\"] a{color:inherit}body [id*=\"__st-hero\"] h1{font-size:clamp(3rem,6vw,6.5rem)}@media(max-width:749px){body .q-collection-highlights .q-bento>*{grid-column:1/-1!important;grid-row:auto!important}body h1{overflow-wrap:normal}body .shopify-section{scroll-margin-top:72px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}}\nbody #MainContent h1{font-weight:500!important;letter-spacing:-.045em!important}body #MainContent [id*=\"__sup-hero\"] h1,body #MainContent [id*=\"__ft-hero\"] h1{font-size:clamp(3.5rem,7vw,7rem)!important;line-height:1!important}body [id*=\"__st-hero\"] h1{font-size:clamp(3rem,6vw,6.5rem)!important;font-weight:500!important}body #MainContent [id*=\"__ss\"] h1,body #MainContent [id*=\"__ss\"] h2{font-size:clamp(3rem,6vw,6.5rem)!important;font-weight:500!important;color:#f5f5f1!important;max-width:12ch;line-height:1!important}body #MainContent [id*=\"__ss\"] [class*=\"content\"]{text-align:left}body .qh2b__action-label{display:none}body .qh2b__icon-button{border:0}body .q-ch__inner{padding-inline:clamp(20px,4vw,56px)}body [id*=\"__fam-layout\"]:has(h2:only-child){padding-bottom:0}</style><script>document.documentElement.classList.toggle('arc-other-product',location.pathname.startsWith('/products/')&&!location.pathname.endsWith('/vector-one'));document.documentElement.classList.toggle('arc-other-collection',location.pathname.startsWith('/collections/')&&!location.pathname.endsWith('/smart-eyewear'));</script><style>.arc-other-product [id$=\"__meta-panels\"],.arc-other-product [id$=\"__story\"],.arc-other-product [id$=\"__bundle\"],.arc-other-product [id$=\"__reviews\"],.arc-other-product [id$=\"__faq\"],.arc-other-collection [id$=\"__spotlight\"],.arc-other-collection [id$=\"__compare-frames\"]{display:none!important}body [id*=\"__ft-hero\"] h2{font-size:clamp(2.5rem,4.8vw,5rem)!important;line-height:1.02;font-weight:500!important}body [id*=\"__jr-hero\"] h1{font-size:clamp(3rem,7vw,6rem)!important}body [id*=\"__jr-hero\"] [class*=\"tile\"]{border-radius:0!important}</style><style>body [id*=\"__coll-hero\"] h1{font-size:clamp(3rem,6vw,6rem)!important;line-height:1.02}body .qtm-modern__title{font-size:clamp(2.5rem,4vw,3.5rem)!important}body .qtm-modern__main-media,body .q-product-card,body .q-product-card__media{border-radius:0!important;box-shadow:none!important}body [id*=\"__fam-\"] .qtm-layout-column{padding:20px;border:1px solid #cfcfca}body [id*=\"__fam-\"] .qtm-layout-column:has(>h2){border:0}</style>",
    "script_body_close": "<script>(()=>{function anchors(){document.querySelectorAll('.shopify-section[id*=\"__\"]').forEach(s=>{let k=s.id.split('__').pop();for(const id of [k,'arc-'+k]){if(!document.getElementById(id)){const a=document.createElement('span');a.id=id;a.style.cssText='display:block;scroll-margin-top:100px';s.prepend(a)}}});const aliases={sections:'portfolio-heroes',blocks:'ch-blocks',engine:'engine',design:'design',templates:'templates'};for(const [a,k]of Object.entries(aliases)){const target=document.getElementById(k);if(target&&!document.getElementById('arc-'+a)){const el=document.createElement('span');el.id='arc-'+a;target.after(el)}}}anchors();document.addEventListener('shopify:section:load',anchors)})();</script>"
