{%- liquid
  assign qtm_popup_should_render = false

  if settings.popup_enable
    assign qtm_popup_should_render = true
  endif

  if request.design_mode and settings.popup_editor_preview
    assign qtm_popup_should_render = true
  endif

  assign popup_placement = settings.popup_placement | default: 'center'
  assign popup_animation = settings.popup_animation | default: 'fade'
  assign popup_type = settings.popup_type | default: 'newsletter'
  assign popup_trigger = settings.popup_trigger | default: 'delay'
  assign popup_frequency = settings.popup_frequency | default: 'once_per_session'
  assign popup_delay = settings.popup_delay_seconds | default: 1
  assign popup_scroll = settings.popup_scroll_percent | default: 45
-%}

{%- if qtm_popup_should_render -%}
   <style>
  .qtm-popup,
  .qtm-popup *,
  .qtm-popup *::before,
  .qtm-popup *::after {
    box-sizing: border-box;
  }

  .qtm-popup {
    position: fixed !important;
    inset: 0 !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    margin: 0 !important;
    padding: 24px !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: transparent;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .qtm-popup[hidden] {
    display: none !important;
  }

  .qtm-popup.is-visible {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .qtm-popup--center {
    align-items: center !important;
    justify-content: center !important;
  }

  .qtm-popup--top {
    align-items: flex-start !important;
    justify-content: center !important;
  }

  .qtm-popup--bottom {
    align-items: flex-end !important;
    justify-content: center !important;
  }

  .qtm-popup--left {
    align-items: center !important;
    justify-content: flex-start !important;
  }

  .qtm-popup--right {
    align-items: center !important;
    justify-content: flex-end !important;
  }

  .qtm-popup__overlay {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: rgba(15, 23, 42, 0.58) !important;
    cursor: pointer;
    appearance: none;
  }

  .qtm-popup__dialog {
    position: relative !important;
    z-index: 2 !important;
    display: grid !important;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    width: min(920px, calc(100vw - 48px)) !important;
    max-width: 920px !important;
    max-height: calc(100vh - 48px) !important;
    max-height: calc(100dvh - 48px) !important;
    margin: 0 auto !important;
    overflow: hidden !important;
    border: 0 !important;
    border-radius: 24px;
    background: #ffffff;
    color: #111111;
    box-shadow: 0 30px 90px rgba(15, 23, 42, 0.28);
    transform: translateY(18px) scale(0.98);
    transition: transform 220ms ease;
  }

  .qtm-popup.is-visible .qtm-popup__dialog {
    transform: translateY(0) scale(1);
  }

  .qtm-popup__dialog--no-image {
    grid-template-columns: 1fr !important;
    width: min(620px, calc(100vw - 48px)) !important;
    max-width: 620px !important;
  }

  .qtm-popup__close {
    position: absolute !important;
    top: 14px !important;
    right: 14px !important;
    z-index: 4 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 38px !important;
    height: 38px !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 1px solid rgba(17, 17, 17, 0.12) !important;
    border-radius: 999px !important;
    background: #ffffff !important;
    color: #111111 !important;
    font-size: 26px !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    cursor: pointer;
    appearance: none;
  }

  .qtm-popup__close:hover {
    background: #f5f5f5 !important;
  }

  .qtm-popup__media {
    position: relative;
    min-width: 0;
    min-height: 100%;
    background: #f5f5f5;
    overflow: hidden;
  }

  .qtm-popup__image {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 420px;
    object-fit: cover;
  }

  .qtm-popup__content {
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    min-width: 0;
    padding: 52px 44px;
    background: #ffffff;
    color: #111111;
  }

  .qtm-popup__eyebrow {
    margin: 0;
    color: rgba(17, 17, 17, 0.58);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .qtm-popup__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .qtm-popup__text {
    margin: 0;
    color: rgba(17, 17, 17, 0.72);
    font-size: 16px;
    line-height: 1.6;
  }

  .qtm-popup__text p {
    margin: 0;
  }

  .qtm-popup__text p + p {
    margin-top: 10px;
  }

  .qtm-popup__newsletter {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .qtm-popup__newsletter-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .qtm-popup__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .qtm-popup__input {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    height: 48px;
    margin: 0;
    padding: 0 16px;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    font-size: 15px;
    line-height: 1;
    box-shadow: none;
    outline: none;
  }

  .qtm-popup__input:focus {
    border-color: #111111;
    box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.10);
  }

  .qtm-popup__submit,
  .qtm-popup__button {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin: 0;
    padding: 0 22px;
    border: 1px solid #111111;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    appearance: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .qtm-popup__submit:hover,
  .qtm-popup__button:hover {
    transform: translateY(-1px);
  }

  .qtm-popup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .qtm-popup__button--secondary {
    background: #ffffff;
    color: #111111;
  }

  .qtm-popup__message {
    margin: 0;
    color: rgba(17, 17, 17, 0.72);
    font-size: 14px;
    line-height: 1.4;
  }

  .qtm-popup__message--success {
    color: #047857;
  }

  body.qtm-popup-open,
  html.qtm-popup-open {
    overflow: hidden !important;
  }

  @media (max-width: 989px) {
    .qtm-popup__dialog {
      width: min(820px, calc(100vw - 40px)) !important;
      max-height: calc(100vh - 40px) !important;
      max-height: calc(100dvh - 40px) !important;
    }

    .qtm-popup__content {
      padding: 44px 34px;
    }
  }

  @media (max-width: 749px) {
    .qtm-popup {
      align-items: center !important;
      justify-content: center !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      padding: 16px !important;
    }

    .qtm-popup--top,
    .qtm-popup--bottom,
    .qtm-popup--left,
    .qtm-popup--right,
    .qtm-popup--center {
      align-items: center !important;
      justify-content: center !important;
    }

    .qtm-popup__dialog {
      width: min(100%, calc(100vw - 32px)) !important;
      max-width: none !important;
      max-height: calc(100vh - 32px) !important;
      max-height: calc(100dvh - 32px) !important;
      grid-template-columns: 1fr !important;
      overflow-y: auto !important;
      border-radius: 20px;
    }

    .qtm-popup__dialog--no-image {
      width: min(100%, calc(100vw - 32px)) !important;
      max-width: none !important;
    }

    .qtm-popup__image {
      min-height: 220px;
      max-height: 280px;
    }

    .qtm-popup__content {
      padding: 34px 24px 28px;
    }

    .qtm-popup__heading {
      font-size: clamp(26px, 8vw, 36px);
    }

    .qtm-popup__newsletter-row {
      flex-direction: column;
      align-items: stretch;
    }

    .qtm-popup__submit,
    .qtm-popup__button {
      width: 100%;
    }

    .qtm-popup__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .qtm-popup {
      padding: 12px !important;
    }

    .qtm-popup__dialog {
      width: calc(100vw - 24px) !important;
      max-height: calc(100vh - 24px) !important;
      max-height: calc(100dvh - 24px) !important;
      border-radius: 18px;
    }

    .qtm-popup__content {
      padding: 30px 20px 24px;
    }

    .qtm-popup__close {
      top: 10px !important;
      right: 10px !important;
      width: 34px !important;
      height: 34px !important;
      font-size: 24px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qtm-popup,
    .qtm-popup__dialog,
    .qtm-popup__submit,
    .qtm-popup__button {
      transition-duration: 0.01ms !important;
    }
  }
</style>

  <div
    id="QuadratumGlobalPopup"
    class="qtm-popup qtm-popup--{{ popup_placement }} qtm-popup--{{ popup_animation }}"
    data-qtm-popup
    data-popup-enabled="{{ settings.popup_enable }}"
    data-popup-type="{{ popup_type }}"
    data-popup-trigger="{{ popup_trigger }}"
    data-popup-frequency="{{ popup_frequency }}"
    data-popup-delay="{{ popup_delay }}"
    data-popup-scroll="{{ popup_scroll }}"
    data-popup-mobile="{{ settings.popup_show_on_mobile }}"
    data-popup-desktop="{{ settings.popup_show_on_desktop }}"
    data-popup-overlay-close="{{ settings.popup_overlay_click_close }}"
    data-popup-editor-preview="{{ settings.popup_editor_preview }}"
    hidden
    aria-hidden="true"
  >
    <button class="qtm-popup__overlay" type="button" data-qtm-popup-overlay aria-label="Close popup"></button>

    <div
      class="qtm-popup__dialog{% if settings.popup_image == blank %} qtm-popup__dialog--no-image{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="QuadratumGlobalPopupHeading"
      tabindex="-1"
      data-qtm-popup-dialog
    >
      <button class="qtm-popup__close" type="button" data-qtm-popup-close aria-label="Close popup">
        <span aria-hidden="true">&times;</span>
      </button>

      {%- if settings.popup_image != blank -%}
        <div class="qtm-popup__media">
          <img
            class="qtm-popup__image"
            src="{{ settings.popup_image | image_url: width: 1200 }}"
            alt="{{ settings.popup_heading | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="qtm-popup__content">
        {%- if settings.popup_eyebrow != blank -%}
          <p class="qtm-popup__eyebrow">{{ settings.popup_eyebrow }}</p>
        {%- endif -%}

        {%- if settings.popup_heading != blank -%}
          <h2 id="QuadratumGlobalPopupHeading" class="qtm-popup__heading">
            {{ settings.popup_heading }}
          </h2>
        {%- else -%}
          <h2 id="QuadratumGlobalPopupHeading" class="qtm-popup__heading">
            Stay in the loop
          </h2>
        {%- endif -%}

        {%- if settings.popup_text != blank -%}
          <div class="qtm-popup__text">
            {{ settings.popup_text }}
          </div>
        {%- endif -%}

        {%- if settings.popup_show_newsletter_form -%}
          {% form 'customer', class: 'qtm-popup__newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">

            <div class="qtm-popup__newsletter-row">
              <label class="qtm-popup__label" for="QuadratumPopupEmail">
                Email address
              </label>

              <input
                id="QuadratumPopupEmail"
                class="qtm-popup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ settings.popup_newsletter_placeholder | default: 'Email address' | escape }}"
                aria-label="{{ settings.popup_newsletter_placeholder | default: 'Email address' | escape }}"
                required
              >

              <button class="qtm-popup__submit" type="submit">
                {{ settings.popup_newsletter_button_label | default: 'Subscribe' }}
              </button>
            </div>

            {%- if form.posted_successfully? -%}
              <p class="qtm-popup__message qtm-popup__message--success" tabindex="-1">
                Thanks for subscribing.
              </p>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="qtm-popup__message">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {% endform %}
        {%- endif -%}

        {%- if settings.popup_button_label != blank or settings.popup_secondary_label != blank -%}
          <div class="qtm-popup__actions">
            {%- if settings.popup_button_label != blank and settings.popup_button_url != blank -%}
              <a class="qtm-popup__button" href="{{ settings.popup_button_url }}">
                {{ settings.popup_button_label }}
              </a>
            {%- endif -%}

            {%- if settings.popup_secondary_label != blank -%}
              {%- if settings.popup_secondary_url != blank -%}
                <a class="qtm-popup__button qtm-popup__button--secondary" href="{{ settings.popup_secondary_url }}">
                  {{ settings.popup_secondary_label }}
                </a>
              {%- else -%}
                <button class="qtm-popup__button qtm-popup__button--secondary" type="button" data-qtm-popup-close>
                  {{ settings.popup_secondary_label }}
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}