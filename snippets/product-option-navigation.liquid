{% comment %}
  Large catalogs use Shopify's option-value URLs. Native links keep selection,
  inventory, media and price on the server and work without JavaScript.
{% endcomment %}
<div class="q-option-navigation" data-product-option-navigation>
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
  {% for option in product.options_with_values %}
    <fieldset>
      <legend>{{ option.name | escape }}</legend>
      <ul role="list">
        {% for value in option.values %}
          {% capture option_ids %}{% for other_option in product.options_with_values %}{% if other_option.position == option.position %}{{ value.id }}{% else %}{% assign selected_value = other_option.values | where: 'selected', true | first %}{{ selected_value.id }}{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}
          {% assign destination = value.product_url | default: product.url %}
          <li><a href="{{ destination | escape }}?option_values={{ option_ids | strip | url_encode }}{% if template.suffix != blank %}&amp;view={{ template.suffix | url_encode }}{% endif %}" {% if value.selected %}aria-current="true"{% endif %}>
            {% render 'product-option-swatch', value: value %}{{ value.name | default: value | escape }}
          </a></li>
        {% endfor %}
      </ul>
    </fieldset>
  {% endfor %}
  <p>{{ 'products.services.option_navigation' | t }}</p>
  {% if product.selected_or_first_available_variant == blank %}<p role="status">{{ 'products.services.unavailable_combination' | t }}</p>{% endif %}
</div>
