    "everreal_4": {
      "type": "interactive-content-helper-cards",
      "settings": {
        "show_header": true,
        "heading": "Four promises behind every look.",
        "subheading": "<p>They decide what goes on a product page, how we write about a costume and what we will not say.</p>",
        "columns_desktop": 4,
        "columns_tablet": 2,
        "columns_mobile": 1,
        "design_preset": "minimal",
        "hover_style": "none",
        "layout_mode": "grid",
