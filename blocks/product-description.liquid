{%- liquid
  assign block_id = 'product-description-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign description_style = block.settings.description_style | default: 'standard'

  assign description_content = product_context.description

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

{% if description_content != blank or block.settings.hide_when_empty == false %}
  <div
    id="{{ block_id }}"
    class="
      product-description
      product-description--{{ description_style }}
      product-description--width-{{ width }}
      product-description--align-{{ alignment }}
      {% if block.settings.enable_read_more %} product-description--read-more-enabled{% endif %}
      {% unless show_on_desktop %} product-description--hide-desktop{% endunless %}
      {% unless show_on_tablet %} product-description--hide-tablet{% endunless %}
      {% unless show_on_mobile %} product-description--hide-mobile{% endunless %}
      {% if block.settings.animation_style != 'none' %} product-description--animate product-description--animate-{{ block.settings.animation_style }}{% endif %}
    "
    style="
      --product-description-margin-top: {{ block.settings.margin_top }}px;
      --product-description-margin-bottom: {{ block.settings.margin_bottom }}px;
      --product-description-padding: {{ block.settings.padding }}px;
      --product-description-font-size: {{ block.settings.font_size }}px;
      --product-description-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
      --product-description-text-color: {{ block.settings.text_color }};
      --product-description-heading-color: {{ block.settings.heading_color }};
      --product-description-link-color: {{ block.settings.link_color }};
      --product-description-background-color: {{ block.settings.background_color }};
      --product-description-border-color: {{ block.settings.border_color }};
      --product-description-border-width: {{ block.settings.border_width }}px;
      --product-description-border-radius: {{ block.settings.border_radius }}px;
      --product-description-collapsed-height: {{ block.settings.collapsed_height }}px;
    "
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-product-description
    {{ block.shopify_attributes }}
  >
    <style>
      #{{ block_id }} {
        width: 100%;
        margin-top: var(--product-description-margin-top);
        margin-bottom: var(--product-description-margin-bottom);
        padding: var(--product-description-padding);
        color: var(--product-description-text-color);
        background: transparent;
      }

      #{{ block_id }}.product-description--width-auto {
        max-width: none;
      }

      #{{ block_id }}.product-description--width-small {
        max-width: 640px;
      }

      #{{ block_id }}.product-description--width-medium {
        max-width: 820px;
      }

      #{{ block_id }}.product-description--width-large {
        max-width: 1040px;
      }

      #{{ block_id }}.product-description--width-full {
        max-width: none;
      }

      #{{ block_id }}.product-description--align-left {
        margin-left: 0;
        margin-right: auto;
        text-align: left;
      }

      #{{ block_id }}.product-description--align-center {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      #{{ block_id }}.product-description--align-right {
        margin-left: auto;
        margin-right: 0;
        text-align: right;
      }

      #{{ block_id }} .product-description__inner {
        display: grid;
        gap: 12px;
        min-width: 0;
      }

      #{{ block_id }}.product-description--card .product-description__inner,
      #{{ block_id }}.product-description--rich .product-description__inner {
        padding: 20px;
        color: var(--product-description-text-color);
        background: var(--product-description-background-color);
        border: var(--product-description-border-width) solid var(--product-description-border-color);
        border-radius: var(--product-description-border-radius);
      }

      #{{ block_id }} .product-description__heading {
        margin: 0;
        color: var(--product-description-heading-color);
        line-height: 1.2;
      }

      #{{ block_id }} .product-description__content {
        position: relative;
        color: var(--product-description-text-color);
        font-size: var(--product-description-font-size);
        line-height: var(--product-description-line-height);
        overflow-wrap: anywhere;
      }

      #{{ block_id }}.product-description--read-more-enabled:not(.is-expanded) .product-description__content {
        max-height: var(--product-description-collapsed-height);
        overflow: hidden;
      }

      #{{ block_id }}.product-description--read-more-enabled:not(.is-expanded) .product-description__content::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 56px;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0), var(--product-description-background-color));
      }

      #{{ block_id }}.product-description--standard.product-description--read-more-enabled:not(.is-expanded) .product-description__content::after,
      #{{ block_id }}.product-description--minimal.product-description--read-more-enabled:not(.is-expanded) .product-description__content::after {
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #ffffff);
      }

      #{{ block_id }} .product-description__content > *:first-child {
        margin-top: 0;
      }

      #{{ block_id }} .product-description__content > *:last-child {
        margin-bottom: 0;
      }

      #{{ block_id }} .product-description__content h1,
      #{{ block_id }} .product-description__content h2,
      #{{ block_id }} .product-description__content h3,
      #{{ block_id }} .product-description__content h4,
      #{{ block_id }} .product-description__content h5,
      #{{ block_id }} .product-description__content h6 {
        color: var(--product-description-heading-color);
        line-height: 1.2;
      }

      #{{ block_id }} .product-description__content a {
        color: var(--product-description-link-color);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      #{{ block_id }} .product-description__content ul,
      #{{ block_id }} .product-description__content ol {
        padding-left: 1.35em;
      }

      #{{ block_id }} .product-description__content img,
      #{{ block_id }} .product-description__content video,
      #{{ block_id }} .product-description__content iframe {
        max-width: 100%;
        height: auto;
        border-radius: max(calc(var(--product-description-border-radius) - 8px), 0px);
      }

      #{{ block_id }} .product-description__toggle {
        appearance: none;
        justify-self: start;
        width: fit-content;
        padding: 0;
        color: var(--product-description-link-color);
        background: transparent;
        border: 0;
        border-bottom: 1px solid currentColor;
        cursor: pointer;
        line-height: 1.3;
        font: inherit;
      }

      #{{ block_id }}.product-description--align-center .product-description__toggle {
        justify-self: center;
      }

      #{{ block_id }}.product-description--align-right .product-description__toggle {
        justify-self: end;
      }

      #{{ block_id }} .product-description__toggle:hover {
        opacity: 0.72;
      }

      #{{ block_id }} .product-description__toggle:focus-visible {
        outline: 2px solid var(--product-description-link-color);
        outline-offset: 3px;
        border-radius: 4px;
      }

      #{{ block_id }}.product-description--minimal .product-description__content {
        opacity: 0.9;
      }

      #{{ block_id }}.product-description--animate {
        opacity: 0;
        animation-duration: 700ms;
        animation-fill-mode: forwards;
        animation-timing-function: ease;
      }

      #{{ block_id }}.product-description--animate-fade {
        animation-name: productDescriptionFade;
      }

      #{{ block_id }}.product-description--animate-fade_up {
        animation-name: productDescriptionFadeUp;
      }

      #{{ block_id }}.product-description--animate-fade_down {
        animation-name: productDescriptionFadeDown;
      }

      #{{ block_id }}.product-description--animate-fade_left {
        animation-name: productDescriptionFadeLeft;
      }

      #{{ block_id }}.product-description--animate-fade_right {
        animation-name: productDescriptionFadeRight;
      }

      #{{ block_id }}.product-description--animate-zoom {
        animation-name: productDescriptionZoom;
      }

      @keyframes productDescriptionFade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes productDescriptionFadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productDescriptionFadeDown {
        from {
          opacity: 0;
          transform: translateY(-20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes productDescriptionFadeLeft {
        from {
          opacity: 0;
          transform: translateX(20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productDescriptionFadeRight {
        from {
          opacity: 0;
          transform: translateX(-20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes productDescriptionZoom {
        from {
          opacity: 0;
          transform: scale(0.96);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media screen and (min-width: 990px) {
        #{{ block_id }}.product-description--hide-desktop {
          display: none !important;
        }
      }

      @media screen and (min-width: 750px) and (max-width: 989px) {
        #{{ block_id }}.product-description--hide-tablet {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        #{{ block_id }}.product-description--hide-mobile {
          display: none !important;
        }

        #{{ block_id }}.product-description--card .product-description__inner,
        #{{ block_id }}.product-description--rich .product-description__inner {
          padding: 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #{{ block_id }}.product-description--animate {
          opacity: 1;
          animation: none;
          transform: none;
        }
      }
    </style>

    <div class="product-description__inner">
      {% if block.settings.heading != blank %}
        <h3 class="product-description__heading">
          {{ block.settings.heading | escape }}
        </h3>
      {% endif %}

      <div class="product-description__content" data-product-description-content>
        {% if description_content != blank %}
          {{ description_content }}
        {% else %}
          <p>{{ block.settings.empty_text | escape }}</p>
        {% endif %}
      </div>

      {% if block.settings.enable_read_more %}
        <button
          type="button"
          class="product-description__toggle"
          data-product-description-toggle
          aria-expanded="false"
          aria-controls="{{ block_id }}-content"
        >
          {{ block.settings.read_more_label | escape }}
        </button>
      {% endif %}
    </div>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productDescriptionReady === 'true') return;

        root.dataset.productDescriptionReady = 'true';

        const content = root.querySelector('[data-product-description-content]');
        const toggle = root.querySelector('[data-product-description-toggle]');

        if (!content || !toggle) return;

        content.id = `${root.id}-content`;

        const readMoreLabel = {{ block.settings.read_more_label | json }};
        const readLessLabel = {{ block.settings.read_less_label | json }};

        const shouldShowToggle = () => {
          const collapsedHeight = parseInt(getComputedStyle(root).getPropertyValue('--product-description-collapsed-height'), 10) || 0;
          return content.scrollHeight > collapsedHeight + 8;
        };

        const updateToggleVisibility = () => {
          toggle.hidden = !shouldShowToggle();
        };

        toggle.addEventListener('click', () => {
          const expanded = root.classList.toggle('is-expanded');

          toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          toggle.textContent = expanded ? readLessLabel : readMoreLabel;
        });

        updateToggleVisibility();

        window.addEventListener('resize', updateToggleVisibility, { passive: true });
      })();
    </script>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product description",
  "settings": [
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide when description is empty",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty description text",
      "default": "No description available."
    },
    {
      "type": "checkbox",
      "id": "enable_read_more",
      "label": "Enable read more",
      "default": false
    },
    {
      "type": "range",
      "id": "collapsed_height",
      "label": "Collapsed height",
      "min": 80,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "read_less_label",
      "label": "Read less label",
      "default": "Read less"
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "Description style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "card",
          "label": "Card"
        },
        {
          "value": "rich",
          "label": "Rich"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 120,
      "max": 220,
      "step": 5,
      "unit": "%",
      "default": 165
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e5e5e5"
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "fade_down",
          "label": "Fade down"
        },
        {
          "value": "fade_left",
          "label": "Fade left"
        },
        {
          "value": "fade_right",
          "label": "Fade right"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Description",
      "settings": {
        "heading": "Product details",
        "hide_when_empty": true,
        "empty_text": "No description available.",
        "enable_read_more": false,
        "collapsed_height": 180,
        "read_more_label": "Read more",
        "read_less_label": "Read less",
        "description_style": "standard",
        "font_size": 16,
        "line_height": 165,
        "heading_color": "#111111",
        "text_color": "#444444",
        "link_color": "#111111",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 20,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 20,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Short Description",
      "settings": {
        "heading": "Product details",
        "hide_when_empty": true,
        "empty_text": "No description available.",
        "enable_read_more": true,
        "collapsed_height": 160,
        "read_more_label": "Read more",
        "read_less_label": "Read less",
        "description_style": "standard",
        "font_size": 16,
        "line_height": 160,
        "heading_color": "#111111",
        "text_color": "#444444",
        "link_color": "#111111",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 20,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 20,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "none"
      }
    },
    {
      "name": "Rich Description",
      "settings": {
        "heading": "About this product",
        "hide_when_empty": true,
        "empty_text": "No description available.",
        "enable_read_more": false,
        "collapsed_height": 180,
        "read_more_label": "Read more",
        "read_less_label": "Read less",
        "description_style": "rich",
        "font_size": 16,
        "line_height": 170,
        "heading_color": "#111111",
        "text_color": "#444444",
        "link_color": "#111111",
        "background_color": "#ffffff",
        "border_color": "#e5e5e5",
        "border_width": 1,
        "border_radius": 20,
        "width": "auto",
        "alignment": "left",
        "margin_top": 0,
        "margin_bottom": 24,
        "padding": 0,
        "show_on_desktop": true,
        "show_on_tablet": true,
        "show_on_mobile": true,
        "animation_style": "fade_up"
      }
    }
  ]
}
{% endschema %}