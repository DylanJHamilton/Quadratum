{{ 'product-lightbox.css' | asset_url | stylesheet_tag }}
<dialog class="qtm-modern__modal" id="QtmModal-{{ section.id }}" aria-label="{{ 'products.lightbox.label' | t | escape }}" data-zoomed="false">
  <div class="qtm-modern__modal-head">
    <p class="qtm-lightbox__title">{{ product.title | escape }}</p>
    <div class="qtm-lightbox__tools">
      <button type="button" data-qtm-zoom aria-pressed="false" aria-label="{{ 'products.lightbox.zoom' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5M7 10.5h7M10.5 7v7"/></svg></button>
      <button type="button" data-qtm-fullscreen hidden aria-label="{{ 'products.lightbox.fullscreen' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></button>
      <button type="button" class="qtm-modern__modal-close" data-qtm-close-modal aria-label="{{ 'products.lightbox.close' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    </div>
  </div>
  <div class="qtm-modern__modal-body">
    <div class="qtm-lightbox__canvas" tabindex="0" aria-label="{{ 'products.lightbox.canvas' | t | escape }}"><img id="QtmModalImg-{{ section.id }}" {% if featured_src != blank %}src="{{ featured_src }}"{% endif %} width="{{ featured.preview_image.width | default: 800 }}" height="{{ featured.preview_image.height | default: 800 }}" sizes="100vw" alt="{{ featured.alt | default: product.title | escape }}"></div>
    <div class="qtm-modern__modal-nav">
      <button type="button" data-qtm-prev aria-label="{{ 'products.lightbox.previous' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button>
      <button type="button" data-qtm-next aria-label="{{ 'products.lightbox.next' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button>
    </div>
  </div>
  <p class="qtm-lightbox__caption" aria-live="polite"><span data-qtm-image-count></span><span data-qtm-image-caption></span></p>
</dialog>
