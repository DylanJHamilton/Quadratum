{%- liquid
  assign block_id = 'product-accordion-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign layout_style = block.settings.layout_style | default: 'bordered'
  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign metafield_1_content = blank
  assign metafield_2_content = blank
  assign metafield_3_content = blank

  if product_context != blank
    if block.settings.metafield_1_namespace != blank and block.settings.metafield_1_key != blank
      assign metafield_1_content = product_context.metafields[block.settings.metafield_1_namespace][block.settings.metafield_1_key]
    endif

    if block.settings.metafield_2_namespace != blank and block.settings.metafield_2_key != blank
      assign metafield_2_content = product_context.metafields[block.settings.metafield_2_namespace][block.settings.metafield_2_key]
    endif

    if block.settings.metafield_3_namespace != blank and block.settings.metafield_3_key != blank
      assign metafield_3_content = product_context.metafields[block.settings.metafield_3_namespace][block.settings.metafield_3_key]
    endif
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    product-accordion
    product-accordion--{{ layout_style }}
    product-accordion--width-{{ width }}
    product-accordion--align-{{ alignment }}
    {% unless show_on_desktop %} product-accordion--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-accordion--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-accordion--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-accordion--animate product-accordion--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-accordion-margin-top: {{ block.settings.margin_top }}px;
    --product-accordion-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-accordion-padding: {{ block.settings.padding }}px;
    --product-accordion-item-padding: {{ block.settings.item_padding }}px;
    --product-accordion-content-padding: {{ block.settings.content_padding }}px;
    --product-accordion-gap: {{ block.settings.item_gap }}px;
    --product-accordion-radius: {{ block.settings.card_radius }}px;
    --product-accordion-border-width: {{ block.settings.border_width }}px;
    --product-accordion-heading-color: {{ block.settings.heading_color }};
    --product-accordion-text-color: {{ block.settings.text_color }};
    --product-accordion-muted-color: {{ block.settings.muted_color }};
    --product-accordion-background: {{ block.settings.background_color }};
    --product-accordion-card-background: {{ block.settings.card_background_color }};
    --product-accordion-item-background: {{ block.settings.item_background_color }};
    --product-accordion-border-color: {{ block.settings.border_color }};
    --product-accordion-icon-color: {{ block.settings.icon_color }};
    --product-accordion-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-accordion
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-accordion-margin-top);
      margin-bottom: var(--product-accordion-margin-bottom);
      padding: var(--product-accordion-padding);
      color: var(--product-accordion-text-color);
      background: var(--product-accordion-background);
    }

    #{{ block_id }}.product-accordion--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-accordion--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.product-accordion--width-medium {
      max-width: 920px;
    }

    #{{ block_id }}.product-accordion--width-large {
      max-width: 1120px;
    }

    #{{ block_id }}.product-accordion--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-accordion--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-accordion--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-accordion--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: left;
    }

    #{{ block_id }} .product-accordion__inner {
      display: grid;
      gap: var(--product-accordion-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-accordion--card .product-accordion__inner {
      padding: var(--product-accordion-item-padding);
      background: var(--product-accordion-card-background);
      border: var(--product-accordion-border-width) solid var(--product-accordion-border-color);
      border-radius: var(--product-accordion-radius);
    }

    #{{ block_id }} .product-accordion__header {
      display: grid;
      gap: 8px;
      margin-bottom: 6px;
    }

    #{{ block_id }} .product-accordion__eyebrow {
      margin: 0;
      color: var(--product-accordion-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-accordion__heading {
      margin: 0;
      color: var(--product-accordion-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.12;
    }

    #{{ block_id }} .product-accordion__description {
      margin: 0;
      color: var(--product-accordion-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.55;
      opacity: 0.86;
    }

    #{{ block_id }} .product-accordion__items {
      display: grid;
      gap: var(--product-accordion-gap);
      min-width: 0;
    }

    #{{ block_id }} .product-accordion__item {
      overflow: hidden;
      color: var(--product-accordion-text-color);
      background: var(--product-accordion-item-background);
    }

    #{{ block_id }}.product-accordion--minimal .product-accordion__item,
    #{{ block_id }}.product-accordion--flush .product-accordion__item {
      border-bottom: var(--product-accordion-border-width) solid var(--product-accordion-border-color);
    }

    #{{ block_id }}.product-accordion--bordered .product-accordion__item,
    #{{ block_id }}.product-accordion--card .product-accordion__item {
      border: var(--product-accordion-border-width) solid var(--product-accordion-border-color);
      border-radius: max(calc(var(--product-accordion-radius) - 6px), 8px);
    }

    #{{ block_id }} .product-accordion__toggle {
      appearance: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 16px;
      width: 100%;
      min-height: {{ block.settings.toggle_height }}px;
      padding: var(--product-accordion-item-padding);
      color: var(--product-accordion-heading-color);
      background: transparent;
      border: 0;
      cursor: pointer;
      text-align: left;
      font: inherit;
      font-weight: 800;
      line-height: 1.25;
    }

    #{{ block_id }} .product-accordion__toggle:focus-visible {
      outline: 2px solid var(--product-accordion-focus-color);
      outline-offset: -2px;
    }

    #{{ block_id }} .product-accordion__icon {
      position: relative;
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      color: var(--product-accordion-icon-color);
      flex: 0 0 auto;
    }

    #{{ block_id }} .product-accordion__icon::before,
    #{{ block_id }} .product-accordion__icon::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 14px;
      height: 2px;
      background: currentColor;
      border-radius: 999px;
      transform: translate(-50%, -50%);
      transition: transform 180ms ease, opacity 180ms ease;
    }

    #{{ block_id }} .product-accordion__icon::after {
      transform: translate(-50%, -50%) rotate(90deg);
    }

    #{{ block_id }} .product-accordion__toggle[aria-expanded="true"] .product-accordion__icon::after {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(0deg);
    }

    #{{ block_id }} .product-accordion__panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 240ms ease;
    }

    #{{ block_id }} .product-accordion__panel[data-open="true"] {
      grid-template-rows: 1fr;
    }

    #{{ block_id }} .product-accordion__panel-inner {
      min-height: 0;
      overflow: hidden;
    }

    #{{ block_id }} .product-accordion__content {
      padding: 0 var(--product-accordion-content-padding) var(--product-accordion-content-padding);
      color: var(--product-accordion-text-color);
      font-size: {{ block.settings.content_size }}px;
      line-height: 1.65;
    }

    #{{ block_id }}.product-accordion--flush .product-accordion__toggle {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }}.product-accordion--flush .product-accordion__content {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ block_id }} .product-accordion__content p:first-child {
      margin-top: 0;
    }

    #{{ block_id }} .product-accordion__content p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .product-accordion__content ul,
    #{{ block_id }} .product-accordion__content ol {
      padding-left: 1.25em;
    }

    #{{ block_id }} .product-accordion__empty {
      padding: 18px;
      color: var(--product-accordion-text-color);
      background: var(--product-accordion-card-background);
      border: var(--product-accordion-border-width) solid var(--product-accordion-border-color);
      border-radius: var(--product-accordion-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.product-accordion--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-accordion--animate-fade {
      animation-name: productAccordionFade;
    }

    #{{ block_id }}.product-accordion--animate-fade_up {
      animation-name: productAccordionFadeUp;
    }

    #{{ block_id }}.product-accordion--animate-zoom {
      animation-name: productAccordionZoom;
    }

    @keyframes productAccordionFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productAccordionFadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productAccordionZoom {
      from {
        opacity: 0;
        transform: scale(0.98);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-accordion--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-accordion--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-accordion--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-accordion__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .product-accordion__toggle {
        min-height: {{ block.settings.toggle_height_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-accordion--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-accordion__panel,
      #{{ block_id }} .product-accordion__icon::before,
      #{{ block_id }} .product-accordion__icon::after {
        transition: none;
      }
    }
  </style>

  {%- capture accordion_items -%}
    {% if block.settings.show_description_item and product_context.description != blank %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-description"
          aria-expanded="{% if block.settings.open_first_item %}true{% else %}false{% endif %}"
          aria-controls="{{ block_id }}-panel-description"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.description_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-description"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-description"
          data-open="{% if block.settings.open_first_item %}true{% else %}false{% endif %}"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ product_context.description }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_shipping_item %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-shipping"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-shipping"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.shipping_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-shipping"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-shipping"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ block.settings.shipping_text }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_returns_item %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-returns"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-returns"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.returns_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-returns"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-returns"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ block.settings.returns_text }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_care_item %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-care"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-care"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.care_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-care"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-care"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ block.settings.care_text }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_custom_item %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-custom"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-custom"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.custom_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-custom"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-custom"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ block.settings.custom_text }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_metafield_1 and metafield_1_content != blank %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-metafield-1"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-metafield-1"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.metafield_1_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-metafield-1"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-metafield-1"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ metafield_1_content | metafield_tag }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_metafield_2 and metafield_2_content != blank %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-metafield-2"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-metafield-2"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.metafield_2_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-metafield-2"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-metafield-2"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ metafield_2_content | metafield_tag }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_metafield_3 and metafield_3_content != blank %}
      <div class="product-accordion__item">
        <button
          type="button"
          class="product-accordion__toggle"
          id="{{ block_id }}-toggle-metafield-3"
          aria-expanded="false"
          aria-controls="{{ block_id }}-panel-metafield-3"
          data-product-accordion-toggle
        >
          <span>{{ block.settings.metafield_3_title | escape }}</span>
          <span class="product-accordion__icon" aria-hidden="true"></span>
        </button>

        <div
          id="{{ block_id }}-panel-metafield-3"
          class="product-accordion__panel"
          role="region"
          aria-labelledby="{{ block_id }}-toggle-metafield-3"
          data-open="false"
          data-product-accordion-panel
        >
          <div class="product-accordion__panel-inner">
            <div class="product-accordion__content">
              {{ metafield_3_content | metafield_tag }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {%- endcapture -%}

  {% if accordion_items != blank %}
    <div class="product-accordion__inner">
      {% if block.settings.show_header %}
        <div class="product-accordion__header">
          {% if block.settings.eyebrow != blank %}
            <p class="product-accordion__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="product-accordion__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="product-accordion__description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      <div class="product-accordion__items" data-product-accordion-items>
        {{ accordion_items }}
      </div>
    </div>

    <script>
      (() => {
        const root = document.getElementById({{ block_id | json }});

        if (!root || root.dataset.productAccordionReady === 'true') return;

        root.dataset.productAccordionReady = 'true';

        const toggles = Array.from(root.querySelectorAll('[data-product-accordion-toggle]'));
        const allowMultiple = {{ block.settings.allow_multiple_open | json }};

        toggles.forEach((toggle) => {
          toggle.addEventListener('click', () => {
            const panelId = toggle.getAttribute('aria-controls');
            const panel = panelId ? root.querySelector(`#${CSS.escape(panelId)}`) : null;
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

            if (!panel) return;

            if (!allowMultiple && !isExpanded) {
              toggles.forEach((otherToggle) => {
                const otherPanelId = otherToggle.getAttribute('aria-controls');
                const otherPanel = otherPanelId ? root.querySelector(`#${CSS.escape(otherPanelId)}`) : null;

                otherToggle.setAttribute('aria-expanded', 'false');

                if (otherPanel) {
                  otherPanel.dataset.open = 'false';
                }
              });
            }

            toggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
            panel.dataset.open = isExpanded ? 'false' : 'true';
          });
        });
      })();
    </script>
  {% elsif block.settings.show_empty_state %}
    <div class="product-accordion__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product accordion",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Product information"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Important product-specific details, policies, and supporting information."
    },

    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "open_first_item",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple items open",
      "default": false
    },

    {
      "type": "header",
      "content": "Description item"
    },
    {
      "type": "checkbox",
      "id": "show_description_item",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "Description title",
      "default": "Description"
    },

    {
      "type": "header",
      "content": "Shipping item"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_item",
      "label": "Show shipping item",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping title",
      "default": "Shipping"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping text",
