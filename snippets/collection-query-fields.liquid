{%- comment -%}Native GET state. Omit sort or filters when the form owns those controls. New sort/filter submissions omit page.{%- endcomment -%}
{%- if is_search_context -%}
<input type="hidden" name="q" value="{{ terms_q | escape }}"><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last">
{%- endif -%}
{%- if keep_sort and sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ sort_by | escape }}">{%- endif -%}
{%- if keep_filters -%}
{%- for f in filters -%}
{%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name | escape }}" value="{{ v.value | escape }}">{%- endfor -%}
{%- if f.type == 'price_range' -%}
{%- if f.min_value.value != blank -%}<input type="hidden" name="{{ f.min_value.param_name | escape }}" value="{{ f.min_value.value | divided_by: 100.0 }}">{%- endif -%}
{%- if f.max_value.value != blank -%}<input type="hidden" name="{{ f.max_value.param_name | escape }}" value="{{ f.max_value.value | divided_by: 100.0 }}">{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
