{%- liquid
  assign column_tag = block.settings.column_tag | default: 'div'
  assign column_label = block.settings.accessibility_label
  assign column_role = block.settings.column_role | default: 'none'
  assign column_type = block.settings.column_type | default: 'content'
  assign vertical_alignment = block.settings.vertical_alignment | default: 'top'
  assign horizontal_alignment = block.settings.horizontal_alignment | default: 'left'

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<{{ column_tag }}
  id="qtm-product-layout-column-{{ block.id }}"
  class="
    qtm-product-layout-column
    qtm-product-layout-column--{{ column_type }}
    qtm-product-layout-column--valign-{{ vertical_alignment }}
    qtm-product-layout-column--halign-{{ horizontal_alignment }}
    {% if block.settings.full_height %} qtm-product-layout-column--full-height{% endif %}
    {% if block.settings.sticky_column %} qtm-product-block--sticky-target{% endif %}
    {% unless show_desktop %} qtm-product-layout-column--hide-desktop{% endunless %}
    {% unless show_tablet %} qtm-product-layout-column--hide-tablet{% endunless %}
    {% unless show_mobile %} qtm-product-layout-column--hide-mobile{% endunless %}
  "
  {% if column_role != 'none' %}
    role="{{ column_role }}"
  {% endif %}
  {% if column_label != blank %}
    aria-label="{{ column_label | escape }}"
  {% endif %}
  style="
    {% if block.settings.background_gradient != blank %}
      --qtm-product-layout-column-background: {{ block.settings.background_gradient }};
    {% else %}
      --qtm-product-layout-column-background: {{ block.settings.background_color }};
    {% endif %}
    --qtm-product-layout-column-border-width: {{ block.settings.border_width }}px;
    --qtm-product-layout-column-border-color: {{ block.settings.border_color }};
    --qtm-product-layout-column-radius: {{ block.settings.border_radius }}px;
    --qtm-product-layout-column-padding-top: {{ block.settings.padding_top }}px;
    --qtm-product-layout-column-padding-bottom: {{ block.settings.padding_bottom }}px;
    --qtm-product-layout-column-padding-left: {{ block.settings.padding_left }}px;
    --qtm-product-layout-column-padding-right: {{ block.settings.padding_right }}px;
    --qtm-product-layout-column-min-height: {{ block.settings.min_height }}px;
    --qtm-product-layout-column-shadow: {% if block.settings.shadow %}0 18px 60px rgba(0, 0, 0, 0.10){% else %}none{% endif %};
  "
  {{ block.shopify_attributes }}
>
  <style>
    #qtm-product-layout-column-{{ block.id }} {
      min-width: 0;
      min-height: var(--qtm-product-layout-column-min-height, 0);
      background: var(--qtm-product-layout-column-background, transparent);
      border: var(--qtm-product-layout-column-border-width, 0) solid var(--qtm-product-layout-column-border-color, transparent);
      border-radius: var(--qtm-product-layout-column-radius, 0);
      padding-top: var(--qtm-product-layout-column-padding-top, 0);
      padding-bottom: var(--qtm-product-layout-column-padding-bottom, 0);
      padding-left: var(--qtm-product-layout-column-padding-left, 0);
      padding-right: var(--qtm-product-layout-column-padding-right, 0);
      box-shadow: var(--qtm-product-layout-column-shadow, none);
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--full-height {
      height: 100%;
    }

    #qtm-product-layout-column-{{ block.id }} > .qtm-product-layout-column__inner {
      min-width: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--valign-top > .qtm-product-layout-column__inner {
      justify-content: flex-start;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--valign-center > .qtm-product-layout-column__inner {
      justify-content: center;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--valign-bottom > .qtm-product-layout-column__inner {
      justify-content: flex-end;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--valign-stretch > .qtm-product-layout-column__inner {
      justify-content: stretch;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--halign-left > .qtm-product-layout-column__inner {
      align-items: flex-start;
      text-align: left;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--halign-center > .qtm-product-layout-column__inner {
      align-items: center;
      text-align: center;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--halign-right > .qtm-product-layout-column__inner {
      align-items: flex-end;
      text-align: right;
    }

    #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--halign-stretch > .qtm-product-layout-column__inner {
      align-items: stretch;
      text-align: inherit;
    }

    #qtm-product-layout-column-{{ block.id }} .qtm-product-block,
    #qtm-product-layout-column-{{ block.id }} .qtm-content-block {
      width: 100%;
    }

    #qtm-product-layout-column-{{ block.id }} .qtm-product-layout-column__placeholder {
      width: 100%;
      padding: 24px;
      border: 1px dashed rgba(0, 0, 0, 0.25);
      border-radius: 14px;
      text-align: center;
      color: rgba(0, 0, 0, 0.65);
      background: rgba(0, 0, 0, 0.03);
    }

    @media screen and (min-width: 990px) {
      #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #qtm-product-layout-column-{{ block.id }}.qtm-product-layout-column--hide-mobile {
        display: none !important;
      }

      #qtm-product-layout-column-{{ block.id }}.qtm-product-block--sticky-target {
        position: static;
      }
    }
  </style>

  <div class="qtm-product-layout-column__inner">
    {% content_for 'blocks' %}

    {% if request.design_mode and block.blocks.size == 0 %}
      <div class="qtm-product-layout-column__placeholder">
        Add product blocks inside this column.
      </div>
    {% endif %}
  </div>
</{{ column_tag }}>

{% schema %}
{
  "name": "Product layout column",
  "blocks": [
    { "type": "content-accordion" },
    { "type": "content-alert" },
    { "type": "content-anchor-navigation" },
    { "type": "content-badge" },
    { "type": "content-before-after" },
    { "type": "content-benefits-vs-drawbacks" },
    { "type": "content-breadcrumbs" },
    { "type": "content-button" },
    { "type": "content-button-group" },
    { "type": "content-code" },
    { "type": "content-collection-banner" },
    { "type": "content-collection-cards" },
    { "type": "content-collection-carousel" },
    { "type": "content-collection-grid" },
    { "type": "content-comparison-matrix" },
    { "type": "content-contact-form" },
    { "type": "content-contact-info" },
    { "type": "content-content-cards" },
    { "type": "content-divider" },
    { "type": "content-feature-cards" },
    { "type": "content-feature-showcase" },
    { "type": "content-featured-collection" },
    { "type": "content-featured-product" },
    { "type": "content-guarantee-box" },
    { "type": "content-heading" },
    { "type": "content-icon" },
    { "type": "content-icon-list" },
    { "type": "content-image-hotspots" },
    { "type": "content-image-stack" },
    { "type": "content-interactive-feature-map" },
    { "type": "content-link-list" },
    { "type": "content-location-info" },
    { "type": "content-logo-cloud" },
    { "type": "content-lookbook" },
    { "type": "content-marquee" },
    { "type": "content-menu-list" },
    { "type": "content-newsletter" },
    { "type": "content-payment-icons" },
    { "type": "content-press-mentions" },
    { "type": "content-product-carousel" },
    { "type": "content-product-grid" },
    { "type": "content-product-recommendations" },
    { "type": "content-promo-card" },
    { "type": "content-quote" },
    { "type": "content-recently-viewed-products" },
    { "type": "content-review-wall" },
    { "type": "content-rich-text" },
    { "type": "content-scrolling-text" },
    { "type": "content-search-form" },
    { "type": "content-social-links" },
    { "type": "content-spacer" },
    { "type": "content-stats-counter" },
    { "type": "content-store-hours" },
    { "type": "content-table-of-contents" },
    { "type": "content-tabs" },
    { "type": "content-tabs-media" },
    { "type": "content-testimonials" },
    { "type": "content-testimonials-slider" },
    { "type": "content-timeline" },
    { "type": "content-trust-badges" },
    { "type": "content-ugc-showcase" },
    { "type": "custom-custom-form" },
    { "type": "product-accordion" },
    { "type": "product-add-to-cart" },
    { "type": "product-bundle-builder" },
    { "type": "product-comparison-table" },
    { "type": "product-complimentary-products" },
    { "type": "product-countdown" },
    { "type": "product-cross-sell-products" },
    { "type": "product-description" },
    { "type": "product-dynamic-checkout" },
    { "type": "product-feature-grid" },
    { "type": "product-form" },
    { "type": "product-frequently-bought-together" },
    { "type": "product-gallery" },
    { "type": "product-inventory-status" },
    { "type": "product-metafield" },
    { "type": "product-payment-methods" },
    { "type": "product-price" },
    { "type": "product-progress-bar" },
    { "type": "product-quantity-selector" },
    { "type": "product-recently-purchased" },
    { "type": "product-related-products" },
    { "type": "product-share" },
    { "type": "product-shipping-returns" },
    { "type": "product-size-chart" },
    { "type": "product-sku" },
    { "type": "product-specifications" },
    { "type": "product-sticky-add-to-cart" },
    { "type": "product-subtitle" },
    { "type": "product-tabs" },
    { "type": "product-tags" },
    { "type": "product-title" },
    { "type": "product-trust-badges" },
    { "type": "product-type" },
    { "type": "product-upsell-products" },
    { "type": "product-variant-picker" },
    { "type": "product-vendor" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Column"
    },
    {
      "type": "select",
      "id": "column_type",
      "label": "Column type",
      "default": "content",
      "options": [
        {
          "value": "media",
          "label": "Media / gallery"
        },
        {
          "value": "content",
          "label": "Product content"
        },
        {
          "value": "form",
          "label": "Purchase form"
        },
        {
          "value": "trust",
          "label": "Trust / support"
        },
        {
          "value": "story",
          "label": "Story content"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_tag",
      "label": "HTML tag",
      "default": "div",
      "options": [
        {
          "value": "div",
          "label": "Div"
        },
        {
          "value": "section",
          "label": "Section"
        },
        {
          "value": "article",
          "label": "Article"
        },
        {
          "value": "aside",
          "label": "Aside"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_role",
      "label": "ARIA role",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "region",
          "label": "Region"
        },
        {
          "value": "group",
          "label": "Group"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ]
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label"
    },
    {
      "type": "checkbox",
      "id": "sticky_column",
      "label": "Sticky column",
      "default": false
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full height",
      "default": true
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Column style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Column padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product media column",
      "settings": {
        "column_type": "media",
        "vertical_alignment": "top",
        "horizontal_alignment": "stretch",
        "sticky_column": false,
        "full_height": true
      }
    },
    {
      "name": "Product content column",
      "settings": {
        "column_type": "content",
        "vertical_alignment": "top",
        "horizontal_alignment": "stretch",
        "sticky_column": true,
        "full_height": true
      }
    },
    {
      "name": "Product card column",
      "settings": {
        "column_type": "form",
        "vertical_alignment": "top",
        "horizontal_alignment": "stretch",
        "sticky_column": true,
        "full_height": true,
        "background_color": "#ffffff",
        "border_width": 1,
        "border_color": "#e5e5e5",
        "border_radius": 20,
        "shadow": true,
        "padding_top": 32,
        "padding_bottom": 32,
        "padding_left": 32,
        "padding_right": 32
      }
    }
  ]
}
{% endschema %}