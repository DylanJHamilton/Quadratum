{% comment %}
  Card Product: native product tile for Warehouse Merch and Supplier.
  Both hosts load card-product.css. Optional booleans: show_vendor (false),
  show_price (true), show_warehouse_chip (false). A chip labels a curated group.
  card_aspect accepts positive numeric x/y; chip positions: card_top_left,
  card_top_right or below_title. Native product ranges do not imply a sale.
{% endcomment %}
{%- liquid
  assign p = product
  assign show_vendor = show_vendor | default: false
  assign show_price = show_price | default: true, allow_false: true
  assign show_chip = show_warehouse_chip | default: false
  assign chip_label = warehouse_label | default: '' | strip
  assign chip_pos = warehouse_chip_position | default: 'card_top_left'
  unless chip_pos == 'card_top_left' or chip_pos == 'card_top_right' or chip_pos == 'below_title'
    assign chip_pos = 'card_top_left'
  endunless
  assign aspect_parts = card_aspect | default: '4/5' | split: '/'
  assign aspect_x = aspect_parts.first | plus: 0
  assign aspect_y = aspect_parts.last | plus: 0
  if aspect_parts.size != 2 or aspect_x <= 0 or aspect_y <= 0
    assign aspect_x = 4
    assign aspect_y = 5
  endif
  assign tile_image = p.featured_media.preview_image | default: p.featured_image
  assign tile_variant = p.selected_or_first_available_variant | default: p.variants.first
  assign compare_price = ''
  unless p.price_varies
    if tile_variant.price == p.price and tile_variant.compare_at_price > tile_variant.price
      assign compare_price = tile_variant.compare_at_price
    endif
  endunless
-%}
{%- if p != blank and p.url != blank -%}
<a class="q-card-product" href="{{ p.url | escape }}" style="--q-card-product-aspect: {{ aspect_x }}/{{ aspect_y }};">
  {%- if show_chip and chip_label != blank and chip_pos != 'below_title' -%}
    <span class="q-card-product__chip q-card-product__chip--{{ chip_pos }}">{{ chip_label | escape }}</span>
  {%- endif -%}
  <div class="q-card-product__media">
    {%- if tile_image != blank -%}
      {%- assign image_alt = tile_image.alt | default: p.title -%}
      {{ tile_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: image_alt }}
    {%- else -%}
      <div class="q-card-product__placeholder" aria-hidden="true">No image</div>
    {%- endif -%}
  </div>
  <div class="q-card-product__content">
    {%- if show_vendor and p.vendor != blank -%}<div class="q-card-product__vendor">{{ p.vendor | escape }}</div>{%- endif -%}
    <h3 class="q-card-product__title">{{ p.title | escape }}</h3>
    {%- if show_chip and chip_label != blank and chip_pos == 'below_title' -%}
      <span class="q-card-product__chip q-card-product__chip--below">{{ chip_label | escape }}</span>
    {%- endif -%}
    {%- if show_price -%}
      <div class="q-card-product__price">
        {%- if p.price_varies -%}
          <span class="q-card-product__price-current">{{ p.price_min | money }}</span>
          <span class="q-card-product__price-note">to {{ p.price_max | money }}</span>
        {%- else -%}
          <span class="q-card-product__price-current">{{ p.price | money }}</span>
          {%- if compare_price != blank -%}<s class="q-card-product__price-compare">{{ compare_price | money }}</s>{%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</a>
{%- endif -%}
