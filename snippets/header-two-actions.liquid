{%- comment -%}
  Snippet: header-two-actions
  Reusable actions cluster (search button / account / cart) for Quadratum headers.

  Accepts:
    search_mode        - 'inline_static' | 'popup' | 'page' | 'none'
                         (inline_static is rendered by the header layout,
                          not in the actions cluster, so it is ignored here)
    search_placeholder - placeholder string
    show_account       - boolean
    account_display    - 'icon' | 'text' | 'icon_text'
    cart_display       - 'icon' | 'icon_text'
    show_cart_subtotal - boolean

  Usage:
    {% render 'header-two-actions',
      search_mode: header_search_mode,
      show_account: section.settings.show_account,
      account_display: section.settings.account_display,
      cart_display: section.settings.cart_display,
      show_cart_subtotal: section.settings.show_cart_subtotal
    %}
{%- endcomment -%}

<div class="qtm-hm-actions">
  {%- if search_mode == 'popup' or search_mode == 'page' -%}
    {% render 'header-two-search',
      mode: search_mode,
      placeholder: search_placeholder
    %}
  {%- endif -%}

  {%- if show_account -%}
    {% render 'header-two-account', display: account_display %}
  {%- endif -%}

  {% render 'header-two-cart',
    display: cart_display,
    show_subtotal: show_cart_subtotal
  %}
</div>