{%- liquid
  assign qtm_product = product
  assign qtm_current_variant = product.selected_or_first_available_variant

  assign section_width = section.settings.section_width | default: 'contained'
  assign section_label = section.settings.accessibility_label | default: 'Product layout section'
  assign section_tag = section.settings.section_tag | default: 'section'

  assign show_desktop = section.settings.show_desktop
  assign show_tablet = section.settings.show_tablet
  assign show_mobile = section.settings.show_mobile
-%}

<{{ section_tag }}
  id="qtm-product-block-section-{{ section.id }}"
  class="
    qtm-product-block-section
    qtm-product-block-section--{{ section_width }}
    qtm-product-block-section--media-{{ section.settings.product_media_priority }}
    qtm-product-block-section--mobile-{{ section.settings.mobile_product_layout }}
    qtm-product-block-section--mobile-grid-{{ section.settings.mobile_behavior }}
    {% if section.settings.enable_sticky_add_to_cart %} qtm-product-block-section--sticky-atc{% endif %}
    {% unless show_desktop %} qtm-product-block-section--hide-desktop{% endunless %}
    {% unless show_tablet %} qtm-product-block-section--hide-tablet{% endunless %}
    {% unless show_mobile %} qtm-product-block-section--hide-mobile{% endunless %}
  "
  aria-label="{{ section_label | escape }}"
  {% if qtm_product != blank %}
    data-product-id="{{ qtm_product.id }}"
    data-product-handle="{{ qtm_product.handle }}"
    {% if qtm_current_variant != blank %}
      data-current-variant-id="{{ qtm_current_variant.id }}"
    {% endif %}
  {% endif %}
  style="
    --qtm-product-block-section-max-width: {{ section.settings.max_width }}px;
    --qtm-product-block-section-section-gap: {{ section.settings.section_gap }}px;
    --qtm-product-block-section-row-gap: {{ section.settings.row_gap }}px;
    --qtm-product-block-section-column-gap: {{ section.settings.column_gap }}px;
    --qtm-product-block-section-padding-top: {{ section.settings.padding_top }}px;
    --qtm-product-block-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --qtm-product-block-section-padding-left: {{ section.settings.padding_left }}px;
    --qtm-product-block-section-padding-right: {{ section.settings.padding_right }}px;
    --qtm-product-block-section-background-color: {{ section.settings.background_color }};
    {% if section.settings.background_gradient != blank %}
      --qtm-product-block-section-background: {{ section.settings.background_gradient }};
    {% else %}
      --qtm-product-block-section-background: {{ section.settings.background_color }};
    {% endif %}
    --qtm-product-block-section-overlay-color: {{ section.settings.overlay_color }};
    --qtm-product-block-section-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --qtm-product-block-section-row-align: {{ section.settings.vertical_alignment }};

    --qtm-product-block-column-background: {{ section.settings.column_background }};
    --qtm-product-block-column-border-width: {{ section.settings.column_border_width }}px;
    --qtm-product-block-column-border-color: {{ section.settings.column_border_color }};
    --qtm-product-block-column-radius: {{ section.settings.column_border_radius }}px;
    --qtm-product-block-column-padding: {{ section.settings.column_padding }}px;
    --qtm-product-block-column-shadow: {% if section.settings.column_shadow %}0 18px 60px rgba(0, 0, 0, 0.10){% else %}none{% endif %};

    --qtm-product-sticky-offset: {{ section.settings.sticky_offset }}px;
  "
>
  <style>
    #qtm-product-block-section-{{ section.id }} {
      position: relative;
      overflow: hidden;
      background: var(--qtm-product-block-section-background, transparent);
      padding-top: var(--qtm-product-block-section-padding-top);
      padding-bottom: var(--qtm-product-block-section-padding-bottom);
      padding-left: var(--qtm-product-block-section-padding-left);
      padding-right: var(--qtm-product-block-section-padding-right);
    }

    #qtm-product-block-section-{{ section.id }}::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: var(--qtm-product-block-section-overlay-color, transparent);
      opacity: var(--qtm-product-block-section-overlay-opacity, 0);
      z-index: 0;
    }

    {% if section.settings.background_image != blank %}
      #qtm-product-block-section-{{ section.id }} {
        background-image:
          linear-gradient(
            rgba(0, 0, 0, 0),
            rgba(0, 0, 0, 0)
          ),
          url({{ section.settings.background_image | image_url: width: 2400 }});
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
    {% endif %}

    #qtm-product-block-section-{{ section.id }} > .qtm-product-block-section__inner {
      position: relative;
      z-index: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--qtm-product-block-section-section-gap);
      margin-left: auto;
      margin-right: auto;
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--contained > .qtm-product-block-section__inner {
      max-width: min(var(--qtm-product-block-section-max-width), calc(100vw - 32px));
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--wide > .qtm-product-block-section__inner {
      max-width: min(var(--qtm-product-block-section-max-width), calc(100vw - 48px));
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--full > .qtm-product-block-section__inner {
      max-width: none;
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row {
      display: grid;
      gap: var(--qtm-product-block-section-column-gap);
      row-gap: var(--qtm-product-block-section-row-gap);
      align-items: var(--qtm-product-block-section-row-align);
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-1 {
      grid-template-columns: minmax(0, 1fr);
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-6 {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-column {
      min-width: 0;
      background: var(--qtm-product-block-column-background, transparent);
      border: var(--qtm-product-block-column-border-width, 0) solid var(--qtm-product-block-column-border-color, transparent);
      border-radius: var(--qtm-product-block-column-radius, 0);
      padding: var(--qtm-product-block-column-padding, 0);
      box-shadow: var(--qtm-product-block-column-shadow, none);
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-layout-column__inner {
      min-width: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--sticky-atc .qtm-product-block--sticky-target {
      position: sticky;
      top: var(--qtm-product-sticky-offset, 24px);
      z-index: 4;
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--media-gallery-first .qtm-product-layout-column--media {
      order: -1;
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--media-content-first .qtm-product-layout-column--content {
      order: -1;
    }

    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--media-balanced .qtm-product-layout-column--media,
    #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--media-balanced .qtm-product-layout-column--content {
      order: initial;
    }

    @media screen and (min-width: 990px) {
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--hide-tablet {
        display: none !important;
      }

      #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-4,
      #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-5,
      #qtm-product-block-section-{{ section.id }} .qtm-product-layout-row--columns-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--hide-mobile {
        display: none !important;
      }

      #qtm-product-block-section-{{ section.id }} {
        padding-left: min(var(--qtm-product-block-section-padding-left), 20px);
        padding-right: min(var(--qtm-product-block-section-padding-right), 20px);
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row--columns-1,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row--columns-2,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row--columns-3,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row--columns-4,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row--columns-5,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-stack .qtm-product-layout-row--columns-6 {
        grid-template-columns: minmax(0, 1fr);
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-scroll .qtm-product-layout-row {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(78%, 1fr);
        grid-template-columns: none;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 8px;
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-scroll .qtm-product-layout-column {
        scroll-snap-align: start;
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-keep-grid .qtm-product-layout-row--columns-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-keep-grid .qtm-product-layout-row--columns-3,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-keep-grid .qtm-product-layout-row--columns-4,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-keep-grid .qtm-product-layout-row--columns-5,
      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-keep-grid .qtm-product-layout-row--columns-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-product-gallery-first .qtm-product-layout-column--media {
        order: -2;
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-product-gallery-first .qtm-product-layout-column--content {
        order: 0;
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-product-content-first .qtm-product-layout-column--content {
        order: -2;
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--mobile-product-content-first .qtm-product-layout-column--media {
        order: 0;
      }

      #qtm-product-block-section-{{ section.id }}.qtm-product-block-section--sticky-atc .qtm-product-block--sticky-target {
        position: static;
      }
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-block-section__placeholder {
      padding: 32px;
      border: 1px dashed rgba(0, 0, 0, 0.25);
      border-radius: 16px;
      text-align: center;
      color: rgba(0, 0, 0, 0.65);
      background: rgba(0, 0, 0, 0.03);
    }

    #qtm-product-block-section-{{ section.id }} .qtm-product-block-section__context-warning {
      padding: 20px;
      border: 1px solid rgba(180, 120, 0, 0.35);
      border-radius: 16px;
      background: rgba(255, 190, 80, 0.12);
      color: rgba(60, 40, 0, 0.9);
    }
  </style>

  <div class="qtm-product-block-section__inner">
    {% if qtm_product == blank and request.design_mode %}
      <div class="qtm-product-block-section__context-warning">
        This section is designed for product templates. Product blocks require product context.
      </div>
    {% endif %}

    {% content_for 'blocks' %}

    {% if request.design_mode and section.blocks.size == 0 %}
      <div class="qtm-product-block-section__placeholder">
        Add Product Blocks to begin building this product layout.
      </div>
    {% endif %}
  </div>
</{{ section_tag }}>

{% schema %}
{
  "name": "Product block section",
  "tag": "section",
  "class": "section qtm-product-section-host",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product layout section"
    },
    {
      "type": "select",
      "id": "section_tag",
      "label": "HTML tag",
      "default": "section",
      "options": [
        {
          "value": "section",
          "label": "Section"
        },
        {
          "value": "div",
          "label": "Div"
        },
        {
          "value": "article",
          "label": "Article"
        },
        {
          "value": "aside",
          "label": "Aside"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "contained",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 720,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Section gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_behavior",
      "label": "Mobile row behavior",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "Stack"
        },
        {
          "value": "scroll",
          "label": "Scroll"
        },
        {
          "value": "keep-grid",
          "label": "Keep grid"
        }
      ]
    },
    {
      "type": "header",
      "content": "Product behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "Enable sticky add to cart support",
      "default": true,
      "info": "Product blocks can opt into sticky behavior using the sticky target class."
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky offset",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "product_media_priority",
      "label": "Product media priority",
      "default": "gallery-first",
      "options": [
        {
          "value": "gallery-first",
          "label": "Gallery first"
        },
        {
          "value": "content-first",
          "label": "Content first"
        },
        {
          "value": "balanced",
          "label": "Balanced"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_product_layout",
      "label": "Mobile product layout",
      "default": "gallery-first",
      "options": [
        {
          "value": "stack",
          "label": "Stack"
        },
        {
          "value": "gallery-first",
          "label": "Gallery first"
        },
        {
          "value": "content-first",
          "label": "Content first"
        }
      ]
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Default column styling"
    },
    {
      "type": "color",
      "id": "column_background",
      "label": "Column background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "column_border_width",
      "label": "Column border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "column_border_color",
      "label": "Column border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "column_border_radius",
      "label": "Column border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "column_padding",
      "label": "Column padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "column_shadow",
      "label": "Column shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tablet",
      "label": "Show on tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product block section"
    }
  ]
}
{% endschema %}