    "everreal_process": {
      "type": "interactive-content-helper-cards",
      "settings": {
        "show_header": true,
        "heading": "From a saved idea to a complete look.",
        "subheading": "<p>A little structure leaves more room for imagination.</p>",
        "columns_desktop": 4,
        "columns_tablet": 2,
        "columns_mobile": 1,
        "design_preset": "minimal",
        "hover_style": "none",
        "layout_mode": "grid",
        "card_variant": "icon_card",
        "content_align": "left",
        "card_radius": 14,
        "use_custom_colors": true,
        "color_bg": "#F5F0FB",
        "color_text": "#202039",
        "color_muted": "#514E6E",
        "color_accent": "#7047BD",
        "color_surface": "#FFFFFF",
        "color_border": "#E3DAF2"
      },
      "blocks": {
        "er_1": {
          "type": "card",
          "settings": {
            "title": "01 / Find your world",
            "body": "<p>Start with a character, a mood or the event on your calendar. Our worlds bring related costumes together so you can explore without knowing a product name.</p>",
            "icon": "lucide-list-checks",
            "cta_label": "Explore the worlds",
            "cta_url": "/collections/everreal-all",
            "badge": "",
            "subtitle": ""
          }
        },
        "er_2": {
          "type": "card",
          "settings": {
            "title": "02 / Read the details",
            "body": "<p>Look at the included pieces, available size labels and photographs together. If a measurement is missing, ask before choosing a size.</p>",
            "icon": "lucide-users",
            "cta_label": "Ask about fit",
            "cta_url": "/pages/everreal-contact",
            "badge": "",
            "subtitle": ""
          }
        },
        "er_3": {
          "type": "card",
          "settings": {
            "title": "03 / Make it yours",
            "body": "<p>Choose a wig or finishing piece when you want one. Accessories are listed separately so you can tell the difference between a complete set and a styled photograph.</p>",
            "icon": "lucide-sparkles",
            "cta_label": "Find finishing pieces",
            "cta_url": "/collections/everreal-wigs-makeup",
            "badge": "",
            "subtitle": ""
          }
        },
        "er_4": {
          "type": "card",
          "settings": {
            "title": "04 / Plan your moment",
            "body": "<p>Give yourself time for a first try-on and a packing check. For group looks, collect everyone’s choices before sending a styling enquiry.</p>",
            "icon": "lucide-shield-check",
            "cta_label": "Plan with a stylist",
            "cta_url": "/pages/everreal-styling-help",
            "badge": "",
            "subtitle": ""
          }
        }
      },
      "block_order": [
        "er_1",
        "er_2",
        "er_3",
        "er_4"
      ]
    },
