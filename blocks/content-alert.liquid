        "heading": "Success",
        "message": "<p>Your offer, product note, or confirmation message can be placed here.</p>",
        "alert_layout": "inline",
        "show_icon": true,
        "icon_text": "✓",
        "max_width": 880,
        "alert_padding": 20,
