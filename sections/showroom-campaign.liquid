{{ 'showroom-campaign.css' | asset_url | stylesheet_tag }}
<script src="{{ 'showroom-motion.js' | asset_url }}" defer></script>
<section class="q-campaign" aria-labelledby="Campaign-{{ section.id }}">
  <div class="q-campaign__hero">
    <div class="q-campaign__copy">
      <p class="q-campaign__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="Campaign-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      <div class="q-campaign__intro rte">{{ section.settings.body }}</div>
      <a class="q-campaign__button" href="{{ section.settings.link | escape }}">{{ section.settings.label | escape }} <span aria-hidden="true">↗</span></a>
      {% if section.settings.secondary_link != blank %}<a class="q-campaign__textlink" href="{{ section.settings.secondary_link | escape }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
      {% if section.settings.note != blank %}<p class="q-campaign__note">{{ section.settings.note | escape }}</p>{% endif %}
    </div>
    <div class="q-campaign__visual">
      {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 900px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'q-campaign__image' }}{% endif %}
      {% assign spotlight = section.settings.spotlight %}
      {% if spotlight != blank %}<a class="q-campaign__spotlight" href="{{ spotlight.url }}">{% if spotlight.featured_image %}{{ spotlight.featured_image | image_url: width: 160 | image_tag: loading: 'eager', widths: '80, 160', sizes: '72px' }}{% endif %}<span><small>IN THE FRAME</small><strong>{{ spotlight.title | escape }}</strong><span>{{ spotlight.price | money }}</span></span><span aria-hidden="true">↗</span></a>{% endif %}
      <span class="q-campaign__edition">{{ section.settings.edition | escape }}</span>
    </div>
  </div>
  <div class="q-campaign__edit">
    <header class="q-campaign__edit-header q-reveal"><div><p class="q-campaign__eyebrow">CONSIDERED OBJECTS. EVERYDAY POSSIBILITIES.</p><h2>{{ section.settings.edit_heading | escape }}</h2></div><a class="q-campaign__textlink" href="{{ routes.all_products_collection_url }}">Explore the catalog ↗</a></header>
    <div class="q-campaign__products">
      {% for block in section.blocks %}{% assign item = block.settings.product %}{% if item != blank %}<article class="q-campaign__product q-reveal" {{ block.shopify_attributes }}>
        <a class="q-campaign__product-image" href="{{ item.url }}" aria-label="Explore {{ item.title | escape }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240, 400, 700', sizes: '(min-width: 900px) 25vw, 50vw' }}{% endif %}{% if item.images.size > 1 %}{{ item.images[1] | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240, 400, 700', sizes: '(min-width: 900px) 25vw, 50vw', class: 'q-campaign__alternate', alt: '' }}{% endif %}</a>
        <div class="q-campaign__product-meta"><p class="q-campaign__eyebrow">{{ block.settings.category | escape }}</p><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3><p>{% if item.price_varies %}From {% endif %}{{ item.price | money }}</p><a class="q-campaign__textlink" href="{{ item.url }}">{% if item.available %}Explore & choose options{% else %}View product · Sold out{% endif %} <span aria-hidden="true">↗</span></a></div>
      </article>{% endif %}{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Showroom campaign","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EVERYDAY EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Make room for better everyday."},{"type":"richtext","id":"body","label":"Description"},{"type":"image_picker","id":"image","label":"Campaign photograph"},{"type":"product","id":"spotlight","label":"Featured product"},{"type":"text","id":"label","label":"Button label","default":"Explore the edit"},{"type":"url","id":"link","label":"Button link"},{"type":"text","id":"edit_heading","label":"Product row heading","default":"Small details. Daily difference."},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"secondary_label","label":"Secondary link label","default":"Explore the collection"},{"type":"text","id":"note","label":"Supporting note","default":"Considered objects for your everyday."},{"type":"text","id":"edition","label":"Image caption","default":"THE EVERYDAY EDIT / 01"}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"category","label":"Category"}]}],"max_blocks":4,"presets":[{"name":"Showroom campaign"}]}
{% endschema %}
