{% assign social_count = 0 %}{% for block in section.blocks %}{% if block.settings.youtube_url != blank and block.settings.youtube_url != '#' %}{% assign social_count = social_count | plus: 1 %}{% endif %}{% endfor %}
{% assign social_visible = false %}{% if social_count > 0 %}{% assign social_visible = true %}{% endif %}
{% if section.settings.data_source_mode != 'manual' %}{% assign social_visible = false %}{% endif %}
{% if request.design_mode %}{% assign social_visible = true %}{% endif %}
{% if social_visible %}
{%- liquid
  assign s = section.settings
  assign cols_d = s.columns_desktop | default: 3
  assign cols_m = s.columns_mobile | default: 1
  assign gap = s.card_gap | default: 20
  assign ratio = s.video_ratio | default: '16:9'
  assign ratio_class = ratio | replace: ':', '-'

  assign modal_ratio = '16 / 9'
  case ratio
    when '1:1'
      assign modal_ratio = '1 / 1'
    when '9:16'
      assign modal_ratio = '9 / 16'
    when '4:5'
      assign modal_ratio = '4 / 5'
    else
      assign modal_ratio = '16 / 9'
  endcase
-%}

{%- if s.enable_section or request.design_mode -%}
<section
  id="social-media-youtube-grid-{{ section.id }}"
  class="q-section q-social-youtube-grid" data-source="{{ s.data_source_mode | escape }}" data-playlist-handle="{{ s.playlist_handle | escape }}"
  aria-label="{{ s.aria_label | escape }}"
>
  <div class="q-social-youtube-grid__inner">
    {%- assign align = s.align | default: 'center' -%}

    <header class="q-social-youtube-grid__header q-align-{{ align }}">
      {%- if s.kicker != blank -%}
        <p class="q-social-youtube-grid__kicker">{{ s.kicker | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="q-social-youtube-grid__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="q-social-youtube-grid__body">
          {{ s.body | escape | newline_to_br }}
        </div>
      {%- endif -%}
    </header>

    {%- assign data_source_mode = s.data_source_mode | default: 'manual' -%}

    {%- if data_source_mode == 'manual' -%}
      {%- if section.blocks.size > 0 -%}
        <div
          class="q-video-grid q-video-grid--ratio-{{ ratio_class }}"
          style="--q-video-grid-gap: {{ gap }}px; --q-video-grid-cols-desktop: {{ cols_d }}; --q-video-grid-cols-mobile: {{ cols_m }};"
        >
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign url = b.youtube_url -%}
            {%- assign has_url = false -%}
            {%- if url != blank and url != '#' -%}
              {%- assign has_url = true -%}
            {%- endif -%}

            {%- assign card_style = s.card_style | default: 'surface' -%}
            {%- assign link_aria = b.aria_label | default: 'Watch video on YouTube' -%}
            {%- assign thumb_alt = b.title | default: 'YouTube video thumbnail' -%}

            {% capture youtube_id %}{% render 'social-media-youtube-id', url: url %}{% endcapture %}
            {% if has_url or request.design_mode %}<article class="q-video-card q-video-card--{{ card_style }}" {{ block.shopify_attributes }}>
              {%- if has_url -%}
                <a
                  class="q-video-card__link"
                  href="{{ url | escape }}"
                  aria-label="{{ link_aria | escape }}"
                  data-q-yt-trigger="{{ section.id }}"
                  data-q-yt-id="{{ youtube_id | strip }}"
                  {% if s.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  <div class="q-video-card__media q-ratio q-ratio--{{ ratio_class }}">
                    {%- if b.thumbnail_override != blank -%}
                      {{ b.thumbnail_override | image_url: width: 960 | image_tag: loading: 'lazy', decoding: 'async', alt: thumb_alt, class: 'q-video-card__thumb' }}
                    {%- else -%}
                      <img
                        class="q-video-card__thumb q-video-card__thumb--auto"
                        src="{% if youtube_id != blank %}https://i.ytimg.com/vi/{{ youtube_id | strip }}/hqdefault.jpg{% else %}data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=={% endif %}" width="480" height="360"
                        loading="lazy"
                        decoding="async"
                        alt="{{ thumb_alt | escape }}"
                        data-q-yt-thumb="1"
                        data-q-yt-id="{{ youtube_id | strip }}"
                      >
                    {%- endif -%}

                    <span class="q-video-card__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                    </span>

                    {%- if s.show_platform_badge -%}
                      <span class="q-video-card__badge" aria-hidden="true" title="YouTube">
                        <svg viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true">
                          <path d="M23.5 6.2s-.2-1.7-.9-2.4c-.9-.9-1.9-.9-2.4-1C16.9 2.5 12 2.5 12 2.5h0s-4.9 0-8.2.3c-.4 0-1.4.1-2.4 1C.7 4.5.5 6.2.5 6.2S.2 8.1.2 9.9v1.7c0 1.8.3 3.7.3 3.7s.2 1.7.9 2.4c.9.9 2.1.9 2.6 1 1.9.2 8 .3 8 .3s4.9 0 8.2-.3c.4 0 1.4-.1 2.4-1 .7-.7.9-2.4.9-2.4s.3-1.9.3-3.7V9.9c0-1.8-.3-3.7-.3-3.7zM9.7 14.8V7.9l6.3 3.5-6.3 3.4z"></path>
                        </svg>
                      </span>
                    {%- endif -%}

                    {%- if b.duration_label != blank -%}
                      <span class="q-video-card__duration">{{ b.duration_label | escape }}</span>
                    {%- endif -%}
                  </div>

                  <div class="q-video-card__body">
                    {%- if s.show_tag and b.tag != blank -%}
                      <p class="q-video-card__tag">{{ b.tag | escape }}</p>
                    {%- endif -%}

                    <h3 class="q-video-card__title">{{ b.title | escape }}</h3>

                    {%- if s.show_description and b.description != blank -%}
                      <p class="q-video-card__description">{{ b.description | escape }}</p>
                    {%- endif -%}

                    {%- if s.show_watch_label -%}
                      <span class="q-video-card__watch">Watch on YouTube</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- else -%}
                <div class="q-video-card__placeholder" aria-hidden="true">
                  <div class="q-video-card__media q-ratio q-ratio--{{ ratio_class }}">
                    <span class="q-video-card__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                    </span>
                  </div>
                  <div class="q-video-card__body">
                    <h3 class="q-video-card__title">{{ b.title | escape }}</h3>
                  </div>
                </div>
              {%- endif -%}
            </article>{% endif %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="q-video-grid__placeholder">
          <p>Playlist mode is enabled. The theme does not fetch a playlist. Use Manual blocks or configure an external integration.</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <dialog class="q-yt-modal" id="q-yt-modal-{{ section.id }}" data-social-youtube-dialog aria-label="YouTube video player" style="--q-yt-modal-aspect: {{ modal_ratio }};">
    <div class="q-yt-modal__dialog">
      <button type="button" class="q-yt-modal__close" aria-label="Close video" data-q-yt-close><span aria-hidden="true">×</span></button>
      <div class="q-yt-modal__player" data-q-yt-player></div>
      <p class="q-yt-modal__fallback">If playback is unavailable, <a class="q-yt-modal__fallback-link" data-q-yt-fallback>watch on YouTube</a>.</p>
    </div>
  </dialog>
  <script src="{{ 'social-media-youtube.js' | asset_url }}" defer></script>

  <style>
    /* scoped, minimal, token-friendly */
    #social-media-youtube-grid-{{ section.id }} .q-social-youtube-grid__inner {
      max-width: var(--container-lg, 1152px);
      margin: 0 auto;
      padding: var(--q-section-pad-y, 48px) var(--q-section-pad-x, 20px);
    }
    #social-media-youtube-grid-{{ section.id }} .q-social-youtube-grid__header { margin-bottom: 20px; }
    #social-media-youtube-grid-{{ section.id }} .q-align-left { text-align: left; }
    #social-media-youtube-grid-{{ section.id }} .q-align-center { text-align: center; }

    #social-media-youtube-grid-{{ section.id }} .q-social-youtube-grid__kicker {
      margin: 0 0 6px;
      font-size: 0.9rem;
      opacity: 0.75;
    }
    #social-media-youtube-grid-{{ section.id }} .q-social-youtube-grid__heading {
      margin: 0;
      font-size: 1.8rem;
      line-height: 1.15;
    }
    #social-media-youtube-grid-{{ section.id }} .q-social-youtube-grid__body {
      margin-top: 10px;
      opacity: 0.9;
    }

    #social-media-youtube-grid-{{ section.id }} .q-video-grid {
      display: grid;
      gap: var(--q-video-grid-gap, 20px);
      grid-template-columns: repeat(var(--q-video-grid-cols-desktop, 3), minmax(0, 1fr));
    }
    @media (max-width: 767px) {
      #social-media-youtube-grid-{{ section.id }} .q-video-grid {
        grid-template-columns: repeat(var(--q-video-grid-cols-mobile, 1), minmax(0, 1fr));
      }
    }

    #social-media-youtube-grid-{{ section.id }} .q-video-card {
      border-radius: var(--q-radius, 16px);
      overflow: hidden;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card--surface {
      background: var(--c-surface, rgba(0,0,0,0.03));
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card--bordered {
      border: 1px solid rgba(0,0,0,0.12);
      background: transparent;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card--minimal {
      background: transparent;
    }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__link,
    #social-media-youtube-grid-{{ section.id }} .q-video-card__placeholder {
      display: grid;
      grid-template-rows: auto 1fr;
      text-decoration: none;
      color: inherit;
    }

    #social-media-youtube-grid-{{ section.id }} .q-ratio { position: relative; width: 100%; }
    #social-media-youtube-grid-{{ section.id }} .q-ratio--16-9 { aspect-ratio: 16 / 9; }
    #social-media-youtube-grid-{{ section.id }} .q-ratio--9-16 { aspect-ratio: 9 / 16; }
    #social-media-youtube-grid-{{ section.id }} .q-ratio--4-5  { aspect-ratio: 4 / 5; }
    #social-media-youtube-grid-{{ section.id }} .q-ratio--1-1  { aspect-ratio: 1 / 1; }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__media {
      position: relative;
      background: rgba(0,0,0,0.06);
      overflow: hidden;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__thumb {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__play {
      position: absolute;
      inset: auto auto 12px 12px;
      width: 40px;
      height: 40px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      background: rgba(0,0,0,0.55);
      color: #fff;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__play svg { fill: currentColor; transform: translateX(1px); }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__badge {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 34px;
      height: 34px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      background: rgba(0,0,0,0.6);
      color: #fff;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__badge svg { fill: currentColor; }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__duration {
      position: absolute;
      bottom: 12px;
      right: 12px;
      font-size: 0.85rem;
      padding: 4px 8px;
      border-radius: 10px;
      background: rgba(0,0,0,0.65);
      color: #fff;
    }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__body {
      padding: 14px 14px 16px;
      display: grid;
      gap: 8px;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__tag {
      margin: 0;
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      opacity: 0.7;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__title {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.25;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__description {
      margin: 0;
      opacity: 0.85;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    #social-media-youtube-grid-{{ section.id }} .q-video-card__watch {
      margin-top: 2px;
      font-weight: 600;
      text-decoration: underline;
    }

    #social-media-youtube-grid-{{ section.id }} .q-video-card__link:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: -3px;
    }

    /* Modal */
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal[hidden] { display: none; }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: grid;
      place-items: center;
      padding: 18px;
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.6);
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__dialog {
      position: relative;
      width: min(960px, 100%);
      border-radius: 18px;
      background: #fff;
      color: #111;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__close {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 40px;
      height: 40px;
      border: 0;
      border-radius: 999px;
      background: rgba(0,0,0,0.65);
      color: #fff;
      cursor: pointer;
      z-index: 2;
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__close:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__player {
      width: 100%;
      aspect-ratio: var(--q-yt-modal-aspect, 16 / 9);
      background: #000;
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__player iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__fallback {
      margin: 0;
      padding: 12px 16px 16px;
      font-size: 0.95rem;
      opacity: 0.9;
    }
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__fallback-link {
      font-weight: 700;
      text-decoration: underline;
    }



    #social-media-youtube-grid-{{ section.id }} .q-yt-modal:not([open]){display:none}
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal{width:min(960px,calc(100vw - 32px));max-height:calc(100dvh - 32px);margin:auto;padding:0;border:0;overflow:auto;display:block;background:#fff;border-radius:18px}
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal::backdrop{background:rgba(0,0,0,.65)}
    #social-media-youtube-grid-{{ section.id }} .q-yt-modal__player{min-height:200px}
  </style>
</section>
{%- endif -%}


<style>
#social-media-youtube-grid-{{ section.id }}{font-family:var(--font-body);overflow-wrap:anywhere}
#social-media-youtube-grid-{{ section.id }} :is(h2,h3){font-family:var(--font-head)}
#social-media-youtube-grid-{{ section.id }} *{box-sizing:border-box;min-width:0}
#social-media-youtube-grid-{{ section.id }} :focus-visible{outline:2px solid currentColor;outline-offset:3px}
#social-media-youtube-grid-{{ section.id }} :is(.q-text-left,.q-align-left,.q-section-heading--left){text-align:start}
#social-media-youtube-grid-{{ section.id }} :is(.q-text-center,.q-align-center,.q-section-heading--center){text-align:center}
#social-media-youtube-grid-{{ section.id }} .q-section__inner{max-width:var(--container-lg);margin-inline:auto;padding:var(--section-pt,48px) 20px var(--section-pb,48px)}
#social-media-youtube-grid-{{ section.id }} :is(a,button){max-width:100%;white-space:normal}
#social-media-youtube-grid-{{ section.id }} [hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){#social-media-youtube-grid-{{ section.id }} *{transition:none!important;scroll-behavior:auto!important}}
</style>
{% endif %}

{% schema %}
{
  "name": "Social Media - YT Grid",
  "tag": "section",
  "class": "q-section q-social-youtube-grid",
  "settings": [
    {
      "type": "paragraph",
      "content": "Merchant-curated content and native links unless an explicit provider embed is configured. The theme does not fetch social posts, authorize accounts, verify claims or implement feed synchronization. Future feed/playlist choices are retained configuration placeholders, not connected integrations."
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Watch & learn"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From our YouTube channel"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Highlight tutorials, reviews, and stories from your YouTube channel."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "surface",
      "options": [
        {
          "value": "surface",
          "label": "Soft surface"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        },
        {
          "value": "minimal",
          "label": "Minimal (no background)"
        }
      ]
    },
    {
      "type": "select",
      "id": "video_ratio",
      "label": "Video aspect ratio",
      "default": "16:9",
      "options": [
        {
          "value": "16:9",
          "label": "16:9 (YouTube default)"
        },
        {
          "value": "1:1",
          "label": "Square (1:1)"
        },
        {
          "value": "9:16",
          "label": "Vertical (9:16)"
        },
        {
          "value": "4:5",
          "label": "Portrait (4:5)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Labels & CTA"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show tag (Tutorial, Review, etc.)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_platform_badge",
      "label": "Show YouTube badge on thumbnail",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_watch_label",
      "label": "Show \"Watch on YouTube\" label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open videos in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Data source (Quadratum Link ready)"
    },
    {
      "type": "select",
      "id": "data_source_mode",
      "label": "Data source",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "Manual videos (theme editor)"
        },
        {
          "value": "playlist",
          "label": "Playlist feed (requires integration)"
        }
      ],
      "info": "Manual blocks are implemented. Other choices require an external integration; without one, the section shows setup guidance only in the editor."
    },
    {
      "type": "text",
      "id": "playlist_handle",
      "label": "Playlist handle (for Quadratum Link)",
      "default": "youtube_playlist_default"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "ARIA label for section",
      "default": "YouTube video gallery"
    }
  ],
  "blocks": [
    {
      "type": "youtube_video",
      "name": "YouTube video",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Video"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (Tutorial, Review, etc.)",
          "default": "Tutorial"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "YouTube URL"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "text",
          "id": "duration_label",
          "label": "Duration label (optional)"
        },
        {
          "type": "image_picker",
          "id": "thumbnail_override",
          "label": "Custom thumbnail (optional)"
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "ARIA label for video link",
          "default": "Watch video on YouTube"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Social Media - YouTube Grid",
      "category": "Social Media",
      "blocks": [
        {
          "type": "youtube_video"
