{%- comment -%}
  Decorative Lucide icon by name, using the existing deployed flat sprite.
  Its two hosts provide the icon box size. Blank/none emits no icon.
{%- endcomment -%}
{%- assign icon_name = name | default: '' | strip | remove: '.svg' | handleize -%}
{%- if icon_name != blank and icon_name != 'none' -%}
  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="width:100%;height:100%;display:block">
    <use href="{{ 'icons.svg' | asset_url }}#lucide-{{ icon_name | escape }}"></use>
  </svg>
{%- endif -%}
