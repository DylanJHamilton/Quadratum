{%- liquid
  assign block_id = 'content-promo-card-' | append: block.id

  assign alignment = block.settings.alignment | default: 'left'
  assign width = block.settings.width | default: 'auto'
  assign layout_style = block.settings.layout_style | default: 'image-top'

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-promo-card
    content-promo-card--{{ layout_style }}
    content-promo-card--align-{{ alignment }}
    content-promo-card--width-{{ width }}
    {% unless show_desktop %} content-promo-card--hide-desktop{% endunless %}
    {% unless show_tablet %} content-promo-card--hide-tablet{% endunless %}
    {% unless show_mobile %} content-promo-card--hide-mobile{% endunless %}
    {% if block.settings.animation != 'none' %} content-promo-card--animate content-promo-card--animate-{{ block.settings.animation }}{% endif %}
  "
  style="
    --content-promo-card-margin-top: {{ block.settings.margin_top }}px;
    --content-promo-card-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-promo-card-padding-top: {{ block.settings.padding_top }}px;
    --content-promo-card-padding-bottom: {{ block.settings.padding_bottom }}px;
    --content-promo-card-padding-left: {{ block.settings.padding_left }}px;
    --content-promo-card-padding-right: {{ block.settings.padding_right }}px;
    --content-promo-card-card-padding: {{ block.settings.card_padding }}px;
    --content-promo-card-gap: {{ block.settings.gap }}px;
    --content-promo-card-radius: {{ block.settings.border_radius }}px;
    --content-promo-card-border-width: {{ block.settings.border_width }}px;
    --content-promo-card-heading-color: {{ block.settings.heading_color }};
    --content-promo-card-text-color: {{ block.settings.text_color }};
    --content-promo-card-link-color: {{ block.settings.link_color }};
    --content-promo-card-background-color: {{ block.settings.background_color }};
    --content-promo-card-card-background-color: {{ block.settings.card_background_color }};
    --content-promo-card-border-color: {{ block.settings.border_color }};
    --content-promo-card-badge-background: {{ block.settings.badge_background_color }};
    --content-promo-card-badge-text: {{ block.settings.badge_text_color }};
    --content-promo-card-primary-background: {{ block.settings.primary_button_background }};
    --content-promo-card-primary-text: {{ block.settings.primary_button_text }};
    --content-promo-card-secondary-background: {{ block.settings.secondary_button_background }};
    --content-promo-card-secondary-text: {{ block.settings.secondary_button_text }};
    --content-promo-card-button-radius: {{ block.settings.button_radius }}px;
    --content-promo-card-overlay-color: {{ block.settings.overlay_color }};
    --content-promo-card-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --content-promo-card-image-radius: {{ block.settings.image_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-promo-card-margin-top);
      margin-bottom: var(--content-promo-card-margin-bottom);
      padding-top: var(--content-promo-card-padding-top);
      padding-bottom: var(--content-promo-card-padding-bottom);
      padding-left: var(--content-promo-card-padding-left);
      padding-right: var(--content-promo-card-padding-right);
      background: var(--content-promo-card-background-color);
      color: var(--content-promo-card-text-color);
    }

    #{{ block_id }}.content-promo-card--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-promo-card--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-promo-card--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-promo-card--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-promo-card--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-promo-card--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-promo-card--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-promo-card--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-promo-card__card {
      position: relative;
      display: flex;
      width: 100%;
      overflow: hidden;
      color: var(--content-promo-card-text-color);
      background: var(--content-promo-card-card-background-color);
      border: var(--content-promo-card-border-width) solid var(--content-promo-card-border-color);
      border-radius: var(--content-promo-card-radius);
      isolation: isolate;
    }

    #{{ block_id }}.content-promo-card--image-top .content-promo-card__card {
      flex-direction: column;
    }

    #{{ block_id }}.content-promo-card--image-left .content-promo-card__card {
      flex-direction: row;
      align-items: stretch;
    }

    #{{ block_id }}.content-promo-card--banner .content-promo-card__card {
      flex-direction: row;
      align-items: center;
    }

    #{{ block_id }}.content-promo-card--overlay .content-promo-card__card {
      min-height: 420px;
      align-items: flex-end;
      background: #111111;
    }

    #{{ block_id }} .content-promo-card__media {
      position: relative;
      width: 100%;
      min-width: 0;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.04);
    }

    #{{ block_id }}.content-promo-card--image-left .content-promo-card__media {
      width: 46%;
      flex: 0 0 46%;
    }

    #{{ block_id }}.content-promo-card--banner .content-promo-card__media {
      width: 34%;
      flex: 0 0 34%;
    }

    #{{ block_id }}.content-promo-card--overlay .content-promo-card__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    #{{ block_id }} .content-promo-card__image {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--content-promo-card-image-radius);
    }

    #{{ block_id }}.content-promo-card--image-top .content-promo-card__image {
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: 0;
    }

    #{{ block_id }}.content-promo-card--image-left .content-promo-card__image,
    #{{ block_id }}.content-promo-card--banner .content-promo-card__image {
      height: 100%;
      min-height: 320px;
      object-fit: cover;
      border-radius: 0;
    }

    #{{ block_id }}.content-promo-card--overlay .content-promo-card__image {
      height: 100%;
      object-fit: cover;
      border-radius: 0;
    }

    #{{ block_id }} .content-promo-card__overlay {
      display: none;
    }

    #{{ block_id }}.content-promo-card--overlay .content-promo-card__overlay,
    #{{ block_id }}.content-promo-card--banner .content-promo-card__overlay {
      display: block;
      position: absolute;
      inset: 0;
      background: var(--content-promo-card-overlay-color);
      opacity: var(--content-promo-card-overlay-opacity);
      z-index: -1;
      pointer-events: none;
    }

    #{{ block_id }} .content-promo-card__content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: var(--content-promo-card-gap);
      width: 100%;
      min-width: 0;
      padding: var(--content-promo-card-card-padding);
    }

    #{{ block_id }}.content-promo-card--image-left .content-promo-card__content {
      justify-content: center;
    }

    #{{ block_id }}.content-promo-card--banner .content-promo-card__content {
      justify-content: center;
    }

    #{{ block_id }}.content-promo-card--overlay .content-promo-card__content {
      color: #ffffff;
    }

    #{{ block_id }} .content-promo-card__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      max-width: 100%;
      padding: 8px 12px;
      border-radius: 999px;
      line-height: 1.2;
      background: var(--content-promo-card-badge-background);
      color: var(--content-promo-card-badge-text);
    }

    #{{ block_id }} .content-promo-card__heading {
      margin: 0;
      color: var(--content-promo-card-heading-color);
      line-height: 1.05;
    }

    #{{ block_id }} .content-promo-card__text {
      margin: 0;
      color: var(--content-promo-card-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-promo-card__text p {
      margin-top: 0;
    }

    #{{ block_id }} .content-promo-card__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }}.content-promo-card--overlay .content-promo-card__heading,
    #{{ block_id }}.content-promo-card--overlay .content-promo-card__text {
      color: #ffffff;
    }

    #{{ block_id }} .content-promo-card__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    #{{ block_id }}.content-promo-card--align-center .content-promo-card__badge,
    #{{ block_id }}.content-promo-card--align-center .content-promo-card__actions {
      margin-left: auto;
      margin-right: auto;
      justify-content: center;
    }

    #{{ block_id }}.content-promo-card--align-right .content-promo-card__badge,
    #{{ block_id }}.content-promo-card--align-right .content-promo-card__actions {
      margin-left: auto;
      margin-right: 0;
      justify-content: flex-end;
    }

    #{{ block_id }} .content-promo-card__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 12px 18px;
      border-radius: var(--content-promo-card-button-radius);
      text-decoration: none;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-promo-card__button:hover {
      opacity: 0.82;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-promo-card__button--primary {
      background: var(--content-promo-card-primary-background);
      color: var(--content-promo-card-primary-text);
      border: 1px solid var(--content-promo-card-primary-background);
    }

    #{{ block_id }} .content-promo-card__button--secondary {
      background: var(--content-promo-card-secondary-background);
      color: var(--content-promo-card-secondary-text);
      border: 1px solid currentColor;
    }

    #{{ block_id }}.content-promo-card--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-promo-card--animate-fade {
      animation-name: contentPromoCardFade;
    }

    #{{ block_id }}.content-promo-card--animate-fade-up {
      animation-name: contentPromoCardFadeUp;
    }

    #{{ block_id }}.content-promo-card--animate-fade-down {
      animation-name: contentPromoCardFadeDown;
    }

    #{{ block_id }}.content-promo-card--animate-fade-left {
      animation-name: contentPromoCardFadeLeft;
    }

    #{{ block_id }}.content-promo-card--animate-fade-right {
      animation-name: contentPromoCardFadeRight;
    }

    #{{ block_id }}.content-promo-card--animate-zoom {
      animation-name: contentPromoCardZoom;
    }

    @keyframes contentPromoCardFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentPromoCardFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentPromoCardFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentPromoCardFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentPromoCardFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentPromoCardZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-promo-card--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-promo-card--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-promo-card--image-left .content-promo-card__card,
      #{{ block_id }}.content-promo-card--banner .content-promo-card__card {
        flex-direction: column;
      }

      #{{ block_id }}.content-promo-card--image-left .content-promo-card__media,
      #{{ block_id }}.content-promo-card--banner .content-promo-card__media {
        width: 100%;
        flex-basis: auto;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-promo-card--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-promo-card--image-left .content-promo-card__card,
      #{{ block_id }}.content-promo-card--banner .content-promo-card__card {
        flex-direction: column;
      }

      #{{ block_id }}.content-promo-card--image-left .content-promo-card__media,
      #{{ block_id }}.content-promo-card--banner .content-promo-card__media {
        width: 100%;
        flex-basis: auto;
      }

      #{{ block_id }} .content-promo-card__actions {
        width: 100%;
      }

      #{{ block_id }} .content-promo-card__button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-promo-card--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-promo-card__button {
        transition: none;
      }

      #{{ block_id }} .content-promo-card__button:hover {
        transform: none;
      }
    }
  </style>

  <article class="content-promo-card__card">
    {% if block.settings.image != blank %}
      <div class="content-promo-card__media">
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'content-promo-card__image',
            loading: 'lazy',
            alt: block.settings.image_alt
        }}
      </div>
    {% elsif block.settings.background_image != blank %}
      <div class="content-promo-card__media">
        {{
          block.settings.background_image
          | image_url: width: 1800
          | image_tag:
            class: 'content-promo-card__image',
            loading: 'lazy',
            alt: block.settings.image_alt
        }}
      </div>
    {% endif %}

    <span class="content-promo-card__overlay" aria-hidden="true"></span>

    <div class="content-promo-card__content">
      {% if block.settings.badge != blank %}
        <span class="content-promo-card__badge">
          {{ block.settings.badge | escape }}
        </span>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="content-promo-card__heading">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="content-promo-card__text">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
        <div class="content-promo-card__actions">
          {% if block.settings.primary_button_label != blank and block.settings.primary_button_url != blank %}
            <a class="content-promo-card__button content-promo-card__button--primary" href="{{ block.settings.primary_button_url }}">
              {{ block.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if block.settings.secondary_button_label != blank and block.settings.secondary_button_url != blank %}
            <a class="content-promo-card__button content-promo-card__button--secondary" href="{{ block.settings.secondary_button_url }}">
              {{ block.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </article>
</div>

{% schema %}
{
  "name": "Content promo card",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Promote a collection, campaign, or offer"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Create a focused promotional card for sales, seasonal campaigns, featured collections, or landing page calls to action.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "image-top",
      "options": [
        {
          "value": "image-top",
          "label": "Image top"
        },
        {
          "value": "image-left",
          "label": "Image left"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "banner",
          "label": "Banner"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Content gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Block background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_button_background",
      "label": "Primary button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_background",
      "label": "Secondary button background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
  "type": "range",
  "id": "button_radius",
  "label": "Button radius",
  "min": 0,
  "max": 80,
