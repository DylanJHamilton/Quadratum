{%- assign current_sort = sort_by | default: default_sort_by -%}
<div class="qcmToolbar{% if sticky_toolbar %} qcmToolbar--sticky{% endif %}" data-qcm-toolbar>
  <div class="qcmToolbar__top">
    <div>
      {%- if s.show_title and results_title != blank -%}<h1 class="qcmToolbar__title">{{ results_title | escape }}</h1>{%- endif -%}
      {%- if s.show_description and results_description != blank -%}<div class="qcmToolbar__desc{% if s.description_style == 'truncated' %} qcmToolbar__desc--trunc{% endif %}">{{ results_description }}</div>{%- endif -%}
    </div>
    <div class="qcmToolbar__controls">
      {%- if s.show_result_count -%}<span>{{ results_count }} results</span>{%- endif -%}
      {%- if has_filters and filter_mode == 'drawer' -%}<button type="button" class="qcm__btn" data-qcm-drawer-open aria-expanded="false" aria-controls="QcmDrawer-{{ section.id }}" hidden>Filters</button>{%- endif -%}
      {%- if s.show_sort and sort_options.size > 0 -%}
        <form method="get" action="{{ results_url | escape }}" class="qcmSortPills">
          {% render 'collection-query-fields', is_search_context: is_search_context, terms_q: terms_q, filters: filters, keep_filters: true %}
          {%- if s.sort_style == 'pills' -%}
            {%- for opt in sort_options -%}<button type="submit" name="sort_by" value="{{ opt.value | escape }}" class="qcm__btn qcmSortPill" aria-pressed="{% if opt.value == current_sort %}true{% else %}false{% endif %}">{{ opt.name | escape }}</button>{%- endfor -%}
          {%- else -%}
            <label>Sort <select name="sort_by" data-qcm-sort>{%- for opt in sort_options -%}<option value="{{ opt.value | escape }}" {% if opt.value == current_sort %}selected{% endif %}>{{ opt.name | escape }}</option>{%- endfor -%}</select></label>
            <button type="submit" class="qcm__btn">Apply sort</button>
          {%- endif -%}
        </form>
      {%- endif -%}
    </div>
  </div>
  {%- if s.show_active_filters -%}{% render 'collection-modern-active-filters', filters: filters, s: s, results_url: results_url, is_search_context: is_search_context, terms_q: terms_q, sort_by: current_sort %}{%- endif -%}
  {%- if has_filters and filter_mode == 'bar' -%}{% render 'collection-simple-facets', section: section, s: s, filters: filters, results_url: results_url, is_search_context: is_search_context, terms_q: terms_q, sort_by: current_sort, placement: 'bar' %}{%- endif -%}
</div>
