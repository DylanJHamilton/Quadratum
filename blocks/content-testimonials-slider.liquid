{%- liquid
  assign block_id = 'content-testimonials-slider-' | append: block.id

  assign block_width = block.settings.block_width | default: 'auto'
  assign text_alignment = block.settings.text_alignment | default: 'left'
  assign testimonial_count = block.settings.testimonial_count | default: 5
  assign slides_per_view_desktop = block.settings.slides_per_view_desktop | default: '3'
  assign slides_per_view_mobile = block.settings.slides_per_view_mobile | default: '1'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    content-testimonials-slider
    content-testimonials-slider--width-{{ block_width }}
    content-testimonials-slider--align-{{ text_alignment }}
    content-testimonials-slider--desktop-{{ slides_per_view_desktop }}
    content-testimonials-slider--mobile-{{ slides_per_view_mobile }}
    {% unless show_on_desktop %} content-testimonials-slider--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-testimonials-slider--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-testimonials-slider--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-testimonials-slider--animate content-testimonials-slider--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-testimonials-slider-margin-top: {{ block.settings.margin_top }}px;
    --content-testimonials-slider-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-testimonials-slider-padding: {{ block.settings.padding }}px;
    --content-testimonials-slider-gap: {{ block.settings.gap }}px;
    --content-testimonials-slider-card-padding: {{ block.settings.card_padding }}px;
    --content-testimonials-slider-border-width: {{ block.settings.border_width }}px;
    --content-testimonials-slider-border-radius: {{ block.settings.border_radius }}px;
    --content-testimonials-slider-heading-color: {{ block.settings.heading_color }};
    --content-testimonials-slider-text-color: {{ block.settings.text_color }};
    --content-testimonials-slider-background-color: {{ block.settings.background_color }};
    --content-testimonials-slider-card-background-color: {{ block.settings.card_background_color }};
    --content-testimonials-slider-border-color: {{ block.settings.border_color }};
    --content-testimonials-slider-link-color: {{ block.settings.link_color }};
    --content-testimonials-slider-rating-color: {{ block.settings.rating_color }};
    --content-testimonials-slider-image-size: {{ block.settings.image_size }}px;
    --content-testimonials-slider-arrow-size: {{ block.settings.arrow_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-testimonials-slider-margin-top);
      margin-bottom: var(--content-testimonials-slider-margin-bottom);
      padding: var(--content-testimonials-slider-padding);
      color: var(--content-testimonials-slider-text-color);
      background: var(--content-testimonials-slider-background-color);
    }

    #{{ block_id }}.content-testimonials-slider--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-testimonials-slider--width-small {
      max-width: 720px;
    }

    #{{ block_id }}.content-testimonials-slider--width-medium {
      max-width: 960px;
    }

    #{{ block_id }}.content-testimonials-slider--width-large {
      max-width: 1200px;
    }

    #{{ block_id }}.content-testimonials-slider--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-testimonials-slider--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-testimonials-slider--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-testimonials-slider--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-testimonials-slider__viewport {
      position: relative;
      width: 100%;
      min-width: 0;
    }

    #{{ block_id }} .content-testimonials-slider__track {
      display: flex;
      gap: var(--content-testimonials-slider-gap);
      width: 100%;
      min-width: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 4px;
    }

    #{{ block_id }} .content-testimonials-slider__track::-webkit-scrollbar {
      display: none;
    }

    #{{ block_id }} .content-testimonials-slider__slide {
      flex: 0 0 calc((100% - (var(--content-testimonials-slider-gap) * 2)) / 3);
      scroll-snap-align: start;
      min-width: 0;
    }

    #{{ block_id }}.content-testimonials-slider--desktop-1 .content-testimonials-slider__slide {
      flex-basis: 100%;
    }

    #{{ block_id }}.content-testimonials-slider--desktop-2 .content-testimonials-slider__slide {
      flex-basis: calc((100% - var(--content-testimonials-slider-gap)) / 2);
    }

    #{{ block_id }}.content-testimonials-slider--desktop-3 .content-testimonials-slider__slide {
      flex-basis: calc((100% - (var(--content-testimonials-slider-gap) * 2)) / 3);
    }

    #{{ block_id }}.content-testimonials-slider--desktop-4 .content-testimonials-slider__slide {
      flex-basis: calc((100% - (var(--content-testimonials-slider-gap) * 3)) / 4);
    }

    #{{ block_id }} .content-testimonials-slider__card {
      height: 100%;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
      color: var(--content-testimonials-slider-text-color);
      background: var(--content-testimonials-slider-card-background-color);
      border: var(--content-testimonials-slider-border-width) solid var(--content-testimonials-slider-border-color);
      border-radius: var(--content-testimonials-slider-border-radius);
      padding: var(--content-testimonials-slider-card-padding);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    }

    #{{ block_id }} .content-testimonials-slider__media {
      width: 100%;
      overflow: hidden;
      border-radius: max(calc(var(--content-testimonials-slider-border-radius) - 6px), 0px);
      background: rgba(0, 0, 0, 0.05);
    }

    #{{ block_id }} .content-testimonials-slider__video {
      width: 100%;
      aspect-ratio: 16 / 9;
      display: block;
      border: 0;
    }

    #{{ block_id }} .content-testimonials-slider__rating {
      display: flex;
      gap: 2px;
      color: var(--content-testimonials-slider-rating-color);
      line-height: 1;
      letter-spacing: 0.02em;
    }

    #{{ block_id }}.content-testimonials-slider--align-center .content-testimonials-slider__rating {
      justify-content: center;
    }

    #{{ block_id }}.content-testimonials-slider--align-right .content-testimonials-slider__rating {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-testimonials-slider__quote {
      margin: 0;
      color: var(--content-testimonials-slider-heading-color);
      line-height: 1.6;
    }

    #{{ block_id }} .content-testimonials-slider__author {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
      min-width: 0;
    }

    #{{ block_id }}.content-testimonials-slider--align-center .content-testimonials-slider__author {
      justify-content: center;
      flex-direction: column;
    }

    #{{ block_id }}.content-testimonials-slider--align-right .content-testimonials-slider__author {
      justify-content: flex-end;
      text-align: right;
    }

    #{{ block_id }} .content-testimonials-slider__image {
      width: var(--content-testimonials-slider-image-size);
      height: var(--content-testimonials-slider-image-size);
      flex: 0 0 var(--content-testimonials-slider-image-size);
      border-radius: 999px;
      object-fit: cover;
      display: block;
      background: rgba(0, 0, 0, 0.06);
    }

    #{{ block_id }} .content-testimonials-slider__author-content {
      display: grid;
      gap: 2px;
      min-width: 0;
    }

    #{{ block_id }} .content-testimonials-slider__name {
      color: var(--content-testimonials-slider-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .content-testimonials-slider__meta {
      color: var(--content-testimonials-slider-text-color);
      line-height: 1.4;
      opacity: 0.82;
    }

    #{{ block_id }} .content-testimonials-slider__link {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      gap: 8px;
      color: var(--content-testimonials-slider-link-color);
      text-decoration: none;
      line-height: 1.2;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
      transition: opacity 180ms ease;
    }

    #{{ block_id }} .content-testimonials-slider__link:hover {
      opacity: 0.72;
    }

    #{{ block_id }}.content-testimonials-slider--align-center .content-testimonials-slider__link {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.content-testimonials-slider--align-right .content-testimonials-slider__link {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .content-testimonials-slider__controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 18px;
    }

    #{{ block_id }} .content-testimonials-slider__arrows {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #{{ block_id }} .content-testimonials-slider__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--content-testimonials-slider-arrow-size);
      height: var(--content-testimonials-slider-arrow-size);
      border-radius: 999px;
      border: var(--content-testimonials-slider-border-width) solid var(--content-testimonials-slider-border-color);
      background: var(--content-testimonials-slider-card-background-color);
      color: var(--content-testimonials-slider-link-color);
      cursor: pointer;
      line-height: 1;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-testimonials-slider__arrow:hover {
      opacity: 0.78;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-testimonials-slider__arrow:focus-visible {
      outline: 2px solid var(--content-testimonials-slider-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-testimonials-slider__dots {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      flex-wrap: wrap;
    }

    #{{ block_id }} .content-testimonials-slider__dot {
      appearance: none;
      width: 10px;
      height: 10px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: var(--content-testimonials-slider-border-color);
      cursor: pointer;
    }

    #{{ block_id }} .content-testimonials-slider__dot.is-active {
      background: var(--content-testimonials-slider-link-color);
    }

    #{{ block_id }} .content-testimonials-slider__dot:focus-visible {
      outline: 2px solid var(--content-testimonials-slider-link-color);
      outline-offset: 3px;
    }

    #{{ block_id }}.content-testimonials-slider--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-testimonials-slider--animate-fade {
      animation-name: contentTestimonialsSliderFade;
    }

    #{{ block_id }}.content-testimonials-slider--animate-fade_up {
      animation-name: contentTestimonialsSliderFadeUp;
    }

    #{{ block_id }}.content-testimonials-slider--animate-fade_down {
      animation-name: contentTestimonialsSliderFadeDown;
    }

    #{{ block_id }}.content-testimonials-slider--animate-fade_left {
      animation-name: contentTestimonialsSliderFadeLeft;
    }

    #{{ block_id }}.content-testimonials-slider--animate-fade_right {
      animation-name: contentTestimonialsSliderFadeRight;
    }

    #{{ block_id }}.content-testimonials-slider--animate-zoom {
      animation-name: contentTestimonialsSliderZoom;
    }

    @keyframes contentTestimonialsSliderFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentTestimonialsSliderFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTestimonialsSliderFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTestimonialsSliderFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTestimonialsSliderFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTestimonialsSliderZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-testimonials-slider--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-testimonials-slider--hide-tablet {
        display: none !important;
      }

      #{{ block_id }} .content-testimonials-slider__slide {
        flex-basis: calc((100% - var(--content-testimonials-slider-gap)) / 2);
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-testimonials-slider--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-testimonials-slider--mobile-1 .content-testimonials-slider__slide {
        flex-basis: 100%;
      }

      #{{ block_id }}.content-testimonials-slider--mobile-2 .content-testimonials-slider__slide {
        flex-basis: calc((100% - var(--content-testimonials-slider-gap)) / 2);
      }

      #{{ block_id }} .content-testimonials-slider__card {
        padding: min(var(--content-testimonials-slider-card-padding), 24px);
      }

      #{{ block_id }} .content-testimonials-slider__controls {
        align-items: flex-start;
        flex-direction: column;
      }

      #{{ block_id }} .content-testimonials-slider__dots {
        justify-content: flex-start;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-testimonials-slider--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-testimonials-slider__track {
        scroll-behavior: auto;
      }

      #{{ block_id }} .content-testimonials-slider__arrow,
      #{{ block_id }} .content-testimonials-slider__link {
        transition: none;
      }

      #{{ block_id }} .content-testimonials-slider__arrow:hover {
        transform: none;
      }
    }
  </style>

  <div class="content-testimonials-slider__viewport">
    <div
      class="content-testimonials-slider__track"
      data-content-testimonials-slider-track
      aria-label="{{ block.settings.aria_label | escape }}"
      tabindex="0"
    >
      {%- for index in (1..8) -%}
        {%- if index <= testimonial_count -%}
          {%- liquid
            assign quote_key = 'testimonial_' | append: index | append: '_quote'
            assign name_key = 'testimonial_' | append: index | append: '_name'
            assign role_key = 'testimonial_' | append: index | append: '_role'
            assign company_key = 'testimonial_' | append: index | append: '_company'
            assign rating_key = 'testimonial_' | append: index | append: '_rating'
            assign image_key = 'testimonial_' | append: index | append: '_image'
            assign image_alt_key = 'testimonial_' | append: index | append: '_image_alt'
            assign video_key = 'testimonial_' | append: index | append: '_video_url'
            assign link_label_key = 'testimonial_' | append: index | append: '_link_label'
            assign link_url_key = 'testimonial_' | append: index | append: '_link_url'

            assign quote = block.settings[quote_key]
            assign name = block.settings[name_key]
            assign role = block.settings[role_key]
            assign company = block.settings[company_key]
            assign rating = block.settings[rating_key]
            assign image = block.settings[image_key]
            assign image_alt = block.settings[image_alt_key]
            assign video_url = block.settings[video_key]
            assign link_label = block.settings[link_label_key]
            assign link_url = block.settings[link_url_key]
          -%}

          {% if quote != blank or name != blank or video_url != blank %}
            <article class="content-testimonials-slider__slide" data-content-testimonials-slider-slide>
              <div class="content-testimonials-slider__card">
                {% if video_url != blank %}
                  <div class="content-testimonials-slider__media">
                    {{
                      video_url
                      | external_video_url
                      | external_video_tag:
                        class: 'content-testimonials-slider__video',
                        loading: 'lazy'
                    }}
                  </div>
                {% endif %}

                {% if rating != 'none' %}
                  <div class="content-testimonials-slider__rating" aria-label="{{ rating | escape }} out of 5 stars">
                    {%- case rating -%}
                      {%- when '1' -%}★
                      {%- when '2' -%}★★
                      {%- when '3' -%}★★★
                      {%- when '4' -%}★★★★
                      {%- when '5' -%}★★★★★
                    {%- endcase -%}
                  </div>
                {% endif %}

                {% if quote != blank %}
                  <blockquote class="content-testimonials-slider__quote">
                    “{{ quote | escape }}”
                  </blockquote>
                {% endif %}

                <div class="content-testimonials-slider__author">
                  {% if image != blank %}
                    {{
                      image
                      | image_url: width: 220
                      | image_tag:
                        class: 'content-testimonials-slider__image',
                        loading: 'lazy',
                        alt: image_alt
                    }}
                  {% endif %}

                  <div class="content-testimonials-slider__author-content">
                    {% if name != blank %}
                      <strong class="content-testimonials-slider__name">{{ name | escape }}</strong>
                    {% endif %}

                    {% if role != blank or company != blank %}
                      <span class="content-testimonials-slider__meta">
                        {% if role != blank %}{{ role | escape }}{% endif %}
                        {% if role != blank and company != blank %}, {% endif %}
                        {% if company != blank %}{{ company | escape }}{% endif %}
                      </span>
                    {% endif %}
                  </div>
                </div>

                {% if link_label != blank and link_url != blank %}
                  <a class="content-testimonials-slider__link" href="{{ link_url }}">
                    {{ link_label | escape }}
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if block.settings.show_arrows or block.settings.show_dots %}
      <div class="content-testimonials-slider__controls">
        {% if block.settings.show_arrows %}
          <div class="content-testimonials-slider__arrows" aria-label="Slider controls">
            <button
              class="content-testimonials-slider__arrow"
              type="button"
              aria-label="Previous testimonial"
              data-content-testimonials-slider-prev
            >
              ←
            </button>

            <button
              class="content-testimonials-slider__arrow"
              type="button"
              aria-label="Next testimonial"
              data-content-testimonials-slider-next
            >
              →
            </button>
          </div>
        {% endif %}

        {% if block.settings.show_dots %}
          <div class="content-testimonials-slider__dots" data-content-testimonials-slider-dots aria-label="Slider pagination"></div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <script>
    (() => {
      const root = document.getElementById({{ block_id | json }});

      if (!root || root.dataset.contentTestimonialsSliderReady === 'true') return;

      root.dataset.contentTestimonialsSliderReady = 'true';

      const track = root.querySelector('[data-content-testimonials-slider-track]');
      const slides = Array.from(root.querySelectorAll('[data-content-testimonials-slider-slide]'));
      const prev = root.querySelector('[data-content-testimonials-slider-prev]');
      const next = root.querySelector('[data-content-testimonials-slider-next]');
      const dotsWrap = root.querySelector('[data-content-testimonials-slider-dots]');
      const autoplayEnabled = {{ block.settings.autoplay | json }};
      const autoplaySpeed = {{ block.settings.autoplay_speed | times: 1000 | json }};
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!track || !slides.length) return;

      let activeIndex = 0;
      let autoplayTimer = null;

      const getSlideStep = () => {
        const firstSlide = slides[0];

        if (!firstSlide) return track.clientWidth;

        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0);

        return firstSlide.getBoundingClientRect().width + gap;
      };

      const scrollToIndex = (index) => {
        const clampedIndex = Math.max(0, Math.min(index, slides.length - 1));
        activeIndex = clampedIndex;

        track.scrollTo({
          left: getSlideStep() * clampedIndex,
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });

        updateDots();
      };

      const updateDots = () => {
        if (!dotsWrap) return;

        const dots = Array.from(dotsWrap.querySelectorAll('[data-content-testimonials-slider-dot]'));

        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === activeIndex);
          dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
        });
      };

      const buildDots = () => {
        if (!dotsWrap) return;

        dotsWrap.innerHTML = '';

        slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'content-testimonials-slider__dot';
          dot.setAttribute('aria-label', `Go to testimonial ${index + 1}`);
          dot.setAttribute('data-content-testimonials-slider-dot', '');
          dot.addEventListener('click', () => scrollToIndex(index));
          dotsWrap.appendChild(dot);
        });

        updateDots();
      };

      const goNext = () => {
        const nextIndex = activeIndex + 1 >= slides.length ? 0 : activeIndex + 1;
        scrollToIndex(nextIndex);
      };

      const goPrev = () => {
        const previousIndex = activeIndex - 1 < 0 ? slides.length - 1 : activeIndex - 1;
        scrollToIndex(previousIndex);
      };

      const startAutoplay = () => {
        if (!autoplayEnabled || prefersReducedMotion || slides.length <= 1) return;

        stopAutoplay();
        autoplayTimer = window.setInterval(goNext, autoplaySpeed);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      if (prev) {
        prev.addEventListener('click', () => {
          goPrev();
          startAutoplay();
        });
      }

      if (next) {
        next.addEventListener('click', () => {
          goNext();
          startAutoplay();
        });
      }

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(() => {
          const step = getSlideStep();

          if (step <= 0) return;

          activeIndex = Math.round(track.scrollLeft / step);
          updateDots();
        });
      }, { passive: true });

      track.addEventListener('mouseenter', stopAutoplay);
      track.addEventListener('mouseleave', startAutoplay);
      track.addEventListener('focusin', stopAutoplay);
      track.addEventListener('focusout', startAutoplay);

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goNext();
