{% comment %}Product-specific waitlist fields, native/customer routing and scoped variant enhancement. Notification delivery requires merchant integration.{% endcomment %}

{{ 'forms-sections.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
{%- assign g = settings -%}
{%- liquid
  assign product_handle = s.product_handle | strip
  assign waitlist_product = product
  if product_handle != blank and product_handle != product.handle
    assign waitlist_product = all_products[product_handle]
  endif
  assign has_waitlist_product = false
  if waitlist_product.id != blank
    if waitlist_product.variants.size > 0 or waitlist_product.selected_variant != blank
      assign has_waitlist_product = true
    endif
  endif
  assign waitlist_url = routes.root_url | append: '/' | replace: '//', '/' | append: 'products/' | append: waitlist_product.handle
  assign form_surface_color = s.form_bg | default: g.bg_base | default: '#ffffff'
-%}
{%- capture form_surface_text -%}{% render 'contrast-text', background: form_surface_color, preferred: g.text_base %}{%- endcapture -%}
{%- capture form_input_text -%}{% render 'contrast-text', background: '#ffffff', preferred: g.text_base %}{%- endcapture -%}


{%- comment %} Effective integrations/config {% endcomment -%}
{%- assign eff_captcha_mode = s.captcha_mode | default: g.forms_captcha_provider | default: 'none' -%}
{%- capture eff_captcha_key -%}{%- render 'form-captcha-key', mode: eff_captcha_mode, local_key: s.captcha_site_key -%}{%- endcapture -%}

{%- assign tags_theme   = g.forms_default_tags | default: 'form, web' -%}
{%- assign tags_section = s.hidden_tags | default: '' -%}
{%- assign eff_tags = tags_theme -%}
{%- if tags_section != blank -%}{%- assign eff_tags = tags_theme | append: ', ' | append: tags_section -%}{%- endif -%}

{%- if waitlist_product.handle != blank -%}{%- assign eff_tags = eff_tags | append: ', product=' | append: waitlist_product.handle -%}{%- endif -%}

{%- assign eff_endpoint = s.endpoint_url -%}
{%- if eff_endpoint == blank and s.destination == 'custom_endpoint' -%}
  {%- assign eff_endpoint = g.forms_global_endpoint | default: '' -%}
{%- endif -%}

{%- comment %} Button variant resolution {% endcomment -%}
{%- assign btn_default = settings.button_variant_default | default: 'solid' -%}
{%- assign btn_choice = s.button_variant | default: 'inherit' -%}
{%- assign btn_variant = btn_default -%}
{%- if btn_choice != 'inherit' and btn_choice != blank -%}{%- assign btn_variant = btn_choice -%}{%- endif -%}
{%- assign btn_mode_class = 'q-btn--solid' -%}
{%- if btn_variant == 'outline' -%}{%- assign btn_mode_class = 'q-btn--outline' -%}{%- endif -%}
{%- if btn_variant == 'ghost' -%}{%- assign btn_mode_class = 'q-btn--ghost' -%}{%- endif -%}

{%- comment %} Visibility helpers + anchor {% endcomment -%}
{%- assign visibility_classes = '' -%}
{%- if s.hide_on_mobile and request.design_mode == false -%}{%- assign visibility_classes = visibility_classes | append: ' hide-mobile' -%}{%- endif -%}
{%- if s.hide_on_desktop and request.design_mode == false -%}{%- assign visibility_classes = visibility_classes | append: ' hide-desktop' -%}{%- endif -%}
{%- assign anchor = s.anchor_id | strip -%}
{%- if anchor == blank -%}{%- assign anchor = 'section-' | append: section.id -%}{%- endif -%}

{%- assign c_primary     = settings.color_primary | default: '#2563eb' -%}
{%- assign c_bg_base     = settings.bg_base       | default: '#ffffff' -%}
{%- assign c_bg_contrast = settings.bg_contrast   | default: '#f6f7f8' -%}
{%- assign c_text_base   = settings.text_base     | default: '#111111' -%}
{%- assign c_text_muted  = settings.text_muted    | default: '#6b7280' -%}
{%- assign btn_radius    = settings.button_radius | default: 12 -%}
{%- assign btn_bw        = settings.button_border_width | default: 1 -%}
{%- assign btn_hover_op  = settings.button_hover_opacity | default: 92 -%}
{%- assign btn_active    = settings.button_active_scale  | default: 98 -%}

{%- capture automatic_button_text -%}{% render 'contrast-text', background: c_primary, preferred: g.text_on_color %}{%- endcapture -%}
<style>
  .q-form-scope-{{ section.id }}{
    --q-pad-y: {{ s.padding_y | default: 40 }}px;
    --q-pad-x: {{ s.padding_x | default: 24 }}px;
    --q-card-br: {{ s.card_radius | default: 14 }}px;
    --q-card-shadow: {% case s.card_shadow %}{% when 0 %}none{% when 1 %}0 1px 2px rgba(0,0,0,.06){% when 3 %}0 2px 4px rgba(0,0,0,.08), 0 16px 40px rgba(0,0,0,.12){% else %}0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.08){% endcase %};
    --q-text: {{ c_text_base }};
    --q-muted: {{ c_text_muted }};
    --q-bg: {{ s.bg_color | default: c_bg_contrast }};
    --q-btn-bg: {{ c_primary }};
    --q-btn-fg: {{ automatic_button_text | strip }};
    --q-btn-bdr: {{ c_text_base }};
    --q-btn-bw: {{ btn_bw }}px;
    --q-btn-br: {{ btn_radius }}px;
    --q-btn-hover-op: {{ btn_hover_op }};
    --q-btn-active-scale: {{ btn_active | divided_by: 100.0 }};

    --q-form-bg: {{ s.form_bg | default: c_bg_base }};
    --q-input-br: {{ s.input_radius | default: 10 }}px;
    --q-input-bdr: {{ s.input_border | default: '#e5e7eb' }};
    --q-error: {{ settings.color_error | default: '#dc2626' }};
  }

  /* Inline (PDP) compaction */
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-card{ padding: 0; background: transparent; box-shadow: none; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-head{ margin: 0 0 8px; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-fields{ display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-field{ margin:0; min-width:0; }
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-actions .q-btn{ min-height:44px; }

  /* Frameless surface toggle (remove card chrome) */
  .q-form-scope-{{ section.id }}[data-surface="frameless"] .q-card{ background: transparent !important; box-shadow:none !important; padding:0 !important; border-radius:0 !important; }

  /* Checkbox/radio sizing guards (avoid "width:100%" input styles bleeding into checks) */
  .q-form-scope-{{ section.id }} .q-radio{ display:flex; align-items:center; gap:10px; justify-content:flex-start; width:auto;max-width:100%;overflow-wrap:anywhere; }
  .q-form-scope-{{ section.id }} input.q-check{ width:auto; min-width:auto; padding:0; height:1.05rem; margin:0; }
  .q-form-scope-{{ section.id }} input.q-check.q-input{ background: transparent; }
  .q-form-scope-{{ section.id }} input[type="checkbox"].q-check.q-input{ border-radius:4px; }
  .q-form-scope-{{ section.id }} input[type="radio"].q-check.q-input{ border-radius:999px; }

  /* Invalid outline on checks only */
  .q-form-scope-{{ section.id }} input.q-check[aria-invalid="true"]{
    outline:2px solid var(--q-error);
    outline-offset:2px;
  }
  .q-form-scope-{{ section.id }}{min-width:0;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-wrap,.q-form-scope-{{ section.id }} .q-wrap-full{box-sizing:border-box;}
  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface,.q-form-scope-{{ section.id }} .q-grid>*{min-width:0;max-width:100%;}
  .q-form-scope-{{ section.id }} .q-field{min-width:0;max-width:100%;text-align:start;}
  .q-form-scope-{{ section.id }} .q-radio{width:auto;max-width:100%;text-align:start;overflow-wrap:anywhere;}
  .q-form-scope-{{ section.id }} .q-radio span{min-width:0;}
  .q-form-scope-{{ section.id }} :is(button,a,input,select,textarea):focus-visible{outline:2px solid currentColor;outline-offset:3px;}
  .q-form-scope-{{ section.id }} .q-step{grid-column:1 / -1;min-width:0;}
  .q-form-scope-{{ section.id }} .q-step-heading{width:100%;}
  .q-form-scope-{{ section.id }} [data-q-submit]{grid-column:1 / -1;max-width:100%;}
  @media(max-width:767.98px){.q-form-scope-{{ section.id }}.hide-mobile{display:none;}}
  @media(min-width:768px){.q-form-scope-{{ section.id }}.hide-desktop{display:none;}}
  @media(prefers-reduced-motion:reduce){.q-form-scope-{{ section.id }} .q-btn{transition:none;}}

  .q-form-scope-{{ section.id }} .q-card,.q-form-scope-{{ section.id }} .q-surface{--q-text:{{ form_surface_text | strip }};--q-muted:{{ form_surface_text | strip }};}
  .q-form-scope-{{ section.id }}[data-surface="frameless"] .q-card,.q-form-scope-{{ section.id }}[data-surface="frameless"] .q-surface{--q-text:{{ g.text_base | default: '#111111' }};--q-muted:{{ g.text_muted | default: '#6b7280' }};}
  .q-form-scope-{{ section.id }} input.q-input,.q-form-scope-{{ section.id }} select.q-select,.q-form-scope-{{ section.id }} textarea.q-textarea{color:{{ form_input_text | strip }};box-sizing:border-box;max-width:100%;}
  .q-form-scope-{{ section.id }}{--q-btn-hover-op:{{ g.button_hover_opacity | default: 92 }};--q-btn-active-scale:{{ g.button_active_scale | default: 98 | divided_by: 100.0 }};}
  {% if g.font_heading %}.q-form-scope-{{ section.id }} .q-head :is(h2,h3){font-family:{{ g.font_heading.family }},{{ g.font_heading.fallback_families }};}{% endif %}
  .q-form-scope-{{ section.id }}[data-template="inline"] .q-card{--q-text:{{ g.text_base | default: '#111111' }};--q-muted:{{ g.text_muted | default: '#6b7280' }};}
  .q-form-scope-{{ section.id }} .q-wrap{margin:0 auto;padding-inline:min(var(--q-pad-x),8vw);max-width:{% if s.container_mode == 'full' or g.style_kit == 'full' %}100%{% elsif g.style_kit == 'wide' %}var(--q-cont-xl,1440px){% else %}var(--q-cont-lg,1152px){% endif %};}
  .q-form-scope-{{ section.id }} .q-btn{max-width:100%;white-space:normal;}
  .q-form-scope-{{ section.id }} .q-actions{flex-wrap:wrap;}
</style>

<section
  data-q-form-host data-q-waitlist
  data-product-id="{{ waitlist_product.id | escape }}"
  id="{{ anchor | escape }}"
  class="q-form-scope-{{ section.id }} q-form q-form--waitlist{{ visibility_classes }}"
  role="region"
  aria-label="{{ s.aria_label | default: 'Product waitlist form' | escape }}"
  data-template="{{ s.template_style | default: 'inline' | escape }}"
  data-surface="{{ s.surface_style | default: 'card' | escape }}"
  data-container="{{ s.container_mode | default: 'contained' | escape }}"
  data-msg-error="{{ s.error_text | escape }}"
  data-msg-success="{{ s.success_text | escape }}"
  data-captcha="{{ eff_captcha_mode | escape }}"
  data-captcha-key="{{ eff_captcha_key | escape }}"
  data-btn-variant="{{ btn_mode_class | escape }}"
  data-bind-mode="{{ s.bind_mode | default: 'auto' | escape }}"
  data-product-handle="{{ waitlist_product.handle | escape }}"
>
  <div class="q-bleed">
    <div class="q-bg" aria-hidden="true">
      {%- if s.bg_image != blank -%}
        {{ s.bg_image | image_url: width: 2560 | image_tag: widths: '960,1440,1920,2560', sizes: '100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: '' }}
      {%- else -%}
        <div class="q-media" style="background: var(--q-bg);"></div>
      {%- endif -%}

      {%- if s.overlay_type == 'gradient' -%}
        {%- assign g1c = s.grad_start | default: '#000000' -%}
        {%- assign g2c = s.grad_end   | default: '#000000' -%}
        {%- assign g1o = s.grad_start_opacity | default: 35 | divided_by: 100.0 -%}
        {%- assign g2o = s.grad_end_opacity   | default: 0  | divided_by: 100.0 -%}
        <div class="q-overlay" style="background: linear-gradient({{ s.grad_angle | default: 180 }}deg, {{ g1c | color_modify: 'alpha', g1o }}, {{ g2c | color_modify: 'alpha', g2o }});"></div>
      {%- elsif s.overlay_type == 'solid' -%}
        <div class="q-overlay" style="background-color: {{ s.overlay_color | default: '#000000' }}; opacity: {{ s.overlay_opacity | default: 30 | divided_by: 100.0 }};"></div>
      {%- endif -%}
    </div>

    <div class="q-layer">
      <div class="q-wrap">
        <div class="q-grid{% if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'left' %} split-left{% elsif s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'right' %} split-right{% endif %}">
          {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'left' -%}
            <div class="q-media-card">
              {{ s.split_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: s.split_image.alt }}
            </div>
          {%- endif -%}

          <div class="q-card" data-q-form-card>
            <header class="q-head">
              {%- if s.kicker != blank -%}<p class="q-kicker">{{ s.kicker | escape }}</p>{%- endif -%}
              {%- assign htag = s.heading_level | default: 'h3' -%}
              {%- if s.heading != blank -%}{% if htag == 'h2' %}<h2 class="q-heading">{{ s.heading | escape }}</h2>{% else %}<h3 class="q-heading">{{ s.heading | escape }}</h3>{% endif %}{%- endif -%}
              {%- if s.subheading != blank -%}<p class="q-sub">{{ s.subheading | escape }}</p>{%- endif -%}
            </header>

            {% if has_waitlist_product %}
              {% render 'form-dispatch',
                id: section.id,
                settings: s,
                theme_settings: g,
                form_source: 'waitlist',
                waitlist_product: waitlist_product,
                waitlist_url: waitlist_url,
                eff_captcha_mode: eff_captcha_mode,
                eff_captcha_key: eff_captcha_key,
                eff_endpoint_url: eff_endpoint,
                eff_tags: eff_tags
              %}
            {% else %}
              <p class="q-live" role="status">{% if request.design_mode %}Choose a published product handle, or add this section to a product page, to enable the waitlist.{% else %}This product waitlist is currently unavailable.{% endif %}</p>
            {% endif %}
            {% if request.design_mode and s.destination == 'shopify_customer' %}<p class="q-help">Shopify Customer records an email marketing signup. Configure a notification integration or a custom endpoint before promising automated restock alerts. Native custom-field storage and tag behavior require live verification.</p>{% endif %}
          </div>

          {%- if s.template_style == 'split' and s.split_image != blank and s.split_media_side == 'right' -%}
            <div class="q-media-card">
              {{ s.split_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '(min-width:768px) 50vw, 100vw', loading: 'lazy', class: 'q-media', decoding: 'async', alt: s.split_image.alt }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'frontend-form-logic.js' | asset_url }}" defer></script>

  <script src="{{ 'form-waitlist.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Form – Waitlist",
  "tag": "section",
  "class": "q-form q-form--waitlist",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Product waitlist form" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "template_style", "label": "Template", "default": "inline", "options": [
      { "value": "inline", "label": "Inline (PDP minimal)" },
      { "value": "card", "label": "Card (landing)" },
      { "value": "split", "label": "Split (image + form)" }
    ]},
    { "type": "select", "id": "surface_style", "label": "Surface chrome", "info": "Inline always uses a minimal frameless surface. Card and Split use this setting.", "default": "card", "options": [
      { "value": "card", "label": "Card" },
      { "value": "frameless", "label": "Frameless (no card)" }
    ]},
    { "type": "select", "id": "split_media_side", "label": "Split: media side", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ]},
    { "type": "image_picker", "id": "split_image", "label": "Split image" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Back in stock" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get notified when it’s back" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "default": "h3", "options": [
      { "value": "h2", "label": "H2" },
      { "value": "h3", "label": "H3" }
    ]},
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We’ll email you as soon as this variant is restocked." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Notify Me" },
    { "type": "checkbox", "id": "show_first_name", "label": "Show first name field", "default": false },

    { "type": "header", "content": "Variant Binding" },
    { "type": "select", "id": "bind_mode", "label": "Bind mode", "info": "Auto syncs a uniquely identified product purchase form on the matching product page. The waitlist picker remains available; unrelated forms and quick views are ignored.", "default": "auto", "options": [
      { "value": "auto", "label": "Auto-detect from PDP (recommended)" },
      { "value": "manual", "label": "Manual only (show picker)" }
    ]},
    { "type": "text", "id": "product_handle", "label": "Product handle (optional override)", "info": "Defaults to the current product on product pages. Elsewhere choose a published handle. Missing/unpublished products leave the form unavailable; variants render natively without a network request." },
    { "type": "text", "id": "variant_placeholder", "label": "Variant placeholder", "default": "Select a variant…" },
    { "type": "text", "id": "variant_help", "label": "Variant help text", "default": "Choose size/color to join the waitlist." },

    { "type": "header", "content": "Consent & Privacy" },
    { "type": "text", "id": "consent_label", "label": "Consent label", "default": "I agree to receive an email when this item is back in stock." },
    { "type": "url", "id": "privacy_link", "label": "Privacy link (URL)" },
    { "type": "text", "id": "privacy_text", "label": "Privacy link label", "default": "Privacy Policy" },

    { "type": "header", "content": "Routing" },
    { "type": "select", "id": "destination", "label": "Destination", "info": "Shopify Customer is an email marketing signup. Automated restock delivery requires a configured notification integration or a custom endpoint that processes inventory events. Match storefront copy to the service actually enabled.", "default": "shopify_customer", "options": [
      { "value": "shopify_customer", "label": "Shopify Customer (tags + marketing consent)" },
      { "value": "custom_endpoint", "label": "Custom endpoint (POST)" }
    ]},
    { "type": "url", "id": "endpoint_url", "label": "Custom endpoint URL (HTTPS)", "info": "The endpoint must process the POST, consent, captcha and notification service. Variant ID is submitted natively; label and enriched tags require JavaScript." },
    { "type": "text", "id": "hidden_tags", "label": "Hidden tags (comma-separated)", "default": "waitlist, web" },

    { "type": "header", "content": "Captcha" },
    { "type": "select", "id": "captcha_mode", "label": "Captcha", "info": "Custom endpoints only, with server verification. Native Customer signup uses Shopify spam protection.", "default": "none", "options": [
      { "value": "none", "label": "None" },
      { "value": "turnstile", "label": "Cloudflare Turnstile" },
      { "value": "recaptcha_v3", "label": "reCAPTCHA v3" }
    ]},
    { "type": "text", "id": "captcha_site_key", "label": "Captcha site key" },

    { "type": "header", "content": "Button & Inputs" },
    { "type": "select", "id": "button_variant", "label": "Button variant", "default": "inherit", "options": [
      { "value": "inherit", "label": "— Theme default —" },
      { "value": "solid", "label": "Solid" },
      { "value": "outline", "label": "Outline" },
      { "value": "ghost", "label": "Ghost" }
    ]},
    { "type": "color", "id": "form_bg", "label": "Form background", "default": "#ffffff" },
    { "type": "range", "id": "input_radius", "label": "Input radius", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "color", "id": "input_border", "label": "Input border color", "default": "#e5e7eb" },

    { "type": "header", "content": "Sizing & Background" },
    { "type": "select", "id": "container_mode", "label": "Container", "default": "contained", "options": [
      { "value": "contained", "label": "Contained" },
      { "value": "full", "label": "Full-bleed" }
    ]},
    { "type": "range", "id": "padding_y", "label": "Padding Y", "min": 0, "max": 160, "step": 8, "default": 40 },
    { "type": "range", "id": "padding_x", "label": "Padding X", "min": 0, "max": 120, "step": 8, "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 28, "step": 1, "default": 14 },
    { "type": "range", "id": "card_shadow", "label": "Card elevation", "min": 0, "max": 3, "step": 1, "default": 2 },

    { "type": "header", "content": "Overlay (optional)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f6f7f8" },
    { "type": "select", "id": "overlay_type", "label": "Overlay", "default": "none", "options": [
      { "value": "none", "label": "None" },
      { "value": "solid", "label": "Solid" },
      { "value": "gradient", "label": "Gradient" }
    ]},
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 30, "unit": "%" },
    { "type": "color", "id": "grad_start", "label": "Gradient start", "default": "#000000" },
    { "type": "range", "id": "grad_start_opacity", "label": "Start opacity", "min": 0, "max": 100, "step": 5, "default": 35, "unit": "%" },
    { "type": "color", "id": "grad_end", "label": "Gradient end", "default": "#000000" },
    { "type": "range", "id": "grad_end_opacity", "label": "End opacity", "min": 0, "max": 100, "step": 5, "default": 0, "unit": "%" },
    { "type": "range", "id": "grad_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 5, "default": 180, "unit": "deg" },

    { "type": "header", "content": "Visibility" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false },

    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "success_text", "label": "Success message", "info": "Shown only after a successful native Shopify response. Do not promise automatic alerts unless an integration actually sends them; custom endpoints own their response.", "default": "All set — we’ll email you the moment it’s available." },
