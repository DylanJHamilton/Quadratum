{%- liquid
  assign block_id = 'product-payment-methods-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign layout_style = block.settings.layout_style | default: 'badges'
  assign display_mode = block.settings.display_mode | default: 'mixed'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-payment-methods
    product-payment-methods--{{ layout_style }}
    product-payment-methods--mode-{{ display_mode }}
    product-payment-methods--width-{{ width }}
    product-payment-methods--align-{{ alignment }}
    {% unless show_on_desktop %} product-payment-methods--hide-desktop{% endunless %}
    {% unless show_on_tablet %} product-payment-methods--hide-tablet{% endunless %}
    {% unless show_on_mobile %} product-payment-methods--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} product-payment-methods--animate product-payment-methods--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-payment-methods-margin-top: {{ block.settings.margin_top }}px;
    --product-payment-methods-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-payment-methods-padding: {{ block.settings.padding }}px;
    --product-payment-methods-gap: {{ block.settings.item_gap }}px;
    --product-payment-methods-card-padding: {{ block.settings.card_padding }}px;
    --product-payment-methods-radius: {{ block.settings.card_radius }}px;
    --product-payment-methods-border-width: {{ block.settings.border_width }}px;
    --product-payment-methods-icon-size: {{ block.settings.icon_size }}px;
    --product-payment-methods-heading-color: {{ block.settings.heading_color }};
    --product-payment-methods-text-color: {{ block.settings.text_color }};
    --product-payment-methods-muted-color: {{ block.settings.muted_color }};
    --product-payment-methods-background: {{ block.settings.background_color }};
    --product-payment-methods-card-background: {{ block.settings.card_background_color }};
    --product-payment-methods-border-color: {{ block.settings.border_color }};
    --product-payment-methods-accent-color: {{ block.settings.accent_color }};
    --product-payment-methods-badge-background: {{ block.settings.badge_background_color }};
    --product-payment-methods-badge-text: {{ block.settings.badge_text_color }};
    --product-payment-methods-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-product-payment-methods
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--product-payment-methods-margin-top);
      margin-bottom: var(--product-payment-methods-margin-bottom);
      padding: var(--product-payment-methods-padding);
      color: var(--product-payment-methods-text-color);
      background: var(--product-payment-methods-background);
    }

    #{{ block_id }}.product-payment-methods--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-payment-methods--width-small {
      max-width: 520px;
    }

    #{{ block_id }}.product-payment-methods--width-medium {
      max-width: 760px;
    }

    #{{ block_id }}.product-payment-methods--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-payment-methods--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-payment-methods--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-payment-methods--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-payment-methods--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-payment-methods__inner {
      display: grid;
      gap: 14px;
      min-width: 0;
    }

    #{{ block_id }}.product-payment-methods--cards .product-payment-methods__inner,
    #{{ block_id }}.product-payment-methods--grid .product-payment-methods__inner {
      padding: var(--product-payment-methods-card-padding);
      background: var(--product-payment-methods-card-background);
      border: var(--product-payment-methods-border-width) solid var(--product-payment-methods-border-color);
      border-radius: var(--product-payment-methods-radius);
    }

    #{{ block_id }} .product-payment-methods__header {
      display: grid;
      gap: 6px;
      max-width: 720px;
    }

    #{{ block_id }}.product-payment-methods--align-center .product-payment-methods__header {
      margin-left: auto;
      margin-right: auto;
      justify-items: center;
    }

    #{{ block_id }}.product-payment-methods--align-right .product-payment-methods__header {
      margin-left: auto;
      margin-right: 0;
      justify-items: end;
    }

    #{{ block_id }} .product-payment-methods__eyebrow {
      margin: 0;
      color: var(--product-payment-methods-muted-color);
      font-size: 0.78em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #{{ block_id }} .product-payment-methods__heading {
      margin: 0;
      color: var(--product-payment-methods-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.15;
    }

    #{{ block_id }} .product-payment-methods__description {
      margin: 0;
      color: var(--product-payment-methods-text-color);
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.5;
      opacity: 0.86;
    }

    #{{ block_id }} .product-payment-methods__financing-note {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      margin: 0;
      padding: 10px 12px;
      color: var(--product-payment-methods-text-color);
      background: color-mix(in srgb, var(--product-payment-methods-accent-color), transparent 90%);
      border: 1px solid color-mix(in srgb, var(--product-payment-methods-accent-color), transparent 75%);
      border-radius: max(calc(var(--product-payment-methods-radius) - 8px), 8px);
      font-size: {{ block.settings.financing_note_size }}px;
      line-height: 1.45;
    }

    #{{ block_id }}.product-payment-methods--align-center .product-payment-methods__financing-note {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ block_id }}.product-payment-methods--align-right .product-payment-methods__financing-note {
      margin-left: auto;
      margin-right: 0;
    }

    #{{ block_id }} .product-payment-methods__financing-note-icon {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      color: #ffffff;
      background: var(--product-payment-methods-accent-color);
      border-radius: 999px;
      font-size: 12px;
      line-height: 1;
      font-weight: 800;
    }

    #{{ block_id }} .product-payment-methods__groups {
      display: grid;
      gap: 16px;
      min-width: 0;
    }

    #{{ block_id }} .product-payment-methods__group {
      display: grid;
      gap: 10px;
      min-width: 0;
    }

    #{{ block_id }} .product-payment-methods__group-title {
      margin: 0;
      color: var(--product-payment-methods-heading-color);
      font-size: {{ block.settings.group_title_size }}px;
      line-height: 1.25;
    }

    #{{ block_id }} .product-payment-methods__list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--product-payment-methods-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-payment-methods--align-center .product-payment-methods__list {
      justify-content: center;
    }

    #{{ block_id }}.product-payment-methods--align-right .product-payment-methods__list {
      justify-content: flex-end;
    }

    #{{ block_id }}.product-payment-methods--grid .product-payment-methods__list {
      display: grid;
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    }

    #{{ block_id }}.product-payment-methods--cards .product-payment-methods__list {
      display: grid;
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    }

    #{{ block_id }} .product-payment-methods__item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: {{ block.settings.item_height }}px;
      min-width: {{ block.settings.item_min_width }}px;
      padding: 8px 12px;
      color: var(--product-payment-methods-badge-text);
      background: var(--product-payment-methods-badge-background);
      border: var(--product-payment-methods-border-width) solid var(--product-payment-methods-border-color);
      border-radius: max(calc(var(--product-payment-methods-radius) - 10px), 8px);
      line-height: 1.2;
      font-size: {{ block.settings.item_text_size }}px;
      font-weight: 700;
      white-space: nowrap;
    }

    #{{ block_id }}.product-payment-methods--inline .product-payment-methods__item {
      min-width: auto;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      color: var(--product-payment-methods-text-color);
    }

    #{{ block_id }}.product-payment-methods--cards .product-payment-methods__item,
    #{{ block_id }}.product-payment-methods--grid .product-payment-methods__item {
      justify-content: flex-start;
      width: 100%;
      white-space: normal;
    }

    #{{ block_id }} .product-payment-methods__icon {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--product-payment-methods-icon-size);
      height: var(--product-payment-methods-icon-size);
      color: var(--product-payment-methods-accent-color);
      background: color-mix(in srgb, var(--product-payment-methods-accent-color), transparent 90%);
      border-radius: 7px;
      font-size: calc(var(--product-payment-methods-icon-size) * 0.45);
      line-height: 1;
      font-weight: 900;
      letter-spacing: -0.04em;
      overflow: hidden;
    }

    #{{ block_id }} .product-payment-methods__icon img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #{{ block_id }} .product-payment-methods__icon svg {
      display: block;
      width: 70%;
      height: 70%;
    }

    #{{ block_id }} .product-payment-methods__label {
      min-width: 0;
    }

    #{{ block_id }} .product-payment-methods__small-text {
      display: block;
      margin-top: 2px;
      color: var(--product-payment-methods-muted-color);
      font-size: 0.82em;
      font-weight: 500;
      line-height: 1.25;
    }

    #{{ block_id }}.product-payment-methods--badges .product-payment-methods__small-text,
    #{{ block_id }}.product-payment-methods--inline .product-payment-methods__small-text {
      display: none;
    }

    #{{ block_id }} .product-payment-methods__footer {
      margin: 0;
      color: var(--product-payment-methods-muted-color);
      font-size: {{ block.settings.footer_text_size }}px;
      line-height: 1.45;
    }

    #{{ block_id }}.product-payment-methods--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-payment-methods--animate-fade {
      animation-name: productPaymentMethodsFade;
    }

    #{{ block_id }}.product-payment-methods--animate-fade_up {
      animation-name: productPaymentMethodsFadeUp;
    }

    #{{ block_id }}.product-payment-methods--animate-zoom {
      animation-name: productPaymentMethodsZoom;
    }

    @keyframes productPaymentMethodsFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productPaymentMethodsFadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productPaymentMethodsZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-payment-methods--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-payment-methods--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.product-payment-methods--grid .product-payment-methods__list,
      #{{ block_id }}.product-payment-methods--cards .product-payment-methods__list {
        grid-template-columns: repeat({{ block.settings.columns_tablet }}, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-payment-methods--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .product-payment-methods__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }}.product-payment-methods--grid .product-payment-methods__list,
      #{{ block_id }}.product-payment-methods--cards .product-payment-methods__list {
        grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      }

      #{{ block_id }} .product-payment-methods__item {
        min-width: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-payment-methods--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }
    }
  </style>

  <div class="product-payment-methods__inner">
    {% if block.settings.show_header %}
      <div class="product-payment-methods__header">
        {% if block.settings.eyebrow != blank %}
          <p class="product-payment-methods__eyebrow">
            {{ block.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="product-payment-methods__heading">
            {{ block.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="product-payment-methods__description">
            {{ block.settings.description | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_financing_note and display_mode != 'payment_methods' %}
      <p class="product-payment-methods__financing-note">
        {% if block.settings.show_icons %}
          <span class="product-payment-methods__financing-note-icon" aria-hidden="true">
            %
          </span>
        {% endif %}
        <span>{{ block.settings.financing_note | escape }}</span>
      </p>
    {% endif %}

    <div class="product-payment-methods__groups">
      {% if display_mode == 'payment_methods' or display_mode == 'mixed' %}
        <div class="product-payment-methods__group">
          {% if block.settings.show_group_titles %}
            <h3 class="product-payment-methods__group-title">
              {{ block.settings.payment_group_title | escape }}
            </h3>
          {% endif %}

          <div class="product-payment-methods__list" aria-label="{{ block.settings.payment_methods_label | escape }}">
            {% if block.settings.enable_shop_pay %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">SP</span>{% endif %}
                {% if block.settings.show_labels %}<span class="product-payment-methods__label">Shop Pay</span>{% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_apple_pay %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}
                  <span class="product-payment-methods__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img">
                      <path fill="currentColor" d="M16.7 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.7-1.8-3.3-1.8-1.4-.1-2.7.8-3.4.8-.7 0-1.8-.8-2.9-.8-1.5 0-2.9.9-3.7 2.2-1.6 2.8-.4 6.9 1.1 9.1.8 1.1 1.7 2.3 2.9 2.2 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.2.9-1.3 1.2-2.5 1.2-2.6 0-.1-2.6-1-2.7-3.4zM14.5 5.8c.6-.8 1-1.8.9-2.8-.9 0-2 .6-2.6 1.3-.6.7-1.1 1.7-1 2.7 1 .1 2-.5 2.7-1.2z"/>
                    </svg>
                  </span>
                {% endif %}
                {% if block.settings.show_labels %}<span class="product-payment-methods__label">Apple Pay</span>{% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_google_pay %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">G</span>{% endif %}
                {% if block.settings.show_labels %}<span class="product-payment-methods__label">Google Pay</span>{% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_paypal %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">PP</span>{% endif %}
                {% if block.settings.show_labels %}<span class="product-payment-methods__label">PayPal</span>{% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_venmo %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">V</span>{% endif %}
                {% if block.settings.show_labels %}<span class="product-payment-methods__label">Venmo</span>{% endif %}
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if display_mode == 'financing' or display_mode == 'mixed' %}
        <div class="product-payment-methods__group">
          {% if block.settings.show_group_titles %}
            <h3 class="product-payment-methods__group-title">
              {{ block.settings.financing_group_title | escape }}
            </h3>
          {% endif %}

          <div class="product-payment-methods__list" aria-label="{{ block.settings.financing_methods_label | escape }}">
            {% if block.settings.enable_affirm %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">A</span>{% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    Affirm
                    <span class="product-payment-methods__small-text">{{ block.settings.affirm_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_klarna %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">K</span>{% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    Klarna
                    <span class="product-payment-methods__small-text">{{ block.settings.klarna_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_afterpay %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">AP</span>{% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    Afterpay
                    <span class="product-payment-methods__small-text">{{ block.settings.afterpay_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_sezzle %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">S</span>{% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    Sezzle
                    <span class="product-payment-methods__small-text">{{ block.settings.sezzle_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_zip %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}<span class="product-payment-methods__icon" aria-hidden="true">Z</span>{% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    Zip
                    <span class="product-payment-methods__small-text">{{ block.settings.zip_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.enable_custom_method_1 or block.settings.enable_custom_method_2 or block.settings.enable_custom_method_3 %}
        <div class="product-payment-methods__group">
          {% if block.settings.show_group_titles %}
            <h3 class="product-payment-methods__group-title">
              {{ block.settings.custom_group_title | escape }}
            </h3>
          {% endif %}

          <div class="product-payment-methods__list" aria-label="{{ block.settings.custom_methods_label | escape }}">
            {% if block.settings.enable_custom_method_1 %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}
                  <span class="product-payment-methods__icon" aria-hidden="true">
                    {% if block.settings.custom_icon_1 %}
                      {{ block.settings.custom_icon_1 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: block.settings.custom_method_1_label }}
                    {% else %}
                      {{ block.settings.custom_method_1_short | escape }}
                    {% endif %}
                  </span>
                {% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    {{ block.settings.custom_method_1_label | escape }}
                    <span class="product-payment-methods__small-text">{{ block.settings.custom_method_1_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_custom_method_2 %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}
                  <span class="product-payment-methods__icon" aria-hidden="true">
                    {% if block.settings.custom_icon_2 %}
                      {{ block.settings.custom_icon_2 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: block.settings.custom_method_2_label }}
                    {% else %}
                      {{ block.settings.custom_method_2_short | escape }}
                    {% endif %}
                  </span>
                {% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    {{ block.settings.custom_method_2_label | escape }}
                    <span class="product-payment-methods__small-text">{{ block.settings.custom_method_2_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}

            {% if block.settings.enable_custom_method_3 %}
              <span class="product-payment-methods__item">
                {% if block.settings.show_icons %}
                  <span class="product-payment-methods__icon" aria-hidden="true">
                    {% if block.settings.custom_icon_3 %}
                      {{ block.settings.custom_icon_3 | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: block.settings.custom_method_3_label }}
                    {% else %}
                      {{ block.settings.custom_method_3_short | escape }}
                    {% endif %}
                  </span>
                {% endif %}
                {% if block.settings.show_labels %}
                  <span class="product-payment-methods__label">
                    {{ block.settings.custom_method_3_label | escape }}
                    <span class="product-payment-methods__small-text">{{ block.settings.custom_method_3_note | escape }}</span>
                  </span>
                {% endif %}
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.footer_text != blank %}
      <p class="product-payment-methods__footer">
        {{ block.settings.footer_text | escape }}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product payment methods",
