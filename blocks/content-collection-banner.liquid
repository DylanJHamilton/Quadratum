{%- liquid
  assign block_id = 'content-collection-banner-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant

  assign selected_collection = block.settings.collection
  assign banner_layout = block.settings.banner_layout | default: 'standard'
  assign content_position = block.settings.content_position | default: 'center-left'

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile

  assign banner_image = block.settings.image

  if banner_image == blank and selected_collection != blank
    assign banner_image = selected_collection.image | default: selected_collection.featured_image
  endif
-%}

<div
  id="{{ block_id }}"
  class="
    content-collection-banner
    content-collection-banner--{{ banner_layout }}
    content-collection-banner--position-{{ content_position }}
    content-collection-banner--width-{{ width }}
    content-collection-banner--align-{{ alignment }}
    {% unless show_on_desktop %} content-collection-banner--hide-desktop{% endunless %}
    {% unless show_on_tablet %} content-collection-banner--hide-tablet{% endunless %}
    {% unless show_on_mobile %} content-collection-banner--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' %} content-collection-banner--animate content-collection-banner--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --content-collection-banner-margin-top: {{ block.settings.margin_top }}px;
    --content-collection-banner-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-collection-banner-padding: {{ block.settings.padding }}px;
    --content-collection-banner-inner-padding: {{ block.settings.inner_padding }}px;
    --content-collection-banner-min-height: {{ block.settings.min_height }}px;
    --content-collection-banner-min-height-mobile: {{ block.settings.min_height_mobile }}px;
    --content-collection-banner-radius: {{ block.settings.banner_radius }}px;
    --content-collection-banner-border-width: {{ block.settings.border_width }}px;
    --content-collection-banner-content-width: {{ block.settings.content_width }}px;
    --content-collection-banner-content-gap: {{ block.settings.content_gap }}px;
    --content-collection-banner-heading-color: {{ block.settings.heading_color }};
    --content-collection-banner-text-color: {{ block.settings.text_color }};
    --content-collection-banner-background: {{ block.settings.background_color }};
    --content-collection-banner-border-color: {{ block.settings.border_color }};
    --content-collection-banner-overlay-color: {{ block.settings.overlay_color }};
    --content-collection-banner-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --content-collection-banner-button-background: {{ block.settings.button_background_color }};
    --content-collection-banner-button-text: {{ block.settings.button_text_color }};
    --content-collection-banner-secondary-button-background: {{ block.settings.secondary_button_background_color }};
    --content-collection-banner-secondary-button-text: {{ block.settings.secondary_button_text_color }};
    --content-collection-banner-focus-color: {{ block.settings.focus_color }};
  "
  {% if product_context != blank %}
    data-product-id="{{ product_context.id }}"
    data-variant-id="{{ current_variant.id }}"
  {% endif %}
  data-content-collection-banner
  {{ block.shopify_attributes }}
>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-collection-banner-margin-top);
      margin-bottom: var(--content-collection-banner-margin-bottom);
      padding: var(--content-collection-banner-padding);
      color: var(--content-collection-banner-text-color);
      background: var(--content-collection-banner-background);
    }

    #{{ block_id }}.content-collection-banner--width-auto {
      max-width: none;
    }

    #{{ block_id }}.content-collection-banner--width-small {
      max-width: 920px;
    }

    #{{ block_id }}.content-collection-banner--width-medium {
      max-width: 1120px;
    }

    #{{ block_id }}.content-collection-banner--width-large {
      max-width: 1360px;
    }

    #{{ block_id }}.content-collection-banner--width-full {
      max-width: none;
    }

    #{{ block_id }}.content-collection-banner--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-collection-banner--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-collection-banner--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-collection-banner__shell {
      position: relative;
      display: grid;
      min-height: var(--content-collection-banner-min-height);
      overflow: hidden;
      isolation: isolate;
      color: var(--content-collection-banner-text-color);
      background: var(--content-collection-banner-background);
      border: var(--content-collection-banner-border-width) solid var(--content-collection-banner-border-color);
      border-radius: var(--content-collection-banner-radius);
    }

    #{{ block_id }}.content-collection-banner--split .content-collection-banner__shell {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      min-height: auto;
      background: var(--content-collection-banner-background);
    }

    #{{ block_id }}.content-collection-banner--split.content-collection-banner--position-center-right .content-collection-banner__media,
    #{{ block_id }}.content-collection-banner--split.content-collection-banner--position-bottom-right .content-collection-banner__media,
    #{{ block_id }}.content-collection-banner--split.content-collection-banner--position-top-right .content-collection-banner__media {
      order: 2;
    }

    #{{ block_id }}.content-collection-banner--split.content-collection-banner--position-center-right .content-collection-banner__content-wrap,
    #{{ block_id }}.content-collection-banner--split.content-collection-banner--position-bottom-right .content-collection-banner__content-wrap,
    #{{ block_id }}.content-collection-banner--split.content-collection-banner--position-top-right .content-collection-banner__content-wrap {
      order: 1;
    }

    #{{ block_id }} .content-collection-banner__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      background: #f6f6f6;
    }

    #{{ block_id }}.content-collection-banner--split .content-collection-banner__media {
      position: relative;
      min-height: var(--content-collection-banner-min-height);
    }

    #{{ block_id }} .content-collection-banner__media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--content-collection-banner-overlay-color);
      opacity: var(--content-collection-banner-overlay-opacity);
      pointer-events: none;
    }

    #{{ block_id }}.content-collection-banner--split .content-collection-banner__media::after {
      opacity: calc(var(--content-collection-banner-overlay-opacity) * 0.55);
    }

    #{{ block_id }} .content-collection-banner__media img,
    #{{ block_id }} .content-collection-banner__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
    }

    #{{ block_id }} .content-collection-banner__placeholder {
      background:
        radial-gradient(circle at top left, rgba(255, 255, 255, 0.42), transparent 36%),
        linear-gradient(135deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.18));
    }

    #{{ block_id }} .content-collection-banner__content-wrap {
      position: relative;
      z-index: 2;
      display: grid;
      align-items: center;
      min-width: 0;
      padding: var(--content-collection-banner-inner-padding);
    }

    #{{ block_id }}.content-collection-banner--position-top-left .content-collection-banner__content-wrap,
    #{{ block_id }}.content-collection-banner--position-top-center .content-collection-banner__content-wrap,
    #{{ block_id }}.content-collection-banner--position-top-right .content-collection-banner__content-wrap {
      align-items: start;
    }

    #{{ block_id }}.content-collection-banner--position-bottom-left .content-collection-banner__content-wrap,
    #{{ block_id }}.content-collection-banner--position-bottom-center .content-collection-banner__content-wrap,
    #{{ block_id }}.content-collection-banner--position-bottom-right .content-collection-banner__content-wrap {
      align-items: end;
    }

    #{{ block_id }}.content-collection-banner--split .content-collection-banner__content-wrap {
      min-height: var(--content-collection-banner-min-height);
      background: var(--content-collection-banner-background);
    }

    #{{ block_id }} .content-collection-banner__content {
      display: grid;
      gap: var(--content-collection-banner-content-gap);
      width: 100%;
      max-width: var(--content-collection-banner-content-width);
      min-width: 0;
    }

    #{{ block_id }}.content-collection-banner--position-top-left .content-collection-banner__content,
    #{{ block_id }}.content-collection-banner--position-center-left .content-collection-banner__content,
    #{{ block_id }}.content-collection-banner--position-bottom-left .content-collection-banner__content {
      justify-items: start;
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.content-collection-banner--position-top-center .content-collection-banner__content,
    #{{ block_id }}.content-collection-banner--position-center-center .content-collection-banner__content,
    #{{ block_id }}.content-collection-banner--position-bottom-center .content-collection-banner__content {
      justify-items: center;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.content-collection-banner--position-top-right .content-collection-banner__content,
    #{{ block_id }}.content-collection-banner--position-center-right .content-collection-banner__content,
    #{{ block_id }}.content-collection-banner--position-bottom-right .content-collection-banner__content {
      justify-items: end;
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .content-collection-banner__eyebrow {
      margin: 0;
      color: var(--content-collection-banner-text-color);
      font-size: 0.82em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.82;
    }

    #{{ block_id }} .content-collection-banner__heading {
      margin: 0;
      color: var(--content-collection-banner-heading-color);
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.02;
      letter-spacing: -0.03em;
    }

    #{{ block_id }} .content-collection-banner__text {
      margin: 0;
      color: var(--content-collection-banner-text-color);
      font-size: {{ block.settings.text_size }}px;
      line-height: 1.6;
      opacity: 0.9;
    }

    #{{ block_id }} .content-collection-banner__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      color: var(--content-collection-banner-text-color);
      font-size: 0.94em;
      line-height: 1.35;
      opacity: 0.78;
    }

    #{{ block_id }}.content-collection-banner--position-top-center .content-collection-banner__meta,
    #{{ block_id }}.content-collection-banner--position-center-center .content-collection-banner__meta,
    #{{ block_id }}.content-collection-banner--position-bottom-center .content-collection-banner__meta {
      justify-content: center;
    }

    #{{ block_id }}.content-collection-banner--position-top-right .content-collection-banner__meta,
    #{{ block_id }}.content-collection-banner--position-center-right .content-collection-banner__meta,
    #{{ block_id }}.content-collection-banner--position-bottom-right .content-collection-banner__meta {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-collection-banner__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #{{ block_id }}.content-collection-banner--position-top-center .content-collection-banner__buttons,
    #{{ block_id }}.content-collection-banner--position-center-center .content-collection-banner__buttons,
    #{{ block_id }}.content-collection-banner--position-bottom-center .content-collection-banner__buttons {
      justify-content: center;
    }

    #{{ block_id }}.content-collection-banner--position-top-right .content-collection-banner__buttons,
    #{{ block_id }}.content-collection-banner--position-center-right .content-collection-banner__buttons,
    #{{ block_id }}.content-collection-banner--position-bottom-right .content-collection-banner__buttons {
      justify-content: flex-end;
    }

    #{{ block_id }} .content-collection-banner__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: {{ block.settings.button_height }}px;
      padding: 12px 18px;
      color: var(--content-collection-banner-button-text);
      background: var(--content-collection-banner-button-background);
      border: 1px solid var(--content-collection-banner-button-background);
      border-radius: {{ block.settings.button_radius }}px;
      text-decoration: none;
      line-height: 1.2;
      font: inherit;
      font-weight: 700;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-collection-banner__button--secondary {
      color: var(--content-collection-banner-secondary-button-text);
      background: var(--content-collection-banner-secondary-button-background);
      border-color: var(--content-collection-banner-secondary-button-text);
    }

    #{{ block_id }} .content-collection-banner__button:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #{{ block_id }} .content-collection-banner__button:focus-visible {
      outline: 2px solid var(--content-collection-banner-focus-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .content-collection-banner__empty {
      padding: 18px;
      color: var(--content-collection-banner-text-color);
      background: var(--content-collection-banner-background);
      border: var(--content-collection-banner-border-width) solid var(--content-collection-banner-border-color);
      border-radius: var(--content-collection-banner-radius);
      line-height: 1.45;
    }

    #{{ block_id }}.content-collection-banner--light-text .content-collection-banner__eyebrow,
    #{{ block_id }}.content-collection-banner--light-text .content-collection-banner__heading,
    #{{ block_id }}.content-collection-banner--light-text .content-collection-banner__text,
    #{{ block_id }}.content-collection-banner--light-text .content-collection-banner__meta {
      color: #ffffff;
      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.22);
    }

    #{{ block_id }}.content-collection-banner--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-collection-banner--animate-fade {
      animation-name: contentCollectionBannerFade;
    }

    #{{ block_id }}.content-collection-banner--animate-fade_up {
      animation-name: contentCollectionBannerFadeUp;
    }

    #{{ block_id }}.content-collection-banner--animate-zoom {
      animation-name: contentCollectionBannerZoom;
    }

    @keyframes contentCollectionBannerFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentCollectionBannerFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentCollectionBannerZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-collection-banner--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-collection-banner--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-collection-banner--split .content-collection-banner__shell {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-collection-banner--split .content-collection-banner__media,
      #{{ block_id }}.content-collection-banner--split .content-collection-banner__content-wrap {
        order: initial;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-collection-banner--hide-mobile {
        display: none !important;
      }

      #{{ block_id }} .content-collection-banner__shell {
        min-height: var(--content-collection-banner-min-height-mobile);
      }

      #{{ block_id }}.content-collection-banner--split .content-collection-banner__shell {
        grid-template-columns: minmax(0, 1fr);
      }

      #{{ block_id }}.content-collection-banner--split .content-collection-banner__media,
      #{{ block_id }}.content-collection-banner--split .content-collection-banner__content-wrap {
        order: initial;
      }

      #{{ block_id }}.content-collection-banner--split .content-collection-banner__media {
        min-height: var(--content-collection-banner-min-height-mobile);
      }

      #{{ block_id }}.content-collection-banner--split .content-collection-banner__content-wrap {
        min-height: auto;
      }

      #{{ block_id }} .content-collection-banner__content-wrap {
        padding: max(calc(var(--content-collection-banner-inner-padding) - 12px), 20px);
      }

      #{{ block_id }} .content-collection-banner__heading {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }

      #{{ block_id }} .content-collection-banner__buttons {
        display: grid;
        width: 100%;
      }

      #{{ block_id }} .content-collection-banner__button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-collection-banner--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-collection-banner__button {
        transition: none;
      }

      #{{ block_id }} .content-collection-banner__button:hover {
        transform: none;
      }
    }
  </style>

  {% if selected_collection != blank or block.settings.allow_custom_banner %}
    <div class="content-collection-banner__shell">
      <div class="content-collection-banner__media" aria-hidden="true">
        {% if banner_image %}
          {{ banner_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600, 2000, 2200', alt: banner_image.alt | default: selected_collection.title }}
        {% else %}
          <span class="content-collection-banner__placeholder" aria-hidden="true"></span>
        {% endif %}
      </div>

      <div class="content-collection-banner__content-wrap">
        <div class="content-collection-banner__content">
          {% if block.settings.eyebrow != blank %}
            <p class="content-collection-banner__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          <h2 class="content-collection-banner__heading">
            {% if block.settings.heading != blank %}
              {{ block.settings.heading | escape }}
            {% elsif selected_collection != blank %}
              {{ selected_collection.title | escape }}
            {% else %}
              {{ block.settings.fallback_heading | escape }}
            {% endif %}
          </h2>

          {% if block.settings.show_text %}
            <div class="content-collection-banner__text">
              {% if block.settings.text_source == 'custom' %}
                {{ block.settings.text | escape }}
              {% elsif selected_collection != blank and selected_collection.description != blank %}
                {{ selected_collection.description | strip_html | truncatewords: block.settings.description_words }}
              {% else %}
                {{ block.settings.fallback_text | escape }}
              {% endif %}
            </div>
          {% endif %}

          {% if selected_collection != blank and block.settings.show_product_count %}
            <div class="content-collection-banner__meta">
              <span>
                {{ selected_collection.products_count }} {{ block.settings.product_count_label | escape }}
              </span>
            </div>
          {% endif %}

          <div class="content-collection-banner__buttons">
            {% if block.settings.show_primary_button %}
              <a
                class="content-collection-banner__button"
                href="{% if selected_collection != blank %}{{ selected_collection.url }}{% else %}{{ block.settings.custom_button_link }}{% endif %}"
              >
                {{ block.settings.primary_button_label | escape }}
              </a>
            {% endif %}

            {% if block.settings.show_secondary_button %}
              <a
                class="content-collection-banner__button content-collection-banner__button--secondary"
                href="{% if block.settings.secondary_button_link != blank %}{{ block.settings.secondary_button_link }}{% elsif selected_collection != blank %}{{ selected_collection.url }}{% else %}{{ routes.collections_url }}{% endif %}"
              >
                {{ block.settings.secondary_button_label | escape }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% elsif block.settings.show_empty_state %}
    <div class="content-collection-banner__empty">
      {{ block.settings.empty_text | escape }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "allow_custom_banner",
      "label": "Allow custom banner without collection",
      "default": true
    },

    {
      "type": "header",
      "content": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "banner_layout",
      "label": "Banner layout",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard overlay"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "campaign",
          "label": "Campaign"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "center-left",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Center left"
        },
        {
          "value": "center-center",
          "label": "Center"
        },
        {
          "value": "center-right",
          "label": "Center right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ]
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 240,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height mobile",
      "min": 220,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "content_width",
