{%- comment -%}Capture the rendered URL. Render does not export assignments.{%- endcomment -%}
{%- liquid
  assign out_base_url = results_url
  if is_search_context
    assign query = terms_q | url_encode
    assign out_base_url = routes.search_url | append: '?q=' | append: query | append: '&type=product&options[prefix]=last'
  endif
  if sort_by != blank
    assign encoded_sort = sort_by | url_encode
    if out_base_url contains '?'
      assign out_base_url = out_base_url | append: '&sort_by=' | append: encoded_sort
    else
      assign out_base_url = out_base_url | append: '?sort_by=' | append: encoded_sort
    endif
  endif
-%}{{- out_base_url -}}
