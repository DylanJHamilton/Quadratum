{%- comment -%}Use the deployed sprite for bundled CTA icons; preserve custom flat asset names.{%- endcomment -%}
{%- liquid
  assign icon_file = filename | default: '' | strip
  assign icon_symbol = ''
  if icon_file contains 'lucide/' or icon_file contains 'tabler/'
    assign icon_symbol = icon_file | remove: '.svg' | replace: '/', '-'
  elsif icon_file == 'star.svg' or icon_file == 'users.svg' or icon_file == 'award.svg'
    assign icon_symbol = icon_file | remove: '.svg' | prepend: 'lucide-'
  endif
  assign icon_size = size | default: 24
-%}
{%- if icon_symbol != blank -%}
  <svg class="{{ class | escape }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="{{ 'icons.svg' | asset_url }}#{{ icon_symbol | escape }}"></use></svg>
{%- elsif icon_file != blank -%}
  <img class="{{ class | escape }}" src="{{ icon_file | asset_url }}" width="{{ icon_size }}" height="{{ icon_size }}" alt="" loading="lazy" decoding="async">
{%- endif -%}
