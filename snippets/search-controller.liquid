{%- comment -%}Retained compatibility data hook; no repository consumer. Keep aligned with the active search forms without activating it.{%- endcomment -%}
{%- liquid
  assign search_mode = settings.search_default_form_type | default: 'predictive'
  if settings.enable_predictive_search == false
    assign search_mode = 'static'
  endif
-%}
<script>
  (function () {
    document.documentElement.dataset.searchMode = {{ search_mode | json }};
    window.QTM_SEARCH = {
      mode: {{ search_mode | json }},
      sources: {
        products: {{ settings.search_src_products | default: true, allow_false: true | json }},
        collections: {{ settings.search_src_collections | default: true, allow_false: true | json }},
        articles: {{ settings.search_src_articles | default: true, allow_false: true | json }},
        pages: {{ settings.search_src_pages | default: true, allow_false: true | json }}
      },
      limits: {
        products: {{ settings.predictive_search_products_limit | default: 4 | at_least: 1 | at_most: 10 | json }},
        collections: {{ settings.predictive_search_collections_limit | default: 3 | at_least: 1 | at_most: 10 | json }},
        articles: {{ settings.predictive_search_articles_limit | default: 3 | at_least: 1 | at_most: 10 | json }},
        pages: {{ settings.predictive_search_pages_limit | default: 3 | at_least: 1 | at_most: 10 | json }}
      },
      minChars: {{ settings.predictive_search_min_chars | default: 2 | at_least: 1 | at_most: 5 | json }},
      debounce: {{ settings.predictive_search_debounce | default: 250 | at_least: 100 | at_most: 500 | json }}
    };
  })();
</script>