{% if product != blank %}
{%- liquid
  assign block_id = 'product-form-' | append: block.id

  assign product_context = product
  assign current_variant = product_context.selected_or_first_available_variant
  assign form_id = block_id | append: '-form'
  assign quantity_min = current_variant.quantity_rule.min | default: 1
  assign quantity_step = current_variant.quantity_rule.increment | default: 1
  assign quantity_max = current_variant.quantity_rule.max
  assign selected_allocation = current_variant.selected_selling_plan_allocation
  if selected_allocation == blank and product_context.requires_selling_plan
    assign selected_allocation = current_variant.selling_plan_allocations.first
  endif
  assign purchase_available = current_variant.available
  if product_context.requires_selling_plan and selected_allocation == blank
    assign purchase_available = false
  endif

  assign width = block.settings.width | default: 'auto'
  assign alignment = block.settings.alignment | default: 'left'
  assign form_style = block.settings.form_style | default: 'standard'

  assign show_on_desktop = block.settings.show_on_desktop
  assign show_on_tablet = block.settings.show_on_tablet
  assign show_on_mobile = block.settings.show_on_mobile
-%}

<div
  id="{{ block_id }}"
  class="
    product-form-block
    product-form-block--{{ form_style }}
    product-form-block--width-{{ width }}
    product-form-block--align-{{ alignment }}
    {% unless show_on_desktop or request.design_mode %} product-form-block--hide-desktop{% endunless %}
    {% unless show_on_tablet or request.design_mode %} product-form-block--hide-tablet{% endunless %}
    {% unless show_on_mobile or request.design_mode %} product-form-block--hide-mobile{% endunless %}
    {% if block.settings.animation_style != 'none' and request.design_mode == false %} product-form-block--animate product-form-block--animate-{{ block.settings.animation_style }}{% endif %}
  "
  style="
    --product-form-margin-top: {{ block.settings.margin_top }}px;
    --product-form-margin-bottom: {{ block.settings.margin_bottom }}px;
    --product-form-padding: {{ block.settings.padding }}px;
    --product-form-gap: {{ block.settings.gap }}px;
    --product-form-field-gap: {{ block.settings.field_gap }}px;
    --product-form-border-width: {{ block.settings.border_width }}px;
    --product-form-border-radius: {{ block.settings.border_radius }}px;
    --product-form-heading-color: {{ block.settings.heading_color }};
    --product-form-text-color: {{ block.settings.text_color }};
    --product-form-background-color: {{ block.settings.background_color }};
    --product-form-card-background-color: {{ block.settings.card_background_color }};
    --product-form-border-color: {{ block.settings.border_color }};
    --product-form-accent-color: {{ block.settings.accent_color }};
    --product-form-button-background: {{ block.settings.button_background_color }};
    --product-form-button-text: {{ block.settings.button_text_color }};
    --product-form-input-background: {{ block.settings.input_background_color }};
  "
  data-qtm-product-block-commerce="form"
  data-product-url="{{ product_context.url | escape }}"
  data-requires-plan="{{ product_context.requires_selling_plan }}"
  data-initial-plan="{{ selected_allocation.selling_plan.id }}"
  data-add-label="{{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}"
  data-sold-label="{{ block.settings.sold_out_label | default: 'Sold out' | escape }}"
  data-unavailable-label="{{ block.settings.unavailable_label | default: 'Unavailable' | escape }}"
  data-available-label="{{ 'Available' | escape }}"
  data-cart-adding-message="{{ block.settings.adding_message | default: 'Adding to cart...' | escape }}"
  data-cart-added-message="{{ block.settings.added_message | default: 'Added to cart.' | escape }}"
  data-product-id="{{ product_context.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-form-block

>
  {% render 'qtm-product-block-data', product: product_context %}
  <style>
    #{{ block_id }} {
      box-sizing: border-box;
      min-width: 0;
      overflow-wrap: anywhere;
      width: 100%;
      margin-top: var(--product-form-margin-top);
      margin-bottom: var(--product-form-margin-bottom);
      padding: var(--product-form-padding);
      color: var(--product-form-text-color);
      background: var(--product-form-background-color);
    }

    #{{ block_id }}.product-form-block--width-auto {
      max-width: none;
    }

    #{{ block_id }}.product-form-block--width-small {
      max-width: 640px;
    }

    #{{ block_id }}.product-form-block--width-medium {
      max-width: 820px;
    }

    #{{ block_id }}.product-form-block--width-large {
      max-width: 1040px;
    }

    #{{ block_id }}.product-form-block--width-full {
      max-width: none;
    }

    #{{ block_id }}.product-form-block--align-left {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    #{{ block_id }}.product-form-block--align-center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    #{{ block_id }}.product-form-block--align-right {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    #{{ block_id }} .product-form-block__inner {
      display: grid;
      gap: var(--product-form-gap);
      min-width: 0;
    }

    #{{ block_id }}.product-form-block--standard .product-form-block__inner,
    #{{ block_id }}.product-form-block--conversion .product-form-block__inner {
      padding: 20px;
      color: var(--product-form-text-color);
      background: var(--product-form-card-background-color);
      border: var(--product-form-border-width) solid var(--product-form-border-color);
      border-radius: var(--product-form-border-radius);
    }

    #{{ block_id }}.product-form-block--compact .product-form-block__inner {
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    #{{ block_id }} .product-form-block__heading {
      margin: 0;
      color: var(--product-form-heading-color);
      line-height: 1.2;
    }

    #{{ block_id }} .product-form-block__form {
      display: grid;
      gap: var(--product-form-gap);
      margin: 0;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__options {
      display: grid;
      gap: var(--product-form-field-gap);
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__option {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__label {
      color: var(--product-form-heading-color);
      line-height: 1.25;
      font-size: 0.92em;
    }

    #{{ block_id }} .product-form-block__select,
    #{{ block_id }} .product-form-block__quantity {
      width: 100%;
      min-height: 46px;
      color: var(--product-form-heading-color);
      background: var(--product-form-input-background);
      border: var(--product-form-border-width) solid var(--product-form-border-color);
      border-radius: max(calc(var(--product-form-border-radius) - 10px), 0px);
    }

    #{{ block_id }} .product-form-block__select {
      padding: 0 38px 0 12px;
    }

    #{{ block_id }} .product-form-block__quantity {
      max-width: 120px;
      padding: 0 12px;
      text-align: center;
    }

    #{{ block_id }} .product-form-block__select:focus-visible,
    #{{ block_id }} .product-form-block__quantity:focus-visible {
      outline: 2px solid var(--product-form-accent-color);
      outline-offset: 2px;
    }

    #{{ block_id }} .product-form-block__quantity-row {
      display: flex;
      align-items: stretch;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }}.product-form-block--align-center .product-form-block__quantity-row {
      justify-content: center;
    }

    #{{ block_id }}.product-form-block--align-right .product-form-block__quantity-row {
      justify-content: flex-end;
    }

    #{{ block_id }} .product-form-block__quantity-button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      min-height: 46px;
      color: var(--product-form-heading-color);
      background: var(--product-form-input-background);
      border: var(--product-form-border-width) solid var(--product-form-border-color);
      border-radius: max(calc(var(--product-form-border-radius) - 10px), 0px);
      cursor: pointer;
      font: inherit;
      line-height: 1;
    }

    #{{ block_id }} .product-form-block__quantity-button:hover {
      border-color: var(--product-form-accent-color);
    }

    #{{ block_id }} .product-form-block__quantity-button:focus-visible {
      outline: 2px solid var(--product-form-accent-color);
      outline-offset: 2px;
    }

    #{{ block_id }} .product-form-block__actions {
      display: grid;
      gap: 10px;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 50px;
      padding: 14px 18px;
      color: var(--product-form-button-text);
      background: var(--product-form-button-background);
      border: var(--product-form-border-width) solid var(--product-form-button-background);
      border-radius: max(calc(var(--product-form-border-radius) - 10px), 0px);
      cursor: pointer;
      text-align: center;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .product-form-block__button:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ block_id }} .product-form-block__button:focus-visible {
      outline: 2px solid var(--product-form-accent-color);
      outline-offset: 3px;
    }

    #{{ block_id }} .product-form-block__button[disabled] {
      cursor: not-allowed;
      opacity: 0.55;
      transform: none;
    }

    #{{ block_id }} .product-form-block__payment-button {
      display: block;
    }

    #{{ block_id }} .product-form-block__message {
      min-height: 1.3em;
      color: var(--product-form-text-color);
      line-height: 1.35;
      font-size: 0.92em;
    }

    #{{ block_id }}.product-form-block--compact .product-form-block__message {
      display: block;
    }

    #{{ block_id }} .product-form-block__selling-plan {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    #{{ block_id }} .product-form-block__selling-plan-note {
      color: var(--product-form-text-color);
      line-height: 1.45;
      font-size: 0.9em;
      opacity: 0.85;
    }

    #{{ block_id }}.product-form-block--animate {
      opacity: 0;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.product-form-block--animate-fade {
      animation-name: productFormFade;
    }

    #{{ block_id }}.product-form-block--animate-fade_up {
      animation-name: productFormFadeUp;
    }

    #{{ block_id }}.product-form-block--animate-fade_down {
      animation-name: productFormFadeDown;
    }

    #{{ block_id }}.product-form-block--animate-fade_left {
      animation-name: productFormFadeLeft;
    }

    #{{ block_id }}.product-form-block--animate-fade_right {
      animation-name: productFormFadeRight;
    }

    #{{ block_id }}.product-form-block--animate-zoom {
      animation-name: productFormZoom;
    }

    @keyframes productFormFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes productFormFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFormFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes productFormFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productFormFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes productFormZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.product-form-block--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.product-form-block--hide-tablet {
        display: none !important;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.product-form-block--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.product-form-block--standard .product-form-block__inner,
      #{{ block_id }}.product-form-block--conversion .product-form-block__inner {
        padding: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.product-form-block--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .product-form-block__button {
        transition: none;
      }

      #{{ block_id }} .product-form-block__button:hover {
        transform: none;
      }
    }
    #{{ block_id }} *, #{{ block_id }} *::before, #{{ block_id }} *::after { box-sizing: border-box; }
    #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} :is(button, select, input, a):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    #{{ block_id }} :is(button, select, input) { max-width: 100%; }
    #{{ block_id }}:focus-within { opacity: 1; transform: none; animation: none; }
    #{{ block_id }} [data-b8-fallback] { display: grid; gap: 6px; min-width: 0; }
    #{{ block_id }} [data-b8-fallback] select, #{{ block_id }} [name="selling_plan"] { width: 100%; min-width: 0; min-height: 44px; }
  {% unless block.settings.show_on_desktop or request.design_mode %}@media screen and (min-width: 990px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_tablet or request.design_mode %}@media screen and (min-width: 750px) and (max-width: 989px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
{% unless block.settings.show_on_mobile or request.design_mode %}@media screen and (max-width: 749px) { #shopify-block-{{ block.id }} { display: none; } }{% endunless %}
      #{{ block_id }} shopify-accelerated-checkout { --shopify-accelerated-checkout-button-block-size: 50px; --shopify-accelerated-checkout-button-border-radius: max(calc(var(--product-form-border-radius) - 10px), 0px); }
    @media (prefers-reduced-motion: reduce) { #{{ block_id }} shopify-accelerated-checkout { --shopify-accelerated-checkout-skeleton-animation-duration: 0s; } }
  </style>

  <div class="product-form-block__inner">
    {% if block.settings.heading != blank %}
      <h3 class="product-form-block__heading">
        {{ block.settings.heading | escape }}
      </h3>
    {% endif %}

    {% form 'product', product_context, id: form_id, class: 'product-form-block__form', data-product-form: '', data-cart-drawer-add: '', data-product-form-block-form: '' %}
      <div data-b8-fallback>
        <label for="{{ block_id }}-native-variant">{{ 'Variant' | escape }}</label>
        <select id="{{ block_id }}-native-variant" name="id" class="product-form-block__select" data-b8-variant-id>
          {% assign selected_listed = false %}{% for variant in product_context.variants %}{% if variant.id == current_variant.id %}{% assign selected_listed = true %}{% endif %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}
        {% unless selected_listed %}<option value="{{ current_variant.id }}" selected>{{ current_variant.title | escape }}{% unless current_variant.available %} — Sold out{% endunless %}</option>{% endunless %}
        </select>
      </div>

      {% if block.settings.show_variant_picker and product_context.has_only_default_variant == false %}
        <div class="product-form-block__options" data-b8-option-controls hidden>
          {% for option in product_context.options_with_values %}
            <div class="product-form-block__option">
              <label class="product-form-block__label" for="{{ block_id }}-option-{{ forloop.index }}">
                {{ option.name | escape }}
              </label>

              <select
                id="{{ block_id }}-option-{{ forloop.index }}"
                class="product-form-block__select"
                data-product-form-option-select data-b8-option-select
                data-option-position="{{ option.position }}"
                aria-label="{{ option.name | escape }}"
              >
                {% for value in option.values %}
              {% assign value_text = value.name | default: value | append: '' %}
                  <option
                    value="{{ value_text | escape }}"
                    {% if value.selected or option.selected_value == value_text %}selected{% endif %}
                  >
                    {{ value_text | escape }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if block.settings.show_selling_plans or product_context.requires_selling_plan %}
        {% render 'product-selling-plans', product: product_context, id: block_id, label: block.settings.selling_plan_label, one_time_label: block.settings.one_time_purchase_label, note: block.settings.selling_plan_note %}
      {% else %}<input type="hidden" name="selling_plan" value="">
      {% endif %}

      {% if block.settings.show_quantity %}
        <div class="product-form-block__option">
          <label class="product-form-block__label" for="{{ block_id }}-quantity">
            {{ block.settings.quantity_label | default: 'Quantity' | escape }}
          </label>

          <div class="product-form-block__quantity-row">
            {% if block.settings.show_quantity_buttons %}
              <button
                type="button"
                class="product-form-block__quantity-button"
                data-product-form-quantity-minus data-b8-minus disabled
                aria-label="{{ block.settings.decrease_quantity_label | default: 'Decrease quantity' | escape }}"
              >
                −
              </button>
            {% endif %}

            <input
              id="{{ block_id }}-quantity"
              class="product-form-block__quantity"
              type="number"
              name="quantity"
              min="{{ quantity_min }}"
              step="{{ quantity_step }}"
              {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %}
              value="{{ quantity_min }}"
              inputmode="numeric"
              data-product-form-quantity
              aria-label="{{ block.settings.quantity_label | default: 'Quantity' | escape }}"
            >

            {% if block.settings.show_quantity_buttons %}
              <button
                type="button"
                class="product-form-block__quantity-button"
                data-product-form-quantity-plus data-b8-plus disabled
                aria-label="{{ block.settings.increase_quantity_label | default: 'Increase quantity' | escape }}"
              >
                +
              </button>
            {% endif %}
          </div>
        </div>
      {% else %}
        <input type="hidden" name="quantity" value="{{ quantity_min }}">
      {% endif %}

      <div class="product-form-block__actions">
        {% if block.settings.show_add_to_cart %}
          <button
            type="submit"
            class="product-form-block__button"
            {% unless purchase_available %}disabled{% endunless %}
            data-add-to-cart
            data-product-form-submit name="add" data-b8-submit
          >
            {% if current_variant.available %}
              {{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}
            {% else %}
              {{ block.settings.sold_out_label | default: 'Sold out' | escape }}
            {% endif %}
          </button>
        {% endif %}

        {% if block.settings.show_dynamic_checkout %}
          <div class="product-form-block__payment-button" data-b8-payment {% unless purchase_available %}hidden{% endunless %}>
            {{ form | payment_button }}
          </div>
        {% endif %}
      </div>

      <div
        class="product-form-block__message"
        data-product-form-message
        data-cart-add-status
        role="status"
        aria-live="polite"
      ></div>
    {% endform %}
  </div>
</div>

{% elsif request.design_mode %}<p>Select a product to configure this block.</p>{% endif %}

{% schema %}
{
  "name": "Product form",
  "settings": [
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "Show variant picker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity_buttons",
      "label": "Show quantity buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_selling_plans",
      "label": "Show selling plans",
      "default": true
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "decrease_quantity_label",
      "label": "Decrease quantity label",
      "default": "Decrease quantity"
    },
    {
      "type": "text",
      "id": "increase_quantity_label",
      "label": "Increase quantity label",
      "default": "Increase quantity"
    },
    {
      "type": "text",
      "id": "selling_plan_label",
      "label": "Selling plan label",
      "default": "Purchase options"
    },
    {
      "type": "text",
      "id": "one_time_purchase_label",
      "label": "One-time purchase label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "selling_plan_note",
      "label": "Selling plan note"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "Unavailable"
    },
    {
      "type": "text",
      "id": "adding_message",
      "label": "Adding message",
      "default": "Adding to cart..."
    },
    {
      "type": "text",
      "id": "added_message",
      "label": "Added message",
      "default": "Added to cart."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "form_style",
      "label": "Form style",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "conversion",
          "label": "Conversion"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
