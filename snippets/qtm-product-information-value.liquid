{%- liquid
  assign information_value = ''
  case source
    when 'sku'
      assign information_value = variant.sku
    when 'option_1'
      assign information_value = variant.options[0]
    when 'option_2'
      assign information_value = variant.options[1]
    when 'option_3'
      assign information_value = variant.options[2]
    when 'weight'
      if variant.weight > 0
        assign information_value = variant.weight | weight_with_unit
      endif
    when 'availability'
      if variant == blank
        assign information_value = 'Unavailable'
      elsif variant.available
        assign information_value = 'Available'
      else
        assign information_value = 'Sold out'
      endif
    when 'inventory'
      if variant == blank
        assign information_value = block.settings.unavailable_text
      elsif variant.available == false
        assign information_value = block.settings.sold_out_text
      elsif variant.inventory_management != blank and variant.inventory_quantity <= 0 and variant.inventory_policy == 'continue'
        assign information_value = block.settings.backorder_text
      elsif block.settings.show_stock_count and variant.inventory_management != blank and variant.inventory_quantity > 0 and variant.inventory_quantity <= block.settings.low_stock_threshold
        assign information_value = block.settings.low_stock_text | replace: '[quantity]', variant.inventory_quantity
      else
        assign information_value = block.settings.in_stock_text
      endif
  endcase
-%}{{- information_value -}}
