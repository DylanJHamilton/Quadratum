{%- liquid
  assign block_id = 'content-timeline-' | append: block.id

  assign alignment = block.settings.alignment | default: 'left'
  assign width = block.settings.width | default: 'auto'
  assign layout_style = block.settings.layout_style | default: 'vertical'
  assign item_count = block.settings.item_count | default: 4

  assign show_desktop = block.settings.show_desktop
  assign show_tablet = block.settings.show_tablet
  assign show_mobile = block.settings.show_mobile
-%}

{% assign rendered_count = 0 %}
{% capture rendered_items %}
  <ol class="content-timeline__list" role="list">
    {%- for index in (1..8) -%}
      {%- if index <= item_count -%}
        {%- liquid
          assign date_key = 'item_' | append: index | append: '_date'
          assign icon_key = 'item_' | append: index | append: '_icon'
          assign image_key = 'item_' | append: index | append: '_image'
          assign image_alt_key = 'item_' | append: index | append: '_image_alt'
          assign heading_key = 'item_' | append: index | append: '_heading'
          assign text_key = 'item_' | append: index | append: '_text'
          assign button_label_key = 'item_' | append: index | append: '_button_label'
          assign button_url_key = 'item_' | append: index | append: '_button_url'

          assign item_date = block.settings[date_key]
          assign item_icon = block.settings[icon_key]
          assign item_image = block.settings[image_key]
          assign item_image_alt = block.settings[image_alt_key]
          assign item_heading = block.settings[heading_key]
          assign item_text = block.settings[text_key]
          assign item_button_label = block.settings[button_label_key]
          assign item_button_url = block.settings[button_url_key]
          assign item_image_alt = item_image_alt | default: item_image.alt | default: item_heading
          assign has_action = false
          if item_button_label != blank and item_button_url != blank
            assign has_action = true
          endif
        -%}

        {% if item_date != blank or item_heading != blank or item_text != blank or item_image != blank or has_action %}
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        <li class="content-timeline__item">
          <span class="content-timeline__marker" aria-hidden="true">
            {% if item_icon != blank %}
              <span class="content-timeline__icon">{{ item_icon | escape }}</span>
            {% endif %}
          </span>

          <div class="content-timeline__card">
            {% if item_image != blank %}
              <div class="content-timeline__media">
                {{
                  item_image
                  | image_url: width: 1100
                  | image_tag:
                    class: 'content-timeline__image',
                    loading: 'lazy',
                    alt: item_image_alt
                }}
              </div>
            {% endif %}

            {% if item_date != blank %}
              <p class="content-timeline__date">
                {{ item_date | escape }}
              </p>
            {% endif %}

            {% if item_heading != blank %}
              <h3 class="content-timeline__heading">
                {{ item_heading | escape }}
              </h3>
            {% endif %}

            {% if item_text != blank %}
              <div class="content-timeline__text">
                {{ item_text }}
              </div>
            {% endif %}

            {% if item_button_label != blank and item_button_url != blank %}
              <a class="content-timeline__button" href="{{ item_button_url | escape }}">
                {{ item_button_label | escape }}
              </a>
            {% endif %}
          </div>
        </li>
        {% endif %}
      {%- endif -%}
    {%- endfor -%}
  </ol>
{% endcapture %}
<div
  id="{{ block_id }}"
  {% if rendered_count == 0 and request.design_mode == false %}hidden{% endif %}
  class="
    content-timeline
    content-timeline--{{ layout_style }}
    content-timeline--align-{{ alignment }}
    content-timeline--width-{{ width }}
    {% unless show_desktop or request.design_mode %} content-timeline--hide-desktop{% endunless %}
    {% unless show_tablet or request.design_mode %} content-timeline--hide-tablet{% endunless %}
    {% unless show_mobile or request.design_mode %} content-timeline--hide-mobile{% endunless %}
    {% if block.settings.animation != 'none' and request.design_mode == false %} content-timeline--animate content-timeline--animate-{{ block.settings.animation }}{% endif %}
  "
  style="
    --content-timeline-margin-top: {{ block.settings.margin_top }}px;
    --content-timeline-margin-bottom: {{ block.settings.margin_bottom }}px;
    --content-timeline-padding-top: {{ block.settings.padding_top }}px;
    --content-timeline-padding-bottom: {{ block.settings.padding_bottom }}px;
    --content-timeline-padding-inline-start: {{ block.settings.padding_left }}px;
    --content-timeline-padding-inline-end: {{ block.settings.padding_right }}px;
    --content-timeline-gap: {{ block.settings.gap }}px;
    --content-timeline-card-padding: {{ block.settings.card_padding }}px;
    --content-timeline-border-width: {{ block.settings.border_width }}px;
    --content-timeline-border-radius: {{ block.settings.border_radius }}px;
    --content-timeline-heading-color: {{ block.settings.heading_color }};
    --content-timeline-text-color: {{ block.settings.text_color }};
    --content-timeline-link-color: {{ block.settings.link_color }};
    --content-timeline-background-color: {{ block.settings.background_color }};
    --content-timeline-card-background-color: {{ block.settings.card_background_color }};
    --content-timeline-border-color: {{ block.settings.border_color }};
    --content-timeline-line-color: {{ block.settings.line_color }};
    --content-timeline-marker-color: {{ block.settings.marker_color }};
    --content-timeline-marker-background: {{ block.settings.marker_background_color }};
    --content-timeline-date-color: {{ block.settings.date_color }};
    --content-timeline-icon-size: {{ block.settings.icon_size }}px;
    --content-timeline-marker-size: {{ block.settings.marker_size }}px;
    --content-timeline-image-radius: {{ block.settings.image_radius }}px;
    --content-timeline-button-radius: {{ block.settings.button_radius }}px;
  "

>
  <style>
    #{{ block_id }} {
      width: 100%;
      margin-top: var(--content-timeline-margin-top);
      margin-bottom: var(--content-timeline-margin-bottom);
      padding-top: var(--content-timeline-padding-top);
      padding-bottom: var(--content-timeline-padding-bottom);
      padding-inline-start: min(var(--content-timeline-padding-inline-start), 8%);
      padding-inline-end: min(var(--content-timeline-padding-inline-end), 8%);
      background: var(--content-timeline-background-color);
      color: var(--content-timeline-text-color);
    }

    #{{ block_id }}.content-timeline--width-auto {
      max-width: 100%;
    }

    #{{ block_id }}.content-timeline--width-small {
      max-width: min(100%, 720px);
    }

    #{{ block_id }}.content-timeline--width-medium {
      max-width: min(100%, 960px);
    }

    #{{ block_id }}.content-timeline--width-large {
      max-width: min(100%, 1200px);
    }

    #{{ block_id }}.content-timeline--width-full {
      max-width: 100%;
    }

    #{{ block_id }}.content-timeline--align-left {
      margin-inline-start: 0;
      margin-inline-end: auto;
      text-align: left;
    }

    #{{ block_id }}.content-timeline--align-center {
      margin-inline-start: auto;
      margin-inline-end: auto;
      text-align: center;
    }

    #{{ block_id }}.content-timeline--align-right {
      margin-inline-start: auto;
      margin-inline-end: 0;
      text-align: right;
    }

    #{{ block_id }} .content-timeline__list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--content-timeline-gap);
      width: 100%;
    }

    #{{ block_id }}.content-timeline--vertical .content-timeline__list,
    #{{ block_id }}.content-timeline--alternating .content-timeline__list {
      padding-inline-start: calc(var(--content-timeline-marker-size) + 24px);
    }

    #{{ block_id }}.content-timeline--vertical .content-timeline__list::before,
    #{{ block_id }}.content-timeline--alternating .content-timeline__list::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      inset-inline-start: calc(var(--content-timeline-marker-size) / 2);
      width: 2px;
      background: var(--content-timeline-line-color);
    }

    #{{ block_id }}.content-timeline--horizontal .content-timeline__list {
      display: grid;
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
      gap: var(--content-timeline-gap);
      align-items: stretch;
    }

    #{{ block_id }}.content-timeline--horizontal .content-timeline__list::before {
      content: "";
      position: absolute;
      inset-inline-start: 0;
      inset-inline-end: 0;
      top: calc(var(--content-timeline-marker-size) / 2);
      height: 2px;
      background: var(--content-timeline-line-color);
      z-index: 0;
    }

    #{{ block_id }} .content-timeline__item {
      position: relative;
      min-width: 0;
    }

    #{{ block_id }}.content-timeline--horizontal .content-timeline__item {
      padding-top: calc(var(--content-timeline-marker-size) + 24px);
    }

    #{{ block_id }} .content-timeline__marker {
      position: absolute;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--content-timeline-marker-size);
      height: var(--content-timeline-marker-size);
      border-radius: 999px;
      color: var(--content-timeline-marker-color);
      background: var(--content-timeline-marker-background);
      border: 2px solid var(--content-timeline-line-color);
      z-index: 2;
      line-height: 1;
    }

    #{{ block_id }}.content-timeline--vertical .content-timeline__marker,
    #{{ block_id }}.content-timeline--alternating .content-timeline__marker {
      top: 0;
      inset-inline-start: calc((var(--content-timeline-marker-size) + 24px) * -1);
    }

    #{{ block_id }}.content-timeline--horizontal .content-timeline__marker {
      top: 0;
      inset-inline-start: 0;
    }

    #{{ block_id }} .content-timeline__icon {
      font-size: var(--content-timeline-icon-size);
      line-height: 1;
    }

    #{{ block_id }} .content-timeline__card {
      position: relative;
      display: grid;
      gap: 14px;
      min-width: 0;
      color: var(--content-timeline-text-color);
      background: var(--content-timeline-card-background-color);
      border: var(--content-timeline-border-width) solid var(--content-timeline-border-color);
      border-radius: var(--content-timeline-border-radius);
      padding: min(var(--content-timeline-card-padding), 8%);
      overflow: hidden;
    }

    #{{ block_id }}.content-timeline--minimal .content-timeline__card {
      background: transparent;
      border-color: transparent;
      border-radius: 0;
      padding-inline-start: 0;
      padding-inline-end: 0;
    }

    #{{ block_id }}.content-timeline--alternating .content-timeline__item:nth-child(even) .content-timeline__card {
      margin-inline-start: 32px;
    }

    #{{ block_id }}.content-timeline--alternating .content-timeline__item:nth-child(odd) .content-timeline__card {
      margin-inline-end: 32px;
    }

    #{{ block_id }} .content-timeline__media {
      width: 100%;
      overflow: hidden;
      border-radius: var(--content-timeline-image-radius);
      background: rgba(0, 0, 0, 0.04);
    }

    #{{ block_id }} .content-timeline__image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: var(--content-timeline-image-radius);
    }

    #{{ block_id }} .content-timeline__date {
      margin: 0;
      color: var(--content-timeline-date-color);
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.78em;
    }

    #{{ block_id }} .content-timeline__heading {
      margin: 0;
      color: var(--content-timeline-heading-color);
      line-height: 1.15;
    }

    #{{ block_id }} .content-timeline__text {
      margin: 0;
      color: var(--content-timeline-text-color);
      line-height: 1.65;
    }

    #{{ block_id }} .content-timeline__text p {
      margin-top: 0;
    }

    #{{ block_id }} .content-timeline__text p:last-child {
      margin-bottom: 0;
    }

    #{{ block_id }} .content-timeline__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 42px;
      padding: 11px 16px;
      border-radius: var(--content-timeline-button-radius);
      color: var(--content-timeline-link-color);
      border: 1px solid currentColor;
      text-decoration: none;
      line-height: 1.2;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #{{ block_id }} .content-timeline__button:hover {
      opacity: 0.75;
      transform: translateY(-1px);
    }

    #{{ block_id }}.content-timeline--align-center .content-timeline__button {
      margin-inline-start: auto;
      margin-inline-end: auto;
    }

    #{{ block_id }}.content-timeline--align-right .content-timeline__button {
      margin-inline-start: auto;
      margin-inline-end: 0;
    }

    #{{ block_id }}.content-timeline--animate {
      opacity: 1;
      animation-duration: 700ms;
      animation-fill-mode: forwards;
      animation-timing-function: ease;
    }

    #{{ block_id }}.content-timeline--animate-fade {
      animation-name: contentTimelineFade;
    }

    #{{ block_id }}.content-timeline--animate-fade-up {
      animation-name: contentTimelineFadeUp;
    }

    #{{ block_id }}.content-timeline--animate-fade-down {
      animation-name: contentTimelineFadeDown;
    }

    #{{ block_id }}.content-timeline--animate-fade-left {
      animation-name: contentTimelineFadeLeft;
    }

    #{{ block_id }}.content-timeline--animate-fade-right {
      animation-name: contentTimelineFadeRight;
    }

    #{{ block_id }}.content-timeline--animate-zoom {
      animation-name: contentTimelineZoom;
    }

    @keyframes contentTimelineFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes contentTimelineFadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTimelineFadeDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes contentTimelineFadeLeft {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTimelineFadeRight {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes contentTimelineZoom {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @media screen and (min-width: 990px) {
      #{{ block_id }}.content-timeline--hide-desktop {
        display: none !important;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #{{ block_id }}.content-timeline--hide-tablet {
        display: none !important;
      }

      #{{ block_id }}.content-timeline--horizontal .content-timeline__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ block_id }}.content-timeline--hide-mobile {
        display: none !important;
      }

      #{{ block_id }}.content-timeline--horizontal .content-timeline__list,
      #{{ block_id }}.content-timeline--vertical .content-timeline__list,
      #{{ block_id }}.content-timeline--alternating .content-timeline__list {
        display: flex;
        flex-direction: column;
        padding-inline-start: calc(var(--content-timeline-marker-size) + 24px);
      }

      #{{ block_id }}.content-timeline--horizontal .content-timeline__list::before,
      #{{ block_id }}.content-timeline--vertical .content-timeline__list::before,
      #{{ block_id }}.content-timeline--alternating .content-timeline__list::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        inset-inline-start: calc(var(--content-timeline-marker-size) / 2);
        width: 2px;
        height: auto;
        background: var(--content-timeline-line-color);
      }

      #{{ block_id }}.content-timeline--horizontal .content-timeline__item {
        padding-top: 0;
      }

      #{{ block_id }}.content-timeline--horizontal .content-timeline__marker,
      #{{ block_id }}.content-timeline--vertical .content-timeline__marker,
      #{{ block_id }}.content-timeline--alternating .content-timeline__marker {
        top: 0;
        inset-inline-start: calc((var(--content-timeline-marker-size) + 24px) * -1);
      }

      #{{ block_id }}.content-timeline--alternating .content-timeline__item:nth-child(even) .content-timeline__card,
      #{{ block_id }}.content-timeline--alternating .content-timeline__item:nth-child(odd) .content-timeline__card {
        margin-inline-start: 0;
        margin-inline-end: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }}.content-timeline--animate {
        opacity: 1;
        animation: none;
        transform: none;
      }

      #{{ block_id }} .content-timeline__button {
        transition: none;
      }

      #{{ block_id }} .content-timeline__button:hover {
        transform: none;
      }
    }
    #{{ block_id }} { min-width: 0; overflow-wrap: anywhere; container-type: inline-size; }
    #{{ block_id }}, #{{ block_id }} * { box-sizing: border-box; }
    #{{ block_id }}[hidden], #{{ block_id }} [hidden] { display: none !important; }
    #{{ block_id }} img, #{{ block_id }} a { max-width: 100%; }
    #{{ block_id }} :focus-visible { outline: 2px solid var(--content-timeline-link-color); outline-offset: -3px; }
    #{{ block_id }} .content-timeline__list { list-style: none; margin: 0; padding-block: 0; padding-inline-end: 0; }
    #{{ block_id }}.content-timeline--horizontal .content-timeline__list, #{{ block_id }}.content-timeline--minimal .content-timeline__list { padding-inline-start: 0; }
    #{{ block_id }}.content-timeline--minimal .content-timeline__marker { position: static; margin-block-end: 12px; }
    #{{ block_id }} .content-timeline__button { white-space: normal; overflow-wrap: anywhere; }
    #{{ block_id }} .content-timeline__icon { max-width: 100%; overflow: hidden; }
    @container (max-width: 749px) {
      #{{ block_id }}.content-timeline:not(.content-timeline--minimal) .content-timeline__list { display: flex; flex-direction: column; padding-inline-start: calc(var(--content-timeline-marker-size) + 24px); }
      #{{ block_id }}.content-timeline:not(.content-timeline--minimal) .content-timeline__list::before { content: ''; top: 0; bottom: 0; inset-inline-start: calc(var(--content-timeline-marker-size) / 2); inset-inline-end: auto; width: 2px; height: auto; }
      #{{ block_id }}.content-timeline .content-timeline__item { padding-top: 0; }
      #{{ block_id }}.content-timeline:not(.content-timeline--minimal) .content-timeline__marker { top: 0; inset-inline-start: calc((var(--content-timeline-marker-size) + 24px) * -1); }
      #{{ block_id }}.content-timeline .content-timeline__item .content-timeline__card { margin-inline: 0; }
    }
    @container (max-width: 400px) {
      #{{ block_id }}.content-timeline:not(.content-timeline--minimal) .content-timeline__list { padding-inline-start: calc(min(var(--content-timeline-marker-size), 40px) + 12px); }
      #{{ block_id }}.content-timeline:not(.content-timeline--minimal) .content-timeline__list::before { inset-inline-start: calc(min(var(--content-timeline-marker-size), 40px) / 2); }
      #{{ block_id }}.content-timeline .content-timeline__marker { width: min(var(--content-timeline-marker-size), 40px); height: min(var(--content-timeline-marker-size), 40px); }
      #{{ block_id }}.content-timeline:not(.content-timeline--minimal) .content-timeline__marker { inset-inline-start: calc((min(var(--content-timeline-marker-size), 40px) + 12px) * -1); }
      #{{ block_id }} .content-timeline__icon { font-size: min(var(--content-timeline-icon-size), 24px); }
    }
  </style>

  {% if rendered_count > 0 %}{{ rendered_items }}{% elsif request.design_mode %}<p role="note">Add timeline entries in this block’s settings.</p>{% endif %}
</div>

{% schema %}
{
  "name": "Content timeline",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "vertical",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "alternating",
          "label": "Alternating"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "range",
      "id": "item_count",
      "label": "Number of timeline items",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Horizontal desktop columns",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "text",
      "id": "item_1_date",
      "label": "Date / label"
